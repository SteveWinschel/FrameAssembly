{
  "parallel-file-lock-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pre_tool_file_lock_guard.ps1 || bash scripts/pre_tool_file_lock_guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}