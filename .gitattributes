# FrameAssembly Custom Domain-Specific Language (.frasm — text/vnd.frameassembly)
# Keeps Rust as primary repository language while indexing .frasm cleanly for GitHub Linguist & AI crawlers
*.frasm linguist-language=FrameAssembly linguist-detectable=true linguist-documentation=false linguist-vendored=false linguist-generated=false text eol=lf
examples/**/*.frasm linguist-language=FrameAssembly linguist-detectable=false linguist-documentation=false linguist-vendored=false linguist-generated=false text eol=lf
contrib/linguist/samples/*.frasm linguist-language=FrameAssembly linguist-detectable=true linguist-documentation=false linguist-vendored=false linguist-generated=false text eol=lf

# Formal Grammars (ISO/IEC 14977 EBNF, GGML GBNF, Lark CFG)
*.ebnf linguist-language=EBNF linguist-detectable=false text eol=lf
*.gbnf linguist-language=EBNF linguist-detectable=false text eol=lf
*.lark linguist-language=EBNF linguist-detectable=false text eol=lf

# Documentation, Dataset Metadata, Standards Registration & Citation Files
*.md text eol=lf
docs/*.md linguist-documentation=true text eol=lf
examples/**/README.md linguist-documentation=true text eol=lf
contrib/**/*.md linguist-documentation=true text eol=lf
contrib/**/*.json text eol=lf
contrib/**/*.xml text eol=lf
contrib/**/*.yml text eol=lf
llms.txt text eol=lf linguist-documentation=true
CITATION.cff text eol=lf
codemeta.json text eol=lf
context7.json text eol=lf
AGENTS.md text eol=lf
CLAUDE.md text eol=lf

# Generated Lockfiles & Composite Context Bundles (excluded from Linguist language stats)
Cargo.lock text eol=lf linguist-generated=true
**/Cargo.lock text eol=lf linguist-generated=true
package-lock.json text eol=lf linguist-generated=true
**/package-lock.json text eol=lf linguist-generated=true
llms-full.txt text eol=lf linguist-generated=true

# Binary, WebAssembly & Packaged Extension Artifacts
*.vsix binary linguist-generated=true
*.wasm binary linguist-generated=true
*.pcap binary
*.pcapng binary
*.png binary
