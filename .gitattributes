# FrameAssembly Custom Domain-Specific Language (.frasm — text/vnd.frameassembly)
# Overrides GitHub's default language detection so .frasm files are always indexed as FrameAssembly
*.frasm linguist-language=FrameAssembly linguist-detectable=false linguist-documentation=false linguist-vendored=false linguist-generated=false text eol=lf
contrib/linguist/samples/*.frasm linguist-language=FrameAssembly linguist-detectable=false linguist-documentation=false linguist-vendored=false linguist-generated=false text eol=lf

# Formal Grammars (EBNF, GBNF, Lark)
*.ebnf linguist-language=EBNF linguist-detectable=false text eol=lf
*.gbnf linguist-language=EBNF linguist-detectable=false text eol=lf
*.lark linguist-language=EBNF linguist-detectable=false text eol=lf

# Documentation, Standards Registration, Citation & AI Context Files
*.md text eol=lf
docs/*.md linguist-documentation=true text eol=lf
contrib/**/*.md linguist-documentation=true text eol=lf
contrib/**/*.xml text eol=lf
contrib/**/*.yml text eol=lf
llms.txt text eol=lf linguist-documentation=true
llms-full.txt text eol=lf linguist-generated=true
CITATION.cff text eol=lf
codemeta.json text eol=lf
context7.json text eol=lf
AGENTS.md text eol=lf
CLAUDE.md text eol=lf

# Binary & Packaged Extension Artifacts
*.vsix binary linguist-generated=true
*.pcap binary
*.pcapng binary
