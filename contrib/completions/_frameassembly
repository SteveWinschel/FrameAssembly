#compdef frameassembly
# zsh completion for frameassembly(1)
# https://github.com/SteveWinschel/FrameAssembly

_frameassembly() {
    local ret=1
    local -a subcommands
    subcommands=(
        'show:Validate a .frasm file and print its packet ladder table'
        'reverse:Reverse a .pcap or .pcapng capture file into .frasm code'
        'version:Print the FrameAssembly version'
        'help:Print help for FrameAssembly or a subcommand'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'frameassembly subcommand' subcommands && ret=0
        _path_files -/ -g '*.(frasm|FRASM)' && ret=0
        return ret
    fi

    case "${words[2]}" in
        show)
            if (( CURRENT == 3 )); then
                _files -g '*.(frasm|FRASM)'
            fi
            ;;
        reverse)
            case "$CURRENT" in
                3) _files -g '*.(pcap|pcapng|PCAP|PCAPNG)' ;;
                4) _files -g '*.(frasm|FRASM)' ;;
            esac
            ;;
        help)
            if (( CURRENT == 3 )); then
                _describe -t commands 'subcommand' subcommands
            fi
            ;;
        version|-*)
            ;;
        *)
            if (( CURRENT == 3 )); then
                _files -g '*.(pcap|pcapng|PCAP|PCAPNG)'
            fi
            ;;
    esac
}

_frameassembly "$@"
