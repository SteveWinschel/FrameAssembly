  "@type": "sc:Dataset",
  "name": "FrameAssembly-frasm-corpus",
  "alternateName": "FrameAssembly Packets-as-Code Samples (v3.2.1)",
  "description": "Compiler-verified, MIT-licensed FrameAssembly (.frasm) sample files with EBNF, GBNF, and Lark grammars covering 81 L2-L7 protocols. More use-case examples: https://frameassembly-lang.dev/use-cases. Documentation: https://frameassembly-lang.dev/docs.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "3.2.1",
  "license": "https://spdx.org/licenses/MIT.html",
  "url": "https://github.com/SteveWinschel/FrameAssembly",
  "sameAs": "https://frameassembly-lang.dev/",
  "isLiveDataset": false,
  "inLanguage": "en",
  "creator": {
    "@type": "sc:Person",
    "name": "Steve Winschel",
    "url": "https://github.com/SteveWinschel"
  },
  "citeAs": "@software{winschel_frameassembly_2026, author={Winschel, Steve}, title={FrameAssembly}, version={3.2.1}, year={2026}, url={https://github.com/SteveWinschel/FrameAssembly}}",
  "keywords": [
    "FrameAssembly",
    "frasm",
    "text/vnd.frameassembly",
    "packets-as-code",
    "pcap",
    "pcapng",
    "network-protocols",
    "wireshark",
    "rust",
    "compiler-verified-code",
    "constrained-decoding"
  ],
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "github-repo-archive",
      "name": "github-repo-archive",
      "description": "FrameAssembly v3.2.1 GitHub source archive containing .frasm samples, formal grammars, and the Rust compiler/decompiler.",
      "contentUrl": "https://github.com/SteveWinschel/FrameAssembly/archive/refs/heads/main.tar.gz",
      "encodingFormat": "application/x-gzip"
    },
    {
      "@type": "cr:FileSet",
      "@id": "frasm-corpus-files",
      "name": "frasm-corpus-files",
      "description": "Verified .frasm sample files under contrib/linguist/samples/.",
      "containedIn": {
        "@id": "github-repo-archive"
      },
      "encodingFormat": "text/vnd.frameassembly",
      "includes": "*/contrib/linguist/samples/*.frasm"
    },
    {
      "@type": "cr:FileObject",
      "@id": "ebnf-grammar",
      "name": "grammar.ebnf",
      "description": "Formal ISO/IEC 14977 EBNF grammar for FrameAssembly v3.2.1.",
      "containedIn": {
        "@id": "github-repo-archive"
      },
      "contentUrl": "https://raw.githubusercontent.com/SteveWinschel/FrameAssembly/main/grammar.ebnf",
      "encodingFormat": "text/plain"
    },
    {
      "@type": "cr:FileObject",
      "@id": "gbnf-grammar",
      "name": "frameassembly.gbnf",
      "description": "GGML BNF constrained-decoding grammar for llama.cpp and XGrammar.",
      "containedIn": {
        "@id": "github-repo-archive"
      },
      "contentUrl": "https://raw.githubusercontent.com/SteveWinschel/FrameAssembly/main/frameassembly.gbnf",
      "encodingFormat": "text/plain"
    },
    {
      "@type": "cr:FileObject",
      "@id": "lark-grammar",
      "name": "frameassembly.lark",
      "description": "Priority-disambiguated Lark CFG grammar for Outlines, vLLM, and llguidance.",
      "containedIn": {
        "@id": "github-repo-archive"
      },
      "contentUrl": "https://raw.githubusercontent.com/SteveWinschel/FrameAssembly/main/frameassembly.lark",
      "encodingFormat": "text/plain"
    },
    {
      "@type": "cr:FileObject",
      "@id": "llms-full-context",
      "name": "llms-full.txt",
      "description": "Self-contained v3.2.1 LLM reference covering all 81 protocols, compilable examples, and EBNF grammar.",
      "containedIn": {
        "@id": "github-repo-archive"
      },
      "contentUrl": "https://raw.githubusercontent.com/SteveWinschel/FrameAssembly/main/llms-full.txt",
      "encodingFormat": "text/plain"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "frasm-examples",
      "name": "frasm-examples",
      "description": "Compiler-verified FrameAssembly (.frasm) packet-capture specifications with networking comments and Wireshark display filters.",
      "key": {
        "@id": "frasm-examples/file_path"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "frasm-examples/file_path",
          "name": "file_path",
          "description": "Relative repository path of the .frasm sample file.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "frasm-corpus-files"
            },
            "extract": {
              "fileProperty": "fullpath"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "frasm-examples/frasm_source",
          "name": "frasm_source",
          "description": "UTF-8 FrameAssembly v3.2.1 .frasm code verified by the forward compiler and reverse PCAP decompiler.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "frasm-corpus-files"
            },
            "extract": {
              "fileProperty": "content"
            }
          }
        }
      ]
    }
  ]
}
