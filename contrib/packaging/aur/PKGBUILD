# Maintainer: Steve Winschel <https://github.com/SteveWinschel/FrameAssembly>
pkgname=frameassembly-bin
pkgver=1.5.0
pkgrel=1
pkgdesc="Rootless Packets-as-Code DSL & compiler: generate deterministic .pcap/.pcapng captures from .fasm across 81 L2-L7 protocols"
arch=('x86_64' 'aarch64')
url="https://github.com/SteveWinschel/FrameAssembly"
license=('MIT')
provides=('frameassembly')
conflicts=('frameassembly')

source_x86_64=("https://github.com/SteveWinschel/FrameAssembly/releases/download/v${pkgver}/frameassembly-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/SteveWinschel/FrameAssembly/releases/download/v${pkgver}/frameassembly-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('8dce0bfcf0c7a5e384c507fb7220b52b332e818bd2441025de3dd1db2bd1de7f')
sha256sums_aarch64=('31a7f286ff9fc6b217286ee3f4bb5946e8ba591dd678b1b6162de3de91e1cacb')

package() {
    cd "${srcdir}/frameassembly-v${pkgver}-${CARCH}-unknown-linux-musl"
    install -Dm755 frameassembly "${pkgdir}/usr/bin/frameassembly"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/frameassembly/README.md"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/frameassembly/LICENSE"

    # Install MIME type registration (text/vnd.frameassembly)
    if [ -f text-vnd.frameassembly.xml ]; then
        install -Dm644 text-vnd.frameassembly.xml "${pkgdir}/usr/share/mime/packages/text-vnd.frameassembly.xml"
    fi

    # Install magic pattern definitions if present
    if [ -f frameassembly.magic ]; then
        install -Dm644 frameassembly.magic "${pkgdir}/usr/share/file/magic/frameassembly"
    fi
}
