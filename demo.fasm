// Demo: Stateful HTTP/1.1 health check and encrypted SNMPv3 USM linkUp alert.
// Compile to PCAPNG:  frameassembly demo.fasm -o output.pcap
// Inspect ladder:     frameassembly show demo.fasm

// Client workstation, application server, and NMS collector endpoints
host edge_client {
    ip 10.0.10.50
    mac 00:1a:2b:3c:4d:50
}

host app_server {
    ip 10.0.10.80
    mac 00:1a:2b:3c:4d:80
}

host nms_collector {
    ip 10.0.10.100
    mac 00:1a:2b:3c:4d:99
}

// TCP 3-way handshake followed by an HTTP GET request and 200 OK JSON response
flow web_session(client, server) {
    client -> server tcp syn srcport 51234 dstport 80 wait 1ms
    client <- server tcp syn ack wait 1ms
    client -> server tcp ack wait 1ms
    client -> server http get uri "/api/v1/health" host_hdr "app.internal" wait 5ms
    client <- server http status 200 body "{\"status\":\"healthy\"}" wait 2ms
}

// Authenticated and encrypted SNMPv3 USM trap (HMAC-SHA-256 + AES-128-CFB)
flow snmpv3_linkup_trap(agent, nms) {
    agent -> nms snmp3 trap user "secops_admin" engineid "80001f888011223344"
        auth sha256 "AuthSecretKey99!" priv aes "PrivSecretKey99!"
        oid 1.3.6.1.6.3.1.1.5.4
        varbind 1.3.6.1.2.1.1.5.0 string "app-server-01.internal"
        wait 5ms
}

compile {
    web_session(edge_client, app_server)
    snmpv3_linkup_trap(app_server, nms_collector)
}