// PROMPT: Simulate a brownfield network management audit where legacy SNMPv1, standard SNMPv2c, and encrypted SNMPv3 coexist and report to a single compliance collector.
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, SNMP1, SNMP2, SNMP3, TRAP, GET, RESPONSE, INFORM, COMMUNITY, USER, ENTERPRISE, AGENTIP, GENTRAP, SPECTRAP, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA256, PRIV, AES, REQID, OID, SYSUPTIME, VARBIND, NULLVAL, STRING, INT, COUNTER64, WAIT, ms, COMPILE

// INSTRUCTION: Define a legacy SNMPv1 print server with IP 10.204.0.11.
HOST legacy_v1_dev { IP 10.204.0.11 MAC 00:11:22:cc:00:11 }

// INSTRUCTION: Define a distribution SNMPv2c switch with IP 10.204.0.22.
HOST standard_v2_dev { IP 10.204.0.22 MAC 00:11:22:cc:00:22 }

// INSTRUCTION: Define a core SNMPv3 router with IP 10.204.0.33.
HOST secure_v3_dev { IP 10.204.0.33 MAC 00:11:22:cc:00:33 }

// INSTRUCTION: Define the unified compliance NMS server with IP 10.204.0.250.
HOST compliance_nms { IP 10.204.0.250 MAC 00:11:22:cc:00:fa }

// INSTRUCTION: Define a 4-host flow auditing SNMP1 trap, SNMP2 GET/RESPONSE, and SNMP3 encrypted INFORM/RESPONSE.
FLOW tri_version_snmp_audit(dev1, dev2, dev3, nms) {
    dev1 -> nms SNMP1 TRAP COMMUNITY "public" ENTERPRISE 1.3.6.1.4.1.11 AGENTIP 10.204.0.11 GENTRAP 6 SPECTRAP 3 SYSUPTIME 50000 VARBIND 1.3.6.1.2.1.1.5.0 STRING "hp-jetdirect-v1" WAIT 10ms
    nms -> dev2 SNMP2 GET COMMUNITY "audit_ro" REQID 10601 VARBIND 1.3.6.1.2.1.1.5.0 NULLVAL WAIT 10ms
    nms <- dev2 SNMP2 RESPONSE COMMUNITY "audit_ro" REQID 10601 VARBIND 1.3.6.1.2.1.1.5.0 STRING "dist-sw-v2c" VARBIND 1.3.6.1.2.1.2.1.0 INT 48 WAIT 10ms
    dev3 -> nms SNMP3 INFORM USER "compliance_v3" ENGINEID "80001f8880cc0033" ENGINEBOOTS 18 ENGINETIME 99000 AUTH SHA256 "audit_sha256_pass" PRIV AES "audit_aes128_pass" REQID 10602 OID 1.3.6.1.6.3.1.1.5.4 SYSUPTIME 9900000 VARBIND 1.3.6.1.2.1.1.5.0 STRING "core-rtr-v3" VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 COUNTER64 776655443322 WAIT 10ms
    dev3 <- nms SNMP3 RESPONSE USER "compliance_v3" ENGINEID "80001f8880cc0033" ENGINEBOOTS 18 ENGINETIME 99000 AUTH SHA256 "audit_sha256_pass" PRIV AES "audit_aes128_pass" REQID 10602 VARBIND 1.3.6.1.2.1.1.5.0 STRING "core-rtr-v3" VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 COUNTER64 776655443322 WAIT 10ms
}

// INSTRUCTION: Compile block to execute the tri-version SNMP coexistence audit.
COMPILE {
    tri_version_snmp_audit(legacy_v1_dev, standard_v2_dev, secure_v3_dev, compliance_nms)
}
