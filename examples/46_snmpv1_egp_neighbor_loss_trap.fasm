// PROMPT: Generate an SNMPv1 egpNeighborLoss generic trap (GENTRAP 5) with EGP peer IPVAL and packet loss COUNTER32 variable bindings.
// TOKENS: HOST, IP, MAC, FLOW, ->, SNMP1, TRAP, COMMUNITY, OID, ENTERPRISE, AGENTIP, GENTRAP, SPECTRAP, SYSUPTIME, VARBIND, IPVAL, COUNTER32, COMPILE

// INSTRUCTION: Define a legacy exterior gateway router with IP 10.105.0.1.
HOST egp_router { IP 10.105.0.1 MAC 00:00:0c:aa:05:01 }

// INSTRUCTION: Define a core routing NMS with IP 10.105.0.250.
HOST routing_nms { IP 10.105.0.250 MAC 00:00:0c:aa:05:fa }

// INSTRUCTION: Define a flow sending an SNMPv1 egpNeighborLoss trap (GENTRAP 5) with egpNeighAddr IPVAL and error COUNTER32 varbinds.
FLOW snmpv1_egp_neighbor_loss(agent, nms) {
    agent -> nms SNMP1 TRAP COMMUNITY "public" OID 1.3.6.1.6.3.1.1.5.6 ENTERPRISE 1.3.6.1.2.1.8 AGENTIP 10.105.0.1 GENTRAP 5 SPECTRAP 0 SYSUPTIME 890000 VARBIND 1.3.6.1.2.1.8.5.1.2.192.0.2.9 IPVAL 192.0.2.9 VARBIND 1.3.6.1.2.1.8.5.1.5.192.0.2.9 COUNTER32 42
}

// INSTRUCTION: Compile block to trigger the SNMPv1 egpNeighborLoss trap.
COMPILE {
    snmpv1_egp_neighbor_loss(egp_router, routing_nms)
}
