// PROMPT: Monitor stateful firewall active session count (GAUGE32) and policy drop counters (COUNTER32, COUNTER64) via SNMPv2c GET and RESPONSE.
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, SNMP2, GET, RESPONSE, COMMUNITY, REQID, VARBIND, NULLVAL, GAUGE32, COUNTER32, COUNTER64, WAIT, ms, COMPILE

// INSTRUCTION: Define a SOC monitoring server with IP 10.135.0.10.
HOST soc_poller { IP 10.135.0.10 MAC 00:1b:17:35:00:10 }

// INSTRUCTION: Define a next-generation firewall appliance with IP 10.135.0.1.
HOST ngfw_appliance { IP 10.135.0.1 MAC 00:1b:17:35:00:01 }

// INSTRUCTION: Define a flow querying firewall concurrent sessions and drop counters on port 161.
FLOW poll_firewall_sessions(soc, fw) {
    soc -> fw SNMP2 GET COMMUNITY "fw_soc_ro" REQID 8801 VARBIND 1.3.6.1.4.1.25461.2.1.2.3.3.0 NULLVAL VARBIND 1.3.6.1.4.1.25461.2.1.2.1.14.0 NULLVAL VARBIND 1.3.6.1.4.1.25461.2.1.2.1.15.0 NULLVAL WAIT 10ms
    soc <- fw SNMP2 RESPONSE COMMUNITY "fw_soc_ro" REQID 8801 VARBIND 1.3.6.1.4.1.25461.2.1.2.3.3.0 GAUGE32 142850 VARBIND 1.3.6.1.4.1.25461.2.1.2.1.14.0 COUNTER32 48920 VARBIND 1.3.6.1.4.1.25461.2.1.2.1.15.0 COUNTER64 89234109283 WAIT 10ms
}

// INSTRUCTION: Compile block to execute the firewall session table SNMPv2c poll.
COMPILE {
    poll_firewall_sessions(soc_poller, ngfw_appliance)
}
