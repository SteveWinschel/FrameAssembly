// PROMPT: Generate a maximum-security SNMPv3 authPriv packet using HMAC-SHA-512 (AUTH SHA512), AES-128-CFB (PRIV AES), CONTEXTNAME, and all 9 VARBIND types.
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, SNMP3, GET, RESPONSE, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, CONTEXTNAME, AUTH, SHA512, PRIV, AES, REQID, VARBIND, NULLVAL, STRING, INT, TIMETICKS, IPVAL, OIDVAL, COUNTER32, GAUGE32, COUNTER64, WAIT, ms, COMPILE

// INSTRUCTION: Define a classified enclave monitoring station with IP 10.155.0.10.
HOST enclave_nms { IP 10.155.0.10 MAC 00:25:90:55:00:10 }

// INSTRUCTION: Define a cryptographic gateway agent with IP 10.155.0.1.
HOST crypto_gw_agent { IP 10.155.0.1 MAC 00:25:90:55:00:01 }

// INSTRUCTION: Define a flow exchanging SHA512 + AES encrypted SNMPv3 GET and RESPONSE packets containing all 9 VarBind data types.
FLOW snmpv3_sha512_aes_all_varbinds(nms, gw) {
    nms -> gw SNMP3 GET USER "secops_sha512_aes" ENGINEID "80001f8880550001" ENGINEBOOTS 42 ENGINETIME 500000 CONTEXTNAME "enclave-alpha" REQID 9990 AUTH SHA512 "sha512_top_secret_auth_key" PRIV AES "aes128_top_secret_priv_key" VARBIND 1.3.6.1.2.1.1.1.0 NULLVAL WAIT 10ms
    nms <- gw SNMP3 RESPONSE USER "secops_sha512_aes" ENGINEID "80001f8880550001" ENGINEBOOTS 42 ENGINETIME 500000 CONTEXTNAME "enclave-alpha" REQID 9990 AUTH SHA512 "sha512_top_secret_auth_key" PRIV AES "aes128_top_secret_priv_key" VARBIND 1.3.6.1.2.1.1.4.0 NULLVAL VARBIND 1.3.6.1.2.1.1.5.0 STRING "crypto-gw-alpha" VARBIND 1.3.6.1.4.1.9999.1.2.0 INT -9 VARBIND 1.3.6.1.2.1.1.3.0 TIMETICKS 50000000 VARBIND 1.3.6.1.2.1.4.20.1.1.10.155.0.1 IPVAL 10.155.0.1 VARBIND 1.3.6.1.2.1.1.2.0 OIDVAL 1.3.6.1.4.1.8072.3.2.10 VARBIND 1.3.6.1.2.1.2.2.1.10.1 COUNTER32 12345678 VARBIND 1.3.6.1.2.1.2.2.1.5.1 GAUGE32 1000000000 VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 COUNTER64 18446744073709551 WAIT 10ms
}

// INSTRUCTION: Compile block to execute the SHA512 + AES 9-varbind SNMPv3 flow.
COMPILE {
    snmpv3_sha512_aes_all_varbinds(enclave_nms, crypto_gw_agent)
}
