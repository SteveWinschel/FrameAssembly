// RFC 5227 IPv4 Address Conflict Detection (ACD) ARP probe with zero sender IP
// and subsequent announcement.
// Wire profile: 3 frames; 2 IPv4 hosts; ARP; waits 1s, 2s.
// Wireshark: arp.opcode == 1

host acd_prober {
    ip 192.168.42.77
    mac 08:00:27:a1:b2:c3
}

host lan_listener {
    ip 192.168.42.1
    mac 00:1c:73:00:00:99
}

flow acd_probe_and_announce(prober, segment) {
    prober -> segment arp request sendermac 08:00:27:a1:b2:c3 senderip 0.0.0.0 targetmac 00:00:00:00:00:00 targetip 192.168.42.77 wait 1s
    prober -> segment arp request sendermac 08:00:27:a1:b2:c3 senderip 0.0.0.0 targetmac 00:00:00:00:00:00 targetip 192.168.42.77 wait 2s
    prober -> segment arp request sendermac 08:00:27:a1:b2:c3 senderip 192.168.42.77 targetmac 00:00:00:00:00:00 targetip 192.168.42.77
}

compile {
    acd_probe_and_announce(acd_prober, lan_listener)
}
