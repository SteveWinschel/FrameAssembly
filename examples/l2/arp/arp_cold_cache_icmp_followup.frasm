// ARP request and reply followed immediately by ICMP Echo verification between
// resolved hosts.
// Wire profile: 4 frames; 2 IPv4 hosts; ICMP, ARP; waits 1ms.
// Wireshark: arp || icmp

host cold_cache_host {
    ip 10.44.0.10
    mac 00:15:5d:44:00:0a
}

host local_gateway {
    ip 10.44.0.1
    mac 00:15:5d:44:00:01
}

flow arp_then_ping(host, gw) {
    host -> gw arp request wait 1ms
    host <- gw arp reply wait 1ms
    host -> gw icmp echorequest id 4401 seq 1 wait 1ms
    host <- gw icmp echoreply id 4401 seq 1
}

compile {
    arp_then_ping(cold_cache_host, local_gateway)
}
