// Minimal two-block ARP request starter asking who owns the default gateway IP.
// Uses direct host and compile blocks with standard Ethernet II (0x0806) framing,
// broadcast destination ff:ff:ff:ff:ff:ff, and zeroed target hardware address.
// Check with `frameassembly show arp_default_frame.frasm` or write a capture
// using `frameassembly arp_default_frame.frasm` to inspect in Wireshark.
// Wireshark: arp.opcode == 1

host workstation {
    ip 192.168.1.50
    mac 00:11:22:33:44:50
}

host gateway {
    ip 192.168.1.1
    mac 00:11:22:33:44:01
}

compile {
    workstation -> gateway arp
}
