// Multi-homed storage server resolving dual iSCSI target interfaces across
// independent SAN subnets.
// Wire profile: 4 frames; 4 IPv4 hosts; VLAN 180; ARP; waits 500us.
// Wireshark: vlan.id == 180 && (arp)

host iscsi_init_a {
    ip 172.18.1.10
    mac 00:25:b5:0a:01:0a
}

host iscsi_tgt_a {
    ip 172.18.1.100
    mac 00:25:b5:0a:01:64
}

host iscsi_init_b {
    ip 172.18.2.10
    mac 00:25:b5:0b:02:0a
}

host iscsi_tgt_b {
    ip 172.18.2.100
    mac 00:25:b5:0b:02:64
}

flow san_arp_resolve(init, tgt) {
    init -> tgt vlan 180 arp request wait 500us
    init <- tgt vlan 180 arp reply wait 500us
}

compile {
    san_arp_resolve(iscsi_init_a, iscsi_tgt_a)
    san_arp_resolve(iscsi_init_b, iscsi_tgt_b)
}
