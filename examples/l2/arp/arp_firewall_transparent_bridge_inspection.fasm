// PROMPT: Transparent Layer 2 firewall inspecting ARP Request and Reply between DMZ web server and internal gateway.
// TOKENS: host, ip, mac, flow, arp, request, sha, spa, tha, tpa, wait, ms, reply, compile

// INSTRUCTION: Define DMZ reverse proxy server resolving default gateway MAC address.
host dmz_reverse_proxy {
    ip 172.16.80.10
    mac 00:16:3e:50:00:0a
}

// INSTRUCTION: Define internal perimeter router behind transparent Layer 2 inspection bridge.
host dmz_perimeter_rtr {
    ip 172.16.80.1
    mac 00:16:3e:50:00:01
}

// INSTRUCTION: Exchange standard ARP Request and Reply with explicit SHA, SPA, THA, and TPA verification.
flow arp_dmz_bridge_verify(proxy, rtr) {
    proxy -> rtr arp request sha 00:16:3e:50:00:0a spa 172.16.80.10 tha 00:00:00:00:00:00 tpa 172.16.80.1 wait 5ms
    proxy <- rtr arp reply sha 00:16:3e:50:00:01 spa 172.16.80.1 tha 00:16:3e:50:00:0a tpa 172.16.80.10
}

// INSTRUCTION: Compile the DMZ transparent bridge ARP inspection trace.
compile {
    arp_dmz_bridge_verify(dmz_reverse_proxy, dmz_perimeter_rtr)
}
