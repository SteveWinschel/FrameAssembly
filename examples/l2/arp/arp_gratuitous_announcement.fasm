// PROMPT: Gratuitous ARP announcement broadcast for IP takeover and MAC cache updating.
// TOKENS: host, ip, mac, flow, sender, target, arp, gratuitous, spa, tpa, compile

// INSTRUCTION: Define cluster primary node advertising virtual IP takeover.
host cluster_node {
    ip 10.0.0.10
    mac 52:54:00:12:34:56
}

// INSTRUCTION: Define broadcast destination for gratuitous ARP announcement.
host broadcast_dest {
    ip 255.255.255.255
    mac ff:ff:ff:ff:ff:ff
}

// INSTRUCTION: Define gratuitous ARP flow broadcasting ownership of VIP.
flow garp_flow(sender, target) {
    sender -> target arp gratuitous spa 10.0.0.10 tpa 10.0.0.10
}

// INSTRUCTION: Compile block executing gratuitous ARP broadcast.
compile {
    garp_flow(cluster_node, broadcast_dest)
}
