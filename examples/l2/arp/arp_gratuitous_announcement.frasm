// Gratuitous ARP announcement broadcast for IP takeover and MAC cache updating.
// Wire profile: 1 frame; 2 IPv4 hosts; ARP.
// Wireshark: arp.src.proto_ipv4 == arp.dst.proto_ipv4

host cluster_node {
    ip 10.0.0.10
    mac 52:54:00:12:34:56
}

host broadcast_dest {
    ip 255.255.255.255
    mac ff:ff:ff:ff:ff:ff
}

flow garp_flow(sender, target) {
    sender -> target arp gratuitous spa 10.0.0.10 tpa 10.0.0.10
}

compile {
    garp_flow(cluster_node, broadcast_dest)
}
