// Dual-stack ARP statement between IPv6 endpoints automatically synthesizing RFC
// 4861 ICMPv6 Neighbor Solicitation and Advertisement.
// Wire profile: 2 frames; 2 IPv6 hosts; ARP; waits 5ms.
// Wireshark: icmpv6.type == 135 || icmpv6.type == 136

host compute_v6_node_a {
    ip 2001:db8:500:1::10
    mac 00:1c:73:50:01:0a
}

host storage_v6_node_b {
    ip 2001:db8:500:1::20
    mac 00:1c:73:50:01:14
}

flow arp_ipv6_ndp(a, b) {
    a -> b arp request wait 5ms
    a <- b arp reply
}

compile {
    arp_ipv6_ndp(compute_v6_node_a, storage_v6_node_b)
}
