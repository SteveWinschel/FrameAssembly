// PROMPT: Load balancer floating virtual IP (VIP) takeover with Gratuitous ARP reply broadcast.
// TOKENS: host, ip, mac, flow, router, dstmac, arp, reply, sha, spa, tha, tpa, wait, ms, compile

// INSTRUCTION: Define standby load balancer promoting itself to active VIP owner.
host lb_node_standby {
    ip 198.51.100.50
    mac 02:42:c6:33:64:32
}

// INSTRUCTION: Define upstream edge router updating ARP cache for floating VIP.
host edge_router_wan {
    ip 198.51.100.1
    mac 00:0f:f7:10:20:30
}

// INSTRUCTION: Define broadcast Gratuitous ARP reply updating floating VIP ownership.
flow vip_takeover_garp_reply(lb, router) {
    lb -> router dstmac ff:ff:ff:ff:ff:ff arp reply sha 02:42:c6:33:64:32 spa 198.51.100.50 tha ff:ff:ff:ff:ff:ff tpa 198.51.100.50
    lb -> router dstmac ff:ff:ff:ff:ff:ff arp reply sha 02:42:c6:33:64:32 spa 198.51.100.50 tha ff:ff:ff:ff:ff:ff tpa 198.51.100.50 wait 100ms
}

// INSTRUCTION: Compile block executing VIP takeover broadcast ARP reply.
compile {
    vip_takeover_garp_reply(lb_node_standby, edge_router_wan)
}
