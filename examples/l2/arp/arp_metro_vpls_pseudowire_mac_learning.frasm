// Customer edge routers resolving next-hop MAC addresses across an MPLS VPLS
// pseudowire (Label 40500).
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 40500; ARP; waits 5ms.
// Wireshark: arp

host vpls_ce_site_a {
    ip 172.31.100.1
    mac 00:1e:be:64:00:01
}

host vpls_ce_site_b {
    ip 172.31.100.2
    mac 00:1e:be:64:00:02
}

flow arp_over_mpls_vpls(ce_a, ce_b) {
    ce_a -> ce_b mpls 40500 exp 5 bos 1 mplsttl 64 arp request sendermac 00:1e:be:64:00:01 senderip 172.31.100.1 targetip 172.31.100.2 wait 5ms
    ce_a <- ce_b mpls 40500 exp 5 bos 1 mplsttl 64 arp reply sendermac 00:1e:be:64:00:02 senderip 172.31.100.2 targetmac 00:1e:be:64:00:01 targetip 172.31.100.1
}

compile {
    arp_over_mpls_vpls(vpls_ce_site_a, vpls_ce_site_b)
}
