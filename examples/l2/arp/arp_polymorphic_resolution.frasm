// PROMPT: Address resolution with ARP request/reply on IPv4 and NDP Neighbor Solicitation on IPv6.
// TOKENS: host, ip, flow, arp, reply, ndp, neighborsolicit, compile

// INSTRUCTION: Define IPv4 endpoint A.
host ipv4_host_a { ip 192.168.10.1 }

// INSTRUCTION: Define IPv4 endpoint B.
host ipv4_host_b { ip 192.168.10.2 }

// INSTRUCTION: Define IPv6 endpoint A.
host ipv6_host_a { ip 2001:db8::1 }

// INSTRUCTION: Define IPv6 endpoint B.
host ipv6_host_b { ip 2001:db8::2 }

// INSTRUCTION: Define IPv4 ARP resolution flow.
flow arp_resolution(a, b) {
    a -> b arp
    a <- b arp reply
}

// INSTRUCTION: Define IPv6 NDP neighbor discovery flow.
flow ndp_resolution(a, b) {
    a -> b ndp neighborsolicit
}

// INSTRUCTION: Compile block executing both address resolution flows.
compile {
    arp_resolution(ipv4_host_a, ipv4_host_b)
    ndp_resolution(ipv6_host_a, ipv6_host_b)
}
