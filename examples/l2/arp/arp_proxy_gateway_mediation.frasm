// Proxy ARP gateway replying on behalf of an isolated subnet host with explicit
// target IP and sender MAC.
// Wire profile: 2 frames; 2 IPv4 hosts; ARP; waits 2ms.
// Wireshark: arp

host workstation_lan {
    ip 10.24.1.15
    mac 00:1b:63:84:45:e6
}

host proxy_arp_gw {
    ip 10.24.1.1
    mac 00:00:0c:9f:f0:01
}

flow proxy_arp_resolution(client, router) {
    client -> router arp request spa 10.24.1.15 tpa 10.24.2.99 wait 2ms
    client <- router arp reply sha 00:00:0c:9f:f0:01 spa 10.24.2.99 tha 00:1b:63:84:45:e6 tpa 10.24.1.15
}

compile {
    proxy_arp_resolution(workstation_lan, proxy_arp_gw)
}
