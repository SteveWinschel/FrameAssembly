// Metro Ethernet QinQ double-tagged ARP request and reply between customer branch
// routers.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 300 / C-VLAN 100; ARP; waits
// 4ms.
// Wireshark: arp

host ce_branch_east {
    ip 172.22.100.1
    mac 00:1e:67:aa:bb:01
}

host ce_branch_west {
    ip 172.22.100.2
    mac 00:1e:67:aa:bb:02
}

flow qinq_arp_exchange(east, west) {
    east -> west qinq 300 innervlan 100 arp request wait 4ms
    east <- west qinq 300 innervlan 100 arp reply
}

compile {
    qinq_arp_exchange(ce_branch_east, ce_branch_west)
}
