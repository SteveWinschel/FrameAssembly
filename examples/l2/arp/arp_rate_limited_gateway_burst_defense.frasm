// Core router resolving multiple downstream host next-hops in a rate-limited ARP
// Request loop.
// Wire profile: 6 frames; 2 IPv4 hosts; ARP; waits 10ms.
// Wireshark: arp

host campus_agg_rtr {
    ip 10.120.0.1
    mac 00:1c:73:78:00:01
}

host campus_desk_pc {
    ip 10.120.0.88
    mac 00:21:70:78:00:58
}

flow arp_periodic_refresh(rtr, pc) {
    rtr -> pc arp request sendermac 00:1c:73:78:00:01 senderip 10.120.0.1 targetmac 00:21:70:78:00:58 targetip 10.120.0.88 dstmac 00:21:70:78:00:58 wait 10ms
    rtr <- pc arp reply sendermac 00:21:70:78:00:58 senderip 10.120.0.88 targetmac 00:1c:73:78:00:01 targetip 10.120.0.1
}

compile {
    arp_periodic_refresh(campus_agg_rtr, campus_desk_pc) // Iteration 1 of 3
    arp_periodic_refresh(campus_agg_rtr, campus_desk_pc) // Iteration 2 of 3
    arp_periodic_refresh(campus_agg_rtr, campus_desk_pc) // Iteration 3 of 3
}
