// PROMPT: Standard ARP request broadcast and unicast reply on IPv4 subnet.
// TOKENS: host, ip, mac, gateway, flow, router, arp, reply, compile

// INSTRUCTION: Define IPv4 workstation endpoint.
host workstation {
    ip 192.168.1.50
    mac 00:11:22:33:44:50
}

// INSTRUCTION: Define IPv4 default gateway endpoint.
host gateway {
    ip 192.168.1.1
    mac 00:11:22:33:44:01
}

// INSTRUCTION: Define standard ARP request and reply address resolution flow.
flow arp_exchange(client, router) {
    client -> router arp
    client <- router arp reply
}

// INSTRUCTION: Compile block executing ARP resolution exchange.
compile {
    arp_exchange(workstation, gateway)
}
