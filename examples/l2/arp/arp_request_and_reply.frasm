// Standard ARP request broadcast and unicast reply on IPv4 subnet.
// Wire profile: 2 frames; 2 IPv4 hosts; ARP.
// Wireshark: arp.opcode == 2

host workstation {
    ip 192.168.1.50
    mac 00:11:22:33:44:50
}

host gateway {
    ip 192.168.1.1
    mac 00:11:22:33:44:01
}

flow arp_exchange(client, router) {
    client -> router arp
    client <- router arp reply
}

compile {
    arp_exchange(workstation, gateway)
}
