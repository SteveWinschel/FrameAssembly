// Subnet-wide ARP discovery sweep probing sequential host IP addresses from a
// network scanner.
// Wire profile: 4 frames; 2 IPv4 hosts; ARP; waits 5ms.
// Wireshark: arp.opcode == 1

host net_scanner {
    ip 10.15.0.5
    mac 00:16:3e:77:88:99
}

host subnet_target {
    ip 10.15.0.254
    mac ff:ff:ff:ff:ff:ff
}

flow arp_subnet_sweep(scanner, broadcast) {
    scanner -> broadcast arp request sha 00:16:3e:77:88:99 spa 10.15.0.5 tpa 10.15.0.10 wait 5ms
    scanner -> broadcast arp request sha 00:16:3e:77:88:99 spa 10.15.0.5 tpa 10.15.0.11 wait 5ms
    scanner -> broadcast arp request sha 00:16:3e:77:88:99 spa 10.15.0.5 tpa 10.15.0.12 wait 5ms
    scanner -> broadcast arp request sha 00:16:3e:77:88:99 spa 10.15.0.5 tpa 10.15.0.13
}

compile {
    arp_subnet_sweep(net_scanner, subnet_target)
}
