// Industrial Ethernet ARP resolution with trailing diagnostic trailer payload for
// switch padding inspection.
// Wire profile: 2 frames; 2 IPv4 hosts; ARP; waits 2ms.
// Wireshark: arp

host plc_master {
    ip 192.168.250.10
    mac 00:0e:8c:fa:00:0a
}

host rio_coupler {
    ip 192.168.250.20
    mac 00:0e:8c:fa:00:14
}

flow industrial_padded_arp(plc, rio) {
    plc -> rio arp request hexpayload "000000000000000000000000000000000000" wait 2ms
    plc <- rio arp reply hexpayload "a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5"
}

compile {
    industrial_padded_arp(plc_master, rio_coupler)
}
