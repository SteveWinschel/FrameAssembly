// Live VM migration MAC mobility announcement using repeated Gratuitous ARP
// broadcasts.
// Wire profile: 3 frames; 2 IPv4 hosts; VLAN 88; ARP.
// Wireshark: vlan.id == 88 && (arp.src.proto_ipv4 == arp.dst.proto_ipv4)

host migrated_vm {
    ip 10.88.12.40
    mac 52:54:00:88:12:40
}

host tor_leaf_sw {
    ip 10.88.12.1
    mac 00:02:c9:11:22:01
}

flow vm_mobility_garp(vm, tor) {
    vm -> tor vlan 88 arp gratuitous sha 52:54:00:88:12:40 spa 10.88.12.40
}

compile {
    vm_mobility_garp(migrated_vm, tor_leaf_sw) // Iteration 1 of 3
    vm_mobility_garp(migrated_vm, tor_leaf_sw) // Iteration 2 of 3
    vm_mobility_garp(migrated_vm, tor_leaf_sw) // Iteration 3 of 3
}
