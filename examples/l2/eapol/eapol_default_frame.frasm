// Minimal two-block IEEE 802.1X EAPOL starter over MAC-only switch and client ports.
// Sends a default EAP-Request/Identity frame (EtherType 0x888E) to the IEEE PAE
// multicast address 01:80:c2:00:00:03 without needing an IP address or flow block.
// Preview with `frameassembly show eapol_default_frame.frasm` or generate a trace
// via `frameassembly eapol_default_frame.frasm` before NAC switch testing.
// Wireshark: eapol

host authenticator_sw { mac 00:1c:73:18:00:01 }
host supplicant_pc { mac 00:21:cc:18:00:32 }

compile {
    authenticator_sw -> supplicant_pc eapol
}
