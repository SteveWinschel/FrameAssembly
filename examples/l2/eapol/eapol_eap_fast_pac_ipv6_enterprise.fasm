// PROMPT: EAP-FAST (Method 43) Protected Access Credential (PAC) tunnel provisioning on an IPv6-only enterprise access network.
// TOKENS: host, ip, mac, flow, eapol, version, type, eappacket, eapcode, eapid, eapmethod, identity, wait, ms, payload, compile

// INSTRUCTION: Define IPv6-only enterprise workstation supplicant.
host ipv6_fast_client {
    ip 2001:db8:1000:43::100
    mac 00:50:56:10:43:64
}

// INSTRUCTION: Define IPv6-only enterprise access switch authenticator.
host ipv6_fast_switch {
    ip 2001:db8:1000:43::1
    mac 00:1c:73:10:43:01
}

// INSTRUCTION: Define EAP-FAST (EAP_METHOD 43) PAC-Key tunnel authentication over IPv6 endpoints.
flow eapol_eap_fast_ipv6(cli, sw) {
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 30 eapmethod 1
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 30 eapmethod 1 identity "fast-user@ipv6.corp.net" wait 2ms
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 31 eapmethod 43 payload "eap_fast_authority_id_pac_req" wait 3ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 31 eapmethod 43 payload "eap_fast_pac_opaque_ticket" wait 3ms
    cli <- sw eapol version 2 type eappacket eapcode 3 eapid 32 eapmethod 43 wait 3ms
}

// INSTRUCTION: Compile block executing EAP-FAST authentication over IPv6 hosts.
compile {
    eapol_eap_fast_ipv6(ipv6_fast_client, ipv6_fast_switch)
}
