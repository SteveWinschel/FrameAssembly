// EAP-FAST (Method 43) Protected Access Credential (PAC) tunnel provisioning on
// an IPv6-only enterprise access network.
// Wire profile: 5 frames; 2 IPv6 hosts; EAPOL; waits 2ms, 3ms.
// Wireshark: eapol || eap

host ipv6_fast_client {
    ip 2001:db8:1000:43::100
    mac 00:50:56:10:43:64
}

host ipv6_fast_switch {
    ip 2001:db8:1000:43::1
    mac 00:1c:73:10:43:01
}

flow eapol_eap_fast_ipv6(cli, sw) {
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 30 eapmethod 1 wait 2ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 30 eapmethod 1 identity "fast-user@ipv6.corp.net" wait 3ms
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 31 eapmethod 43 payload "eap_fast_authority_id_pac_req" wait 3ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 31 eapmethod 43 payload "eap_fast_pac_opaque_ticket" wait 3ms
    cli <- sw eapol version 2 type eappacket eapcode 3 eapid 32 eapmethod 43
}

compile {
    eapol_eap_fast_ipv6(ipv6_fast_client, ipv6_fast_switch)
}
