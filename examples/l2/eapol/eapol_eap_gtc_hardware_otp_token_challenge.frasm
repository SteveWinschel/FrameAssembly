// PROMPT: High-security laboratory terminal authenticating via EAP-GTC (Generic Token Card, EAP_METHOD 6) one-time password challenge.
// TOKENS: host, ip, mac, flow, eapol, version, type, start, wait, ms, eappacket, eapcode, eapid, eapmethod, identity, payload, compile

// INSTRUCTION: Define air-gapped lab terminal supplicant responding with hardware OTP token code.
host lab_terminal_supp {
    ip 172.29.10.50
    mac 00:21:70:1d:0a:32
}

// INSTRUCTION: Define lab security switch port enforcing EAP-GTC token verification.
host lab_sec_switch {
    ip 172.29.10.1
    mac 00:1c:73:1d:0a:01
}

// INSTRUCTION: Exchange EAP-Identity and EAP-GTC (Method 6) ASCII OTP challenge/response followed by EAP-Success.
flow eapol_gtc_otp_auth(term, sw) {
    term -> sw eapol version 2 type start wait 2ms
    term <- sw eapol version 2 type eappacket eapcode 1 eapid 20 eapmethod 1 wait 2ms
    term -> sw eapol version 2 type eappacket eapcode 2 eapid 20 eapmethod 1 identity "dr.chen@quantum-lab.internal" wait 5ms
    term <- sw eapol version 2 type eappacket eapcode 1 eapid 21 eapmethod 6 payload "Challenge: Enter Hardware YubiKey OTP:" wait 10ms
    term -> sw eapol version 2 type eappacket eapcode 2 eapid 21 eapmethod 6 payload "ccccccbcgujhingjrdejhgfnuetrgigvejhh" wait 5ms
    term <- sw eapol version 2 type eappacket eapcode 3 eapid 21 eapmethod 6
}

// INSTRUCTION: Compile the EAP-GTC hardware OTP token authentication trace.
compile {
    eapol_gtc_otp_auth(lab_terminal_supp, lab_sec_switch)
}
