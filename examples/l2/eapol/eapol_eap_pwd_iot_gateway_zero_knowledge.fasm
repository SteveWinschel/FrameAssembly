// PROMPT: Industrial IoT gateway authenticating via RFC 5931 EAP-pwd (EAP_METHOD 52) zero-knowledge password proof over IPv6.
// TOKENS: host, ip, mac, flow, eapol, version, type, start, wait, ms, eappacket, eapcode, eapid, eapmethod, identity, payload, compile

// INSTRUCTION: Define IPv6 industrial IoT edge gateway using RFC 5931 EAP-pwd (Method 52).
host iot_gw_v6_supp {
    ip 2001:db8:520::10
    mac 00:0e:8c:52:00:0a
}

// INSTRUCTION: Define IPv6 industrial switch authenticator verifying EAP-pwd dragonfly commit/confirm.
host ind_sw_v6_pae {
    ip 2001:db8:520::1
    mac 00:1c:73:52:00:01
}

// INSTRUCTION: Exchange EAP-Identity and EAP-pwd (Method 52) Commit/Confirm frames ending in EAP-Success.
flow eapol_eap_pwd_iot(gw, sw) {
    gw -> sw eapol version 2 type start wait 2ms
    gw <- sw eapol version 2 type eappacket eapcode 1 eapid 8 eapmethod 1 wait 2ms
    gw -> sw eapol version 2 type eappacket eapcode 2 eapid 8 eapmethod 1 identity "iot-gw-substation-08" wait 5ms
    gw <- sw eapol version 2 type eappacket eapcode 1 eapid 9 eapmethod 52 payload "EAP_PWD_ID_COMMIT_ECC_GROUP_19" wait 5ms
    gw -> sw eapol version 2 type eappacket eapcode 2 eapid 9 eapmethod 52 payload "EAP_PWD_PEER_COMMIT_CONFIRM_SCALAR" wait 5ms
    gw <- sw eapol version 2 type eappacket eapcode 3 eapid 9 eapmethod 52
}

// INSTRUCTION: Compile the RFC 5931 EAP-pwd IoT gateway authentication trace.
compile {
    eapol_eap_pwd_iot(iot_gw_v6_supp, ind_sw_v6_pae)
}
