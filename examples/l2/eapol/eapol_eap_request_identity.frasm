// IEEE 802.1X EAP-Packet exchange requesting and supplying user identity string.
// Wire profile: 2 frames; 2 IPv4 hosts; EAPOL.
// Wireshark: eapol || eap

host client_supplicant { ip 192.168.1.100 }

host radius_auth_server { ip 192.168.1.2 }

flow eapol_identity_flow(cli, srv) {
    cli <- srv eapol type eappacket eapcode 1 eapid 1 eapmethod 1
    cli -> srv eapol type eappacket eapcode 2 eapid 1 eapmethod 1 identity "alice@corp.local"
}

compile {
    eapol_identity_flow(client_supplicant, radius_auth_server)
}
