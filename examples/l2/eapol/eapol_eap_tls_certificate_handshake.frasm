// IEEE 802.1X EAP-TLS (Method 13) mutual certificate authentication exchange with
// X.509 certificate fragment payloads.
// Wire profile: 5 frames; 2 IPv4 hosts; EAPOL; waits 2ms, 3ms, 4ms, 5ms.
// Wireshark: eapol || eap

host eaptls_client {
    ip 10.42.10.88
    mac f8:75:a4:42:10:58
}

host eaptls_switch {
    ip 10.42.10.1
    mac 00:1c:73:42:10:01
}

flow eapol_eap_tls_certificate(cli, sw) {
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1 wait 2ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 1 eapmethod 1 identity "host/laptop-88.corp.example.com" wait 3ms
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 2 eapmethod 13 payload "eap_tls_start_flag_0x20" wait 4ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 2 eapmethod 13 payload "eap_tls_client_hello_and_x509_cert" wait 5ms
    cli <- sw eapol version 2 type eappacket eapcode 3 eapid 3 eapmethod 13
}

compile {
    eapol_eap_tls_certificate(eaptls_client, eaptls_switch)
}
