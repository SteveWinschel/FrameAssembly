// PROMPT: IEEE 802.1X EAP-TLS (Method 13) mutual certificate authentication exchange with X.509 certificate fragment payloads.
// TOKENS: host, ip, mac, flow, eapol, version, type, eappacket, eapcode, eapid, eapmethod, identity, wait, ms, payload, compile

// INSTRUCTION: Define corporate laptop with TPM client certificate.
host eaptls_client {
    ip 10.42.10.88
    mac f8:75:a4:42:10:58
}

// INSTRUCTION: Define zero-trust campus access switch authenticator.
host eaptls_switch {
    ip 10.42.10.1
    mac 00:1c:73:42:10:01
}

// INSTRUCTION: Define EAP-TLS (Method 13) Start, ClientHello/Certificate exchange, and EAP-Success (Code 3).
flow eapol_eap_tls_certificate(cli, sw) {
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 1 eapmethod 1 identity "host/laptop-88.corp.example.com" wait 2ms
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 2 eapmethod 13 payload "eap_tls_start_flag_0x20" wait 3ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 2 eapmethod 13 payload "eap_tls_client_hello_and_x509_cert" wait 4ms
    cli <- sw eapol version 2 type eappacket eapcode 3 eapid 3 eapmethod 13 wait 5ms
}

// INSTRUCTION: Compile block executing EAP-TLS mutual certificate authentication.
compile {
    eapol_eap_tls_certificate(eaptls_client, eaptls_switch)
}
