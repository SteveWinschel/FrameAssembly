// Guest VLAN fallback remediation after IEEE 802.1X EAP-Identity timeout and DHCP
// quarantine assignment.
// Wire profile: 4 frames; 2 IPv4 hosts; VLAN 254; DHCP, EAPOL; waits 30s, 5s,
// 5ms.
// Wireshark: eapol || eap

host non_dot1x_printer {
    ip 192.168.254.80
    mac 00:17:c8:fe:00:50
}

host guest_fallback_sw {
    ip 192.168.254.1
    mac 00:1c:73:fe:00:01
}

flow dot1x_guest_vlan_fallback(prt, sw) {
    prt <- sw eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1 wait 30s
    prt <- sw eapol version 2 type eappacket eapcode 1 eapid 2 eapmethod 1 wait 5s
    prt -> sw vlan 254 dhcp discover wait 5ms
    prt <- sw vlan 254 dhcp offer yiaddr 192.168.254.80
}

compile {
    dot1x_guest_vlan_fallback(non_dot1x_printer, guest_fallback_sw)
}
