// PROMPT: IEEE 802.1X EAPOL logoff frame terminating an authenticated network port session.
// TOKENS: HOST, IP, FLOW, ->, EAPOL, TYPE, LOGOFF, COMPILE

// INSTRUCTION: Define client disconnecting from secured access port.
HOST departing_client { IP 10.1.1.55 }

// INSTRUCTION: Define edge switch port receiving logoff.
HOST switch_edge { IP 10.1.1.1 }

// INSTRUCTION: Define 802.1X session termination flow sending EAPOL-Logoff.
FLOW eapol_logoff_flow(src, dst) {
    src -> dst EAPOL TYPE LOGOFF
}

// INSTRUCTION: Compile block executing port logoff transmission.
COMPILE {
    eapol_logoff_flow(departing_client, switch_edge)
}
