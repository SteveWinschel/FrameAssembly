// IEEE 802.1ad Provider Bridge PAE group address (01:80:c2:00:00:08) EAPOL
// authentication between Metro Ethernet NIDs.
// Wire profile: 4 frames; 2 IPv4 hosts; EAPOL; waits 2ms, 4ms.
// Wireshark: eapol || eap

host metro_cpe_nid {
    ip 172.30.10.2
    mac 00:15:ad:30:10:02
}

host metro_agg_pe {
    ip 172.30.10.1
    mac 00:15:ad:30:10:01
}

flow metro_nid_eapol_auth(nid, pe) {
    nid -> pe dstmac 01:80:c2:00:00:08 eapol version 2 type start wait 2ms
    nid <- pe dstmac 01:80:c2:00:00:08 eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1 wait 2ms
    nid -> pe dstmac 01:80:c2:00:00:08 eapol version 2 type eappacket eapcode 2 eapid 1 eapmethod 1 identity "nid-cpe-branch42@carrier.net" wait 4ms
    nid <- pe dstmac 01:80:c2:00:00:08 eapol version 2 type eappacket eapcode 3 eapid 1 eapmethod 1
}

compile {
    metro_nid_eapol_auth(metro_cpe_nid, metro_agg_pe)
}
