// Minimal IEEE 802.1X EAPOL frame sending a default EAP-Request/Identity packet.
// Uses direct host and compile blocks (two-block syntax) targeting IEEE PAE
// multicast 01:80:c2:00:00:03 over EtherType 0x888E with built-in defaults.
// Inspect via `frameassembly show eapol_minimal_zero_keyword_default.frasm` or
// compile to PCAP before testing 802.1X switch supplicant handling.
// Wireshark: eapol

host dot1x_auth_port {
    ip 10.18.0.1
    mac 00:1c:73:18:00:01
}

host dot1x_supp_port {
    ip 10.18.0.50
    mac 00:21:cc:18:00:32
}

compile {
    dot1x_auth_port -> dot1x_supp_port eapol
}
