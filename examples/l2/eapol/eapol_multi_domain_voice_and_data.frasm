// Multi-Domain Authentication (MDA) on a single switch port authenticating both a
// VoIP phone on voice VLAN 110 and a PC.
// Wire profile: 6 frames; 3 IPv4 hosts; VLAN 110; PCP 6; EAPOL; waits 2ms, 3ms.
// Wireshark: eapol || eap

host mda_voip_phone {
    ip 10.110.1.25
    mac 00:04:f2:6e:01:19
}

host mda_desktop_pc {
    ip 10.120.1.25
    mac 00:23:24:78:01:19
}

host mda_switch_port {
    ip 10.110.1.1
    mac 00:1e:be:6e:01:01
}

flow multi_domain_dot1x(phone, pc, sw) {
    phone <- sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1 wait 2ms
    phone -> sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 2 eapid 1 eapmethod 1 identity "CP-8861-SEP0004F26E0119" wait 3ms
    phone <- sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 3 eapid 1 eapmethod 1 wait 2ms
    pc <- sw eapol version 2 type eappacket eapcode 1 eapid 2 eapmethod 1 wait 2ms
    pc -> sw eapol version 2 type eappacket eapcode 2 eapid 2 eapmethod 1 identity "CORP\\jdoe" wait 3ms
    pc <- sw eapol version 2 type eappacket eapcode 3 eapid 2 eapmethod 1
}

compile {
    multi_domain_dot1x(mda_voip_phone, mda_desktop_pc, mda_switch_port)
}
