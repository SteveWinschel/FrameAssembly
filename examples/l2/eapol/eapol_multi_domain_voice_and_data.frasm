// PROMPT: Multi-Domain Authentication (MDA) on a single switch port authenticating both a VoIP phone on voice VLAN 110 and a PC.
// TOKENS: host, ip, mac, flow, vlan, pcp, eapol, version, type, eappacket, eapcode, eapid, eapmethod, identity, wait, ms, compile

// INSTRUCTION: Define VoIP desk phone authenticating in the Voice domain.
host mda_voip_phone {
    ip 10.110.1.25
    mac 00:04:f2:6e:01:19
}

// INSTRUCTION: Define desktop workstation daisy-chained behind the VoIP phone in the Data domain.
host mda_desktop_pc {
    ip 10.120.1.25
    mac 00:23:24:78:01:19
}

// INSTRUCTION: Define single switch port authenticator supporting 802.1X Multi-Domain Authentication.
host mda_switch_port {
    ip 10.110.1.1
    mac 00:1e:be:6e:01:01
}

// INSTRUCTION: Define sequential voice domain and data domain 802.1X EAPOL authentication on shared port.
flow multi_domain_dot1x(phone, pc, sw) {
    phone <- sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 1 eapid 1 eapmethod 1
    phone -> sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 2 eapid 1 eapmethod 1 identity "CP-8861-SEP0004F26E0119" wait 2ms
    phone <- sw vlan 110 pcp 6 eapol version 2 type eappacket eapcode 3 eapid 1 eapmethod 1 wait 3ms
    pc <- sw eapol version 2 type eappacket eapcode 1 eapid 2 eapmethod 1 wait 2ms
    pc -> sw eapol version 2 type eappacket eapcode 2 eapid 2 eapmethod 1 identity "CORP\\jdoe" wait 2ms
    pc <- sw eapol version 2 type eappacket eapcode 3 eapid 2 eapmethod 1 wait 3ms
}

// INSTRUCTION: Compile block executing Multi-Domain Authentication for Voice and Data endpoints.
compile {
    multi_domain_dot1x(mda_voip_phone, mda_desktop_pc, mda_switch_port)
}
