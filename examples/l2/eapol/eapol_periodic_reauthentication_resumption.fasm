// PROMPT: Periodic 802.1X re-authentication timer expiry triggering a fresh EAP-Identity and EAP-TLS verification without dropping link.
// TOKENS: HOST, IP, MAC, FLOW, EAPOL, VERSION, TYPE, EAP_PACKET, EAP_CODE, EAP_ID, EAP_METHOD, IDENTITY, WAIT, PAYLOAD, COMPILE

// INSTRUCTION: Define authenticated medical imaging workstation on hospital VLAN.
HOST pacs_workstation {
    IP 10.75.20.33
    MAC 00:1b:21:75:14:21
}

// INSTRUCTION: Define hospital access switch enforcing 3600-second periodic 802.1X re-authentication.
HOST hospital_edge_sw {
    IP 10.75.20.1
    MAC 00:1c:73:75:14:01
}

// INSTRUCTION: Define authenticator-initiated periodic re-authentication with high EAP_ID sequence numbers.
FLOW eapol_periodic_reauth(ws, sw) {
    ws <- sw EAPOL VERSION 2 TYPE EAP_PACKET EAP_CODE 1 EAP_ID 200 EAP_METHOD 1
    ws -> sw EAPOL VERSION 2 TYPE EAP_PACKET EAP_CODE 2 EAP_ID 200 EAP_METHOD 1 IDENTITY "pacs-ws33.radiology.hosp" WAIT 1ms
    ws <- sw EAPOL VERSION 2 TYPE EAP_PACKET EAP_CODE 1 EAP_ID 201 EAP_METHOD 13 PAYLOAD "eap_tls_session_ticket_resumption" WAIT 2ms
    ws -> sw EAPOL VERSION 2 TYPE EAP_PACKET EAP_CODE 2 EAP_ID 201 EAP_METHOD 13 PAYLOAD "eap_tls_client_finished_verify" WAIT 2ms
    ws <- sw EAPOL VERSION 2 TYPE EAP_PACKET EAP_CODE 3 EAP_ID 202 EAP_METHOD 13 WAIT 2ms
}

// INSTRUCTION: Compile block executing periodic 802.1X session re-authentication.
COMPILE {
    eapol_periodic_reauth(pacs_workstation, hospital_edge_sw)
}
