// PROMPT: EAPOL-Start retransmission loop from a booting PXE workstation waiting for a slow spanning-tree port to unblock.
// TOKENS: host, ip, mac, flow, eapol, version, type, start, wait, s, compile

// INSTRUCTION: Define booting PXE workstation sending periodic EAPOL-Start frames.
host pxe_boot_client {
    ip 0.0.0.0
    mac 00:50:56:aa:00:01
}

// INSTRUCTION: Define access switch port still in STP learning state.
host learning_sw_port {
    ip 10.10.0.1
    mac 00:1c:73:0a:00:01
}

// INSTRUCTION: Define EAPOL-Start retry frame with 3-second supplicant timeout interval.
flow eapol_start_retry(cli, sw) {
    cli -> sw eapol version 2 type start wait 3s
}

// INSTRUCTION: Compile block executing 3 consecutive EAPOL-Start retries in a loop.
compile {
    eapol_start_retry(pxe_boot_client, learning_sw_port) // cycle 1
    eapol_start_retry(pxe_boot_client, learning_sw_port) // cycle 2
    eapol_start_retry(pxe_boot_client, learning_sw_port) // cycle 3
}
