// EAPOL-Start retransmission loop from a booting PXE workstation waiting for a
// slow spanning-tree port to unblock.
// Wire profile: 3 frames; 2 IPv4 hosts; EAPOL; waits 3s.
// Wireshark: eapol

host pxe_boot_client {
    ip 0.0.0.0
    mac 00:50:56:aa:00:01
}

host learning_sw_port {
    ip 10.10.0.1
    mac 00:1c:73:0a:00:01
}

flow eapol_start_retry(cli, sw) {
    cli -> sw eapol version 2 type start wait 3s
}

compile {
    eapol_start_retry(pxe_boot_client, learning_sw_port) // Iteration 1 of 3
    eapol_start_retry(pxe_boot_client, learning_sw_port) // Iteration 2 of 3
    eapol_start_retry(pxe_boot_client, learning_sw_port) // Iteration 3 of 3
}
