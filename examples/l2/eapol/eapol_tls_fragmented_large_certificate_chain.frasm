// EAP-TLS (EAP_METHOD 13) handshake exchanging multi-fragment X.509 certificate
// chains across consecutive EAP_ID increments.
// Wire profile: 5 frames; 2 IPv4 hosts; EAPOL; waits 2ms, 5ms.
// Wireshark: eapol || eap

host pki_client_supp {
    ip 10.92.1.33
    mac 00:21:70:5c:01:21
}

host pki_switch_auth {
    ip 10.92.1.1
    mac 00:1c:73:5c:01:01
}

flow eapol_tls_cert_fragments(cli, sw) {
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 10 eapmethod 13 payload "EAP_TLS_SRV_CERT_FRAG_1_MORE_BIT_SET" wait 2ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 10 eapmethod 13 payload "EAP_TLS_FRAG_ACK" wait 2ms
    cli <- sw eapol version 2 type eappacket eapcode 1 eapid 11 eapmethod 13 payload "EAP_TLS_SRV_CERT_FRAG_2_FINAL" wait 2ms
    cli -> sw eapol version 2 type eappacket eapcode 2 eapid 11 eapmethod 13 payload "EAP_TLS_CLI_CERT_CHAIN_VERIFY" wait 5ms
    cli <- sw eapol version 2 type eappacket eapcode 3 eapid 12 eapmethod 13
}

compile {
    eapol_tls_cert_fragments(pki_client_supp, pki_switch_auth)
}
