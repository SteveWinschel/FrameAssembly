// PROMPT: EAP-TTLS (Method 21) authentication session followed by graceful user logout via EAPOL-Logoff.
// TOKENS: host, ip, mac, flow, auth, eapol, version, type, eappacket, eapcode, eapid, eapmethod, identity, wait, ms, payload, logoff, s, compile

// INSTRUCTION: Define university eduroam laptop supplicant.
host eduroam_supplicant {
    ip 10.130.4.99
    mac d8:cb:8a:82:04:63
}

// INSTRUCTION: Define campus wireless controller authenticator.
host eduroam_authenticator {
    ip 10.130.4.1
    mac 00:24:97:82:04:01
}

// INSTRUCTION: Define EAP-TTLS (Method 21) authentication, session success, and subsequent EAPOL-Logoff.
flow eapol_ttls_and_logoff(supp, auth) {
    supp <- auth eapol version 2 type eappacket eapcode 1 eapid 7 eapmethod 1
    supp -> auth eapol version 2 type eappacket eapcode 2 eapid 7 eapmethod 1 identity "anonymous@university.edu" wait 2ms
    supp <- auth eapol version 2 type eappacket eapcode 1 eapid 8 eapmethod 21 payload "eap_ttls_v0_server_hello" wait 3ms
    supp -> auth eapol version 2 type eappacket eapcode 2 eapid 8 eapmethod 21 payload "eap_ttls_avp_pap_credentials" wait 3ms
    supp <- auth eapol version 2 type eappacket eapcode 3 eapid 9 eapmethod 21 wait 3ms
    supp -> auth eapol version 2 type logoff wait 60s
}

// INSTRUCTION: Compile block executing eduroam EAP-TTLS login and EAPOL-Logoff.
compile {
    eapol_ttls_and_logoff(eduroam_supplicant, eduroam_authenticator)
}
