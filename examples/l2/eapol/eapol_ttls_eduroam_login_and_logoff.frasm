// EAP-TTLS (Method 21) authentication session followed by graceful user logout
// via EAPOL-Logoff.
// Wire profile: 6 frames; 2 IPv4 hosts; EAPOL; waits 2ms, 3ms, 60s.
// Wireshark: eapol.type == 1 || eapol.type == 2

host eduroam_supplicant {
    ip 10.130.4.99
    mac d8:cb:8a:82:04:63
}

host eduroam_authenticator {
    ip 10.130.4.1
    mac 00:24:97:82:04:01
}

flow eapol_ttls_and_logoff(supp, auth) {
    supp <- auth eapol version 2 type eappacket eapcode 1 eapid 7 eapmethod 1 wait 2ms
    supp -> auth eapol version 2 type eappacket eapcode 2 eapid 7 eapmethod 1 identity "anonymous@university.edu" wait 3ms
    supp <- auth eapol version 2 type eappacket eapcode 1 eapid 8 eapmethod 21 payload "eap_ttls_v0_server_hello" wait 3ms
    supp -> auth eapol version 2 type eappacket eapcode 2 eapid 8 eapmethod 21 payload "eap_ttls_avp_pap_credentials" wait 3ms
    supp <- auth eapol version 2 type eappacket eapcode 3 eapid 9 eapmethod 21 wait 60s
    supp -> auth eapol version 2 type logoff
}

compile {
    eapol_ttls_and_logoff(eduroam_supplicant, eduroam_authenticator)
}
