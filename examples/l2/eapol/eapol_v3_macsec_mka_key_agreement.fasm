// PROMPT: IEEE 802.1X-2020 EAPOL Version 3 MKA (MACsec Key Agreement) key server election and SAK distribution.
// TOKENS: host, ip, mac, flow, eapol, version, type, key, hexpayload, wait, ms, compile

// INSTRUCTION: Define MACsec Key Server core router interface.
host macsec_key_srv {
    ip 10.254.20.1
    mac 00:1c:73:fe:14:01
}

// INSTRUCTION: Define MACsec peer router interface on dark fiber WAN link.
host macsec_peer_rtr {
    ip 10.254.20.2
    mac 00:1c:73:fe:14:02
}

// INSTRUCTION: Define EAPOL Version 3 Key frames exchanging MKA Basic Parameter Set and SAK wrap.
flow eapol_v3_macsec_mka(ks, peer) {
    ks -> peer eapol version 3 type key hexpayload "01001020001c73fe14010001a1b2c3d4"
    ks <- peer eapol version 3 type key hexpayload "01801020001c73fe14020001e5f60718" wait 5ms
    ks -> peer eapol version 3 type key hexpayload "04000018aabbccddeeff001122334455" wait 5ms
}

// INSTRUCTION: Compile block executing EAPOL Version 3 MACsec MKA key agreement.
compile {
    eapol_v3_macsec_mka(macsec_key_srv, macsec_peer_rtr)
}
