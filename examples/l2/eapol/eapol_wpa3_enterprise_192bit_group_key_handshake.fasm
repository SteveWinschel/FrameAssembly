// PROMPT: WPA3-Enterprise 192-bit CNSA suite completing EAP-TLS followed by two-message EAPOL-Key Group Temporal Key (GTK) installation.
// TOKENS: host, ip, mac, flow, eapol, version, type, eappacket, eapcode, eapid, eapmethod, wait, ms, key, payload, compile

// INSTRUCTION: Define WPA3-Enterprise 192-bit wireless supplicant station.
host wpa3_cnsa_sta {
    ip 10.192.0.50
    mac 00:24:d7:c0:00:32
}

// INSTRUCTION: Define WPA3-Enterprise access point authenticator installing GCMP-256 keys.
host wpa3_cnsa_ap {
    ip 10.192.0.1
    mac 00:2c:c8:c0:00:01
}

// INSTRUCTION: Deliver EAP-Success (Code 3) followed by bidirectional EAPOL TYPE KEY GCMP-256 key installation.
flow eapol_wpa3_gtk_install(sta, ap) {
    sta <- ap eapol version 2 type eappacket eapcode 3 eapid 99 eapmethod 13 wait 2ms
    sta <- ap eapol version 2 type key payload "WPA3_192BIT_KEY_MSG1_ANONCE_GCMP256" wait 2ms
    sta -> ap eapol version 2 type key payload "WPA3_192BIT_KEY_MSG2_SNONCE_MIC_SHA384"
}

// INSTRUCTION: Compile the WPA3-Enterprise 192-bit EAP-Success and EAPOL-Key exchange.
compile {
    eapol_wpa3_gtk_install(wpa3_cnsa_sta, wpa3_cnsa_ap)
}
