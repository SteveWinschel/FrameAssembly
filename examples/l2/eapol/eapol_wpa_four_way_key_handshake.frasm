// IEEE 802.11i / WPA2/WPA3 4-Way Handshake using EAPOL-Key (type key) frames with
// ANonce, SNonce, and MIC payloads.
// Wire profile: 4 frames; 2 IPv4 hosts; EAPOL; waits 3ms, 2ms.
// Wireshark: eapol.type == 3

host wpa3_ap_bssid {
    ip 192.168.200.1
    mac 70:69:79:c8:00:01
}

host wpa3_client_sta {
    ip 192.168.200.45
    mac a4:83:e7:c8:00:2d
}

flow eapol_wpa_four_way_key(ap, sta) {
    ap -> sta eapol version 2 type key hexpayload "02008a00100000000000000001aabbccddeeff0011" wait 3ms
    ap <- sta eapol version 2 type key hexpayload "02010a001000000000000000011122334455667788" wait 2ms
    ap -> sta eapol version 2 type key hexpayload "0213ca00100000000000000002aabbccddeeff0011" wait 2ms
    ap <- sta eapol version 2 type key hexpayload "02030a000000000000000000020000000000000000"
}

compile {
    eapol_wpa_four_way_key(wpa3_ap_bssid, wpa3_client_sta)
}
