// Passive switch vs Active server LACP negotiation where only the server sets the
// LACP Activity bit (0x01).
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host active_linux_bond {
    ip 192.168.120.10
    mac 52:54:00:78:00:0a
}

host passive_access_sw {
    ip 192.168.120.1
    mac 00:1b:21:78:00:01
}

flow lacp_active_vs_passive(srv, sw) {
    srv -> sw lacp actorsys 52:54:00:78:00:0a actorkey 120 actorport 1 actorstate 61 partnersys 00:1b:21:78:00:01 partnerkey 120 partnerport 24 partnerstate 60 wait 5ms
    srv <- sw lacp actorsys 00:1b:21:78:00:01 actorkey 120 actorport 24 actorstate 60 partnersys 52:54:00:78:00:0a partnerkey 120 partnerport 1 partnerstate 61
}

compile {
    lacp_active_vs_passive(active_linux_bond, passive_access_sw)
}
