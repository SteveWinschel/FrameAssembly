// Link Aggregation Control Protocol PDU exchange configuring actor and partner
// keys.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP.
// Wireshark: lacp

host bond_server { ip 192.168.50.1 }

host bond_switch { ip 192.168.50.2 }

flow lacp_duplex_flow(srv, sw) {
    srv -> sw lacp actorkey 100 partnerkey 200
    srv <- sw lacp actorkey 200 partnerkey 100
}

compile {
    lacp_duplex_flow(bond_server, bond_switch)
}
