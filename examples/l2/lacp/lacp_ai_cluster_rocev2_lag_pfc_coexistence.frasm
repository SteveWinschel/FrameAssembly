// AI storage fabric 400GbE LAG port-channel maintaining LACP short-timeout
// heartbeats on a lossless RoCEv2 link.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host ai_storage_bond {
    ip 10.88.40.10
    mac 0c:42:a1:58:28:0a
}

host ai_storage_leaf {
    ip 10.88.40.1
    mac 00:1c:73:58:28:01
}

flow lacp_rocev2_lag_sync(srv, sw) {
    srv -> sw lacp actorsys 0c:42:a1:58:28:0a actorkey 400 actorport 1 actorstate 63 partnersys 00:1c:73:58:28:01 partnerkey 400 partnerport 49 partnerstate 63 wait 5ms
    srv <- sw lacp actorsys 00:1c:73:58:28:01 actorkey 400 actorport 49 actorstate 63 partnersys 0c:42:a1:58:28:0a partnerkey 400 partnerport 1 partnerstate 63
}

compile {
    lacp_rocev2_lag_sync(ai_storage_bond, ai_storage_leaf)
}
