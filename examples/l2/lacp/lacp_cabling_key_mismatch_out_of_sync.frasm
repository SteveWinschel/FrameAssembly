// LACP cabling misconfiguration detection where a dual-port NIC is accidentally
// plugged into two different Actor Keys on the switch.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host miswired_srv_nic2 {
    ip 10.33.0.10
    mac 00:25:90:33:00:0a
}

host misconfigured_sw_port {
    ip 10.33.0.1
    mac 00:1c:73:33:00:01
}

flow lacp_key_mismatch_fault(srv, sw) {
    srv -> sw lacp actorsys 00:25:90:33:00:0a actorkey 100 actorport 2 actorstate 61 partnersys 00:1c:73:33:00:01 partnerkey 100 partnerport 2 partnerstate 61 wait 5ms
    srv <- sw lacp actorsys 00:1c:73:33:00:01 actorkey 200 actorport 18 actorstate 5 partnersys 00:25:90:33:00:0a partnerkey 100 partnerport 2 partnerstate 5
}

compile {
    lacp_key_mismatch_fault(miswired_srv_nic2, misconfigured_sw_port)
}
