// PROMPT: VMware vSphere Distributed Switch (vDS) negotiating a 2-port LACP LAG with top-of-rack switch ports.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define ESXi hypervisor host vDS LACP uplink group.
HOST esxi_vds_host {
    IP 10.60.10.21
    MAC 00:50:56:3c:0a:15
}

// INSTRUCTION: Define ToR switch port-channel 21 partner interface.
HOST tor_po21_sw {
    IP 10.60.10.1
    MAC 00:1c:73:3c:0a:01
}

// INSTRUCTION: Negotiate vDS uplink ports 1 and 2 into Collecting/Distributing state 61 (0x3D).
FLOW lacp_esxi_vds_lag(esxi, tor) {
    esxi -> tor LACP ACTOR_SYS 00:50:56:3c:0a:15 ACTOR_KEY 21 ACTOR_PORT 1 ACTOR_STATE 61 PARTNER_SYS 00:1c:73:3c:0a:01 PARTNER_KEY 21 PARTNER_PORT 11 PARTNER_STATE 61 WAIT 5ms
    esxi <- tor LACP ACTOR_SYS 00:1c:73:3c:0a:01 ACTOR_KEY 21 ACTOR_PORT 11 ACTOR_STATE 61 PARTNER_SYS 00:50:56:3c:0a:15 PARTNER_KEY 21 PARTNER_PORT 1 PARTNER_STATE 61
}

// INSTRUCTION: Compile the VMware vDS LACP LAG negotiation trace.
COMPILE {
    lacp_esxi_vds_lag(esxi_vds_host, tor_po21_sw)
}
