// PROMPT: RFC 7432 EVPN All-Active multihoming PE leaf switches presenting identical LACP Actor System MAC and Key to a CE router.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define EVPN multihoming PE leaf switches sharing ESI system MAC 00:00:5e:00:0e:01.
HOST evpn_esi_pe_pair {
    IP 172.30.1.1
    MAC 00:00:5e:00:0e:01
}

// INSTRUCTION: Define dual-homed customer edge router aggregating links to both EVPN PEs.
HOST multihomed_ce_rtr {
    IP 172.30.1.10
    MAC 00:25:90:1e:01:0a
}

// INSTRUCTION: Synchronize EVPN ESI LACP parameters with Actor Key 1000 and State 63.
FLOW lacp_evpn_esi_active(pe, ce) {
    pe -> ce LACP ACTOR_SYS 00:00:5e:00:0e:01 ACTOR_KEY 1000 ACTOR_PORT 10 ACTOR_STATE 63 PARTNER_SYS 00:25:90:1e:01:0a PARTNER_KEY 1000 PARTNER_PORT 1 PARTNER_STATE 63 WAIT 5ms
    pe <- ce LACP ACTOR_SYS 00:25:90:1e:01:0a ACTOR_KEY 1000 ACTOR_PORT 1 ACTOR_STATE 63 PARTNER_SYS 00:00:5e:00:0e:01 PARTNER_KEY 1000 PARTNER_PORT 10 PARTNER_STATE 63
}

// INSTRUCTION: Compile the RFC 7432 EVPN All-Active ESI LACP multihoming trace.
COMPILE {
    lacp_evpn_esi_active(evpn_esi_pe_pair, multihomed_ce_rtr)
}
