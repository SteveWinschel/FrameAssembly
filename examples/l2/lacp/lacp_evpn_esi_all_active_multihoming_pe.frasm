// RFC 7432 EVPN All-Active multihoming PE leaf switches presenting identical LACP
// Actor System MAC and Key to a CE router.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host evpn_esi_pe_pair {
    ip 172.30.1.1
    mac 00:00:5e:00:0e:01
}

host multihomed_ce_rtr {
    ip 172.30.1.10
    mac 00:25:90:1e:01:0a
}

flow lacp_evpn_esi_active(pe, ce) {
    pe -> ce lacp actorsys 00:00:5e:00:0e:01 actorkey 1000 actorport 10 actorstate 63 partnersys 00:25:90:1e:01:0a partnerkey 1000 partnerport 1 partnerstate 63 wait 5ms
    pe <- ce lacp actorsys 00:25:90:1e:01:0a actorkey 1000 actorport 1 actorstate 63 partnersys 00:00:5e:00:0e:01 partnerkey 1000 partnerport 10 partnerstate 63
}

compile {
    lacp_evpn_esi_active(evpn_esi_pe_pair, multihomed_ce_rtr)
}
