// PROMPT: LACP Expired state (0x80) recovery after a temporary control-plane stall on a WAN aggregation trunk.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define local switch entering LACP Expired state (ACTOR_STATE 143 = 0x8F) after missed PDUs.
HOST local_expired_sw {
    IP 10.160.1.1
    MAC 00:24:38:a0:01:01
}

// INSTRUCTION: Define remote switch resuming LACPDU transmission to clear Expired state.
HOST remote_resumed_sw {
    IP 10.160.1.2
    MAC 00:24:38:a0:01:02
}

// INSTRUCTION: Define LACP Expired state notification followed by partner recovery and full sync restoration.
FLOW lacp_expired_state_recovery(loc, rem) {
    loc -> rem LACP ACTOR_SYS 00:24:38:a0:01:01 ACTOR_KEY 160 ACTOR_PORT 1 ACTOR_STATE 143 PARTNER_SYS 00:24:38:a0:01:02 PARTNER_KEY 160 PARTNER_PORT 1 PARTNER_STATE 135
    loc <- rem LACP ACTOR_SYS 00:24:38:a0:01:02 ACTOR_KEY 160 ACTOR_PORT 1 ACTOR_STATE 63 PARTNER_SYS 00:24:38:a0:01:01 PARTNER_KEY 160 PARTNER_PORT 1 PARTNER_STATE 143 WAIT 100ms
    loc -> rem LACP ACTOR_SYS 00:24:38:a0:01:01 ACTOR_KEY 160 ACTOR_PORT 1 ACTOR_STATE 63 PARTNER_SYS 00:24:38:a0:01:02 PARTNER_KEY 160 PARTNER_PORT 1 PARTNER_STATE 63 WAIT 50ms
}

// INSTRUCTION: Compile block executing LACP Expired timer recovery.
COMPILE {
    lacp_expired_state_recovery(local_expired_sw, remote_resumed_sw)
}
