// PROMPT: LACP Expired state (0x80) recovery after a temporary control-plane stall on a WAN aggregation trunk.
// TOKENS: host, ip, mac, flow, lacp, actorsys, actorkey, actorport, actorstate, partnersys, partnerkey, partnerport, partnerstate, wait, ms, compile

// INSTRUCTION: Define local switch entering LACP Expired state (ACTOR_STATE 143 = 0x8F) after missed PDUs.
host local_expired_sw {
    ip 10.160.1.1
    mac 00:24:38:a0:01:01
}

// INSTRUCTION: Define remote switch resuming LACPDU transmission to clear Expired state.
host remote_resumed_sw {
    ip 10.160.1.2
    mac 00:24:38:a0:01:02
}

// INSTRUCTION: Define LACP Expired state notification followed by partner recovery and full sync restoration.
flow lacp_expired_state_recovery(loc, rem) {
    loc -> rem lacp actorsys 00:24:38:a0:01:01 actorkey 160 actorport 1 actorstate 143 partnersys 00:24:38:a0:01:02 partnerkey 160 partnerport 1 partnerstate 135
    loc <- rem lacp actorsys 00:24:38:a0:01:02 actorkey 160 actorport 1 actorstate 63 partnersys 00:24:38:a0:01:01 partnerkey 160 partnerport 1 partnerstate 143 wait 100ms
    loc -> rem lacp actorsys 00:24:38:a0:01:01 actorkey 160 actorport 1 actorstate 63 partnersys 00:24:38:a0:01:02 partnerkey 160 partnerport 1 partnerstate 63 wait 50ms
}

// INSTRUCTION: Compile block executing LACP Expired timer recovery.
compile {
    lacp_expired_state_recovery(local_expired_sw, remote_resumed_sw)
}
