// LACP Expired state (0x80) recovery after a temporary control-plane stall on a
// WAN aggregation trunk.
// Wire profile: 3 frames; 2 IPv4 hosts; LACP; waits 100ms, 50ms.
// Wireshark: lacp

host local_expired_sw {
    ip 10.160.1.1
    mac 00:24:38:a0:01:01
}

host remote_resumed_sw {
    ip 10.160.1.2
    mac 00:24:38:a0:01:02
}

flow lacp_expired_state_recovery(loc, rem) {
    loc -> rem lacp actorsys 00:24:38:a0:01:01 actorkey 160 actorport 1 actorstate 143 partnersys 00:24:38:a0:01:02 partnerkey 160 partnerport 1 partnerstate 135
        wait 100ms
    loc <- rem lacp actorsys 00:24:38:a0:01:02 actorkey 160 actorport 1 actorstate 63 partnersys 00:24:38:a0:01:01 partnerkey 160 partnerport 1 partnerstate 143 wait 50ms
    loc -> rem lacp actorsys 00:24:38:a0:01:01 actorkey 160 actorport 1 actorstate 63 partnersys 00:24:38:a0:01:02 partnerkey 160 partnerport 1 partnerstate 63
}

compile {
    lacp_expired_state_recovery(local_expired_sw, remote_resumed_sw)
}
