// Fast-periodic 1-second LACP heartbeat loop with Short Timeout flag (0x3F)
// between low-latency trading switches.
// Wire profile: 5 frames; 2 IPv4 hosts; LACP; waits 1s.
// Wireshark: lacp

host hft_switch_a {
    ip 10.8.8.1
    mac 00:0f:53:08:08:01
}

host hft_switch_b {
    ip 10.8.8.2
    mac 00:0f:53:08:08:02
}

flow lacp_fast_rate_heartbeat(a, b) {
    a -> b lacp actorsys 00:0f:53:08:08:01 actorkey 88 actorport 1 actorstate 63 partnersys 00:0f:53:08:08:02 partnerkey 88 partnerport 1 partnerstate 63 wait 1s
}

compile {
    lacp_fast_rate_heartbeat(hft_switch_a, hft_switch_b) // Iteration 1 of 5
    lacp_fast_rate_heartbeat(hft_switch_a, hft_switch_b) // Iteration 2 of 5
    lacp_fast_rate_heartbeat(hft_switch_a, hft_switch_b) // Iteration 3 of 5
    lacp_fast_rate_heartbeat(hft_switch_a, hft_switch_b) // Iteration 4 of 5
    lacp_fast_rate_heartbeat(hft_switch_a, hft_switch_b) // Iteration 5 of 5
}
