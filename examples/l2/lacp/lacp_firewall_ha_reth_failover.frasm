// Firewall High-Availability (HA) cluster Redundant Ethernet (reth0) LACP
// failover transferring active Actor System MAC.
// Wire profile: 2 frames; 3 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host fw_node0_pri {
    ip 10.90.0.1
    mac 00:10:db:ff:10:00
}

host fw_node1_sec {
    ip 10.90.0.2
    mac 00:10:db:ff:10:01
}

host core_fw_agg_sw {
    ip 10.90.0.254
    mac 00:1c:73:90:00:fe
}

flow fw_ha_reth_lacp_failover(n0, n1, sw) {
    n0 -> sw lacp actorsys 00:10:db:ff:10:00 actorkey 90 actorport 1 actorstate 5 partnersys 00:1c:73:90:00:fe partnerkey 90 partnerport 1 partnerstate 61 wait 5ms
    n1 -> sw lacp actorsys 00:10:db:ff:10:00 actorkey 90 actorport 2 actorstate 63 partnersys 00:1c:73:90:00:fe partnerkey 90 partnerport 2 partnerstate 63
}

compile {
    fw_ha_reth_lacp_failover(fw_node0_pri, fw_node1_sec, core_fw_agg_sw)
}
