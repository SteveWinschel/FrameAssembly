// PROMPT: Individual non-aggregatable link LACP advertisement (Aggregation bit 0, ACTOR_STATE 0x39 = 57) for standalone port diagnostics.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define diagnostic test appliance port configured as Individual link (non-aggregatable).
HOST diag_appliance {
    IP 192.168.88.10
    MAC 00:10:94:88:00:0a
}

// INSTRUCTION: Define switch port accepting Individual LACP link operating mode.
HOST switch_diag_port {
    IP 192.168.88.1
    MAC 00:10:94:88:00:01
}

// INSTRUCTION: Define LACP exchange with Aggregation bit cleared (ACTOR_STATE 57 = Active,InSync,Collect,Dist).
FLOW lacp_individual_link_mode(app, sw) {
    app -> sw LACP ACTOR_SYS 00:10:94:88:00:0a ACTOR_KEY 1 ACTOR_PORT 1 ACTOR_STATE 57 PARTNER_SYS 00:10:94:88:00:01 PARTNER_KEY 1 PARTNER_PORT 9 PARTNER_STATE 57
    app <- sw LACP ACTOR_SYS 00:10:94:88:00:01 ACTOR_KEY 1 ACTOR_PORT 9 ACTOR_STATE 57 PARTNER_SYS 00:10:94:88:00:0a PARTNER_KEY 1 PARTNER_PORT 1 PARTNER_STATE 57 WAIT 5ms
}

// INSTRUCTION: Compile block executing Individual non-aggregatable LACP link exchange.
COMPILE {
    lacp_individual_link_mode(diag_appliance, switch_diag_port)
}
