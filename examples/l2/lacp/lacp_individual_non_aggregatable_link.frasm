// Individual non-aggregatable link LACP advertisement (Aggregation bit 0,
// actorstate 0x39 = 57) for standalone port diagnostics.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host diag_appliance {
    ip 192.168.88.10
    mac 00:10:94:88:00:0a
}

host switch_diag_port {
    ip 192.168.88.1
    mac 00:10:94:88:00:01
}

flow lacp_individual_link_mode(app, sw) {
    app -> sw lacp actorsys 00:10:94:88:00:0a actorkey 1 actorport 1 actorstate 57 partnersys 00:10:94:88:00:01 partnerkey 1 partnerport 9 partnerstate 57 wait 5ms
    app <- sw lacp actorsys 00:10:94:88:00:01 actorkey 1 actorport 9 actorstate 57 partnersys 00:10:94:88:00:0a partnerkey 1 partnerport 1 partnerstate 57
}

compile {
    lacp_individual_link_mode(diag_appliance, switch_diag_port)
}
