// Bare-metal Kubernetes worker node negotiating Linux bonding 802.3ad LACP with
// ToR switch before CNI BGP startup.
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 5ms.
// Wireshark: lacp

host k8s_worker_bond0 {
    ip 10.244.0.15
    mac 52:54:00:f4:00:0f
}

host rack_tor_po15 {
    ip 10.244.0.1
    mac 00:1c:73:f4:00:01
}

flow lacp_k8s_worker_bond(worker, tor) {
    worker -> tor lacp actorsys 52:54:00:f4:00:0f actorkey 15 actorport 1 actorstate 63 partnersys 00:1c:73:f4:00:01 partnerkey 15 partnerport 15 partnerstate 63 wait 5ms
    worker <- tor lacp actorsys 00:1c:73:f4:00:01 actorkey 15 actorport 15 actorstate 63 partnersys 52:54:00:f4:00:0f partnerkey 15 partnerport 1 partnerstate 63
}

compile {
    lacp_k8s_worker_bond(k8s_worker_bond0, rack_tor_po15)
}
