// PROMPT: LACP member link degradation and graceful removal clearing Collecting (0x10) and Distributing (0x20) flags.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define switch port experiencing optical transceiver RX power warning.
HOST degraded_lag_port {
    IP 172.25.10.1
    MAC 00:1c:73:25:10:01
}

// INSTRUCTION: Define peer switch port removing degraded member from active hash table.
HOST peer_lag_port {
    IP 172.25.10.2
    MAC 00:1c:73:25:10:02
}

// INSTRUCTION: Define LACP transition from Collecting/Distributing (61) to Out-of-Sync Standby (5).
FLOW lacp_member_graceful_drain(deg, peer) {
    deg -> peer LACP ACTOR_SYS 00:1c:73:25:10:01 ACTOR_KEY 25 ACTOR_PORT 3 ACTOR_STATE 13 PARTNER_SYS 00:1c:73:25:10:02 PARTNER_KEY 25 PARTNER_PORT 3 PARTNER_STATE 61
    deg <- peer LACP ACTOR_SYS 00:1c:73:25:10:02 ACTOR_KEY 25 ACTOR_PORT 3 ACTOR_STATE 13 PARTNER_SYS 00:1c:73:25:10:01 PARTNER_KEY 25 PARTNER_PORT 3 PARTNER_STATE 13 WAIT 5ms
    deg -> peer LACP ACTOR_SYS 00:1c:73:25:10:01 ACTOR_KEY 25 ACTOR_PORT 3 ACTOR_STATE 5 PARTNER_SYS 00:1c:73:25:10:02 PARTNER_KEY 25 PARTNER_PORT 3 PARTNER_STATE 13 WAIT 5ms
}

// INSTRUCTION: Compile block executing LACP member graceful drain.
COMPILE {
    lacp_member_graceful_drain(degraded_lag_port, peer_lag_port)
}
