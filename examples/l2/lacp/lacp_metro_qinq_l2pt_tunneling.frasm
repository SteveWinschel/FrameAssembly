// Metro Ethernet provider L2PT (Layer 2 Protocol Tunneling) encapsulating
// customer LACP frames inside QinQ S-VLAN 1800.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 1800 / C-VLAN 1; LACP; waits
// 5ms.
// Wireshark: lacp

host ce_lacp_site_a {
    ip 172.19.18.1
    mac 00:1e:67:19:18:01
}

host ce_lacp_site_b {
    ip 172.19.18.2
    mac 00:1e:67:19:18:02
}

flow qinq_l2pt_lacp_tunnel(a, b) {
    a -> b qinq 1800 innervlan 1 dstmac 01:00:0c:cd:cd:d0 lacp
        actorsys 00:1e:67:19:18:01 actorkey 18 actorport 1 actorstate 61
        partnersys 00:1e:67:19:18:02 partnerkey 18 partnerport 1 partnerstate 61 wait 5ms
    a <- b qinq 1800 innervlan 1 dstmac 01:00:0c:cd:cd:d0 lacp
        actorsys 00:1e:67:19:18:02 actorkey 18 actorport 1 actorstate 61
        partnersys 00:1e:67:19:18:01 partnerkey 18 partnerport 1 partnerstate 61
}

compile {
    qinq_l2pt_lacp_tunnel(ce_lacp_site_a, ce_lacp_site_b)
}
