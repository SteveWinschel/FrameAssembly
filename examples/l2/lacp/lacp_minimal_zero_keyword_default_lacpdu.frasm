// Minimal IEEE 802.3ad LACPDU exchange using direct two-block host and compile syntax.
// Emits two 110-byte Slow Protocols (0x8809) frames to 01:80:c2:00:00:02 with a
// 5ms post-packet pause after the first LACPDU before the partner responds.
// Verify Actor/Partner TLVs with `frameassembly show lacp_minimal_zero_keyword_default_lacpdu.frasm`.
// Wireshark: lacp

host default_lacp_a {
    ip 10.0.20.1
    mac 00:11:22:44:55:01
}

host default_lacp_b {
    ip 10.0.20.2
    mac 00:11:22:44:55:02
}

compile {
    default_lacp_a -> default_lacp_b lacp wait 5ms
    default_lacp_a <- default_lacp_b lacp
}
