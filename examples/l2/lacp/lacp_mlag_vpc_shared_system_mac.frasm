// Multi-Chassis Link Aggregation (MLAG / vPC) LACP negotiation using shared
// virtual system MAC across dual leaf switches.
// Wire profile: 3 frames; 3 IPv4 hosts; LACP; waits 2ms.
// Wireshark: lacp

host hypervisor_nic1 {
    ip 172.18.40.10
    mac 3c:fd:fe:18:40:0a
}

host mlag_leaf_a {
    ip 172.18.40.1
    mac 00:1c:73:18:40:01
}

host mlag_leaf_b {
    ip 172.18.40.2
    mac 00:1c:73:18:40:02
}

flow mlag_vpc_lacp(host, leaf1, leaf2) {
    leaf1 -> host lacp actorsys 02:00:00:aa:bb:cc actorkey 400 actorport 101 actorstate 63 partnersys 3c:fd:fe:18:40:0a partnerkey 400 partnerport 1 partnerstate 63
        wait 2ms
    leaf2 -> host lacp actorsys 02:00:00:aa:bb:cc actorkey 400 actorport 201 actorstate 63 partnersys 3c:fd:fe:18:40:0a partnerkey 400 partnerport 2 partnerstate 63
        wait 2ms
    host -> leaf1 lacp actorsys 3c:fd:fe:18:40:0a actorkey 400 actorport 1 actorstate 63 partnersys 02:00:00:aa:bb:cc partnerkey 400 partnerport 101 partnerstate 63
}

compile {
    mlag_vpc_lacp(hypervisor_nic1, mlag_leaf_a, mlag_leaf_b)
}
