// PROMPT: MPLS core routers maintaining a 4x400GbE LACP link bundle carrying labeled transit traffic.
// TOKENS: host, ip, mac, flow, lacp, actorsys, actorkey, actorport, actorstate, partnersys, partnerkey, partnerport, partnerstate, wait, ms, compile

// INSTRUCTION: Define MPLS core Label Switch Router P1 Bundle-Ether100.
host mpls_core_p1 {
    ip 172.16.100.1
    mac 00:1c:73:64:64:01
}

// INSTRUCTION: Define MPLS core Label Switch Router P2 Bundle-Ether100.
host mpls_core_p2 {
    ip 172.16.100.2
    mac 00:1c:73:64:64:02
}

// INSTRUCTION: Exchange LACP control PDUs on Bundle-Ether100 (Key 100, State 63).
flow lacp_mpls_core_bundle(p1, p2) {
    p1 -> p2 lacp actorsys 00:1c:73:64:64:01 actorkey 100 actorport 4 actorstate 63 partnersys 00:1c:73:64:64:02 partnerkey 100 partnerport 4 partnerstate 63 wait 5ms
    p1 <- p2 lacp actorsys 00:1c:73:64:64:02 actorkey 100 actorport 4 actorstate 63 partnersys 00:1c:73:64:64:01 partnerkey 100 partnerport 4 partnerstate 63
}

// INSTRUCTION: Compile the MPLS core Bundle-Ether100 LACP synchronization trace.
compile {
    lacp_mpls_core_bundle(mpls_core_p1, mpls_core_p2)
}
