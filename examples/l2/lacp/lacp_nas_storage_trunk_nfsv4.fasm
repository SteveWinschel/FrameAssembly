// PROMPT: Storage Area Network (SAN) NAS filer 40GbE LACP trunk negotiation followed by NFSv4 compound mount RPC.
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, VLAN, PCP, NFS, VERS, PROC, PATH, COMPILE

// INSTRUCTION: Define enterprise NAS storage filer bond interface.
HOST nas_filer_bond {
    IP 172.27.50.100
    MAC 00:a0:98:27:50:64
}

// INSTRUCTION: Define compute cluster storage switch port-channel.
HOST compute_san_sw {
    IP 172.27.50.10
    MAC 00:1c:73:27:50:0a
}

// INSTRUCTION: Define LACP trunk bringup followed by VLAN 270 NFSv4 datastore access.
FLOW nas_lacp_and_nfsv4(filer, sw) {
    filer -> sw LACP ACTOR_SYS 00:a0:98:27:50:64 ACTOR_KEY 270 ACTOR_PORT 1 ACTOR_STATE 61
        PARTNER_SYS 00:1c:73:27:50:0a PARTNER_KEY 270 PARTNER_PORT 1 PARTNER_STATE 61
    filer <- sw LACP ACTOR_SYS 00:1c:73:27:50:0a ACTOR_KEY 270 ACTOR_PORT 1 ACTOR_STATE 61
        PARTNER_SYS 00:a0:98:27:50:64 PARTNER_KEY 270 PARTNER_PORT 1 PARTNER_STATE 61 WAIT 2ms
    filer <- sw VLAN 270 PCP 3 NFS VERS 4 PROC "COMPOUND" PATH "/export/vmstore01" WAIT 2ms
    filer -> sw VLAN 270 PCP 3 NFS VERS 4 PROC "LOOKUP" PATH "/export/vmstore01" WAIT 1ms
}

// INSTRUCTION: Compile block executing NAS LACP negotiation and NFSv4 traffic.
COMPILE {
    nas_lacp_and_nfsv4(nas_filer_bond, compute_san_sw)
}
