// PROMPT: High-availability OLTP database server NIC team synchronizing dual-port LACP with data center core switch.
// TOKENS: host, ip, mac, flow, db, lacp, actorsys, actorkey, actorport, actorstate, partnersys, partnerkey, partnerport, partnerstate, wait, ms, compile

// INSTRUCTION: Define OLTP database server LACP team0 interface.
host oltp_db_team0 {
    ip 10.99.10.50
    mac 00:25:90:63:0a:32
}

// INSTRUCTION: Define data center core switch Port-channel 50 interface.
host dc_core_po50 {
    ip 10.99.10.1
    mac 00:1c:73:63:0a:01
}

// INSTRUCTION: Exchange LACP synchronization frames across team0 member ports 1 and 2.
flow lacp_oltp_team_verify(db, sw) {
    db -> sw lacp actorsys 00:25:90:63:0a:32 actorkey 50 actorport 1 actorstate 63 partnersys 00:1c:73:63:0a:01 partnerkey 50 partnerport 50 partnerstate 63 wait 2ms
    db <- sw lacp actorsys 00:1c:73:63:0a:01 actorkey 50 actorport 50 actorstate 63 partnersys 00:25:90:63:0a:32 partnerkey 50 partnerport 1 partnerstate 63 wait 2ms
    db -> sw lacp actorsys 00:25:90:63:0a:32 actorkey 50 actorport 2 actorstate 63 partnersys 00:1c:73:63:0a:01 partnerkey 50 partnerport 51 partnerstate 63
}

// INSTRUCTION: Compile the OLTP database NIC team LACP verification trace.
compile {
    lacp_oltp_team_verify(oltp_db_team0, dc_core_po50)
}
