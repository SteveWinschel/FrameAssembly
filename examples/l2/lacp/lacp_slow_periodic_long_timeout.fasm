// PROMPT: Slow-periodic 30-second IEEE 802.3ad LACP keepalive exchange with Long Timeout bit (ACTOR_STATE 0x3D = 61).
// TOKENS: HOST, IP, MAC, FLOW, LACP, ACTOR_SYS, ACTOR_KEY, ACTOR_PORT, ACTOR_STATE, PARTNER_SYS, PARTNER_KEY, PARTNER_PORT, PARTNER_STATE, WAIT, COMPILE

// INSTRUCTION: Define campus distribution switch A using standard 30s LACP long timeout.
HOST campus_lag_a {
    IP 10.145.0.1
    MAC 00:1e:be:91:00:01
}

// INSTRUCTION: Define campus distribution switch B using standard 30s LACP long timeout.
HOST campus_lag_b {
    IP 10.145.0.2
    MAC 00:1e:be:91:00:02
}

// INSTRUCTION: Define slow-periodic 30s LACP heartbeat exchange.
FLOW lacp_slow_periodic_long_timeout(a, b) {
    a -> b LACP ACTOR_SYS 00:1e:be:91:00:01 ACTOR_KEY 145 ACTOR_PORT 49 ACTOR_STATE 61 PARTNER_SYS 00:1e:be:91:00:02 PARTNER_KEY 145 PARTNER_PORT 49 PARTNER_STATE 61
    a <- b LACP ACTOR_SYS 00:1e:be:91:00:02 ACTOR_KEY 145 ACTOR_PORT 49 ACTOR_STATE 61 PARTNER_SYS 00:1e:be:91:00:01 PARTNER_KEY 145 PARTNER_PORT 49 PARTNER_STATE 61 WAIT 30s
}

// INSTRUCTION: Compile block executing slow-periodic 30s LACP exchange.
COMPILE {
    lacp_slow_periodic_long_timeout(campus_lag_a, campus_lag_b)
}
