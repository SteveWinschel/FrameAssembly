// Slow-periodic 30-second IEEE 802.3ad LACP keepalive exchange with Long Timeout
// bit (actorstate 0x3D = 61).
// Wire profile: 2 frames; 2 IPv4 hosts; LACP; waits 30s.
// Wireshark: lacp

host campus_lag_a {
    ip 10.145.0.1
    mac 00:1e:be:91:00:01
}

host campus_lag_b {
    ip 10.145.0.2
    mac 00:1e:be:91:00:02
}

flow lacp_slow_periodic_long_timeout(a, b) {
    a -> b lacp actorsys 00:1e:be:91:00:01 actorkey 145 actorport 49 actorstate 61 partnersys 00:1e:be:91:00:02 partnerkey 145 partnerport 49 partnerstate 61 wait 30s
    a <- b lacp actorsys 00:1e:be:91:00:02 actorkey 145 actorport 49 actorstate 61 partnersys 00:1e:be:91:00:01 partnerkey 145 partnerport 49 partnerstate 61
}

compile {
    lacp_slow_periodic_long_timeout(campus_lag_a, campus_lag_b)
}
