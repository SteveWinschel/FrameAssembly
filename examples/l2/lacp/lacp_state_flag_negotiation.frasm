// LACPDU negotiation asserting actor state flags, port numbers, and partner
// system parameters.
// Wire profile: 1 frame; 2 IPv4 hosts; LACP.
// Wireshark: lacp

host trunk_intf_a { ip 10.10.10.1 }

host trunk_intf_b { ip 10.10.10.2 }

flow lacp_state_flow(a, b) {
    a -> b lacp actorkey 100 actorport 1 actorstate 61
}

compile {
    lacp_state_flow(trunk_intf_a, trunk_intf_b)
}
