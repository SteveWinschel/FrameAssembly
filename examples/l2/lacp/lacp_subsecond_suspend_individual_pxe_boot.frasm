// PROMPT: Bare-metal server in PXE boot stage before OS bonding driver loads, triggering switch LACP suspend-individual evaluation.
// TOKENS: host, ip, mac, flow, lacp, actorsys, actorkey, actorport, actorstate, partnersys, partnerkey, partnerport, partnerstate, wait, ms, compile

// INSTRUCTION: Define switch port sending active LACP probes to an unconfigured PXE-booting server NIC.
host tor_pxe_port {
    ip 10.10.50.1
    mac 00:1c:73:0a:32:01
}

// INSTRUCTION: Define bare-metal server BIOS PXE ROM before LACP teaming initializes.
host pxe_boot_server {
    ip 10.10.50.99
    mac 00:25:90:0a:32:63
}

// INSTRUCTION: Transmit initial switch LACP probe (State 69 Defaulted) followed by OS boot LACP response (State 63).
flow lacp_pxe_to_os_handover(sw, srv) {
    sw -> srv lacp actorsys 00:1c:73:0a:32:01 actorkey 50 actorport 12 actorstate 69 partnersys 00:00:00:00:00:00 partnerkey 0 partnerport 0 partnerstate 64 wait 10ms
    sw <- srv lacp actorsys 00:25:90:0a:32:63 actorkey 50 actorport 1 actorstate 63 partnersys 00:1c:73:0a:32:01 partnerkey 50 partnerport 12 partnerstate 69 wait 5ms
    sw -> srv lacp actorsys 00:1c:73:0a:32:01 actorkey 50 actorport 12 actorstate 63 partnersys 00:25:90:0a:32:63 partnerkey 50 partnerport 1 partnerstate 63
}

// INSTRUCTION: Compile the PXE boot to OS LACP bond synchronization sequence.
compile {
    lacp_pxe_to_os_handover(tor_pxe_port, pxe_boot_server)
}
