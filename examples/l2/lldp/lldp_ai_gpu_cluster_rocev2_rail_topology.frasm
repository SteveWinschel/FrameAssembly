// AI training cluster 800GbE GPU node NICs exchanging LLDP rail-optimized
// topology TLVs with leaf switch ports.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 2ms.
// Wireshark: lldp

host gpu_rail1_nic0 {
    ip 10.80.1.101
    mac 0c:42:a1:80:01:65
}

host rail1_leaf_sw01 {
    ip 10.80.1.1
    mac 00:1c:73:80:01:01
}

flow lldp_gpu_rail_verify(gpu, leaf) {
    gpu -> leaf lldp chassisid "gpu-node-013-hgx" portid "mlx5_0" sysname "hgx-h200-node013" sysdesc "ConnectX-7 400G/800G RoCEv2" ttl 120 wait 2ms
    gpu <- leaf lldp chassisid "rail1-leaf-01" portid "Ethernet1/1" sysname "dc-ai-rail1-leaf01" sysdesc "Tomahawk5 51.2T AI Fabric Switch" ttl 120
}

compile {
    lldp_gpu_rail_verify(gpu_rail1_nic0, rail1_leaf_sw01)
}
