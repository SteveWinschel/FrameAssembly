// IEEE 802.1BA Audio Video Bridging (AVB) Time-Sensitive Networking switch and
// media endpoint LLDP capability exchange.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 5ms.
// Wireshark: lldp

host tsn_avb_bridge {
    ip 192.168.88.1
    mac 00:1d:c1:58:00:01
}

host avb_speaker_ep {
    ip 192.168.88.25
    mac 00:1d:c1:58:00:19
}

flow lldp_tsn_avb_exchange(br, ep) {
    br -> ep lldp chassisid "tsn-bridge-01" portid "avb-port-4" sysname "studio-tsn-sw1" sysdesc "IEEE 802.1Qav/Qbv TSN Bridge" ttl 120 hexpayload "fe070080c201000001" wait 5ms
    br <- ep lldp chassisid "avb-spk-left" portid "eth0" sysname "genelec-avb-l" sysdesc "Milan Certified AVB Listener" ttl 120
}

compile {
    lldp_tsn_avb_exchange(tsn_avb_bridge, avb_speaker_ep)
}
