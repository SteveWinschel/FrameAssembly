// PROMPT: Enterprise blade enclosure I/O module (IOM) and compute blade mezzanine card exchanging internal backplane LLDP frames.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define compute blade slot 3 converged network adapter mezzanine port.
host blade_slot3_cna {
    ip 172.20.3.13
    mac 00:25:b5:03:00:0d
}

// INSTRUCTION: Define blade chassis fabric interconnect I/O module A internal backplane port 3.
host chassis_iom_a {
    ip 172.20.3.1
    mac 00:25:b5:03:00:01
}

// INSTRUCTION: Discover internal KR backplane lane mapping between blade slot 3 and fabric interconnect A.
flow lldp_blade_backplane(blade, iom) {
    blade -> iom lldp chassisid "blade-sn-JAE2041" portid "vmnic0-kr-a" sysname "esxi-blade-03.corp" sysdesc "VIC 14425 25G KR Mezzanine" ttl 180 wait 5ms
    blade <- iom lldp chassisid "fi-6454-fabric-a" portid "Server-1/3" sysname "ucs-fi-a.corp" sysdesc "Fabric Interconnect 6454 IOM" ttl 180
}

// INSTRUCTION: Compile the blade chassis backplane LLDP discovery trace.
compile {
    lldp_blade_backplane(blade_slot3_cna, chassis_iom_a)
}
