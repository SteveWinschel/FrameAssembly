// Outdoor PTZ security camera negotiating IEEE 802.3at PoE+ 25.5W power
// allocation via LLDP-MED / 802.3 Power via MDI TLVs.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 10ms.
// Wireshark: lldp

host poe_access_sw {
    ip 10.33.10.1
    mac 00:1e:be:21:0a:01
}

host ptz_camera_pd {
    ip 10.33.10.85
    mac 00:40:8c:21:0a:55
}

flow lldp_poe_plus_mdi(sw, cam) {
    cam -> sw lldp chassisid "00:40:8c:21:0a:55" portid "eth0" sysname "cam-parking-ptz04" sysdesc "Axis Q6135-LE PTZ Type2 PD 25.5W" ttl 120 hexpayload "fe0c00120f02070100ff00eb" wait 10ms
    cam <- sw lldp chassisid "00:1e:be:21:0a:01" portid "Gi1/0/22" sysname "bldg4-idf2-sw01" sysdesc "PoE+ PSE Allocated 25500mW" ttl 120 hexpayload "fe0c00120f020f0100ff00ff"
}

compile {
    lldp_poe_plus_mdi(poe_access_sw, ptz_camera_pd)
}
