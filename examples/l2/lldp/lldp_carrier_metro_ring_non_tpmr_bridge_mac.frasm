// Carrier Ethernet ring nodes using the Nearest Non-TPMR Bridge multicast MAC
// 01:80:C2:00:00:03 for link-only LLDP visibility.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 5ms.
// Wireshark: lldp

host metro_ring_east {
    ip 172.31.20.1
    mac 00:15:ad:14:00:01
}

host metro_ring_west {
    ip 172.31.20.2
    mac 00:15:ad:14:00:02
}

flow lldp_non_tpmr_exchange(east, west) {
    east -> west dstmac 01:80:c2:00:00:03 lldp chassisid "metro-east-01" portid "TenGigE0/1/0" sysname "metro-pop-east" sysdesc "Carrier Ethernet Ring Node" ttl 60 wait 5ms
    east <- west dstmac 01:80:c2:00:00:03 lldp chassisid "metro-west-02" portid "TenGigE0/1/1" sysname "metro-pop-west" sysdesc "Carrier Ethernet Ring Node" ttl 60
}

compile {
    lldp_non_tpmr_exchange(metro_ring_east, metro_ring_west)
}
