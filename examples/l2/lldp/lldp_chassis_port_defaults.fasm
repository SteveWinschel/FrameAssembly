// PROMPT: Basic IEEE 802.1AB LLDP neighbor discovery advertisement using chassis ID and port ID.
// TOKENS: HOST, IP, FLOW, ->, LLDP, CHASSIS_ID, PORT_ID, COMPILE

// INSTRUCTION: Define top-of-rack leaf switch.
HOST leaf_switch { IP 192.168.10.1 }

// INSTRUCTION: Define spine switch neighbor interface.
HOST spine_switch { IP 192.168.10.2 }

// INSTRUCTION: Define LLDP chassis and port identifier announcement flow.
FLOW lldp_chassis_flow(leaf, spine) {
    leaf -> spine LLDP CHASSIS_ID "00:11:22:33:44:aa" PORT_ID "Ethernet1/1"
}

// INSTRUCTION: Compile block executing basic LLDP discovery.
COMPILE {
    lldp_chassis_flow(leaf_switch, spine_switch)
}
