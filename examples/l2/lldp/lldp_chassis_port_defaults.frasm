// Basic IEEE 802.1AB LLDP neighbor discovery advertisement using chassis ID and
// port ID.
// Wire profile: 1 frame; 2 IPv4 hosts; LLDP.
// Wireshark: lldp

host leaf_switch { ip 192.168.10.1 }

host spine_switch { ip 192.168.10.2 }

flow lldp_chassis_flow(leaf, spine) {
    leaf -> spine lldp chassisid "00:11:22:33:44:aa" portid "Ethernet1/1"
}

compile {
    lldp_chassis_flow(leaf_switch, spine_switch)
}
