// PROMPT: IEEE 802.1AB LLDP-MED fast-start mechanism transmitting three rapid 1-second LLDPDUs upon link-up detection.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define newly connected enterprise desk switch port entering LLDP fast-start state.
host desk_access_port {
    ip 10.14.2.1
    mac 00:26:cb:0e:02:01
}

// INSTRUCTION: Define newly powered-on executive workstation triggering link-up fast-start.
host exec_workstation {
    ip 10.14.2.50
    mac 00:21:70:0e:02:32
}

// INSTRUCTION: Emit LLDP fast-start advertisement with 20s TTL inside a 3-iteration rapid loop.
flow lldp_fast_start_burst(sw, ws) {
    sw -> ws lldp chassisid "fl2-sw04" portid "Gi0/15" sysname "fl2-access-sw04" sysdesc "LLDP-MED Fast-Start Enabled" ttl 20 wait 10ms
    sw <- ws lldp chassisid "ws-exec-09" portid "enp3s0" sysname "ws-exec-09.corp" sysdesc "Linux Workstation 6.8" ttl 20
}

// INSTRUCTION: Compile 3 rapid LLDP fast-start burst iterations.
compile {
    lldp_fast_start_burst(desk_access_port, exec_workstation) // cycle 1
    lldp_fast_start_burst(desk_access_port, exec_workstation) // cycle 2
    lldp_fast_start_burst(desk_access_port, exec_workstation) // cycle 3
}
