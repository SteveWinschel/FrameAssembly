// IEEE 802.1AB LLDP-MED fast-start mechanism transmitting three rapid 1-second
// LLDPDUs upon link-up detection.
// Wire profile: 6 frames; 2 IPv4 hosts; LLDP; waits 10ms.
// Wireshark: lldp

host desk_access_port {
    ip 10.14.2.1
    mac 00:26:cb:0e:02:01
}

host exec_workstation {
    ip 10.14.2.50
    mac 00:21:70:0e:02:32
}

flow lldp_fast_start_burst(sw, ws) {
    sw -> ws lldp chassisid "fl2-sw04" portid "Gi0/15" sysname "fl2-access-sw04" sysdesc "LLDP-MED Fast-Start Enabled" ttl 20 wait 10ms
    sw <- ws lldp chassisid "ws-exec-09" portid "enp3s0" sysname "ws-exec-09.corp" sysdesc "Linux Workstation 6.8" ttl 20
}

compile {
    lldp_fast_start_burst(desk_access_port, exec_workstation) // Iteration 1 of 3
    lldp_fast_start_burst(desk_access_port, exec_workstation) // Iteration 2 of 3
    lldp_fast_start_burst(desk_access_port, exec_workstation) // Iteration 3 of 3
}
