// High-availability firewall pair validating dedicated HA1/HA2 control and state-
// sync physical links via LLDP.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 5ms.
// Wireshark: lldp

host fw_active_ha2 {
    ip 169.254.200.1
    mac 00:1b:17:c8:00:01
}

host fw_passive_ha2 {
    ip 169.254.200.2
    mac 00:1b:17:c8:00:02
}

flow lldp_fw_ha_link_check(act, pas) {
    act -> pas lldp chassisid "pa-5450-pri" portid "HA2-a" sysname "fw-dc1-pri" sysdesc "HA2 Session Sync Dedicated Link" ttl 30 wait 5ms
    act <- pas lldp chassisid "pa-5450-sec" portid "HA2-a" sysname "fw-dc1-sec" sysdesc "HA2 Session Sync Dedicated Link" ttl 30
}

compile {
    lldp_fw_ha_link_check(fw_active_ha2, fw_passive_ha2)
}
