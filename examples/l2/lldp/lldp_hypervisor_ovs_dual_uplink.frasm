// Hypervisor Open vSwitch (OVS) bridge emitting LLDP beacons across dual-NIC
// physical uplinks.
// Wire profile: 2 frames; 4 IPv4 hosts; LLDP; waits 2ms.
// Wireshark: lldp

host kvm_uplink_eth0 {
    ip 10.14.1.11
    mac 52:54:00:0e:01:0b
}

host kvm_uplink_eth1 {
    ip 10.14.2.11
    mac 52:54:00:0e:02:0b
}

host tor_switch_a {
    ip 10.14.1.1
    mac 00:1c:73:0e:01:01
}

host tor_switch_b {
    ip 10.14.2.1
    mac 00:1c:73:0e:02:01
}

flow ovs_dual_uplink_lldp(nic0, tor_a, nic1, tor_b) {
    nic0 -> tor_a lldp chassisid "eb90-4412-kvm01" portid "ens1f0np0" sysname "kvm-hypervisor-01.dc.local" sysdesc "Open vSwitch 3.3.0 Linux 6.8" ttl 120 wait 2ms
    nic1 -> tor_b lldp chassisid "eb90-4412-kvm01" portid "ens1f1np1" sysname "kvm-hypervisor-01.dc.local" sysdesc "Open vSwitch 3.3.0 Linux 6.8" ttl 120
}

compile {
    ovs_dual_uplink_lldp(kvm_uplink_eth0, tor_switch_a, kvm_uplink_eth1, tor_switch_b)
}
