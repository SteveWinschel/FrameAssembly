// PROMPT: Data center BGP Unnumbered spine and leaf routers using IPv6 hosts and LLDP to audit interface peering.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define IPv6 spine router interface participating in RFC 5549 BGP unnumbered fabric.
host bgp_unnum_spine {
    ip fe80::200:1
    mac 00:1c:73:aa:02:01
}

// INSTRUCTION: Define IPv6 leaf router interface discovering spine neighbor identity via LLDP.
host bgp_unnum_leaf {
    ip fe80::200:2
    mac 00:1c:73:aa:02:02
}

// INSTRUCTION: Exchange LLDP system and interface descriptors alongside IPv6 link-local peering.
flow lldp_bgp_unnumbered_audit(spine, leaf) {
    spine -> leaf lldp chassisid "spine02.pod1" portid "swp1" sysname "spine02.pod1.dc" sysdesc "Cumulus Linux 5.9 BGP-Unnumbered" ttl 120 wait 5ms
    spine <- leaf lldp chassisid "leaf01.pod1" portid "swp50" sysname "leaf01.pod1.dc" sysdesc "Cumulus Linux 5.9 BGP-Unnumbered" ttl 120
}

// INSTRUCTION: Compile the IPv6 BGP unnumbered fabric LLDP audit trace.
compile {
    lldp_bgp_unnumbered_audit(bgp_unnum_spine, bgp_unnum_leaf)
}
