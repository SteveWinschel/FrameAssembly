// PROMPT: Minimal zero-keyword IEEE 802.1AB LLDP advertisement using automatic MAC-derived Chassis ID and default TTL.
// TOKENS: host, ip, mac, flow, lldp, compile

// INSTRUCTION: Define access switch port sending default LLDP beacon.
host lldp_default_tx {
    ip 10.12.0.1
    mac 00:1c:73:12:00:01
}

// INSTRUCTION: Define neighbor switch port receiving default LLDP beacon.
host lldp_default_rx {
    ip 10.12.0.2
    mac 00:1c:73:12:00:02
}

// INSTRUCTION: Define zero-argument LLDP discovery frame with RFC-compliant defaults.
flow lldp_minimal_default(tx, rx) {
    tx -> rx lldp
}

// INSTRUCTION: Compile block executing minimal default LLDP advertisement.
compile {
    lldp_minimal_default(lldp_default_tx, lldp_default_rx)
}
