// Minimal IEEE 802.1AB LLDP advertisement using automatic MAC Chassis ID and TTL 120.
// Uses direct two-block host and compile syntax without a flow wrapper, targeting
// Nearest Bridge multicast 01:80:c2:00:00:0e over EtherType 0x88CC.
// Inspect Chassis ID, Port ID, and TTL with `frameassembly show lldp_minimal_zero_keyword_default.frasm`.
// Wireshark: lldp

host lldp_default_tx {
    ip 10.12.0.1
    mac 00:1c:73:12:00:01
}

host lldp_default_rx {
    ip 10.12.0.2
    mac 00:1c:73:12:00:02
}

compile {
    lldp_default_tx -> lldp_default_rx lldp
}
