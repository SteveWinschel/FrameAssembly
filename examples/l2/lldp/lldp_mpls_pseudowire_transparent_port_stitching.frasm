// Port-based MPLS EoMPLS pseudowire carrying customer LLDP frames transparently
// across provider label 60100.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 60100; LLDP; waits 5ms.
// Wireshark: lldp

host eompls_ce_site1 {
    ip 10.60.1.1
    mac 00:25:90:3c:01:01
}

host eompls_ce_site2 {
    ip 10.60.1.2
    mac 00:25:90:3c:01:02
}

flow lldp_over_eompls_pw(ce1, ce2) {
    ce1 -> ce2 mpls 60100 exp 6 bos 1 mplsttl 64 lldp chassisid "ce-nyc-01" portid "ge-0/0/1" sysname "ce-nyc-01.wan" sysdesc "EoMPLS Pseudowire Endpoint" ttl 120 wait 5ms
    ce1 <- ce2 mpls 60100 exp 6 bos 1 mplsttl 64 lldp chassisid "ce-bos-02" portid "ge-0/0/1" sysname "ce-bos-02.wan" sysdesc "EoMPLS Pseudowire Endpoint" ttl 120
}

compile {
    lldp_over_eompls_pw(eompls_ce_site1, eompls_ce_site2)
}
