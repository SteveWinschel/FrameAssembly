// PROMPT: IEEE 802.1AB LLDP over non-bridged customer access port using Nearest Customer Bridge multicast MAC 01:80:c2:00:00:00.
// TOKENS: host, ip, mac, flow, dstmac, lldp, chassisid, portid, sysname, sysdesc, ttl, compile

// INSTRUCTION: Define customer edge router A at Metro Ethernet demarcation.
host ce_demarc_west {
    ip 192.168.220.1
    mac 00:0f:f7:dc:00:01
}

// INSTRUCTION: Define customer edge router B at remote Metro Ethernet demarcation.
host ce_demarc_east {
    ip 192.168.220.2
    mac 00:0f:f7:dc:00:02
}

// INSTRUCTION: Define LLDP frame overriding destination MAC to Nearest Customer Bridge address 01:80:c2:00:00:00.
flow customer_bridge_lldp(west, east) {
    west -> east dstmac 01:80:c2:00:00:00 lldp chassisid "ce-west-chassis" portid "ge-0/0/0" sysname "ce-west.corp.net" sysdesc "Customer Edge WAN Router" ttl 180
}

// INSTRUCTION: Compile block executing Nearest Customer Bridge multicast LLDP advertisement.
compile {
    customer_bridge_lldp(ce_demarc_west, ce_demarc_east)
}
