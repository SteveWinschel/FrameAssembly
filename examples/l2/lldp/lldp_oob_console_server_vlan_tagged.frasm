// Out-of-band console terminal server LLDP discovery over tagged management VLAN
// 99.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 99; PCP 6; LLDP; waits 5ms.
// Wireshark: lldp

host console_term_srv {
    ip 10.99.99.50
    mac 00:05:43:99:99:32
}

host oob_rack_switch {
    ip 10.99.99.1
    mac 00:05:43:99:99:01
}

flow oob_console_lldp(term, sw) {
    term -> sw vlan 99 pcp 6 lldp chassisid "00:05:43:99:99:32" portid "net1" sysname "ts01-oob.dc1.corp" sysdesc "48-Port Serial Console Server" ttl 120 wait 5ms
    term <- sw vlan 99 pcp 6 lldp chassisid "00:05:43:99:99:01" portid "gi0/48" sysname "oob-sw01.dc1.corp" sysdesc "OOB Management Switch" ttl 120
}

compile {
    oob_console_lldp(console_term_srv, oob_rack_switch)
}
