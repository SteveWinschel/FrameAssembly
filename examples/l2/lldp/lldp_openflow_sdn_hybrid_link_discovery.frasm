// PROMPT: Hybrid SDN switch emitting standard IEEE 802.1AB LLDP alongside custom OpenFlow BDDP chassis metadata.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define OpenFlow hybrid switch port 10.
host of_hybrid_sw1 {
    ip 10.180.0.1
    mac 00:16:3e:b4:00:01
}

// INSTRUCTION: Define peer OpenFlow hybrid switch port 20.
host of_hybrid_sw2 {
    ip 10.180.0.2
    mac 00:16:3e:b4:00:02
}

// INSTRUCTION: Exchange LLDP frames encoding OpenFlow datapath IDs in CHASSIS_ID and port numbers in PORT_ID.
flow lldp_sdn_datapath_map(sw1, sw2) {
    sw1 -> sw2 lldp chassisid "dpid:000000163eb40001" portid "ofport:10" sysname "ovs-br0-node1" sysdesc "Open vSwitch 3.3.0 OF1.3" ttl 30 wait 5ms
    sw1 <- sw2 lldp chassisid "dpid:000000163eb40002" portid "ofport:20" sysname "ovs-br0-node2" sysdesc "Open vSwitch 3.3.0 OF1.3" ttl 30
}

// INSTRUCTION: Compile the OpenFlow SDN datapath LLDP link discovery trace.
compile {
    lldp_sdn_datapath_map(of_hybrid_sw1, of_hybrid_sw2)
}
