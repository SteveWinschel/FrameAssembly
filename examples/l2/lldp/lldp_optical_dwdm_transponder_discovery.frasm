// PROMPT: Optical DWDM transponder line card advertising wavelength and optical port identifier over LLDP.
// TOKENS: host, ip, mac, flow, router, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define coherent DWDM optical transponder client port A.
host dwdm_muxponder_a {
    ip 172.31.250.1
    mac 00:04:96:fa:00:01
}

// INSTRUCTION: Define core IP router coherentZR+ optical port B.
host core_zrplus_rtr {
    ip 172.31.250.2
    mac 00:04:96:fa:00:02
}

// INSTRUCTION: Define optical transport LLDP discovery between router ZR+ optics and DWDM line system.
flow optical_dwdm_lldp(dwdm, router) {
    dwdm -> router lldp chassisid "dwdm-shelf1-slot4" portid "OCH-1-4-C1-193.1THz" sysname "ots-metro-west-01" sysdesc "OpenROADM Coherent 800G Transponder" ttl 180
    dwdm <- router lldp chassisid "core-rtr-west-01" portid "Optics0/2/0/0" sysname "cr01.sfo02.backbone.net" sysdesc "400G-ZR+ Coherent IPoDWDM Router" ttl 180 wait 5ms
}

// INSTRUCTION: Compile block executing optical IPoDWDM LLDP neighbor discovery.
compile {
    optical_dwdm_lldp(dwdm_muxponder_a, core_zrplus_rtr)
}
