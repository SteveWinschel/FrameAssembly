// Optical DWDM transponder line card advertising wavelength and optical port
// identifier over LLDP.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 5ms.
// Wireshark: lldp

host dwdm_muxponder_a {
    ip 172.31.250.1
    mac 00:04:96:fa:00:01
}

host core_zrplus_rtr {
    ip 172.31.250.2
    mac 00:04:96:fa:00:02
}

flow optical_dwdm_lldp(dwdm, router) {
    dwdm -> router lldp chassisid "dwdm-shelf1-slot4" portid "OCH-1-4-C1-193.1THz" sysname "ots-metro-west-01" sysdesc "OpenROADM Coherent 800G Transponder" ttl 180
        wait 5ms
    dwdm <- router lldp chassisid "core-rtr-west-01" portid "Optics0/2/0/0" sysname "cr01.sfo02.backbone.net" sysdesc "400G-ZR+ Coherent IPoDWDM Router" ttl 180
}

compile {
    optical_dwdm_lldp(dwdm_muxponder_a, core_zrplus_rtr)
}
