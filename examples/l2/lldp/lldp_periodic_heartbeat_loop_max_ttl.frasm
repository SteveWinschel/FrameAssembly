// Periodic LLDP heartbeat loop transmitting 4 consecutive topology refresh
// advertisements with maximum 255s TTL.
// Wire profile: 4 frames; 2 IPv4 hosts; LLDP; waits 30s.
// Wireshark: lldp

host core_sup_engine {
    ip 10.1.254.1
    mac 00:24:f7:01:fe:01
}

host dist_uplink_port {
    ip 10.1.254.2
    mac 00:24:f7:01:fe:02
}

flow periodic_lldp_beacon(core, dist) {
    core -> dist lldp chassisid "00:24:f7:01:fe:01" portid "Te1/1/1" sysname "hq-core-9606r" sysdesc "Modular Core Switch Supervisor" ttl 255 wait 30s
}

compile {
    periodic_lldp_beacon(core_sup_engine, dist_uplink_port) // Iteration 1 of 4
    periodic_lldp_beacon(core_sup_engine, dist_uplink_port) // Iteration 2 of 4
    periodic_lldp_beacon(core_sup_engine, dist_uplink_port) // Iteration 3 of 4
    periodic_lldp_beacon(core_sup_engine, dist_uplink_port) // Iteration 4 of 4
}
