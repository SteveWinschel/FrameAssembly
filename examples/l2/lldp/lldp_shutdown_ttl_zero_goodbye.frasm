// PROMPT: IEEE 802.1AB LLDP shutdown goodbye frame advertising TTL 0 to flush neighbor discovery cache immediately.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, ttl, compile

// INSTRUCTION: Define maintenance switch port preparing for administrative shutdown.
host maint_tor_sw {
    ip 172.16.99.10
    mac 00:25:90:99:00:0a
}

// INSTRUCTION: Define upstream spine neighbor receiving LLDP TTL 0 withdrawal.
host upstream_spine {
    ip 172.16.99.1
    mac 00:25:90:99:00:01
}

// INSTRUCTION: Define LLDP shutdown PDU with TTL 0 to invalidate neighbor entry immediately.
flow lldp_shutdown_ttl_zero(tor, spine) {
    tor -> spine lldp chassisid "00:25:90:99:00:0a" portid "FortyGigE1/0/49" sysname "tor-rack14-sw01" ttl 0
}

// INSTRUCTION: Compile block executing LLDP TTL 0 shutdown announcement.
compile {
    lldp_shutdown_ttl_zero(maint_tor_sw, upstream_spine)
}
