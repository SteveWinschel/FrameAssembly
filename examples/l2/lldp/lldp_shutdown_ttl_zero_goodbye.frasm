// IEEE 802.1AB LLDP shutdown goodbye frame advertising TTL 0 to flush neighbor
// discovery cache immediately.
// Wire profile: 1 frame; 2 IPv4 hosts; LLDP.
// Wireshark: lldp.time_to_live == 0

host maint_tor_sw {
    ip 172.16.99.10
    mac 00:25:90:99:00:0a
}

host upstream_spine {
    ip 172.16.99.1
    mac 00:25:90:99:00:01
}

flow lldp_shutdown_ttl_zero(tor, spine) {
    tor -> spine lldp chassisid "00:25:90:99:00:0a" portid "FortyGigE1/0/49" sysname "tor-rack14-sw01" ttl 0
}

compile {
    lldp_shutdown_ttl_zero(maint_tor_sw, upstream_spine)
}
