// IPv6-only data center management fabric LLDP discovery between a SmartNIC DPU
// and Top-of-Rack switch.
// Wire profile: 2 frames; 2 IPv6 hosts; LLDP; waits 3ms.
// Wireshark: lldp

host dpu_smartnic_v6 {
    ip 2001:db8:d000:1::50
    mac b8:ce:f6:d0:00:32
}

host tor_v6_switch {
    ip 2001:db8:d000:1::1
    mac b8:ce:f6:d0:00:01
}

flow smartnic_dpu_lldp(dpu, tor) {
    dpu -> tor lldp chassisid "b8:ce:f6:d0:00:32" portid "p0" sysname "dpu-bf3-node50.dc6.internal" sysdesc "BlueField-3 SmartNIC DPU ARMv9" ttl 120 wait 3ms
    dpu <- tor lldp chassisid "b8:ce:f6:d0:00:01" portid "swp50" sysname "tor-sn5600-rack02.dc6.internal" sysdesc "SONiC Network OS 202511" ttl 120
}

compile {
    smartnic_dpu_lldp(dpu_smartnic_v6, tor_v6_switch)
}
