// Data center Link Layer Discovery Protocol frame advertising system name and
// port parameters.
// Wire profile: 1 frame; 2 IPv4 hosts; LLDP.
// Wireshark: lldp

host switch_core { ip 10.0.0.1 }

host switch_leaf { ip 10.0.0.2 }

flow lldp_discovery(s, l) {
    s -> l lldp sysname "core-sw01"
}

compile {
    lldp_discovery(switch_core, switch_leaf)
}
