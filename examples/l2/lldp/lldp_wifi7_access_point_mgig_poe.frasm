// Wi-Fi 7 enterprise wireless access point advertising multi-gigabit 10GBASE-T
// uplink capabilities over LLDP.
// Wire profile: 2 frames; 2 IPv4 hosts; LLDP; waits 4ms.
// Wireshark: lldp

host wifi7_ap_node {
    ip 10.77.4.50
    mac 70:69:79:77:04:32
}

host mgig_poe_switch {
    ip 10.77.4.1
    mac 70:69:79:77:04:01
}

flow wifi7_ap_lldp_negotiation(ap, sw) {
    ap -> sw lldp chassisid "70:69:79:77:04:32" portid "TenGigabitEthernet0" sysname "ap-auditorium-north-04" sysdesc "Wi-Fi 7 802.11be Tri-Radio AP" ttl 120 wait 4ms
    ap <- sw lldp chassisid "70:69:79:77:04:01" portid "Te1/0/24" sysname "sw-auditorium-mgig-01" sysdesc "PoE++ 802.3bt 90W Switch" ttl 120
}

compile {
    wifi7_ap_lldp_negotiation(wifi7_ap_node, mgig_poe_switch)
}
