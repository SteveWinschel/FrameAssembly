// PROMPT: Wi-Fi 7 enterprise wireless access point advertising multi-gigabit 10GBASE-T uplink capabilities over LLDP.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, sysdesc, ttl, wait, ms, compile

// INSTRUCTION: Define ceiling-mounted Wi-Fi 7 tri-band access point.
host wifi7_ap_node {
    ip 10.77.4.50
    mac 70:69:79:77:04:32
}

// INSTRUCTION: Define multi-gigabit PoE++ aggregation switch port.
host mgig_poe_switch {
    ip 10.77.4.1
    mac 70:69:79:77:04:01
}

// INSTRUCTION: Define Wi-Fi 7 AP and multi-gigabit switch LLDP discovery handshake.
flow wifi7_ap_lldp_negotiation(ap, sw) {
    ap -> sw lldp chassisid "70:69:79:77:04:32" portid "TenGigabitEthernet0" sysname "ap-auditorium-north-04" sysdesc "Wi-Fi 7 802.11be Tri-Radio AP" ttl 120
    ap <- sw lldp chassisid "70:69:79:77:04:01" portid "Te1/0/24" sysname "sw-auditorium-mgig-01" sysdesc "PoE++ 802.3bt 90W Switch" ttl 120 wait 4ms
}

// INSTRUCTION: Compile block executing Wi-Fi 7 AP LLDP discovery.
compile {
    wifi7_ap_lldp_negotiation(wifi7_ap_node, mgig_poe_switch)
}
