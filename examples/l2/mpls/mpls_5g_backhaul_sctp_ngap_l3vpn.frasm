// 5G mobile backhaul Cell Site Gateway (CSG) transporting SCTP NGAP signaling
// over MPLS L3VPN to AMF core.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 88400,88401; SCTP; SCTP
// DATA/SACK; PPID 60; dstport 38412; waits 2ms.
// Wireshark: mpls.label == 88400 || mpls.label == 88401

host csg_gnodeb_pe {
    ip 10.155.10.1
    mac 00:1c:73:9b:0a:01
}

host amf_core_pe {
    ip 10.155.10.2
    mac 00:1c:73:9b:0a:02
}

flow mpls_5g_ngap_backhaul(csg, amf) {
    csg -> amf mpls 88400 exp 5 bos 1 mplsttl 64 sctp chunk data vtag 55001 stream 0 ssn 1 ppid 60 srcport 38412 dstport 38412 payload "ngap_initial_ue_message_pdu"
        wait 2ms
    csg <- amf mpls 88401 exp 5 bos 1 mplsttl 64 sctp chunk sack vtag 55001 srcport 38412 dstport 38412
}

compile {
    mpls_5g_ngap_backhaul(csg_gnodeb_pe, amf_core_pe)
}
