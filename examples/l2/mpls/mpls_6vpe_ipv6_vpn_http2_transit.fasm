// PROMPT: Dual-stack 6VPE IPv6 VPN over MPLS core transporting HTTP/2 microservice API calls between regional data centers.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, http2, preface, settings, wait, ms, headers, streamid, data, compile

// INSTRUCTION: Define IPv6 6VPE ingress PE router in Frankfurt.
host pe_6vpe_fra {
    ip 2001:db8:6000:1::1
    mac 00:1c:73:60:00:01
}

// INSTRUCTION: Define IPv6 6VPE egress PE router in Amsterdam.
host pe_6vpe_ams {
    ip 2001:db8:6000:1::2
    mac 00:1c:73:60:00:02
}

// INSTRUCTION: Define 6VPE MPLS Label 600443 encapsulating IPv6 HTTP/2 stream frames.
flow mpls_6vpe_http2_api(fra, ams) {
    fra -> ams mpls 600443 exp 4 bos 1 mplsttl 62 http2 preface
    fra <- ams mpls 600444 exp 4 bos 1 mplsttl 62 http2 settings wait 1ms
    fra -> ams mpls 600443 exp 4 bos 1 mplsttl 62 http2 headers streamid 1 wait 1ms
    fra <- ams mpls 600444 exp 4 bos 1 mplsttl 62 http2 data streamid 1 wait 2ms
}

// INSTRUCTION: Compile block executing 6VPE IPv6 HTTP/2 over MPLS.
compile {
    mpls_6vpe_http2_api(pe_6vpe_fra, pe_6vpe_ams)
}
