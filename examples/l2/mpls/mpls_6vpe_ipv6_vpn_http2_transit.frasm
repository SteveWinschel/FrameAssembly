// Dual-stack 6VPE IPv6 VPN over MPLS core transporting HTTP/2 microservice API
// calls between regional data centers.
// Wire profile: 4 frames; 2 IPv6 hosts; MPLS label 600443,600444; HTTP/2; waits
// 1ms, 2ms.
// Wireshark: mpls.label == 600443 || mpls.label == 600444

host pe_6vpe_fra {
    ip 2001:db8:6000:1::1
    mac 00:1c:73:60:00:01
}

host pe_6vpe_ams {
    ip 2001:db8:6000:1::2
    mac 00:1c:73:60:00:02
}

flow mpls_6vpe_http2_api(fra, ams) {
    fra -> ams mpls 600443 exp 4 bos 1 mplsttl 62 http2 preface wait 1ms
    fra <- ams mpls 600444 exp 4 bos 1 mplsttl 62 http2 settings wait 1ms
    fra -> ams mpls 600443 exp 4 bos 1 mplsttl 62 http2 headers streamid 1 wait 2ms
    fra <- ams mpls 600444 exp 4 bos 1 mplsttl 62 http2 data streamid 1
}

compile {
    mpls_6vpe_http2_api(pe_6vpe_fra, pe_6vpe_ams)
}
