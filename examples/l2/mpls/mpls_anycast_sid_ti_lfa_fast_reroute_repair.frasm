// Segment Routing TI-LFA (Topology-Independent Loop-Free Alternate) fast reroute
// pushing repair label 16050 with EXP 6.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 16050; UDP; dstport 50000;
// waits 2ms.
// Wireshark: mpls.label == 16050

host tilfa_plr_rtr {
    ip 10.255.10.1
    mac 00:1c:73:ff:0a:01
}

host tilfa_mp_rtr {
    ip 10.255.10.2
    mac 00:1c:73:ff:0a:02
}

flow mpls_tilfa_frr_repair(plr, mp) {
    plr -> mp mpls 16050 exp 6 bos 1 mplsttl 63 udp srcport 50000 dstport 50000 payload "tilfa_protected_packet_sub50ms_repair_1" wait 2ms
    plr -> mp mpls 16050 exp 6 bos 1 mplsttl 63 udp srcport 50000 dstport 50000 payload "tilfa_protected_packet_sub50ms_repair_2"
}

compile {
    mpls_tilfa_frr_repair(tilfa_plr_rtr, tilfa_mp_rtr)
}
