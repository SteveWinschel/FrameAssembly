// Carrier Supporting Carrier (CSC) hierarchical MPLS backbone switching outer ISP
// label 90100 with BOS 0 for a customer carrier.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 90100,90200; MPLS; waits 5ms.
// Wireshark: mpls.label == 90100 || mpls.label == 90200

host csc_backbone_pe1 {
    ip 172.31.90.1
    mac 00:1c:73:5a:5a:01
}

host csc_backbone_pe2 {
    ip 172.31.90.2
    mac 00:1c:73:5a:5a:02
}

flow mpls_csc_hierarchical(pe1, pe2) {
    pe1 -> pe2 mpls 90100 exp 5 bos 0 mplsttl 60 payload "nested_customer_carrier_ldp_and_vpn_frame" wait 5ms
    pe1 <- pe2 mpls 90200 exp 5 bos 0 mplsttl 60 payload "nested_customer_carrier_return_vpn_frame"
}

compile {
    mpls_csc_hierarchical(csc_backbone_pe1, csc_backbone_pe2)
}
