// PROMPT: RFC 3270 MPLS DiffServ Pipe Model 8-class Traffic Class (EXP 0 through 7) QoS marking sweep.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define MPLS QoS traffic generator PE router.
host mpls_qos_tx {
    ip 172.29.0.1
    mac 00:1b:21:29:00:01
}

// INSTRUCTION: Define MPLS QoS traffic analyzer P router.
host mpls_qos_rx {
    ip 172.29.0.2
    mac 00:1b:21:29:00:02
}

// INSTRUCTION: Define 8-class MPLS EXP 0..7 Traffic Class sweep on Label 50000.
flow mpls_exp_eight_class_sweep(tx, rx) {
    tx -> rx mpls 50000 exp 0 bos 1 mplsttl 64 udp srcport 50000 dstport 9000 payload "mpls_exp_0_best_effort_be"
    tx -> rx mpls 50000 exp 1 bos 1 mplsttl 64 udp srcport 50001 dstport 9001 payload "mpls_exp_1_assured_af11" wait 1ms
    tx -> rx mpls 50000 exp 2 bos 1 mplsttl 64 udp srcport 50002 dstport 9002 payload "mpls_exp_2_assured_af21" wait 1ms
    tx -> rx mpls 50000 exp 3 bos 1 mplsttl 64 udp srcport 50003 dstport 9003 payload "mpls_exp_3_assured_af31" wait 1ms
    tx -> rx mpls 50000 exp 4 bos 1 mplsttl 64 udp srcport 50004 dstport 9004 payload "mpls_exp_4_multimedia_af41" wait 1ms
    tx -> rx mpls 50000 exp 5 bos 1 mplsttl 64 udp srcport 50005 dstport 9005 payload "mpls_exp_5_expedited_ef_voice" wait 1ms
    tx -> rx mpls 50000 exp 6 bos 1 mplsttl 64 udp srcport 50006 dstport 9006 payload "mpls_exp_6_internetwork_cs6" wait 1ms
    tx -> rx mpls 50000 exp 7 bos 1 mplsttl 64 udp srcport 50007 dstport 9007 payload "mpls_exp_7_network_control_cs7" wait 1ms
}

// INSTRUCTION: Compile block executing full 8-class MPLS EXP sweep.
compile {
    mpls_exp_eight_class_sweep(mpls_qos_tx, mpls_qos_rx)
}
