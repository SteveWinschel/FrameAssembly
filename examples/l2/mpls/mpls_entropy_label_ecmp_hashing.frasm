// PROMPT: RFC 6790 MPLS Entropy Label Indicator (ELI Label 7) and Entropy Label for ECMP load balancing across core LAG bundles.
// TOKENS: host, ip, mac, flow, lsr, mpls, exp, bos, mplsttl, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define ingress PE router inserting Entropy Label Indicator (7) and hash labels.
host eli_ingress_pe {
    ip 172.21.0.1
    mac 00:05:85:15:00:01
}

// INSTRUCTION: Define core P router load-balancing across ECMP links using Entropy Label.
host eli_core_lsr {
    ip 172.21.0.2
    mac 00:05:85:15:00:02
}

// INSTRUCTION: Define MPLS frames with ELI Label 7 (BOS 0) and distinct Entropy Labels (512345, 789012) for ECMP hashing.
flow mpls_entropy_label_ecmp(pe, lsr) {
    pe -> lsr mpls 7 exp 0 bos 0 mplsttl 0 udp srcport 50000 dstport 443 payload "eli_indicator_header"
    pe -> lsr mpls 512345 exp 0 bos 1 mplsttl 64 udp srcport 50000 dstport 443 payload "ecmp_flow_hash_bucket_a" wait 1ms
    pe -> lsr mpls 789012 exp 0 bos 1 mplsttl 64 udp srcport 50001 dstport 443 payload "ecmp_flow_hash_bucket_b" wait 1ms
}

// INSTRUCTION: Compile block executing MPLS Entropy Label ECMP load distribution.
compile {
    mpls_entropy_label_ecmp(eli_ingress_pe, eli_core_lsr)
}
