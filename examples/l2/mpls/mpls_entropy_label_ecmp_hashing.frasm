// RFC 6790 MPLS Entropy Label Indicator (ELI Label 7) and Entropy Label for ECMP
// load balancing across core LAG bundles.
// Wire profile: 3 frames; 2 IPv4 hosts; MPLS label 7,512345,789012; UDP; dstport
// 443; waits 1ms.
// Wireshark: mpls.label == 7 || mpls.label == 512345 || mpls.label == 789012

host eli_ingress_pe {
    ip 172.21.0.1
    mac 00:05:85:15:00:01
}

host eli_core_lsr {
    ip 172.21.0.2
    mac 00:05:85:15:00:02
}

flow mpls_entropy_label_ecmp(pe, lsr) {
    pe -> lsr mpls 7 exp 0 bos 0 mplsttl 0 udp srcport 50000 dstport 443 payload "eli_indicator_header" wait 1ms
    pe -> lsr mpls 512345 exp 0 bos 1 mplsttl 64 udp srcport 50000 dstport 443 payload "ecmp_flow_hash_bucket_a" wait 1ms
    pe -> lsr mpls 789012 exp 0 bos 1 mplsttl 64 udp srcport 50001 dstport 443 payload "ecmp_flow_hash_bucket_b"
}

compile {
    mpls_entropy_label_ecmp(eli_ingress_pe, eli_core_lsr)
}
