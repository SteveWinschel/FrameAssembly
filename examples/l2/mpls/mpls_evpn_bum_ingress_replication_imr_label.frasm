// RFC 7432 MPLS-EVPN Ingress Replication (Inclusive Multicast Ethernet Tag)
// flooding BUM ARP traffic using IMET label 44000.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 44000,44001; ARP; waits 5ms.
// Wireshark: arp

host evpn_imet_pe1 {
    ip 10.250.44.1
    mac 00:1c:73:fa:2c:01
}

host evpn_imet_pe2 {
    ip 10.250.44.2
    mac 00:1c:73:fa:2c:02
}

flow mpls_evpn_imet_flood(pe1, pe2) {
    pe1 -> pe2 mpls 44000 exp 3 bos 1 mplsttl 64 arp request senderip 192.168.44.10 targetip 192.168.44.20 wait 5ms
    pe1 <- pe2 mpls 44001 exp 3 bos 1 mplsttl 64 arp reply senderip 192.168.44.20 targetip 192.168.44.10
}

compile {
    mpls_evpn_imet_flood(evpn_imet_pe1, evpn_imet_pe2)
}
