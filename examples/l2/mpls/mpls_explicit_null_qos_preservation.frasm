// RFC 3032 MPLS Explicit Null labels (IPv4 Explicit Null Label 0 and IPv6
// Explicit Null Label 2) preserving QoS EXP bits on penultimate hop.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 0,2; MPLS; waits 2ms.
// Wireshark: mpls.label == 0 || mpls.label == 2

host php_core_rtr {
    ip 172.16.250.1
    mac 00:1c:73:fa:00:01
}

host egress_pe_rtr {
    ip 172.16.250.2
    mac 00:1c:73:fa:00:02
}

flow mpls_explicit_null_php(p_rtr, pe_rtr) {
    p_rtr -> pe_rtr mpls 0 exp 5 bos 1 mplsttl 63 payload "ipv4_explicit_null_qos_preserved" wait 2ms
    p_rtr -> pe_rtr mpls 2 exp 5 bos 1 mplsttl 63 payload "ipv6_explicit_null_qos_preserved"
}

compile {
    mpls_explicit_null_php(php_core_rtr, egress_pe_rtr)
}
