// PROMPT: RFC 3032 MPLS Explicit Null labels (IPv4 Explicit Null Label 0 and IPv6 Explicit Null Label 2) preserving QoS EXP bits on penultimate hop.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, payload, wait, ms, compile

// INSTRUCTION: Define penultimate hop provider (P) router.
host php_core_rtr {
    ip 172.16.250.1
    mac 00:1c:73:fa:00:01
}

// INSTRUCTION: Define egress provider edge (PE) router receiving Explicit Null labels.
host egress_pe_rtr {
    ip 172.16.250.2
    mac 00:1c:73:fa:00:02
}

// INSTRUCTION: Define MPLS Explicit Null Label 0 (IPv4) and Label 2 (IPv6) preserving EXP 5 QoS marking.
flow mpls_explicit_null_php(p_rtr, pe_rtr) {
    p_rtr -> pe_rtr mpls 0 exp 5 bos 1 mplsttl 63 payload "ipv4_explicit_null_qos_preserved"
    p_rtr -> pe_rtr mpls 2 exp 5 bos 1 mplsttl 63 payload "ipv6_explicit_null_qos_preserved" wait 2ms
}

// INSTRUCTION: Compile block executing MPLS Explicit Null label PHP forwarding.
compile {
    mpls_explicit_null_php(php_core_rtr, egress_pe_rtr)
}
