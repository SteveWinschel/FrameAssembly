// Penultimate Hop Popping (PHP) signaling via reserved Implicit Null Label 3 and
// delivering final hop with MPLS_TTL 1.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 24003,24004; ICMP; waits 5ms.
// Wireshark: mpls.label == 24003 || mpls.label == 24004

host php_penultimate_p {
    ip 10.100.3.1
    mac 00:1c:73:64:03:01
}

host php_egress_pe {
    ip 10.100.3.2
    mac 00:1c:73:64:03:02
}

flow mpls_php_delivery(p_rtr, pe_rtr) {
    p_rtr -> pe_rtr mpls 24003 exp 4 bos 1 mplsttl 61 icmp echorequest id 300 seq 1 payload "php_exposed_inner_vrf_label" wait 5ms
    p_rtr <- pe_rtr mpls 24004 exp 4 bos 1 mplsttl 64 icmp echoreply id 300 seq 1 payload "php_exposed_inner_vrf_label"
}

compile {
    mpls_php_delivery(php_penultimate_p, php_egress_pe)
}
