// PROMPT: RFC 4182 IPv6 Explicit Null Label 2 preserving 3-bit EXP QoS marking on an IPv6 6PE penultimate hop link.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, dscp, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define 6PE penultimate hop router pushing IPv6 Explicit Null Label 2 to preserve EXP 5 QoS.
host sixpe_php_rtr {
    ip 2001:db8:2::1
    mac 00:1c:73:00:02:01
}

// INSTRUCTION: Define 6PE egress router popping Label 2 and reading EXP 5 traffic class before IPv6 lookup.
host sixpe_egress_rtr {
    ip 2001:db8:2::2
    mac 00:1c:73:00:02:02
}

// INSTRUCTION: Encapsulate IPv6 UDP voice traffic inside reserved MPLS Label 2 (IPv6 Explicit Null) with EXP 5.
flow mpls_ipv6_explicit_null_2(php, egr) {
    php -> egr mpls 2 exp 5 bos 1 mplsttl 63 dscp 46 udp srcport 16384 dstport 16384 payload "ipv6_explicit_null_label2_voip_rtp" wait 5ms
    php <- egr mpls 2 exp 5 bos 1 mplsttl 63 dscp 46 udp srcport 16384 dstport 16384 payload "ipv6_explicit_null_label2_voip_rtcp"
}

// INSTRUCTION: Compile the RFC 4182 IPv6 Explicit Null Label 2 QoS preservation trace.
compile {
    mpls_ipv6_explicit_null_2(sixpe_php_rtr, sixpe_egress_rtr)
}
