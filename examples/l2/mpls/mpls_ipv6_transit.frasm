// MPLS encapsulated 6PE IPv6 packet transit across service provider core.
// Wire profile: 1 frame; 2 IPv6 hosts; MPLS label 2048; UDP.
// Wireshark: mpls.label == 2048

host pe6_router_a { ip 2001:db8:6e::1 }

host pe6_router_b { ip 2001:db8:6e::2 }

flow mpls_6pe_flow(a, b) {
    a -> b mpls 2048 exp 0 bos 1 mplsttl 64 udp payload "6pe_ipv6_payload"
}

compile {
    mpls_6pe_flow(pe6_router_a, pe6_router_b)
}
