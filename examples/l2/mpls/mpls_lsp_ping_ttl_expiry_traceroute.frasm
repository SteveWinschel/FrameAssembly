// RFC 8029 MPLS LSP Ping and Traceroute using MPLS TTL 1 expiry and UDP port 3503
// echo request.
// Wire profile: 3 frames; 2 IPv4 hosts; MPLS label 16001; ICMP, UDP; dstport
// 3503; waits 2ms.
// Wireshark: mpls.label == 16001

host headend_ler {
    ip 10.200.1.1
    mac 00:05:85:c8:01:01
}

host transit_lsr_hop1 {
    ip 10.200.1.2
    mac 00:05:85:c8:01:02
}

flow mpls_lsp_traceroute(ler, lsr) {
    ler -> lsr mpls 16001 exp 6 bos 1 mplsttl 1 udp srcport 49152 dstport 3503 payload "rfc8029_mpls_echo_req_fec_10_200_1_99" wait 2ms
    ler <- lsr icmp timeexceeded code 0 wait 2ms
    ler -> lsr mpls 16001 exp 6 bos 1 mplsttl 2 udp srcport 49152 dstport 3503 payload "rfc8029_mpls_echo_req_hop2"
}

compile {
    mpls_lsp_traceroute(headend_ler, transit_lsr_hop1)
}
