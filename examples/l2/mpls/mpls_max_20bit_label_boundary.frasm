// MPLS Maximum 20-bit Label boundary test (Label 1048575 = 0xFFFFF) and Reserved
// Router Alert Label 1.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 1,1048575; MPLS; waits 2ms.
// Wireshark: mpls.label == 1 || mpls.label == 1048575

host mpls_bound_a {
    ip 192.0.2.101
    mac 00:00:5e:00:53:65
}

host mpls_bound_b {
    ip 192.0.2.102
    mac 00:00:5e:00:53:66
}

flow mpls_boundary_labels(a, b) {
    a -> b mpls 1 exp 6 bos 0 mplsttl 1 payload "rfc3032_router_alert_label_1" wait 2ms
    a <- b mpls 1048575 exp 7 bos 1 mplsttl 255 payload "rfc3032_max_20bit_label_1048575"
}

compile {
    mpls_boundary_labels(mpls_bound_a, mpls_bound_b)
}
