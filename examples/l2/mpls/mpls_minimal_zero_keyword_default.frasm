// Minimal standalone MPLS frame using RFC 3032 default label stack values.
// Written in direct two-block host and compile syntax between ingress LER and
// core LSR endpoints, setting default label 0, EXP 0, BoS 1, and MPLS TTL 64.
// Check shim fields with `frameassembly show mpls_minimal_zero_keyword_default.frasm`.
// Wireshark: mpls

host ler_ingress_default {
    ip 10.130.0.1
    mac 00:05:85:82:00:01
}

host lsr_core_default {
    ip 10.130.0.2
    mac 00:05:85:82:00:02
}

compile {
    ler_ingress_default -> lsr_core_default mpls
}
