// PROMPT: RFC 6388 Multipoint LDP (mLDP) Point-to-Multipoint (P2MP) LSP distributing IPTV multicast stream over label 77500.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, dscp, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define mLDP P2MP root ingress PE router injecting national IPTV broadcast stream.
host mldp_root_pe {
    ip 10.77.50.1
    mac 00:1c:73:4d:32:01
}

// INSTRUCTION: Define mLDP branch transit router replicating P2MP label 77500 to downstream leaves.
host mldp_branch_p {
    ip 10.77.50.2
    mac 00:1c:73:4d:32:02
}

// INSTRUCTION: Stream sequential UDP MPEG-TS video frames over mLDP P2MP label 77500 with EXP 5 in a loop.
flow mpls_mldp_p2mp_iptv(root, branch) {
    root -> branch mpls 77500 exp 5 bos 1 mplsttl 60 dscp 40 udp srcport 5004 dstport 5004 payload "mpeg_ts_uhd_channel_101_i_frame" wait 5ms
    root -> branch mpls 77500 exp 5 bos 1 mplsttl 60 dscp 40 udp srcport 5004 dstport 5004 payload "mpeg_ts_uhd_channel_101_p_frame"
}

// INSTRUCTION: Compile 2 iterations of the mLDP P2MP IPTV video distribution burst.
compile {
    mpls_mldp_p2mp_iptv(mldp_root_pe, mldp_branch_p) // cycle 1
    mpls_mldp_p2mp_iptv(mldp_root_pe, mldp_branch_p) // cycle 2
}
