// RFC 6388 Multipoint LDP (mLDP) Point-to-Multipoint (P2MP) LSP distributing IPTV
// multicast stream over label 77500.
// Wire profile: 4 frames; 2 IPv4 hosts; MPLS label 77500; UDP; dstport 5004; DSCP
// 40; waits 5ms.
// Wireshark: mpls.label == 77500

host mldp_root_pe {
    ip 10.77.50.1
    mac 00:1c:73:4d:32:01
}

host mldp_branch_p {
    ip 10.77.50.2
    mac 00:1c:73:4d:32:02
}

flow mpls_mldp_p2mp_iptv(root, branch) {
    root -> branch mpls 77500 exp 5 bos 1 mplsttl 60 dscp 40 udp srcport 5004 dstport 5004 payload "mpeg_ts_uhd_channel_101_i_frame" wait 5ms
    root -> branch mpls 77500 exp 5 bos 1 mplsttl 60 dscp 40 udp srcport 5004 dstport 5004 payload "mpeg_ts_uhd_channel_101_p_frame"
}

compile {
    mpls_mldp_p2mp_iptv(mldp_root_pe, mldp_branch_p) // Iteration 1 of 2
    mpls_mldp_p2mp_iptv(mldp_root_pe, mldp_branch_p) // Iteration 2 of 2
}
