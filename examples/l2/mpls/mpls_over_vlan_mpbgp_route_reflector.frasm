// MPLS over 802.1Q VLAN subinterface carrying MP-BGP VPNv4 route updates between
// Route Reflectors.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 400; PCP 6; MPLS label 24011,24012;
// BGP; waits 2ms.
// Wireshark: mpls.label == 24011 || mpls.label == 24012

host vpn_rr_west {
    ip 10.255.0.11
    mac 00:05:85:ff:00:0b
}

host vpn_rr_east {
    ip 10.255.0.12
    mac 00:05:85:ff:00:0c
}

flow vlan_mpls_bgp_rr(rr_w, rr_e) {
    rr_w -> rr_e vlan 400 pcp 6 mpls 24011 exp 6 bos 1 mplsttl 64 bgp update prefix "10.120.0.0/16" nexthop 10.255.0.11 wait 2ms
    rr_w <- rr_e vlan 400 pcp 6 mpls 24012 exp 6 bos 1 mplsttl 64 bgp keepalive
}

compile {
    vlan_mpls_bgp_rr(vpn_rr_west, vpn_rr_east)
}
