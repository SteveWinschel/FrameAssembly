// Combined IEEE 802.1ad QinQ (S-VLAN 1800, C-VLAN 80) and RFC 3032 MPLS Label
// 180800 encapsulation at a wholesale NNI handoff.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 1800 / C-VLAN 80; MPLS label
// 180800,180801; QinQ, MPLS; waits 5ms.
// Wireshark: mpls.label == 180800 || mpls.label == 180801

host nni_qinq_mpls_a {
    ip 10.180.80.1
    mac 00:1c:73:b4:50:01
}

host nni_qinq_mpls_b {
    ip 10.180.80.2
    mac 00:1c:73:b4:50:02
}

flow mpls_over_qinq_nni(a, b) {
    a -> b qinq 1800 innervlan 80 mpls 180800 exp 5 bos 1 mplsttl 64 payload "carrier_nni_qinq_plus_mpls_pseudowire_pdu" wait 5ms
    a <- b qinq 1800 innervlan 80 mpls 180801 exp 5 bos 1 mplsttl 64 payload "carrier_nni_qinq_plus_mpls_pseudowire_ack"
}

compile {
    mpls_over_qinq_nni(nni_qinq_mpls_a, nni_qinq_mpls_b)
}
