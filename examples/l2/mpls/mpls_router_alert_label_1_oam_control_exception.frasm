// PROMPT: RFC 3032 reserved Router Alert Label 1 punting MPLS OAM diagnostic packets to the LSR control plane CPU.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, icmp, echorequest, id, seq, payload, wait, ms, echoreply, compile

// INSTRUCTION: Define ingress LSR injecting an MPLS packet with reserved Router Alert Label 1.
host oam_ingress_lsr {
    ip 10.10.1.1
    mac 00:1c:73:0a:01:01
}

// INSTRUCTION: Define transit LSR punting Label 1 packet to local control plane and replying with ICMP Echo Reply.
host oam_transit_lsr {
    ip 10.10.1.2
    mac 00:1c:73:0a:01:02
}

// INSTRUCTION: Send MPLS Label 1 (Router Alert) with EXP 6 and MPLS_TTL 64 carrying OAM diagnostic ping.
flow mpls_router_alert_label1(ing, trn) {
    ing -> trn mpls 1 exp 6 bos 1 mplsttl 64 icmp echorequest id 101 seq 1 payload "rfc3032_router_alert_label_1_oam_probe" wait 5ms
    ing <- trn mpls 1 exp 6 bos 1 mplsttl 64 icmp echoreply id 101 seq 1 payload "rfc3032_router_alert_label_1_oam_reply"
}

// INSTRUCTION: Compile the RFC 3032 Router Alert Label 1 OAM exception trace.
compile {
    mpls_router_alert_label1(oam_ingress_lsr, oam_transit_lsr)
}
