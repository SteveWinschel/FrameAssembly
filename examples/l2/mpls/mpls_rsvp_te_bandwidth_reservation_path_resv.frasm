// MPLS Traffic Engineering tunnel carrying assured-bandwidth database replication
// over RSVP-signaled LSP Label 310500.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 310500,310501; TCP; TCP flags
// ACK/PSH; dstport 3260; waits 2ms.
// Wireshark: mpls.label == 310500 || mpls.label == 310501

host rsvpte_headend_pe {
    ip 10.210.1.1
    mac 00:1c:73:d2:01:01
}

host rsvpte_tailend_pe {
    ip 10.210.1.2
    mac 00:1c:73:d2:01:02
}

flow mpls_rsvpte_guaranteed_lsp(head, tail) {
    head -> tail mpls 310500 exp 4 bos 1 mplsttl 60 tcp psh ack srcport 3260 dstport 3260 seq 5000 acknum 1 win 65535 payload "srdf_sync_replication_journal_block_99" wait 2ms
    head <- tail mpls 310501 exp 4 bos 1 mplsttl 60 tcp psh ack srcport 3260 dstport 3260 seq 1 acknum 5038 win 65535 payload "srdf_sync_commit_ack_block_99"
}

compile {
    mpls_rsvpte_guaranteed_lsp(rsvpte_headend_pe, rsvpte_tailend_pe)
}
