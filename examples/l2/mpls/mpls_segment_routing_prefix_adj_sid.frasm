// Segment Routing MPLS (SR-MPLS) TI-LFA fast reroute forwarding across Prefix-SID
// 16042 and Adjacency-SID 24009.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 16042,24009; UDP; dstport
// 9100; waits 1ms.
// Wireshark: mpls.label == 16042 || mpls.label == 24009

host sr_plr_node {
    ip 10.160.42.1
    mac 00:1c:73:a0:2a:01
}

host sr_repair_pq_node {
    ip 10.160.42.2
    mac 00:1c:73:a0:2a:02
}

flow sr_mpls_tilfa_frr(plr, pq) {
    plr -> pq mpls 24009 exp 4 bos 0 mplsttl 64 udp srcport 52000 dstport 9100 payload "sr_mpls_tilfa_adj_sid_push" wait 1ms
    plr -> pq mpls 16042 exp 4 bos 1 mplsttl 63 udp srcport 52000 dstport 9100 payload "sr_mpls_prefix_sid_continue"
}

compile {
    sr_mpls_tilfa_frr(sr_plr_node, sr_repair_pq_node)
}
