// PROMPT: BGP SR-TE automated steering mapping low-latency color community traffic to Segment Routing Binding SID label 24088.
// TOKENS: host, ip, mac, flow, mpls, exp, bos, mplsttl, dscp, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define SR-TE ingress edge router steering colored VRF traffic into Binding SID 24088.
host srte_bsid_ingress {
    ip 10.240.88.1
    mac 00:1c:73:f0:58:01
}

// INSTRUCTION: Define SR-TE transit midpoint expanding Binding SID 24088 into low-latency path.
host srte_bsid_midpoint {
    ip 10.240.88.2
    mac 00:1c:73:f0:58:02
}

// INSTRUCTION: Send DSCP EF marked UDP traffic over SR-TE Binding SID label 24088 EXP 5 and default traffic over label 16088 EXP 0.
flow mpls_srte_color_steering(ing, mid) {
    ing -> mid mpls 24088 exp 5 bos 1 mplsttl 64 dscp 46 udp srcport 40000 dstport 40000 payload "srte_color_100_low_latency_path" wait 2ms
    ing -> mid mpls 16088 exp 0 bos 1 mplsttl 64 dscp 0 udp srcport 40001 dstport 40001 payload "srte_color_200_best_effort_path"
}

// INSTRUCTION: Compile the Segment Routing SR-TE Binding SID color steering trace.
compile {
    mpls_srte_color_steering(srte_bsid_ingress, srte_bsid_midpoint)
}
