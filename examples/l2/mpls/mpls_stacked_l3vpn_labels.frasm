// MPLS L3VPN provider edge transport with high-priority experimental class bits.
// Wire profile: 1 frame; 2 IPv4 hosts; MPLS label 10001; UDP.
// Wireshark: mpls.label == 10001

host pe_ingress { ip 172.16.0.1 }

host p_core { ip 172.16.0.2 }

flow mpls_l3vpn_flow(pe, p) {
    pe -> p mpls 10001 exp 5 bos 1 mplsttl 128 udp payload "l3vpn_inner_packet"
}

compile {
    mpls_l3vpn_flow(pe_ingress, p_core)
}
