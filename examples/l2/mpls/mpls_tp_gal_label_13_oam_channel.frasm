// RFC 5586 MPLS Generic Associated Channel (G-ACh Label 13) carrying MPLS-TP OAM
// Continuity Check frames.
// Wire profile: 2 frames; 2 IPv4 hosts; MPLS label 13; MPLS; waits 3ms.
// Wireshark: mpls.label == 13

host mplstp_mep_west {
    ip 10.173.13.1
    mac 00:15:ad:ad:0d:01
}

host mplstp_mep_east {
    ip 10.173.13.2
    mac 00:15:ad:ad:0d:02
}

flow mplstp_gach_oam_ccm(west, east) {
    west -> east mpls 13 exp 7 bos 1 mplsttl 1 hexpayload "100000220001010000000001" wait 3ms
    west <- east mpls 13 exp 7 bos 1 mplsttl 1 hexpayload "100000220001010000000002"
}

compile {
    mplstp_gach_oam_ccm(mplstp_mep_west, mplstp_mep_east)
}
