// PROMPT: Connected vehicle roadside unit (RSU) backhauling C-V2X safety telemetry over municipal fiber QinQ S-VLAN 2800 C-VLAN 80.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, flowlabel, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define intersection 5G-V2X Roadside Unit (RSU) IPv6 telemetry node.
host v2x_intersection_rsu {
    ip 2001:db8:2800:80::10
    mac 00:16:3e:28:50:0a
}

// INSTRUCTION: Define municipal traffic management center (TMC) IPv6 ingestion server.
host municipal_tmc_srv {
    ip 2001:db8:2800:80::1
    mac 00:16:3e:28:50:01
}

// INSTRUCTION: Transmit Basic Safety Message (BSM) hazard alerts over IPv6 with QinQ S-VLAN 2800 C-VLAN 80.
flow qinq_v2x_safety_backhaul(rsu, tmc) {
    rsu -> tmc qinq 2800 innervlan 80 dscp 46 flowlabel 28080 udp srcport 30800 dstport 30800 payload "J2735_BSM_HARD_BRAKING_ALERT_LAT_407128" wait 2ms
    rsu <- tmc qinq 2800 innervlan 80 dscp 46 flowlabel 28080 udp srcport 30800 dstport 30800 payload "TMC_SIGNAL_PHASE_TIMING_SPAT_UPDATE"
}

// INSTRUCTION: Compile the connected vehicle V2X roadside backhaul QinQ trace.
compile {
    qinq_v2x_safety_backhaul(v2x_intersection_rsu, municipal_tmc_srv)
}
