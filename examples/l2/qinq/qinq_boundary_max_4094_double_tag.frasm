// IEEE 802.1ad QinQ boundary test with maximum outer S-VLAN 4094 and maximum
// inner C-VLAN 4094.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 4094 / C-VLAN 4094; UDP;
// dstport 60000; waits 1ms.
// Wireshark: vlan.id == 4094 && vlan.id == 4094

host qinq_tester_a {
    ip 192.0.2.10
    mac 00:00:5e:00:53:0a
}

host qinq_tester_b {
    ip 192.0.2.20
    mac 00:00:5e:00:53:14
}

flow qinq_max_boundary_4094(a, b) {
    a -> b qinq 4094 innervlan 4094 udp srcport 60000 dstport 60000 payload "qinq_max_vid_4094_4094_forward" wait 1ms
    a <- b qinq 4094 innervlan 4094 udp srcport 60000 dstport 60000 payload "qinq_max_vid_4094_4094_return"
}

compile {
    qinq_max_boundary_4094(qinq_tester_a, qinq_tester_b)
}
