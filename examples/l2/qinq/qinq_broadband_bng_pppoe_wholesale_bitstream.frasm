// Wholesale fiber bitstream access encapsulating residential subscriber C-VLAN
// 105 inside RSP S-VLAN 3100 toward BNG.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 3100 / C-VLAN 105; ICMP;
// waits 5ms.
// Wireshark: vlan.id == 3100 && vlan.id == 105

host subscriber_ont_rg {
    ip 100.64.105.50
    mac 00:24:d7:69:00:32
}

host rsp_bng_edge {
    ip 100.64.105.1
    mac 00:1c:73:69:00:01
}

flow qinq_wholesale_bitstream(ont, bng) {
    ont -> bng qinq 3100 innervlan 105 icmp echorequest id 3105 seq 1 payload "wholesale_bitstream_oam_ping" wait 5ms
    ont <- bng qinq 3100 innervlan 105 icmp echoreply id 3105 seq 1 payload "wholesale_bitstream_oam_ping"
}

compile {
    qinq_wholesale_bitstream(subscriber_ont_rg, rsp_bng_edge)
}
