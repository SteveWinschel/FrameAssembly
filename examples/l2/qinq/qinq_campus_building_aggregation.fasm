// PROMPT: University campus building S-VLAN 600 aggregating research lab C-VLAN 61 and lecture hall C-VLAN 62.
// TOKENS: host, ip, flow, qinq, innervlan, dns, qname, rdata, wait, ms, http, get, uri, status, compile

// INSTRUCTION: Define campus building distribution switch uplink.
host building_dist_sw { ip 10.60.0.10 }

// INSTRUCTION: Define campus core services gateway.
host campus_core_srv { ip 10.60.0.1 }

// INSTRUCTION: Define multi-C-VLAN campus building traffic for DNS resolution and HTTP portal access.
flow campus_building_qinq(bldg, core) {
    bldg -> core qinq 600 innervlan 61 dns qname "arxiv.org"
    bldg <- core qinq 600 innervlan 61 dns qname "arxiv.org" rdata "128.84.21.199" wait 2ms
    bldg -> core qinq 600 innervlan 62 http get uri "/syllabus.pdf" wait 1ms
    bldg <- core qinq 600 innervlan 62 http status 200 wait 2ms
}

// INSTRUCTION: Compile block executing campus building QinQ aggregation.
compile {
    campus_building_qinq(building_dist_sw, campus_core_srv)
}
