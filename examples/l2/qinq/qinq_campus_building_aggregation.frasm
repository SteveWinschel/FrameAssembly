// University campus building S-VLAN 600 aggregating research lab C-VLAN 61 and
// lecture hall C-VLAN 62.
// Wire profile: 4 frames; 2 IPv4 hosts; QinQ S-VLAN 600 / C-VLAN 61,62; DNS,
// HTTP; waits 2ms, 1ms.
// Wireshark: vlan.id == 600 && vlan.id == 61

host building_dist_sw { ip 10.60.0.10 }

host campus_core_srv { ip 10.60.0.1 }

flow campus_building_qinq(bldg, core) {
    bldg -> core qinq 600 innervlan 61 dns qname "arxiv.org" wait 2ms
    bldg <- core qinq 600 innervlan 61 dns qname "arxiv.org" rdata "128.84.21.199" wait 1ms
    bldg -> core qinq 600 innervlan 62 http get uri "/syllabus.pdf" wait 2ms
    bldg <- core qinq 600 innervlan 62 http status 200
}

compile {
    campus_building_qinq(building_dist_sw, campus_core_srv)
}
