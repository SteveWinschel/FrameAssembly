// Wholesale carrier Ethernet NNI handoff using QinQ double tagging to establish
// eBGP peering and route exchange.
// Wire profile: 4 frames; 2 IPv4 hosts; QinQ S-VLAN 3100 / C-VLAN 700; BGP; waits
// 2ms, 1ms.
// Wireshark: vlan.id == 3100 && vlan.id == 700

host carrier_nni_pe {
    ip 198.18.100.1
    mac 00:05:85:18:64:01
}

host regional_isp_ce {
    ip 198.18.100.2
    mac 00:05:85:18:64:02
}

flow nni_qinq_ebgp(pe, ce) {
    pe -> ce qinq 3100 innervlan 700 bgp open asn 65100 holdtime 180 bgpid 198.18.100.1 wait 2ms
    pe <- ce qinq 3100 innervlan 700 bgp open asn 65200 holdtime 180 bgpid 198.18.100.2 wait 1ms
    pe -> ce qinq 3100 innervlan 700 bgp keepalive wait 2ms
    pe -> ce qinq 3100 innervlan 700 bgp update prefix "203.0.113.0/24" nexthop 198.18.100.1
}

compile {
    nni_qinq_ebgp(carrier_nni_pe, regional_isp_ce)
}
