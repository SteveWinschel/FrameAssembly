// PROMPT: Carrier Layer 2 Protocol Tunneling (L2PT) encapsulating customer Spanning Tree BPDUs inside QinQ S-VLAN 4000 C-VLAN 1.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dstmac, rstp, rootid, bridgeid, portid, cost, flags, wait, ms, compile

// INSTRUCTION: Define customer headquarters root switch sending RSTP BPDUs into carrier UNI port.
host cust_hq_root_sw {
    ip 10.1.0.1
    mac 00:1c:73:01:00:01
}

// INSTRUCTION: Define customer branch switch receiving tunneled RSTP BPDUs from remote carrier UNI port.
host cust_branch_sw {
    ip 10.1.0.2
    mac 00:1c:73:01:00:02
}

// INSTRUCTION: Tunnel customer RSTP BPDUs transparently across carrier QinQ S-VLAN 4000 C-VLAN 1 with provider MAC rewrite.
flow qinq_l2pt_rstp_tunnel(hq, br) {
    hq -> br qinq 4000 innervlan 1 dstmac 01:00:0c:cd:cd:d0 rstp rootid "32768:00:1c:73:01:00:01" bridgeid "32768:00:1c:73:01:00:01" portid 32769 cost 0 flags 62 wait 10ms
    hq <- br qinq 4000 innervlan 1 dstmac 01:00:0c:cd:cd:d0 rstp rootid "32768:00:1c:73:01:00:01" bridgeid "32768:00:1c:73:01:00:02" portid 32770 cost 2000 flags 60
}

// INSTRUCTION: Compile the carrier L2PT QinQ S-VLAN 4000 C-VLAN 1 RSTP BPDU tunnel trace.
compile {
    qinq_l2pt_rstp_tunnel(cust_hq_root_sw, cust_branch_sw)
}
