// Cloud Direct Connect dedicated colocation cross-connect with QinQ partner
// S-VLAN and private VIF C-VLAN.
// Wire profile: 3 frames; 2 IPv4 hosts; QinQ S-VLAN 1500 / C-VLAN 305; TLS, BFD;
// waits 1ms, 2ms.
// Wireshark: vlan.id == 1500 && vlan.id == 305

host colo_edge_rtr {
    ip 169.254.200.1
    mac 00:1c:73:c8:00:01
}

host cloud_dx_gw {
    ip 169.254.200.2
    mac 00:1c:73:c8:00:02
}

flow cloud_dx_qinq_vif(colo, cloud) {
    colo -> cloud qinq 1500 innervlan 305 bfd state 3 mydisc 9001 yourdisc 9002 mintx 300000 minrx 300000 mult 3 wait 1ms
    colo <- cloud qinq 1500 innervlan 305 bfd state 3 mydisc 9002 yourdisc 9001 mintx 300000 minrx 300000 mult 3 wait 2ms
    colo -> cloud qinq 1500 innervlan 305 tls clienthello sni "s3.us-east-1.amazonaws.com"
}

compile {
    cloud_dx_qinq_vif(colo_edge_rtr, cloud_dx_gw)
}
