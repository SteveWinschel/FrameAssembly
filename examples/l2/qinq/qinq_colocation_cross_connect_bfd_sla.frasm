// Colocation carrier-hotel virtual cross-connect running sub-second UDP BFD
// liveness probes over QinQ S-VLAN 750 C-VLAN 75.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 750 / C-VLAN 75; BFD; DSCP
// 48; waits 5ms.
// Wireshark: vlan.id == 750 && vlan.id == 75

host colo_cage_rtr_a {
    ip 192.0.2.75
    mac 00:25:90:02:4b:01
}

host colo_cage_rtr_b {
    ip 192.0.2.76
    mac 00:25:90:02:4b:02
}

flow qinq_colo_bfd_sla(a, b) {
    a -> b qinq 750 innervlan 75 dscp 48 ttl 255 bfd state 3 mydisc 7501 yourdisc 7502 mintx 50000 minrx 50000 mult 3 wait 5ms
    a <- b qinq 750 innervlan 75 dscp 48 ttl 255 bfd state 3 mydisc 7502 yourdisc 7501 mintx 50000 minrx 50000 mult 3
}

compile {
    qinq_colo_bfd_sla(colo_cage_rtr_a, colo_cage_rtr_b)
}
