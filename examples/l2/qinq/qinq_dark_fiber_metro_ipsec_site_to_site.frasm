// PROMPT: Enterprise IPsec ESP site-to-site VPN transported over a leased Metro Ethernet QinQ circuit (S-VLAN 2200, C-VLAN 220).
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, esp, spi, seq, payload, wait, ms, compile

// INSTRUCTION: Define primary headquarters VPN concentrator on QinQ S-VLAN 2200 C-VLAN 220.
host hq_ipsec_gw {
    ip 172.17.220.1
    mac 00:1b:17:dc:00:01
}

// INSTRUCTION: Define regional manufacturing plant VPN gateway on QinQ S-VLAN 2200 C-VLAN 220.
host plant_ipsec_gw {
    ip 172.17.220.2
    mac 00:1b:17:dc:00:02
}

// INSTRUCTION: Exchange encrypted ESP tunnel packets encapsulated inside IEEE 802.1ad QinQ S-VLAN 2200 C-VLAN 220.
flow qinq_metro_ipsec_esp(hq, plant) {
    hq -> plant qinq 2200 innervlan 220 dscp 46 esp spi 22001 seq 10 payload "erp_manufacturing_schedule_ciphertext" wait 5ms
    hq <- plant qinq 2200 innervlan 220 dscp 46 esp spi 22002 seq 10 payload "erp_shop_floor_telemetry_ciphertext"
}

// INSTRUCTION: Compile the Metro Ethernet QinQ S-VLAN 2200 C-VLAN 220 IPsec ESP trace.
compile {
    qinq_metro_ipsec_esp(hq_ipsec_gw, plant_ipsec_gw)
}
