// Data Center Interconnect (DCI) carrying VXLAN overlay network traffic over a
// QinQ provider dark fiber trunk.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 3500 / C-VLAN 1000; VXLAN;
// dstport 4789; waits 2ms.
// Wireshark: vlan.id == 3500 && vlan.id == 1000

host dci_vtep_west {
    ip 10.250.1.1
    mac 00:1c:73:fa:01:01
}

host dci_vtep_east {
    ip 10.250.1.2
    mac 00:1c:73:fa:01:02
}

flow dci_qinq_vxlan(west, east) {
    west -> east qinq 3500 innervlan 1000 vxlan vni 100500 srcport 54321 dstport 4789 payload "dci_east_west_vxlan_frame_1" wait 2ms
    west <- east qinq 3500 innervlan 1000 vxlan vni 100500 srcport 51234 dstport 4789 payload "dci_east_west_vxlan_frame_2"
}

compile {
    dci_qinq_vxlan(dci_vtep_west, dci_vtep_east)
}
