// PROMPT: Standalone IEEE 802.1ad QinQ frame using default outer S-VLAN and inner C-VLAN tags.
// TOKENS: host, ip, mac, flow, qinq, payload, compile

// INSTRUCTION: Define provider bridge ingress port A.
host pb_port_a {
    ip 10.108.0.1
    mac 00:1b:21:ad:00:01
}

// INSTRUCTION: Define provider bridge egress port B.
host pb_port_b {
    ip 10.108.0.2
    mac 00:1b:21:ad:00:02
}

// INSTRUCTION: Define standalone QinQ frame relying on RFC-compliant default S-Tag and C-Tag IDs.
flow default_qinq_frame(a, b) {
    a -> b qinq payload "ieee_802_1ad_default_provider_bridge"
}

// INSTRUCTION: Compile block executing default QinQ frame generation.
compile {
    default_qinq_frame(pb_port_a, pb_port_b)
}
