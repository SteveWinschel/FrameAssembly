// Standalone IEEE 802.1ad QinQ double-tagged frame with default S-VLAN and C-VLAN IDs.
// Uses direct two-block host and compile syntax carrying an ASCII bridge test
// payload behind the stacked 0x88A8 outer S-Tag and 0x8100 inner C-Tag.
// Verify stacked tags via `frameassembly show qinq_default_zero_keyword_tags.frasm`.
// Wireshark: eth.type == 0x88a8 || vlan

host pb_port_a {
    ip 10.108.0.1
    mac 00:1b:21:ad:00:01
}

host pb_port_b {
    ip 10.108.0.2
    mac 00:1b:21:ad:00:02
}

compile {
    pb_port_a -> pb_port_b qinq payload "ieee_802_1ad_default_provider_bridge"
}
