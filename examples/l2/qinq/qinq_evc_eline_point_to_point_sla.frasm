// MEF E-Line Ethernet Virtual Connection (EVC) SLA latency verification using
// ICMP over QinQ.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 2500 / C-VLAN 55; ICMP; DSCP
// 46; waits 3ms.
// Wireshark: vlan.id == 2500 && vlan.id == 55

host nid_hq_demarc {
    ip 172.29.10.1
    mac 00:15:ad:29:10:01
}

host nid_dr_demarc {
    ip 172.29.10.2
    mac 00:15:ad:29:10:02
}

flow mef_eline_sla_probe(hq, dr) {
    hq -> dr qinq 2500 innervlan 55 dscp 46 icmp echorequest id 2500 seq 1 payload "mef_y1731_synthetic_sla_probe_01" wait 3ms
    hq <- dr qinq 2500 innervlan 55 dscp 46 icmp echoreply id 2500 seq 1 payload "mef_y1731_synthetic_sla_probe_01"
}

compile {
    mef_eline_sla_probe(nid_hq_demarc, nid_dr_demarc)
}
