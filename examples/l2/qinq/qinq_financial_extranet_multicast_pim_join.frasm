// PROMPT: Financial extranet provider delivering customer multicast PIM-SM Join/Prune control messages over QinQ S-VLAN 950 C-VLAN 95.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, ttl, pim, hello, drpriority, holdtime, wait, ms, joinprune, group, source, compile

// INSTRUCTION: Define trading firm edge multicast router on extranet QinQ S-VLAN 950 C-VLAN 95.
host firm_mcast_ce {
    ip 10.95.0.2
    mac 00:0f:53:5f:00:02
}

// INSTRUCTION: Define extranet provider rendezvous point router on S-VLAN 950 C-VLAN 95.
host extranet_rp_pe {
    ip 10.95.0.1
    mac 00:1c:73:5f:00:01
}

// INSTRUCTION: Exchange PIM Hello and Join/Prune messages inside QinQ S-VLAN 950 C-VLAN 95 with TTL 1.
flow qinq_extranet_pim(ce, pe) {
    ce -> pe qinq 950 innervlan 95 dscp 48 ttl 1 pim hello drpriority 100 holdtime 105 wait 5ms
    ce <- pe qinq 950 innervlan 95 dscp 48 ttl 1 pim hello drpriority 200 holdtime 105 wait 5ms
    ce -> pe qinq 950 innervlan 95 dscp 48 ttl 1 pim joinprune group 239.95.1.1 source 10.95.0.1
}

// INSTRUCTION: Compile the financial extranet QinQ S-VLAN 950 C-VLAN 95 PIM multicast join trace.
compile {
    qinq_extranet_pim(firm_mcast_ce, extranet_rp_pe)
}
