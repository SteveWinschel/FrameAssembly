// FTTH GPON OLT double-tagged QinQ aggregation mapping S-VLAN per PON port and
// C-VLAN per subscriber ONT.
// Wire profile: 3 frames; 2 IPv4 hosts; QinQ S-VLAN 1200 / C-VLAN 42; DHCP; waits
// 5ms, 2ms.
// Wireshark: vlan.id == 1200 && vlan.id == 42

host ont_subscriber_42 {
    ip 100.64.42.10
    mac 48:57:02:42:00:0a
}

host bng_edge_router {
    ip 100.64.0.1
    mac 00:22:bd:f8:00:01
}

flow ftth_gpon_qinq_dhcp(ont, bng) {
    ont -> bng qinq 1200 innervlan 42 dhcp discover wait 5ms
    ont <- bng qinq 1200 innervlan 42 dhcp offer yiaddr 100.64.42.10 wait 2ms
    ont -> bng qinq 1200 innervlan 42 dhcp request
}

compile {
    ftth_gpon_qinq_dhcp(ont_subscriber_42, bng_edge_router)
}
