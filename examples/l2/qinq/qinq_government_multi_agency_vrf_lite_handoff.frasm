// Municipal fiber network isolating two government agencies under outer S-VLAN
// 3500 with distinct inner C-VLANs 11 and 12.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 3500 / C-VLAN 11,12; UDP;
// dstport 514; waits 5ms.
// Wireshark: vlan.id == 3500 && vlan.id == 11

host muni_vrf_core {
    ip 10.250.0.1
    mac 00:1c:73:fa:35:01
}

host agency_branch_rtr {
    ip 10.250.0.2
    mac 00:1c:73:fa:35:02
}

flow qinq_multi_agency_vrf(core, br) {
    core -> br qinq 3500 innervlan 11 udp srcport 514 dstport 514 payload "agency_a_public_safety_syslog_event" wait 5ms
    core -> br qinq 3500 innervlan 12 udp srcport 514 dstport 514 payload "agency_b_water_utility_syslog_event"
}

compile {
    qinq_multi_agency_vrf(muni_vrf_core, agency_branch_rtr)
}
