// PROMPT: Regional Health Information Exchange (HIE) carrier circuit using QinQ S-VLAN 1600 C-VLAN 60 for HL7 clinical messaging.
// TOKENS: host, ip, mac, flow, qinq, innervlan, tcp, psh, ack, srcport, dstport, seq, acknum, win, payload, wait, ms, compile

// INSTRUCTION: Define community clinic EHR integration engine on QinQ S-VLAN 1600 C-VLAN 60.
host clinic_ehr_node {
    ip 172.24.60.10
    mac 00:50:56:18:3c:0a
}

// INSTRUCTION: Define regional hospital HIE message broker on S-VLAN 1600 C-VLAN 60.
host hospital_hie_hub {
    ip 172.24.60.1
    mac 00:50:56:18:3c:01
}

// INSTRUCTION: Transmit HL7v2 ADT patient admission message and ACK over TCP port 2575 inside QinQ S-VLAN 1600 C-VLAN 60.
flow qinq_healthcare_hl7(clinic, hub) {
    clinic -> hub qinq 1600 innervlan 60 tcp psh ack srcport 52575 dstport 2575 seq 1 acknum 1 win 32768 payload "MSH|EHR|CLINIC|HIE|HOSP|20261025||ADT_A01|101|P|2.5" wait 5ms
    clinic <- hub qinq 1600 innervlan 60 tcp psh ack srcport 2575 dstport 52575 seq 1 acknum 52 win 32768 payload "MSH|HIE|HOSP|EHR|CLINIC|20261025||ACK_A01|101|P|2.5|MSA|AA"
}

// INSTRUCTION: Compile the regional healthcare HIE QinQ S-VLAN 1600 C-VLAN 60 HL7 exchange.
compile {
    qinq_healthcare_hl7(clinic_ehr_node, hospital_hie_hub)
}
