// PROMPT: Railway Communications-Based Train Control (CBTC) trackside fiber ring using QinQ S-VLAN 880 C-VLAN 88 for wayside telemetry.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define wayside zone controller A transmitting train movement authority on QinQ S-VLAN 880 C-VLAN 88.
host cbtc_zone_ctrl_a {
    ip 10.88.88.1
    mac 00:0e:8c:58:58:01
}

// INSTRUCTION: Define trackside interlocking controller B receiving CBTC movement authority frames.
host cbtc_interlock_b {
    ip 10.88.88.2
    mac 00:0e:8c:58:58:02
}

// INSTRUCTION: Exchange cyclic CBTC safety-critical movement authority frames in a 2-iteration loop.
flow qinq_cbtc_signaling(zc, il) {
    zc -> il qinq 880 innervlan 88 dscp 46 udp srcport 8800 dstport 8800 payload "cbtc_ma_block_14_clear_speed_80kph" wait 5ms
    zc <- il qinq 880 innervlan 88 dscp 46 udp srcport 8800 dstport 8800 payload "cbtc_switch_locked_normal_vital_crc_ok"
}

// INSTRUCTION: Compile 2 cyclic iterations of the railway CBTC QinQ S-VLAN 880 C-VLAN 88 signaling exchange.
compile {
    qinq_cbtc_signaling(cbtc_zone_ctrl_a, cbtc_interlock_b) // cycle 1
    qinq_cbtc_signaling(cbtc_zone_ctrl_a, cbtc_interlock_b) // cycle 2
}
