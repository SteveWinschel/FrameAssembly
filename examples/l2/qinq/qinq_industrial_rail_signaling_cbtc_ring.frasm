// Railway Communications-Based Train Control (CBTC) trackside fiber ring using
// QinQ S-VLAN 880 C-VLAN 88 for wayside telemetry.
// Wire profile: 4 frames; 2 IPv4 hosts; QinQ S-VLAN 880 / C-VLAN 88; UDP; dstport
// 8800; DSCP 46; waits 5ms.
// Wireshark: vlan.id == 880 && vlan.id == 88

host cbtc_zone_ctrl_a {
    ip 10.88.88.1
    mac 00:0e:8c:58:58:01
}

host cbtc_interlock_b {
    ip 10.88.88.2
    mac 00:0e:8c:58:58:02
}

flow qinq_cbtc_signaling(zc, il) {
    zc -> il qinq 880 innervlan 88 dscp 46 udp srcport 8800 dstport 8800 payload "cbtc_ma_block_14_clear_speed_80kph" wait 5ms
    zc <- il qinq 880 innervlan 88 dscp 46 udp srcport 8800 dstport 8800 payload "cbtc_switch_locked_normal_vital_crc_ok"
}

compile {
    qinq_cbtc_signaling(cbtc_zone_ctrl_a, cbtc_interlock_b) // Iteration 1 of 2
    qinq_cbtc_signaling(cbtc_zone_ctrl_a, cbtc_interlock_b) // Iteration 2 of 2
}
