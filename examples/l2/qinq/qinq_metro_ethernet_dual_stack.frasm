// PROMPT: Stacked QinQ double-tagged frames carrying IPv6 packets across a metro Ethernet network boundary.
// TOKENS: host, ip, flow, qinq, innervlan, udp, payload, compile

// INSTRUCTION: Define metro IPv6 customer site A.
host metro_v6_a { ip 2001:db8:cafe:1::1 }

// INSTRUCTION: Define metro IPv6 customer site B.
host metro_v6_b { ip 2001:db8:cafe:1::2 }

// INSTRUCTION: Define QinQ double-tagged IPv6 transit flow.
flow qinq_v6_flow(site_a, site_b) {
    site_a -> site_b qinq 2000 innervlan 100 udp payload "qinq_ipv6_transit_payload"
}

// INSTRUCTION: Compile block executing QinQ IPv6 encapsulation.
compile {
    qinq_v6_flow(metro_v6_a, metro_v6_b)
}
