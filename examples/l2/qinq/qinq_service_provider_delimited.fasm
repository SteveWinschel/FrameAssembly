// PROMPT: IEEE 802.1ad QinQ double-tagged Ethernet framing with outer service and inner customer VLAN tags.
// TOKENS: host, ip, flow, src, dst, qinq, innervlan, udp, payload, compile

// INSTRUCTION: Define metro Ethernet customer endpoint A.
host metro_ce_a { ip 172.16.1.1 }

// INSTRUCTION: Define metro Ethernet customer endpoint B.
host metro_ce_b { ip 172.16.1.2 }

// INSTRUCTION: Define QinQ double-tagged encapsulated flow.
flow qinq_flow(src, dst) {
    src -> dst qinq 1000 innervlan 20 udp payload "metro_ethernet_customer"
}

// INSTRUCTION: Compile block executing QinQ double tagging.
compile {
    qinq_flow(metro_ce_a, metro_ce_b)
}
