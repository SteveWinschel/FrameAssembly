// IEEE 802.1ad QinQ double-tagged Ethernet framing with outer service and inner
// customer VLAN tags.
// Wire profile: 1 frame; 2 IPv4 hosts; QinQ S-VLAN 1000 / C-VLAN 20; UDP.
// Wireshark: vlan.id == 1000 && vlan.id == 20

host metro_ce_a { ip 172.16.1.1 }

host metro_ce_b { ip 172.16.1.2 }

flow qinq_flow(src, dst) {
    src -> dst qinq 1000 innervlan 20 udp payload "metro_ethernet_customer"
}

compile {
    qinq_flow(metro_ce_a, metro_ce_b)
}
