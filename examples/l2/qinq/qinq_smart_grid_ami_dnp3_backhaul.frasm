// Utility smart grid backhaul aggregating substation C-VLANs into a regional
// S-VLAN carrying DNP3 telemetry.
// Wire profile: 3 frames; 2 IPv4 hosts; QinQ S-VLAN 1400 / C-VLAN 22; DNP3; waits
// 8ms, 5ms.
// Wireshark: vlan.id == 1400 && vlan.id == 22

host utility_dms_headend {
    ip 10.140.0.10
    mac 00:a0:c9:8c:00:0a
}

host substation_rtu_gw {
    ip 10.140.0.55
    mac 00:a0:c9:8c:00:37
}

flow utility_qinq_dnp3(dms, rtu) {
    dms -> rtu qinq 1400 innervlan 22 dnp3 func read src 1 dst 55 wait 8ms
    dms <- rtu qinq 1400 innervlan 22 dnp3 func read src 55 dst 1 wait 5ms
    dms -> rtu qinq 1400 innervlan 22 dnp3 func directoperate src 1 dst 55
}

compile {
    utility_qinq_dnp3(utility_dms_headend, substation_rtu_gw)
}
