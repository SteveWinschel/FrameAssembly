// PROMPT: Standalone IEEE 802.1ad QinQ Layer 2 frame carrying synthetic Ethernet OAM loopback payload bytes on S-VLAN 3000 C-VLAN 30.
// TOKENS: host, ip, mac, flow, qinq, innervlan, hexpayload, wait, ms, compile

// INSTRUCTION: Define Carrier Ethernet NID (Network Interface Device) at customer demarcation point A.
host nid_demarc_a {
    ip 10.30.0.1
    mac 00:15:ad:1e:00:01
}

// INSTRUCTION: Define Carrier Ethernet NID at remote demarcation point B looped back across provider core.
host nid_demarc_b {
    ip 10.30.0.2
    mac 00:15:ad:1e:00:02
}

// INSTRUCTION: Exchange standalone Layer 2 QinQ S-VLAN 3000 C-VLAN 30 frames with hexadecimal OAM test pattern.
flow qinq_nid_oam_loopback(nid_a, nid_b) {
    nid_a -> nid_b qinq 3000 innervlan 30 hexpayload "0003000000000001deadbeefcafebabe" wait 5ms
    nid_a <- nid_b qinq 3000 innervlan 30 hexpayload "0002000000000001deadbeefcafebabe"
}

// INSTRUCTION: Compile the standalone Carrier Ethernet NID QinQ S-VLAN 3000 C-VLAN 30 loopback trace.
compile {
    qinq_nid_oam_loopback(nid_demarc_a, nid_demarc_b)
}
