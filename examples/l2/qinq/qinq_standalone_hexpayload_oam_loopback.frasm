// Standalone IEEE 802.1ad QinQ Layer 2 frame carrying synthetic Ethernet OAM
// loopback payload bytes on S-VLAN 3000 C-VLAN 30.
// Wire profile: 2 frames; 2 IPv4 hosts; QinQ S-VLAN 3000 / C-VLAN 30; QinQ; waits
// 5ms.
// Wireshark: vlan.id == 3000 && vlan.id == 30

host nid_demarc_a {
    ip 10.30.0.1
    mac 00:15:ad:1e:00:01
}

host nid_demarc_b {
    ip 10.30.0.2
    mac 00:15:ad:1e:00:02
}

flow qinq_nid_oam_loopback(nid_a, nid_b) {
    nid_a -> nid_b qinq 3000 innervlan 30 hexpayload "0003000000000001deadbeefcafebabe" wait 5ms
    nid_a <- nid_b qinq 3000 innervlan 30 hexpayload "0002000000000001deadbeefcafebabe"
}

compile {
    qinq_nid_oam_loopback(nid_demarc_a, nid_demarc_b)
}
