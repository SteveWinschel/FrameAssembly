// PROMPT: Synchronous block storage replication over Metro Ethernet QinQ using stateful TCP 3-way handshake and data push.
// TOKENS: host, ip, mac, flow, pri, qinq, innervlan, tcp, syn, srcport, dstport, mss, wscale, sackperm, ack, wait, ms, us, psh, payload, compile

// INSTRUCTION: Define primary SAN storage controller at Site A.
host san_site_a {
    ip 172.30.200.11
    mac 00:a0:98:30:c8:0b
}

// INSTRUCTION: Define synchronous mirror SAN storage controller at Site B.
host san_site_b {
    ip 172.30.200.12
    mac 00:a0:98:30:c8:0c
}

// INSTRUCTION: Define QinQ S-VLAN 2200 C-VLAN 3260 TCP handshake and synchronous block write replication.
flow qinq_san_replication(pri, mir) {
    pri -> mir qinq 2200 innervlan 3260 tcp syn srcport 49800 dstport 3260 mss 1440 wscale 8 sackperm
    pri <- mir qinq 2200 innervlan 3260 tcp syn ack mss 1440 wscale 8 sackperm wait 1ms
    pri -> mir qinq 2200 innervlan 3260 tcp ack wait 500us
    pri -> mir qinq 2200 innervlan 3260 tcp psh ack payload "iscsi_scsi_write_16_lba_0x004000" wait 1ms
    pri <- mir qinq 2200 innervlan 3260 tcp psh ack payload "iscsi_scsi_response_good_status" wait 1ms
}

// INSTRUCTION: Compile block executing synchronous SAN replication over QinQ.
compile {
    qinq_san_replication(san_site_a, san_site_b)
}
