// Synchronous block storage replication over Metro Ethernet QinQ using stateful
// TCP 3-way handshake and data push.
// Wire profile: 5 frames; 2 IPv4 hosts; QinQ S-VLAN 2200 / C-VLAN 3260; TCP; TCP
// flags SYN/ACK/PSH; dstport 3260; waits 1ms, 500us.
// Wireshark: vlan.id == 2200 && vlan.id == 3260

host san_site_a {
    ip 172.30.200.11
    mac 00:a0:98:30:c8:0b
}

host san_site_b {
    ip 172.30.200.12
    mac 00:a0:98:30:c8:0c
}

flow qinq_san_replication(pri, mir) {
    pri -> mir qinq 2200 innervlan 3260 tcp syn srcport 49800 dstport 3260 mss 1440 wscale 8 sackperm wait 1ms
    pri <- mir qinq 2200 innervlan 3260 tcp syn ack mss 1440 wscale 8 sackperm wait 500us
    pri -> mir qinq 2200 innervlan 3260 tcp ack wait 1ms
    pri -> mir qinq 2200 innervlan 3260 tcp psh ack payload "iscsi_scsi_write_16_lba_0x004000" wait 1ms
    pri <- mir qinq 2200 innervlan 3260 tcp psh ack payload "iscsi_scsi_response_good_status"
}

compile {
    qinq_san_replication(san_site_a, san_site_b)
}
