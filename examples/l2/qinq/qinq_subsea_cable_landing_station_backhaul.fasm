// PROMPT: Subsea cable landing station backhauling wholesale tenant IPv6 BGP sessions inside QinQ S-VLAN 3800 C-VLAN 380.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, bgp, open, asn, holdtime, bgpid, wait, ms, keepalive, compile

// INSTRUCTION: Define subsea cable landing station (CLS) optical handoff router.
host cls_landing_rtr {
    ip 2001:db8:3800:380::1
    mac 00:1c:73:38:03:81
}

// INSTRUCTION: Define inland terrestrial PoP core router terminating S-VLAN 3800 C-VLAN 380.
host inland_pop_rtr {
    ip 2001:db8:3800:380::2
    mac 00:1c:73:38:03:82
}

// INSTRUCTION: Exchange IPv6 BGP OPEN and KEEPALIVE messages inside QinQ S-VLAN 3800 C-VLAN 380.
flow qinq_subsea_cls_bgp(cls, pop) {
    cls -> pop qinq 3800 innervlan 380 dscp 48 bgp open asn 65380 holdtime 90 bgpid 192.0.2.38 wait 5ms
    cls <- pop qinq 3800 innervlan 380 dscp 48 bgp open asn 65381 holdtime 90 bgpid 192.0.2.39 wait 5ms
    cls -> pop qinq 3800 innervlan 380 dscp 48 bgp keepalive
}

// INSTRUCTION: Compile the subsea cable landing station QinQ S-VLAN 3800 C-VLAN 380 IPv6 BGP trace.
compile {
    qinq_subsea_cls_bgp(cls_landing_rtr, inland_pop_rtr)
}
