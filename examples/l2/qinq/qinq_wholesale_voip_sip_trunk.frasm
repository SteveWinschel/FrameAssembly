// PROMPT: Wholesale VoIP interconnect over QinQ double-tagged trunk carrying SIP call setup and RTP voice packets.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dscp, sip, invite, uri, ack, wait, ms, rtp, pt, seq, timestamp, ssrc, payload, compile

// INSTRUCTION: Define enterprise session border controller (SBC).
host enterprise_sbc {
    ip 172.24.88.10
    mac 00:08:25:24:88:0a
}

// INSTRUCTION: Define carrier wholesale VoIP softswitch.
host carrier_softswitch {
    ip 172.24.88.1
    mac 00:08:25:24:88:01
}

// INSTRUCTION: Define QinQ S-VLAN 900 C-VLAN 150 SIP INVITE handshake and RTP voice bearer stream.
flow qinq_voip_trunk(sbc, carrier) {
    sbc -> carrier qinq 900 innervlan 150 dscp 24 sip invite uri "sip:+18005550199@carrier.voice.net"
    sbc <- carrier qinq 900 innervlan 150 dscp 24 sip ack uri "sip:+18005550199@carrier.voice.net" wait 10ms
    sbc -> carrier qinq 900 innervlan 150 dscp 46 rtp pt 0 seq 101 timestamp 160 ssrc 0x11223344 payload "ulaw_voice_frame_01" wait 20ms
    sbc <- carrier qinq 900 innervlan 150 dscp 46 rtp pt 0 seq 501 timestamp 160 ssrc 0x55667788 payload "ulaw_voice_frame_02" wait 20ms
}

// INSTRUCTION: Compile block executing wholesale VoIP SIP and RTP over QinQ.
compile {
    qinq_voip_trunk(enterprise_sbc, carrier_softswitch)
}
