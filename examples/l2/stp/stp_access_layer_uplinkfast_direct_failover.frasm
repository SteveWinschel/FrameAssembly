// Access switch executing UplinkFast failover to backup root port and advertising
// elevated path cost 3000.
// Wire profile: 2 frames; 2 IPv4 hosts; STP; waits 2ms.
// Wireshark: stp

host access_uplinkfast_sw {
    ip 10.12.1.10
    mac 00:1c:73:0c:01:0a
}

host dist_secondary_sw {
    ip 10.12.1.2
    mac 00:1c:73:0c:01:02
}

flow stp_uplinkfast_cutover(acc, dist) {
    acc <- dist stp rootid "4096:00:1c:73:0c:01:01" bridgeid "8192:00:1c:73:0c:01:02" cost 4 portid 32770 maxage 20 hellotime 2 forwarddelay 15 flags 0 wait 2ms
    acc -> dist stp rootid "4096:00:1c:73:0c:01:01" bridgeid "49152:00:1c:73:0c:01:0a" cost 3004 portid 32770 maxage 20 hellotime 2 forwarddelay 15 flags 1
}

compile {
    stp_uplinkfast_cutover(access_uplinkfast_sw, dist_secondary_sw)
}
