// PROMPT: BPDU Guard security test simulating an accidental hub loop reflecting a switch's own PORT_ID and BRIDGE_ID back to itself.
// TOKENS: host, ip, mac, flow, stp, rstp, rootid, bridgeid, cost, portid, flags, wait, ms, compile

// INSTRUCTION: Define access switch port 1 transmitting BPDU into unmanaged desk hub.
host access_sw_port1 {
    ip 10.11.12.1
    mac 00:26:cb:0b:0c:01
}

// INSTRUCTION: Define access switch port 2 receiving reflected BPDU from unmanaged desk hub.
host access_sw_port2 {
    ip 10.11.12.2
    mac 00:26:cb:0b:0c:02
}

// INSTRUCTION: Define self-looped RSTP BPDU triggering Backup port role and BPDU Guard err-disable.
flow bpdu_guard_self_loop(p1, p2) {
    p1 -> p2 stp rstp rootid "32768:00:26:cb:0b:0c:01" bridgeid "32768:00:26:cb:0b:0c:01" cost 20000 portid 32769 flags 60
    p2 -> p1 stp rstp rootid "32768:00:26:cb:0b:0c:01" bridgeid "32768:00:26:cb:0b:0c:01" cost 20000 portid 32770 flags 28 wait 1ms
}

// INSTRUCTION: Compile block executing BPDU Guard self-loop detection test.
compile {
    bpdu_guard_self_loop(access_sw_port1, access_sw_port2)
}
