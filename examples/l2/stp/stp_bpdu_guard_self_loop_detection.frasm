// BPDU Guard security test simulating an accidental hub loop reflecting a
// switch's own portid and bridgeid back to itself.
// Wire profile: 2 frames; 2 IPv4 hosts; STP; waits 1ms.
// Wireshark: stp.version == 2

host access_sw_port1 {
    ip 10.11.12.1
    mac 00:26:cb:0b:0c:01
}

host access_sw_port2 {
    ip 10.11.12.2
    mac 00:26:cb:0b:0c:02
}

flow bpdu_guard_self_loop(p1, p2) {
    p1 -> p2 stp rstp rootid "32768:00:26:cb:0b:0c:01" bridgeid "32768:00:26:cb:0b:0c:01" cost 20000 portid 32769 flags 60 wait 1ms
    p2 -> p1 stp rstp rootid "32768:00:26:cb:0b:0c:01" bridgeid "32768:00:26:cb:0b:0c:01" cost 20000 portid 32770 flags 28
}

compile {
    bpdu_guard_self_loop(access_sw_port1, access_sw_port2)
}
