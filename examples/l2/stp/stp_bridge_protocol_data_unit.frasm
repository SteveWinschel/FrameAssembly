// Spanning Tree Protocol standard BPDU transmission for loop prevention.
// Wire profile: 1 frame; 2 IPv4 hosts; STP.
// Verify packet timing and headers with `frameassembly show
// stp_bridge_protocol_data_unit.frasm` or write
// `stp_bridge_protocol_data_unit.pcap` via `frameassembly
// stp_bridge_protocol_data_unit.frasm` before replaying on a lab interface or
// opening in Wireshark.
// Wireshark: stp

host bridge_root { ip 10.0.0.1 }

host bridge_designated { ip 10.0.0.2 }

flow stp_bpdu_flow(root, desig) {
    root -> desig stp
}

compile {
    stp_bpdu_flow(bridge_root, bridge_designated)
}
