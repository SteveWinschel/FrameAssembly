// Minimal two-block IEEE 802.1D Spanning Tree Protocol starter for switch lab checks.
// Emits a classic 35-byte Configuration BPDU over 802.2 LLC (0x424203) addressed
// to Bridge Group multicast 01:80:c2:00:00:00 with MAC-only switch endpoints.
// Verify BPDU bytes with `frameassembly show stp_default_frame.frasm` or build
// a capture using `frameassembly stp_default_frame.frasm`.
// Wireshark: stp

host root_bridge { mac 00:11:22:33:44:01 }
host access_switch { mac 00:11:22:33:44:02 }

compile {
    root_bridge -> access_switch stp
}
