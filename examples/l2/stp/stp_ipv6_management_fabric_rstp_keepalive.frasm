// Dual-stack IPv6 management switches exchanging periodic RSTP Configuration
// BPDUs on out-of-band network.
// Wire profile: 2 frames; 2 IPv6 hosts; STP; waits 10ms.
// Wireshark: stp.version == 2

host oob_mgmt_root_v6 {
    ip 2001:db8:999::1
    mac 00:25:90:99:09:01
}

host oob_rack_sw_v6 {
    ip 2001:db8:999::10
    mac 00:25:90:99:09:0a
}

flow stp_ipv6_oob_keepalive(root, rack) {
    root -> rack stp rstp rootid "4096:00:25:90:99:09:01" bridgeid "4096:00:25:90:99:09:01" cost 0 portid 32775 maxage 20 hellotime 2 forwarddelay 15 flags 60 wait 10ms
    root -> rack stp rstp rootid "4096:00:25:90:99:09:01" bridgeid "4096:00:25:90:99:09:01" cost 0 portid 32775 maxage 20 hellotime 2 forwarddelay 15 flags 60
}

compile {
    stp_ipv6_oob_keepalive(oob_mgmt_root_v6, oob_rack_sw_v6)
}
