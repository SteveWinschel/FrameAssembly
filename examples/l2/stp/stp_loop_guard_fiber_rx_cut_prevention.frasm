// Loop Guard test case where an RSTP alternate port stops receiving BPDUs after a
// fiber Rx strand cut.
// Wire profile: 3 frames; 2 IPv4 hosts; STP; waits 10ms.
// Wireshark: stp.version == 2

host designated_fiber_sw {
    ip 172.22.10.1
    mac 00:1e:be:16:0a:01
}

host loopguard_alt_sw {
    ip 172.22.10.2
    mac 00:1e:be:16:0a:02
}

flow stp_loopguard_prefault(desig, alt) {
    desig -> alt stp rstp rootid "4096:00:1e:be:16:0a:00" bridgeid "8192:00:1e:be:16:0a:01" cost 2000 portid 32772 maxage 20 hellotime 2 forwarddelay 15 flags 60 wait 10ms
    desig -> alt stp rstp rootid "4096:00:1e:be:16:0a:00" bridgeid "8192:00:1e:be:16:0a:01" cost 2000 portid 32772 maxage 20 hellotime 2 forwarddelay 15 flags 60 wait 10ms
    desig -> alt stp rstp rootid "4096:00:1e:be:16:0a:00" bridgeid "8192:00:1e:be:16:0a:01" cost 2000 portid 32772 maxage 20 hellotime 2 forwarddelay 15 flags 60
}

compile {
    stp_loopguard_prefault(designated_fiber_sw, loopguard_alt_sw)
}
