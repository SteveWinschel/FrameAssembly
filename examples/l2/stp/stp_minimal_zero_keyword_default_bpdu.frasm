// Minimal STP and RSTP BPDU exchange using direct two-block host and compile syntax.
// Sends a 35-byte IEEE 802.1D Configuration BPDU, waits 5ms post-packet, then
// returns a 36-byte IEEE 802.1w RSTP BPDU over 802.2 LLC (0x424203).
// Inspect BPDU versions via `frameassembly show stp_minimal_zero_keyword_default_bpdu.frasm`.
// Wireshark: stp

host default_stp_a {
    ip 10.0.10.1
    mac 00:11:22:33:44:01
}

host default_stp_b {
    ip 10.0.10.2
    mac 00:11:22:33:44:02
}

compile {
    default_stp_a -> default_stp_b stp wait 5ms
    default_stp_a <- default_stp_b stp rstp
}
