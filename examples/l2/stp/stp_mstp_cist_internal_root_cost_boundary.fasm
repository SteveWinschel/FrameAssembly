// PROMPT: IEEE 802.1s Multiple Spanning Tree (MSTP) boundary bridges exchanging CIST Configuration and MSTI digest extensions.
// TOKENS: host, ip, mac, flow, stp, rstp, rootid, bridgeid, cost, portid, flags, payload, wait, ms, compile

// INSTRUCTION: Define MST Region 1 boundary root bridge.
host mst_region1_br {
    ip 10.180.1.1
    mac 00:1c:73:b4:01:01
}

// INSTRUCTION: Define MST Region 2 boundary peer bridge.
host mst_region2_br {
    ip 10.180.1.2
    mac 00:1c:73:b4:01:02
}

// INSTRUCTION: Exchange RSTP/MSTP BPDUs carrying appended MST Configuration Identifier payload.
flow stp_mstp_inter_region(r1, r2) {
    r1 -> r2 stp rstp rootid "4096:00:1c:73:b4:01:01" bridgeid "4096:00:1c:73:b4:01:01" cost 0 portid 32769 flags 60 payload "MSTP_DC_WEST_REV1" wait 5ms
    r1 <- r2 stp rstp rootid "4096:00:1c:73:b4:01:01" bridgeid "8192:00:1c:73:b4:01:02" cost 20000 portid 32769 flags 60 payload "MSTP_DC_EAST_REV1"
}

// INSTRUCTION: Compile the inter-region MSTP CIST boundary BPDU exchange.
compile {
    stp_mstp_inter_region(mst_region1_br, mst_region2_br)
}
