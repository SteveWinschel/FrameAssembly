// PROMPT: IEEE 802.1ad Provider Bridge Group Address (01:80:c2:00:00:08) STP BPDU tunneling across a Metro Ethernet QinQ core.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dstmac, stp, rstp, rootid, bridgeid, cost, portid, flags, compile

// INSTRUCTION: Define provider edge bridge A encapsulating customer STP into S-VLAN 2000.
host pe_bridge_west {
    ip 10.188.0.1
    mac 00:15:17:bc:00:01
}

// INSTRUCTION: Define provider edge bridge B receiving Provider Bridge STP BPDU.
host pe_bridge_east {
    ip 10.188.0.2
    mac 00:15:17:bc:00:02
}

// INSTRUCTION: Define QinQ tagged STP BPDU using Provider Bridge Group MAC 01:80:c2:00:00:08.
flow provider_bridge_stp_tunnel(west, east) {
    west -> east qinq 2000 innervlan 10 dstmac 01:80:c2:00:00:08 stp rstp rootid "4096:00:15:17:bc:00:01" bridgeid "4096:00:15:17:bc:00:01" cost 0 portid 32769 flags 60
}

// INSTRUCTION: Compile block executing Provider Bridge Group STP BPDU transmission.
compile {
    provider_bridge_stp_tunnel(pe_bridge_west, pe_bridge_east)
}
