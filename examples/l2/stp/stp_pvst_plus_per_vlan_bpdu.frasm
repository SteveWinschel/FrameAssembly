// Per-VLAN Spanning Tree Plus (PVST+) BPDUs transmitted to shared spanning tree
// multicast MAC 01:00:0c:cc:cc:cd on VLAN 100.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 100; PCP 7; STP; waits 2s.
// Wireshark: stp.version == 2

host pvst_pri_dist {
    ip 10.100.0.1
    mac 00:1e:14:64:00:01
}

host pvst_sec_dist {
    ip 10.100.0.2
    mac 00:1e:14:64:00:02
}

flow pvst_plus_vlan_bpdu(pri, sec) {
    pri -> sec vlan 100 pcp 7 dstmac 01:00:0c:cc:cc:cd stp rstp rootid "4196:00:1e:14:64:00:01" bridgeid "4196:00:1e:14:64:00:01" cost 0 portid 32769 flags 60 wait 2s
    pri <- sec vlan 100 pcp 7 dstmac 01:00:0c:cc:cc:cd stp rstp rootid "4196:00:1e:14:64:00:01" bridgeid "8292:00:1e:14:64:00:02" cost 2000 portid 32770 flags 60
}

compile {
    pvst_plus_vlan_bpdu(pvst_pri_dist, pvst_sec_dist)
}
