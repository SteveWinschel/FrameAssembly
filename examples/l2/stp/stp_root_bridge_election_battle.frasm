// Root bridge election battle between three switches advertising competing bridge
// priorities until lowest Root ID wins.
// Wire profile: 4 frames; 3 IPv4 hosts; STP; waits 5ms.
// Wireshark: stp

host elect_sw_a {
    ip 192.168.70.11
    mac 00:aa:00:70:00:0b
}

host elect_sw_b {
    ip 192.168.70.12
    mac 00:aa:00:70:00:0c
}

host elect_sw_c {
    ip 192.168.70.1
    mac 00:aa:00:70:00:01
}

flow root_bridge_election(a, b, c) {
    a -> b stp rootid "32768:00:aa:00:70:00:0b" bridgeid "32768:00:aa:00:70:00:0b" cost 0 portid 32769 hellotime 2 maxage 20 forwarddelay 15 wait 5ms
    b -> c stp rootid "16384:00:aa:00:70:00:0c" bridgeid "16384:00:aa:00:70:00:0c" cost 0 portid 32770 hellotime 2 maxage 20 forwarddelay 15 wait 5ms
    c -> b stp rootid "4096:00:aa:00:70:00:01" bridgeid "4096:00:aa:00:70:00:01" cost 0 portid 32769 hellotime 2 maxage 20 forwarddelay 15 wait 5ms
    b -> a stp rootid "4096:00:aa:00:70:00:01" bridgeid "16384:00:aa:00:70:00:0c" cost 4000 portid 32769 hellotime 2 maxage 20 forwarddelay 15
}

compile {
    root_bridge_election(elect_sw_a, elect_sw_b, elect_sw_c)
}
