// PROMPT: STP Root Guard validation test where a rogue access switch advertises priority 0 superior Root ID on a customer port.
// TOKENS: host, ip, mac, flow, stp, rstp, rootid, bridgeid, cost, portid, flags, compile

// INSTRUCTION: Define unauthorized rogue switch plugged into edge port.
host rogue_stp_switch {
    ip 10.66.6.66
    mac de:ad:00:66:06:42
}

// INSTRUCTION: Define Root-Guard-enabled enterprise access switch port.
host rootguard_edge_sw {
    ip 10.66.6.1
    mac 00:23:04:66:06:01
}

// INSTRUCTION: Define superior BPDU with priority 0 triggering Root-Inconsistent port blocking.
flow stp_root_guard_trigger(rogue, edge) {
    rogue -> edge stp rstp rootid "0:de:ad:00:66:06:42" bridgeid "0:de:ad:00:66:06:42" cost 0 portid 32769 flags 60
}

// INSTRUCTION: Compile block generating STP Root Guard test frame.
compile {
    stp_root_guard_trigger(rogue_stp_switch, rootguard_edge_sw)
}
