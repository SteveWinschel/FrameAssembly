// IEEE 802.1w Rapid Spanning Tree Protocol BPDU with rapid transition flags and
// forward delay.
// Wire profile: 1 frame; 2 IPv4 hosts; STP.
// Wireshark: stp.version == 2

host rstp_bridge_a { ip 10.100.1.1 }

host rstp_bridge_b { ip 10.100.1.2 }

flow rstp_rapid_flow(a, b) {
    a -> b stp rstp forwarddelay 4 flags 60
}

compile {
    rstp_rapid_flow(rstp_bridge_a, rstp_bridge_b)
}
