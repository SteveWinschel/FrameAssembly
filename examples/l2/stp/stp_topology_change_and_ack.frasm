// IEEE 802.1D Spanning Tree Topology Change Notification (TCN) and Topology
// Change Acknowledgment (TCA) BPDU exchange.
// Wire profile: 2 frames; 2 IPv4 hosts; STP; waits 4ms.
// Wireshark: stp

host access_sw_tcn {
    ip 10.45.0.12
    mac 00:1c:0e:45:00:0c
}

host root_bridge_tca {
    ip 10.45.0.1
    mac 00:1c:0e:45:00:01
}

flow stp_tcn_tca_exchange(access, root) {
    access -> root stp rootid "4096:00:1c:0e:45:00:01" bridgeid "32768:00:1c:0e:45:00:0c" cost 20000 portid 32769 flags 1 wait 4ms
    access <- root stp rootid "4096:00:1c:0e:45:00:01" bridgeid "4096:00:1c:0e:45:00:01" cost 0 portid 32770 flags 129
}

compile {
    stp_tcn_tca_exchange(access_sw_tcn, root_bridge_tca)
}
