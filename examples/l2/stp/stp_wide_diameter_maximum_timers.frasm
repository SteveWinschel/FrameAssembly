// Wide-diameter campus network STP BPDU configured with maximum IEEE 802.1D
// timers (MaxAge 40s, Hello 10s, ForwardDelay 30s).
// Wire profile: 1 frame; 2 IPv4 hosts; STP.
// Wireshark: stp

host wide_campus_root {
    ip 10.175.0.1
    mac 00:13:c4:af:00:01
}

host perimeter_bldg_sw {
    ip 10.175.0.7
    mac 00:13:c4:af:00:07
}

flow stp_wide_diameter_timers(root, perim) {
    root -> perim stp rootid "8192:00:13:c4:af:00:01" bridgeid "8192:00:13:c4:af:00:01" cost 140000 portid 32775 maxage 40 hellotime 10 forwarddelay 30 flags 0
}

compile {
    stp_wide_diameter_timers(wide_campus_root, perimeter_bldg_sw)
}
