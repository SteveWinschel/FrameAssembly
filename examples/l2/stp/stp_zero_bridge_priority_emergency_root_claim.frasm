// Emergency core switch asserting absolute minimum IEEE 802.1D bridge priority 0
// to force deterministic Root Bridge takeover.
// Wire profile: 2 frames; 2 IPv4 hosts; STP; waits 5ms.
// Wireshark: stp.version == 2

host core_priority_zero {
    ip 10.0.0.1
    mac 00:1c:73:00:00:01
}

host incumbent_root_4096 {
    ip 10.0.0.2
    mac 00:1c:73:00:00:02
}

flow stp_priority_zero_claim(zero_sw, inc_sw) {
    zero_sw -> inc_sw stp rstp rootid "0:00:1c:73:00:00:01" bridgeid "0:00:1c:73:00:00:01" cost 0 portid 32769 maxage 20 hellotime 2 forwarddelay 15 flags 14 wait 5ms
    zero_sw <- inc_sw stp rstp rootid "0:00:1c:73:00:00:01" bridgeid "4096:00:1c:73:00:00:02" cost 2000 portid 32769 maxage 20 hellotime 2 forwarddelay 15 flags 78
}

compile {
    stp_priority_zero_claim(core_priority_zero, incumbent_root_4096)
}
