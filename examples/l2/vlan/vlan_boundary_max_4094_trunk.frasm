// IEEE 802.1Q VLAN boundary ID 4094 trunk frame carrying network control traffic
// with PCP 7.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 4094; PCP 7; ICMP; waits 1ms.
// Wireshark: vlan.id == 4094 && vlan.priority == 7

host core_trunk_a {
    ip 10.255.254.1
    mac 00:1c:73:aa:ff:01
}

host core_trunk_b {
    ip 10.255.254.2
    mac 00:1c:73:aa:ff:02
}

flow vlan_max_id_trunk(sw_a, sw_b) {
    sw_a -> sw_b vlan 4094 pcp 7 dei 0 icmp echorequest wait 1ms
    sw_a <- sw_b vlan 4094 pcp 7 dei 0 icmp echoreply
}

compile {
    vlan_max_id_trunk(core_trunk_a, core_trunk_b)
}
