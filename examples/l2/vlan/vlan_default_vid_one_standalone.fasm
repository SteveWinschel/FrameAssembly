// PROMPT: Default VLAN 1 management frame using zero-parameter VLAN keyword and standalone L2 payload.
// TOKENS: host, ip, mac, flow, vlan, payload, compile

// INSTRUCTION: Define access switch management interface on default VLAN 1.
host access_mgmt_sw {
    ip 192.168.1.251
    mac 00:19:56:10:20:30
}

// INSTRUCTION: Define network management controller on default VLAN 1.
host nms_collector {
    ip 192.168.1.10
    mac 00:19:56:10:20:99
}

// INSTRUCTION: Define standalone default VLAN 1 frame with management keepalive payload.
flow default_vlan_one(sw, nms) {
    sw -> nms vlan payload "vlan1_native_keepalive_beacon"
}

// INSTRUCTION: Compile block executing default VLAN 1 frame generation.
compile {
    default_vlan_one(access_mgmt_sw, nms_collector)
}
