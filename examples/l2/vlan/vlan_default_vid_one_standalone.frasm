// Default VLAN 1 switch management frame using direct two-block host and compile syntax.
// Emits a single IEEE 802.1Q tagged frame (TPID 0x8100, default VID 1) carrying
// a management keepalive payload between an access switch and collector host.
// Verify VID 1 tagging with `frameassembly show vlan_default_vid_one_standalone.frasm`.
// Wireshark: vlan.id == 1

host access_mgmt_sw {
    ip 192.168.1.251
    mac 00:19:56:10:20:30
}

host nms_collector {
    ip 192.168.1.10
    mac 00:19:56:10:20:99
}

compile {
    access_mgmt_sw -> nms_collector vlan payload "vlan1_native_keepalive_beacon"
}
