// Guest Wi-Fi isolation VLAN 666 with DEI drop-eligible marking and captive
// portal DNS/HTTP redirect.
// Wire profile: 4 frames; 2 IPv4 hosts; VLAN 666; PCP 1; DNS, HTTP; waits 3ms,
// 2ms.
// Wireshark: vlan.id == 666 && vlan.priority == 1

host guest_wifi_sta { ip 172.19.66.142 }

host wlc_portal_gw { ip 172.19.66.1 }

flow guest_vlan_captive_portal(sta, wlc) {
    sta -> wlc vlan 666 pcp 1 dei 1 dns qname "connectivitycheck.gstatic.com" wait 3ms
    sta <- wlc vlan 666 pcp 1 dei 0 dns qname "connectivitycheck.gstatic.com" rdata "172.19.66.1" wait 2ms
    sta -> wlc vlan 666 pcp 1 dei 1 http get uri "/generate_204" wait 2ms
    sta <- wlc vlan 666 pcp 1 dei 0 http status 302
}

compile {
    guest_vlan_captive_portal(guest_wifi_sta, wlc_portal_gw)
}
