// IPTV multicast distribution VLAN 500 with IGMPv3 membership report and UDP
// MPEG-TS video stream.
// Wire profile: 3 frames; 3 IPv4 hosts; VLAN 500; PCP 4,5; IGMP, UDP; dstport
// 5000; waits 5ms.
// Wireshark: vlan.id == 500 && vlan.priority == 4

host iptv_stb {
    ip 10.50.5.88
    mac 00:09:df:50:05:58
}

host iptv_headend {
    ip 10.50.5.1
    mac 00:1b:21:50:05:01
}

host mcast_channel_hd { ip 239.100.1.1 }

flow iptv_multicast_vlan(stb, headend, channel) {
    stb -> headend vlan 500 pcp 4 igmp report group 239.100.1.1 wait 5ms
    headend -> channel vlan 500 pcp 5 udp srcport 5000 dstport 5000 payload "mpeg_ts_sync_0x47_pid_0x0100_iframe" wait 5ms
    headend -> channel vlan 500 pcp 5 udp srcport 5000 dstport 5000 payload "mpeg_ts_sync_0x47_pid_0x0100_pframe"
}

compile {
    iptv_multicast_vlan(iptv_stb, iptv_headend, mcast_channel_hd)
}
