// PROMPT: IPv6 router-on-a-stick forwarding inter-VLAN traffic between corporate workstation VLAN 101 and server VLAN 102.
// TOKENS: host, ip, mac, flow, vlan, pcp, dei, ttl, flowlabel, tcp, syn, srcport, dstport, seq, win, mss, wait, ms, ack, acknum, compile

// INSTRUCTION: Define enterprise IPv6 workstation on access VLAN 101.
host corp_ws_v6 {
    ip 2001:db8:101::25
    mac 00:21:70:65:01:19
}

// INSTRUCTION: Define internal application server reachable via router subinterface on VLAN 102.
host corp_srv_v6 {
    ip 2001:db8:102::80
    mac 00:25:90:66:02:50
}

// INSTRUCTION: Send IPv6 TCP SYN on ingress VLAN 101 and receive SYN-ACK on egress VLAN 102 with decremented Hop Limit.
flow vlan_ipv6_roas_routing(ws, srv) {
    ws -> srv vlan 101 pcp 3 dei 0 ttl 64 flowlabel 10102 tcp syn srcport 51000 dstport 443 seq 1000 win 65535 mss 1440 wait 5ms
    ws <- srv vlan 102 pcp 3 dei 0 ttl 63 flowlabel 10102 tcp syn ack srcport 443 dstport 51000 seq 5000 acknum 1001 win 65535 mss 1440
}

// INSTRUCTION: Compile the IPv6 router-on-a-stick VLAN 101/102 inter-VLAN forwarding trace.
compile {
    vlan_ipv6_roas_routing(corp_ws_v6, corp_srv_v6)
}
