// Shared flow for dual-stack IPv4 and IPv6 BGP peering over 802.1Q tagged IXP
// peering VLAN 999.
// Wire profile: 8 frames; 4 dual-stack IPv4/IPv6 hosts; VLAN 999; PCP 6; BGP;
// waits 2ms, 5ms.
// Wireshark: vlan.id == 999 && vlan.priority == 6

host ixp_peer_a_v4 { ip 198.32.160.10 }

host ixp_peer_b_v4 { ip 198.32.160.20 }

host ixp_peer_a_v6 { ip 2001:504:16::a }

host ixp_peer_b_v6 { ip 2001:504:16::14 }

flow ixp_vlan_bgp_session(peer1, peer2) {
    peer1 -> peer2 vlan 999 pcp 6 ttl 1 bgp open asn 64512 holdtime 90 bgpid 198.32.160.10 wait 2ms
    peer1 <- peer2 vlan 999 pcp 6 ttl 1 bgp open asn 64513 holdtime 90 bgpid 198.32.160.20 wait 5ms
    peer1 -> peer2 vlan 999 pcp 6 ttl 1 bgp keepalive wait 5ms
    peer1 <- peer2 vlan 999 pcp 6 ttl 1 bgp keepalive wait 5ms
}

compile {
    ixp_vlan_bgp_session(ixp_peer_a_v4, ixp_peer_b_v4)
    ixp_vlan_bgp_session(ixp_peer_a_v6, ixp_peer_b_v6)
}
