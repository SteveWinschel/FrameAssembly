// Hybrid switch port contrasting standalone IEEE 802.1Q VLAN 100 control frames
// with priority-tagged VLAN 200 frames.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 100,200; PCP 0,5; VLAN; waits 5ms.
// Wireshark: vlan.id == 100 || vlan.id == 200

host hybrid_trunk_a {
    ip 10.10.100.1
    mac 00:1c:73:0a:64:01
}

host hybrid_trunk_b {
    ip 10.10.100.2
    mac 00:1c:73:0a:64:02
}

flow vlan_hybrid_standalone(a, b) {
    a -> b vlan 100 pcp 0 dei 0 payload "hybrid_port_vlan100_untagged_equivalent" wait 5ms
    a <- b vlan 200 pcp 5 dei 1 payload "hybrid_port_vlan200_tagged_drop_eligible"
}

compile {
    vlan_hybrid_standalone(hybrid_trunk_a, hybrid_trunk_b)
}
