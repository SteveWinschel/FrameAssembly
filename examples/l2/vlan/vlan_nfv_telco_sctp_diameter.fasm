// PROMPT: Hypervisor vSwitch trunk port carrying SCTP Diameter signaling on telco NFV VLAN 2100.
// TOKENS: host, ip, mac, flow, vlan, pcp, sctp, chunk, init, vtag, srcport, dstport, initack, wait, ms, data, stream, ssn, ppid, payload, compile

// INSTRUCTION: Define virtualized MME pod on NFV compute host A.
host vnf_mme_node {
    ip 10.210.1.10
    mac 52:54:00:d2:01:0a
}

// INSTRUCTION: Define virtualized HSS pod on NFV compute host B.
host vnf_hss_node {
    ip 10.210.1.20
    mac 52:54:00:d2:01:14
}

// INSTRUCTION: Define VLAN 2100 tagged SCTP association and S6a Diameter payload exchange.
flow nfv_vlan_sctp_s6a(mme, hss) {
    mme -> hss vlan 2100 pcp 5 sctp chunk init vtag 0 srcport 3868 dstport 3868
    mme <- hss vlan 2100 pcp 5 sctp chunk initack vtag 77100 srcport 3868 dstport 3868 wait 1ms
    mme -> hss vlan 2100 pcp 5 sctp chunk data vtag 77100 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_ulr_imsi_00101" wait 2ms
}

// INSTRUCTION: Compile block executing NFV VLAN 2100 SCTP Diameter exchange.
compile {
    nfv_vlan_sctp_s6a(vnf_mme_node, vnf_hss_node)
}
