// Hypervisor vSwitch trunk port carrying SCTP Diameter signaling on telco NFV
// VLAN 2100.
// Wire profile: 3 frames; 2 IPv4 hosts; VLAN 2100; PCP 5; SCTP; SCTP
// DATA/INIT/INITACK; PPID 46; dstport 3868; waits 1ms, 2ms.
// Wireshark: vlan.id == 2100 && vlan.priority == 5

host vnf_mme_node {
    ip 10.210.1.10
    mac 52:54:00:d2:01:0a
}

host vnf_hss_node {
    ip 10.210.1.20
    mac 52:54:00:d2:01:14
}

flow nfv_vlan_sctp_s6a(mme, hss) {
    mme -> hss vlan 2100 pcp 5 sctp chunk init vtag 0 srcport 3868 dstport 3868 wait 1ms
    mme <- hss vlan 2100 pcp 5 sctp chunk initack vtag 77100 srcport 3868 dstport 3868 wait 2ms
    mme -> hss vlan 2100 pcp 5 sctp chunk data vtag 77100 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_ulr_imsi_00101"
}

compile {
    nfv_vlan_sctp_s6a(vnf_mme_node, vnf_hss_node)
}
