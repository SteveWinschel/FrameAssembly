// Out-of-band IPMI/BMC management VLAN 4000 carrying SSH and SNMPv3 health
// monitoring.
// Wire profile: 3 frames; 2 IPv4 hosts; VLAN 4000; PCP 2; SNMPv3, SSH; waits 3ms,
// 5ms.
// Wireshark: vlan.id == 4000 && vlan.priority == 2

host oob_bastion {
    ip 10.240.0.5
    mac 00:25:90:00:b0:05
}

host bmc_controller {
    ip 10.240.0.101
    mac 00:25:90:ee:01:01
}

flow oob_bmc_management(bastion, bmc) {
    bastion -> bmc vlan 4000 pcp 2 ssh banner "SSH-2.0-OpenSSH_9.6" wait 3ms
    bastion <- bmc vlan 4000 pcp 2 ssh banner "SSH-2.0-OpenBMC_2.14" wait 5ms
    bastion -> bmc vlan 4000 pcp 2 snmp3 get user "bmc_admin" auth sha256 "OobAuthKey2026!" priv aes "OobPrivKey2026!" varbind 1.3.6.1.2.1.1.5.0 string "rack01-bmc"
}

compile {
    oob_bmc_management(oob_bastion, bmc_controller)
}
