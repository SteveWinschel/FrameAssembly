// PROMPT: Out-of-band IPMI/BMC management VLAN 4000 carrying SSH and SNMPv3 health monitoring.
// TOKENS: host, ip, mac, flow, vlan, pcp, ssh, banner, wait, ms, snmp3, get, user, auth, sha256, priv, aes, varbind, string, compile

// INSTRUCTION: Define bastion management jump host on OOB VLAN 4000.
host oob_bastion {
    ip 10.240.0.5
    mac 00:25:90:00:b0:05
}

// INSTRUCTION: Define rack server BMC controller on OOB VLAN 4000.
host bmc_controller {
    ip 10.240.0.101
    mac 00:25:90:ee:01:01
}

// INSTRUCTION: Define OOB management VLAN 4000 SSH banner check and SNMPv3 thermal sensor poll.
flow oob_bmc_management(bastion, bmc) {
    bastion -> bmc vlan 4000 pcp 2 ssh banner "SSH-2.0-OpenSSH_9.6"
    bastion <- bmc vlan 4000 pcp 2 ssh banner "SSH-2.0-OpenBMC_2.14" wait 3ms
    bastion -> bmc vlan 4000 pcp 2 snmp3 get user "bmc_admin" auth sha256 "OobAuthKey2026!" priv aes "OobPrivKey2026!" varbind 1.3.6.1.2.1.1.5.0 string "rack01-bmc" wait 5ms
}

// INSTRUCTION: Compile block executing OOB management VLAN 4000 session.
compile {
    oob_bmc_management(oob_bastion, bmc_controller)
}
