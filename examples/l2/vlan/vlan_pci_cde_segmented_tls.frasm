// PCI-DSS cardholder data environment (CDE) VLAN 800 carrying mutually
// authenticated TLS 1.3 traffic.
// Wire profile: 4 frames; 2 IPv4 hosts; VLAN 800; PCP 4; TLS; waits 2ms, 1ms.
// Wireshark: vlan.id == 800 && vlan.priority == 4

host pos_gateway {
    ip 10.80.8.12
    mac 00:50:56:99:08:0c
}

host token_vault_srv {
    ip 10.80.8.200
    mac 00:50:56:99:08:c8
}

flow pci_cde_vlan_tls(pos, vault) {
    pos -> vault vlan 800 pcp 4 dei 0 tls clienthello sni "vault.pci.internal" alpn "h2" wait 2ms
    pos <- vault vlan 800 pcp 4 dei 0 tls serverhello alpn "h2" wait 1ms
    pos -> vault vlan 800 pcp 4 dei 0 tls finished wait 1ms
    pos -> vault vlan 800 pcp 4 dei 0 tls appdata
}

compile {
    pci_cde_vlan_tls(pos_gateway, token_vault_srv)
}
