// Private VLAN (PVLAN) architecture mapping isolated secondary VLAN 502 host to
// promiscuous primary VLAN 500 gateway.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 500,502; PCP 0; ICMP; waits 5ms.
// Wireshark: vlan.id == 500 || vlan.id == 502

host pvlan_isolated_srv {
    ip 172.30.50.102
    mac 00:25:90:1e:32:66
}

host pvlan_promisc_fw {
    ip 172.30.50.1
    mac 00:1b:17:1e:32:01
}

flow pvlan_isolated_to_promisc(srv, fw) {
    srv -> fw vlan 502 pcp 0 dei 0 icmp echorequest id 502 seq 1 payload "pvlan_isolated_upstream_ping" wait 5ms
    srv <- fw vlan 500 pcp 0 dei 0 icmp echoreply id 502 seq 1 payload "pvlan_isolated_upstream_ping"
}

compile {
    pvlan_isolated_to_promisc(pvlan_isolated_srv, pvlan_promisc_fw)
}
