// PROMPT: Retail branch point-of-sale terminal on PCI-DSS VLAN 650 communicating with store payment gateway.
// TOKENS: host, ip, mac, flow, vlan, pcp, dei, tcp, psh, ack, srcport, dstport, seq, acknum, win, payload, wait, ms, compile

// INSTRUCTION: Define retail point-of-sale PIN pad terminal on restricted VLAN 650.
host pos_pinpad_term {
    ip 10.65.10.21
    mac 00:0b:4f:41:0a:15
}

// INSTRUCTION: Define store payment encryption controller on VLAN 650.
host store_pay_ctrl {
    ip 10.65.10.1
    mac 00:0b:4f:41:0a:01
}

// INSTRUCTION: Exchange ISO 8583 authorization frames over TCP port 8443 on PCI-DSS VLAN 650 PCP 4.
flow vlan_retail_pos_auth(pos, ctrl) {
    pos -> ctrl vlan 650 pcp 4 dei 0 tcp psh ack srcport 49100 dstport 8443 seq 100 acknum 200 win 16384 payload "ISO8583_0200_AUTH_REQ_DUKPT_PIN_BLOCK" wait 10ms
    pos <- ctrl vlan 650 pcp 4 dei 0 tcp psh ack srcport 8443 dstport 49100 seq 200 acknum 137 win 16384 payload "ISO8583_0210_AUTH_RSP_00_APPROVED"
}

// INSTRUCTION: Compile the retail PCI-DSS VLAN 650 point-of-sale authorization trace.
compile {
    vlan_retail_pos_auth(pos_pinpad_term, store_pay_ctrl)
}
