// PROMPT: Enterprise Wi-Fi 6E access point splitting management CAPWAP control on VLAN 40 and local-bridged employee data on VLAN 140.
// TOKENS: host, ip, mac, flow, vlan, pcp, dei, dscp, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define ceiling Wi-Fi 6E access point trunk uplink port.
host wifi6e_ap_uplink {
    ip 10.40.0.50
    mac 00:2c:c8:28:00:32
}

// INSTRUCTION: Define campus distribution switch terminating AP trunk VLANs 40 and 140.
host campus_wlc_sw {
    ip 10.40.0.1
    mac 00:1c:73:28:00:01
}

// INSTRUCTION: Send CAPWAP control keepalive on management VLAN 40 PCP 6 and employee data on VLAN 140 PCP 0.
flow vlan_ap_split_tunnel(ap, sw) {
    ap -> sw vlan 40 pcp 6 dei 0 dscp 48 udp srcport 5246 dstport 5246 payload "capwap_echo_request_ap_radio_stats" wait 5ms
    ap <- sw vlan 40 pcp 6 dei 0 dscp 48 udp srcport 5246 dstport 5246 payload "capwap_echo_response_wlc_ack" wait 5ms
    ap -> sw vlan 140 pcp 0 dei 0 udp srcport 55100 dstport 443 payload "quic_http3_employee_ssid_local_breakout"
}

// INSTRUCTION: Compile the Wi-Fi 6E split-tunnel VLAN 40 and VLAN 140 trunk flow.
compile {
    vlan_ap_split_tunnel(wifi6e_ap_uplink, campus_wlc_sw)
}
