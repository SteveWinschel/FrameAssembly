// Single IPsec Authentication Header (AH, RFC 4302) packet over IP protocol 51
// with SPI 6001 and sequence number 1 between two gateways. Useful for checking
// firewall protocol-51 permit rules or IDS decoding without live IPsec keys.
// Wireshark: ah && ah.spi == 6001

host ipsec_gw1 {
    ip 198.51.100.1
}

host ipsec_gw2 {
    ip 198.51.100.2
}

// Send one AH frame directly using SPI 6001, sequence 1, and default ICV.
compile {
    ipsec_gw1 -> ipsec_gw2 ah spi 6001 seq 1
}
