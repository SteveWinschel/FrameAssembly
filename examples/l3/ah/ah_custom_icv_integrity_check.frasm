// PROMPT: IPsec AH packet with explicit Integrity Check Value digest and SPI over IPv4.
// TOKENS: host, ip, mac, flow, ah, spi, seq, icv, compile

// INSTRUCTION: Define primary security gateway with static IPv4 and MAC address.
host sec_gw_west { ip 172.16.10.1 mac 00:1a:2b:3c:4d:01 }

// INSTRUCTION: Define peer security gateway validating AH HMAC digest.
host sec_gw_east { ip 172.16.10.2 mac 00:1a:2b:3c:4d:02 }

// INSTRUCTION: Define bidirectional AH exchange carrying explicit ICV digests.
flow ah_icv_exchange(west, east) {
    west -> east ah spi 305419896 seq 10 icv "a1b2c3d4e5f60718293a4b5c"
    west <- east ah spi 305419897 seq 10 icv "ffeeddccbbaa998877665544"
}

// INSTRUCTION: Compile the AH custom ICV verification flow.
compile {
    ah_icv_exchange(sec_gw_west, sec_gw_east)
}
