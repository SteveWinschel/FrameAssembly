// Minimal IPsec Authentication Header (AH, RFC 4302) starter packet sent over
// IP protocol 51 with built-in defaults (SPI 0x2000, sequence 1, 12-byte ICV,
// Next Header 59). No flow block or keys are needed to test firewall
// protocol-51 handling.
// Wireshark: ah

host endpoint_a {
    ip 10.51.0.1
    mac 02:00:51:00:00:01
}

host endpoint_b {
    ip 10.51.0.2
    mac 02:00:51:00:00:02
}

// Transmit one default AH frame directly inside compile.
compile {
    endpoint_a -> endpoint_b ah
}
