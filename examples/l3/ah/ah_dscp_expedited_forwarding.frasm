// IPsec AH control plane session marked with DSCP EF (46) and ECN ECT(1) over
// IPv4.
// This capture sets DSCP 46, TTL 128, carries SPI 14400/14401, and uses
// post-packet wait gaps (15ms) between frames.
// Wireshark: ah

host telemetry_hub { ip 192.0.2.50 }

host substation_rtu { ip 192.0.2.51 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_qos_marked_flow(hub, rtu) {
    hub -> rtu ah spi 14400 seq 1 dscp 46 ecn 1 ttl 128 wait 15ms
    hub <- rtu ah spi 14401 seq 1 dscp 46 ecn 1 ttl 128
}

// Run ah_qos_marked_flow(telemetry_hub, substation_rtu) to generate the
// capture.
compile {
    ah_qos_marked_flow(telemetry_hub, substation_rtu)
}
