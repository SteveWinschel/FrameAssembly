// RFC 4302 IPsec AH authenticating GRE tunnel packets (Next Header 47)
// between enterprise WAN routers.
// This capture sets DSCP 24, TTL 64, DF bit set, carries SPI 47001/47002, and
// uses post-packet wait gaps (6ms) between frames.
// Wireshark: ah

host wan_gre_ah_rtr1 {
    ip 198.18.47.1
    mac 00:1d:71:47:01:01
}

host wan_gre_ah_rtr2 {
    ip 198.18.47.2
    mac 00:1d:71:47:01:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_protecting_gre_flow(r1, r2) {
    r1 -> r2 ah spi 47001 seq 301 nextheader 47 icv "474747470102030405060708" dscp 24 df ttl 64 hexpayload "20000800000003e84752455f494e5f4148" wait 6ms
    r1 <- r2 ah spi 47002 seq 301 nextheader 47 icv "080706050403020147474747" dscp 24 df ttl 64 hexpayload "20000800000003e84752455f41434b"
}

// Run ah_protecting_gre_flow(wan_gre_ah_rtr1, wan_gre_ah_rtr2) to generate
// the capture.
compile {
    ah_protecting_gre_flow(wan_gre_ah_rtr1, wan_gre_ah_rtr2)
}
