// IPsec AH packet encapsulating raw binary HEXPAYLOAD and custom
// source/destination MACs.
// This capture carries SPI 20480.
// Wireshark: ah

host sec_appliance_a { ip 10.99.0.10 }

host sec_appliance_b { ip 10.99.0.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ah_hex_payload_flow(a, b) {
    a -> b ah spi 20480 seq 7 nextheader 17 srcmac 02:00:5e:10:00:01 dstmac 02:00:5e:10:00:02 hexpayload "4500001c0001000040117cce"
}

// Run ah_hex_payload_flow(sec_appliance_a, sec_appliance_b) to generate the
// capture.
compile {
    ah_hex_payload_flow(sec_appliance_a, sec_appliance_b)
}
