// PROMPT: IPsec AH anti-replay window validation with high sequence numbers and custom ICVs.
// TOKENS: host, ip, flow, s, ah, spi, seq, icv, wait, ms, compile

// INSTRUCTION: Define sender testing anti-replay sliding window boundary.
host replay_test_src { ip 172.30.100.10 }

// INSTRUCTION: Define receiver validating sequence numbers against its replay bitmap.
host replay_test_dst { ip 172.30.100.20 }

// INSTRUCTION: Define AH sequence progression across high sequence numbers.
flow ah_replay_window_flow(s, d) {
    s -> d ah spi 999001 seq 65534 icv "11223344556677889900aabb"
    s -> d ah spi 999001 seq 65535 icv "223344556677889900aabbcc" wait 5ms
    s -> d ah spi 999001 seq 65536 icv "3344556677889900aabbccdd" wait 5ms
}

// INSTRUCTION: Compile the AH anti-replay sequence test.
compile {
    ah_replay_window_flow(replay_test_src, replay_test_dst)
}
