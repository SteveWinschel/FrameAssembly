// IPsec AH anti-replay window validation with high sequence numbers and
// custom ICVs.
// This capture carries SPI 999001 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: ah

host replay_test_src { ip 172.30.100.10 }

host replay_test_dst { ip 172.30.100.20 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow ah_replay_window_flow(s, d) {
    s -> d ah spi 999001 seq 65534 icv "11223344556677889900aabb" wait 5ms
    s -> d ah spi 999001 seq 65535 icv "223344556677889900aabbcc" wait 5ms
    s -> d ah spi 999001 seq 65536 icv "3344556677889900aabbccdd"
}

// Run ah_replay_window_flow(replay_test_src, replay_test_dst) to generate the
// capture.
compile {
    ah_replay_window_flow(replay_test_src, replay_test_dst)
}
