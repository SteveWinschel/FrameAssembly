// PROMPT: RFC 4302 IPsec AH authenticating diagnostic ICMPv4 Echo traffic (Next Header 1) between Bastion hosts.
// TOKENS: host, ip, mac, flow, ah, spi, seq, nextheader, icv, ttl, hexpayload, wait, ms, compile

// INSTRUCTION: Define management bastion host initiating authenticated ICMP probes.
host mgmt_bastion_01 {
    ip 10.254.0.10
    mac 00:50:56:fe:00:0a
}

// INSTRUCTION: Define core firewall appliance responding under AH Security Association.
host core_fw_appliance {
    ip 10.254.0.1
    mac 00:50:56:fe:00:01
}

// INSTRUCTION: Define AH flow carrying Next Header 1 (ICMPv4) with hexadecimal echo payload.
flow ah_icmp_ping_flow(bastion, fw) {
    bastion -> fw ah spi 10101 seq 1 nextheader 1 icv "080012340001aabbccddeeff" ttl 64 hexpayload "0800f7fd0001000141485f50494e47" wait 5ms
    bastion <- fw ah spi 10102 seq 1 nextheader 1 icv "ffeeddccbbaa000112340800" ttl 64 hexpayload "0000fffd0001000141485f504f4e47"
}

// INSTRUCTION: Compile the AH-authenticated ICMP diagnostic flow.
compile {
    ah_icmp_ping_flow(mgmt_bastion_01, core_fw_appliance)
}
