// RFC 4302 IPsec AH tunnel mode encapsulating inner IPv4 datagrams (Next
// Header 4) between security gateways.
// This capture sets TTL 61/62, DF bit set, carries SPI 70010/70020, and uses
// post-packet wait gaps (8ms) between frames.
// Wireshark: ah

host branch_ah_gw {
    ip 203.0.113.10
    mac 00:15:5d:01:13:0a
}

host hq_ah_concentrator {
    ip 198.51.100.200
    mac 00:15:5d:64:c8:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_tunnel_ip4_in_ip4(branch, hq) {
    branch -> hq ah spi 70010 seq 101 nextheader 4 icv "deadbeefcafebabe01020304" ipid 1101 df ttl 62 payload "INNER_IPV4_ERP_TRANSACTION" wait 8ms
    branch <- hq ah spi 70020 seq 505 nextheader 4 icv "04030201babecafebeefdead" ipid 2202 df ttl 61 payload "INNER_IPV4_ERP_COMMIT_OK"
}

// Run ah_tunnel_ip4_in_ip4(branch_ah_gw, hq_ah_concentrator) to generate the
// capture.
compile {
    ah_tunnel_ip4_in_ip4(branch_ah_gw, hq_ah_concentrator)
}
