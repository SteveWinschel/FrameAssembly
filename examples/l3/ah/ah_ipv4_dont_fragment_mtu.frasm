// IPv4 AH authenticated packet asserting Don't Fragment and explicit IP
// identification.
// This capture sets DF bit set and carries SPI 60010.
// Wireshark: ah

host pmtud_sender { ip 10.12.34.1 }

host pmtud_receiver { ip 10.12.34.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ah_df_mtu_probe(src, dst) {
    src -> dst ah spi 60010 seq 1 ipid 1024 df nextheader 4 payload "MTU_PROBE_1400"
    src -> dst ah spi 60010 seq 2 ipid 1025 df nextheader 4 payload "MTU_PROBE_1460"
}

// Run ah_df_mtu_probe(pmtud_sender, pmtud_receiver) to generate the capture.
compile {
    ah_df_mtu_probe(pmtud_sender, pmtud_receiver)
}
