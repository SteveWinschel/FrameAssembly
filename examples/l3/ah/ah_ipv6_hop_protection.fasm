// PROMPT: IPsec AH authentication header protecting IPv6 traffic between endpoints.
// TOKENS: HOST, IP, FLOW, ->, AH, SPI, SEQ, COMPILE

// INSTRUCTION: Define IPv6 client host A.
HOST ah_v6_host_a { IP 2001:db8:a::1 }

// INSTRUCTION: Define IPv6 server host B.
HOST ah_v6_host_b { IP 2001:db8:a::2 }

// INSTRUCTION: Define AH authentication flow over IPv6 with SPI 70001.
FLOW ah_v6_flow(a, b) {
    a -> b AH SPI 70001 SEQ 1
}

// INSTRUCTION: Compile block executing AH IPv6 protection.
COMPILE {
    ah_v6_flow(ah_v6_host_a, ah_v6_host_b)
}
