// PROMPT: RFC 4302 IPsec AH over IPv6 in tunnel mode protecting inner IPv6 packets (Next Header 41).
// TOKENS: host, ip, mac, flow, ah, spi, seq, nextheader, icv, flowlabel, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define West Coast IPv6 security gateway.
host v6_ah_gw_west {
    ip 2001:db8:100::1
    mac 00:25:90:aa:00:01
}

// INSTRUCTION: Define East Coast IPv6 security gateway.
host v6_ah_gw_east {
    ip 2001:db8:200::1
    mac 00:25:90:aa:00:02
}

// INSTRUCTION: Define IPv6 AH tunnel mode flow with Next Header 41 (IPv6) and Flow Label 65536.
flow ah_v6_tunnel_flow(west, east) {
    west -> east ah spi 91001 seq 1 nextheader 41 icv "f0e1d2c3b4a5968778695a4b" flowlabel 65536 dscp 34 ttl 64 payload "INNER_IPV6_TELEMETRY_FRAME" wait 12ms
    west <- east ah spi 91002 seq 1 nextheader 41 icv "4b5a69788796a5b4c3d2e1f0" flowlabel 65536 dscp 34 ttl 64 payload "INNER_IPV6_TELEMETRY_ACK"
}

// INSTRUCTION: Compile the IPv6-in-IPv6 AH tunnel mode security scenario.
compile {
    ah_v6_tunnel_flow(v6_ah_gw_west, v6_ah_gw_east)
}
