// RFC 4302 IPsec AH over IPv6 in tunnel mode protecting inner IPv6 packets
// (Next Header 41).
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 64, IPv6 Flow Label,
// carries SPI 91001/91002, and uses post-packet wait gaps (12ms) between
// frames.
// Wireshark: ah && ipv6

host v6_ah_gw_west {
    ip 2001:db8:100::1
    mac 00:25:90:aa:00:01
}

host v6_ah_gw_east {
    ip 2001:db8:200::1
    mac 00:25:90:aa:00:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_v6_tunnel_flow(west, east) {
    west -> east ah spi 91001 seq 1 nextheader 41 icv "f0e1d2c3b4a5968778695a4b" flowlabel 65536 dscp 34 ttl 64 payload "INNER_IPV6_TELEMETRY_FRAME" wait 12ms
    west <- east ah spi 91002 seq 1 nextheader 41 icv "4b5a69788796a5b4c3d2e1f0" flowlabel 65536 dscp 34 ttl 64 payload "INNER_IPV6_TELEMETRY_ACK"
}

// Run ah_v6_tunnel_flow(v6_ah_gw_west, v6_ah_gw_east) to generate the
// capture.
compile {
    ah_v6_tunnel_flow(v6_ah_gw_west, v6_ah_gw_east)
}
