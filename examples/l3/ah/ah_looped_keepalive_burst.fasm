// PROMPT: Periodic IPsec AH heartbeat burst executed inside a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, ah, spi, seq, wait, ms, compile

// INSTRUCTION: Define primary WAN concentrator.
host wan_conc_primary { ip 203.0.113.100 }

// INSTRUCTION: Define remote spoke router.
host wan_spoke_router { ip 203.0.113.101 }

// INSTRUCTION: Define bidirectional AH heartbeat probe with 20ms interval.
flow ah_heartbeat_cycle(conc, spoke) {
    conc -> spoke ah spi 3300 seq 1 wait 20ms
    conc <- spoke ah spi 3301 seq 1 wait 20ms
}

// INSTRUCTION: Compile 4 consecutive iterations of the AH heartbeat cycle.
compile {
    ah_heartbeat_cycle(wan_conc_primary, wan_spoke_router) // cycle 1
    ah_heartbeat_cycle(wan_conc_primary, wan_spoke_router) // cycle 2
    ah_heartbeat_cycle(wan_conc_primary, wan_spoke_router) // cycle 3
    ah_heartbeat_cycle(wan_conc_primary, wan_spoke_router) // cycle 4
}
