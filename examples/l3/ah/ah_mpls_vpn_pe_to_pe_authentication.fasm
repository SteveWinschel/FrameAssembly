// PROMPT: MPLS L3VPN Provider Edge routers exchanging RFC 4302 AH-authenticated control frames with VLAN and MPLS shims.
// TOKENS: HOST, IP, MAC, FLOW, AH, SPI, SEQ, NEXT_HEADER, ICV, VLAN, PCP, MPLS, EXP, BOS, MPLS_TTL, TTL, PAYLOAD, WAIT, COMPILE

// INSTRUCTION: Define Provider Edge router PE-North with MPLS and VLAN trunking.
HOST pe_north_ah {
    IP 10.200.51.1
    MAC 00:22:bd:51:00:01
}

// INSTRUCTION: Define Provider Edge router PE-South terminating MPLS-labeled AH frames.
HOST pe_south_ah {
    IP 10.200.51.2
    MAC 00:22:bd:51:00:02
}

// INSTRUCTION: Define VLAN and MPLS tagged AH exchange with EXP 6 and BOS 1.
FLOW ah_mpls_vlan_pe_flow(north, south) {
    north -> south AH SPI 88471 SEQ 15 NEXT_HEADER 4 ICV "884700018847000288470003" VLAN 510 PCP 6 MPLS 24051 EXP 6 BOS 1 MPLS_TTL 63 TTL 63 PAYLOAD "MPLS_PE_AUTH_VRF_SYNC" WAIT 5ms
    north <- south AH SPI 88472 SEQ 15 NEXT_HEADER 4 ICV "000388470002884700018847" VLAN 510 PCP 6 MPLS 24052 EXP 6 BOS 1 MPLS_TTL 63 TTL 63 PAYLOAD "MPLS_PE_AUTH_VRF_ACK"
}

// INSTRUCTION: Compile the MPLS + VLAN Provider Edge AH authentication flow.
COMPILE {
    ah_mpls_vlan_pe_flow(pe_north_ah, pe_south_ah)
}
