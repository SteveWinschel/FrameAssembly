// MPLS L3VPN Provider Edge routers exchanging RFC 4302 AH-authenticated
// control frames with VLAN and MPLS shims.
// This capture wraps frames in 802.1Q VLAN 510 and MPLS label 24051/24052,
// sets TTL 63, carries SPI 88471/88472, and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: ah && vlan.id == 510 && mpls

host pe_north_ah {
    ip 10.200.51.1
    mac 00:22:bd:51:00:01
}

host pe_south_ah {
    ip 10.200.51.2
    mac 00:22:bd:51:00:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_mpls_vlan_pe_flow(north, south) {
    north -> south ah spi 88471 seq 15 nextheader 4 icv "884700018847000288470003" vlan 510 pcp 6 mpls 24051 exp 6 bos 1 mplsttl 63 ttl 63 payload "MPLS_PE_AUTH_VRF_SYNC" wait 5ms
    north <- south ah spi 88472 seq 15 nextheader 4 icv "000388470002884700018847" vlan 510 pcp 6 mpls 24052 exp 6 bos 1 mplsttl 63 ttl 63 payload "MPLS_PE_AUTH_VRF_ACK"
}

// Run ah_mpls_vlan_pe_flow(pe_north_ah, pe_south_ah) to generate the capture.
compile {
    ah_mpls_vlan_pe_flow(pe_north_ah, pe_south_ah)
}
