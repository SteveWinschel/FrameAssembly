// Multi-hop IPv4 AH transit simulation showing TTL decrements across
// intermediate hops.
// This capture sets DSCP 16, TTL 62/63/64 and carries SPI 71000.
// Wireshark: ah

host ah_origin_host { ip 10.5.1.10 }

host ah_dest_gateway { ip 10.5.99.10 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow ah_ttl_observation(orig, dest) {
    orig -> dest ah spi 71000 seq 1 ttl 64 dscp 16
    orig -> dest ah spi 71000 seq 2 ttl 63 dscp 16
    orig -> dest ah spi 71000 seq 3 ttl 62 dscp 16
}

// Run ah_ttl_observation(ah_origin_host, ah_dest_gateway) to generate the
// capture.
compile {
    ah_ttl_observation(ah_origin_host, ah_dest_gateway)
}
