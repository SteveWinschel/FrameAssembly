// RFC 4302 IPsec AH graceful Security Association rekeying transitioning from
// old SPI to new SPI.
// This capture sets DSCP 34, carries SPI 30010/30020/30021, and uses
// post-packet wait gaps (5ms) between frames.
// Wireshark: ah

host fin_gw_alpha {
    ip 10.88.1.1
    mac 00:1b:63:88:01:01
}

host fin_gw_omega {
    ip 10.88.1.2
    mac 00:1b:63:88:01:02
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow ah_rekey_rollover_flow(alpha, omega) {
    alpha -> omega ah spi 30010 seq 9999 nextheader 6 icv "111122223333444455556666" dscp 34 payload "LAST_PKT_OLD_SA_30010" wait 5ms
    alpha -> omega ah spi 30020 seq 1 nextheader 6 icv "777788889999aaaabbbbcccc" dscp 34 payload "FIRST_PKT_NEW_SA_30020" wait 5ms
    alpha <- omega ah spi 30021 seq 1 nextheader 6 icv "ccccbbbbaaaa999988887777" dscp 34 payload "ACK_NEW_SA_30021_ACTIVE"
}

// Run ah_rekey_rollover_flow(fin_gw_alpha, fin_gw_omega) to generate the
// capture.
compile {
    ah_rekey_rollover_flow(fin_gw_alpha, fin_gw_omega)
}
