// IPsec AH authentication session advancing sequence numbers between hosts.
// This capture carries SPI 12000.
// Wireshark: ah

host ah_client { ip 10.0.5.10 }

host ah_server { ip 10.0.5.20 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow ah_session_flow(c, s) {
    c -> s ah spi 12000 seq 1
    c <- s ah spi 12000 seq 1
    c -> s ah spi 12000 seq 2
}

// Run ah_session_flow(ah_client, ah_server) to generate the capture.
compile {
    ah_session_flow(ah_client, ah_server)
}
