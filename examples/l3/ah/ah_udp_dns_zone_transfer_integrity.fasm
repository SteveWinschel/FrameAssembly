// PROMPT: RFC 4302 IPsec AH transport mode authenticating UDP (Next Header 17) authoritative DNS metadata.
// TOKENS: host, ip, mac, flow, pri, ah, spi, seq, nextheader, icv, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define primary authoritative DNS server with IPsec AH policy.
host dns_primary_ah {
    ip 192.0.2.53
    mac 00:16:3e:53:00:01
}

// INSTRUCTION: Define secondary authoritative DNS mirror server.
host dns_secondary_ah {
    ip 198.51.100.53
    mac 00:16:3e:53:00:02
}

// INSTRUCTION: Define AH transport flow with Next Header 17 (UDP) and explicit ICV authentication digest.
flow ah_udp_dns_notify(pri, sec) {
    pri -> sec ah spi 53001 seq 12 nextheader 17 icv "53535353aaaaaaaabbbbbbbb" dscp 26 ttl 64 payload "DNS_SOA_SERIAL_2026102501" wait 4ms
    pri <- sec ah spi 53002 seq 12 nextheader 17 icv "bbbbbbbbaaaaaaaa53535353" dscp 26 ttl 64 payload "DNS_NOTIFY_ACK_OK"
}

// INSTRUCTION: Compile the AH-protected UDP DNS notification flow.
compile {
    ah_udp_dns_notify(dns_primary_ah, dns_secondary_ah)
}
