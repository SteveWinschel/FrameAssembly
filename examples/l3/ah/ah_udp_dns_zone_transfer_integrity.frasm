// RFC 4302 IPsec AH transport mode authenticating UDP (Next Header 17)
// authoritative DNS metadata.
// This capture sets DSCP 26, TTL 64, carries SPI 53001/53002, and uses
// post-packet wait gaps (4ms) between frames.
// Wireshark: ah

host dns_primary_ah {
    ip 192.0.2.53
    mac 00:16:3e:53:00:01
}

host dns_secondary_ah {
    ip 198.51.100.53
    mac 00:16:3e:53:00:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ah_udp_dns_notify(pri, sec) {
    pri -> sec ah spi 53001 seq 12 nextheader 17 icv "53535353aaaaaaaabbbbbbbb" dscp 26 ttl 64 payload "DNS_SOA_SERIAL_2026102501" wait 4ms
    pri <- sec ah spi 53002 seq 12 nextheader 17 icv "bbbbbbbbaaaaaaaa53535353" dscp 26 ttl 64 payload "DNS_NOTIFY_ACK_OK"
}

// Run ah_udp_dns_notify(dns_primary_ah, dns_secondary_ah) to generate the
// capture.
compile {
    ah_udp_dns_notify(dns_primary_ah, dns_secondary_ah)
}
