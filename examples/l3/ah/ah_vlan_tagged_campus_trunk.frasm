// IEEE 802.1Q VLAN-tagged IPsec AH authentication frames traversing a campus
// trunk.
// This capture wraps frames in 802.1Q VLAN 120 and carries SPI 77001/77002.
// Wireshark: ah && vlan.id == 120

host dist_sw_alpha { ip 10.88.12.1 mac 00:22:33:44:55:01 }

host dist_sw_beta { ip 10.88.12.2 mac 00:22:33:44:55:02 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ah_vlan_trunk_flow(a, b) {
    a -> b ah spi 77001 seq 1 vlan 120 pcp 6 dei 0
    a <- b ah spi 77002 seq 1 vlan 120 pcp 6 dei 0
}

// Run ah_vlan_trunk_flow(dist_sw_alpha, dist_sw_beta) to generate the
// capture.
compile {
    ah_vlan_trunk_flow(dist_sw_alpha, dist_sw_beta)
}
