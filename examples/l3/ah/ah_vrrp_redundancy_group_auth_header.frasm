// RFC 4302 IPsec AH protecting VRRP (Next Header 112) master election
// advertisements against spoofing.
// This capture sets DSCP 48, TTL 255, carries SPI 11200, executes 3 cycles in
// compile, and uses post-packet wait gaps (100ms) between frames.
// Wireshark: ah

host vrrp_ah_master {
    ip 10.112.0.2
    mac 00:00:5e:00:01:0a
}

host vrrp_ah_mcast {
    ip 224.0.0.18
    mac 01:00:5e:00:00:12
}

// Packet sequence (1 frame); wait pauses after a packet before the next.
flow ah_vrrp_heartbeat_flow(master, mcast) {
    master -> mcast ah spi 11200 seq 1 nextheader 112 icv "707070701122334455667788" dscp 48 ttl 255 payload "VRRP_VRID10_PRIO200_AUTH" wait 100ms
}

// Emit 3 sequential cycles of ah_vrrp_heartbeat_flow.
compile {
    ah_vrrp_heartbeat_flow(vrrp_ah_master, vrrp_ah_mcast) // cycle 1
    ah_vrrp_heartbeat_flow(vrrp_ah_master, vrrp_ah_mcast) // cycle 2
    ah_vrrp_heartbeat_flow(vrrp_ah_master, vrrp_ah_mcast) // cycle 3
}
