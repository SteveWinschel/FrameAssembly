// BFD session graceful administrative shutdown signaling State 0 (AdminDown)
// and Diag 7.
// This capture carries BFD state 0/1/3, diag 0/3 and uses post-packet wait
// gaps (25ms, 10ms) between frames.
// Wireshark: bfd

host core_maint_rtr { ip 172.18.10.1 }

host core_peer_rtr { ip 172.18.10.2 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow bfd_admin_shutdown(maint, peer) {
    maint -> peer bfd state 3 diag 0 mydisc 4010 yourdisc 4020 mult 3 wait 25ms
    maint -> peer bfd state 0 diag 7 mydisc 4010 yourdisc 4020 mult 3 wait 10ms
    maint <- peer bfd state 1 diag 3 mydisc 4020 yourdisc 4010 mult 3
}

// Run bfd_admin_shutdown(core_maint_rtr, core_peer_rtr) to generate the
// capture.
compile {
    bfd_admin_shutdown(core_maint_rtr, core_peer_rtr)
}
