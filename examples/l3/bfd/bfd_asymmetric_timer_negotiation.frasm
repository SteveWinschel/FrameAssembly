// BFD asymmetric timer negotiation between fast hardware router and slower
// software peer.
// This capture carries BFD state 3.
// Wireshark: bfd

host hw_asic_rtr { ip 10.77.0.1 }

host sw_vrouter { ip 10.77.0.2 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow bfd_asymmetric_timers(hw, sw) {
    hw -> sw bfd state 3 mydisc 6001 yourdisc 6002 mintx 3300 minrx 3300 mult 3
    hw <- sw bfd state 3 mydisc 6002 yourdisc 6001 mintx 250000 minrx 250000 mult 5
    hw -> sw bfd state 3 mydisc 6001 yourdisc 6002 mintx 250000 minrx 3300 mult 3
}

// Run bfd_asymmetric_timers(hw_asic_rtr, sw_vrouter) to generate the capture.
compile {
    bfd_asymmetric_timers(hw_asic_rtr, sw_vrouter)
}
