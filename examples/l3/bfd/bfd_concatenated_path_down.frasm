// BFD session reporting Diag 6 (Concatenated Path Down) and Diag 5 (Path
// Down).
// This capture carries BFD state 1/3, diag 5/6.
// Wireshark: bfd

host pw_gateway_a { ip 10.155.12.1 }

host pw_gateway_b { ip 10.155.12.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow bfd_concat_path_fault(a, b) {
    a -> b bfd state 3 diag 6 mydisc 77100 yourdisc 77200 mintx 100000 minrx 100000 mult 4 payload "PW_AC_FAULT"
    a <- b bfd state 1 diag 5 mydisc 77200 yourdisc 77100 mintx 1000000 minrx 1000000 mult 4
}

// Run bfd_concat_path_fault(pw_gateway_a, pw_gateway_b) to generate the
// capture.
compile {
    bfd_concat_path_fault(pw_gateway_a, pw_gateway_b)
}
