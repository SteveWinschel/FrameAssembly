// Minimal BFD (RFC 5880 / RFC 5881) control packet sent over UDP port 3784
// using built-in defaults (State 3 Up, Diag 0, My Discriminator 1, multiplier
// 3). Useful as a quick baseline to check UDP 3784 firewall rules and BFD
// dissectors.
// Wireshark: bfd

host endpoint_a {
    ip 10.37.84.1
    mac 02:00:37:84:00:01
}

host endpoint_b {
    ip 10.37.84.2
    mac 02:00:37:84:00:02
}

// Transmit one default BFD control frame directly inside compile.
compile {
    endpoint_a -> endpoint_b bfd
}
