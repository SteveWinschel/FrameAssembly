// BFD Control packet asserting NeighborDown diagnostic and Down state code.
// This capture carries BFD state 1, diag 3.
// Wireshark: bfd

host local_bfd_peer { ip 192.168.10.1 }

host remote_bfd_peer { ip 192.168.10.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow bfd_down_flow(local, remote) {
    local -> remote bfd state 1 diag 3 mydisc 1050 yourdisc 2050
}

// Run bfd_down_flow(local_bfd_peer, remote_bfd_peer) to generate the capture.
compile {
    bfd_down_flow(local_bfd_peer, remote_bfd_peer)
}
