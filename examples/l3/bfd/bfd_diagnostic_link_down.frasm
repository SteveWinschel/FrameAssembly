// PROMPT: BFD Control packet asserting NeighborDown diagnostic and Down state code.
// TOKENS: host, ip, flow, bfd, state, diag, mydisc, yourdisc, compile

// INSTRUCTION: Define local router reporting peer failure.
host local_bfd_peer { ip 192.168.10.1 }

// INSTRUCTION: Define remote peer endpoint.
host remote_bfd_peer { ip 192.168.10.2 }

// INSTRUCTION: Define BFD diagnostic flow transitioning to State 1 (Down) with diagnostic code 3.
flow bfd_down_flow(local, remote) {
    local -> remote bfd state 1 diag 3 mydisc 1050 yourdisc 2050
}

// INSTRUCTION: Compile block executing BFD link down notification.
compile {
    bfd_down_flow(local_bfd_peer, remote_bfd_peer)
}
