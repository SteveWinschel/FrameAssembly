// RFC 8971 / RFC 5883 multihop BFD monitoring underlay reachability between
// EVPN VXLAN VTEP loopbacks.
// This capture sets DSCP 48, TTL 62, carries BFD state 3, diag 0, destination
// port 4784, and uses post-packet wait gaps (50ms) between frames.
// Wireshark: bfd && udp.port == 4784

host vtep_leaf1_lo {
    ip 10.255.0.11
    mac 00:1c:73:aa:00:0b
}

host vtep_leaf2_lo {
    ip 10.255.0.22
    mac 00:1c:73:aa:00:16
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bfd_vtep_underlay_check(vtep1, vtep2) {
    vtep1 -> vtep2 bfd state 3 diag 0 mydisc 89711 yourdisc 89712 mintx 50000 minrx 50000 mult 3 srcport 50100 dstport 4784 dscp 48 ttl 62 wait 50ms
    vtep1 <- vtep2 bfd state 3 diag 0 mydisc 89712 yourdisc 89711 mintx 50000 minrx 50000 mult 3 srcport 50101 dstport 4784 dscp 48 ttl 62
}

// Run bfd_vtep_underlay_check(vtep_leaf1_lo, vtep_leaf2_lo) to generate the
// capture.
compile {
    bfd_vtep_underlay_check(vtep_leaf1_lo, vtep_leaf2_lo)
}
