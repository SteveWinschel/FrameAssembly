// PROMPT: BFD session signaling Diag 4 (Forwarding Plane Reset) during linecard reload.
// TOKENS: host, ip, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, compile

// INSTRUCTION: Define modular chassis router undergoing linecard reset.
host chassis_rtr_1 { ip 172.16.200.1 }

// INSTRUCTION: Define peer router detecting forwarding plane reset diagnostic.
host chassis_rtr_2 { ip 172.16.200.2 }

// INSTRUCTION: Define BFD transition to Down (1) with Diag 4 (Forwarding Plane Reset).
flow bfd_fp_reset_flow(r1, r2) {
    r1 -> r2 bfd state 1 diag 4 mydisc 15001 yourdisc 15002 mintx 1000000 minrx 1000000 mult 3
    r1 <- r2 bfd state 2 diag 3 mydisc 15002 yourdisc 15001 mintx 100000 minrx 100000 mult 3
    r1 -> r2 bfd state 3 diag 0 mydisc 15001 yourdisc 15002 mintx 100000 minrx 100000 mult 3
}

// INSTRUCTION: Compile the BFD forwarding plane reset recovery flow.
compile {
    bfd_fp_reset_flow(chassis_rtr_1, chassis_rtr_2)
}
