// PROMPT: BFD session recovering from AdminDown (STATE 0, DIAG 7) through Down (STATE 1) and Init (STATE 2) back to Up (STATE 3).
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define core router completing control-plane ISSU upgrade and re-enabling BFD.
host issu_upgraded_rtr {
    ip 10.99.37.1
    mac 00:22:55:99:37:01
}

// INSTRUCTION: Define peer core router re-establishing BFD three-way handshake after AdminDown.
host issu_neighbor_rtr {
    ip 10.99.37.2
    mac 00:22:55:99:37:02
}

// INSTRUCTION: Define complete BFD recovery from STATE 0 (AdminDown) -> STATE 1 -> STATE 2 -> STATE 3 (Up).
flow bfd_admin_up_recovery_flow(r1, r2) {
    r1 -> r2 bfd state 0 diag 7 mydisc 9901 yourdisc 9902 mintx 1000000 minrx 1000000 mult 3 dscp 48 ttl 255 wait 20ms
    r1 -> r2 bfd state 1 diag 0 mydisc 9901 yourdisc 0 mintx 50000 minrx 50000 mult 3 dscp 48 ttl 255 wait 10ms
    r1 <- r2 bfd state 2 diag 0 mydisc 9902 yourdisc 9901 mintx 50000 minrx 50000 mult 3 dscp 48 ttl 255 wait 10ms
    r1 -> r2 bfd state 3 diag 0 mydisc 9901 yourdisc 9902 mintx 50000 minrx 50000 mult 3 dscp 48 ttl 255 wait 10ms
    r1 <- r2 bfd state 3 diag 0 mydisc 9902 yourdisc 9901 mintx 50000 minrx 50000 mult 3 dscp 48 ttl 255
}

// INSTRUCTION: Compile the BFD AdminDown-to-Up recovery state machine flow.
compile {
    bfd_admin_up_recovery_flow(issu_upgraded_rtr, issu_neighbor_rtr)
}
