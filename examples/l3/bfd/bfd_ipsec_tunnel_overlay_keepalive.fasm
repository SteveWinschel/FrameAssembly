// PROMPT: BFD control packets running across a decrypted VTI tunnel interface with DF bit and custom MTU probing.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, ipid, df, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define Virtual Tunnel Interface (VTI) endpoint A running BFD over IPsec.
host vti_bfd_peer_a {
    ip 169.254.100.1
    mac 00:50:56:a9:fe:01
}

// INSTRUCTION: Define Virtual Tunnel Interface (VTI) endpoint B validating overlay path health.
host vti_bfd_peer_b {
    ip 169.254.100.2
    mac 00:50:56:a9:fe:02
}

// INSTRUCTION: Define BFD overlay session with DF bit and explicit IPID values.
flow bfd_vti_overlay_flow(a, b) {
    a -> b bfd state 3 diag 0 mydisc 10001 yourdisc 10002 mintx 100000 minrx 100000 mult 3 ipid 3701 df dscp 48 ttl 255 wait 25ms
    a <- b bfd state 3 diag 0 mydisc 10002 yourdisc 10001 mintx 100000 minrx 100000 mult 3 ipid 3702 df dscp 48 ttl 255
}

// INSTRUCTION: Compile the VTI overlay BFD liveness verification flow.
compile {
    bfd_vti_overlay_flow(vti_bfd_peer_a, vti_bfd_peer_b)
}
