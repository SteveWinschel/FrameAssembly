// BFD control packets running across a decrypted VTI tunnel interface with DF
// bit and custom MTU probing.
// This capture sets DSCP 48, TTL 255, DF bit set, carries BFD state 3, diag
// 0, and uses post-packet wait gaps (25ms) between frames.
// Wireshark: bfd

host vti_bfd_peer_a {
    ip 169.254.100.1
    mac 00:50:56:a9:fe:01
}

host vti_bfd_peer_b {
    ip 169.254.100.2
    mac 00:50:56:a9:fe:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bfd_vti_overlay_flow(a, b) {
    a -> b bfd state 3 diag 0 mydisc 10001 yourdisc 10002 mintx 100000 minrx 100000 mult 3 ipid 3701 df dscp 48 ttl 255 wait 25ms
    a <- b bfd state 3 diag 0 mydisc 10002 yourdisc 10001 mintx 100000 minrx 100000 mult 3 ipid 3702 df dscp 48 ttl 255
}

// Run bfd_vti_overlay_flow(vti_bfd_peer_a, vti_bfd_peer_b) to generate the
// capture.
compile {
    bfd_vti_overlay_flow(vti_bfd_peer_a, vti_bfd_peer_b)
}
