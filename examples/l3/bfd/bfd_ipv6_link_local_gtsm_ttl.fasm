// PROMPT: Single-hop IPv6 link-local BFD session enforcing RFC 5082 GTSM Hop Limit 255.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, ttl, dscp, flowlabel, compile

// INSTRUCTION: Define IPv6 link-local neighbor A.
host ll_bfd_peer_a { ip fe80::10:1 mac 52:54:00:bf:d0:01 }

// INSTRUCTION: Define IPv6 link-local neighbor B.
host ll_bfd_peer_b { ip fe80::10:2 mac 52:54:00:bf:d0:02 }

// INSTRUCTION: Define IPv6 link-local BFD exchange with Hop Limit 255 and DSCP 48.
flow bfd_ipv6_link_local(a, b) {
    a -> b bfd state 3 diag 0 mydisc 33001 yourdisc 33002 mintx 50000 minrx 50000 mult 3 ttl 255 dscp 48 flowlabel 99001
    a <- b bfd state 3 diag 0 mydisc 33002 yourdisc 33001 mintx 50000 minrx 50000 mult 3 ttl 255 dscp 48 flowlabel 99002
}

// INSTRUCTION: Compile the IPv6 link-local GTSM BFD flow.
compile {
    bfd_ipv6_link_local(ll_bfd_peer_a, ll_bfd_peer_b)
}
