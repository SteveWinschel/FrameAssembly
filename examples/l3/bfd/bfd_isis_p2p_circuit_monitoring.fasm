// PROMPT: RFC 5882 BFD session protecting an IS-IS Level-2 point-to-point metro fiber circuit at 3.3ms intervals.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, srcport, dstport, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define IS-IS Level-2 core node West with hardware BFD offload.
host isis_l2_west {
    ip 10.49.0.1
    mac 00:26:55:49:00:01
}

// INSTRUCTION: Define IS-IS Level-2 core node East with 3300us BFD timers.
host isis_l2_east {
    ip 10.49.0.2
    mac 00:26:55:49:00:02
}

// INSTRUCTION: Define ultra-fast 3.3ms (3300us) BFD control exchange with Multiplier 3 (10ms detection).
flow bfd_isis_p2p_flow(west, east) {
    west -> east bfd state 3 diag 0 mydisc 49001 yourdisc 49002 mintx 3300 minrx 3300 mult 3 srcport 49300 dstport 3784 dscp 48 ttl 255 wait 3ms
    west <- east bfd state 3 diag 0 mydisc 49002 yourdisc 49001 mintx 3300 minrx 3300 mult 3 srcport 49301 dstport 3784 dscp 48 ttl 255 wait 3ms
    west -> east bfd state 3 diag 0 mydisc 49001 yourdisc 49002 mintx 3300 minrx 3300 mult 3 srcport 49300 dstport 3784 dscp 48 ttl 255
}

// INSTRUCTION: Compile the IS-IS point-to-point ultra-fast BFD monitoring flow.
compile {
    bfd_isis_p2p_flow(isis_l2_west, isis_l2_east)
}
