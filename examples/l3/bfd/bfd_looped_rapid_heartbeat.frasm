// PROMPT: Rapid BFD sub-second keepalive burst executed in a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, bfd, state, mydisc, yourdisc, mintx, minrx, mult, wait, ms, compile

// INSTRUCTION: Define fabric spine switch 1.
host fabric_spine_1 { ip 10.240.1.1 }

// INSTRUCTION: Define fabric tor switch 1.
host fabric_tor_1 { ip 10.240.1.2 }

// INSTRUCTION: Define bidirectional 10ms BFD keepalive exchange.
flow bfd_rapid_poll(spine, tor) {
    spine -> tor bfd state 3 mydisc 4401 yourdisc 4402 mintx 10000 minrx 10000 mult 3 wait 10ms
    spine <- tor bfd state 3 mydisc 4402 yourdisc 4401 mintx 10000 minrx 10000 mult 3 wait 10ms
}

// INSTRUCTION: Compile 5 consecutive iterations of the rapid BFD heartbeat.
compile {
    bfd_rapid_poll(fabric_spine_1, fabric_tor_1) // cycle 1
    bfd_rapid_poll(fabric_spine_1, fabric_tor_1) // cycle 2
    bfd_rapid_poll(fabric_spine_1, fabric_tor_1) // cycle 3
    bfd_rapid_poll(fabric_spine_1, fabric_tor_1) // cycle 4
    bfd_rapid_poll(fabric_spine_1, fabric_tor_1) // cycle 5
}
