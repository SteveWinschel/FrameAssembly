// PROMPT: RFC 7130 micro-BFD session running per Link Aggregation Group (LAG) member link to verify individual port forwarding.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, srcport, dstport, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define LAG member link 1 on switch A with dedicated source MAC.
host lag_member1_sw_a {
    ip 10.71.30.1
    mac 00:1c:73:71:30:01
}

// INSTRUCTION: Define LAG member link 1 on switch B with dedicated peer MAC.
host lag_member1_sw_b {
    ip 10.71.30.2
    mac 00:1c:73:71:30:02
}

// INSTRUCTION: Define RFC 7130 micro-BFD control exchange at 10ms TX/RX intervals with TTL 255.
flow micro_bfd_lag_member(sw_a, sw_b) {
    sw_a -> sw_b bfd state 3 diag 0 mydisc 71301 yourdisc 71302 mintx 10000 minrx 10000 mult 3 srcport 49152 dstport 3784 dscp 48 ttl 255 wait 10ms
    sw_a <- sw_b bfd state 3 diag 0 mydisc 71302 yourdisc 71301 mintx 10000 minrx 10000 mult 3 srcport 49153 dstport 3784 dscp 48 ttl 255
}

// INSTRUCTION: Compile the RFC 7130 micro-BFD LAG member verification flow.
compile {
    micro_bfd_lag_member(lag_member1_sw_a, lag_member1_sw_b)
}
