// PROMPT: RFC 7761 / RFC 5880 BFD session between PIM-SM Designated Router candidates enabling sub-second DR election.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, vlan, pcp, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define active PIM Designated Router monitoring standby DR via BFD.
host pim_active_dr {
    ip 10.103.50.1
    mac 00:1b:54:67:50:01
}

// INSTRUCTION: Define standby PIM router ready to preempt upon BFD session Down.
host pim_standby_dr {
    ip 10.103.50.2
    mac 00:1b:54:67:50:02
}

// INSTRUCTION: Define BFD 25ms control exchange on VLAN 50 multicast access subnet.
flow bfd_pim_dr_liveness(active, standby) {
    active -> standby bfd state 3 diag 0 mydisc 50101 yourdisc 50102 mintx 25000 minrx 25000 mult 3 vlan 50 pcp 6 dscp 48 ttl 255 wait 25ms
    active <- standby bfd state 3 diag 0 mydisc 50102 yourdisc 50101 mintx 25000 minrx 25000 mult 3 vlan 50 pcp 6 dscp 48 ttl 255
}

// INSTRUCTION: Compile the BFD-assisted PIM Designated Router failover monitoring flow.
compile {
    bfd_pim_dr_liveness(pim_active_dr, pim_standby_dr)
}
