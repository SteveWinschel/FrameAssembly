// RFC 7761 / RFC 5880 BFD session between PIM-SM Designated Router candidates
// enabling sub-second DR election.
// This capture wraps frames in 802.1Q VLAN 50, sets DSCP 48, TTL 255, carries
// BFD state 3, diag 0, and uses post-packet wait gaps (25ms) between frames.
// Wireshark: bfd && vlan.id == 50

host pim_active_dr {
    ip 10.103.50.1
    mac 00:1b:54:67:50:01
}

host pim_standby_dr {
    ip 10.103.50.2
    mac 00:1b:54:67:50:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bfd_pim_dr_liveness(active, standby) {
    active -> standby bfd state 3 diag 0 mydisc 50101 yourdisc 50102 mintx 25000 minrx 25000 mult 3 vlan 50 pcp 6 dscp 48 ttl 255 wait 25ms
    active <- standby bfd state 3 diag 0 mydisc 50102 yourdisc 50101 mintx 25000 minrx 25000 mult 3 vlan 50 pcp 6 dscp 48 ttl 255
}

// Run bfd_pim_dr_liveness(pim_active_dr, pim_standby_dr) to generate the
// capture.
compile {
    bfd_pim_dr_liveness(pim_active_dr, pim_standby_dr)
}
