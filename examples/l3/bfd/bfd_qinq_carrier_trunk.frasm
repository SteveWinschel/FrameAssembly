// BFD fault detection over an 802.1ad QinQ service provider circuit.
// This capture wraps frames in QinQ S-VLAN 1500 / C-VLAN 50 and carries BFD
// state 3.
// Wireshark: bfd

host metro_bfd_n1 { ip 172.25.100.1 }

host metro_bfd_n2 { ip 172.25.100.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow bfd_qinq_circuit_flow(n1, n2) {
    n1 -> n2 bfd state 3 mydisc 3100 yourdisc 3200 mintx 25000 minrx 25000 mult 3 qinq 1500 innervlan 50
    n1 <- n2 bfd state 3 mydisc 3200 yourdisc 3100 mintx 25000 minrx 25000 mult 3 qinq 1500 innervlan 50
}

// Run bfd_qinq_circuit_flow(metro_bfd_n1, metro_bfd_n2) to generate the
// capture.
compile {
    bfd_qinq_circuit_flow(metro_bfd_n1, metro_bfd_n2)
}
