// PROMPT: RFC 5880 BFD signaling Diagnostic Code 8 (Reverse Concatenated Path Down) on a bidirectional transport LSP.
// TOKENS: host, ip, mac, flow, bfd, state, diag, mydisc, yourdisc, mintx, minrx, mult, mpls, exp, bos, mplsttl, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define MPLS-TP egress LSR detecting reverse path defect.
host mpls_tp_egress {
    ip 10.58.80.10
    mac 00:19:aa:58:80:0a
}

// INSTRUCTION: Define MPLS-TP ingress LSR receiving DIAG 8 reverse path alarm.
host mpls_tp_ingress {
    ip 10.58.80.20
    mac 00:19:aa:58:80:14
}

// INSTRUCTION: Define BFD transition to DIAG 8 (Reverse Concatenated Path Down) over MPLS label 18080.
flow bfd_reverse_concat_diag8(egr, ing) {
    egr -> ing bfd state 3 diag 8 mydisc 58801 yourdisc 58802 mintx 10000 minrx 10000 mult 3 mpls 18080 exp 6 bos 1 mplsttl 255 dscp 48 ttl 255 wait 10ms
    egr <- ing bfd state 3 diag 0 mydisc 58802 yourdisc 58801 mintx 10000 minrx 10000 mult 3 mpls 18081 exp 6 bos 1 mplsttl 255 dscp 48 ttl 255
}

// INSTRUCTION: Compile the BFD Reverse Concatenated Path Down (DIAG 8) flow.
compile {
    bfd_reverse_concat_diag8(mpls_tp_egress, mpls_tp_ingress)
}
