// RFC 5880 BFD signaling Diagnostic Code 8 (Reverse Concatenated Path Down)
// on a bidirectional transport LSP.
// This capture wraps frames in MPLS label 18080/18081, sets DSCP 48, TTL 255,
// carries BFD state 3, diag 0/8, and uses post-packet wait gaps (10ms)
// between frames.
// Wireshark: bfd && mpls

host mpls_tp_egress {
    ip 10.58.80.10
    mac 00:19:aa:58:80:0a
}

host mpls_tp_ingress {
    ip 10.58.80.20
    mac 00:19:aa:58:80:14
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bfd_reverse_concat_diag8(egr, ing) {
    egr -> ing bfd state 3 diag 8 mydisc 58801 yourdisc 58802 mintx 10000 minrx 10000 mult 3 mpls 18080 exp 6 bos 1 mplsttl 255 dscp 48 ttl 255 wait 10ms
    egr <- ing bfd state 3 diag 0 mydisc 58802 yourdisc 58801 mintx 10000 minrx 10000 mult 3 mpls 18081 exp 6 bos 1 mplsttl 255 dscp 48 ttl 255
}

// Run bfd_reverse_concat_diag8(mpls_tp_egress, mpls_tp_ingress) to generate
// the capture.
compile {
    bfd_reverse_concat_diag8(mpls_tp_egress, mpls_tp_ingress)
}
