// Bidirectional Forwarding Detection session monitoring in Up state with
// discriminators.
// This capture carries BFD state 3.
// Wireshark: bfd

host bfd_node_a { ip 10.200.1.1 }

host bfd_node_b { ip 10.200.1.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow bfd_session_flow(a, b) {
    a -> b bfd state 3 mydisc 100 yourdisc 200
}

// Run bfd_session_flow(bfd_node_a, bfd_node_b) to generate the capture.
compile {
    bfd_session_flow(bfd_node_a, bfd_node_b)
}
