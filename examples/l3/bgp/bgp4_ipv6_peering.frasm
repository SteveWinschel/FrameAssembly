// Border Gateway Protocol 4+ peering over IPv6 using TCP 179 with OPEN and
// KEEPALIVE messages.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs and
// carries ASN 65001/65002.
// Wireshark: bgp

host bgp_peer_a { ip 2001:db8:ffff::1 }

host bgp_peer_b { ip 2001:db8:ffff::2 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow bgp_peer_flow(a, b) {
    a -> b bgp open asn 65001 holdtime 180 bgpid 10.0.0.1
    a <- b bgp open asn 65002 holdtime 180 bgpid 10.0.0.2
    a -> b bgp keepalive
    a <- b bgp keepalive
}

// Run bgp_peer_flow(bgp_peer_a, bgp_peer_b) to generate the capture.
compile {
    bgp_peer_flow(bgp_peer_a, bgp_peer_b)
}
