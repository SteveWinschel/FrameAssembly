// RFC 7999 Remotely Triggered Black Hole (RTBH) BGP UPDATE tagging an
// attacked /32 host with BLACKHOLE community 65535:666.
// This capture sets DSCP 48, TTL 1, carries ASN 65300, and uses post-packet
// wait gaps (5ms) between frames.
// Wireshark: bgp

host soc_rtbh_trigger {
    ip 203.0.113.50
    mac 00:1b:63:79:99:32
}

host isp_rtbh_upstream {
    ip 203.0.113.49
    mac 00:1b:63:79:99:31
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bgp_rtbh_blackhole_flow(soc, isp) {
    soc -> isp bgp update asn 65300 prefix "203.0.113.200/32" nexthop 192.0.2.1 dscp 48 ttl 1 payload "COMMUNITY_65535_666_BLACKHOLE" wait 5ms
    soc <- isp bgp keepalive dscp 48 ttl 1
}

// Run bgp_rtbh_blackhole_flow(soc_rtbh_trigger, isp_rtbh_upstream) to
// generate the capture.
compile {
    bgp_rtbh_blackhole_flow(soc_rtbh_trigger, isp_rtbh_upstream)
}
