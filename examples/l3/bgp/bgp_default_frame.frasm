// Minimal BGP-4 (RFC 4271) starter packet sent over TCP port 179 with PSH+ACK
// and automatic sequence numbers, emitting a 19-byte KEEPALIVE header by
// default. Helpful for verifying TCP 179 ACLs and BGP parser baselines
// without a router daemon.
// Wireshark: bgp

host endpoint_a {
    ip 198.51.100.1
    mac 02:00:17:90:00:01
}

host endpoint_b {
    ip 198.51.100.2
    mac 02:00:17:90:00:02
}

// Transmit one default BGP packet directly inside compile.
compile {
    endpoint_a -> endpoint_b bgp
}
