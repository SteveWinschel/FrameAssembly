// PROMPT: eBGP peering establishment using 4-byte Autonomous System Numbers and BGP Identifiers.
// TOKENS: host, ip, mac, flow, bgp, open, asn, holdtime, bgpid, keepalive, compile

// INSTRUCTION: Define autonomous system 4200000001 border router.
host as4200000001_edge { ip 198.51.100.101 mac 00:1b:21:aa:bb:01 }

// INSTRUCTION: Define autonomous system 4200000002 border router.
host as4200000002_edge { ip 198.51.100.102 mac 00:1b:21:aa:bb:02 }

// INSTRUCTION: Define eBGP OPEN and KEEPALIVE exchange with 4-byte ASNs.
flow ebgp_4byte_asn_open(p1, p2) {
    p1 -> p2 bgp open asn 4200000001 holdtime 90 bgpid 10.255.0.1
    p1 <- p2 bgp open asn 4200000002 holdtime 90 bgpid 10.255.0.2
    p1 -> p2 bgp keepalive
    p1 <- p2 bgp keepalive
}

// INSTRUCTION: Compile the 4-byte ASN eBGP peering handshake.
compile {
    ebgp_4byte_asn_open(as4200000001_edge, as4200000002_edge)
}
