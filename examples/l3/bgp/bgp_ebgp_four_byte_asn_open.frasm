// eBGP peering establishment using 4-byte Autonomous System Numbers and BGP
// Identifiers.
// This capture carries ASN 4200000001/4200000002.
// Wireshark: bgp

host as4200000001_edge { ip 198.51.100.101 mac 00:1b:21:aa:bb:01 }

host as4200000002_edge { ip 198.51.100.102 mac 00:1b:21:aa:bb:02 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow ebgp_4byte_asn_open(p1, p2) {
    p1 -> p2 bgp open asn 4200000001 holdtime 90 bgpid 10.255.0.1
    p1 <- p2 bgp open asn 4200000002 holdtime 90 bgpid 10.255.0.2
    p1 -> p2 bgp keepalive
    p1 <- p2 bgp keepalive
}

// Run ebgp_4byte_asn_open(as4200000001_edge, as4200000002_edge) to generate
// the capture.
compile {
    ebgp_4byte_asn_open(as4200000001_edge, as4200000002_edge)
}
