// PROMPT: RFC 8955 BGP FlowSpec UPDATE distributing automated DDoS traffic filtering rules to edge scrubbers.
// TOKENS: host, ip, mac, flow, bgp, update, asn, prefix, nexthop, dscp, ttl, payload, wait, ms, keepalive, compile

// INSTRUCTION: Define DDoS Controller BGP speaker originating FlowSpec SAFI 133 rules.
host flowspec_controller {
    ip 10.89.55.1
    mac 00:25:b5:89:55:01
}

// INSTRUCTION: Define Provider Edge router applying FlowSpec rate-limit and discard actions.
host flowspec_pe_scrubber {
    ip 10.89.55.20
    mac 00:25:b5:89:55:14
}

// INSTRUCTION: Define BGP FlowSpec UPDATE carrying drop filter for victim prefix 198.51.100.88/32.
flow bgp_flowspec_mitigation(ctrl, pe) {
    ctrl -> pe bgp update asn 65089 prefix "198.51.100.88/32" nexthop 10.89.55.1 dscp 48 ttl 64 payload "FLOWSPEC_SAFI133_PROTO17_PORT53_ACTION_DROP" wait 4ms
    ctrl <- pe bgp keepalive dscp 48 ttl 64
}

// INSTRUCTION: Compile the RFC 8955 BGP FlowSpec DDoS mitigation distribution flow.
compile {
    bgp_flowspec_mitigation(flowspec_controller, flowspec_pe_scrubber)
}
