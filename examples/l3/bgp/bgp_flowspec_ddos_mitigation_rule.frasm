// RFC 8955 BGP FlowSpec UPDATE distributing automated DDoS traffic filtering
// rules to edge scrubbers.
// This capture sets DSCP 48, TTL 64, carries ASN 65089, and uses post-packet
// wait gaps (4ms) between frames.
// Wireshark: bgp

host flowspec_controller {
    ip 10.89.55.1
    mac 00:25:b5:89:55:01
}

host flowspec_pe_scrubber {
    ip 10.89.55.20
    mac 00:25:b5:89:55:14
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bgp_flowspec_mitigation(ctrl, pe) {
    ctrl -> pe bgp update asn 65089 prefix "198.51.100.88/32" nexthop 10.89.55.1 dscp 48 ttl 64 payload "FLOWSPEC_SAFI133_PROTO17_PORT53_ACTION_DROP" wait 4ms
    ctrl <- pe bgp keepalive dscp 48 ttl 64
}

// Run bgp_flowspec_mitigation(flowspec_controller, flowspec_pe_scrubber) to
// generate the capture.
compile {
    bgp_flowspec_mitigation(flowspec_controller, flowspec_pe_scrubber)
}
