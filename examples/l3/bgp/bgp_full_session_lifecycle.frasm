// PROMPT: Complete BGP session lifecycle from OPEN to UPDATE, KEEPALIVE, and NOTIFICATION cease.
// TOKENS: host, ip, flow, bgp, open, asn, holdtime, bgpid, keepalive, wait, ms, update, prefix, nexthop, notification, payload, compile

// INSTRUCTION: Define enterprise edge BGP router.
host ent_bgp_edge { ip 172.31.250.1 }

// INSTRUCTION: Define cloud direct-connect BGP gateway.
host cloud_dx_bgp { ip 172.31.250.2 }

// INSTRUCTION: Define full BGP lifecycle including OPEN, KEEPALIVE, UPDATE, and NOTIFICATION.
flow bgp_full_lifecycle(ent, cloud) {
    ent -> cloud bgp open asn 65200 holdtime 60 bgpid 172.31.250.1
    ent <- cloud bgp open asn 64515 holdtime 60 bgpid 172.31.250.2
    ent -> cloud bgp keepalive wait 10ms
    ent <- cloud bgp keepalive wait 10ms
    ent -> cloud bgp update asn 65200 prefix "10.50.0.0/16" nexthop 172.31.250.1 wait 20ms
    ent <- cloud bgp update asn 64515 prefix "10.200.0.0/16" nexthop 172.31.250.2 wait 20ms
    ent -> cloud bgp notification payload "Administrative Shutdown" wait 50ms
}

// INSTRUCTION: Compile the full BGP session lifecycle flow.
compile {
    bgp_full_lifecycle(ent_bgp_edge, cloud_dx_bgp)
}
