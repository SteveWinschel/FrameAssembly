// Complete BGP session lifecycle from OPEN to UPDATE, KEEPALIVE, and
// NOTIFICATION cease.
// This capture carries ASN 64515/65200 and uses post-packet wait gaps (10ms,
// 20ms, 50ms) between frames.
// Wireshark: bgp

host ent_bgp_edge { ip 172.31.250.1 }

host cloud_dx_bgp { ip 172.31.250.2 }

// Packet sequence (7 frames); wait pauses after a packet before the next.
flow bgp_full_lifecycle(ent, cloud) {
    ent -> cloud bgp open asn 65200 holdtime 60 bgpid 172.31.250.1
    ent <- cloud bgp open asn 64515 holdtime 60 bgpid 172.31.250.2 wait 10ms
    ent -> cloud bgp keepalive wait 10ms
    ent <- cloud bgp keepalive wait 20ms
    ent -> cloud bgp update asn 65200 prefix "10.50.0.0/16" nexthop 172.31.250.1 wait 20ms
    ent <- cloud bgp update asn 64515 prefix "10.200.0.0/16" nexthop 172.31.250.2 wait 50ms
    ent -> cloud bgp notification payload "Administrative Shutdown"
}

// Run bgp_full_lifecycle(ent_bgp_edge, cloud_dx_bgp) to generate the capture.
compile {
    bgp_full_lifecycle(ent_bgp_edge, cloud_dx_bgp)
}
