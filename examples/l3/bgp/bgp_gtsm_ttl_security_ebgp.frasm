// PROMPT: RFC 5082 Generalized TTL Security Mechanism (GTSM) eBGP session enforcing TTL 255 and DF.
// TOKENS: host, ip, flow, bgp, open, asn, holdtime, bgpid, ttl, df, ipid, update, prefix, nexthop, keepalive, compile

// INSTRUCTION: Define GTSM-hardened border router A.
host gtsm_bgp_a { ip 198.51.100.201 }

// INSTRUCTION: Define GTSM-hardened border router B.
host gtsm_bgp_b { ip 198.51.100.202 }

// INSTRUCTION: Define eBGP session with TTL 255 and IPv4 Don't Fragment flag.
flow bgp_gtsm_protected(a, b) {
    a -> b bgp open asn 65401 holdtime 30 bgpid 198.51.100.201 ttl 255 df ipid 501
    a <- b bgp open asn 65402 holdtime 30 bgpid 198.51.100.202 ttl 255 df ipid 601
    a -> b bgp update asn 65401 prefix "192.0.2.0/24" nexthop 198.51.100.201 ttl 255 df ipid 502
    a <- b bgp keepalive ttl 255 df ipid 602
}

// INSTRUCTION: Compile the GTSM TTL-hardened eBGP flow.
compile {
    bgp_gtsm_protected(gtsm_bgp_a, gtsm_bgp_b)
}
