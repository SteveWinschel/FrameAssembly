// PROMPT: RFC 4760 Multiprotocol BGP (MP-BGP) over IPv6 advertising global IPv6 unicast prefixes and link-local Next-Hop.
// TOKENS: host, ip, mac, flow, bgp, update, asn, prefix, nexthop, flowlabel, dscp, ttl, wait, ms, keepalive, compile

// INSTRUCTION: Define Tier-1 IPv6 transit router A in AS 64501.
host v6_tier1_rtr_a {
    ip 2001:db8:feed::1
    mac 00:25:90:fe:ed:01
}

// INSTRUCTION: Define Tier-1 IPv6 transit router B in AS 64502.
host v6_tier1_rtr_b {
    ip 2001:db8:feed::2
    mac 00:25:90:fe:ed:02
}

// INSTRUCTION: Define IPv6 MP-BGP UPDATE advertising /32 and /48 IPv6 prefixes with Flow Label 17900.
flow bgp_v6_global_unicast_flow(a, b) {
    a -> b bgp update asn 64501 prefix "2001:db8:1000::/36" nexthop 2001:db8:feed::1 flowlabel 17900 dscp 48 ttl 255 wait 5ms
    a <- b bgp update asn 64502 prefix "2001:db8:2000::/36" nexthop 2001:db8:feed::2 flowlabel 17900 dscp 48 ttl 255 wait 5ms
    a -> b bgp keepalive flowlabel 17900 dscp 48 ttl 255
}

// INSTRUCTION: Compile the IPv6 MP-BGP global unicast prefix advertisement flow.
compile {
    bgp_v6_global_unicast_flow(v6_tier1_rtr_a, v6_tier1_rtr_b)
}
