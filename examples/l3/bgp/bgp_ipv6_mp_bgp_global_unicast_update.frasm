// RFC 4760 Multiprotocol BGP (MP-BGP) over IPv6 advertising global IPv6
// unicast prefixes and link-local Next-Hop.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 255, IPv6 Flow
// Label, carries ASN 64501/64502, and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: bgp && ipv6

host v6_tier1_rtr_a {
    ip 2001:db8:feed::1
    mac 00:25:90:fe:ed:01
}

host v6_tier1_rtr_b {
    ip 2001:db8:feed::2
    mac 00:25:90:fe:ed:02
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow bgp_v6_global_unicast_flow(a, b) {
    a -> b bgp update asn 64501 prefix "2001:db8:1000::/36" nexthop 2001:db8:feed::1 flowlabel 17900 dscp 48 ttl 255 wait 5ms
    a <- b bgp update asn 64502 prefix "2001:db8:2000::/36" nexthop 2001:db8:feed::2 flowlabel 17900 dscp 48 ttl 255 wait 5ms
    a -> b bgp keepalive flowlabel 17900 dscp 48 ttl 255
}

// Run bgp_v6_global_unicast_flow(v6_tier1_rtr_a, v6_tier1_rtr_b) to generate
// the capture.
compile {
    bgp_v6_global_unicast_flow(v6_tier1_rtr_a, v6_tier1_rtr_b)
}
