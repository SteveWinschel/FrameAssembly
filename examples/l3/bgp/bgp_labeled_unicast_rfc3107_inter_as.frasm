// RFC 3107 / RFC 8277 BGP Labeled Unicast (BGP-LU) Inter-AS Option C session
// over MPLS transport.
// This capture wraps frames in MPLS label 29901/29902, sets DSCP 48, TTL 1,
// carries ASN 65001/65002, and uses post-packet wait gaps (5ms) between
// frames.
// Wireshark: bgp && mpls

host asbr1_opt_c {
    ip 10.31.7.1
    mac 00:19:e8:31:07:01
}

host asbr2_opt_c {
    ip 10.31.7.2
    mac 00:19:e8:31:07:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bgp_labeled_unicast_opt_c(asbr1, asbr2) {
    asbr1 -> asbr2 bgp update asn 65001 prefix "10.255.1.1/32" nexthop 10.31.7.1 mpls 29901 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 payload "BGPLU_SAFI4_LABEL_29901" wait 5ms
    asbr1 <- asbr2 bgp update asn 65002 prefix "10.255.2.1/32" nexthop 10.31.7.2 mpls 29902 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 payload "BGPLU_SAFI4_LABEL_29902"
}

// Run bgp_labeled_unicast_opt_c(asbr1_opt_c, asbr2_opt_c) to generate the
// capture.
compile {
    bgp_labeled_unicast_opt_c(asbr1_opt_c, asbr2_opt_c)
}
