// PROMPT: Periodic BGP KEEPALIVE heartbeat exchange executed inside a COMPILE LOOP block.
// TOKENS: HOST, IP, FLOW, BGP, KEEPALIVE, WAIT, COMPILE, LOOP

// INSTRUCTION: Define long-haul BGP peer West.
HOST lh_bgp_west { IP 198.51.100.77 }

// INSTRUCTION: Define long-haul BGP peer East.
HOST lh_bgp_east { IP 198.51.100.78 }

// INSTRUCTION: Define bidirectional BGP KEEPALIVE exchange with 30ms interval.
FLOW bgp_keepalive_tick(w, e) {
    w -> e BGP KEEPALIVE WAIT 30ms
    w <- e BGP KEEPALIVE WAIT 30ms
}

// INSTRUCTION: Compile 4 consecutive BGP keepalive intervals.
COMPILE {
    LOOP 4 {
        bgp_keepalive_tick(lh_bgp_west, lh_bgp_east)
    }
}
