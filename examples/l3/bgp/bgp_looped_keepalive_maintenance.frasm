// PROMPT: Periodic BGP KEEPALIVE heartbeat exchange executed inside a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, bgp, keepalive, wait, ms, compile

// INSTRUCTION: Define long-haul BGP peer West.
host lh_bgp_west { ip 198.51.100.77 }

// INSTRUCTION: Define long-haul BGP peer East.
host lh_bgp_east { ip 198.51.100.78 }

// INSTRUCTION: Define bidirectional BGP KEEPALIVE exchange with 30ms interval.
flow bgp_keepalive_tick(w, e) {
    w -> e bgp keepalive wait 30ms
    w <- e bgp keepalive wait 30ms
}

// INSTRUCTION: Compile 4 consecutive BGP keepalive intervals.
compile {
    bgp_keepalive_tick(lh_bgp_west, lh_bgp_east) // cycle 1
    bgp_keepalive_tick(lh_bgp_west, lh_bgp_east) // cycle 2
    bgp_keepalive_tick(lh_bgp_west, lh_bgp_east) // cycle 3
    bgp_keepalive_tick(lh_bgp_west, lh_bgp_east) // cycle 4
}
