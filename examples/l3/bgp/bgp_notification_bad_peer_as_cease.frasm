// RFC 4271 BGP NOTIFICATION message terminating a peering attempt due to OPEN
// configuration mismatch.
// This capture sets DSCP 48, TTL 1, carries ASN 65555, and uses post-packet
// wait gaps (5ms) between frames.
// Wireshark: bgp

host transit_asbr_01 {
    ip 198.51.100.254
    mac 00:1b:21:64:fe:01
}

host customer_edge_99 {
    ip 198.51.100.253
    mac 00:1b:21:64:fd:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bgp_open_error_notification(cust, provider) {
    cust -> provider bgp open asn 65555 holdtime 180 bgpid 198.51.100.253 dscp 48 ttl 1 wait 5ms
    cust <- provider bgp notification dscp 48 ttl 1 payload "OPEN_MSG_ERROR_BAD_PEER_AS"
}

// Run bgp_open_error_notification(customer_edge_99, transit_asbr_01) to
// generate the capture.
compile {
    bgp_open_error_notification(customer_edge_99, transit_asbr_01)
}
