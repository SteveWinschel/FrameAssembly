// BGP session teardown via NOTIFICATION message after Hold Timer expiration.
// This capture uses post-packet wait gaps (50ms) between frames.
// Wireshark: bgp

host transit_bgp_speaker { ip 203.0.113.5 }

host enterprise_bgp_speaker { ip 203.0.113.6 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow bgp_holdtimer_notification(up, down) {
    up -> down bgp keepalive wait 50ms
    up -> down bgp notification payload "Hold Timer Expired"
}

// Run bgp_holdtimer_notification(transit_bgp_speaker, enterprise_bgp_speaker)
// to generate the capture.
compile {
    bgp_holdtimer_notification(transit_bgp_speaker, enterprise_bgp_speaker)
}
