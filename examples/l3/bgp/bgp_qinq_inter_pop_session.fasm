// PROMPT: Inter-PoP BGP session encapsulated in 802.1ad QinQ double VLAN tags.
// TOKENS: host, ip, flow, bgp, open, asn, holdtime, bgpid, qinq, innervlan, update, prefix, nexthop, keepalive, compile

// INSTRUCTION: Define metro PoP east router.
host pop_east_bgp { ip 172.22.1.1 }

// INSTRUCTION: Define metro PoP west router.
host pop_west_bgp { ip 172.22.1.2 }

// INSTRUCTION: Define QinQ double-tagged BGP peering session.
flow bgp_qinq_inter_pop(east, west) {
    east -> west bgp open asn 65101 holdtime 60 bgpid 172.22.1.1 qinq 3100 innervlan 179
    east <- west bgp open asn 65102 holdtime 60 bgpid 172.22.1.2 qinq 3100 innervlan 179
    east -> west bgp update asn 65101 prefix "10.220.0.0/16" nexthop 172.22.1.1 qinq 3100 innervlan 179
    east <- west bgp keepalive qinq 3100 innervlan 179
}

// INSTRUCTION: Compile the QinQ inter-PoP BGP flow.
compile {
    bgp_qinq_inter_pop(pop_east_bgp, pop_west_bgp)
}
