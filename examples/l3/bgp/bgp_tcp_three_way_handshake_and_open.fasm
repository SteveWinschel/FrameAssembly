// PROMPT: Complete TCP port 179 three-way handshake (SYN, SYN-ACK, ACK) followed by RFC 4271 BGP OPEN and KEEPALIVE.
// TOKENS: host, ip, mac, flow, bgp, open, asn, holdtime, bgpid, srcport, dstport, seq, acknum, win, syn, dscp, ttl, wait, ms, ack, psh, keepalive, compile

// INSTRUCTION: Define Customer Edge eBGP router initiating active TCP port 179 connection.
host ce_bgp_initiator {
    ip 192.0.2.2
    mac 00:1e:49:02:00:02
}

// INSTRUCTION: Define Provider Edge eBGP router listening on TCP port 179.
host pe_bgp_listener {
    ip 192.0.2.1
    mac 00:1e:49:02:00:01
}

// INSTRUCTION: Define TCP 3-way handshake on port 179 followed by BGP OPEN and KEEPALIVE exchange.
flow bgp_tcp_handshake_open(ce, pe) {
    ce -> pe bgp open asn 65010 holdtime 180 bgpid 192.0.2.2 srcport 52179 dstport 179 seq 1000 acknum 0 win 64240 syn dscp 48 ttl 1 wait 5ms
    ce <- pe bgp open asn 65001 holdtime 180 bgpid 192.0.2.1 srcport 179 dstport 52179 seq 5000 acknum 1001 win 65535 syn ack dscp 48 ttl 1 wait 5ms
    ce -> pe bgp open asn 65010 holdtime 180 bgpid 192.0.2.2 srcport 52179 dstport 179 seq 1001 acknum 5001 win 64240 psh ack dscp 48 ttl 1 wait 5ms
    ce <- pe bgp keepalive srcport 179 dstport 52179 seq 5030 acknum 1030 win 65535 psh ack dscp 48 ttl 1
}

// INSTRUCTION: Compile the TCP handshake + BGP OPEN session establishment flow.
compile {
    bgp_tcp_handshake_open(ce_bgp_initiator, pe_bgp_listener)
}
