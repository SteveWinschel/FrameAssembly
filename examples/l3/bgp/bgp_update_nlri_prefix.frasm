// PROMPT: BGP UPDATE message announcing IPv4 Network Layer Reachability Information prefix and next hop.
// TOKENS: host, ip, flow, bgp, update, prefix, nexthop, compile

// INSTRUCTION: Define upstream ISP transit router.
host isp_transit_router { ip 198.51.100.1 }

// INSTRUCTION: Define customer border router receiving routing updates.
host customer_bgp_edge { ip 198.51.100.2 }

// INSTRUCTION: Define BGP UPDATE flow announcing enterprise prefix reachability.
flow bgp_update_flow(isp, cust) {
    isp -> cust bgp update prefix "203.0.113.0/24" nexthop 198.51.100.1
}

// INSTRUCTION: Compile block executing BGP UPDATE announcement.
compile {
    bgp_update_flow(isp_transit_router, customer_bgp_edge)
}
