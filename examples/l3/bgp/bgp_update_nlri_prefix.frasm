// BGP UPDATE message announcing IPv4 Network Layer Reachability Information
// prefix and next hop.
// This capture exchanges TCP port 179 peering messages with automatic
// sequence tracking.
// Wireshark: bgp

host isp_transit_router { ip 198.51.100.1 }

host customer_bgp_edge { ip 198.51.100.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow bgp_update_flow(isp, cust) {
    isp -> cust bgp update prefix "203.0.113.0/24" nexthop 198.51.100.1
}

// Run bgp_update_flow(isp_transit_router, customer_bgp_edge) to generate the
// capture.
compile {
    bgp_update_flow(isp_transit_router, customer_bgp_edge)
}
