// PROMPT: RFC 4106 / RFC 4303 IPsec ESP tunnel using AES-256-GCM with an explicit 8-byte nonce IV and 16-byte AEAD authentication tag.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Cloud VPC VPN Gateway encrypting site-to-site tunnel traffic with AES-GCM.
host vpc_gcm_gw {
    ip 198.51.100.10
    mac 00:1b:21:50:10:01
}

// INSTRUCTION: Define on-premises Data Center Firewall terminating AES-GCM ESP Security Association.
host onprem_gcm_fw {
    ip 203.0.113.20
    mac 00:1b:21:50:20:02
}

// INSTRUCTION: Define bidirectional ESP tunnel mode (NEXT_HEADER 4) with 8B IV and 16B AEAD ICV.
flow esp_aes_gcm_tunnel_flow(vpc, onprem) {
    vpc -> onprem esp spi 410601 seq 1 iv "00000001a1b2c3d4" icv "102030405060708090a0b0c0d0e0f001" nextheader 4 df dscp 34 ttl 64 payload "AES256_GCM_CIPHERTEXT_BLOCK_1" wait 5ms
    vpc <- onprem esp spi 410602 seq 1 iv "00000001d4c3b2a1" icv "01f0e0d0c0b0a0908070605040302010" nextheader 4 df dscp 34 ttl 64 payload "AES256_GCM_CIPHERTEXT_BLOCK_2"
}

// INSTRUCTION: Compile the RFC 4106 AES-GCM IPsec ESP tunnel mode flow.
compile {
    esp_aes_gcm_tunnel_flow(vpc_gcm_gw, onprem_gcm_fw)
}
