// RFC 4106 / RFC 4303 IPsec ESP tunnel using AES-256-GCM with an explicit
// 8-byte nonce IV and 16-byte AEAD authentication tag.
// This capture sets DSCP 34, TTL 64, DF bit set, carries SPI 410601/410602,
// and uses post-packet wait gaps (5ms) between frames.
// Wireshark: esp

host vpc_gcm_gw {
    ip 198.51.100.10
    mac 00:1b:21:50:10:01
}

host onprem_gcm_fw {
    ip 203.0.113.20
    mac 00:1b:21:50:20:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow esp_aes_gcm_tunnel_flow(vpc, onprem) {
    vpc -> onprem esp spi 410601 seq 1 iv "00000001a1b2c3d4" icv "102030405060708090a0b0c0d0e0f001" nextheader 4 df dscp 34 ttl 64 payload "AES256_GCM_CIPHERTEXT_BLOCK_1" wait 5ms
    vpc <- onprem esp spi 410602 seq 1 iv "00000001d4c3b2a1" icv "01f0e0d0c0b0a0908070605040302010" nextheader 4 df dscp 34 ttl 64 payload "AES256_GCM_CIPHERTEXT_BLOCK_2"
}

// Run esp_aes_gcm_tunnel_flow(vpc_gcm_gw, onprem_gcm_fw) to generate the
// capture.
compile {
    esp_aes_gcm_tunnel_flow(vpc_gcm_gw, onprem_gcm_fw)
}
