// PROMPT: RFC 4303 Section 3.4.3 IPsec ESP anti-replay 64-packet sliding window verification under out-of-order delivery.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define multi-path WAN sender transmitting ESP packets across asymmetric links.
host multipath_esp_tx {
    ip 10.50.99.1
    mac 00:22:bd:50:99:01
}

// INSTRUCTION: Define WAN receiver validating out-of-order ESP sequence numbers within the 64-bit replay bitmap.
host multipath_esp_rx {
    ip 10.50.99.2
    mac 00:22:bd:50:99:02
}

// INSTRUCTION: Define out-of-order ESP sequence numbers (SEQ 100, 103, 101, 102) advancing the replay window.
flow esp_anti_replay_window_test(tx, rx) {
    tx -> rx esp spi 99001 seq 100 iv "0000000000000064" icv "010101010202020203030303" nextheader 4 df ttl 64 payload "ESP_PKT_SEQ_100_IN_ORDER" wait 2ms
    tx -> rx esp spi 99001 seq 103 iv "0000000000000067" icv "040404040505050506060606" nextheader 4 df ttl 64 payload "ESP_PKT_SEQ_103_ADVANCE_TOP" wait 2ms
    tx -> rx esp spi 99001 seq 101 iv "0000000000000065" icv "070707070808080809090909" nextheader 4 df ttl 64 payload "ESP_PKT_SEQ_101_WINDOW_HIT" wait 2ms
    tx -> rx esp spi 99001 seq 102 iv "0000000000000066" icv "0a0a0a0a0b0b0b0b0c0c0c0c" nextheader 4 df ttl 64 payload "ESP_PKT_SEQ_102_WINDOW_FILL"
}

// INSTRUCTION: Compile the ESP anti-replay sliding window out-of-order test flow.
compile {
    esp_anti_replay_window_test(multipath_esp_tx, multipath_esp_rx)
}
