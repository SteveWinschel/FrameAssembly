// PROMPT: RFC 7634 IPsec ESP tunnel utilizing ChaCha20-Poly1305 AEAD with 64-bit implicit/explicit IV and 128-bit Poly1305 ICV.
// TOKENS: HOST, IP, MAC, FLOW, ESP, SPI, SEQ, IV, ICV, NEXT_HEADER, DF, DSCP, TTL, PAYLOAD, WAIT, COMPILE

// INSTRUCTION: Define mobile edge router encrypting uplink traffic with ChaCha20-Poly1305 ESP.
HOST edge_chacha_rtr {
    IP 100.64.50.10
    MAC 00:1e:67:76:34:0a
}

// INSTRUCTION: Define headend concentrator verifying Poly1305 16-byte authentication tag.
HOST headend_chacha_gw {
    IP 192.0.2.200
    MAC 00:1e:67:76:34:c8
}

// INSTRUCTION: Define RFC 7634 ChaCha20-Poly1305 ESP exchange with NEXT_HEADER 4 (IPv4).
FLOW esp_chacha20_poly1305_flow(edge, headend) {
    edge -> headend ESP SPI 763401 SEQ 10 IV "000000000000000a" ICV "aa11bb22cc33dd44ee55ff6677889900" NEXT_HEADER 4 DF DSCP 26 TTL 62 PAYLOAD "CHACHA20_STREAM_CIPHER_FRAME_A" WAIT 4ms
    edge <- headend ESP SPI 763402 SEQ 10 IV "000000000000000a" ICV "0099887766ff55ee44dd33cc22bb11aa" NEXT_HEADER 4 DF DSCP 26 TTL 62 PAYLOAD "CHACHA20_STREAM_CIPHER_FRAME_B"
}

// INSTRUCTION: Compile the RFC 7634 ChaCha20-Poly1305 ESP VPN scenario.
COMPILE {
    esp_chacha20_poly1305_flow(edge_chacha_rtr, headend_chacha_gw)
}
