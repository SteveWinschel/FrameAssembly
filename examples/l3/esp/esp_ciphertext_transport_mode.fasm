// PROMPT: IPsec ESP transport session advancing sequence numbers between hosts.
// TOKENS: HOST, IP, FLOW, ->, <-, ESP, SPI, SEQ, COMPILE

// INSTRUCTION: Define secure workstation node.
HOST sec_node_a { IP 10.20.30.1 }

// INSTRUCTION: Define secure application server.
HOST sec_node_b { IP 10.20.30.2 }

// INSTRUCTION: Define bidirectional ESP packet stream exchanging encrypted records.
FLOW esp_transport_flow(a, b) {
    a -> b ESP SPI 10001 SEQ 1
    a <- b ESP SPI 10002 SEQ 1
    a -> b ESP SPI 10001 SEQ 2
}

// INSTRUCTION: Compile block executing bidirectional ESP transport.
COMPILE {
    esp_transport_flow(sec_node_a, sec_node_b)
}
