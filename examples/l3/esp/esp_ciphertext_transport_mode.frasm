// IPsec ESP transport session advancing sequence numbers between hosts.
// This capture carries SPI 10001/10002.
// Wireshark: esp

host sec_node_a { ip 10.20.30.1 }

host sec_node_b { ip 10.20.30.2 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow esp_transport_flow(a, b) {
    a -> b esp spi 10001 seq 1
    a <- b esp spi 10002 seq 1
    a -> b esp spi 10001 seq 2
}

// Run esp_transport_flow(sec_node_a, sec_node_b) to generate the capture.
compile {
    esp_transport_flow(sec_node_a, sec_node_b)
}
