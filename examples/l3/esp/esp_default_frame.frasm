// Minimal IPsec Encapsulating Security Payload (ESP, RFC 4303) starter packet
// over IP protocol 50 using built-in default SPI, sequence number, IV, and
// ICV fields. Useful for testing IP protocol 50 firewall traversal and ESP
// capture inspection.
// Wireshark: esp

host endpoint_a {
    ip 10.50.0.1
    mac 02:00:50:00:00:01
}

host endpoint_b {
    ip 10.50.0.2
    mac 02:00:50:00:00:02
}

// Transmit one default ESP frame directly inside compile.
compile {
    endpoint_a -> endpoint_b esp
}
