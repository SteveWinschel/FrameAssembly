// PROMPT: RFC 4303 / RFC 6040 IPsec ESP tunnel preserving inner DSCP AF21 (18) and ECN ECT(0) (2) markings on the outer header.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, dscp, ecn, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define enterprise branch QoS-aware IPsec gateway.
host qos_esp_branch {
    ip 172.19.50.1
    mac 00:1a:a1:50:12:01
}

// INSTRUCTION: Define regional hub IPsec gateway inspecting outer RFC 6040 ECN bits.
host qos_esp_hub {
    ip 172.19.50.254
    mac 00:1a:a1:50:12:fe
}

// INSTRUCTION: Define ESP tunnel packets with DSCP 18 (AF21) and ECN 2 (ECT0) transitioning to ECN 3 (CE).
flow esp_rfc6040_ecn_tunnel(branch, hub) {
    branch -> hub esp spi 60401 seq 1 iv "6040000160400001" icv "123456789abcdef012345678" nextheader 4 dscp 18 ecn 2 df ttl 63 payload "TRANSACTIONAL_DATA_ECT0" wait 5ms
    branch -> hub esp spi 60401 seq 2 iv "6040000260400002" icv "876543210fedcba987654321" nextheader 4 dscp 18 ecn 3 df ttl 63 payload "TRANSACTIONAL_DATA_CE_MARKED" wait 5ms
    branch <- hub esp spi 60402 seq 1 iv "6040000360400003" icv "abcdef0123456789abcdef01" nextheader 4 dscp 18 ecn 2 df ttl 63 payload "TRANSACTIONAL_ACK_ECE_FEEDBACK"
}

// INSTRUCTION: Compile the RFC 6040 ECN-preserving IPsec ESP tunnel flow.
compile {
    esp_rfc6040_ecn_tunnel(qos_esp_branch, qos_esp_hub)
}
