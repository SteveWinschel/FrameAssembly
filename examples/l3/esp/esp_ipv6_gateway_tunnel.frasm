// IPsec ESP encrypted tunnel packet transmission between two IPv6 endpoints.
// This capture targets IPv6 endpoints and carries SPI 90001.
// Wireshark: esp && ipv6

host esp_v6_gw_a { ip 2001:db8:e50::1 }

host esp_v6_gw_b { ip 2001:db8:e50::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow esp_v6_tunnel_flow(gw_a, gw_b) {
    gw_a -> gw_b esp spi 90001 seq 1
}

// Run esp_v6_tunnel_flow(esp_v6_gw_a, esp_v6_gw_b) to generate the capture.
compile {
    esp_v6_tunnel_flow(esp_v6_gw_a, esp_v6_gw_b)
}
