// PROMPT: IPv6 Host-to-Host RFC 4303 ESP transport mode protecting upper-layer UDP telemetry (Next Header 17) with custom MACs.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, flowlabel, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define IPv6 telemetry collector node A.
host v6_telem_esp_a {
    ip 2001:db8:50:17::10
    mac 00:16:3e:50:17:0a
}

// INSTRUCTION: Define IPv6 telemetry analytics engine B.
host v6_telem_esp_b {
    ip 2001:db8:50:17::20
    mac 00:16:3e:50:17:14
}

// INSTRUCTION: Define IPv6 ESP transport mode (NEXT_HEADER 17) with FLOWLABEL and DSCP.
flow esp_v6_udp_transport_flow(a, b) {
    a -> b esp spi 601701 seq 1 iv "0017001700170017" icv "f1e2d3c4b5a69788796a5b4c" nextheader 17 flowlabel 17050 dscp 26 ttl 64 payload "ENCRYPTED_UDP_GNMI_STREAM" wait 5ms
    a <- b esp spi 601702 seq 1 iv "7100710071007100" icv "4c5b6a798897a6b5c4d3e2f1" nextheader 17 flowlabel 17050 dscp 26 ttl 64 payload "ENCRYPTED_UDP_GNMI_ACK"
}

// INSTRUCTION: Compile the IPv6 ESP UDP telemetry transport mode flow.
compile {
    esp_v6_udp_transport_flow(v6_telem_esp_a, v6_telem_esp_b)
}
