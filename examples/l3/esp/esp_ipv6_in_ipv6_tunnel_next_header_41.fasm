// PROMPT: RFC 4303 IPsec ESP over IPv6 encapsulating inner IPv6 tenant packets (Next Header 41) across a global backbone.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, flowlabel, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Frankfurt IPv6 IPsec VPN concentrator.
host fra_v6_esp_gw {
    ip 2001:db8:49:50::1
    mac 00:25:90:49:50:01
}

// INSTRUCTION: Define Tokyo IPv6 IPsec VPN concentrator.
host nrt_v6_esp_gw {
    ip 2001:db8:81:50::1
    mac 00:25:90:81:50:02
}

// INSTRUCTION: Define IPv6 ESP tunnel mode (NEXT_HEADER 41) with Flow Label 50041 and AF41 QoS.
flow esp_v6_in_v6_tunnel(fra, nrt) {
    fra -> nrt esp spi 600411 seq 1 iv "20010db800490050" icv "112233445566778899aabbccddeeff00" nextheader 41 flowlabel 50041 dscp 34 ttl 58 payload "IPV6_INNER_ENCRYPTED_PAYLOAD_REQ" wait 10ms
    fra <- nrt esp spi 600412 seq 1 iv "20010db800810050" icv "00ffeeddccbbaa998877665544332211" nextheader 41 flowlabel 50041 dscp 34 ttl 58 payload "IPV6_INNER_ENCRYPTED_PAYLOAD_ACK"
}

// INSTRUCTION: Compile the IPv6-in-IPv6 ESP tunnel mode flow.
compile {
    esp_v6_in_v6_tunnel(fra_v6_esp_gw, nrt_v6_esp_gw)
}
