// RFC 4303 IPsec ESP over IPv6 encapsulating inner IPv6 tenant packets (Next
// Header 41) across a global backbone.
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 58, IPv6 Flow Label,
// carries SPI 600411/600412, and uses post-packet wait gaps (10ms) between
// frames.
// Wireshark: esp && ipv6

host fra_v6_esp_gw {
    ip 2001:db8:49:50::1
    mac 00:25:90:49:50:01
}

host nrt_v6_esp_gw {
    ip 2001:db8:81:50::1
    mac 00:25:90:81:50:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow esp_v6_in_v6_tunnel(fra, nrt) {
    fra -> nrt esp spi 600411 seq 1 iv "20010db800490050" icv "112233445566778899aabbccddeeff00" nextheader 41 flowlabel 50041 dscp 34 ttl 58 payload "IPV6_INNER_ENCRYPTED_PAYLOAD_REQ" wait 10ms
    fra <- nrt esp spi 600412 seq 1 iv "20010db800810050" icv "00ffeeddccbbaa998877665544332211" nextheader 41 flowlabel 50041 dscp 34 ttl 58 payload "IPV6_INNER_ENCRYPTED_PAYLOAD_ACK"
}

// Run esp_v6_in_v6_tunnel(fra_v6_esp_gw, nrt_v6_esp_gw) to generate the
// capture.
compile {
    esp_v6_in_v6_tunnel(fra_v6_esp_gw, nrt_v6_esp_gw)
}
