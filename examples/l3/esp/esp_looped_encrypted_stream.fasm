// PROMPT: Continuous IPsec ESP encrypted tunnel traffic generated via a COMPILE LOOP block.
// TOKENS: HOST, IP, FLOW, ESP, SPI, SEQ, PAYLOAD, WAIT, COMPILE, LOOP

// INSTRUCTION: Define primary site IPsec peer.
HOST loop_esp_peer1 { IP 10.66.1.1 }

// INSTRUCTION: Define disaster recovery site IPsec peer.
HOST loop_esp_peer2 { IP 10.66.1.2 }

// INSTRUCTION: Define bidirectional ESP replication exchange.
FLOW esp_replication_cycle(p1, p2) {
    p1 -> p2 ESP SPI 81000 SEQ 1 PAYLOAD "ENCRYPTED_STORAGE_BLOCK" WAIT 10ms
    p1 <- p2 ESP SPI 81001 SEQ 1 PAYLOAD "ENCRYPTED_STORAGE_ACK" WAIT 10ms
}

// INSTRUCTION: Compile 4 iterations of the ESP replication cycle.
COMPILE {
    LOOP 4 {
        esp_replication_cycle(loop_esp_peer1, loop_esp_peer2)
    }
}
