// Continuous IPsec ESP encrypted tunnel traffic repeated across multiple
// cycles in compile.
// This capture carries SPI 81000/81001, executes 4 cycles in compile, and
// uses post-packet wait gaps (10ms) between frames.
// Wireshark: esp

host loop_esp_peer1 { ip 10.66.1.1 }

host loop_esp_peer2 { ip 10.66.1.2 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow esp_replication_cycle(p1, p2) {
    p1 -> p2 esp spi 81000 seq 1 payload "ENCRYPTED_STORAGE_BLOCK" wait 10ms
    p1 <- p2 esp spi 81001 seq 1 payload "ENCRYPTED_STORAGE_ACK" wait 10ms
}

// Emit 4 sequential cycles of esp_replication_cycle.
compile {
    esp_replication_cycle(loop_esp_peer1, loop_esp_peer2) // cycle 1
    esp_replication_cycle(loop_esp_peer1, loop_esp_peer2) // cycle 2
    esp_replication_cycle(loop_esp_peer1, loop_esp_peer2) // cycle 3
    esp_replication_cycle(loop_esp_peer1, loop_esp_peer2) // cycle 4
}
