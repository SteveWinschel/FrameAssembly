// PROMPT: IPsec ESP packets transported across an MPLS label-switched core network.
// TOKENS: host, ip, flow, esp, spi, seq, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define west PE crypto router.
host mpls_pe_west { ip 10.251.1.1 }

// INSTRUCTION: Define east PE crypto router.
host mpls_pe_east { ip 10.251.1.2 }

// INSTRUCTION: Define MPLS-labeled ESP exchange with label 32100 and EXP 4.
flow esp_mpls_transit(w, e) {
    w -> e esp spi 77880 seq 15 mpls 32100 exp 4 bos 1 mplsttl 60
    w <- e esp spi 77881 seq 15 mpls 32200 exp 4 bos 1 mplsttl 60
}

// INSTRUCTION: Compile the MPLS-labeled ESP transit flow.
compile {
    esp_mpls_transit(mpls_pe_west, mpls_pe_east)
}
