// IPsec ESP packets transported across an MPLS label-switched core network.
// This capture wraps frames in MPLS label 32100/32200 and carries SPI
// 77880/77881.
// Wireshark: esp && mpls

host mpls_pe_west { ip 10.251.1.1 }

host mpls_pe_east { ip 10.251.1.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow esp_mpls_transit(w, e) {
    w -> e esp spi 77880 seq 15 mpls 32100 exp 4 bos 1 mplsttl 60
    w <- e esp spi 77881 seq 15 mpls 32200 exp 4 bos 1 mplsttl 60
}

// Run esp_mpls_transit(mpls_pe_west, mpls_pe_east) to generate the capture.
compile {
    esp_mpls_transit(mpls_pe_west, mpls_pe_east)
}
