// PROMPT: Customer Edge (CE) to Customer Edge (CE) RFC 4303 IPsec ESP encryption traversing an MPLS L3VPN provider core.
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, mpls, exp, bos, mplsttl, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Customer Edge router CE-West encrypting payload prior to MPLS PE handoff.
host ce_west_esp {
    ip 10.150.1.1
    mac 00:24:38:96:01:01
}

// INSTRUCTION: Define Customer Edge router CE-East decrypting ESP payload after MPLS label disposition.
host ce_east_esp {
    ip 10.150.2.1
    mac 00:24:38:96:02:01
}

// INSTRUCTION: Define MPLS-labeled ESP frames with VRF label 35001 and EXP 4.
flow esp_ce_over_mpls_vpn(west, east) {
    west -> east esp spi 350011 seq 10 iv "3500110035001100" icv "aabbccddeeff001122334455" nextheader 4 mpls 35001 exp 4 bos 1 mplsttl 62 df dscp 32 ttl 62 payload "CE_FIN_REQ" wait 6ms
    west <- east esp spi 350012 seq 10 iv "3500120035001200" icv "554433221100ffeeddccbbaa" nextheader 4 mpls 35002 exp 4 bos 1 mplsttl 62 df dscp 32 ttl 62 payload "CE_FIN_ACK"
}

// INSTRUCTION: Compile the CE-to-CE IPsec ESP over MPLS L3VPN flow.
compile {
    esp_ce_over_mpls_vpn(ce_west_esp, ce_east_esp)
}
