// IPsec ESP tunnel mode specifying Next Header 4 (IPv4-in-IP) and encrypted
// payload.
// This capture carries SPI 20010/20020.
// Wireshark: esp

host branch_fw_esp { ip 172.16.50.1 }

host hq_fw_esp { ip 172.16.50.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow esp_tunnel_next_hdr(br, hq) {
    br -> hq esp spi 20010 seq 10 nextheader 4 payload "ENC_IPV4_INNER_PKT_01"
    br <- hq esp spi 20020 seq 10 nextheader 4 payload "ENC_IPV4_INNER_PKT_02"
}

// Run esp_tunnel_next_hdr(branch_fw_esp, hq_fw_esp) to generate the capture.
compile {
    esp_tunnel_next_hdr(branch_fw_esp, hq_fw_esp)
}
