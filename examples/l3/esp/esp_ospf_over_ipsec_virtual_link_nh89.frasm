// RFC 4552 / RFC 4303 OSPFv3 / OSPFv2 control packets (Next Header 89)
// encrypted directly inside IPsec ESP transport mode.
// This capture sets DSCP 48, TTL 64, carries SPI 89501/89502, and uses
// post-packet wait gaps (5ms) between frames.
// Wireshark: esp

host abr1_ospf_esp {
    ip 10.89.50.1
    mac 00:1e:be:89:50:01
}

host abr2_ospf_esp {
    ip 10.89.50.2
    mac 00:1e:be:89:50:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow esp_ospf_virtual_link_flow(abr1, abr2) {
    abr1 -> abr2 esp spi 89501 seq 77 iv "8950000189500001" icv "898989890102030405060708" nextheader 89 dscp 48 ttl 64 payload "ENCRYPTED_OSPF_VIRTUAL_LINK_DBD" wait 5ms
    abr1 <- abr2 esp spi 89502 seq 77 iv "8950000289500002" icv "080706050403020189898989" nextheader 89 dscp 48 ttl 64 payload "ENCRYPTED_OSPF_VIRTUAL_LINK_LSR"
}

// Run esp_ospf_virtual_link_flow(abr1_ospf_esp, abr2_ospf_esp) to generate
// the capture.
compile {
    esp_ospf_virtual_link_flow(abr1_ospf_esp, abr2_ospf_esp)
}
