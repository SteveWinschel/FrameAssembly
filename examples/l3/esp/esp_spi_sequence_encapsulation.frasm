// PROMPT: IPsec Encapsulating Security Payload packet transmission with SPI and sequence number.
// TOKENS: host, ip, flow, esp, spi, seq, compile

// INSTRUCTION: Define IPsec security gateway 1.
host ipsec_gw1 { ip 198.51.100.1 }

// INSTRUCTION: Define IPsec security gateway 2.
host ipsec_gw2 { ip 198.51.100.2 }

// INSTRUCTION: Define ESP security encapsulation flow.
flow esp_vpn_flow(gw1, gw2) {
    gw1 -> gw2 esp spi 5001 seq 1
}

// INSTRUCTION: Compile block executing ESP security transmission.
compile {
    esp_vpn_flow(ipsec_gw1, ipsec_gw2)
}
