// RFC 4303 IPsec ESP in Host-to-Host Transport Mode protecting upper-layer
// TCP segments (Next Header 6).
// This capture sets DSCP 18, TTL 64, DF bit set, carries SPI 500061/500062,
// and uses post-packet wait gaps (2ms) between frames.
// Wireshark: esp

host app_srv_esp_a {
    ip 10.50.6.11
    mac 00:50:56:50:06:0b
}

host db_srv_esp_b {
    ip 10.50.6.22
    mac 00:50:56:50:06:16
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow esp_tcp_transport_mode(app, db) {
    app -> db esp spi 500061 seq 101 iv "1122334455667788" icv "a1a2a3a4a5a6b1b2b3b4b5b6" nextheader 6 df dscp 18 ttl 64 payload "ENCRYPTED_TCP_SQL_QUERY" wait 2ms
    app <- db esp spi 500062 seq 204 iv "8877665544332211" icv "b6b5b4b3b2b1a6a5a4a3a2a1" nextheader 6 df dscp 18 ttl 64 payload "ENCRYPTED_TCP_SQL_RESULTSET"
}

// Run esp_tcp_transport_mode(app_srv_esp_a, db_srv_esp_b) to generate the
// capture.
compile {
    esp_tcp_transport_mode(app_srv_esp_a, db_srv_esp_b)
}
