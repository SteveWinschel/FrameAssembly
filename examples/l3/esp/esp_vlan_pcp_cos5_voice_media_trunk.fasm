// PROMPT: IEEE 802.1Q VLAN-tagged IPsec ESP voice trunk carrying RTP media with 802.1p PCP 5 and DSCP EF (46).
// TOKENS: host, ip, mac, flow, esp, spi, seq, iv, icv, nextheader, vlan, pcp, dei, dscp, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Enterprise Session Border Controller (SBC) encrypting SIP/RTP media trunk.
host sbc_voice_esp_a {
    ip 10.210.50.10
    mac 00:0c:29:d2:32:0a
}

// INSTRUCTION: Define Carrier Interconnect SBC terminating VLAN 210 IPsec ESP media stream.
host sbc_voice_esp_b {
    ip 10.210.50.20
    mac 00:0c:29:d2:32:14
}

// INSTRUCTION: Define VLAN 210 (PCP 5) and DSCP 46 (EF) ESP stream protecting UDP RTP media (Next Header 17).
flow esp_voice_media_trunk_flow(sbc_a, sbc_b) {
    sbc_a -> sbc_b esp spi 210501 seq 1 iv "5001500150015001" icv "aaaa1111bbbb2222cccc3333" nextheader 17 vlan 210 pcp 5 dei 0 dscp 46 df ttl 64 payload "G711_ULAW_ENCRYPTED_FRAME_1" wait 20ms
    sbc_a <- sbc_b esp spi 210502 seq 1 iv "5002500250025002" icv "3333cccc2222bbbb1111aaaa" nextheader 17 vlan 210 pcp 5 dei 0 dscp 46 df ttl 64 payload "G711_ULAW_ENCRYPTED_FRAME_2"
}

// INSTRUCTION: Compile the VLAN-prioritized IPsec ESP voice media trunk flow.
compile {
    esp_voice_media_trunk_flow(sbc_voice_esp_a, sbc_voice_esp_b)
}
