// PROMPT: EVPN-GENEVE Leaf NVE intercepting a local ARP/ND query and responding directly from the EVPN Type-2 proxy table.
// TOKENS: host, ip, mac, flow, geneve, vni, optclass, opttype, protocoltype, srcport, dstport, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define ingress compute hypervisor sending GENEVE-encapsulated ARP query.
host compute_nve_node {
    ip 10.60.40.10
    mac 00:16:3e:60:40:0a
}

// INSTRUCTION: Define Top-of-Rack EVPN-GENEVE NVE acting as ARP/ND suppression proxy.
host tor_arp_proxy_nve {
    ip 10.60.40.1
    mac 00:1c:73:60:40:01
}

// INSTRUCTION: Define GENEVE unicast ARP proxy response suppressing fabric-wide BUM flooding.
flow geneve_arp_suppression_flow(hv, tor) {
    hv -> tor geneve vni 4040 optclass 258 opttype 2 protocoltype 25944 srcport 50400 dstport 6081 df ttl 64 payload "ARP_WHO_HAS_10_40_0_99_TELL_10_40_0_10" wait 1ms
    hv <- tor geneve vni 4040 optclass 258 opttype 2 protocoltype 25944 srcport 50401 dstport 6081 df ttl 64 payload "ARP_PROXY_REPLY_10_40_0_99_IS_AT_00_16_3E_99_00_01"
}

// INSTRUCTION: Compile the EVPN-GENEVE ARP proxy suppression flow.
compile {
    geneve_arp_suppression_flow(compute_nve_node, tor_arp_proxy_nve)
}
