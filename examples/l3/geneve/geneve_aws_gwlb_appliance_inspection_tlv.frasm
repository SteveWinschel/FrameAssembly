// AWS Gateway Load Balancer (GWLB) encapsulating customer VPC traffic in RFC
// 8926 GENEVE with Option Class 0x0108 (264).
// This capture sets TTL 64, DF bit set, carries VNI 1, destination port 6081,
// and uses post-packet wait gaps (1ms) between frames.
// Wireshark: geneve && geneve.vni == 1

host aws_gwlb_eni {
    ip 10.100.60.10
    mac 02:a1:b2:60:81:0a
}

host ngfw_partner_appliance {
    ip 10.100.60.50
    mac 02:a1:b2:60:81:32
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_aws_gwlb_hairpin(gwlb, fw) {
    gwlb -> fw geneve vni 1 optclass 264 opttype 1 protocoltype 2048 srcport 49800 dstport 6081 df ttl 64 payload "AWS_GWLBE_ENI_ID_FLOW_COOKIE_INGRESS" wait 1ms
    gwlb <- fw geneve vni 1 optclass 264 opttype 1 protocoltype 2048 srcport 49800 dstport 6081 df ttl 64 payload "AWS_GWLBE_ENI_ID_FLOW_COOKIE_INSPECTED_OK"
}

// Run geneve_aws_gwlb_hairpin(aws_gwlb_eni, ngfw_partner_appliance) to
// generate the capture.
compile {
    geneve_aws_gwlb_hairpin(aws_gwlb_eni, ngfw_partner_appliance)
}
