// RFC 8926 GENEVE ingress replication flooding an inner
// Broadcast/Unknown-Unicast/Multicast (BUM) ARP request across NVEs.
// This capture sets TTL 64, DF bit set, carries VNI 10100, destination port
// 6081, and uses post-packet wait gaps (3ms) between frames.
// Wireshark: geneve && geneve.vni == 10100

host bum_ingress_nve {
    ip 10.60.10.1
    mac 00:1c:73:60:10:01
}

host bum_remote_nve {
    ip 10.60.10.2
    mac 00:1c:73:60:10:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_bum_arp_flood(ing, rem) {
    ing -> rem geneve vni 10100 protocoltype 25944 srcport 49152 dstport 6081 df ttl 64 hexpayload "ffffffffffff00112233445508060001080006040001" wait 3ms
    ing <- rem geneve vni 10100 protocoltype 25944 srcport 49153 dstport 6081 df ttl 64 hexpayload "00112233445566778899aabb08060001080006040002"
}

// Run geneve_bum_arp_flood(bum_ingress_nve, bum_remote_nve) to generate the
// capture.
compile {
    geneve_bum_arp_flood(bum_ingress_nve, bum_remote_nve)
}
