// Cilium Kubernetes CNI encapsulating pod-to-pod traffic in RFC 8926 GENEVE
// with eBPF Security Identity TLV metadata.
// This capture sets DSCP 18, TTL 64, DF bit set, carries VNI 2, destination
// port 6081, and uses post-packet wait gaps (2ms) between frames.
// Wireshark: geneve && geneve.vni == 2

host cilium_node_01 {
    ip 10.244.0.11
    mac 00:16:3e:60:81:0b
}

host cilium_node_02 {
    ip 10.244.0.12
    mac 00:16:3e:60:81:0c
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_cilium_identity_flow(n1, n2) {
    n1 -> n2 geneve vni 2 optclass 267 opttype 1 protocoltype 25944 srcport 51234 dstport 6081 df dscp 18 ttl 64 payload "CILIUM_POD_TO_POD_ID_42105_HTTP_GET" wait 2ms
    n1 <- n2 geneve vni 2 optclass 267 opttype 1 protocoltype 25944 srcport 51235 dstport 6081 df dscp 18 ttl 64 payload "CILIUM_POD_TO_POD_ID_19820_HTTP_200"
}

// Run geneve_cilium_identity_flow(cilium_node_01, cilium_node_02) to generate
// the capture.
compile {
    geneve_cilium_identity_flow(cilium_node_01, cilium_node_02)
}
