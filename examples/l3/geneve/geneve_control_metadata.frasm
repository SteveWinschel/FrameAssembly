// GENEVE tunnel packet specifying option class and option type metadata.
// This capture carries VNI 12345.
// Wireshark: geneve && geneve.vni == 12345

host ovs_controller { ip 10.50.0.1 }

host ovs_dataplane { ip 10.50.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow geneve_opt_flow(src, dst) {
    src -> dst geneve vni 12345 optclass 264 opttype 1
}

// Run geneve_opt_flow(ovs_controller, ovs_dataplane) to generate the capture.
compile {
    geneve_opt_flow(ovs_controller, ovs_dataplane)
}
