// RFC 8926 Section 3.5 GENEVE TLV with Critical Option bit set (opttype >=
// 128) mandating drop if unrecognized.
// This capture sets DSCP 32, TTL 64, DF bit set, carries VNI 80128,
// destination port 6081, and uses post-packet wait gaps (3ms) between frames.
// Wireshark: geneve && geneve.vni == 80128

host zt_nve_ingress {
    ip 10.60.128.1
    mac 00:1c:73:60:80:01
}

host zt_nve_egress {
    ip 10.60.128.2
    mac 00:1c:73:60:80:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_critical_tlv_flow(ing, egr) {
    ing -> egr geneve vni 80128 optclass 258 opttype 128 protocoltype 25944 srcport 54001 dstport 6081 df dscp 32 ttl 64 payload "CRITICAL_OPT_SGT_TAG_MANDATORY" wait 3ms
    ing <- egr geneve vni 80128 optclass 258 opttype 128 protocoltype 25944 srcport 54002 dstport 6081 df dscp 32 ttl 64 payload "CRITICAL_OPT_VERIFIED_ACK"
}

// Run geneve_critical_tlv_flow(zt_nve_ingress, zt_nve_egress) to generate the
// capture.
compile {
    geneve_critical_tlv_flow(zt_nve_ingress, zt_nve_egress)
}
