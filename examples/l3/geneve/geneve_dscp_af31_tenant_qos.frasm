// Multi-tenant GENEVE overlay preserving outer DSCP AF31 (26) and ECN
// markings.
// This capture sets DSCP 26, TTL 64, carries VNI 30010, and uses post-packet
// wait gaps (10ms) between frames.
// Wireshark: geneve && geneve.vni == 30010

host tenant_gold_hyp_a { ip 10.180.10.1 }

host tenant_gold_hyp_b { ip 10.180.10.2 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_tenant_qos(a, b) {
    a -> b geneve vni 30010 optclass 258 opttype 20 dscp 26 ecn 2 ttl 64 wait 10ms
    a <- b geneve vni 30010 optclass 258 opttype 20 dscp 26 ecn 2 ttl 64
}

// Run geneve_tenant_qos(tenant_gold_hyp_a, tenant_gold_hyp_b) to generate the
// capture.
compile {
    geneve_tenant_qos(tenant_gold_hyp_a, tenant_gold_hyp_b)
}
