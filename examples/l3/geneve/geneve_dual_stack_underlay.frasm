// GENEVE network virtualization tunnel established over IPv6 transport
// endpoints.
// This capture targets IPv6 endpoints and carries VNI 50000.
// Wireshark: geneve && geneve.vni == 50000 && ipv6

host geneve_v6_a { ip 2001:db8:9000::1 }

host geneve_v6_b { ip 2001:db8:9000::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow geneve_v6_flow(a, b) {
    a -> b geneve vni 50000
}

// Run geneve_v6_flow(geneve_v6_a, geneve_v6_b) to generate the capture.
compile {
    geneve_v6_flow(geneve_v6_a, geneve_v6_b)
}
