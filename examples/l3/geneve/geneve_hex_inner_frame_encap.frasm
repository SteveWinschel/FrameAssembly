// GENEVE tunnel encapsulating a raw hex-encoded inner Ethernet frame with
// custom MACs.
// This capture carries VNI 65535.
// Wireshark: geneve && geneve.vni == 65535

host bm_geneve_gw { ip 10.70.70.1 }

host vm_geneve_gw { ip 10.70.70.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow geneve_hex_inner_flow(bm, vm) {
    bm -> vm geneve vni 65535 optclass 258 opttype 129 protocoltype 0x6558 srcmac 00:16:3e:aa:bb:01 dstmac 00:16:3e:aa:bb:02 hexpayload "ffffffffffff00163e00000108060001"
}

// Run geneve_hex_inner_flow(bm_geneve_gw, vm_geneve_gw) to generate the
// capture.
compile {
    geneve_hex_inner_flow(bm_geneve_gw, vm_geneve_gw)
}
