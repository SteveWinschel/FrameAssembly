// IPv6 underlay RFC 8926 GENEVE tunnel carrying Cilium metadata TLVs with
// IPv6 Flow Label ECMP entropy.
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 64, IPv6 Flow Label,
// carries VNI 6001, destination port 6081, and uses post-packet wait gaps
// (3ms) between frames.
// Wireshark: geneve && geneve.vni == 6001 && ipv6

host v6_cilium_node_a {
    ip 2001:db8:6081:1::10
    mac 00:16:3e:66:81:0a
}

host v6_cilium_node_b {
    ip 2001:db8:6081:2::20
    mac 00:16:3e:66:81:14
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_v6_cilium_flow(a, b) {
    a -> b geneve vni 6001 optclass 267 opttype 1 protocoltype 34525 srcport 56081 dstport 6081 flowlabel 60810 dscp 34 ttl 64 payload "IPV6_POD_TO_POD_CILIUM_GENEVE" wait 3ms
    a <- b geneve vni 6001 optclass 267 opttype 1 protocoltype 34525 srcport 56082 dstport 6081 flowlabel 60810 dscp 34 ttl 64 payload "IPV6_POD_TO_POD_CILIUM_REPLY"
}

// Run geneve_v6_cilium_flow(v6_cilium_node_a, v6_cilium_node_b) to generate
// the capture.
compile {
    geneve_v6_cilium_flow(v6_cilium_node_a, v6_cilium_node_b)
}
