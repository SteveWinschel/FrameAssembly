// PROMPT: RFC 8926 GENEVE tunnel keepalive health probes executed inside a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, s, geneve, vni, optclass, opttype, wait, ms, compile

// INSTRUCTION: Define primary network virtualization edge.
host primary_nve_node { ip 10.111.1.1 }

// INSTRUCTION: Define standby network virtualization edge.
host standby_nve_node { ip 10.111.1.2 }

// INSTRUCTION: Define bidirectional GENEVE tunnel health probe.
flow geneve_health_probe(p, s) {
    p -> s geneve vni 1000 optclass 258 opttype 254 wait 15ms
    p <- s geneve vni 1000 optclass 258 opttype 254 wait 15ms
}

// INSTRUCTION: Compile 4 iterations of the GENEVE tunnel health probe.
compile {
    geneve_health_probe(primary_nve_node, standby_nve_node) // cycle 1
    geneve_health_probe(primary_nve_node, standby_nve_node) // cycle 2
    geneve_health_probe(primary_nve_node, standby_nve_node) // cycle 3
    geneve_health_probe(primary_nve_node, standby_nve_node) // cycle 4
}
