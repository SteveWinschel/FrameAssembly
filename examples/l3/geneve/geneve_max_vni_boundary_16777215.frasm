// RFC 8926 GENEVE boundary validation testing the maximum 24-bit Virtual
// Network Identifier (VNI 16777215 = 0xFFFFFF).
// This capture sets TTL 64, DF bit set, carries VNI 1/16777215, destination
// port 6081, and uses post-packet wait gaps (2ms) between frames.
// Wireshark: geneve

host max_vni_nve_src {
    ip 10.60.255.1
    mac 00:25:90:ff:ff:01
}

host max_vni_nve_dst {
    ip 10.60.255.2
    mac 00:25:90:ff:ff:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow geneve_vni_boundary_flow(src, dst) {
    src -> dst geneve vni 16777215 optclass 258 opttype 1 protocoltype 25944 srcport 60001 dstport 6081 df ttl 64 payload "GENEVE_MAX_24BIT_VNI_0XFFFFFF" wait 2ms
    src <- dst geneve vni 1 optclass 258 opttype 1 protocoltype 25944 srcport 60002 dstport 6081 df ttl 64 payload "GENEVE_MIN_TENANT_VNI_0X000001"
}

// Run geneve_vni_boundary_flow(max_vni_nve_src, max_vni_nve_dst) to generate
// the capture.
compile {
    geneve_vni_boundary_flow(max_vni_nve_src, max_vni_nve_dst)
}
