// PROMPT: Multi-Pod Data Center Interconnect (DCI) Border Gateways stitching GENEVE VNI 20001 to VNI 30001 across a WAN core.
// TOKENS: host, ip, mac, flow, geneve, vni, optclass, opttype, vlan, mpls, exp, bos, mplsttl, srcport, dstport, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Pod-1 Border Gateway NVE translating local VNI to DCI VNI.
host pod1_dci_bgw {
    ip 172.30.60.1
    mac 00:1c:73:d1:60:01
}

// INSTRUCTION: Define Pod-2 Border Gateway NVE receiving stitched GENEVE overlay traffic.
host pod2_dci_bgw {
    ip 172.30.60.2
    mac 00:1c:73:d2:60:02
}

// INSTRUCTION: Define DCI GENEVE tunnel stitch with MPLS core label 60810 and VLAN 300 handoff.
flow geneve_dci_vni_stitch(bgw1, bgw2) {
    bgw1 -> bgw2 geneve vni 20001 optclass 258 opttype 1 vlan 300 mpls 60810 exp 5 bos 1 mplsttl 60 srcport 52001 dstport 6081 df dscp 40 ttl 60 payload "DCI_POD1_2" wait 5ms
    bgw1 <- bgw2 geneve vni 30001 optclass 258 opttype 1 vlan 300 mpls 60820 exp 5 bos 1 mplsttl 60 srcport 53001 dstport 6081 df dscp 40 ttl 60 payload "DCI_POD2_1"
}

// INSTRUCTION: Compile the Multi-Pod DCI GENEVE border gateway stitching flow.
compile {
    geneve_dci_vni_stitch(pod1_dci_bgw, pod2_dci_bgw)
}
