// PROMPT: Open Virtual Network (OVN) hypervisor chassis exchanging GENEVE frames with Option Class 0x0102 (258) logical port keys.
// TOKENS: host, ip, mac, flow, geneve, vni, optclass, opttype, protocoltype, srcport, dstport, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define OVN hypervisor chassis hv-compute-01 hosting logical switch port.
host ovn_hv_compute_01 {
    ip 10.168.60.101
    mac 52:54:00:60:01:01
}

// INSTRUCTION: Define OVN gateway chassis hv-gw-01 hosting distributed logical router port.
host ovn_hv_gw_01 {
    ip 10.168.60.201
    mac 52:54:00:60:02:01
}

// INSTRUCTION: Define OVN GENEVE packet with VNI 15 (datapath tunnel key) and OPT_CLASS 258 (0x0102 OVN).
flow geneve_ovn_logical_router_flow(hv1, gw1) {
    hv1 -> gw1 geneve vni 15 optclass 258 opttype 128 protocoltype 25944 srcport 58101 dstport 6081 df ttl 64 payload "OVN_INGRESS_PORT_KEY_3_EGRESS_PORT_KEY_7" wait 3ms
    hv1 <- gw1 geneve vni 15 optclass 258 opttype 128 protocoltype 25944 srcport 58201 dstport 6081 df ttl 64 payload "OVN_INGRESS_PORT_KEY_7_EGRESS_PORT_KEY_3"
}

// INSTRUCTION: Compile the OVN logical router GENEVE datapath flow.
compile {
    geneve_ovn_logical_router_flow(ovn_hv_compute_01, ovn_hv_gw_01)
}
