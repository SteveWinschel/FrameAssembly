// OVN/OpenStack GENEVE tunnel carrying Open vSwitch TLV option class 0x0102
// and security metadata.
// This capture carries VNI 10042.
// Wireshark: geneve && geneve.vni == 10042

host ovn_chassis_01 { ip 10.120.1.11 mac 52:54:00:12:01:11 }

host ovn_chassis_02 { ip 10.120.1.12 mac 52:54:00:12:01:12 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow geneve_ovn_metadata(c1, c2) {
    c1 -> c2 geneve vni 10042 optclass 258 opttype 128 protocoltype 0x6558 payload "OVN_INGRESS_OUTPORT_META"
    c1 <- c2 geneve vni 10042 optclass 258 opttype 128 protocoltype 0x6558 payload "OVN_EGRESS_ACK_META"
}

// Run geneve_ovn_metadata(ovn_chassis_01, ovn_chassis_02) to generate the
// capture.
compile {
    geneve_ovn_metadata(ovn_chassis_01, ovn_chassis_02)
}
