// Multi-datacenter GENEVE interconnect carried over an 802.1ad QinQ carrier
// link.
// This capture wraps frames in QinQ S-VLAN 3600 / C-VLAN 600 and carries VNI
// 120000.
// Wireshark: geneve && geneve.vni == 120000

host dc_west_nve { ip 172.30.60.1 }

host dc_east_nve { ip 172.30.60.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow geneve_qinq_dci(w, e) {
    w -> e geneve vni 120000 optclass 258 opttype 5 qinq 3600 innervlan 600
    w <- e geneve vni 120000 optclass 258 opttype 5 qinq 3600 innervlan 600
}

// Run geneve_qinq_dci(dc_west_nve, dc_east_nve) to generate the capture.
compile {
    geneve_qinq_dci(dc_west_nve, dc_east_nve)
}
