// Network virtualization overlay utilizing GENEVE tunneling protocol with
// VNI.
// This capture carries VNI 20000.
// Wireshark: geneve && geneve.vni == 20000

host geneve_gw1 { ip 192.168.20.1 }

host geneve_gw2 { ip 192.168.20.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow geneve_flow(g1, g2) {
    g1 -> g2 geneve vni 20000
}

// Run geneve_flow(geneve_gw1, geneve_gw2) to generate the capture.
compile {
    geneve_flow(geneve_gw1, geneve_gw2)
}
