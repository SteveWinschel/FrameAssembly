// PROMPT: Network virtualization overlay utilizing GENEVE tunneling protocol with VNI.
// TOKENS: host, ip, flow, geneve, vni, compile

// INSTRUCTION: Define GENEVE gateway hypervisor 1.
host geneve_gw1 { ip 192.168.20.1 }

// INSTRUCTION: Define GENEVE gateway hypervisor 2.
host geneve_gw2 { ip 192.168.20.2 }

// INSTRUCTION: Define GENEVE encapsulation flow with VNI 20000.
flow geneve_flow(g1, g2) {
    g1 -> g2 geneve vni 20000
}

// INSTRUCTION: Compile block executing GENEVE tunnel packet.
compile {
    geneve_flow(geneve_gw1, geneve_gw2)
}
