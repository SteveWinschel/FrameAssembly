// PROMPT: GENEVE Transparent Ethernet Bridging (0x6558) between Kubernetes CNI nodes.
// TOKENS: host, ip, flow, geneve, vni, protocoltype, payload, compile

// INSTRUCTION: Define Kubernetes worker node 1 running Antrea/Cilium CNI.
host k8s_cni_worker1 { ip 172.18.40.10 }

// INSTRUCTION: Define Kubernetes worker node 2 running Antrea/Cilium CNI.
host k8s_cni_worker2 { ip 172.18.40.20 }

// INSTRUCTION: Define GENEVE L2 bridging flow with Protocol Type 0x6558 (25944).
flow geneve_teb_cni_flow(w1, w2) {
    w1 -> w2 geneve vni 5001 protocoltype 0x6558 payload "POD_TO_POD_ETH_FRAME_REQ"
    w1 <- w2 geneve vni 5001 protocoltype 0x6558 payload "POD_TO_POD_ETH_FRAME_RSP"
}

// INSTRUCTION: Compile the GENEVE Transparent Ethernet Bridging flow.
compile {
    geneve_teb_cni_flow(k8s_cni_worker1, k8s_cni_worker2)
}
