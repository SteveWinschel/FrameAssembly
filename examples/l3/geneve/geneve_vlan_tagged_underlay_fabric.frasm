// GENEVE overlay tunnel traversing an 802.1Q VLAN-tagged leaf-spine underlay
// fabric.
// This capture wraps frames in 802.1Q VLAN 608 and carries VNI 40010.
// Wireshark: geneve && geneve.vni == 40010 && vlan.id == 608

host nve_rack_01 { ip 10.60.8.11 mac 00:25:90:60:08:11 }

host nve_rack_02 { ip 10.60.8.12 mac 00:25:90:60:08:12 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow geneve_vlan_underlay(r1, r2) {
    r1 -> r2 geneve vni 40010 optclass 257 opttype 10 vlan 608 pcp 4 dei 0
    r1 <- r2 geneve vni 40010 optclass 257 opttype 10 vlan 608 pcp 4 dei 0
}

// Run geneve_vlan_underlay(nve_rack_01, nve_rack_02) to generate the capture.
compile {
    geneve_vlan_underlay(nve_rack_01, nve_rack_02)
}
