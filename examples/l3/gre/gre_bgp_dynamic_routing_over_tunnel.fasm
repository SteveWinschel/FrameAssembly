// PROMPT: GRE point-to-point overlay tunnel carrying interior BGP / OSPF dynamic routing protocol updates with CS6 DSCP.
// TOKENS: HOST, IP, MAC, FLOW, GRE, GRE_KEY, GRE_SEQ, GRE_PROTO, CHECKSUM, DSCP, DF, TTL, PAYLOAD, WAIT, COMPILE

// INSTRUCTION: Define branch router running dynamic routing over a GRE tunnel interface.
HOST branch_gre_rtr {
    IP 198.18.47.11
    MAC 00:1d:71:47:11:01
}

// INSTRUCTION: Define regional hub router terminating the routed GRE tunnel interface.
HOST hub_gre_rtr {
    IP 198.18.47.1
    MAC 00:1d:71:47:01:01
}

// INSTRUCTION: Define sequenced GRE control plane exchange with DSCP CS6 (48) and CHECKSUM enabled.
FLOW gre_routed_overlay_flow(branch, hub) {
    branch -> hub GRE GRE_KEY 179 GRE_SEQ 1 GRE_PROTO 2048 CHECKSUM DSCP 48 DF TTL 64 PAYLOAD "INNER_BGP_UPDATE_PREFIX_10_11_0_0_16" WAIT 5ms
    branch <- hub GRE GRE_KEY 179 GRE_SEQ 1 GRE_PROTO 2048 CHECKSUM DSCP 48 DF TTL 64 PAYLOAD "INNER_BGP_UPDATE_DEFAULT_ROUTE_0_0_0_0"
}

// INSTRUCTION: Compile the dynamic routing over GRE tunnel flow.
COMPILE {
    gre_routed_overlay_flow(branch_gre_rtr, hub_gre_rtr)
}
