// GRE tunnel header asserting checksum verification flag and payload
// protocol.
// This capture encapsulates passenger traffic inside IP protocol 47 GRE
// headers.
// Wireshark: gre

host branch_gw { ip 10.100.0.1 }

host dc_gw { ip 10.100.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow gre_checksum_flow(src, dst) {
    src -> dst gre grekey 54321 checksum
}

// Run gre_checksum_flow(branch_gw, dc_gw) to generate the capture.
compile {
    gre_checksum_flow(branch_gw, dc_gw)
}
