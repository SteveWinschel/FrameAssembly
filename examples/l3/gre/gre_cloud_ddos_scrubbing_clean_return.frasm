// Cloud DDoS Scrubbing Center injecting sanitized customer traffic back to
// origin router over an RFC 2784 GRE clean-pipe tunnel.
// This capture sets DSCP 0/48, TTL 59/64, DF bit set and uses post-packet
// wait gaps (2ms) between frames.
// Wireshark: gre

host scrubbing_center_gre {
    ip 198.51.100.250
    mac 00:25:90:47:fa:01
}

host origin_cleanpipe_rtr {
    ip 203.0.113.100
    mac 00:25:90:47:64:02
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow gre_ddos_clean_pipe_flow(scrubber, origin) {
    scrubber -> origin gre grekey 91100 greseq 101 greproto 2048 checksum df dscp 0 ttl 59 payload "SCRUBBED_HTTPS_CLIENT_SYN_CLEAN" wait 2ms
    scrubber -> origin gre grekey 91100 greseq 102 greproto 2048 checksum df dscp 0 ttl 59 payload "SCRUBBED_HTTPS_CLIENT_ACK_CLEAN" wait 2ms
    scrubber <- origin gre grekey 91100 greseq 1 greproto 2048 checksum df dscp 48 ttl 64 payload "GRE_KEEPALIVE_ORIGIN_HEALTH_OK"
}

// Run gre_ddos_clean_pipe_flow(scrubbing_center_gre, origin_cleanpipe_rtr) to
// generate the capture.
compile {
    gre_ddos_clean_pipe_flow(scrubbing_center_gre, origin_cleanpipe_rtr)
}
