// RFC 2784 / RFC 2890 Multipoint GRE (mGRE) DMVPN tunnel with shared NHRP
// network grekey 10000 and sequence tracking.
// This capture sets DSCP 48, TTL 64, DF bit set and uses post-packet wait
// gaps (5ms) between frames.
// Wireshark: gre

host dmvpn_mgre_hub {
    ip 198.51.100.1
    mac 00:1e:13:47:00:01
}

host dmvpn_mgre_spoke {
    ip 203.0.113.55
    mac 00:1e:13:47:00:37
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_dmvpn_nhrp_flow(spoke, hub) {
    spoke -> hub gre grekey 10000 greseq 1 greproto 2048 checksum df dscp 48 ttl 64 payload "NHRP_RESOLUTION_REQ_SPOKE_TO_SPOKE" wait 5ms
    spoke <- hub gre grekey 10000 greseq 1 greproto 2048 checksum df dscp 48 ttl 64 payload "NHRP_RESOLUTION_REPLY_DIRECT_NBMA"
}

// Run gre_dmvpn_nhrp_flow(dmvpn_mgre_spoke, dmvpn_mgre_hub) to generate the
// capture.
compile {
    gre_dmvpn_nhrp_flow(dmvpn_mgre_spoke, dmvpn_mgre_hub)
}
