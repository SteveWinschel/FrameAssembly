// PROMPT: RFC 2784 GRE tunnel path MTU discovery enforcing IPv4 Don't Fragment (DF) on outer header.
// TOKENS: host, ip, flow, head, gre, grekey, greseq, ipid, df, payload, compile

// INSTRUCTION: Define GRE tunnel headend router.
host gre_mtu_head { ip 10.15.47.1 }

// INSTRUCTION: Define GRE tunnel tailend router.
host gre_mtu_tail { ip 10.15.47.2 }

// INSTRUCTION: Define DF-marked GRE tunnel packets with explicit IPID values.
flow gre_df_mtu_probe(head, tail) {
    head -> tail gre grekey 500 greseq 1 ipid 7001 df payload "GRE_PMTUD_1476_BYTE_CHECK"
    head <- tail gre grekey 500 greseq 1 ipid 7002 df payload "GRE_PMTUD_1476_BYTE_ACK"
}

// INSTRUCTION: Compile the GRE Don't Fragment MTU discovery flow.
compile {
    gre_df_mtu_probe(gre_mtu_head, gre_mtu_tail)
}
