// Broadcast video contribution GRE tunnel marked with outer DSCP CS4 (32) and
// ECN ECT(0).
// This capture sets DSCP 32, TTL 64 and uses post-packet wait gaps (8ms)
// between frames.
// Wireshark: gre

host video_ing_gre { ip 203.0.113.120 }

host studio_egr_gre { ip 203.0.113.121 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow gre_video_cs4_stream(ing, egr) {
    ing -> egr gre grekey 8080 greseq 1 greproto 0x0800 dscp 32 ecn 2 ttl 64 payload "MPEG_TS_SLICE_01" wait 8ms
    ing -> egr gre grekey 8080 greseq 2 greproto 0x0800 dscp 32 ecn 2 ttl 64 payload "MPEG_TS_SLICE_02" wait 8ms
    ing -> egr gre grekey 8080 greseq 3 greproto 0x0800 dscp 32 ecn 2 ttl 64 payload "MPEG_TS_SLICE_03"
}

// Run gre_video_cs4_stream(video_ing_gre, studio_egr_gre) to generate the
// capture.
compile {
    gre_video_cs4_stream(video_ing_gre, studio_egr_gre)
}
