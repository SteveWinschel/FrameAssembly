// Dual-stack GRE SD-WAN tunnel running identically over IPv4 and IPv6
// underlays.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs and
// sets DSCP 34, TTL 64, IPv6 Flow Label.
// Wireshark: gre

host sdwan_gre_v4_1 { ip 192.0.2.71 }

host sdwan_gre_v4_2 { ip 192.0.2.72 }

host sdwan_gre_v6_1 { ip 2001:db8:47::71 }

host sdwan_gre_v6_2 { ip 2001:db8:47::72 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow sdwan_dual_stack_gre(r1, r2) {
    r1 -> r2 gre grekey 7001 greseq 1 checksum dscp 34 ttl 64 flowlabel 47001
    r1 <- r2 gre grekey 7001 greseq 1 checksum dscp 34 ttl 64 flowlabel 47002
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    sdwan_dual_stack_gre(sdwan_gre_v4_1, sdwan_gre_v4_2)
    sdwan_dual_stack_gre(sdwan_gre_v6_1, sdwan_gre_v6_2)
}
