// PROMPT: RFC 6040 ECN propagation across a GRE tunnel copying inner ECN markings to the outer IPv4 header.
// TOKENS: host, ip, mac, flow, gre, grekey, greseq, greproto, dscp, ecn, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define GRE tunnel ingress copying inner ECT(0) (2) to outer IPv4 header.
host gre_ecn_ing {
    ip 10.60.47.1
    mac 00:22:bd:60:47:01
}

// INSTRUCTION: Define GRE tunnel egress decapsulating congestion-marked ECN CE (3) packet.
host gre_ecn_egr {
    ip 10.60.47.2
    mac 00:22:bd:60:47:02
}

// INSTRUCTION: Define GRE packets transitioning from ECN 2 (ECT0) to ECN 3 (CE) with DSCP AF21 (18).
flow gre_ecn_propagation_flow(ing, egr) {
    ing -> egr gre grekey 6040 greseq 1 greproto 2048 dscp 18 ecn 2 df ttl 64 payload "GRE_PASSENGER_TCP_ECT0" wait 3ms
    ing -> egr gre grekey 6040 greseq 2 greproto 2048 dscp 18 ecn 3 df ttl 64 payload "GRE_PASSENGER_TCP_CE_EXPERIENCED" wait 3ms
    ing <- egr gre grekey 6040 greseq 1 greproto 2048 dscp 18 ecn 2 df ttl 64 payload "GRE_PASSENGER_TCP_ECE_ACK"
}

// INSTRUCTION: Compile the RFC 6040 ECN propagation over GRE tunnel flow.
compile {
    gre_ecn_propagation_flow(gre_ecn_ing, gre_ecn_egr)
}
