// Cisco ERSPAN Type II remote port mirroring using GRE protocol type 0x88BE
// and greseq sequence numbers.
// This capture uses post-packet wait gaps (5ms) between frames.
// Wireshark: gre

host erspan_source_sw { ip 172.20.99.1 }

host erspan_collector_npb { ip 172.20.99.100 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow erspan_mirror_stream(sw, npb) {
    sw -> npb gre greseq 1001 greproto 0x88BE payload "MIRRORED_FRAME_SPAN_SESSION_1" wait 5ms
    sw -> npb gre greseq 1002 greproto 0x88BE payload "MIRRORED_FRAME_SPAN_SESSION_2" wait 5ms
    sw -> npb gre greseq 1003 greproto 0x88BE payload "MIRRORED_FRAME_SPAN_SESSION_3"
}

// Run erspan_mirror_stream(erspan_source_sw, erspan_collector_npb) to
// generate the capture.
compile {
    erspan_mirror_stream(erspan_source_sw, erspan_collector_npb)
}
