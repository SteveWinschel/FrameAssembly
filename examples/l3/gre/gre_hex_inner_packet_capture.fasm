// PROMPT: GRE tunnel encapsulating a raw binary inner IPv4 packet via HEXPAYLOAD and explicit MACs.
// TOKENS: host, ip, flow, gre, grekey, greseq, greproto, srcmac, dstmac, hexpayload, compile

// INSTRUCTION: Define security scrubbing center ingress router.
host scrub_ingress_gre { ip 198.51.100.240 }

// INSTRUCTION: Define clean-pipe customer return router.
host customer_clean_gre { ip 198.51.100.241 }

// INSTRUCTION: Define GRE clean-pipe return packet carrying raw hex inner IPv4 datagram.
flow gre_clean_pipe_hex(scrub, cust) {
    scrub -> cust gre grekey 91100 greseq 42 greproto 0x0800 srcmac 00:00:5e:00:53:10 dstmac 00:00:5e:00:53:20 hexpayload "4500001c0001000040017cce0a0000010a000002"
}

// INSTRUCTION: Compile the GRE hex inner packet flow.
compile {
    gre_clean_pipe_hex(scrub_ingress_gre, customer_clean_gre)
}
