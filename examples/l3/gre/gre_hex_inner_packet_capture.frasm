// GRE tunnel encapsulating a raw binary inner IPv4 packet via HEXPAYLOAD and
// explicit MACs.
// This capture encapsulates passenger traffic inside IP protocol 47 GRE
// headers.
// Wireshark: gre

host scrub_ingress_gre { ip 198.51.100.240 }

host customer_clean_gre { ip 198.51.100.241 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow gre_clean_pipe_hex(scrub, cust) {
    scrub -> cust gre grekey 91100 greseq 42 greproto 0x0800 srcmac 00:00:5e:00:53:10 dstmac 00:00:5e:00:53:20 hexpayload "4500001c0001000040017cce0a0000010a000002"
}

// Run gre_clean_pipe_hex(scrub_ingress_gre, customer_clean_gre) to generate
// the capture.
compile {
    gre_clean_pipe_hex(scrub_ingress_gre, customer_clean_gre)
}
