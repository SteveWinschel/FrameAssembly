// PROMPT: RFC 7676 IPv4-in-IPv6 GRE tunnel transporting legacy IPv4 subnets (GRE_PROTO 0x0800 = 2048) across an IPv6-only core.
// TOKENS: host, ip, mac, flow, gre, grekey, greseq, greproto, flowlabel, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define IPv6-only core PE router A encapsulating customer IPv4 traffic in GRE.
host v6_core_gre_pe1 {
    ip 2001:db8:47:1::1
    mac 00:25:90:47:01:01
}

// INSTRUCTION: Define IPv6-only core PE router B decapsulating GRE_PROTO 2048 (0x0800 IPv4).
host v6_core_gre_pe2 {
    ip 2001:db8:47:2::1
    mac 00:25:90:47:02:02
}

// INSTRUCTION: Define IPv6 GRE flow with FLOWLABEL 47800, GRE_KEY 4004, and GRE_PROTO 2048 (IPv4).
flow gre_ipv4_over_ipv6_core(pe1, pe2) {
    pe1 -> pe2 gre grekey 4004 greseq 100 greproto 2048 flowlabel 47800 dscp 34 ttl 64 payload "INNER_IPV4_10_1_1_1_TO_10_2_2_2" wait 4ms
    pe1 <- pe2 gre grekey 4004 greseq 101 greproto 2048 flowlabel 47800 dscp 34 ttl 64 payload "INNER_IPV4_10_2_2_2_TO_10_1_1_1"
}

// INSTRUCTION: Compile the RFC 7676 IPv4-over-IPv6 GRE tunnel flow.
compile {
    gre_ipv4_over_ipv6_core(v6_core_gre_pe1, v6_core_gre_pe2)
}
