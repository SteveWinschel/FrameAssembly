// RFC 7676 IPv4-in-IPv6 GRE tunnel transporting legacy IPv4 subnets (GRE
// protocol type 0x0800 = 2048) across an IPv6-only core.
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 64, IPv6 Flow Label,
// and uses post-packet wait gaps (4ms) between frames.
// Wireshark: gre && ipv6

host v6_core_gre_pe1 {
    ip 2001:db8:47:1::1
    mac 00:25:90:47:01:01
}

host v6_core_gre_pe2 {
    ip 2001:db8:47:2::1
    mac 00:25:90:47:02:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_ipv4_over_ipv6_core(pe1, pe2) {
    pe1 -> pe2 gre grekey 4004 greseq 100 greproto 2048 flowlabel 47800 dscp 34 ttl 64 payload "INNER_IPV4_10_1_1_1_TO_10_2_2_2" wait 4ms
    pe1 <- pe2 gre grekey 4004 greseq 101 greproto 2048 flowlabel 47800 dscp 34 ttl 64 payload "INNER_IPV4_10_2_2_2_TO_10_1_1_1"
}

// Run gre_ipv4_over_ipv6_core(v6_core_gre_pe1, v6_core_gre_pe2) to generate
// the capture.
compile {
    gre_ipv4_over_ipv6_core(v6_core_gre_pe1, v6_core_gre_pe2)
}
