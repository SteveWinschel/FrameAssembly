// PROMPT: RFC 2784 6-in-4 GRE tunnel transporting inner IPv6 packets (GRE_PROTO 0x86DD = 34525) across an IPv4 underlay.
// TOKENS: host, ip, mac, flow, gre, grekey, greseq, greproto, checksum, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define dual-stack border router A encapsulating IPv6 islands over IPv4 GRE.
host gre_6in4_rtr_a {
    ip 172.16.47.10
    mac 00:1b:21:47:10:01
}

// INSTRUCTION: Define dual-stack border router B decapsulating GRE Protocol Type 0x86DD (34525).
host gre_6in4_rtr_b {
    ip 172.16.47.20
    mac 00:1b:21:47:20:02
}

// INSTRUCTION: Define GRE tunnel with GRE_PROTO 34525 (0x86DD IPv6) and sequence numbers.
flow gre_ipv6_over_ipv4_flow(a, b) {
    a -> b gre grekey 8600 greseq 1 greproto 34525 checksum df dscp 26 ttl 64 payload "INNER_IPV6_2001_DB8_1_TO_2001_DB8_2" wait 5ms
    a <- b gre grekey 8600 greseq 2 greproto 34525 checksum df dscp 26 ttl 64 payload "INNER_IPV6_2001_DB8_2_TO_2001_DB8_1"
}

// INSTRUCTION: Compile the IPv6-over-IPv4 GRE tunnel (GRE_PROTO 0x86DD) flow.
compile {
    gre_ipv6_over_ipv4_flow(gre_6in4_rtr_a, gre_6in4_rtr_b)
}
