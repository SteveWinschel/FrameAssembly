// RFC 2784 6-in-4 GRE tunnel transporting inner IPv6 packets (GRE protocol
// type 0x86DD = 34525) across an IPv4 underlay.
// This capture sets DSCP 26, TTL 64, DF bit set and uses post-packet wait
// gaps (5ms) between frames.
// Wireshark: gre

host gre_6in4_rtr_a {
    ip 172.16.47.10
    mac 00:1b:21:47:10:01
}

host gre_6in4_rtr_b {
    ip 172.16.47.20
    mac 00:1b:21:47:20:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_ipv6_over_ipv4_flow(a, b) {
    a -> b gre grekey 8600 greseq 1 greproto 34525 checksum df dscp 26 ttl 64 payload "INNER_IPV6_2001_DB8_1_TO_2001_DB8_2" wait 5ms
    a <- b gre grekey 8600 greseq 2 greproto 34525 checksum df dscp 26 ttl 64 payload "INNER_IPV6_2001_DB8_2_TO_2001_DB8_1"
}

// Run gre_ipv6_over_ipv4_flow(gre_6in4_rtr_a, gre_6in4_rtr_b) to generate the
// capture.
compile {
    gre_ipv6_over_ipv4_flow(gre_6in4_rtr_a, gre_6in4_rtr_b)
}
