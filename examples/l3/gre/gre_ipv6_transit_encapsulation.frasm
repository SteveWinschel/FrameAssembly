// GRE tunnel established across IPv6 transport endpoints carrying
// encapsulated data.
// This capture targets IPv6 endpoints.
// Wireshark: gre && ipv6

host gre_v6_rtr_a { ip 2001:db8:ee::1 }

host gre_v6_rtr_b { ip 2001:db8:ee::2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow gre_v6_flow(r1, r2) {
    r1 -> r2 gre grekey 99001 greseq 100
    r1 -> r2 gre grekey 99001 greseq 101
}

// Run gre_v6_flow(gre_v6_rtr_a, gre_v6_rtr_b) to generate the capture.
compile {
    gre_v6_flow(gre_v6_rtr_a, gre_v6_rtr_b)
}
