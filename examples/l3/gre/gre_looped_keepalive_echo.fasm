// PROMPT: Periodic GRE tunnel keepalive probes executed inside a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, s, gre, grekey, greseq, checksum, wait, ms, compile

// INSTRUCTION: Define primary WAN GRE endpoint.
host gre_ka_primary { ip 10.210.1.1 }

// INSTRUCTION: Define secondary WAN GRE endpoint.
host gre_ka_secondary { ip 10.210.1.2 }

// INSTRUCTION: Define bidirectional GRE keepalive exchange with 25ms delay.
flow gre_keepalive_cycle(p, s) {
    p -> s gre grekey 1010 greseq 1 checksum wait 25ms
    p <- s gre grekey 1010 greseq 1 checksum wait 25ms
}

// INSTRUCTION: Compile 4 iterations of the GRE keepalive probe cycle.
compile {
    gre_keepalive_cycle(gre_ka_primary, gre_ka_secondary) // cycle 1
    gre_keepalive_cycle(gre_ka_primary, gre_ka_secondary) // cycle 2
    gre_keepalive_cycle(gre_ka_primary, gre_ka_secondary) // cycle 3
    gre_keepalive_cycle(gre_ka_primary, gre_ka_secondary) // cycle 4
}
