// Minimal 4-byte RFC 2784 GRE header (Flags 0x0000, Protocol 0x0800) without
// Checksum, Key, or Sequence fields.
// This capture sets TTL 64, DF bit set and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: gre

host min_gre_rtr_a {
    ip 10.27.84.1
    mac 00:0c:29:27:84:01
}

host min_gre_rtr_b {
    ip 10.27.84.2
    mac 00:0c:29:27:84:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_minimal_4byte_flow(a, b) {
    a -> b gre greproto 2048 df ttl 64 payload "RFC2784_MINIMAL_4BYTE_GRE_HEADER_PACKET_1" wait 5ms
    a <- b gre greproto 2048 df ttl 64 payload "RFC2784_MINIMAL_4BYTE_GRE_HEADER_PACKET_2"
}

// Run gre_minimal_4byte_flow(min_gre_rtr_a, min_gre_rtr_b) to generate the
// capture.
compile {
    gre_minimal_4byte_flow(min_gre_rtr_a, min_gre_rtr_b)
}
