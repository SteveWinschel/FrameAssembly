// PROMPT: Minimal 4-byte RFC 2784 GRE header (Flags 0x0000, Protocol 0x0800) without Checksum, Key, or Sequence fields.
// TOKENS: host, ip, mac, flow, gre, greproto, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define legacy core router A using minimal 4-byte RFC 2784 GRE encapsulation.
host min_gre_rtr_a {
    ip 10.27.84.1
    mac 00:0c:29:27:84:01
}

// INSTRUCTION: Define legacy core router B decapsulating minimal 4-byte GRE headers.
host min_gre_rtr_b {
    ip 10.27.84.2
    mac 00:0c:29:27:84:02
}

// INSTRUCTION: Define minimal 4-byte GRE exchange with GRE_PROTO 2048 (0x0800) and no optional words.
flow gre_minimal_4byte_flow(a, b) {
    a -> b gre greproto 2048 df ttl 64 payload "RFC2784_MINIMAL_4BYTE_GRE_HEADER_PACKET_1" wait 5ms
    a <- b gre greproto 2048 df ttl 64 payload "RFC2784_MINIMAL_4BYTE_GRE_HEADER_PACKET_2"
}

// INSTRUCTION: Compile the minimal 4-byte RFC 2784 GRE header flow.
compile {
    gre_minimal_4byte_flow(min_gre_rtr_a, min_gre_rtr_b)
}
