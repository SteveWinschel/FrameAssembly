// RFC 4023 MPLS-in-GRE encapsulation (GRE protocol type 0x8847 = 34887)
// carrying L3VPN traffic over an IPv6 core.
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 64, IPv6 Flow Label,
// and uses post-packet wait gaps (4ms) between frames.
// Wireshark: gre && ipv6

host pe_north_mpls_gre {
    ip 2001:db8:4023::1
    mac 00:24:38:40:23:01
}

host pe_south_mpls_gre {
    ip 2001:db8:4023::2
    mac 00:24:38:40:23:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_rfc4023_v6_mpls(north, south) {
    north -> south gre grekey 40230 greseq 1 greproto 34887 flowlabel 40230 dscp 34 ttl 64 hexpayload "0004e1404500001c000100004001" wait 4ms
    north <- south gre grekey 40230 greseq 1 greproto 34887 flowlabel 40230 dscp 34 ttl 64 hexpayload "0004e2404500001c000200004001"
}

// Run gre_rfc4023_v6_mpls(pe_north_mpls_gre, pe_south_mpls_gre) to generate
// the capture.
compile {
    gre_rfc4023_v6_mpls(pe_north_mpls_gre, pe_south_mpls_gre)
}
