// PROMPT: RFC 4023 MPLS-in-GRE encapsulation using GRE_PROTO 0x8847 across an IP transit network.
// TOKENS: host, ip, flow, gre, grekey, greproto, checksum, payload, compile

// INSTRUCTION: Define autonomous system border router West.
host asbr_mpls_gre_w { ip 198.51.100.151 }

// INSTRUCTION: Define autonomous system border router East.
host asbr_mpls_gre_e { ip 198.51.100.152 }

// INSTRUCTION: Define MPLS-in-GRE tunnel specifying EtherType 0x8847 (MPLS Unicast).
flow mpls_in_gre_flow(w, e) {
    w -> e gre grekey 4023 greproto 0x8847 checksum payload "MPLS_VPN_LABEL_STACK_FWD"
    w <- e gre grekey 4023 greproto 0x8847 checksum payload "MPLS_VPN_LABEL_STACK_REV"
}

// INSTRUCTION: Compile the RFC 4023 MPLS-over-GRE encapsulation flow.
compile {
    mpls_in_gre_flow(asbr_mpls_gre_w, asbr_mpls_gre_e)
}
