// RFC 4023 MPLS-in-GRE encapsulation using GRE protocol type 0x8847 across an
// IP transit network.
// This capture encapsulates passenger traffic inside IP protocol 47 GRE
// headers.
// Wireshark: gre

host asbr_mpls_gre_w { ip 198.51.100.151 }

host asbr_mpls_gre_e { ip 198.51.100.152 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow mpls_in_gre_flow(w, e) {
    w -> e gre grekey 4023 greproto 0x8847 checksum payload "MPLS_VPN_LABEL_STACK_FWD"
    w <- e gre grekey 4023 greproto 0x8847 checksum payload "MPLS_VPN_LABEL_STACK_REV"
}

// Run mpls_in_gre_flow(asbr_mpls_gre_w, asbr_mpls_gre_e) to generate the
// capture.
compile {
    mpls_in_gre_flow(asbr_mpls_gre_w, asbr_mpls_gre_e)
}
