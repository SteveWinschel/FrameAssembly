// GRE point-to-point tunnel transported over an MPLS-labeled core underlay.
// This capture wraps frames in MPLS label 47100/47200.
// Wireshark: gre && mpls

host ce_west_gre { ip 10.249.1.1 }

host ce_east_gre { ip 10.249.2.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow gre_over_mpls_core(w, e) {
    w -> e gre grekey 1234 greseq 5 mpls 47100 exp 2 bos 1 mplsttl 62
    w <- e gre grekey 1234 greseq 5 mpls 47200 exp 2 bos 1 mplsttl 62
}

// Run gre_over_mpls_core(ce_west_gre, ce_east_gre) to generate the capture.
compile {
    gre_over_mpls_core(ce_west_gre, ce_east_gre)
}
