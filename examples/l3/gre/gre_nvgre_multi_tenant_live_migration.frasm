// PROMPT: RFC 7637 NVGRE hypervisor virtual switch migrating a Virtual Machine across Tenant Network VSID 500100.
// TOKENS: host, ip, mac, flow, gre, grekey, greproto, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Hyper-V / SDN source host NVE transmitting NVGRE frames with 24-bit VSID in GRE_KEY.
host nvgre_src_hypervisor {
    ip 10.76.37.11
    mac 00:15:5d:76:37:0b
}

// INSTRUCTION: Define destination Hyper-V host NVE receiving live-migrated tenant frames on VSID 500100.
host nvgre_dst_hypervisor {
    ip 10.76.37.22
    mac 00:15:5d:76:37:16
}

// INSTRUCTION: Define RFC 7637 NVGRE flow with GRE_PROTO 25944 (0x6558 TEB) and GRE_KEY 500100.
flow gre_nvgre_vm_migration(src_hv, dst_hv) {
    src_hv -> dst_hv gre grekey 500100 greproto 25944 df dscp 26 ttl 64 payload "NVGRE_VSID_500100_RARP_VM_MAC_MOVE" wait 3ms
    src_hv <- dst_hv gre grekey 500100 greproto 25944 df dscp 26 ttl 64 payload "NVGRE_VSID_500100_TENANT_FDB_UPDATED"
}

// INSTRUCTION: Compile the RFC 7637 NVGRE VM live migration flow.
compile {
    gre_nvgre_vm_migration(nvgre_src_hypervisor, nvgre_dst_hypervisor)
}
