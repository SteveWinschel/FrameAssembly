// PROMPT: RFC 7637 NVGRE Layer 2 virtualization using GRE_KEY for 24-bit VSID and GRE_PROTO 0x6558.
// TOKENS: host, ip, mac, flow, gre, grekey, greproto, payload, compile

// INSTRUCTION: Define Hyper-V virtualization host 1.
host nvgre_host_01 { ip 10.130.10.11 mac 00:15:5d:10:01:01 }

// INSTRUCTION: Define Hyper-V virtualization host 2.
host nvgre_host_02 { ip 10.130.10.12 mac 00:15:5d:10:01:02 }

// INSTRUCTION: Define NVGRE tunnel with GRE_PROTO 0x6558 (Transparent Ethernet Bridging) and GRE_KEY.
flow nvgre_l2_bridge(h1, h2) {
    h1 -> h2 gre grekey 16777200 greproto 0x6558 payload "NVGRE_VM_ETH_FRAME_OUT"
    h1 <- h2 gre grekey 16777200 greproto 0x6558 payload "NVGRE_VM_ETH_FRAME_IN"
}

// INSTRUCTION: Compile the NVGRE virtual subnet encapsulation flow.
compile {
    nvgre_l2_bridge(nvgre_host_01, nvgre_host_02)
}
