// Unicast GRE tunnel transporting PIM-SM and IPv4 multicast streams across a
// non-multicast-enabled ISP WAN.
// This capture sets DSCP 34/48, TTL 60 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: gre

host mcast_gre_headend {
    ip 192.0.2.47
    mac 00:19:e8:47:00:2f
}

host mcast_gre_tailend {
    ip 198.51.100.47
    mac 00:19:e8:47:64:2f
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_multicast_transit_flow(head, tail) {
    head -> tail gre grekey 2391 greseq 1 greproto 2048 dscp 34 ttl 60 payload "INNER_PIM_HELLO_AND_MCAST_GROUP_239_1_1_1" wait 5ms
    head <- tail gre grekey 2391 greseq 1 greproto 2048 dscp 48 ttl 60 payload "INNER_PIM_JOIN_S_G_239_1_1_1"
}

// Run gre_multicast_transit_flow(mcast_gre_headend, mcast_gre_tailend) to
// generate the capture.
compile {
    gre_multicast_transit_flow(mcast_gre_headend, mcast_gre_tailend)
}
