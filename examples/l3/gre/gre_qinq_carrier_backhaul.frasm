// 802.1ad QinQ double-tagged GRE backhaul tunnel across a carrier wholesale
// network.
// This capture wraps frames in QinQ S-VLAN 2400 / C-VLAN 47.
// Wireshark: gre

host cell_bBU_gre { ip 172.24.47.1 }

host epc_core_gre { ip 172.24.47.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow gre_qinq_backhaul(cell, epc) {
    cell -> epc gre grekey 9900 greseq 1 checksum qinq 2400 innervlan 47
    cell <- epc gre grekey 9900 greseq 1 checksum qinq 2400 innervlan 47
}

// Run gre_qinq_backhaul(cell_bBU_gre, epc_core_gre) to generate the capture.
compile {
    gre_qinq_backhaul(cell_bBU_gre, epc_core_gre)
}
