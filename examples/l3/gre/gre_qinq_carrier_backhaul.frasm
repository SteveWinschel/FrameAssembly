// PROMPT: 802.1ad QinQ double-tagged GRE backhaul tunnel across a carrier wholesale network.
// TOKENS: host, ip, flow, gre, grekey, greseq, checksum, qinq, innervlan, compile

// INSTRUCTION: Define cell site backhaul router.
host cell_bBU_gre { ip 172.24.47.1 }

// INSTRUCTION: Define mobile packet core gateway.
host epc_core_gre { ip 172.24.47.2 }

// INSTRUCTION: Define QinQ double-tagged GRE tunnel with S-VLAN 2400 and C-VLAN 47.
flow gre_qinq_backhaul(cell, epc) {
    cell -> epc gre grekey 9900 greseq 1 checksum qinq 2400 innervlan 47
    cell <- epc gre grekey 9900 greseq 1 checksum qinq 2400 innervlan 47
}

// INSTRUCTION: Compile the QinQ carrier backhaul GRE flow.
compile {
    gre_qinq_backhaul(cell_bBU_gre, epc_core_gre)
}
