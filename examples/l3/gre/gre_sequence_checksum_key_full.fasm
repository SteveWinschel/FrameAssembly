// PROMPT: RFC 2890 full-featured GRE header combining Checksum, Key, Sequence, and Protocol Type overrides.
// TOKENS: host, ip, flow, gre, grekey, greseq, greproto, checksum, payload, compile

// INSTRUCTION: Define enterprise core router A.
host gre_full_rtr_a { ip 172.16.47.10 }

// INSTRUCTION: Define enterprise core router B.
host gre_full_rtr_b { ip 172.16.47.20 }

// INSTRUCTION: Define bidirectional GRE exchange enabling all RFC 2890 optional header words.
flow gre_rfc2890_full(a, b) {
    a -> b gre grekey 305419896 greseq 100 greproto 0x86DD checksum payload "IPV6_OVER_IPV4_GRE_PKT_1"
    a <- b gre grekey 305419896 greseq 101 greproto 0x86DD checksum payload "IPV6_OVER_IPV4_GRE_PKT_2"
}

// INSTRUCTION: Compile the full RFC 2890 GRE header flow.
compile {
    gre_rfc2890_full(gre_full_rtr_a, gre_full_rtr_b)
}
