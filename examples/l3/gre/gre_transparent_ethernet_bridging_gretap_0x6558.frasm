// RFC 1701 / RFC 2784 Layer 2 GRETAP tunnel encapsulating full Ethernet
// frames with GRE protocol type 0x6558 (25944 TEB).
// This capture sets TTL 64, DF bit set and uses post-packet wait gaps (4ms)
// between frames.
// Wireshark: gre

host gretap_bridge_a {
    ip 10.47.65.1
    mac 00:16:3e:47:65:01
}

host gretap_bridge_b {
    ip 10.47.65.2
    mac 00:16:3e:47:65:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow gre_teb_gretap_flow(a, b) {
    a -> b gre grekey 6558 greseq 10 greproto 25944 df ttl 64 hexpayload "00112233445566778899aabb08004500001c000100004001" wait 4ms
    a <- b gre grekey 6558 greseq 10 greproto 25944 df ttl 64 hexpayload "66778899aabb00112233445508004500001c000200004001"
}

// Run gre_teb_gretap_flow(gretap_bridge_a, gretap_bridge_b) to generate the
// capture.
compile {
    gre_teb_gretap_flow(gretap_bridge_a, gretap_bridge_b)
}
