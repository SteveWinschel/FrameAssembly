// 802.1Q VLAN-tagged GRE tunnel packets traversing a branch WAN handoff VLAN.
// This capture wraps frames in 802.1Q VLAN 470.
// Wireshark: gre && vlan.id == 470

host retail_cpe_gre { ip 10.47.1.1 mac 00:19:aa:47:01:01 }

host regional_hub_gre { ip 10.47.1.2 mac 00:19:aa:47:01:02 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow gre_vlan_uplink_flow(cpe, hub) {
    cpe -> hub gre grekey 4700 greseq 10 vlan 470 pcp 3 dei 0
    cpe <- hub gre grekey 4700 greseq 10 vlan 470 pcp 3 dei 0
}

// Run gre_vlan_uplink_flow(retail_cpe_gre, regional_hub_gre) to generate the
// capture.
compile {
    gre_vlan_uplink_flow(retail_cpe_gre, regional_hub_gre)
}
