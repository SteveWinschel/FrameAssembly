// HSRP active router election where high-priority gateway preempts current
// active router.
// This capture carries group 10, HSRP state 16.
// Wireshark: hsrp

host hsrp_preempt_primary { ip 10.10.1.254 }

host hsrp_mcast_v4 { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_preempt_flow(rtr, mcast) {
    rtr -> mcast hsrp group 10 priority 150 state 16 vip 10.10.1.1
}

// Run hsrp_preempt_flow(hsrp_preempt_primary, hsrp_mcast_v4) to generate the
// capture.
compile {
    hsrp_preempt_flow(hsrp_preempt_primary, hsrp_mcast_v4)
}
