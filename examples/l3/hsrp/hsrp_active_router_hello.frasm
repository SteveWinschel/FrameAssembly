// Hot Standby Router Protocol Hello packet advertising group and priority.
// This capture carries group 1.
// Wireshark: hsrp

host hsrp_primary_gw { ip 192.168.1.254 }

host hsrp_backup_gw { ip 192.168.1.253 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_hello_flow(p, b) {
    p -> b hsrp group 1 priority 110
}

// Run hsrp_hello_flow(hsrp_primary_gw, hsrp_backup_gw) to generate the
// capture.
compile {
    hsrp_hello_flow(hsrp_primary_gw, hsrp_backup_gw)
}
