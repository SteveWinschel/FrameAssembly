// Fast HSRP convergence configuration with 1-second hello and 3-second
// holdtime.
// This capture carries group 30.
// Wireshark: hsrp

host fast_core_rtr { ip 10.20.30.254 }

host fast_hsrp_mcast { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_fast_timer(rtr, dst) {
    rtr -> dst hsrp group 30 priority 140 hellotime 1 holdtime 3 vip 10.20.30.1
}

// Run hsrp_fast_timer(fast_core_rtr, fast_hsrp_mcast) to generate the
// capture.
compile {
    hsrp_fast_timer(fast_core_rtr, fast_hsrp_mcast)
}
