// PROMPT: Campus core HSRP active router failback restoring priority 200 after uplink recovery with subsecond timers.
// TOKENS: host, ip, mac, flow, pri, hsrp, group, priority, state, hellotime, holdtime, vip, ttl, wait, ms, compile

// INSTRUCTION: Define primary campus core switch returning to service after link restoration.
host campus_core_pri {
    ip 10.44.0.2
    mac 00:00:0c:07:ac:0a
}

// INSTRUCTION: Define secondary campus core switch ceding active role to higher-priority peer.
host campus_core_sec {
    ip 10.44.0.3
    mac 00:00:0c:07:ac:0b
}

// INSTRUCTION: Define HSRP all-routers IPv4 multicast destination group.
host hsrp_all_rtrs {
    ip 224.0.0.2
    mac 01:00:5e:00:00:02
}

// INSTRUCTION: Exchange HSRP Coup, Resign, and Active Hello advertisements during planned core failback.
flow hsrp_core_failback(pri, sec, mcast) {
    pri -> mcast hsrp group 10 priority 200 state 16 hellotime 1 holdtime 3 vip 10.44.0.1 ttl 1 wait 10ms
    sec -> mcast hsrp group 10 priority 150 state 8 hellotime 1 holdtime 3 vip 10.44.0.1 ttl 1 wait 10ms
    pri -> mcast hsrp group 10 priority 200 state 16 hellotime 1 holdtime 3 vip 10.44.0.1 ttl 1
}

// INSTRUCTION: Compile the campus core HSRP priority 200 failback sequence.
compile {
    hsrp_core_failback(campus_core_pri, campus_core_sec, hsrp_all_rtrs)
}
