// Graceful HSRP gateway handover with primary resigning and secondary
// assuming active state.
// This capture carries group 1, HSRP state 16/8 and uses post-packet wait
// gaps (25ms) between frames.
// Wireshark: hsrp

host hsrp_old_active { ip 192.168.10.1 }

host hsrp_new_active { ip 192.168.10.2 }

host hsrp_handover_mcast { ip 224.0.0.2 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow hsrp_handover_flow(r1, r2, mcast) {
    r1 -> mcast hsrp group 1 priority 80 state 8 vip 192.168.10.254 wait 25ms
    r2 -> mcast hsrp group 1 priority 120 state 16 vip 192.168.10.254
}

// Run hsrp_handover_flow(hsrp_old_active, hsrp_new_active,
// hsrp_handover_mcast) to generate the capture.
compile {
    hsrp_handover_flow(hsrp_old_active, hsrp_new_active, hsrp_handover_mcast)
}
