// PROMPT: Graceful HSRP gateway handover with primary resigning and secondary assuming active state.
// TOKENS: host, ip, flow, hsrp, group, priority, state, vip, wait, ms, compile

// INSTRUCTION: Define resigning primary gateway.
host hsrp_old_active { ip 192.168.10.1 }

// INSTRUCTION: Define incoming secondary gateway.
host hsrp_new_active { ip 192.168.10.2 }

// INSTRUCTION: Define multicast exchange address.
host hsrp_handover_mcast { ip 224.0.0.2 }

// INSTRUCTION: Define handover sequence where primary resigns (8) and secondary takes active (16).
flow hsrp_handover_flow(r1, r2, mcast) {
    r1 -> mcast hsrp group 1 priority 80 state 8 vip 192.168.10.254 wait 25ms
    r2 -> mcast hsrp group 1 priority 120 state 16 vip 192.168.10.254
}

// INSTRUCTION: Compile block executing planned HSRP role transition.
compile {
    hsrp_handover_flow(hsrp_old_active, hsrp_new_active, hsrp_handover_mcast)
}
