// Minimal HSRPv1 (RFC 2281) Hello packet sent over UDP port 1985 to the
// All-Routers multicast destination 224.0.0.2 (01:00:5e:00:00:02) with
// default Group 0, Priority 100, and Active state. Useful for checking FHRP
// filtering and switch snooping.
// Wireshark: hsrp

host endpoint_a {
    ip 10.19.85.2
    mac 02:00:19:85:00:02
}

host endpoint_b {
    ip 10.19.85.3
    mac 02:00:19:85:00:03
}

// Transmit one default HSRP packet directly inside compile.
compile {
    endpoint_a -> endpoint_b hsrp
}
