// PROMPT: HSRP Hello messages marked with DSCP CS6 (48), TTL 1, and IPv4 Don't Fragment flag.
// TOKENS: host, ip, flow, hsrp, group, priority, state, vip, hellotime, holdtime, dscp, ecn, ttl, df, compile

// INSTRUCTION: Define campus core router 1.
host hsrp_cs6_r1 { ip 10.1.1.252 }

// INSTRUCTION: Define campus core router 2.
host hsrp_cs6_r2 { ip 10.1.1.253 }

// INSTRUCTION: Define DSCP CS6 (48) marked HSRP packets with TTL 1.
flow hsrp_dscp_cs6_flow(r1, r2) {
    r1 -> r2 hsrp group 1 priority 110 state 16 vip 10.1.1.254 hellotime 3 holdtime 10 dscp 48 ecn 0 ttl 1 df
    r1 <- r2 hsrp group 1 priority 100 state 8 vip 10.1.1.254 hellotime 3 holdtime 10 dscp 48 ecn 0 ttl 1 df
}

// INSTRUCTION: Compile the DSCP CS6 HSRP control plane flow.
compile {
    hsrp_dscp_cs6_flow(hsrp_cs6_r1, hsrp_cs6_r2)
}
