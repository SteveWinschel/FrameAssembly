// HSRP control-plane packets with DSCP CS6 (48) marking and max TTL 255.
// This capture sets DSCP 48, TTL 255 and carries group 40.
// Wireshark: hsrp

host edge_agg_rtr { ip 10.55.0.254 }

host edge_hsrp_dst { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_qos_flow(src, dst) {
    src -> dst hsrp group 40 priority 105 vip 10.55.0.1 dscp 48 ttl 255
}

// Run hsrp_qos_flow(edge_agg_rtr, edge_hsrp_dst) to generate the capture.
compile {
    hsrp_qos_flow(edge_agg_rtr, edge_hsrp_dst)
}
