// HSRP first hop redundancy hello message with explicit hellotime and
// holdtime timers.
// This capture carries group 5.
// Wireshark: hsrp

host hsrp_timer_rtr { ip 172.20.1.254 }

host hsrp_mcast_dst { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_timer_flow(src, dst) {
    src -> dst hsrp group 5 priority 105 hellotime 3 holdtime 10 vip 172.20.1.1
}

// Run hsrp_timer_flow(hsrp_timer_rtr, hsrp_mcast_dst) to generate the
// capture.
compile {
    hsrp_timer_flow(hsrp_timer_rtr, hsrp_mcast_dst)
}
