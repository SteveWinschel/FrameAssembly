// HSRPv2 IPv6 redundancy announcement over link-local addresses on port 2029.
// This capture targets IPv6 endpoints and carries group 100, HSRP state 16.
// Wireshark: hsrp2

host hsrp_v6_primary { ip fe80::20c:29ff:fe11:2233 }

host hsrp_v6_mcast { ip ff02::66 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_v6_hello(rtr, mcast) {
    rtr -> mcast hsrp group 100 priority 120 state 16 vip fe80::1
}

// Run hsrp_v6_hello(hsrp_v6_primary, hsrp_v6_mcast) to generate the capture.
compile {
    hsrp_v6_hello(hsrp_v6_primary, hsrp_v6_mcast)
}
