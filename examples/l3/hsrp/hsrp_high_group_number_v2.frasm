// HSRP configuration utilizing extended standby group number 250 with custom
// timers.
// This capture carries group 250.
// Wireshark: hsrp

host access_sw_rtr { ip 172.24.1.254 }

host access_mcast { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_high_grp(rtr, dst) {
    rtr -> dst hsrp group 250 priority 130 hellotime 2 holdtime 6 vip 172.24.1.1
}

// Run hsrp_high_grp(access_sw_rtr, access_mcast) to generate the capture.
compile {
    hsrp_high_grp(access_sw_rtr, access_mcast)
}
