// Newly booted HSRP router transitioning from Initial (0) and Learn (1)
// states upon hearing Active VIP.
// This capture carries group 88, HSRP state 1/16/8 and uses post-packet wait
// gaps (15ms) between frames.
// Wireshark: hsrp

host hsrp_boot_rtr { ip 192.168.88.3 }

host hsrp_active_rtr { ip 192.168.88.2 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow hsrp_learn_bootstrap(boot, act) {
    boot -> act hsrp group 88 priority 100 state 1 vip 0.0.0.0 hellotime 3 holdtime 10 wait 15ms
    boot <- act hsrp group 88 priority 115 state 16 vip 192.168.88.1 hellotime 3 holdtime 10 wait 15ms
    boot -> act hsrp group 88 priority 100 state 8 vip 192.168.88.1 hellotime 3 holdtime 10
}

// Run hsrp_learn_bootstrap(hsrp_boot_rtr, hsrp_active_rtr) to generate the
// capture.
compile {
    hsrp_learn_bootstrap(hsrp_boot_rtr, hsrp_active_rtr)
}
