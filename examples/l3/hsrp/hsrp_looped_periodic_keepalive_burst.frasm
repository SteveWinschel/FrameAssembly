// PROMPT: Repetitive HSRP hello heartbeats generated via COMPILE LOOP to test holdtime tracking.
// TOKENS: host, ip, flow, dst, hsrp, group, priority, state, vip, wait, ms, compile

// INSTRUCTION: Define active cluster firewall node.
host fw_active_node { ip 192.168.99.1 }

// INSTRUCTION: Define HSRP multicast target.
host fw_hsrp_group { ip 224.0.0.2 }

// INSTRUCTION: Define periodic HSRP heartbeat flow with 50ms inter-packet pause.
flow hsrp_burst_flow(fw, dst) {
    fw -> dst hsrp group 99 priority 120 state 16 vip 192.168.99.254 wait 50ms
}

// INSTRUCTION: Compile loop executing 4 consecutive HSRP hello transmissions.
compile {
    hsrp_burst_flow(fw_active_node, fw_hsrp_group) // cycle 1
    hsrp_burst_flow(fw_active_node, fw_hsrp_group) // cycle 2
    hsrp_burst_flow(fw_active_node, fw_hsrp_group) // cycle 3
    hsrp_burst_flow(fw_active_node, fw_hsrp_group) // cycle 4
}
