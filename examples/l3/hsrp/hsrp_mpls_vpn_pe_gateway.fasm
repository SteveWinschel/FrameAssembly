// PROMPT: HSRP gateway heartbeats encapsulated across MPLS provider edge customer handoff.
// TOKENS: host, ip, flow, dst, hsrp, group, priority, vip, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define MPLS customer edge router.
host mpls_ce_gw { ip 10.200.5.1 }

// INSTRUCTION: Define HSRP multicast target.
host mpls_mcast_dst { ip 224.0.0.2 }

// INSTRUCTION: Define MPLS labeled HSRP hello frame with label 100200 and EXP 5.
flow hsrp_mpls_flow(ce, dst) {
    ce -> dst hsrp group 70 priority 125 vip 10.200.5.254 mpls 100200 exp 5 bos 1 mplsttl 64
}

// INSTRUCTION: Compile block executing MPLS encapsulated HSRP heartbeat.
compile {
    hsrp_mpls_flow(mpls_ce_gw, mpls_mcast_dst)
}
