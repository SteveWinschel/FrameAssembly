// HSRP gateway heartbeats encapsulated across MPLS provider edge customer
// handoff.
// This capture wraps frames in MPLS label 100200 and carries group 70.
// Wireshark: hsrp && mpls

host mpls_ce_gw { ip 10.200.5.1 }

host mpls_mcast_dst { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_mpls_flow(ce, dst) {
    ce -> dst hsrp group 70 priority 125 vip 10.200.5.254 mpls 100200 exp 5 bos 1 mplsttl 64
}

// Run hsrp_mpls_flow(mpls_ce_gw, mpls_mcast_dst) to generate the capture.
compile {
    hsrp_mpls_flow(mpls_ce_gw, mpls_mcast_dst)
}
