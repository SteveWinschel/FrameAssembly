// PROMPT: Multigroup HSRP (MHSRP) active/active load sharing across Group 1 and Group 2 on the same subnet.
// TOKENS: HOST, IP, FLOW, HSRP, GROUP, PRIORITY, STATE, VIP, HELLOTIME, HOLDTIME, COMPILE

// INSTRUCTION: Define router A (Active for Group 1, Standby for Group 2).
HOST mhsrp_router_a { IP 192.168.10.2 }

// INSTRUCTION: Define router B (Active for Group 2, Standby for Group 1).
HOST mhsrp_router_b { IP 192.168.10.3 }

// INSTRUCTION: Define reciprocal MHSRP load-sharing advertisements for VIPs .1 and .254.
FLOW mhsrp_load_sharing(a, b) {
    a -> b HSRP GROUP 1 PRIORITY 120 STATE 16 VIP 192.168.10.1 HELLOTIME 3 HOLDTIME 10
    a <- b HSRP GROUP 1 PRIORITY 90 STATE 8 VIP 192.168.10.1 HELLOTIME 3 HOLDTIME 10
    a <- b HSRP GROUP 2 PRIORITY 120 STATE 16 VIP 192.168.10.254 HELLOTIME 3 HOLDTIME 10
    a -> b HSRP GROUP 2 PRIORITY 90 STATE 8 VIP 192.168.10.254 HELLOTIME 3 HOLDTIME 10
}

// INSTRUCTION: Compile the multigroup HSRP load-sharing flow.
COMPILE {
    mhsrp_load_sharing(mhsrp_router_a, mhsrp_router_b)
}
