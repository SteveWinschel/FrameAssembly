// Multiple HSRP standby groups running concurrently for VLAN active/active
// load sharing.
// This capture carries group 1/2, HSRP state 16.
// Wireshark: hsrp

host mhsrp_rtr1 { ip 10.1.0.251 }

host mhsrp_rtr2 { ip 10.1.0.252 }

host mhsrp_mcast { ip 224.0.0.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow mhsrp_dual_group(r1, r2, mcast) {
    r1 -> mcast hsrp group 1 priority 110 state 16 vip 10.1.1.1
    r2 -> mcast hsrp group 2 priority 110 state 16 vip 10.1.2.1
}

// Run mhsrp_dual_group(mhsrp_rtr1, mhsrp_rtr2, mhsrp_mcast) to generate the
// capture.
compile {
    mhsrp_dual_group(mhsrp_rtr1, mhsrp_rtr2, mhsrp_mcast)
}
