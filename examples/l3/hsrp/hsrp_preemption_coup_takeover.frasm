// Higher-priority HSRP router preempting lower-priority active router for
// virtual gateway IP.
// This capture carries group 50, HSRP state 16/8 and uses post-packet wait
// gaps (20ms) between frames.
// Wireshark: hsrp

host hsrp_incumbent_rtr { ip 192.168.50.2 }

host hsrp_preempt_rtr { ip 192.168.50.3 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow hsrp_preemption_takeover(inc, pre) {
    inc -> pre hsrp group 50 priority 100 state 16 vip 192.168.50.1 hellotime 3 holdtime 10 wait 20ms
    inc <- pre hsrp group 50 priority 150 state 16 vip 192.168.50.1 hellotime 3 holdtime 10 wait 20ms
    inc -> pre hsrp group 50 priority 100 state 8 vip 192.168.50.1 hellotime 3 holdtime 10
}

// Run hsrp_preemption_takeover(hsrp_incumbent_rtr, hsrp_preempt_rtr) to
// generate the capture.
compile {
    hsrp_preemption_takeover(hsrp_incumbent_rtr, hsrp_preempt_rtr)
}
