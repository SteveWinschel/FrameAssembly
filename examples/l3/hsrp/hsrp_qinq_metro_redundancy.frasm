// QinQ dual-tagged HSRP heartbeats for service provider metro Ethernet
// redundancy.
// This capture wraps frames in QinQ S-VLAN 200 / C-VLAN 10 and carries group
// 25.
// Wireshark: hsrp

host metro_pe_rtr { ip 172.16.200.1 }

host hsrp_metro_mcast { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_qinq_flow(pe, dst) {
    pe -> dst hsrp group 25 priority 115 vip 172.16.200.254 qinq 200 innervlan 10
}

// Run hsrp_qinq_flow(metro_pe_rtr, hsrp_metro_mcast) to generate the capture.
compile {
    hsrp_qinq_flow(metro_pe_rtr, hsrp_metro_mcast)
}
