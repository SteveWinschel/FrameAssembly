// Cisco HSRP state advertisement with active state code, virtual IP, and
// priority.
// This capture carries group 2, HSRP state 16.
// Wireshark: hsrp

host cisco_rtr_active { ip 10.1.1.253 }

host hsrp_all_routers { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_state_flow(rtr, mcast) {
    rtr -> mcast hsrp group 2 priority 120 state 16 vip 10.1.1.1
}

// Run hsrp_state_flow(cisco_rtr_active, hsrp_all_routers) to generate the
// capture.
compile {
    hsrp_state_flow(cisco_rtr_active, hsrp_all_routers)
}
