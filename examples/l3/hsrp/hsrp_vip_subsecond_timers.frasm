// Cisco HSRP active router advertising Virtual IP (VIP) with explicit
// HELLOTIME and HOLDTIME.
// This capture carries group 10, HSRP state 16.
// Wireshark: hsrp

host hsrp_dist_active { ip 10.10.20.2 mac 00:00:0c:07:ac:0a }

host hsrp_all_routers { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_vip_timers_flow(act, mcast) {
    act -> mcast hsrp group 10 priority 120 state 16 vip 10.10.20.1 hellotime 1 holdtime 3
}

// Run hsrp_vip_timers_flow(hsrp_dist_active, hsrp_all_routers) to generate
// the capture.
compile {
    hsrp_vip_timers_flow(hsrp_dist_active, hsrp_all_routers)
}
