// PROMPT: HSRP hello heartbeat on 802.1Q tagged subinterface for campus VLAN 100.
// TOKENS: host, ip, flow, dst, hsrp, group, priority, vip, vlan, pcp, dei, compile

// INSTRUCTION: Define campus distribution switch subinterface.
host campus_dist_rtr { ip 10.100.1.254 }

// INSTRUCTION: Define all-routers multicast target.
host hsrp_all_rtrs { ip 224.0.0.2 }

// INSTRUCTION: Define tagged HSRP flow with VLAN 100 and voice-level PCP priority 5.
flow hsrp_vlan_tagged(rtr, dst) {
    rtr -> dst hsrp group 10 priority 110 vip 10.100.1.1 vlan 100 pcp 5 dei 0
}

// INSTRUCTION: Compile block executing VLAN-encapsulated HSRP hello.
compile {
    hsrp_vlan_tagged(campus_dist_rtr, hsrp_all_rtrs)
}
