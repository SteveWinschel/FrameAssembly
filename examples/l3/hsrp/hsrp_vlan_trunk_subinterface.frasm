// HSRP hello heartbeat on 802.1Q tagged subinterface for campus VLAN 100.
// This capture wraps frames in 802.1Q VLAN 100 and carries group 10.
// Wireshark: hsrp && vlan.id == 100

host campus_dist_rtr { ip 10.100.1.254 }

host hsrp_all_rtrs { ip 224.0.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow hsrp_vlan_tagged(rtr, dst) {
    rtr -> dst hsrp group 10 priority 110 vip 10.100.1.1 vlan 100 pcp 5 dei 0
}

// Run hsrp_vlan_tagged(campus_dist_rtr, hsrp_all_rtrs) to generate the
// capture.
compile {
    hsrp_vlan_tagged(campus_dist_rtr, hsrp_all_rtrs)
}
