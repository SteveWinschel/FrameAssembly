// Perimeter firewall rejecting unauthorized ping with ICMP Destination
// Unreachable Code 13 (Admin Prohibited).
// This capture sets TTL 54/64.
// Wireshark: icmp

host ext_untrusted_host { ip 203.0.113.99 }

host acl_border_filter { ip 198.51.100.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_acl_prohibited(ext, fw) {
    ext -> fw icmp echorequest id 666 seq 1 ttl 54
    ext <- fw icmp destunreach code 13 ttl 64
}

// Run icmp_acl_prohibited(ext_untrusted_host, acl_border_filter) to generate
// the capture.
compile {
    icmp_acl_prohibited(ext_untrusted_host, acl_border_filter)
}
