// PROMPT: ICMP Echo Request carrying custom hex payload containing telemetry timestamp and pattern.
// TOKENS: host, ip, flow, src, dst, icmp, echorequest, id, seq, hexpayload, compile

// INSTRUCTION: Define network analyzer test source.
host net_analyzer { ip 10.254.1.10 }

// INSTRUCTION: Define benchmark responder host.
host benchmark_node { ip 10.254.1.20 }

// INSTRUCTION: Define ICMP Echo Request flow with 16-byte custom diagnostic payload.
flow icmp_hex_payload_flow(src, dst) {
    src -> dst icmp echorequest id 7700 seq 42 hexpayload "0102030405060708090a0b0c0d0e0f10"
}

// INSTRUCTION: Compile block executing ICMP custom payload transmission.
compile {
    icmp_hex_payload_flow(net_analyzer, benchmark_node)
}
