// ICMP Echo Request carrying custom hex payload containing telemetry
// timestamp and pattern.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host net_analyzer { ip 10.254.1.10 }

host benchmark_node { ip 10.254.1.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_hex_payload_flow(src, dst) {
    src -> dst icmp echorequest id 7700 seq 42 hexpayload "0102030405060708090a0b0c0d0e0f10"
}

// Run icmp_hex_payload_flow(net_analyzer, benchmark_node) to generate the
// capture.
compile {
    icmp_hex_payload_flow(net_analyzer, benchmark_node)
}
