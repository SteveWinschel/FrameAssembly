// PROMPT: ICMP Destination Unreachable with Code 1 (Host Unreachable) and explicit ID and Sequence.
// TOKENS: host, ip, flow, icmp, destunreach, code, id, seq, compile

// INSTRUCTION: Define edge router unable to resolve target host.
host edge_boundary_rtr { ip 172.28.1.1 }

// INSTRUCTION: Define requesting workstation.
host requesting_wrk { ip 172.28.1.100 }

// INSTRUCTION: Define ICMP Host Unreachable error notification flow.
flow icmp_host_unreach_flow(rtr, wrk) {
    rtr -> wrk icmp destunreach code 1 id 2200 seq 1
}

// INSTRUCTION: Compile block executing ICMP Host Unreachable generation.
compile {
    icmp_host_unreach_flow(edge_boundary_rtr, requesting_wrk)
}
