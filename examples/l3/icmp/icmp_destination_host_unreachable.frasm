// ICMP Destination Unreachable with Code 1 (Host Unreachable) and explicit ID
// and Sequence.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host edge_boundary_rtr { ip 172.28.1.1 }

host requesting_wrk { ip 172.28.1.100 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_host_unreach_flow(rtr, wrk) {
    rtr -> wrk icmp destunreach code 1 id 2200 seq 1
}

// Run icmp_host_unreach_flow(edge_boundary_rtr, requesting_wrk) to generate
// the capture.
compile {
    icmp_host_unreach_flow(edge_boundary_rtr, requesting_wrk)
}
