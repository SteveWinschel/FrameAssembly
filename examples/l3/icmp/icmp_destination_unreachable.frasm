// ICMP Destination Unreachable message generation with explicit type, code,
// and identifier.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host reporting_router { ip 198.51.100.1 }

host original_sender { ip 198.51.100.50 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_error_flow(router, sender) {
    router -> sender icmp destunreach code 3 id 100 seq 1
}

// Run icmp_error_flow(reporting_router, original_sender) to generate the
// capture.
compile {
    icmp_error_flow(reporting_router, original_sender)
}
