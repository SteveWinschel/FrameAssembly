// IPv4 ICMP Echo Request with DF flag asserted to detect maximum unfragmented
// MTU.
// This capture sets DF bit set.
// Wireshark: icmp

host mtu_probe_host { ip 192.168.80.20 }

host lab_gateway { ip 192.168.80.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_pmtu_df_flow(src, dst) {
    src -> dst icmp echorequest id 1234 seq 1 df ipid 45000
}

// Run icmp_pmtu_df_flow(mtu_probe_host, lab_gateway) to generate the capture.
compile {
    icmp_pmtu_df_flow(mtu_probe_host, lab_gateway)
}
