// OAM ICMP Echo probe marked with DSCP CS2 (16) and ECN ECT(1) for network
// management telemetry.
// This capture sets DSCP 16, TTL 126/128 and uses post-packet wait gaps
// (20ms) between frames.
// Wireshark: icmp

host noc_probe_srv { ip 198.51.100.15 }

host branch_wan_rtr { ip 198.51.100.16 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow icmp_cs2_oam_ping(noc, br) {
    noc -> br icmp echorequest id 3001 seq 1 dscp 16 ecn 1 ttl 128 wait 20ms
    noc <- br icmp echoreply id 3001 seq 1 dscp 16 ecn 1 ttl 126
}

// Run icmp_cs2_oam_ping(noc_probe_srv, branch_wan_rtr) to generate the
// capture.
compile {
    icmp_cs2_oam_ping(noc_probe_srv, branch_wan_rtr)
}
