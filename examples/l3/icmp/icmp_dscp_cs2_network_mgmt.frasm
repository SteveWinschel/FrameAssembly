// PROMPT: OAM ICMP Echo probe marked with DSCP CS2 (16) and ECN ECT(1) for network management telemetry.
// TOKENS: host, ip, flow, icmp, echorequest, id, seq, dscp, ecn, ttl, echoreply, wait, ms, compile

// INSTRUCTION: Define network operations center probe engine.
host noc_probe_srv { ip 198.51.100.15 }

// INSTRUCTION: Define remote branch WAN router.
host branch_wan_rtr { ip 198.51.100.16 }

// INSTRUCTION: Define DSCP CS2 (16) marked ICMP ping exchange with 20ms latency.
flow icmp_cs2_oam_ping(noc, br) {
    noc -> br icmp echorequest id 3001 seq 1 dscp 16 ecn 1 ttl 128
    noc <- br icmp echoreply id 3001 seq 1 dscp 16 ecn 1 ttl 126 wait 20ms
}

// INSTRUCTION: Compile the DSCP CS2 OAM ICMP ping flow.
compile {
    icmp_cs2_oam_ping(noc_probe_srv, branch_wan_rtr)
}
