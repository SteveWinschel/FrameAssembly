// Standard IPv4 ICMP Echo Request and Echo Reply ping exchange.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host ping_client { ip 192.168.1.100 }

host ping_target { ip 192.168.1.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_ping_flow(client, target) {
    client -> target icmp echorequest
    client <- target icmp echoreply
}

// Run icmp_ping_flow(ping_client, ping_target) to generate the capture.
compile {
    icmp_ping_flow(ping_client, ping_target)
}
