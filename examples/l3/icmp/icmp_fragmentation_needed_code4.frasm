// Path MTU Discovery triggering ICMP Destination Unreachable Code 4
// (Fragmentation Needed and DF Set).
// This capture sets DF bit set.
// Wireshark: icmp

host pmtu_probe_host { ip 172.16.10.100 }

host wan_mtu_router { ip 172.16.10.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_frag_needed(src, rtr) {
    src -> rtr icmp echorequest id 8801 seq 1 df ipid 1200 payload "LARGE_UNFRAGMENTABLE_PING_PROBE"
    src <- rtr icmp destunreach code 4
}

// Run icmp_frag_needed(pmtu_probe_host, wan_mtu_router) to generate the
// capture.
compile {
    icmp_frag_needed(pmtu_probe_host, wan_mtu_router)
}
