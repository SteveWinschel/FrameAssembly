// PROMPT: ICMP Fragmentation Needed and DF Set (Code 4) generation for Path MTU Discovery.
// TOKENS: host, ip, flow, icmp, destunreach, code, id, seq, compile

// INSTRUCTION: Define WAN gateway router with MTU restriction.
host wan_bottleneck_rtr { ip 203.0.113.1 }

// INSTRUCTION: Define client transmitting oversize datagram.
host pmtud_client { ip 203.0.113.88 }

// INSTRUCTION: Define ICMP error flow notifying client that fragmentation is required.
flow icmp_pmtud_frag_needed(rtr, c) {
    rtr -> c icmp destunreach code 4 id 1500 seq 1
}

// INSTRUCTION: Compile block executing ICMP Fragmentation Needed error.
compile {
    icmp_pmtud_frag_needed(wan_bottleneck_rtr, pmtud_client)
}
