// ICMP Fragmentation Needed and DF Set (Code 4) generation for Path MTU
// Discovery.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host wan_bottleneck_rtr { ip 203.0.113.1 }

host pmtud_client { ip 203.0.113.88 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_pmtud_frag_needed(rtr, c) {
    rtr -> c icmp destunreach code 4 id 1500 seq 1
}

// Run icmp_pmtud_frag_needed(wan_bottleneck_rtr, pmtud_client) to generate
// the capture.
compile {
    icmp_pmtud_frag_needed(wan_bottleneck_rtr, pmtud_client)
}
