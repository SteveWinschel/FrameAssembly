// Bit-error rate diagnostic ICMP ping carrying a walking-ones binary
// HEXPAYLOAD pattern.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host bert_tester { ip 192.168.99.10 }

host bert_target { ip 192.168.99.20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_hex_pattern_ping(tester, target) {
    tester -> target icmp echorequest id 5555 seq 10 srcmac 00:11:22:33:44:01 dstmac 00:11:22:33:44:02 hexpayload "0102040810204080aa55ff00deadbeef"
    tester <- target icmp echoreply id 5555 seq 10 srcmac 00:11:22:33:44:02 dstmac 00:11:22:33:44:01 hexpayload "0102040810204080aa55ff00deadbeef"
}

// Run icmp_hex_pattern_ping(bert_tester, bert_target) to generate the
// capture.
compile {
    icmp_hex_pattern_ping(bert_tester, bert_target)
}
