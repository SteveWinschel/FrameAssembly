// ICMPv6 Destination Unreachable (Type 1, Code 0) indicating no route to
// destination IPv6.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6

host v6_border_gw { ip 2001:db8:beef:1::1 }

host v6_sender_node { ip 2001:db8:beef:1::42 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp6_no_route_flow(gw, sender) {
    gw -> sender icmp destunreach code 0
}

// Run icmp6_no_route_flow(v6_border_gw, v6_sender_node) to generate the
// capture.
compile {
    icmp6_no_route_flow(v6_border_gw, v6_sender_node)
}
