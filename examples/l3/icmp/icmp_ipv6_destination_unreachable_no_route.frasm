// PROMPT: ICMPv6 Destination Unreachable (Type 1, Code 0) indicating no route to destination IPv6.
// TOKENS: host, ip, flow, sender, icmp, destunreach, code, compile

// INSTRUCTION: Define IPv6 border gateway without matching route.
host v6_border_gw { ip 2001:db8:beef:1::1 }

// INSTRUCTION: Define originating IPv6 sender.
host v6_sender_node { ip 2001:db8:beef:1::42 }

// INSTRUCTION: Define ICMPv6 No Route to Destination notification flow.
flow icmp6_no_route_flow(gw, sender) {
    gw -> sender icmp destunreach code 0
}

// INSTRUCTION: Compile block executing ICMPv6 Destination Unreachable error.
compile {
    icmp6_no_route_flow(v6_border_gw, v6_sender_node)
}
