// PROMPT: RFC 4443 ICMPv6 Echo Request and Echo Reply with explicit IPv6 Flow Labels and Hop Limit 64.
// TOKENS: host, ip, mac, flow, s, icmp, echorequest, id, seq, flowlabel, dscp, ttl, payload, echoreply, compile

// INSTRUCTION: Define IPv6 client host.
host icmpv6_client { ip 2001:db8:4443::10 mac 00:50:56:44:43:10 }

// INSTRUCTION: Define IPv6 server host.
host icmpv6_server { ip 2001:db8:4443::20 mac 00:50:56:44:43:20 }

// INSTRUCTION: Define ICMPv6 Echo Request (Type 128) and Echo Reply (Type 129) with Flow Labels.
flow icmpv6_echo_flow(c, s) {
    c -> s icmp echorequest id 4443 seq 1 flowlabel 128000 dscp 8 ttl 64 payload "RFC4443_ICMPV6_PING_REQ"
    c <- s icmp echoreply id 4443 seq 1 flowlabel 129000 dscp 8 ttl 64 payload "RFC4443_ICMPV6_PING_RSP"
}

// INSTRUCTION: Compile the RFC 4443 ICMPv6 Echo flow.
compile {
    icmpv6_echo_flow(icmpv6_client, icmpv6_server)
}
