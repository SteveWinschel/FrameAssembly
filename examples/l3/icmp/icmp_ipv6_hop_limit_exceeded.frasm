// ICMPv6 Time Exceeded (Type 3) generated across IPv6 routers when Hop Limit
// decrements to 0.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6

host v6_transit_rtr { ip 2001:db8:fedc::1 }

host v6_origin_host { ip 2001:db8:fedc::99 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp6_hop_exceeded_flow(rtr, host) {
    rtr -> host icmp timeexceeded code 0
}

// Run icmp6_hop_exceeded_flow(v6_transit_rtr, v6_origin_host) to generate the
// capture.
compile {
    icmp6_hop_exceeded_flow(v6_transit_rtr, v6_origin_host)
}
