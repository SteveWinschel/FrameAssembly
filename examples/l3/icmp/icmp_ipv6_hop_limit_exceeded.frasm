// PROMPT: ICMPv6 Time Exceeded (Type 3) generated across IPv6 routers when Hop Limit decrements to 0.
// TOKENS: host, ip, flow, icmp, timeexceeded, code, compile

// INSTRUCTION: Define intermediate IPv6 transit router.
host v6_transit_rtr { ip 2001:db8:fedc::1 }

// INSTRUCTION: Define IPv6 originating endpoint.
host v6_origin_host { ip 2001:db8:fedc::99 }

// INSTRUCTION: Define ICMPv6 Hop Limit Exceeded flow with code 0.
flow icmp6_hop_exceeded_flow(rtr, host) {
    rtr -> host icmp timeexceeded code 0
}

// INSTRUCTION: Compile block executing ICMPv6 Time Exceeded generation.
compile {
    icmp6_hop_exceeded_flow(v6_transit_rtr, v6_origin_host)
}
