// MPLS-encapsulated ICMP ping and TTL-expired response across a
// label-switched core.
// This capture wraps frames in MPLS label 16001/16002.
// Wireshark: icmp && mpls

host mpls_ping_ing { ip 10.253.0.1 }

host mpls_ping_egr { ip 10.253.0.2 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow icmp_mpls_lsp_trace(ing, egr) {
    ing -> egr icmp echorequest id 9000 seq 1 mpls 16001 exp 4 bos 1 mplsttl 1
    ing <- egr icmp timeexceeded mpls 16002 exp 4 bos 1 mplsttl 64
    ing -> egr icmp echorequest id 9000 seq 2 mpls 16001 exp 4 bos 1 mplsttl 64
    ing <- egr icmp echoreply id 9000 seq 2 mpls 16002 exp 4 bos 1 mplsttl 64
}

// Run icmp_mpls_lsp_trace(mpls_ping_ing, mpls_ping_egr) to generate the
// capture.
compile {
    icmp_mpls_lsp_trace(mpls_ping_ing, mpls_ping_egr)
}
