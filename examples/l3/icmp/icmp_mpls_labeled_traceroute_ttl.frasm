// MPLS label-switched ICMP Echo Request probe with explicit MPLS label and
// TTL.
// This capture wraps frames in MPLS label 300400.
// Wireshark: icmp && mpls

host mpls_ingress_pe { ip 10.150.1.1 }

host mpls_egress_pe { ip 10.150.2.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_mpls_probe(pe1, pe2) {
    pe1 -> pe2 icmp echorequest id 8899 seq 1 mpls 300400 exp 3 bos 1 mplsttl 128
}

// Run icmp_mpls_probe(mpls_ingress_pe, mpls_egress_pe) to generate the
// capture.
compile {
    icmp_mpls_probe(mpls_ingress_pe, mpls_egress_pe)
}
