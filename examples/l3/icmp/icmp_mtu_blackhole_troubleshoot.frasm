// Path MTU Discovery (PMTUD) troubleshooting trace: a server sends an Echo
// Request with Don't Fragment (df) set across a 1400-byte tunnel path, and the
// tunnel gateway returns ICMP Type 3 Code 4 (Fragmentation Needed) 3ms later.
// Wireshark: icmp && (icmp.type == 8 || (icmp.type == 3 && icmp.code == 4))

host app_server {
    ip 10.88.10.25
    mac 00:50:56:88:0a:19
}

host tunnel_gw {
    ip 10.88.10.1
    mac 00:1c:73:88:0a:01
}

// Pause 3ms after the DF probe before emitting the ICMP Code 4 error reply.
flow pmtud_frag_needed_check(srv, gw) {
    srv -> gw df ttl 64 icmp echorequest id 8400 seq 1 payload "df_1472_byte_mtu_probe" wait 3ms
    srv <- gw ttl 64 icmp destunreach code 4 payload "next_hop_mtu_1400_limit"
}

// Compile the PMTUD ICMP Code 4 trace.
compile {
    pmtud_frag_needed_check(app_server, tunnel_gw)
}
