// PROMPT: Server returning ICMP DEST_UNREACH Code 3 (Port Unreachable) and Code 2 (Protocol Unreachable).
// TOKENS: host, ip, flow, icmp, destunreach, code, payload, wait, ms, compile

// INSTRUCTION: Define network scanner host.
host scanner_node { ip 10.50.0.15 }

// INSTRUCTION: Define hardened server rejecting closed UDP port and unsupported IP protocol.
host hardened_srv { ip 10.50.0.80 }

// INSTRUCTION: Define ICMP Destination Unreachable Code 3 and Code 2 error responses.
flow icmp_port_proto_unreach(scan, srv) {
    scan <- srv icmp destunreach code 3 payload "CLOSED_UDP_PORT_HEADER_ECHO"
    scan <- srv icmp destunreach code 2 payload "UNSUPPORTED_IP_PROTO_ECHO" wait 10ms
}

// INSTRUCTION: Compile the ICMP Port and Protocol Unreachable flow.
compile {
    icmp_port_proto_unreach(scanner_node, hardened_srv)
}
