// Server returning ICMP Destination Unreachable Code 3 (Port Unreachable) and
// Code 2 (Protocol Unreachable).
// This capture uses post-packet wait gaps (10ms) between frames.
// Wireshark: icmp

host scanner_node { ip 10.50.0.15 }

host hardened_srv { ip 10.50.0.80 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow icmp_port_proto_unreach(scan, srv) {
    scan <- srv icmp destunreach code 3 payload "CLOSED_UDP_PORT_HEADER_ECHO" wait 10ms
    scan <- srv icmp destunreach code 2 payload "UNSUPPORTED_IP_PROTO_ECHO"
}

// Run icmp_port_proto_unreach(scanner_node, hardened_srv) to generate the
// capture.
compile {
    icmp_port_proto_unreach(scanner_node, hardened_srv)
}
