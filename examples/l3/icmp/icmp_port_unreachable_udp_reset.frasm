// ICMP Port Unreachable (Type 3, Code 3) returned when target UDP service
// port is closed.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host closed_service_srv { ip 10.99.1.5 }

host udp_scanner_node { ip 10.99.1.200 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_port_unreach_flow(srv, scanner) {
    srv -> scanner icmp destunreach code 3 id 9988 seq 5
}

// Run icmp_port_unreach_flow(closed_service_srv, udp_scanner_node) to
// generate the capture.
compile {
    icmp_port_unreach_flow(closed_service_srv, udp_scanner_node)
}
