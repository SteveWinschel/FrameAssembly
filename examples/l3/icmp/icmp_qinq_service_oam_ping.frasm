// 802.1ad QinQ double-tagged ICMP reachability check across a wholesale
// carrier circuit.
// This capture wraps frames in QinQ S-VLAN 1800 / C-VLAN 80.
// Wireshark: icmp

host qinq_ping_ce_a { ip 172.29.10.1 }

host qinq_ping_ce_b { ip 172.29.10.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_qinq_oam(a, b) {
    a -> b icmp echorequest id 1880 seq 10 qinq 1800 innervlan 80 payload "CARRIER_CIRCUIT_SLA_PROBE"
    a <- b icmp echoreply id 1880 seq 10 qinq 1800 innervlan 80 payload "CARRIER_CIRCUIT_SLA_PROBE"
}

// Run icmp_qinq_oam(qinq_ping_ce_a, qinq_ping_ce_b) to generate the capture.
compile {
    icmp_qinq_oam(qinq_ping_ce_a, qinq_ping_ce_b)
}
