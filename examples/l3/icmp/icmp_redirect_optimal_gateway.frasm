// Default gateway sending ICMP REDIRECT (Code 1 for Host) pointing to optimal
// next-hop router.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host lan_workstation { ip 192.168.10.55 mac 00:1a:a0:10:00:55 }

host default_gw_r1 { ip 192.168.10.1 mac 00:1a:a0:10:00:01 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_redirect_flow(host, gw) {
    host -> gw icmp echorequest id 1010 seq 1
    host <- gw icmp redirect code 1 gateway 192.168.10.2
}

// Run icmp_redirect_flow(lan_workstation, default_gw_r1) to generate the
// capture.
compile {
    icmp_redirect_flow(lan_workstation, default_gw_r1)
}
