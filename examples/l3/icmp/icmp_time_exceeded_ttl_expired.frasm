// ICMP Time Exceeded (Type 11, Code 0) notification generated when packet TTL
// reaches 0.
// This capture sends ICMP control and reachability probes with valid
// checksums.
// Wireshark: icmp

host transit_core_rtr { ip 198.51.100.1 }

host traceroute_src { ip 198.51.100.45 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_ttl_expired_flow(rtr, src) {
    rtr -> src icmp timeexceeded code 0 id 4001 seq 1
}

// Run icmp_ttl_expired_flow(transit_core_rtr, traceroute_src) to generate the
// capture.
compile {
    icmp_ttl_expired_flow(transit_core_rtr, traceroute_src)
}
