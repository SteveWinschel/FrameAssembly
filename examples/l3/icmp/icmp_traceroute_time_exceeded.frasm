// Traceroute TTL expiration triggering ICMP Time Exceeded (Code 0) from
// intermediate hop.
// This capture sets TTL 1/64.
// Wireshark: icmp

host trace_client { ip 10.10.1.50 }

host transit_hop_1 { ip 10.10.1.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow icmp_traceroute_hop(client, hop) {
    client -> hop icmp echorequest id 4001 seq 1 ttl 1
    client <- hop icmp timeexceeded code 0 ttl 64
}

// Run icmp_traceroute_hop(trace_client, transit_hop_1) to generate the
// capture.
compile {
    icmp_traceroute_hop(trace_client, transit_hop_1)
}
