// PROMPT: 802.1Q VLAN tagged ICMP Echo Request traceroute probe with explicit SEQ and DSCP.
// TOKENS: host, ip, flow, s, icmp, echorequest, id, seq, vlan, pcp, dei, dscp, compile

// INSTRUCTION: Define diagnostic tester on VLAN 42.
host diag_tester { ip 192.168.42.10 }

// INSTRUCTION: Define remote target switch.
host remote_sw { ip 192.168.42.1 }

// INSTRUCTION: Define VLAN-tagged ICMP echo flow with CS4 DSCP marking.
flow icmp_vlan_probe(t, s) {
    t -> s icmp echorequest id 1042 seq 1 vlan 42 pcp 4 dei 0 dscp 32
}

// INSTRUCTION: Compile block executing tagged ICMP traceroute probe.
compile {
    icmp_vlan_probe(diag_tester, remote_sw)
}
