// 802.1Q VLAN tagged ICMP Echo Request traceroute probe with explicit SEQ and
// DSCP.
// This capture wraps frames in 802.1Q VLAN 42 and sets DSCP 32.
// Wireshark: icmp && vlan.id == 42

host diag_tester { ip 192.168.42.10 }

host remote_sw { ip 192.168.42.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow icmp_vlan_probe(t, s) {
    t -> s icmp echorequest id 1042 seq 1 vlan 42 pcp 4 dei 0 dscp 32
}

// Run icmp_vlan_probe(diag_tester, remote_sw) to generate the capture.
compile {
    icmp_vlan_probe(diag_tester, remote_sw)
}
