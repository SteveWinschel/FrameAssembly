// WAN overlay MTU discovery triggering ICMP Fragmentation Needed (Type 3,
// Code 4) from tunnel ingress router.
// This capture sets TTL 64, DF bit set and uses post-packet wait gaps (5ms,
// 10ms) between frames.
// Wireshark: icmp

host app_origin_srv {
    ip 10.88.1.10
    mac 00:50:56:88:01:0a
}

host wan_tunnel_rtr {
    ip 10.88.1.1
    mac 00:50:56:88:01:01
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow icmp_tunnel_pmtud(srv, rtr) {
    srv -> rtr df ttl 64 icmp echorequest id 4410 seq 1 payload "oversized_df_probe_simulating_1472_byte_wan_frame" wait 5ms
    srv <- rtr ttl 64 icmp destunreach code 4 payload "mtu_1400_exceeded_on_gre0" wait 10ms
    srv -> rtr df ttl 64 icmp echorequest id 4410 seq 2 payload "clamped_1372_byte_probe" wait 5ms
    srv <- rtr ttl 64 icmp echoreply id 4410 seq 2 payload "clamped_1372_byte_probe"
}

// Run icmp_tunnel_pmtud(app_origin_srv, wan_tunnel_rtr) to generate the
// capture.
compile {
    icmp_tunnel_pmtud(app_origin_srv, wan_tunnel_rtr)
}
