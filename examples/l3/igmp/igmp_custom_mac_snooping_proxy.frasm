// IGMP snooping proxy forwarding aggregated report with explicit RFC 1112
// multicast DSTMAC.
// This capture sets TTL 1 and carries group 239.1.2.3.
// Wireshark: igmp

host igmp_proxy_sw { ip 172.20.1.2 }

host igmp_upstream_rtr { ip 172.20.1.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_proxy_report(proxy, rtr) {
    proxy -> rtr igmp report group 239.1.2.3 srcmac 00:1e:49:20:01:02 dstmac 01:00:5e:01:02:03 ttl 1 hexpayload "00000000"
}

// Run igmp_proxy_report(igmp_proxy_sw, igmp_upstream_rtr) to generate the
// capture.
compile {
    igmp_proxy_report(igmp_proxy_sw, igmp_upstream_rtr)
}
