// Minimal IGMP Membership Report starter packet sent over IP protocol 2 to
// default multicast group 239.1.1.1 (auto-derived MAC 01:00:5e:01:01:01) with
// TTL 1. Useful for checking IGMP snooping and multicast boundary rules on a
// lab switch.
// Wireshark: igmp

host endpoint_a {
    ip 10.2.0.10
    mac 02:00:02:00:00:0a
}

host endpoint_b {
    ip 10.2.0.1
    mac 02:00:02:00:00:01
}

// Transmit one default IGMP packet directly inside compile.
compile {
    endpoint_a -> endpoint_b igmp
}
