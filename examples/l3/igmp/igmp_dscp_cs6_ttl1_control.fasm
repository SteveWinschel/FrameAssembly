// PROMPT: IGMP control plane messages marked with RFC 4594 DSCP CS6 (48), TTL 1, and DF flag.
// TOKENS: host, ip, flow, igmp, query, group, maxresp, dscp, ecn, ttl, df, report, compile

// INSTRUCTION: Define multicast router enforcing TTL=1 and DSCP CS6.
host igmp_cs6_rtr { ip 10.1.99.1 }

// INSTRUCTION: Define multicast host responding with DSCP CS6.
host igmp_cs6_host { ip 10.1.99.20 }

// INSTRUCTION: Define DSCP CS6 (48) marked IGMP Query and Report.
flow igmp_cs6_control(rtr, host) {
    rtr -> host igmp query group 239.99.99.1 maxresp 100 dscp 48 ecn 0 ttl 1 df
    rtr <- host igmp report group 239.99.99.1 dscp 48 ecn 0 ttl 1 df
}

// INSTRUCTION: Compile the DSCP CS6 IGMP control flow.
compile {
    igmp_cs6_control(igmp_cs6_rtr, igmp_cs6_host)
}
