// IGMP control plane messages marked with RFC 4594 DSCP CS6 (48), TTL 1, and
// DF flag.
// This capture sets DSCP 48, TTL 1, DF bit set and carries group 239.99.99.1.
// Wireshark: igmp

host igmp_cs6_rtr { ip 10.1.99.1 }

host igmp_cs6_host { ip 10.1.99.20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_cs6_control(rtr, host) {
    rtr -> host igmp query group 239.99.99.1 maxresp 100 dscp 48 ecn 0 ttl 1 df
    rtr <- host igmp report group 239.99.99.1 dscp 48 ecn 0 ttl 1 df
}

// Run igmp_cs6_control(igmp_cs6_rtr, igmp_cs6_host) to generate the capture.
compile {
    igmp_cs6_control(igmp_cs6_rtr, igmp_cs6_host)
}
