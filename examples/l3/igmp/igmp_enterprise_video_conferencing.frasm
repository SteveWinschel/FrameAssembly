// PROMPT: IGMP Membership Report joining organization-wide video conference stream 239.192.100.1.
// TOKENS: host, ip, flow, igmp, report, group, vlan, compile

// INSTRUCTION: Define boardroom conferencing codec.
host boardroom_codec { ip 10.210.4.50 }

// INSTRUCTION: Define corporate town hall video stream address.
host townhall_stream { ip 239.192.100.1 }

// INSTRUCTION: Define conferencing IGMP join flow on AV VLAN 210.
flow igmp_conf_join(codec, grp) {
    codec -> grp igmp report group 239.192.100.1 vlan 210
}

// INSTRUCTION: Compile block executing corporate video IGMP join.
compile {
    igmp_conf_join(boardroom_codec, townhall_stream)
}
