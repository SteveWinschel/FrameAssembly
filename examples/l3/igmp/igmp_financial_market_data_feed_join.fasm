// PROMPT: Low-latency trading engine joining UDP multicast market data feed 239.192.10.50 via IGMPv2 REPORT.
// TOKENS: host, ip, mac, flow, dscp, ttl, igmp, report, maxresp, group, wait, ms, compile

// INSTRUCTION: Define colocation algorithmic trading server subscribing to equity order-book multicast feed.
host algo_trade_srv {
    ip 10.210.40.15
    mac 00:0f:53:d2:28:0f
}

// INSTRUCTION: Define exchange multicast feed group address 239.192.10.50.
host market_feed_grp {
    ip 239.192.10.50
    mac 01:00:5e:40:0a:32
}

// INSTRUCTION: Transmit unsolicited IGMPv2 Membership Report with DSCP CS6 and TTL 1 for immediate join.
flow igmp_market_feed_join(srv, grp) {
    srv -> grp dscp 48 ttl 1 igmp report maxresp 0 group 239.192.10.50 wait 10ms
    srv -> grp dscp 48 ttl 1 igmp report maxresp 0 group 239.192.10.50
}

// INSTRUCTION: Compile the financial market data IGMPv2 rapid join flow.
compile {
    igmp_market_feed_join(algo_trade_srv, market_feed_grp)
}
