// Low-latency trading engine joining UDP multicast market data feed
// 239.192.10.50 via IGMPv2 REPORT.
// This capture sets DSCP 48, TTL 1, carries group 239.192.10.50, and uses
// post-packet wait gaps (10ms) between frames.
// Wireshark: igmp

host algo_trade_srv {
    ip 10.210.40.15
    mac 00:0f:53:d2:28:0f
}

host market_feed_grp {
    ip 239.192.10.50
    mac 01:00:5e:40:0a:32
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow igmp_market_feed_join(srv, grp) {
    srv -> grp dscp 48 ttl 1 igmp report maxresp 0 group 239.192.10.50 wait 10ms
    srv -> grp dscp 48 ttl 1 igmp report maxresp 0 group 239.192.10.50
}

// Run igmp_market_feed_join(algo_trade_srv, market_feed_grp) to generate the
// capture.
compile {
    igmp_market_feed_join(algo_trade_srv, market_feed_grp)
}
