// IGMPv2 General Membership Query specifying Max Response (100 = 10.0s) to
// 224.0.0.1 followed by host Report.
// This capture sets TTL 1 and carries group 0.0.0.0/239.10.10.5.
// Wireshark: igmp

host igmp_querier_rtr { ip 192.168.10.1 mac 00:1b:54:10:00:01 }

host igmp_receiver_01 { ip 192.168.10.50 mac 00:1b:54:10:00:50 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_general_query_flow(q, r) {
    q -> r igmp query group 0.0.0.0 maxresp 100 ttl 1
    q <- r igmp report group 239.10.10.5 ttl 1
}

// Run igmp_general_query_flow(igmp_querier_rtr, igmp_receiver_01) to generate
// the capture.
compile {
    igmp_general_query_flow(igmp_querier_rtr, igmp_receiver_01)
}
