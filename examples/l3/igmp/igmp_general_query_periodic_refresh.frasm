// Periodic IGMP General Membership Query sent by designated router to
// all-hosts 224.0.0.1.
// This capture sets TTL 1 and carries group 224.0.0.1.
// Wireshark: igmp

host igmp_dr_rtr { ip 10.40.1.1 }

host all_systems_group { ip 224.0.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_general_query(rtr, grp) {
    rtr -> grp igmp query maxresp 100 group 224.0.0.1 ttl 1
}

// Run igmp_general_query(igmp_dr_rtr, all_systems_group) to generate the
// capture.
compile {
    igmp_general_query(igmp_dr_rtr, all_systems_group)
}
