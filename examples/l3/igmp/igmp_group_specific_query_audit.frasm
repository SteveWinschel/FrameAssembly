// IGMP Group-Specific Query auditing active listeners for video group
// 239.255.10.20.
// This capture carries group 239.255.10.20.
// Wireshark: igmp

host igmp_access_querier { ip 192.168.100.1 }

host igmp_video_mcast { ip 239.255.10.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_specific_query(querier, grp) {
    querier -> grp igmp query maxresp 20 group 239.255.10.20
}

// Run igmp_specific_query(igmp_access_querier, igmp_video_mcast) to generate
// the capture.
compile {
    igmp_specific_query(igmp_access_querier, igmp_video_mcast)
}
