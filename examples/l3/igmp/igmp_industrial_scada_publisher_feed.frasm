// PROMPT: IGMP Query and Report sequence coordinating telemetry distribution across SCADA substations.
// TOKENS: host, ip, flow, igmp, query, maxresp, group, wait, ms, report, compile

// INSTRUCTION: Define SCADA telemetry master gateway.
host scada_master_gw { ip 172.30.1.1 }

// INSTRUCTION: Define electrical substation PLC receiver.
host substation_plc { ip 172.30.1.20 }

// INSTRUCTION: Define power grid telemetry multicast group.
host grid_telemetry_grp { ip 239.200.1.10 }

// INSTRUCTION: Define query and reply sequence managing substation telemetry forwarding.
flow scada_igmp_coordination(gw, plc, grp) {
    gw -> grp igmp query maxresp 50 group 239.200.1.10 wait 25ms
    plc -> grp igmp report group 239.200.1.10
}

// INSTRUCTION: Compile block executing SCADA IGMP query and report exchange.
compile {
    scada_igmp_coordination(scada_master_gw, substation_plc, grid_telemetry_grp)
}
