// IGMP Query and Report sequence coordinating telemetry distribution across
// SCADA substations.
// This capture carries group 239.200.1.10 and uses post-packet wait gaps
// (25ms) between frames.
// Wireshark: igmp

host scada_master_gw { ip 172.30.1.1 }

host substation_plc { ip 172.30.1.20 }

host grid_telemetry_grp { ip 239.200.1.10 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow scada_igmp_coordination(gw, plc, grp) {
    gw -> grp igmp query maxresp 50 group 239.200.1.10 wait 25ms
    plc -> grp igmp report group 239.200.1.10
}

// Run scada_igmp_coordination(scada_master_gw, substation_plc,
// grid_telemetry_grp) to generate the capture.
compile {
    scada_igmp_coordination(scada_master_gw, substation_plc, grid_telemetry_grp)
}
