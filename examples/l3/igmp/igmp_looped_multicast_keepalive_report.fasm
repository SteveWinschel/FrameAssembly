// PROMPT: Repetitive IGMP Membership Reports inside COMPILE LOOP to refresh multicast forwarding state.
// TOKENS: host, ip, flow, igmp, report, group, wait, ms, compile

// INSTRUCTION: Define surveillance video wall receiver.
host video_wall_node { ip 192.168.140.22 }

// INSTRUCTION: Define security camera multicast stream.
host camera_feed_stream { ip 239.20.1.5 }

// INSTRUCTION: Define IGMP report refresh flow with 100ms interval.
flow igmp_keepalive_flow(recv, grp) {
    recv -> grp igmp report group 239.20.1.5 wait 100ms
}

// INSTRUCTION: Compile loop executing 4 periodic IGMP report renewals.
compile {
    igmp_keepalive_flow(video_wall_node, camera_feed_stream) // cycle 1
    igmp_keepalive_flow(video_wall_node, camera_feed_stream) // cycle 2
    igmp_keepalive_flow(video_wall_node, camera_feed_stream) // cycle 3
    igmp_keepalive_flow(video_wall_node, camera_feed_stream) // cycle 4
}
