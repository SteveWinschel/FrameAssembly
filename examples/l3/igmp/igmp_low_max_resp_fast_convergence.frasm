// IGMP General Query specifying aggressive 1-second (Max Response 10)
// response window for fast convergence.
// This capture carries group 224.0.0.1.
// Wireshark: igmp

host fast_igmp_rtr { ip 192.168.220.1 }

host all_hosts_target { ip 224.0.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_fast_query_flow(rtr, dst) {
    rtr -> dst igmp query maxresp 10 group 224.0.0.1
}

// Run igmp_fast_query_flow(fast_igmp_rtr, all_hosts_target) to generate the
// capture.
compile {
    igmp_fast_query_flow(fast_igmp_rtr, all_hosts_target)
}
