// Trading engine subscribing simultaneously to multiple financial market data
// multicast groups.
// This capture sets DSCP 48, TTL 1, carries group
// 239.192.1.1/239.192.1.2/239.192.2.1, and uses post-packet wait gaps (2ms)
// between frames.
// Wireshark: igmp

host algo_trader_01 { ip 10.240.10.11 mac 00:0f:53:aa:10:11 }

host tor_mcast_sw { ip 10.240.10.1 mac 00:1c:73:aa:10:01 }

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow market_data_igmp_joins(srv, sw) {
    srv -> sw igmp report group 239.192.1.1 ttl 1 dscp 48 wait 2ms
    srv -> sw igmp report group 239.192.1.2 ttl 1 dscp 48 wait 2ms
    srv -> sw igmp report group 239.192.2.1 ttl 1 dscp 48
}

// Run market_data_igmp_joins(algo_trader_01, tor_mcast_sw) to generate the
// capture.
compile {
    market_data_igmp_joins(algo_trader_01, tor_mcast_sw)
}
