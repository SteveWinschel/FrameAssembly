// PROMPT: Trading engine subscribing simultaneously to multiple financial market data multicast groups.
// TOKENS: host, ip, mac, flow, igmp, report, group, ttl, dscp, wait, ms, compile

// INSTRUCTION: Define low-latency algorithmic trading server.
host algo_trader_01 { ip 10.240.10.11 mac 00:0f:53:aa:10:11 }

// INSTRUCTION: Define top-of-rack multicast switch.
host tor_mcast_sw { ip 10.240.10.1 mac 00:1c:73:aa:10:01 }

// INSTRUCTION: Define rapid IGMP Membership Reports across three market feed multicast groups.
flow market_data_igmp_joins(srv, sw) {
    srv -> sw igmp report group 239.192.1.1 ttl 1 dscp 48
    srv -> sw igmp report group 239.192.1.2 ttl 1 dscp 48 wait 2ms
    srv -> sw igmp report group 239.192.2.1 ttl 1 dscp 48 wait 2ms
}

// INSTRUCTION: Compile the multi-group financial market data IGMP join flow.
compile {
    market_data_igmp_joins(algo_trader_01, tor_mcast_sw)
}
