// PROMPT: Multicast group membership management with IGMP query and report on IPv4.
// TOKENS: host, ip, flow, igmp, query, report, compile

// INSTRUCTION: Define IPv4 querier router.
host igmp_router { ip 192.168.1.1 }

// INSTRUCTION: Define IPv4 all-hosts destination.
host igmp_host { ip 224.0.0.1 }

// INSTRUCTION: Define multicast membership signaling flow.
flow igmp_mgmt(r, h) {
    r -> h igmp query
    r -> h igmp report
}

// INSTRUCTION: Compile block executing IGMP query and report.
compile {
    igmp_mgmt(igmp_router, igmp_host)
}
