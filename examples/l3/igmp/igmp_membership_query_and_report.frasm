// Multicast group membership management with IGMP query and report on IPv4.
// This capture exchanges IPv4 multicast membership messages over IP protocol
// 2.
// Wireshark: igmp

host igmp_router { ip 192.168.1.1 }

host igmp_host { ip 224.0.0.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_mgmt(r, h) {
    r -> h igmp query
    r -> h igmp report
}

// Run igmp_mgmt(igmp_router, igmp_host) to generate the capture.
compile {
    igmp_mgmt(igmp_router, igmp_host)
}
