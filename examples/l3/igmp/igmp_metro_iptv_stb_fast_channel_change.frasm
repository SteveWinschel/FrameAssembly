// Residential IPTV set-top box executing fast channel change with IGMP LEAVE
// on old channel and REPORT on new channel.
// This capture wraps frames in 802.1Q VLAN 300, sets TTL 1, carries group
// 239.1.1.10/239.1.1.11, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: igmp && vlan.id == 300

host iptv_stb_client {
    ip 100.64.30.105
    mac 00:1a:2b:3c:4d:69
}

host bng_mcast_rtr {
    ip 100.64.30.1
    mac 00:1a:2b:3c:00:01
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow igmp_iptv_zap(stb, bng) {
    stb -> bng vlan 300 pcp 5 ttl 1 igmp leave maxresp 0 group 239.1.1.10 wait 5ms
    stb <- bng vlan 300 pcp 6 ttl 1 igmp query maxresp 10 group 239.1.1.10 wait 5ms
    stb -> bng vlan 300 pcp 5 ttl 1 igmp report maxresp 0 group 239.1.1.11
}

// Run igmp_iptv_zap(iptv_stb_client, bng_mcast_rtr) to generate the capture.
compile {
    igmp_iptv_zap(iptv_stb_client, bng_mcast_rtr)
}
