// PROMPT: Customer IGMP membership reports transported over an MPLS pseudowire with EXP 6.
// TOKENS: host, ip, flow, igmp, query, group, maxresp, mpls, exp, bos, mplsttl, ttl, report, compile

// INSTRUCTION: Define MVPN provider edge router.
host mvpn_pe_querier { ip 172.16.88.1 }

// INSTRUCTION: Define customer site multicast receiver.
host mvpn_ce_receiver { ip 172.16.88.10 }

// INSTRUCTION: Define MPLS-labeled IGMP Query and Report exchange.
flow igmp_mpls_pseudowire(pe, ce) {
    pe -> ce igmp query group 239.88.1.1 maxresp 100 mpls 22400 exp 6 bos 1 mplsttl 255 ttl 1
    pe <- ce igmp report group 239.88.1.1 mpls 22401 exp 6 bos 1 mplsttl 255 ttl 1
}

// INSTRUCTION: Compile the MPLS-labeled IGMP membership flow.
compile {
    igmp_mpls_pseudowire(mvpn_pe_querier, mvpn_ce_receiver)
}
