// Customer IGMP membership reports transported over an MPLS pseudowire with
// EXP 6.
// This capture wraps frames in MPLS label 22400/22401, sets TTL 1, and
// carries group 239.88.1.1.
// Wireshark: igmp && mpls

host mvpn_pe_querier { ip 172.16.88.1 }

host mvpn_ce_receiver { ip 172.16.88.10 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_mpls_pseudowire(pe, ce) {
    pe -> ce igmp query group 239.88.1.1 maxresp 100 mpls 22400 exp 6 bos 1 mplsttl 255 ttl 1
    pe <- ce igmp report group 239.88.1.1 mpls 22401 exp 6 bos 1 mplsttl 255 ttl 1
}

// Run igmp_mpls_pseudowire(mvpn_pe_querier, mvpn_ce_receiver) to generate the
// capture.
compile {
    igmp_mpls_pseudowire(mvpn_pe_querier, mvpn_ce_receiver)
}
