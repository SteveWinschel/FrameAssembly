// Concurrent IGMP Membership Reports from multiple independent client nodes
// for distinct streams.
// This capture carries group 239.50.1.1/239.50.1.2.
// Wireshark: igmp

host analytics_worker1 { ip 10.120.1.11 }

host analytics_worker2 { ip 10.120.1.12 }

host equities_feed_grp { ip 239.50.1.1 }

host commodities_feed_grp { ip 239.50.1.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_multi_join(w1, w2, g1, g2) {
    w1 -> g1 igmp report group 239.50.1.1
    w2 -> g2 igmp report group 239.50.1.2
}

// Run igmp_multi_join(analytics_worker1, analytics_worker2,
// equities_feed_grp, commodities_feed_grp) to generate the capture.
compile {
    igmp_multi_join(analytics_worker1, analytics_worker2, equities_feed_grp, commodities_feed_grp)
}
