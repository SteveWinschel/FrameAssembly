// QinQ encapsulated IGMP Membership Report for hospitality guest network IPTV
// feed.
// This capture wraps frames in QinQ S-VLAN 300 / C-VLAN 25 and carries group
// 239.100.5.1.
// Wireshark: igmp

host hotel_media_unit { ip 172.22.10.50 }

host hotel_iptv_stream { ip 239.100.5.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_qinq_report(dev, grp) {
    dev -> grp igmp report group 239.100.5.1 qinq 300 innervlan 25
}

// Run igmp_qinq_report(hotel_media_unit, hotel_iptv_stream) to generate the
// capture.
compile {
    igmp_qinq_report(hotel_media_unit, hotel_iptv_stream)
}
