// 802.1ad QinQ double-tagged IGMP membership reports across a wholesale IPTV
// access network.
// This capture wraps frames in QinQ S-VLAN 3000 / C-VLAN 200, sets TTL 1, and
// carries group 239.200.1.1.
// Wireshark: igmp

host bng_iptv_root { ip 100.64.50.1 }

host ont_subscriber { ip 100.64.50.25 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow igmp_qinq_iptv(bng, ont) {
    bng -> ont igmp query group 239.200.1.1 maxresp 100 qinq 3000 innervlan 200 ttl 1
    bng <- ont igmp report group 239.200.1.1 qinq 3000 innervlan 200 ttl 1
    bng <- ont igmp leave group 239.200.1.1 qinq 3000 innervlan 200 ttl 1
}

// Run igmp_qinq_iptv(bng_iptv_root, ont_subscriber) to generate the capture.
compile {
    igmp_qinq_iptv(bng_iptv_root, ont_subscriber)
}
