// IGMPv2 membership report joining a specific multicast group with maximum
// response time.
// This capture carries group 239.255.1.1.
// Wireshark: igmp

host mcast_client { ip 10.0.10.15 }

host all_routers_group { ip 224.0.0.22 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_join_flow(client, router) {
    client -> router igmp report group 239.255.1.1 maxresp 100
}

// Run igmp_join_flow(mcast_client, all_routers_group) to generate the
// capture.
compile {
    igmp_join_flow(mcast_client, all_routers_group)
}
