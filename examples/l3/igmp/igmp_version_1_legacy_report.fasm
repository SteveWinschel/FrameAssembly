// PROMPT: RFC 1112 IGMP VERSION 1 Membership Report with Max Response Time 0 and TTL 1.
// TOKENS: host, ip, flow, igmp, query, group, maxresp, version, ttl, report, compile

// INSTRUCTION: Define legacy multicast router polling on 224.0.0.1.
host igmpv1_router { ip 192.168.12.1 }

// INSTRUCTION: Define legacy industrial PLC reporting multicast group membership.
host igmpv1_plc { ip 192.168.12.50 }

// INSTRUCTION: Define IGMP VERSION 1 query and report exchange.
flow igmp_v1_compat_flow(rtr, plc) {
    rtr -> plc igmp query group 0.0.0.0 maxresp 0 version 1 ttl 1
    rtr <- plc igmp report group 224.0.1.60 version 1 ttl 1
}

// INSTRUCTION: Compile the IGMPv1 backward-compatibility flow.
compile {
    igmp_v1_compat_flow(igmpv1_router, igmpv1_plc)
}
