// RFC 1112 IGMP version 1 Membership Report with Max Response Time 0 and TTL
// 1.
// This capture sets TTL 1 and carries group 0.0.0.0/224.0.1.60.
// Wireshark: igmp

host igmpv1_router { ip 192.168.12.1 }

host igmpv1_plc { ip 192.168.12.50 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_v1_compat_flow(rtr, plc) {
    rtr -> plc igmp query group 0.0.0.0 maxresp 0 version 1 ttl 1
    rtr <- plc igmp report group 224.0.1.60 version 1 ttl 1
}

// Run igmp_v1_compat_flow(igmpv1_router, igmpv1_plc) to generate the capture.
compile {
    igmp_v1_compat_flow(igmpv1_router, igmpv1_plc)
}
