// IGMP Membership Report on VLAN 30 triggering switch IGMP snooping multicast
// table entry.
// This capture wraps frames in 802.1Q VLAN 30 and carries group 239.1.2.3.
// Wireshark: igmp && vlan.id == 30

host stb_client_node { ip 10.30.0.15 }

host iptv_channel_hd { ip 239.1.2.3 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow igmp_snooping_join(client, grp) {
    client -> grp igmp report group 239.1.2.3 vlan 30 pcp 5 dei 0
}

// Run igmp_snooping_join(stb_client_node, iptv_channel_hd) to generate the
// capture.
compile {
    igmp_snooping_join(stb_client_node, iptv_channel_hd)
}
