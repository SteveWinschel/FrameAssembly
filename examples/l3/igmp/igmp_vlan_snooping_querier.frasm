// 802.1Q VLAN-tagged IGMP snooping querier and subscriber report on multicast
// VLAN 500.
// This capture wraps frames in 802.1Q VLAN 500, sets TTL 1, and carries group
// 239.50.0.1.
// Wireshark: igmp && vlan.id == 500

host snoop_querier_500 { ip 10.50.0.1 mac 00:1c:73:50:00:01 }

host mcast_sub_500 { ip 10.50.0.88 mac 00:1c:73:50:00:88 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow igmp_vlan_snooping(q, sub) {
    q -> sub igmp query group 239.50.0.1 maxresp 50 vlan 500 pcp 5 dei 0 ttl 1
    q <- sub igmp report group 239.50.0.1 vlan 500 pcp 5 dei 0 ttl 1
}

// Run igmp_vlan_snooping(snoop_querier_500, mcast_sub_500) to generate the
// capture.
compile {
    igmp_vlan_snooping(snoop_querier_500, mcast_sub_500)
}
