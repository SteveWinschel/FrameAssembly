// IKEv2 CREATE_CHILD_SA exchange with explicit Initiator/Responder SPIs and
// Next Payload 46 (SK).
// This capture uses post-packet wait gaps (15ms) between frames.
// Wireshark: isakmp

host rekey_ike_a { ip 172.16.101.1 }

host rekey_ike_b { ip 172.16.101.2 }

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ikev2_rekey_sk(a, b) {
    a -> b ikev2 createchildsa initiatorspi 300400500 responderspi 600700800 msgid 4 flags 8 nextpayload 46 wait 15ms
    a <- b ikev2 createchildsa initiatorspi 300400500 responderspi 600700800 msgid 4 flags 32 nextpayload 46
}

// Run ikev2_rekey_sk(rekey_ike_a, rekey_ike_b) to generate the capture.
compile {
    ikev2_rekey_sk(rekey_ike_a, rekey_ike_b)
}
