// PROMPT: Enterprise edge router establishing primary IKEv2 SA_INIT and AUTH tunnel with a cloud VPC VPN gateway.
// TOKENS: host, ip, mac, flow, dscp, ikev2, sainit, initiatorspi, responderspi, msgid, flags, nextpayload, wait, ms, exchange, auth, compile

// INSTRUCTION: Define on-premises enterprise SD-WAN border router.
host onprem_vpn_edge {
    ip 198.51.100.45
    mac 00:1c:73:c6:64:2d
}

// INSTRUCTION: Define cloud VPC virtual private gateway endpoint.
host cloud_vpc_vgw {
    ip 203.0.113.200
    mac 00:1c:73:cb:71:c8
}

// INSTRUCTION: Complete four-message IKE_SA_INIT and IKE_AUTH negotiation between on-premises edge and cloud VGW.
flow ikev2_cloud_vpc_setup(edge, vgw) {
    edge -> vgw dscp 48 ikev2 sainit initiatorspi 91002001 responderspi 0 msgid 0 flags 8 nextpayload 33 wait 10ms
    edge <- vgw dscp 48 ikev2 sainit initiatorspi 91002001 responderspi 92003002 msgid 0 flags 32 nextpayload 33 wait 10ms
    edge -> vgw dscp 48 ikev2 exchange auth initiatorspi 91002001 responderspi 92003002 msgid 1 flags 8 nextpayload 46 wait 10ms
    edge <- vgw dscp 48 ikev2 exchange auth initiatorspi 91002001 responderspi 92003002 msgid 1 flags 32 nextpayload 46
}

// INSTRUCTION: Compile the cloud VPC IKEv2 SA_INIT and AUTH negotiation trace.
compile {
    ikev2_cloud_vpc_setup(onprem_vpn_edge, cloud_vpc_vgw)
}
