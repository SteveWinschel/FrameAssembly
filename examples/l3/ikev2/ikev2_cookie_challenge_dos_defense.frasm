// RFC 7296 IKEv2 stateless COOKIE challenge (Next Payload 41 Notify)
// defending against DoS floods.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host cookie_ike_init { ip 198.51.100.199 }

host cookie_ike_resp { ip 203.0.113.199 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow ikev2_cookie_challenge(init, resp) {
    init -> resp ikev2 sainit initiatorspi 555666777 responderspi 0 msgid 0 flags 8 nextpayload 33
    init <- resp ikev2 sainit initiatorspi 555666777 responderspi 0 msgid 0 flags 32 nextpayload 41 payload "COOKIE_CHALLENGE_TOKEN"
    init -> resp ikev2 sainit initiatorspi 555666777 responderspi 0 msgid 0 flags 8 nextpayload 41 payload "COOKIE_CHALLENGE_TOKEN"
    init <- resp ikev2 sainit initiatorspi 555666777 responderspi 888999000 msgid 0 flags 32 nextpayload 33
}

// Run ikev2_cookie_challenge(cookie_ike_init, cookie_ike_resp) to generate
// the capture.
compile {
    ikev2_cookie_challenge(cookie_ike_init, cookie_ike_resp)
}
