// PROMPT: IKEv2 CREATE_CHILD_SA exchange rekeying an existing Child Security Association.
// TOKENS: host, ip, flow, init, ikev2, exchange, createchildsa, msgid, compile

// INSTRUCTION: Define IKEv2 initiator gateway.
host ike_gw_init { ip 198.51.100.10 }

// INSTRUCTION: Define IKEv2 responder gateway.
host ike_gw_resp { ip 198.51.100.20 }

// INSTRUCTION: Define CREATE_CHILD_SA exchange flow with incremented message IDs.
flow ikev2_child_sa_flow(init, resp) {
    init -> resp ikev2 exchange createchildsa msgid 2
    init <- resp ikev2 exchange createchildsa msgid 2
}

// INSTRUCTION: Compile block executing Child SA negotiation.
compile {
    ikev2_child_sa_flow(ike_gw_init, ike_gw_resp)
}
