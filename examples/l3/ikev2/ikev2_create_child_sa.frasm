// IKEv2 CREATE_CHILD_SA exchange rekeying an existing Child Security
// Association.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host ike_gw_init { ip 198.51.100.10 }

host ike_gw_resp { ip 198.51.100.20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ikev2_child_sa_flow(init, resp) {
    init -> resp ikev2 exchange createchildsa msgid 2
    init <- resp ikev2 exchange createchildsa msgid 2
}

// Run ikev2_child_sa_flow(ike_gw_init, ike_gw_resp) to generate the capture.
compile {
    ikev2_child_sa_flow(ike_gw_init, ike_gw_resp)
}
