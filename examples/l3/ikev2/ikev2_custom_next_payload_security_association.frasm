// IKEv2 IKE_SA_INIT packet specifying Next Payload 33 (Security Association)
// and explicit SPIs.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host sec_audit_probe { ip 10.130.5.50 }

host audited_ipsec_gw { ip 10.130.5.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_next_payload_flow(src, gw) {
    src -> gw ikev2 initiatorspi 9081726354453627 responderspi 0 sainit msgid 0 nextpayload 33
}

// Run ikev2_next_payload_flow(sec_audit_probe, audited_ipsec_gw) to generate
// the capture.
compile {
    ikev2_next_payload_flow(sec_audit_probe, audited_ipsec_gw)
}
