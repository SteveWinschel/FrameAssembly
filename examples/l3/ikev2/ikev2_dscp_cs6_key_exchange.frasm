// IKEv2 control plane key exchange marked with DSCP CS6 (48) and ECN ECT(0).
// This capture sets DSCP 48, TTL 64, DF bit set.
// Wireshark: isakmp

host cs6_ike_gw_a { ip 203.0.113.51 }

host cs6_ike_gw_b { ip 203.0.113.52 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ikev2_cs6_priority(a, b) {
    a -> b ikev2 sainit initiatorspi 48001 responderspi 0 msgid 0 flags 8 nextpayload 33 dscp 48 ecn 2 ttl 64 df
    a <- b ikev2 sainit initiatorspi 48001 responderspi 48002 msgid 0 flags 32 nextpayload 33 dscp 48 ecn 2 ttl 64 df
}

// Run ikev2_cs6_priority(cs6_ike_gw_a, cs6_ike_gw_b) to generate the capture.
compile {
    ikev2_cs6_priority(cs6_ike_gw_a, cs6_ike_gw_b)
}
