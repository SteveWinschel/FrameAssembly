// IKEv2 handshake packets prioritized with Expedited Forwarding (DSCP 46 EF)
// and TTL 64.
// This capture sets DSCP 46, TTL 64.
// Wireshark: isakmp

host emergency_gw { ip 192.168.188.1 }

host dispatch_center { ip 192.168.188.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_qos_flow(gw, dc) {
    gw -> dc ikev2 initiatorspi 6677889900112233 responderspi 0 sainit msgid 0 dscp 46 ttl 64
}

// Run ikev2_qos_flow(emergency_gw, dispatch_center) to generate the capture.
compile {
    ikev2_qos_flow(emergency_gw, dispatch_center)
}
