// PROMPT: IKEv2 SA_INIT exchange operating natively over IPv6 transport on UDP port 500.
// TOKENS: host, ip, flow, ikev2, initiatorspi, responderspi, sainit, msgid, compile

// INSTRUCTION: Define IPv6 site A VPN router.
host v6_vpn_site_a { ip 2001:db8:abc:1::1 }

// INSTRUCTION: Define IPv6 site B VPN router.
host v6_vpn_site_b { ip 2001:db8:abc:2::1 }

// INSTRUCTION: Define bidirectional IPv6 IKEv2 SA_INIT exchange flow.
flow ikev2_v6_init_flow(a, b) {
    a -> b ikev2 initiatorspi 7711223344556677 responderspi 0 sainit msgid 0
    a <- b ikev2 initiatorspi 7711223344556677 responderspi 8822334455667788 sainit msgid 0
}

// INSTRUCTION: Compile block executing native IPv6 IKEv2 negotiation.
compile {
    ikev2_v6_init_flow(v6_vpn_site_a, v6_vpn_site_b)
}
