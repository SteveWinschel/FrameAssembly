// Dual-stack IKEv2 key negotiation running over IPv4 and IPv6 security
// gateways.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs and
// sets DSCP 48, TTL 64, IPv6 Flow Label.
// Wireshark: isakmp

host ike_v4_west { ip 198.51.100.31 }

host ike_v4_east { ip 198.51.100.32 }

host ike_v6_west { ip 2001:db8:500::31 }

host ike_v6_east { ip 2001:db8:500::32 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow dual_stack_ikev2(w, e) {
    w -> e ikev2 sainit initiatorspi 700800900 responderspi 0 msgid 0 dscp 48 ttl 64 flowlabel 50001
    w <- e ikev2 sainit initiatorspi 700800900 responderspi 900800700 msgid 0 dscp 48 ttl 64 flowlabel 50002
    w -> e ikev2 createchildsa initiatorspi 700800900 responderspi 900800700 msgid 1 dscp 48 ttl 64 flowlabel 50001
    w <- e ikev2 createchildsa initiatorspi 700800900 responderspi 900800700 msgid 1 dscp 48 ttl 64 flowlabel 50002
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    dual_stack_ikev2(ike_v4_west, ike_v4_east)
    dual_stack_ikev2(ike_v6_west, ike_v6_east)
}
