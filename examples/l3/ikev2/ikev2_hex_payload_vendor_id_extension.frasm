// IKEv2 IKE_SA_INIT packet containing proprietary vendor ID extension in hex
// representation.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host vendor_appliance { ip 198.51.100.80 }

host vendor_gateway { ip 198.51.100.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_vendor_id_flow(app, gw) {
    app -> gw ikev2 initiatorspi 9876123456789012 responderspi 0 sainit msgid 0 hexpayload "434953434f2d5544502d454e43415000"
}

// Run ikev2_vendor_id_flow(vendor_appliance, vendor_gateway) to generate the
// capture.
compile {
    ikev2_vendor_id_flow(vendor_appliance, vendor_gateway)
}
