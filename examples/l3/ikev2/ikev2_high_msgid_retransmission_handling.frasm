// PROMPT: IKEv2 INFORMATIONAL message testing high message ID replay and window handling.
// TOKENS: host, ip, flow, init, ikev2, initiatorspi, responderspi, informational, msgid, compile

// INSTRUCTION: Define long-lived session initiator.
host long_session_init { ip 192.168.210.10 }

// INSTRUCTION: Define long-lived session responder.
host long_session_resp { ip 192.168.210.20 }

// INSTRUCTION: Define flow asserting large message ID 50000 for sliding window verification.
flow ikev2_high_msgid_flow(init, resp) {
    init -> resp ikev2 initiatorspi 1357924680135792 responderspi 2468013579246801 informational msgid 50000
}

// INSTRUCTION: Compile block executing high message-ID IKEv2 transmission.
compile {
    ikev2_high_msgid_flow(long_session_init, long_session_resp)
}
