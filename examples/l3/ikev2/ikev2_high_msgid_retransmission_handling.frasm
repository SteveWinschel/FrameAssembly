// IKEv2 INFORMATIONAL message testing high message ID replay and window
// handling.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host long_session_init { ip 192.168.210.10 }

host long_session_resp { ip 192.168.210.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_high_msgid_flow(init, resp) {
    init -> resp ikev2 initiatorspi 1357924680135792 responderspi 2468013579246801 informational msgid 50000
}

// Run ikev2_high_msgid_flow(long_session_init, long_session_resp) to generate
// the capture.
compile {
    ikev2_high_msgid_flow(long_session_init, long_session_resp)
}
