// IKEv2 INFORMATIONAL message carrying SA deletion payload to gracefully
// terminate tunnel.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host mobile_vpn_client { ip 10.45.0.99 }

host security_gateway { ip 10.45.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_teardown_flow(c, gw) {
    c -> gw ikev2 initiatorspi 4433221100998877 responderspi 8877665544332211 informational msgid 20 nextpayload 42
}

// Run ikev2_teardown_flow(mobile_vpn_client, security_gateway) to generate
// the capture.
compile {
    ikev2_teardown_flow(mobile_vpn_client, security_gateway)
}
