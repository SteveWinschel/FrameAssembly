// IKEv2 INFORMATIONAL keepalive and dead peer detection message exchange.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host ike_peer1 { ip 172.31.0.1 }

host ike_peer2 { ip 172.31.0.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ikev2_keepalive_flow(p1, p2) {
    p1 -> p2 ikev2 exchange informational msgid 10
    p1 <- p2 ikev2 exchange informational msgid 10
}

// Run ikev2_keepalive_flow(ike_peer1, ike_peer2) to generate the capture.
compile {
    ikev2_keepalive_flow(ike_peer1, ike_peer2)
}
