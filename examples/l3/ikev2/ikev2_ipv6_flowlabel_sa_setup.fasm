// PROMPT: IPv6 IKEv2 tunnel setup with explicit 64-bit SPIs, Flow Labels, and MAC addresses.
// TOKENS: HOST, IP, MAC, FLOW, IKEV2, SA_INIT, INITIATOR_SPI, RESPONDER_SPI, MSGID, FLAGS, NEXT_PAYLOAD, FLOWLABEL, DSCP, TTL, CREATE_CHILD_SA, COMPILE

// INSTRUCTION: Define IPv6 security gateway North.
HOST v6_ike_north { IP 2001:db8:7296:1::10 MAC 00:25:90:72:96:01 }

// INSTRUCTION: Define IPv6 security gateway South.
HOST v6_ike_south { IP 2001:db8:7296:2::20 MAC 00:25:90:72:96:02 }

// INSTRUCTION: Define IPv6 IKEv2 SA_INIT and CREATE_CHILD_SA negotiation with Flow Labels.
FLOW ikev2_ipv6_setup(n, s) {
    n -> s IKEV2 SA_INIT INITIATOR_SPI 900100200300 RESPONDER_SPI 0 MSGID 0 FLAGS 8 NEXT_PAYLOAD 33 FLOWLABEL 729601 DSCP 48 TTL 64
    n <- s IKEV2 SA_INIT INITIATOR_SPI 900100200300 RESPONDER_SPI 400500600700 MSGID 0 FLAGS 32 NEXT_PAYLOAD 33 FLOWLABEL 729602 DSCP 48 TTL 64
    n -> s IKEV2 CREATE_CHILD_SA INITIATOR_SPI 900100200300 RESPONDER_SPI 400500600700 MSGID 1 FLAGS 8 NEXT_PAYLOAD 46 FLOWLABEL 729601 DSCP 48 TTL 64
    n <- s IKEV2 CREATE_CHILD_SA INITIATOR_SPI 900100200300 RESPONDER_SPI 400500600700 MSGID 1 FLAGS 32 NEXT_PAYLOAD 46 FLOWLABEL 729602 DSCP 48 TTL 64
}

// INSTRUCTION: Compile the IPv6 Flow Label IKEv2 negotiation flow.
COMPILE {
    ikev2_ipv6_setup(v6_ike_north, v6_ike_south)
}
