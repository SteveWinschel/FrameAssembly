// PROMPT: IPv6 IKEv2 tunnel setup with explicit 64-bit SPIs, Flow Labels, and MAC addresses.
// TOKENS: host, ip, mac, flow, s, ikev2, sainit, initiatorspi, responderspi, msgid, flags, nextpayload, flowlabel, dscp, ttl, createchildsa, compile

// INSTRUCTION: Define IPv6 security gateway North.
host v6_ike_north { ip 2001:db8:7296:1::10 mac 00:25:90:72:96:01 }

// INSTRUCTION: Define IPv6 security gateway South.
host v6_ike_south { ip 2001:db8:7296:2::20 mac 00:25:90:72:96:02 }

// INSTRUCTION: Define IPv6 IKEv2 SA_INIT and CREATE_CHILD_SA negotiation with Flow Labels.
flow ikev2_ipv6_setup(n, s) {
    n -> s ikev2 sainit initiatorspi 900100200300 responderspi 0 msgid 0 flags 8 nextpayload 33 flowlabel 729601 dscp 48 ttl 64
    n <- s ikev2 sainit initiatorspi 900100200300 responderspi 400500600700 msgid 0 flags 32 nextpayload 33 flowlabel 729602 dscp 48 ttl 64
    n -> s ikev2 createchildsa initiatorspi 900100200300 responderspi 400500600700 msgid 1 flags 8 nextpayload 46 flowlabel 729601 dscp 48 ttl 64
    n <- s ikev2 createchildsa initiatorspi 900100200300 responderspi 400500600700 msgid 1 flags 32 nextpayload 46 flowlabel 729602 dscp 48 ttl 64
}

// INSTRUCTION: Compile the IPv6 Flow Label IKEv2 negotiation flow.
compile {
    ikev2_ipv6_setup(v6_ike_north, v6_ike_south)
}
