// PROMPT: Periodic IKEv2 Dead Peer Detection (DPD) INFORMATIONAL probes inside a COMPILE repeated flow calls.
// TOKENS: host, ip, flow, ikev2, informational, initiatorspi, responderspi, msgid, flags, nextpayload, wait, ms, compile

// INSTRUCTION: Define primary IPsec peer polling DPD liveliness.
host dpd_peer_left { ip 10.190.1.1 }

// INSTRUCTION: Define secondary IPsec peer acknowledging DPD probes.
host dpd_peer_right { ip 10.190.1.2 }

// INSTRUCTION: Define bidirectional IKEv2 DPD INFORMATIONAL exchange.
flow ikev2_dpd_cycle(l, r) {
    l -> r ikev2 informational initiatorspi 10102020 responderspi 30304040 msgid 50 flags 8 nextpayload 46 wait 20ms
    l <- r ikev2 informational initiatorspi 10102020 responderspi 30304040 msgid 50 flags 32 nextpayload 46 wait 20ms
}

// INSTRUCTION: Compile 4 consecutive IKEv2 DPD liveliness cycles.
compile {
    ikev2_dpd_cycle(dpd_peer_left, dpd_peer_right) // cycle 1
    ikev2_dpd_cycle(dpd_peer_left, dpd_peer_right) // cycle 2
    ikev2_dpd_cycle(dpd_peer_left, dpd_peer_right) // cycle 3
    ikev2_dpd_cycle(dpd_peer_left, dpd_peer_right) // cycle 4
}
