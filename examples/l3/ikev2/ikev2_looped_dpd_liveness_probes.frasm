// PROMPT: Consecutive IKEv2 INFORMATIONAL DPD heartbeats inside COMPILE LOOP to test tunnel state.
// TOKENS: host, ip, flow, ikev2, initiatorspi, responderspi, informational, msgid, wait, ms, compile

// INSTRUCTION: Define remote monitoring VPN peer.
host probe_vpn_peer { ip 10.75.0.10 }

// INSTRUCTION: Define central VPN concentrator.
host central_concentrator { ip 10.75.0.1 }

// INSTRUCTION: Define DPD keepalive probe flow with 50ms pause.
flow ikev2_loop_dpd(peer, conc) {
    peer -> conc ikev2 initiatorspi 1212343456567878 responderspi 8787656543432121 informational msgid 100 wait 50ms
}

// INSTRUCTION: Compile loop executing 3 periodic DPD keepalive transmissions.
compile {
    ikev2_loop_dpd(probe_vpn_peer, central_concentrator) // cycle 1
    ikev2_loop_dpd(probe_vpn_peer, central_concentrator) // cycle 2
    ikev2_loop_dpd(probe_vpn_peer, central_concentrator) // cycle 3
}
