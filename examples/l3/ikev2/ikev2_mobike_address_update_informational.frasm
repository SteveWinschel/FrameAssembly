// RFC 4555 MOBIKE roaming client sending authenticated INFORMATIONAL exchange
// to update tunnel endpoint address.
// This capture targets IPv6 endpoints, sets IPv6 Flow Label, and uses
// post-packet wait gaps (10ms) between frames.
// Wireshark: isakmp && ipv6

host mobike_client_v6 {
    ip 2001:db8:90:1::55
    mac 00:24:d7:90:01:55
}

host corp_headend_v6 {
    ip 2001:db8:10:1::1
    mac 00:24:d7:10:01:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ikev2_mobike_roam(cli, gw) {
    cli -> gw flowlabel 65536 ikev2 informational initiatorspi 44556677 responderspi 88990011 msgid 12 flags 8 nextpayload 46 payload "MOBIKE_UPDATE_SA_ADDRESSES_NAT_D" wait 10ms
    cli <- gw flowlabel 65536 ikev2 informational initiatorspi 44556677 responderspi 88990011 msgid 12 flags 32 nextpayload 46 payload "MOBIKE_COOKIE2_VERIFY_ACK"
}

// Run ikev2_mobike_roam(mobike_client_v6, corp_headend_v6) to generate the
// capture.
compile {
    ikev2_mobike_roam(mobike_client_v6, corp_headend_v6)
}
