// PROMPT: MPLS-labeled IKEv2 key management exchange traversing a provider core backbone.
// TOKENS: host, ip, flow, init, ikev2, sainit, initiatorspi, responderspi, msgid, mpls, exp, bos, mplsttl, informational, compile

// INSTRUCTION: Define MPLS PE crypto initiator.
host mpls_ike_init { ip 10.248.0.1 }

// INSTRUCTION: Define MPLS PE crypto responder.
host mpls_ike_resp { ip 10.248.0.2 }

// INSTRUCTION: Define MPLS-encapsulated IKEv2 SA_INIT and INFORMATIONAL exchange.
flow ikev2_mpls_core(init, resp) {
    init -> resp ikev2 sainit initiatorspi 888111 responderspi 0 msgid 0 mpls 50010 exp 6 bos 1 mplsttl 64
    init <- resp ikev2 sainit initiatorspi 888111 responderspi 888222 msgid 0 mpls 50020 exp 6 bos 1 mplsttl 64
    init -> resp ikev2 informational initiatorspi 888111 responderspi 888222 msgid 2 mpls 50010 exp 6 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the MPLS-labeled IKEv2 key management flow.
compile {
    ikev2_mpls_core(mpls_ike_init, mpls_ike_resp)
}
