// PROMPT: IKEv2 SA negotiation packets transported across an MPLS carrier backbone.
// TOKENS: host, ip, flow, ikev2, initiatorspi, responderspi, sainit, msgid, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define customer edge router initiating IPsec over MPLS.
host cust_ce_init { ip 10.222.1.1 }

// INSTRUCTION: Define customer edge router responding over MPLS.
host cust_ce_resp { ip 10.222.2.1 }

// INSTRUCTION: Define MPLS labeled IKEv2 SA_INIT packet with label 500100 and EXP 4.
flow ikev2_mpls_vpn_flow(ce1, ce2) {
    ce1 -> ce2 ikev2 initiatorspi 3141592653589793 responderspi 0 sainit msgid 0 mpls 500100 exp 4 bos 1 mplsttl 64
}

// INSTRUCTION: Compile block executing MPLS encapsulated IKEv2 packet.
compile {
    ikev2_mpls_vpn_flow(cust_ce_init, cust_ce_resp)
}
