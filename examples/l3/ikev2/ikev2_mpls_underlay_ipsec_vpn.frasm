// IKEv2 SA negotiation packets transported across an MPLS carrier backbone.
// This capture wraps frames in MPLS label 500100.
// Wireshark: isakmp && mpls

host cust_ce_init { ip 10.222.1.1 }

host cust_ce_resp { ip 10.222.2.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_mpls_vpn_flow(ce1, ce2) {
    ce1 -> ce2 ikev2 initiatorspi 3141592653589793 responderspi 0 sainit msgid 0 mpls 500100 exp 4 bos 1 mplsttl 64
}

// Run ikev2_mpls_vpn_flow(cust_ce_init, cust_ce_resp) to generate the
// capture.
compile {
    ikev2_mpls_vpn_flow(cust_ce_init, cust_ce_resp)
}
