// PROMPT: IKEv2 NAT-Traversal (NAT-T) floating from UDP port 500 to UDP port 4500 during authentication.
// TOKENS: HOST, IP, FLOW, IKEV2, SA_INIT, INITIATOR_SPI, RESPONDER_SPI, MSGID, SRCPORT, DSTPORT, INFORMATIONAL, COMPILE

// INSTRUCTION: Define NATed branch VPN client.
HOST natt_ike_client { IP 192.0.2.88 }

// INSTRUCTION: Define public VPN headend responder.
HOST natt_ike_server { IP 198.51.100.88 }

// INSTRUCTION: Define IKEv2 SA_INIT on UDP 500 followed by NAT-T port float to UDP 4500.
FLOW ikev2_natt_float(cli, srv) {
    cli -> srv IKEV2 SA_INIT INITIATOR_SPI 111222333 RESPONDER_SPI 0 MSGID 0 SRCPORT 500 DSTPORT 500
    cli <- srv IKEV2 SA_INIT INITIATOR_SPI 111222333 RESPONDER_SPI 444555666 MSGID 0 SRCPORT 500 DSTPORT 500
    cli -> srv IKEV2 INFORMATIONAL INITIATOR_SPI 111222333 RESPONDER_SPI 444555666 MSGID 1 SRCPORT 4500 DSTPORT 4500
    cli <- srv IKEV2 INFORMATIONAL INITIATOR_SPI 111222333 RESPONDER_SPI 444555666 MSGID 1 SRCPORT 4500 DSTPORT 4500
}

// INSTRUCTION: Compile the IKEv2 NAT-Traversal port 4500 float flow.
COMPILE {
    ikev2_natt_float(natt_ike_client, natt_ike_server)
}
