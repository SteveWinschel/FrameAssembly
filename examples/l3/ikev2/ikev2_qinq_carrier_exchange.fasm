// PROMPT: 802.1ad QinQ double-tagged IKEv2 negotiation across a carrier Ethernet transport link.
// TOKENS: host, ip, flow, ikev2, sainit, initiatorspi, responderspi, msgid, qinq, innervlan, createchildsa, compile

// INSTRUCTION: Define site 1 VPN appliance.
host qinq_ike_s1 { ip 172.26.50.1 }

// INSTRUCTION: Define site 2 VPN appliance.
host qinq_ike_s2 { ip 172.26.50.2 }

// INSTRUCTION: Define QinQ tagged IKEv2 negotiation on S-VLAN 2500 and C-VLAN 500.
flow ikev2_qinq_exchange(s1, s2) {
    s1 -> s2 ikev2 sainit initiatorspi 25005001 responderspi 0 msgid 0 qinq 2500 innervlan 500
    s1 <- s2 ikev2 sainit initiatorspi 25005001 responderspi 25005002 msgid 0 qinq 2500 innervlan 500
    s1 -> s2 ikev2 createchildsa initiatorspi 25005001 responderspi 25005002 msgid 1 qinq 2500 innervlan 500
}

// INSTRUCTION: Compile the QinQ carrier IKEv2 exchange flow.
compile {
    ikev2_qinq_exchange(qinq_ike_s1, qinq_ike_s2)
}
