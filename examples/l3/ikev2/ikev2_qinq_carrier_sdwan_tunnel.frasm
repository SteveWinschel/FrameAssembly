// QinQ dual-tagged IKEv2 exchange establishing SD-WAN tunnel over provider
// Ethernet.
// This capture wraps frames in QinQ S-VLAN 400 / C-VLAN 15.
// Wireshark: isakmp

host sdwan_cpe_edge { ip 172.29.10.1 }

host sdwan_cloud_gw { ip 172.29.10.254 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ikev2_qinq_sdwan(cpe, gw) {
    cpe -> gw ikev2 initiatorspi 5544332211009988 responderspi 0 sainit msgid 0 qinq 400 innervlan 15
}

// Run ikev2_qinq_sdwan(sdwan_cpe_edge, sdwan_cloud_gw) to generate the
// capture.
compile {
    ikev2_qinq_sdwan(sdwan_cpe_edge, sdwan_cloud_gw)
}
