// PROMPT: QinQ dual-tagged IKEv2 exchange establishing SD-WAN tunnel over provider Ethernet.
// TOKENS: host, ip, flow, ikev2, initiatorspi, responderspi, sainit, msgid, qinq, innervlan, compile

// INSTRUCTION: Define edge SD-WAN CPE appliance.
host sdwan_cpe_edge { ip 172.29.10.1 }

// INSTRUCTION: Define cloud SD-WAN gateway.
host sdwan_cloud_gw { ip 172.29.10.254 }

// INSTRUCTION: Define QinQ encapsulated IKEv2 negotiation with outer 400 and inner 15.
flow ikev2_qinq_sdwan(cpe, gw) {
    cpe -> gw ikev2 initiatorspi 5544332211009988 responderspi 0 sainit msgid 0 qinq 400 innervlan 15
}

// INSTRUCTION: Compile block executing QinQ encapsulated IKEv2 handshake.
compile {
    ikev2_qinq_sdwan(sdwan_cpe_edge, sdwan_cloud_gw)
}
