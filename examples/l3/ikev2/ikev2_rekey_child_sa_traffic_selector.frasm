// IKEv2 CREATE_CHILD_SA exchange rekeying IPsec Security Association with
// custom SPIs.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host branch_vpn_gw { ip 203.0.113.10 }

host hq_vpn_concentrator { ip 203.0.113.20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ikev2_rekey_flow(b, hq) {
    b -> hq ikev2 initiatorspi 9988776655443322 responderspi 1122334455667788 createchildsa msgid 4 nextpayload 33
    b <- hq ikev2 initiatorspi 9988776655443322 responderspi 1122334455667788 createchildsa msgid 4 nextpayload 33
}

// Run ikev2_rekey_flow(branch_vpn_gw, hq_vpn_concentrator) to generate the
// capture.
compile {
    ikev2_rekey_flow(branch_vpn_gw, hq_vpn_concentrator)
}
