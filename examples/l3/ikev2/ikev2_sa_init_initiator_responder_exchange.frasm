// PROMPT: Bidirectional IKE_SA_INIT exchange establishing initial Security Association on UDP 500.
// TOKENS: host, ip, flow, ikev2, initiatorspi, responderspi, sainit, msgid, compile

// INSTRUCTION: Define VPN client initiator node.
host vpn_client_init { ip 198.51.100.25 }

// INSTRUCTION: Define enterprise VPN gateway responder.
host vpn_gateway_resp { ip 198.51.100.1 }

// INSTRUCTION: Define bidirectional SA_INIT exchange with explicit SPI values and MSGID 0.
flow ikev2_sa_init_flow(c, gw) {
    c -> gw ikev2 initiatorspi 123456789012345678 responderspi 0 sainit msgid 0
    c <- gw ikev2 initiatorspi 123456789012345678 responderspi 987654321098765432 sainit msgid 0
}

// INSTRUCTION: Compile block executing bidirectional IKE_SA_INIT negotiation.
compile {
    ikev2_sa_init_flow(vpn_client_init, vpn_gateway_resp)
}
