// Internet Key Exchange version 2 security association initiation and
// authentication on UDP 500.
// This capture models UDP port 500/4500 IKEv2 key-exchange messages.
// Wireshark: isakmp

host ike_initiator { ip 203.0.113.1 }

host ike_responder { ip 203.0.113.2 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow ikev2_negotiation(init, resp) {
    init -> resp ikev2 exchange sainit
    init <- resp ikev2 exchange sainit
    init -> resp ikev2 exchange auth
    init <- resp ikev2 exchange auth
}

// Run ikev2_negotiation(ike_initiator, ike_responder) to generate the
// capture.
compile {
    ikev2_negotiation(ike_initiator, ike_responder)
}
