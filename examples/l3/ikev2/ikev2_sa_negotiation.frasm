// PROMPT: Internet Key Exchange version 2 security association initiation and authentication on UDP 500.
// TOKENS: host, ip, flow, init, ikev2, exchange, sainit, auth, compile

// INSTRUCTION: Define IKEv2 negotiation initiator.
host ike_initiator { ip 203.0.113.1 }

// INSTRUCTION: Define IKEv2 negotiation responder.
host ike_responder { ip 203.0.113.2 }

// INSTRUCTION: Define IKEv2 security association negotiation flow.
flow ikev2_negotiation(init, resp) {
    init -> resp ikev2 exchange sainit
    init <- resp ikev2 exchange sainit
    init -> resp ikev2 exchange auth
    init <- resp ikev2 exchange auth
}

// INSTRUCTION: Compile block executing IKEv2 negotiation exchange.
compile {
    ikev2_negotiation(ike_initiator, ike_responder)
}
