// PROMPT: 802.1Q VLAN-tagged IKEv2 security association negotiation over a WAN peering VLAN.
// TOKENS: host, ip, mac, flow, ikev2, sainit, initiatorspi, responderspi, msgid, vlan, pcp, dei, compile

// INSTRUCTION: Define WAN crypto edge 1 on VLAN 500.
host wan_ike_edge1 { ip 10.50.5.1 mac 00:1e:67:50:05:01 }

// INSTRUCTION: Define WAN crypto edge 2 on VLAN 500.
host wan_ike_edge2 { ip 10.50.5.2 mac 00:1e:67:50:05:02 }

// INSTRUCTION: Define VLAN 500 tagged IKEv2 SA_INIT exchange with PCP 6.
flow ikev2_vlan_peering(e1, e2) {
    e1 -> e2 ikev2 sainit initiatorspi 5001001 responderspi 0 msgid 0 vlan 500 pcp 6 dei 0
    e1 <- e2 ikev2 sainit initiatorspi 5001001 responderspi 5002002 msgid 0 vlan 500 pcp 6 dei 0
}

// INSTRUCTION: Compile the VLAN-tagged WAN IKEv2 peering flow.
compile {
    ikev2_vlan_peering(wan_ike_edge1, wan_ike_edge2)
}
