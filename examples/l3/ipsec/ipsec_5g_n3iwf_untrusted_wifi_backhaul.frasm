// 5G Non-3GPP InterWorking Function (N3IWF) IPsec tunnel protecting NAS and
// UPF user-plane traffic.
// This capture sets DSCP 46, carries SPI 700101/700202, and uses post-packet
// wait gaps (5ms) between frames.
// Wireshark: esp

host ue_wlan_client {
    ip 192.0.2.115
    mac 00:26:bb:02:00:73
}

host core_n3iwf_gw {
    ip 198.51.100.250
    mac 00:26:bb:64:00:fa
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ipsec_n3iwf_userplane(ue, n3iwf) {
    ue -> n3iwf dscp 46 ipsec spi 700101 seq 10 nextheader 4 iv "a1a2a3a4a5a6a7a8" icv "b1b2b3b4b5b6b7b8b9babbbc" payload "5g_ul_pdu_session_gre_encap" wait 5ms
    ue <- n3iwf dscp 46 ipsec spi 700202 seq 10 nextheader 4 iv "c1c2c3c4c5c6c7c8" icv "d1d2d3d4d5d6d7d8d9dadbdc" payload "5g_dl_pdu_session_gre_encap"
}

// Run ipsec_n3iwf_userplane(ue_wlan_client, core_n3iwf_gw) to generate the
// capture.
compile {
    ipsec_n3iwf_userplane(ue_wlan_client, core_n3iwf_gw)
}
