// IPsec ESP packet sequence advancing anti-replay verification window.
// This capture carries SPI 91000 and uses post-packet wait gaps (1ms) between
// frames.
// Wireshark: esp

host fin_tx_gw { ip 10.160.12.1 }

host clearing_hub { ip 10.160.12.254 }

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow ipsec_seq_advancement(src, dst) {
    src -> dst ipsec spi 91000 seq 1000 wait 1ms
    src -> dst ipsec spi 91000 seq 1001 wait 1ms
    src -> dst ipsec spi 91000 seq 1002 wait 1ms
    src -> dst ipsec spi 91000 seq 1003
}

// Run ipsec_seq_advancement(fin_tx_gw, clearing_hub) to generate the capture.
compile {
    ipsec_seq_advancement(fin_tx_gw, clearing_hub)
}
