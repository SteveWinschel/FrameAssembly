// Capture a bidirectional IPsec security association pair using distinct
// inbound and outbound SPIs over IPv4 and IPv6.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs,
// carries SPI 100500/200500, and uses post-packet wait gaps (10ms) between
// frames.
// Wireshark: esp

host hub_v4 {
    ip 172.22.10.1
    mac 00:25:90:b1:10:01
}

host spoke_v4 {
    ip 172.22.10.2
    mac 00:25:90:b1:10:02
}

host hub_v6 {
    ip 2001:db8:2210::1
    mac 00:25:90:b1:10:11
}

host spoke_v6 {
    ip 2001:db8:2210::2
    mac 00:25:90:b1:10:12
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow ipsec_bidirectional_sa(hub, spoke) {
    hub -> spoke ipsec spi 100500 seq 1 nextheader 4 payload "outbound-sa-data-1" wait 10ms
    spoke -> hub ipsec spi 200500 seq 1 nextheader 4 payload "inbound-sa-data-1" wait 10ms
    hub -> spoke ipsec spi 100500 seq 2 nextheader 4 payload "outbound-sa-data-2" wait 10ms
    spoke -> hub ipsec spi 200500 seq 2 nextheader 4 payload "inbound-sa-data-2"
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    ipsec_bidirectional_sa(hub_v4, spoke_v4)
    ipsec_bidirectional_sa(hub_v6, spoke_v6)
}
