// IPsec security gateway exchanging protected traffic across IPv6 endpoints.
// This capture targets IPv6 endpoints and carries SPI 16384.
// Wireshark: esp && ipv6

host ipsec_v6_site_a { ip 2001:db8:8000::1 }

host ipsec_v6_site_b { ip 2001:db8:8000::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ipsec_v6_flow(a, b) {
    a -> b ipsec spi 16384 seq 1
}

// Run ipsec_v6_flow(ipsec_v6_site_a, ipsec_v6_site_b) to generate the
// capture.
compile {
    ipsec_v6_flow(ipsec_v6_site_a, ipsec_v6_site_b)
}
