// IPsec ESP frame marked with Explicit Congestion Notification Congestion
// Experienced (ECN 3).
// This capture sets DSCP 18 and carries SPI 44300.
// Wireshark: esp

host wan_edge_router { ip 192.0.2.14 }

host sec_appliance_peer { ip 192.0.2.29 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ipsec_ecn_flow(rtr, sec) {
    rtr -> sec ipsec spi 44300 seq 77 dscp 18 ecn 3
}

// Run ipsec_ecn_flow(wan_edge_router, sec_appliance_peer) to generate the
// capture.
compile {
    ipsec_ecn_flow(wan_edge_router, sec_appliance_peer)
}
