// PROMPT: Host-to-host IPsec Transport Mode (NEXT_HEADER 6) protecting a low-latency FIX trading session.
// TOKENS: host, ip, mac, flow, dscp, df, ipsec, spi, seq, nextheader, iv, icv, payload, wait, ms, compile

// INSTRUCTION: Define buy-side order management gateway encrypting outbound TCP FIX messages.
host fix_oms_initiator {
    ip 10.77.10.11
    mac 00:0f:53:4d:0a:0b
}

// INSTRUCTION: Define sell-side matching engine gateway decrypting inbound IPsec transport frames.
host fix_match_acceptor {
    ip 10.77.10.22
    mac 00:0f:53:4d:0a:16
}

// INSTRUCTION: Transmit sequential Transport Mode IPsec packets (Next Header 6 for TCP) with AES-GCM IV and ICV.
flow ipsec_fix_transport(oms, match_eng) {
    oms -> match_eng dscp 46 df ipsec spi 31001 seq 501 nextheader 6 iv "00000000000001f5" icv "1a2b3c4d5e6f7a8b9c0d1e2f" payload "8=FIX.4.4|35=D|49=BUY|56=SELL|38=500" wait 2ms
    oms <- match_eng dscp 46 df ipsec spi 32002 seq 501 nextheader 6 iv "00000000000001f5" icv "f2e1d0c9b8a7f6e5d4c3b2a1" payload "8=FIX.4.4|35=8|49=SELL|56=BUY|39=2"
}

// INSTRUCTION: Compile the low-latency IPsec Transport Mode FIX trading exchange.
compile {
    ipsec_fix_transport(fix_oms_initiator, fix_match_acceptor)
}
