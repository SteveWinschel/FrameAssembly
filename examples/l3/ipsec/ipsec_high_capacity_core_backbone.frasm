// High capacity backbone core router IPsec encryption with custom DSCP Class
// Selector 4.
// This capture sets DSCP 32, TTL 128 and carries SPI 888100.
// Wireshark: esp

host core_router_fra { ip 172.18.1.1 }

host core_router_lon { ip 172.18.1.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow backbone_ipsec_flow(fra, lon) {
    fra -> lon ipsec spi 888100 seq 9999 dscp 32 ttl 128
}

// Run backbone_ipsec_flow(core_router_fra, core_router_lon) to generate the
// capture.
compile {
    backbone_ipsec_flow(core_router_fra, core_router_lon)
}
