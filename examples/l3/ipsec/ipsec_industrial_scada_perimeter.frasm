// Substation SCADA perimeter gateway protecting RTU telemetry via IPsec ESP.
// This capture sets TTL 32 and carries SPI 123456.
// Wireshark: esp

host scada_substation_gw { ip 10.99.4.1 mac 00:1c:73:99:04:01 }

host energy_ops_center { ip 10.99.100.10 mac 00:1c:73:99:64:0a }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow scada_ipsec_telemetry(sub, ops) {
    sub -> ops ipsec spi 123456 seq 42 ttl 32 payload "DNP3_IEC61850_TELEMETRY_PAYLOAD"
}

// Run scada_ipsec_telemetry(scada_substation_gw, energy_ops_center) to
// generate the capture.
compile {
    scada_ipsec_telemetry(scada_substation_gw, energy_ops_center)
}
