// Cloud VPC interconnect over IPv6 IPsec transport with custom SPI
// parameters.
// This capture targets IPv6 endpoints and carries SPI 90123/90124.
// Wireshark: esp && ipv6

host aws_transit_gw { ip 2001:db8:a001::1 }

host gcp_cloud_router { ip 2001:db8:b002::2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow cloud_peering_ipsec(aws, gcp) {
    aws -> gcp ipsec spi 90123 seq 1
    aws <- gcp ipsec spi 90124 seq 1
}

// Run cloud_peering_ipsec(aws_transit_gw, gcp_cloud_router) to generate the
// capture.
compile {
    cloud_peering_ipsec(aws_transit_gw, gcp_cloud_router)
}
