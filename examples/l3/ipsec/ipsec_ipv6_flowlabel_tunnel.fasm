// PROMPT: Build an IPv6 IPsec tunnel flow utilizing IPv6 Flow Labels, DSCP traffic classes, and ECN bits
// TOKENS: host, ip, mac, flow, ipsec, spi, seq, nextheader, flowlabel, dscp, ecn, ttl, payload, wait, ms, compile

// INSTRUCTION: Define the IPv6 regional gateway A
host v6_gw_alpha {
    ip 2001:db8:900:a::1
    mac 00:50:56:d1:0a:01
}

// INSTRUCTION: Define the IPv6 regional gateway B
host v6_gw_beta {
    ip 2001:db8:900:b::1
    mac 00:50:56:d1:0b:01
}

// INSTRUCTION: Send IPv6 IPsec packets with explicit Flow Labels for ECMP hashing
flow ipsec_v6_flowlabel_sa(gw_a, gw_b) {
    gw_a -> gw_b ipsec spi 500101 seq 1 nextheader 41 flowlabel 262144 dscp 34 ecn 2 ttl 64 payload "ipv6-in-ipv6-ipsec-stream" wait 15ms
    gw_b -> gw_a ipsec spi 500102 seq 1 nextheader 41 flowlabel 524288 dscp 34 ecn 2 ttl 64 payload "ipv6-in-ipv6-ipsec-ack"
}

// INSTRUCTION: Compile the IPv6 Flow Label IPsec exchange
compile {
    ipsec_v6_flowlabel_sa(v6_gw_alpha, v6_gw_beta)
}
