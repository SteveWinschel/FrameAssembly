// Build an IPv6 IPsec tunnel flow utilizing IPv6 Flow Labels, DSCP traffic
// classes, and ECN bits.
// This capture targets IPv6 endpoints, sets DSCP 34, TTL 64, IPv6 Flow Label,
// carries SPI 500101/500102, and uses post-packet wait gaps (15ms) between
// frames.
// Wireshark: esp && ipv6

host v6_gw_alpha {
    ip 2001:db8:900:a::1
    mac 00:50:56:d1:0a:01
}

host v6_gw_beta {
    ip 2001:db8:900:b::1
    mac 00:50:56:d1:0b:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ipsec_v6_flowlabel_sa(gw_a, gw_b) {
    gw_a -> gw_b ipsec spi 500101 seq 1 nextheader 41 flowlabel 262144 dscp 34 ecn 2 ttl 64 payload "ipv6-in-ipv6-ipsec-stream" wait 15ms
    gw_b -> gw_a ipsec spi 500102 seq 1 nextheader 41 flowlabel 524288 dscp 34 ecn 2 ttl 64 payload "ipv6-in-ipv6-ipsec-ack"
}

// Run ipsec_v6_flowlabel_sa(v6_gw_alpha, v6_gw_beta) to generate the capture.
compile {
    ipsec_v6_flowlabel_sa(v6_gw_alpha, v6_gw_beta)
}
