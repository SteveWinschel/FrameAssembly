// Mobile IPv6 node establishing IPsec protected communication with home
// agent.
// This capture targets IPv6 endpoints, sets IPv6 Flow Label, and carries SPI
// 77701/77702.
// Wireshark: esp && ipv6

host mobile_ipv6_node { ip 2001:db8:cafe:11::99 }

host home_agent_v6 { ip 2001:db8:cafe:ff::1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow mobile_ipsec_v6_flow(node, ha) {
    node -> ha ipsec spi 77701 seq 12 flowlabel 104857
    node <- ha ipsec spi 77702 seq 15 flowlabel 104857
}

// Run mobile_ipsec_v6_flow(mobile_ipv6_node, home_agent_v6) to generate the
// capture.
compile {
    mobile_ipsec_v6_flow(mobile_ipv6_node, home_agent_v6)
}
