// IPsec encrypted tunnel packets transported across an MPLS label-switched
// core.
// This capture wraps frames in MPLS label 43030/43031 and carries SPI
// 430301/430302.
// Wireshark: esp && mpls

host pe_ipsec_west { ip 10.247.1.1 }

host pe_ipsec_east { ip 10.247.1.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ipsec_mpls_core(w, e) {
    w -> e ipsec spi 430301 seq 20 mpls 43030 exp 4 bos 1 mplsttl 64
    w <- e ipsec spi 430302 seq 20 mpls 43031 exp 4 bos 1 mplsttl 64
}

// Run ipsec_mpls_core(pe_ipsec_west, pe_ipsec_east) to generate the capture.
compile {
    ipsec_mpls_core(pe_ipsec_west, pe_ipsec_east)
}
