// PROMPT: Dual-SA IPsec tunnel segregating voice (DSCP EF) and bulk replication (DSCP AF11) onto distinct SPIs.
// TOKENS: host, ip, mac, flow, dscp, ipsec, spi, seq, iv, icv, payload, wait, ms, compile

// INSTRUCTION: Define branch office SD-WAN router classifying traffic across per-QoS IPsec Child SAs.
host branch_sdwan_cpe {
    ip 172.25.10.2
    mac 00:1c:73:19:0a:02
}

// INSTRUCTION: Define regional hub VPN concentrator terminating per-QoS IPsec Child SAs.
host hub_vpn_headend {
    ip 172.25.10.1
    mac 00:1c:73:19:0a:01
}

// INSTRUCTION: Send voice RTP over SPI 80001 (DSCP 46) and bulk backup over SPI 80002 (DSCP 10) without anti-replay drops.
flow ipsec_qos_dual_spi(cpe, hub) {
    cpe -> hub dscp 46 ipsec spi 80001 seq 1 iv "1000000000000001" icv "aaaa1111bbbb2222cccc3333" payload "voip_g711_frame_spi_80001" wait 5ms
    cpe -> hub dscp 10 ipsec spi 80002 seq 1 iv "2000000000000001" icv "dddd4444eeee5555ffff6666" payload "bulk_replication_spi_80002" wait 5ms
    cpe -> hub dscp 46 ipsec spi 80001 seq 2 iv "1000000000000002" icv "1111aaaa2222bbbb3333cccc" payload "voip_g711_frame_spi_80001_seq2"
}

// INSTRUCTION: Compile the multi-SA QoS-segregated IPsec tunnel scenario.
compile {
    ipsec_qos_dual_spi(branch_sdwan_cpe, hub_vpn_headend)
}
