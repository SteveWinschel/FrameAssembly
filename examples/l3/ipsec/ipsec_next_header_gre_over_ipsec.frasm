// GRE-over-IPsec transport mode specifying Next Header 47 (GRE) inside IPsec
// encapsulation.
// This capture carries SPI 47001/47002.
// Wireshark: esp

host dmvpn_ipsec_hub { ip 172.16.254.1 }

host dmvpn_ipsec_spoke { ip 172.16.254.10 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow gre_over_ipsec_flow(hub, spoke) {
    hub -> spoke ipsec spi 47001 seq 10 nextheader 47 payload "ENCRYPTED_GRE_NHRP_PACKET"
    hub <- spoke ipsec spi 47002 seq 10 nextheader 47 payload "ENCRYPTED_GRE_NHRP_REPLY"
}

// Run gre_over_ipsec_flow(dmvpn_ipsec_hub, dmvpn_ipsec_spoke) to generate the
// capture.
compile {
    gre_over_ipsec_flow(dmvpn_ipsec_hub, dmvpn_ipsec_spoke)
}
