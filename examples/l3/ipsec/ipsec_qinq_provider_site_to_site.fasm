// PROMPT: 802.1ad QinQ double-tagged site-to-site IPsec tunnel over a metro Ethernet provider.
// TOKENS: host, ip, flow, ipsec, spi, seq, iv, qinq, innervlan, compile

// INSTRUCTION: Define metro site 1 IPsec router.
host qinq_ipsec_s1 { ip 172.23.10.1 }

// INSTRUCTION: Define metro site 2 IPsec router.
host qinq_ipsec_s2 { ip 172.23.10.2 }

// INSTRUCTION: Define QinQ double-tagged IPsec exchange on S-VLAN 2300 and C-VLAN 100.
flow ipsec_qinq_site(s1, s2) {
    s1 -> s2 ipsec spi 23100 seq 5 iv "1122334455667788" qinq 2300 innervlan 100
    s1 <- s2 ipsec spi 23200 seq 5 iv "8877665544332211" qinq 2300 innervlan 100
}

// INSTRUCTION: Compile the QinQ provider site-to-site IPsec flow.
compile {
    ipsec_qinq_site(qinq_ipsec_s1, qinq_ipsec_s2)
}
