// 802.1ad QinQ double-tagged site-to-site IPsec tunnel over a metro Ethernet
// provider.
// This capture wraps frames in QinQ S-VLAN 2300 / C-VLAN 100 and carries SPI
// 23100/23200.
// Wireshark: esp

host qinq_ipsec_s1 { ip 172.23.10.1 }

host qinq_ipsec_s2 { ip 172.23.10.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ipsec_qinq_site(s1, s2) {
    s1 -> s2 ipsec spi 23100 seq 5 iv "1122334455667788" qinq 2300 innervlan 100
    s1 <- s2 ipsec spi 23200 seq 5 iv "8877665544332211" qinq 2300 innervlan 100
}

// Run ipsec_qinq_site(qinq_ipsec_s1, qinq_ipsec_s2) to generate the capture.
compile {
    ipsec_qinq_site(qinq_ipsec_s1, qinq_ipsec_s2)
}
