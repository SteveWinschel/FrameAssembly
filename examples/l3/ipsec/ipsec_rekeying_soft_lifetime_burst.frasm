// Periodic IPsec security association heartbeat burst across repeated cycles
// in compile.
// This capture carries SPI 88000, executes 5 cycles in compile, and uses
// post-packet wait gaps (10ms) between frames.
// Wireshark: esp

host bank_gw_a { ip 10.220.5.10 }

host bank_gw_b { ip 10.220.5.20 }

// Packet sequence (1 frame); wait pauses after a packet before the next.
flow ipsec_heartbeat_flow(g1, g2) {
    g1 -> g2 ipsec spi 88000 seq 500 wait 10ms
}

// Emit 5 sequential cycles of ipsec_heartbeat_flow.
compile {
    ipsec_heartbeat_flow(bank_gw_a, bank_gw_b) // cycle 1
    ipsec_heartbeat_flow(bank_gw_a, bank_gw_b) // cycle 2
    ipsec_heartbeat_flow(bank_gw_a, bank_gw_b) // cycle 3
    ipsec_heartbeat_flow(bank_gw_a, bank_gw_b) // cycle 4
    ipsec_heartbeat_flow(bank_gw_a, bank_gw_b) // cycle 5
}
