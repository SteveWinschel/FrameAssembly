// Enterprise branch-to-headquarters IPsec VPN transit marked with DSCP EF.
// This capture sets DSCP 46, TTL 64 and carries SPI 65536/65537.
// Wireshark: esp

host branch_store_gw { ip 172.24.10.1 }

host hq_vpn_concentrator { ip 172.24.100.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow branch_hq_ipsec_flow(br, hq) {
    br -> hq ipsec spi 65536 seq 50 dscp 46 ttl 64
    br <- hq ipsec spi 65537 seq 80 dscp 46 ttl 64
}

// Run branch_hq_ipsec_flow(branch_store_gw, hq_vpn_concentrator) to generate
// the capture.
compile {
    branch_hq_ipsec_flow(branch_store_gw, hq_vpn_concentrator)
}
