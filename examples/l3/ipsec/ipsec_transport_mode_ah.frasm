// IPsec security association advancing sequence numbers across tunnel
// endpoints.
// This capture carries SPI 8192.
// Wireshark: esp

host secure_client { ip 10.10.1.5 }

host secure_server { ip 10.10.1.10 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ipsec_seq_flow(cli, srv) {
    cli -> srv ipsec spi 8192 seq 100
    cli -> srv ipsec spi 8192 seq 101
}

// Run ipsec_seq_flow(secure_client, secure_server) to generate the capture.
compile {
    ipsec_seq_flow(secure_client, secure_server)
}
