// IPsec tunnel mode security encapsulation using SPI and sequence number.
// This capture carries SPI 4096.
// Wireshark: esp

host vpn_gw_primary { ip 198.51.100.1 }

host vpn_gw_secondary { ip 198.51.100.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ipsec_tunnel_flow(gw1, gw2) {
    gw1 -> gw2 ipsec spi 4096 seq 1
}

// Run ipsec_tunnel_flow(vpn_gw_primary, vpn_gw_secondary) to generate the
// capture.
compile {
    ipsec_tunnel_flow(vpn_gw_primary, vpn_gw_secondary)
}
