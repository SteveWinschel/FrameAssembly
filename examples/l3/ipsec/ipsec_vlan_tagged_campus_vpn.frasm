// 802.1Q VLAN-tagged IPsec packets traversing a segmented campus security
// zone.
// This capture wraps frames in 802.1Q VLAN 750 and carries SPI 75001/75002.
// Wireshark: esp && vlan.id == 750

host enclave_fw_left { ip 10.75.10.1 mac 00:1e:67:75:10:01 }

host dc_crypto_right { ip 10.75.10.2 mac 00:1e:67:75:10:02 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ipsec_campus_vlan(l, r) {
    l -> r ipsec spi 75001 seq 1 vlan 750 pcp 5 dei 0
    l <- r ipsec spi 75002 seq 1 vlan 750 pcp 5 dei 0
}

// Run ipsec_campus_vlan(enclave_fw_left, dc_crypto_right) to generate the
// capture.
compile {
    ipsec_campus_vlan(enclave_fw_left, dc_crypto_right)
}
