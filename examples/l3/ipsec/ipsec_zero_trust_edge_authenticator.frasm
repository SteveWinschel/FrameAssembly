// Zero Trust network access edge node establishing IPsec channel to policy
// enforcement point.
// This capture carries SPI 314159/314160.
// Wireshark: esp

host ztna_edge_connector { ip 172.30.50.15 }

host ztna_pep_gateway { ip 172.30.50.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ztna_ipsec_handshake(edge, pep) {
    edge -> pep ipsec spi 314159 seq 1 iv "0011223344556677"
    edge <- pep ipsec spi 314160 seq 1 iv "8899aabbccddeeff"
}

// Run ztna_ipsec_handshake(ztna_edge_connector, ztna_pep_gateway) to generate
// the capture.
compile {
    ztna_ipsec_handshake(ztna_edge_connector, ztna_pep_gateway)
}
