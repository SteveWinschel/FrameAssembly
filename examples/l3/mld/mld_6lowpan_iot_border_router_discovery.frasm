// IPv6 IoT border router querying 6LoWPAN sensor nodes for link-scope CoAP
// multicast group ff02::fd membership.
// This capture targets IPv6 endpoints, sets TTL 1, and uses post-packet wait
// gaps (15ms) between frames.
// Wireshark: icmpv6.mld

host iot_border_rtr {
    ip fe80::600:1
    mac 00:12:4b:00:06:01
}

host coap_sensor_node {
    ip fe80::600:42
    mac 00:12:4b:00:06:42
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_coap_group_sync(rtr, sensor) {
    rtr -> sensor ttl 1 mld query multicastaddr ff02::fd maxrespdelay 2000 wait 15ms
    rtr <- sensor ttl 1 mld report multicastaddr ff02::fd maxrespdelay 0
}

// Run mld_coap_group_sync(iot_border_rtr, coap_sensor_node) to generate the
// capture.
compile {
    mld_coap_group_sync(iot_border_rtr, coap_sensor_node)
}
