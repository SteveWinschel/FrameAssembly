// PROMPT: Capture multiple IPv6 hosts reporting multicast group membership and one host sending MLD Done to all-routers multicast
// TOKENS: host, ip, mac, flow, mld, report, multicastaddr, maxrespdelay, srcmac, dstmac, ttl, wait, ms, done, query, compile

// INSTRUCTION: Define the first cluster node participating in an IPv6 multicast group
host cluster_node_1 {
    ip fe80::10:1
    mac 00:16:3e:c9:10:01
}

// INSTRUCTION: Define the second cluster node participating in the same IPv6 multicast group
host cluster_node_2 {
    ip fe80::10:2
    mac 00:16:3e:c9:10:02
}

// INSTRUCTION: Define the IPv6 multicast router on the cluster network
host cluster_mrouter {
    ip fe80::10:fe
    mac 00:16:3e:c9:10:fe
}

// INSTRUCTION: Both nodes report membership, node 1 leaves to 33:33:00:00:00:02, and node 2 re-confirms
flow mld_cluster_leave_sequence(n1, n2, rtr) {
    n1 -> rtr mld report multicastaddr ff05::c100:1 maxrespdelay 0 srcmac 00:16:3e:c9:10:01 dstmac 33:33:c1:00:00:01 ttl 1 wait 10ms
    n2 -> rtr mld report multicastaddr ff05::c100:1 maxrespdelay 0 srcmac 00:16:3e:c9:10:02 dstmac 33:33:c1:00:00:01 ttl 1 wait 30ms
    n1 -> rtr mld done multicastaddr ff05::c100:1 maxrespdelay 0 srcmac 00:16:3e:c9:10:01 dstmac 33:33:00:00:00:02 ttl 1 wait 10ms
    rtr -> n2 mld query multicastaddr ff05::c100:1 maxrespdelay 1000 ttl 1 wait 10ms
    n2 -> rtr mld report multicastaddr ff05::c100:1 maxrespdelay 0 srcmac 00:16:3e:c9:10:02 dstmac 33:33:c1:00:00:01 ttl 1
}

// INSTRUCTION: Compile the cluster multicast leave and re-confirmation trace
compile {
    mld_cluster_leave_sequence(cluster_node_1, cluster_node_2, cluster_mrouter)
}
