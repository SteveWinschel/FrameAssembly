// Minimal MLD (Multicast Listener Discovery) Listener Report starter packet
// sent over ICMPv6 Next Header 58 toward link-local all-nodes multicast
// ff02::1 (MAC 33:33:00:00:00:01). Useful for quick MLD snooping and IPv6
// multicast lab checks.
// Wireshark: icmpv6.mld

host endpoint_a {
    ip 2001:db8:58::10
    mac 02:00:58:00:00:10
}

host endpoint_b {
    ip 2001:db8:58::1
    mac 02:00:58:00:00:01
}

// Transmit one default MLD Listener Report directly inside compile.
compile {
    endpoint_a -> endpoint_b mld
}
