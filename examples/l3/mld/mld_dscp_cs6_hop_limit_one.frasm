// Construct an MLD control-plane exchange enforcing DSCP CS6 traffic class
// and IPv6 Hop Limit 1.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 1, and uses
// post-packet wait gaps (15ms) between frames.
// Wireshark: icmpv6.mld

host core_mrouter_v6 {
    ip fe80::c0:1
    mac 00:26:99:c6:01:01
}

host dist_host_v6 {
    ip fe80::c0:25
    mac 00:26:99:c6:01:25
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_dscp_cs6_exchange(router, host) {
    router -> host mld query multicastaddr ff05::100:200 maxrespdelay 3000 dscp 48 ecn 0 ttl 1 wait 15ms
    host -> router mld report multicastaddr ff05::100:200 maxrespdelay 0 dscp 48 ecn 0 ttl 1
}

// Run mld_dscp_cs6_exchange(core_mrouter_v6, dist_host_v6) to generate the
// capture.
compile {
    mld_dscp_cs6_exchange(core_mrouter_v6, dist_host_v6)
}
