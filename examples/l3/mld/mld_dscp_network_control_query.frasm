// MLD query prioritizing control traffic with DSCP Class Selector 6.
// This capture targets IPv6 endpoints and sets DSCP 48.
// Wireshark: icmpv6.mld

host campus_querier_sw { ip fe80::c001:1 }

host campus_nodes { ip ff02::1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_dscp_control_flow(sw, nodes) {
    sw -> nodes mld query dscp 48
}

// Run mld_dscp_control_flow(campus_querier_sw, campus_nodes) to generate the
// capture.
compile {
    mld_dscp_control_flow(campus_querier_sw, campus_nodes)
}
