// Secondary querier observing higher priority querier General Query.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host primary_querier { ip fe80::1 }

host all_nodes_link { ip ff02::1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow querier_election_flow(p_q, nodes) {
    p_q -> nodes mld query maxrespdelay 10000
}

// Run querier_election_flow(primary_querier, all_nodes_link) to generate the
// capture.
compile {
    querier_election_flow(primary_querier, all_nodes_link)
}
