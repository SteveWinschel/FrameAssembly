// Periodic MLD General Query sent by IPv6 multicast querier to all-nodes
// address.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host mld_querier_rtr { ip fe80::100 }

host mld_all_nodes_grp { ip ff02::1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_periodic_query(q, grp) {
    q -> grp mld query maxrespdelay 10000
}

// Run mld_periodic_query(mld_querier_rtr, mld_all_nodes_grp) to generate the
// capture.
compile {
    mld_periodic_query(mld_querier_rtr, mld_all_nodes_grp)
}
