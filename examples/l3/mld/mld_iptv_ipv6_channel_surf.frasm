// Capture an IPv6 IPTV set-top box channel surf sequence using MLD Done and
// Report messages.
// This capture targets IPv6 endpoints, sets TTL 1, and uses post-packet wait
// gaps (50ms, 5ms) between frames.
// Wireshark: icmpv6.mld

host stb_v6 {
    ip 2001:db8:400:10::55
    mac 00:16:3e:c2:10:55
}

host bng_mrouter {
    ip 2001:db8:400:10::1
    mac 00:16:3e:c2:10:01
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow mld_iptv_channel_surf(stb, bng) {
    stb -> bng mld report multicastaddr ff3e::8000:101 maxrespdelay 0 ttl 1 wait 50ms
    stb -> bng mld done multicastaddr ff3e::8000:101 maxrespdelay 0 ttl 1 wait 5ms
    bng -> stb mld query multicastaddr ff3e::8000:101 maxrespdelay 500 ttl 1 wait 5ms
    stb -> bng mld report multicastaddr ff3e::8000:102 maxrespdelay 0 ttl 1
}

// Run mld_iptv_channel_surf(stb_v6, bng_mrouter) to generate the capture.
compile {
    mld_iptv_channel_surf(stb_v6, bng_mrouter)
}
