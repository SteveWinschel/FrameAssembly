// PROMPT: Generate an MLD Report and Done exchange with explicit IPv6 Flow Labels and custom multicast MAC addresses
// TOKENS: host, ip, mac, flow, mld, report, multicastaddr, maxrespdelay, flowlabel, dstmac, ttl, wait, ms, done, compile

// INSTRUCTION: Define the IPv6 telemetry subscriber host
host telemetry_sub {
    ip 2001:db8:770::50
    mac 00:1b:21:c7:00:50
}

// INSTRUCTION: Define the IPv6 multicast router interface
host telemetry_rtr {
    ip 2001:db8:770::1
    mac 00:1b:21:c7:00:01
}

// INSTRUCTION: Send MLD Report and Done messages using an explicit IPv6 Flow Label and IPv6 multicast MAC
flow mld_flowlabel_signaling(sub, rtr) {
    sub -> rtr mld report multicastaddr ff15::9900:1 maxrespdelay 0 flowlabel 393216 dstmac 33:33:99:00:00:01 ttl 1 wait 30ms
    sub -> rtr mld done multicastaddr ff15::9900:1 maxrespdelay 0 flowlabel 393216 dstmac 33:33:00:00:00:02 ttl 1
}

// INSTRUCTION: Compile the IPv6 Flow Label MLD signaling trace
compile {
    mld_flowlabel_signaling(telemetry_sub, telemetry_rtr)
}
