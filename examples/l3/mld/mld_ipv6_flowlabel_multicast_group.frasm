// Generate an MLD Report and Done exchange with explicit IPv6 Flow Labels and
// custom multicast MAC addresses.
// This capture targets IPv6 endpoints, sets TTL 1, IPv6 Flow Label, and uses
// post-packet wait gaps (30ms) between frames.
// Wireshark: icmpv6.mld

host telemetry_sub {
    ip 2001:db8:770::50
    mac 00:1b:21:c7:00:50
}

host telemetry_rtr {
    ip 2001:db8:770::1
    mac 00:1b:21:c7:00:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_flowlabel_signaling(sub, rtr) {
    sub -> rtr mld report multicastaddr ff15::9900:1 maxrespdelay 0 flowlabel 393216 dstmac 33:33:99:00:00:01 ttl 1 wait 30ms
    sub -> rtr mld done multicastaddr ff15::9900:1 maxrespdelay 0 flowlabel 393216 dstmac 33:33:00:00:00:02 ttl 1
}

// Run mld_flowlabel_signaling(telemetry_sub, telemetry_rtr) to generate the
// capture.
compile {
    mld_flowlabel_signaling(telemetry_sub, telemetry_rtr)
}
