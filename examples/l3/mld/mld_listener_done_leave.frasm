// MLD Listener Done message terminating membership in IPv6 multicast stream.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host leaving_node { ip fe80::500 }

host all_ipv6_routers { ip ff02::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_done_flow(node, rtr) {
    node -> rtr mld done multicastaddr ff02::1:2
}

// Run mld_done_flow(leaving_node, all_ipv6_routers) to generate the capture.
compile {
    mld_done_flow(leaving_node, all_ipv6_routers)
}
