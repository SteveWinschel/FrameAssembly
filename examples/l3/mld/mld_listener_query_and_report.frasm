// Multicast Listener Discovery query and membership report on IPv6 network.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host mld_router { ip fe80::1 }

host mld_host { ip ff02::1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow mld_mgmt(r, h) {
    r -> h mld query
    r -> h mld report multicastaddr ff02::1:2
}

// Run mld_mgmt(mld_router, mld_host) to generate the capture.
compile {
    mld_mgmt(mld_router, mld_host)
}
