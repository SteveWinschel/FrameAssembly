// PROMPT: Simulate a periodic MLD General Querier polling loop and host membership report refresh
// TOKENS: host, ip, mac, flow, receiver, mld, query, multicastaddr, maxrespdelay, ttl, wait, ms, report, compile

// INSTRUCTION: Define the periodic MLD querier router
host periodic_querier {
    ip fe80::500:1
    mac 00:50:56:ca:05:01
}

// INSTRUCTION: Define the persistent IPv6 multicast audio receiver
host audio_receiver {
    ip fe80::500:22
    mac 00:50:56:ca:05:22
}

// INSTRUCTION: Send an MLD General Query and receive an MLD Report in each polling interval
flow mld_periodic_poll(querier, receiver) {
    querier -> receiver mld query multicastaddr :: maxrespdelay 5000 ttl 1 wait 25ms
    receiver -> querier mld report multicastaddr ff08::a000:1 maxrespdelay 0 ttl 1 wait 50ms
}

// INSTRUCTION: Compile four iterations of the periodic MLD query and report loop
compile {
    mld_periodic_poll(periodic_querier, audio_receiver) // cycle 1
    mld_periodic_poll(periodic_querier, audio_receiver) // cycle 2
    mld_periodic_poll(periodic_querier, audio_receiver) // cycle 3
    mld_periodic_poll(periodic_querier, audio_receiver) // cycle 4
}
