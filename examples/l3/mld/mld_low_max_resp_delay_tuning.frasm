// Low Max Response Delay MLD query for rapid multicast group pruning audit.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host core_dist_rtr { ip fe80::1 }

host channel_target_grp { ip ff05::200 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_audit_query_flow(core, grp) {
    core -> grp mld query multicastaddr ff05::200 maxrespdelay 1000
}

// Run mld_audit_query_flow(core_dist_rtr, channel_target_grp) to generate the
// capture.
compile {
    mld_audit_query_flow(core_dist_rtr, channel_target_grp)
}
