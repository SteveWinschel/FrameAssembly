// Capture an IPv6 smart-home hub registering for link-local mDNSv6 (ff02::fb)
// and SSDPv6 (ff02::c) via MLD Reports.
// This capture targets IPv6 endpoints, sets TTL 1, and uses post-packet wait
// gaps (15ms, 25ms) between frames.
// Wireshark: icmpv6.mld

host iot_hub_v6 {
    ip fe80::99:10
    mac 00:0f:53:cc:99:10
}

host home_router_v6 {
    ip fe80::99:1
    mac 00:0f:53:cc:99:01
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow mld_service_discovery_join(hub, router) {
    hub -> router mld report multicastaddr ff02::fb maxrespdelay 0 ttl 1 payload "mdnsv6-listener-join" wait 15ms
    hub -> router mld report multicastaddr ff02::c maxrespdelay 0 ttl 1 payload "ssdpv6-listener-join" wait 25ms
    router -> hub mld query multicastaddr :: maxrespdelay 2000 ttl 1
}

// Run mld_service_discovery_join(iot_hub_v6, home_router_v6) to generate the
// capture.
compile {
    mld_service_discovery_join(iot_hub_v6, home_router_v6)
}
