// Simulate MLD multicast group signaling carried over an MPLS-labeled
// 6PE/6VPE access circuit.
// This capture targets IPv6 endpoints, wraps frames in MPLS label
// 38010/38020, sets TTL 1, and uses post-packet wait gaps (20ms) between
// frames.
// Wireshark: icmpv6.mld && mpls

host ce_v6_receiver {
    ip 2001:db8:600:1::2
    mac 00:0f:53:c5:06:02
}

host pe_v6_mvpn {
    ip 2001:db8:600:1::1
    mac 00:0f:53:c5:06:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_mpls_6vpe_flow(ce, pe) {
    ce -> pe mld report multicastaddr ff08:100::5001 maxrespdelay 0 mpls 38010 exp 6 bos 1 mplsttl 1 ttl 1 wait 20ms
    pe -> ce mld query multicastaddr ff08:100::5001 maxrespdelay 2000 mpls 38020 exp 6 bos 1 mplsttl 1 ttl 1
}

// Run mld_mpls_6vpe_flow(ce_v6_receiver, pe_v6_mvpn) to generate the capture.
compile {
    mld_mpls_6vpe_flow(ce_v6_receiver, pe_v6_mvpn)
}
