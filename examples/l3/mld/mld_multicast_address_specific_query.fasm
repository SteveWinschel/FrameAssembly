// PROMPT: Simulate an MLD Multicast-Address-Specific Query triggered after a listener sends a Done message
// TOKENS: HOST, IP, MAC, FLOW, MLD, DONE, MULTICAST_ADDR, MAX_RESP_DELAY, TTL, WAIT, QUERY, REPORT, COMPILE

// INSTRUCTION: Define the departing IPv6 multicast listener
HOST departing_node {
    IP fe80::201
    MAC 00:25:90:c1:02:01
}

// INSTRUCTION: Define the remaining IPv6 multicast listener on the same LAN
HOST remaining_node {
    IP fe80::202
    MAC 00:25:90:c1:02:02
}

// INSTRUCTION: Define the local subnet IPv6 multicast router
HOST subnet_mrouter {
    IP fe80::10
    MAC 00:25:90:c1:02:10
}

// INSTRUCTION: Send an MLD Done message, trigger a fast address-specific query, and confirm remaining membership
FLOW mld_last_listener_check(leaver, stayer, router) {
    leaver -> router MLD DONE MULTICAST_ADDR ff05::1:3 MAX_RESP_DELAY 0 TTL 1 WAIT 5ms
    router -> stayer MLD QUERY MULTICAST_ADDR ff05::1:3 MAX_RESP_DELAY 1000 TTL 1 WAIT 15ms
    stayer -> router MLD REPORT MULTICAST_ADDR ff05::1:3 MAX_RESP_DELAY 0 TTL 1
}

// INSTRUCTION: Compile the MLD address-specific query verification flow
COMPILE {
    mld_last_listener_check(departing_node, remaining_node, subnet_mrouter)
}
