// Simulate an MLD Multicast-Address-Specific Query triggered after a listener
// sends a Done message.
// This capture targets IPv6 endpoints, sets TTL 1, and uses post-packet wait
// gaps (5ms, 15ms) between frames.
// Wireshark: icmpv6.mld

host departing_node {
    ip fe80::201
    mac 00:25:90:c1:02:01
}

host remaining_node {
    ip fe80::202
    mac 00:25:90:c1:02:02
}

host subnet_mrouter {
    ip fe80::10
    mac 00:25:90:c1:02:10
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow mld_last_listener_check(leaver, stayer, router) {
    leaver -> router mld done multicastaddr ff05::1:3 maxrespdelay 0 ttl 1 wait 5ms
    router -> stayer mld query multicastaddr ff05::1:3 maxrespdelay 1000 ttl 1 wait 15ms
    stayer -> router mld report multicastaddr ff05::1:3 maxrespdelay 0 ttl 1
}

// Run mld_last_listener_check(departing_node, remaining_node, subnet_mrouter)
// to generate the capture.
compile {
    mld_last_listener_check(departing_node, remaining_node, subnet_mrouter)
}
