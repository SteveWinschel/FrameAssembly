// Strict IPv6 Hop Limit verification (TTL 1) on MLD General Query per RFC
// 2710.
// This capture targets IPv6 endpoints and sets TTL 1.
// Wireshark: icmpv6.mld

host link_local_router { ip fe80::beef:1 }

host all_nodes_mcast { ip ff02::1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_hoplimit_flow(rtr, mcast) {
    rtr -> mcast mld query ttl 1
}

// Run mld_hoplimit_flow(link_local_router, all_nodes_mcast) to generate the
// capture.
compile {
    mld_hoplimit_flow(link_local_router, all_nodes_mcast)
}
