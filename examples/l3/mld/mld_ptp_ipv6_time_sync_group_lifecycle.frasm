// IEEE 1588v2 PTP over IPv6 slave clock joining and leaving primary PTP-event
// multicast group ff0e::181.
// This capture targets IPv6 endpoints, wraps frames in 802.1Q VLAN 158, sets
// TTL 1, and uses post-packet wait gaps (10ms) between frames.
// Wireshark: icmpv6.mld && vlan.id == 158

host ptp_boundary_sw {
    ip fe80::1588:1
    mac 00:80:ea:15:88:01
}

host ptp_slave_clock {
    ip fe80::1588:20
    mac 00:80:ea:15:88:20
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow mld_ptp_group_lifecycle(sw, clk) {
    clk -> sw vlan 158 pcp 7 ttl 1 mld report multicastaddr ff0e::181 maxrespdelay 0 wait 10ms
    sw -> clk vlan 158 pcp 7 ttl 1 mld query multicastaddr ff0e::181 maxrespdelay 500 wait 10ms
    clk -> sw vlan 158 pcp 7 ttl 1 mld done multicastaddr ff0e::181 maxrespdelay 0
}

// Run mld_ptp_group_lifecycle(ptp_boundary_sw, ptp_slave_clock) to generate
// the capture.
compile {
    mld_ptp_group_lifecycle(ptp_boundary_sw, ptp_slave_clock)
}
