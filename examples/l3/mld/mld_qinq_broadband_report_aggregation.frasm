// Dual-tagged QinQ MLD Report originating from customer premise equipment
// (CPE).
// This capture targets IPv6 endpoints and wraps frames in QinQ S-VLAN 100 /
// C-VLAN 25.
// Wireshark: icmpv6.mld

host enterprise_cpe { ip fe80::ca01:1 }

host metro_pe_router { ip ff02::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_qinq_report_flow(cpe, pe) {
    cpe -> pe mld report multicastaddr ff08::8080 qinq 100 innervlan 25
}

// Run mld_qinq_report_flow(enterprise_cpe, metro_pe_router) to generate the
// capture.
compile {
    mld_qinq_report_flow(enterprise_cpe, metro_pe_router)
}
