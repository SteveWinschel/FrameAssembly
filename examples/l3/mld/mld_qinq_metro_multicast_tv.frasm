// Generate a QinQ double-tagged MLD multicast listener subscription across a
// wholesale metro network.
// This capture targets IPv6 endpoints, wraps frames in QinQ S-VLAN 1800 /
// C-VLAN 250, sets TTL 1, and uses post-packet wait gaps (15ms, 30ms) between
// frames.
// Wireshark: icmpv6.mld

host home_gw_v6 {
    ip fe80::1800:250
    mac 00:1e:67:c4:18:01
}

host metro_agg_v6 {
    ip fe80::1800:1
    mac 00:1e:67:c4:18:99
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow mld_qinq_subscription(rgw, agg) {
    agg -> rgw mld query multicastaddr ff0e::114 maxrespdelay 4000 qinq 1800 innervlan 250 ttl 1 wait 15ms
    rgw -> agg mld report multicastaddr ff0e::114 maxrespdelay 0 qinq 1800 innervlan 250 ttl 1 wait 30ms
    rgw -> agg mld done multicastaddr ff0e::114 maxrespdelay 0 qinq 1800 innervlan 250 ttl 1
}

// Run mld_qinq_subscription(home_gw_v6, metro_agg_v6) to generate the
// capture.
compile {
    mld_qinq_subscription(home_gw_v6, metro_agg_v6)
}
