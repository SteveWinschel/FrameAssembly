// PROMPT: Generate a QinQ double-tagged MLD multicast listener subscription across a wholesale metro network
// TOKENS: host, ip, mac, flow, mld, query, multicastaddr, maxrespdelay, qinq, innervlan, ttl, wait, ms, report, done, compile

// INSTRUCTION: Define the residential IPv6 home gateway
host home_gw_v6 {
    ip fe80::1800:250
    mac 00:1e:67:c4:18:01
}

// INSTRUCTION: Define the wholesale metro multicast aggregation router
host metro_agg_v6 {
    ip fe80::1800:1
    mac 00:1e:67:c4:18:99
}

// INSTRUCTION: Exchange QinQ-encapsulated MLD messages with outer S-VLAN 1800 and inner C-VLAN 250
flow mld_qinq_subscription(rgw, agg) {
    agg -> rgw mld query multicastaddr ff0e::114 maxrespdelay 4000 qinq 1800 innervlan 250 ttl 1 wait 15ms
    rgw -> agg mld report multicastaddr ff0e::114 maxrespdelay 0 qinq 1800 innervlan 250 ttl 1 wait 30ms
    rgw -> agg mld done multicastaddr ff0e::114 maxrespdelay 0 qinq 1800 innervlan 250 ttl 1
}

// INSTRUCTION: Compile the QinQ wholesale MLD multicast flow
compile {
    mld_qinq_subscription(home_gw_v6, metro_agg_v6)
}
