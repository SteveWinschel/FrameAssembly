// PROMPT: Simulate an IPv6 host joining its Solicited-Node Multicast Address via MLD Report during interface initialization
// TOKENS: host, ip, mac, flow, mld, report, multicastaddr, maxrespdelay, dstmac, ttl, wait, ms, compile

// INSTRUCTION: Define the newly booting IPv6 server interface
host booting_srv_v6 {
    ip fe80::a8bb:ccff:fedd:ee01
    mac aa:bb:cc:dd:ee:01
}

// INSTRUCTION: Define the local link IPv6 switch querier
host link_querier_v6 {
    ip fe80::1
    mac 00:25:90:c8:00:01
}

// INSTRUCTION: Transmit unsolicited MLD Reports for the solicited-node multicast group prior to DAD
flow mld_solicited_node_join(srv, querier) {
    srv -> querier mld report multicastaddr ff02::1:ffdd:ee01 maxrespdelay 0 dstmac 33:33:ff:dd:ee:01 ttl 1 wait 100ms
    srv -> querier mld report multicastaddr ff02::1:ffdd:ee01 maxrespdelay 0 dstmac 33:33:ff:dd:ee:01 ttl 1
}

// INSTRUCTION: Compile the solicited-node multicast MLD join sequence
compile {
    mld_solicited_node_join(booting_srv_v6, link_querier_v6)
}
