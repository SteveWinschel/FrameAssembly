// Simulate an IPv6 host joining its Solicited-Node Multicast Address via MLD
// Report during interface initialization.
// This capture targets IPv6 endpoints, sets TTL 1, and uses post-packet wait
// gaps (100ms) between frames.
// Wireshark: icmpv6.mld

host booting_srv_v6 {
    ip fe80::a8bb:ccff:fedd:ee01
    mac aa:bb:cc:dd:ee:01
}

host link_querier_v6 {
    ip fe80::1
    mac 00:25:90:c8:00:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_solicited_node_join(srv, querier) {
    srv -> querier mld report multicastaddr ff02::1:ffdd:ee01 maxrespdelay 0 dstmac 33:33:ff:dd:ee:01 ttl 1 wait 100ms
    srv -> querier mld report multicastaddr ff02::1:ffdd:ee01 maxrespdelay 0 dstmac 33:33:ff:dd:ee:01 ttl 1
}

// Run mld_solicited_node_join(booting_srv_v6, link_querier_v6) to generate
// the capture.
compile {
    mld_solicited_node_join(booting_srv_v6, link_querier_v6)
}
