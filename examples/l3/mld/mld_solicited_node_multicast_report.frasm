// IPv6 host reporting membership in solicited-node multicast address for NDP
// resolution.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host mld_client_node { ip fe80::5054:ff:fe12:3456 }

host mld_all_routers_dst { ip ff02::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_solicited_report(client, rtrs) {
    client -> rtrs mld report multicastaddr ff02::1:ff12:3456
}

// Run mld_solicited_report(mld_client_node, mld_all_routers_dst) to generate
// the capture.
compile {
    mld_solicited_report(mld_client_node, mld_all_routers_dst)
}
