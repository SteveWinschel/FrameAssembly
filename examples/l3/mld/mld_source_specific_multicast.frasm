// MLDv1 listener report subscribing to multicast address with maximum
// response delay.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.mld

host ipv6_subscriber { ip fe80::a1 }

host ipv6_querier { ip ff02::16 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_report_flow(sub, qry) {
    sub -> qry mld report multicastaddr ff05::1:3 maxrespdelay 1000
}

// Run mld_report_flow(ipv6_subscriber, ipv6_querier) to generate the capture.
compile {
    mld_report_flow(ipv6_subscriber, ipv6_querier)
}
