// Build an 802.1Q VLAN-tagged MLD snooping query and report exchange on a
// campus switch VLAN.
// This capture targets IPv6 endpoints, wraps frames in 802.1Q VLAN 250, sets
// TTL 1, and uses post-packet wait gaps (20ms) between frames.
// Wireshark: icmpv6.mld && vlan.id == 250

host snoop_switch {
    ip fe80::250:1
    mac 00:50:56:c3:02:01
}

host media_client {
    ip fe80::250:88
    mac 00:50:56:c3:02:88
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow mld_vlan_snooping(querier, client) {
    querier -> client mld query multicastaddr ff08::400:1 maxrespdelay 5000 vlan 250 pcp 6 ttl 1 wait 20ms
    client -> querier mld report multicastaddr ff08::400:1 maxrespdelay 0 vlan 250 pcp 6 ttl 1
}

// Run mld_vlan_snooping(snoop_switch, media_client) to generate the capture.
compile {
    mld_vlan_snooping(snoop_switch, media_client)
}
