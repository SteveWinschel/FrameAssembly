// PROMPT: Build an 802.1Q VLAN-tagged MLD snooping query and report exchange on a campus switch VLAN
// TOKENS: host, ip, mac, flow, mld, query, multicastaddr, maxrespdelay, vlan, pcp, ttl, wait, ms, report, compile

// INSTRUCTION: Define the VLAN 250 MLD snooping querier switch
host snoop_switch {
    ip fe80::250:1
    mac 00:50:56:c3:02:01
}

// INSTRUCTION: Define the VLAN 250 IPv6 multimedia workstation
host media_client {
    ip fe80::250:88
    mac 00:50:56:c3:02:88
}

// INSTRUCTION: Exchange MLD query and report frames tagged with VLAN 250 and priority 6
flow mld_vlan_snooping(querier, client) {
    querier -> client mld query multicastaddr ff08::400:1 maxrespdelay 5000 vlan 250 pcp 6 ttl 1 wait 20ms
    client -> querier mld report multicastaddr ff08::400:1 maxrespdelay 0 vlan 250 pcp 6 ttl 1
}

// INSTRUCTION: Compile the VLAN-tagged MLD snooping flow
compile {
    mld_vlan_snooping(snoop_switch, media_client)
}
