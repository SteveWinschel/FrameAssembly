// 802.1Q tagged MLD query on subscriber multicast delivery VLAN 200.
// This capture targets IPv6 endpoints and wraps frames in 802.1Q VLAN 200.
// Wireshark: icmpv6.mld && vlan.id == 200

host bng_access_gw { ip fe80::b00:1 }

host sub_listener { ip ff02::1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mld_vlan_query_flow(bng, sub) {
    bng -> sub mld query vlan 200 pcp 6 dei 0 maxrespdelay 5000
}

// Run mld_vlan_query_flow(bng_access_gw, sub_listener) to generate the
// capture.
compile {
    mld_vlan_query_flow(bng_access_gw, sub_listener)
}
