// IPv6 Duplicate Address Detection (DAD) Neighbor Solicitation verifying
// address uniqueness.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host dad_probing_node { ip fe80::dad:1 mac 00:50:56:00:da:01 }

host dad_solicited_node { ip ff02::1:ff34:5678 mac 33:33:ff:34:56:78 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow dad_probe_flow(src, dst) {
    src -> dst ndp neighborsolicit target 2001:db8::3456:78
}

// Run dad_probe_flow(dad_probing_node, dad_solicited_node) to generate the
// capture.
compile {
    dad_probe_flow(dad_probing_node, dad_solicited_node)
}
