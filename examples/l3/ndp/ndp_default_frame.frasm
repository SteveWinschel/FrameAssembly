// Minimal IPv6 Neighbor Discovery Protocol (NDP, RFC 4861) Neighbor
// Solicitation (Type 135) sent over ICMPv6 Next Header 58 to solicited-node
// multicast ff02::1:ff00:2 (TTL 255). Helpful for testing ND inspection,
// RA-Guard baselines, and IPv6 address resolution.
// Wireshark: icmpv6.nd

host endpoint_a {
    ip 2001:db8:61::1
    mac 02:00:61:00:00:01
}

host endpoint_b {
    ip 2001:db8:61::2
    mac 02:00:61:00:00:02
}

// Transmit one default NDP Neighbor Solicitation directly inside compile.
compile {
    endpoint_a -> endpoint_b ndp
}
