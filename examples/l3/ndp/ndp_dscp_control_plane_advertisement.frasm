// Router Advertisement marked with Network Control DSCP Class Selector 6.
// This capture targets IPv6 endpoints and sets DSCP 48.
// Wireshark: icmpv6.nd

host agg_gw_router { ip fe80::ac01:1 mac 00:26:88:aa:11:01 }

host all_link_nodes { ip ff02::1 mac 33:33:00:00:00:01 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ra_control_plane_flow(gw, nodes) {
    gw -> nodes ndp routeradvert routerlifetime 3600 dscp 48
}

// Run ra_control_plane_flow(agg_gw_router, all_link_nodes) to generate the
// capture.
compile {
    ra_control_plane_flow(agg_gw_router, all_link_nodes)
}
