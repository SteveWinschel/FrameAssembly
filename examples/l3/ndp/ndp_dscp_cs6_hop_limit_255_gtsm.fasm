// PROMPT: Construct an RFC 4861 NDP exchange enforcing DSCP CS6 network control marking and Hop Limit 255 GTSM validation
// TOKENS: host, ip, mac, flow, ndp, routersolicit, slla, dscp, ecn, ttl, wait, ms, routeradvert, routerlifetime, neighborsolicit, target, neighboradvert, tlla, compile

// INSTRUCTION: Define the secure IPv6 campus router
host sec_rtr_v6 {
    ip 2001:db8:700::1
    mac 00:1b:21:d7:07:01
}

// INSTRUCTION: Define the secure IPv6 campus host
host sec_host_v6 {
    ip 2001:db8:700::77
    mac 00:1b:21:d7:07:77
}

// INSTRUCTION: Exchange NDP control messages with DSCP 48 (CS6) and Hop Limit 255
flow ndp_dscp_cs6_gtsm(rtr, host) {
    host -> rtr ndp routersolicit slla 00:1b:21:d7:07:77 dscp 48 ecn 0 ttl 255 wait 10ms
    rtr -> host ndp routeradvert routerlifetime 1800 slla 00:1b:21:d7:07:01 dscp 48 ecn 0 ttl 255 wait 10ms
    host -> rtr ndp neighborsolicit target 2001:db8:700::1 slla 00:1b:21:d7:07:77 dscp 48 ecn 0 ttl 255 wait 10ms
    rtr -> host ndp neighboradvert target 2001:db8:700::1 tlla 00:1b:21:d7:07:01 dscp 48 ecn 0 ttl 255
}

// INSTRUCTION: Compile the DSCP CS6 and Hop Limit 255 NDP trace
compile {
    ndp_dscp_cs6_gtsm(sec_rtr_v6, sec_host_v6)
}
