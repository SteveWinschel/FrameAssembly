// PROMPT: Simulate IPv6 Duplicate Address Detection (DAD) where a tentative address collision is defended via Neighbor Advertisement
// TOKENS: host, ip, mac, flow, ndp, neighborsolicit, target, dstmac, ttl, wait, ms, neighboradvert, tlla, compile

// INSTRUCTION: Define the newly joining host using the unspecified IPv6 address during DAD
host tentative_host {
    ip ::
    mac 00:1b:21:d0:01:99
}

// INSTRUCTION: Define the existing host that already owns the target IPv6 address
host existing_owner {
    ip 2001:db8:10::50
    mac 00:1b:21:d0:01:50
}

// INSTRUCTION: Probe for address uniqueness with NS and defend the address with a multicast NA
flow ndp_dad_collision_defense(new_node, owner) {
    new_node -> owner ndp neighborsolicit target 2001:db8:10::50 dstmac 33:33:ff:00:00:50 ttl 255 wait 10ms
    owner -> new_node ndp neighboradvert target 2001:db8:10::50 tlla 00:1b:21:d0:01:50 dstmac 33:33:00:00:00:01 ttl 255
}

// INSTRUCTION: Compile the NDP Duplicate Address Detection collision trace
compile {
    ndp_dad_collision_defense(tentative_host, existing_owner)
}
