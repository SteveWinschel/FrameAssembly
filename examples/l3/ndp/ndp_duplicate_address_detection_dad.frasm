// Simulate IPv6 Duplicate Address Detection (DAD) where a tentative address
// collision is defended via Neighbor Advertisement.
// This capture targets IPv6 endpoints, sets TTL 255, and uses post-packet
// wait gaps (10ms) between frames.
// Wireshark: icmpv6.nd

host tentative_host {
    ip ::
    mac 00:1b:21:d0:01:99
}

host existing_owner {
    ip 2001:db8:10::50
    mac 00:1b:21:d0:01:50
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ndp_dad_collision_defense(new_node, owner) {
    new_node -> owner ndp neighborsolicit target 2001:db8:10::50 dstmac 33:33:ff:00:00:50 ttl 255 wait 10ms
    owner -> new_node ndp neighboradvert target 2001:db8:10::50 tlla 00:1b:21:d0:01:50 dstmac 33:33:00:00:00:01 ttl 255
}

// Run ndp_dad_collision_defense(tentative_host, existing_owner) to generate
// the capture.
compile {
    ndp_dad_collision_defense(tentative_host, existing_owner)
}
