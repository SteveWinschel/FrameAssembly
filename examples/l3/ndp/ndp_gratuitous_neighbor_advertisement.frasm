// Simulate an unsolicited Gratuitous Neighbor Advertisement updating neighbor
// caches after a virtual IP failover.
// This capture targets IPv6 endpoints, sets TTL 255, and uses post-packet
// wait gaps (50ms) between frames.
// Wireshark: icmpv6.nd

host ha_lb_active {
    ip 2001:db8:40::100
    mac 00:00:5e:00:02:64
}

host upstream_core_v6 {
    ip 2001:db8:40::1
    mac 00:50:56:d3:00:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ndp_gratuitous_na_failover(vip_node, switch) {
    vip_node -> switch ndp neighboradvert target 2001:db8:40::100 tlla 00:00:5e:00:02:64 srcmac 00:00:5e:00:02:64 dstmac 33:33:00:00:00:01 ttl 255 wait 50ms
    vip_node -> switch ndp neighboradvert target 2001:db8:40::100 tlla 00:00:5e:00:02:64 srcmac 00:00:5e:00:02:64 dstmac 33:33:00:00:00:01 ttl 255
}

// Run ndp_gratuitous_na_failover(ha_lb_active, upstream_core_v6) to generate
// the capture.
compile {
    ndp_gratuitous_na_failover(ha_lb_active, upstream_core_v6)
}
