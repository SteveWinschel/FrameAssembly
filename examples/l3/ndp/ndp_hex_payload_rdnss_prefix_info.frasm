// Generate an IPv6 Router Advertisement carrying hexadecimal ICMPv6 Prefix
// Information and RDNSS options.
// This capture targets IPv6 endpoints, sets TTL 255, and uses post-packet
// wait gaps (15ms) between frames.
// Wireshark: icmpv6.nd

host laptop_v6 {
    ip fe80::b00:99
    mac 00:1e:67:db:0b:99
}

host rdnss_router_v6 {
    ip fe80::b00:1
    mac 00:1e:67:db:0b:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ndp_ra_hex_options(client, router) {
    client -> router ndp routersolicit slla 00:1e:67:db:0b:99 ttl 255 wait 15ms
    router -> client ndp routeradvert routerlifetime 1800 slla 00:1e:67:db:0b:01 ttl 255 hexpayload "030440c000278d0000093a800000000020010db80b0000000000000000000000"
}

// Run ndp_ra_hex_options(laptop_v6, rdnss_router_v6) to generate the capture.
compile {
    ndp_ra_hex_options(laptop_v6, rdnss_router_v6)
}
