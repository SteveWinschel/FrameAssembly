// High-availability IPv6 load balancer broadcasting unsolicited Neighbor
// Advertisement to update upstream neighbor caches.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 255, and uses
// post-packet wait gaps (5ms, 10ms) between frames.
// Wireshark: icmpv6.nd

host lb_active_v6 {
    ip 2001:db8:80::100
    mac 00:16:3e:80:01:00
}

host core_router_v6 {
    ip 2001:db8:80::1
    mac 00:16:3e:80:00:01
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow ndp_vip_takeover(lb, rtr) {
    lb -> rtr dscp 48 ttl 255 ndp neighboradvert target 2001:db8:80::100 tlla 00:16:3e:80:01:00 dstmac 33:33:00:00:00:01 wait 5ms
    lb -> rtr dscp 48 ttl 255 ndp neighboradvert target 2001:db8:80::100 tlla 00:16:3e:80:01:00 dstmac 33:33:00:00:00:01 wait 10ms
    rtr -> lb dscp 48 ttl 255 ndp neighborsolicit target 2001:db8:80::100 slla 00:16:3e:80:00:01 wait 5ms
    lb -> rtr dscp 48 ttl 255 ndp neighboradvert target 2001:db8:80::100 tlla 00:16:3e:80:01:00
}

// Run ndp_vip_takeover(lb_active_v6, core_router_v6) to generate the capture.
compile {
    ndp_vip_takeover(lb_active_v6, core_router_v6)
}
