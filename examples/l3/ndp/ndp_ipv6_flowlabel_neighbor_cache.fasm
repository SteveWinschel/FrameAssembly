// PROMPT: Generate an IPv6 Neighbor Solicitation and Advertisement sequence with explicit IPv6 Flow Labels
// TOKENS: host, ip, mac, flow, ndp, neighborsolicit, target, slla, flowlabel, ttl, wait, ms, neighboradvert, tlla, compile

// INSTRUCTION: Define the primary IPv6 storage node
host storage_v6_a {
    ip 2001:db8:810::10
    mac 00:25:90:d8:08:10
}

// INSTRUCTION: Define the secondary IPv6 storage node
host storage_v6_b {
    ip 2001:db8:810::20
    mac 00:25:90:d8:08:20
}

// INSTRUCTION: Exchange Neighbor Discovery messages carrying non-zero IPv6 Flow Labels
flow ndp_flowlabel_resolution(node_a, node_b) {
    node_a -> node_b ndp neighborsolicit target 2001:db8:810::20 slla 00:25:90:d8:08:10 flowlabel 65535 ttl 255 wait 10ms
    node_b -> node_a ndp neighboradvert target 2001:db8:810::20 tlla 00:25:90:d8:08:20 flowlabel 65535 ttl 255
}

// INSTRUCTION: Compile the Flow Label NDP neighbor resolution flow
compile {
    ndp_flowlabel_resolution(storage_v6_a, storage_v6_b)
}
