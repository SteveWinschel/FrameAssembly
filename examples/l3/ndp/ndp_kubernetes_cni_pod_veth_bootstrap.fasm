// PROMPT: Kubernetes IPv6 pod interface completing Router Solicitation, DAD Neighbor Solicitation, and host gateway resolution.
// TOKENS: host, ip, mac, flow, ttl, ndp, neighborsolicit, target, dstmac, wait, ms, routersolicit, slla, routeradvert, routerlifetime, compile

// INSTRUCTION: Define newly scheduled Kubernetes pod veth interface on IPv6 cluster subnet.
host k8s_pod_veth {
    ip 2001:db8:c0de:1::42
    mac 0a:58:c0:de:01:42
}

// INSTRUCTION: Define worker node CNI bridge interface acting as link-local IPv6 router.
host cni_node_router {
    ip 2001:db8:c0de:1::1
    mac 0a:58:c0:de:01:01
}

// INSTRUCTION: Perform DAD check on pod address followed by Router Solicitation and Router Advertisement.
flow ndp_k8s_pod_init(pod, cni) {
    pod -> cni ttl 255 ndp neighborsolicit target 2001:db8:c0de:1::42 dstmac 33:33:ff:01:00:42 wait 10ms
    pod -> cni ttl 255 ndp routersolicit slla 0a:58:c0:de:01:42 dstmac 33:33:00:00:00:02 wait 5ms
    cni -> pod ttl 255 ndp routeradvert routerlifetime 3600 slla 0a:58:c0:de:01:01
}

// INSTRUCTION: Compile the Kubernetes IPv6 pod CNI bootstrap NDP exchange.
compile {
    ndp_k8s_pod_init(k8s_pod_veth, cni_node_router)
}
