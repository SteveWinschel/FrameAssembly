// Simulate MPLS-labeled IPv6 Neighbor Discovery between a 6VPE provider edge
// and customer edge router.
// This capture targets IPv6 endpoints, wraps frames in MPLS label
// 41000/41001, sets TTL 255, and uses post-packet wait gaps (10ms) between
// frames.
// Wireshark: icmpv6.nd && mpls

host pe_6vpe_rtr {
    ip 2001:db8:650::1
    mac 00:26:99:d6:06:01
}

host ce_6vpe_rtr {
    ip 2001:db8:650::2
    mac 00:26:99:d6:06:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ndp_mpls_attachment_circuit(pe, ce) {
    pe -> ce ndp neighborsolicit target 2001:db8:650::2 slla 00:26:99:d6:06:01 mpls 41000 exp 6 bos 1 mplsttl 255 ttl 255 wait 10ms
    ce -> pe ndp neighboradvert target 2001:db8:650::2 tlla 00:26:99:d6:06:02 mpls 41001 exp 6 bos 1 mplsttl 255 ttl 255
}

// Run ndp_mpls_attachment_circuit(pe_6vpe_rtr, ce_6vpe_rtr) to generate the
// capture.
compile {
    ndp_mpls_attachment_circuit(pe_6vpe_rtr, ce_6vpe_rtr)
}
