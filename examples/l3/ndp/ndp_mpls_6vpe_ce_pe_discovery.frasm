// PROMPT: Simulate MPLS-labeled IPv6 Neighbor Discovery between a 6VPE provider edge and customer edge router
// TOKENS: host, ip, mac, flow, ndp, neighborsolicit, target, slla, mpls, exp, bos, mplsttl, ttl, wait, ms, neighboradvert, tlla, compile

// INSTRUCTION: Define the 6VPE provider edge router
host pe_6vpe_rtr {
    ip 2001:db8:650::1
    mac 00:26:99:d6:06:01
}

// INSTRUCTION: Define the customer edge IPv6 router
host ce_6vpe_rtr {
    ip 2001:db8:650::2
    mac 00:26:99:d6:06:02
}

// INSTRUCTION: Resolve link-layer addresses across an MPLS-labeled pseudowire attachment circuit
flow ndp_mpls_attachment_circuit(pe, ce) {
    pe -> ce ndp neighborsolicit target 2001:db8:650::2 slla 00:26:99:d6:06:01 mpls 41000 exp 6 bos 1 mplsttl 255 ttl 255 wait 10ms
    ce -> pe ndp neighboradvert target 2001:db8:650::2 tlla 00:26:99:d6:06:02 mpls 41001 exp 6 bos 1 mplsttl 255 ttl 255
}

// INSTRUCTION: Compile the MPLS-labeled NDP resolution sequence
compile {
    ndp_mpls_attachment_circuit(pe_6vpe_rtr, ce_6vpe_rtr)
}
