// NDP resolution packet encapsulated across MPLS label switched path with
// label 300.
// This capture targets IPv6 endpoints and wraps frames in MPLS label 300.
// Wireshark: icmpv6.nd && mpls

host mpls_ler_node { ip fe80::101 mac 00:1f:6d:10:01:01 }

host mpls_egress_dst { ip ff02::1:ff00:2 mac 33:33:ff:00:00:02 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow mpls_ndp_flow(ler, dst) {
    ler -> dst ndp neighborsolicit target 2001:db8:99::2 slla 00:1f:6d:10:01:01 mpls 300
}

// Run mpls_ndp_flow(mpls_ler_node, mpls_egress_dst) to generate the capture.
compile {
    mpls_ndp_flow(mpls_ler_node, mpls_egress_dst)
}
