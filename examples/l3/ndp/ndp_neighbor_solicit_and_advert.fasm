// PROMPT: IPv6 NDP Neighbor Solicitation and Advertisement resolving link-layer address with explicit target.
// TOKENS: host, ip, flow, src, dst, ndp, neighborsolicit, target, neighboradvert, compile

// INSTRUCTION: Define IPv6 client node.
host ipv6_node_a { ip 2001:db8::10 }

// INSTRUCTION: Define IPv6 server node.
host ipv6_node_b { ip 2001:db8::20 }

// INSTRUCTION: Define Neighbor Discovery resolution flow with explicit target address.
flow ndp_target_flow(src, dst) {
    src -> dst ndp neighborsolicit target 2001:db8::20
    src <- dst ndp neighboradvert target 2001:db8::20
}

// INSTRUCTION: Compile block executing NDP resolution.
compile {
    ndp_target_flow(ipv6_node_a, ipv6_node_b)
}
