// IPv6 NDP Neighbor Solicitation and Advertisement resolving link-layer
// address with explicit target.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host ipv6_node_a { ip 2001:db8::10 }

host ipv6_node_b { ip 2001:db8::20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ndp_target_flow(src, dst) {
    src -> dst ndp neighborsolicit target 2001:db8::20
    src <- dst ndp neighboradvert target 2001:db8::20
}

// Run ndp_target_flow(ipv6_node_a, ipv6_node_b) to generate the capture.
compile {
    ndp_target_flow(ipv6_node_a, ipv6_node_b)
}
