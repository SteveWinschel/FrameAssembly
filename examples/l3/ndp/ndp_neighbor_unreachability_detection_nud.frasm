// PROMPT: Generate a unicast IPv6 Neighbor Unreachability Detection (NUD) probe and reachability confirmation
// TOKENS: host, ip, mac, flow, ndp, neighborsolicit, target, slla, ttl, wait, ms, neighboradvert, tlla, compile

// INSTRUCTION: Define the probing IPv6 application server
host app_node_v6 {
    ip 2001:db8:30::11
    mac 00:16:3e:d2:00:11
}

// INSTRUCTION: Define the neighbor IPv6 database server being verified
host db_node_v6 {
    ip 2001:db8:30::22
    mac 00:16:3e:d2:00:22
}

// INSTRUCTION: Exchange unicast Neighbor Solicitation and Neighbor Advertisement frames for NUD
flow ndp_nud_unicast_probe(prober, neighbor) {
    prober -> neighbor ndp neighborsolicit target 2001:db8:30::22 slla 00:16:3e:d2:00:11 ttl 255 wait 5ms
    neighbor -> prober ndp neighboradvert target 2001:db8:30::22 tlla 00:16:3e:d2:00:22 ttl 255 wait 20ms
    neighbor -> prober ndp neighborsolicit target 2001:db8:30::11 slla 00:16:3e:d2:00:22 ttl 255 wait 5ms
    prober -> neighbor ndp neighboradvert target 2001:db8:30::11 tlla 00:16:3e:d2:00:11 ttl 255
}

// INSTRUCTION: Compile the bidirectional NUD reachability verification flow
compile {
    ndp_nud_unicast_probe(app_node_v6, db_node_v6)
}
