// Dual-tagged QinQ Neighbor Advertisement traversing broadband metro access
// ring.
// This capture targets IPv6 endpoints and wraps frames in QinQ S-VLAN 500 /
// C-VLAN 102.
// Wireshark: icmpv6.nd

host metro_subscriber_onu { ip fe80::0001 mac 00:1e:67:aa:bb:cc }

host provider_bng_gw { ip ff02::1 mac 33:33:00:00:00:01 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow qinq_ndp_flow(onu, bng) {
    onu -> bng ndp neighboradvert target 2001:db8:cafe::10 tlla 00:1e:67:aa:bb:cc qinq 500 innervlan 102
}

// Run qinq_ndp_flow(metro_subscriber_onu, provider_bng_gw) to generate the
// capture.
compile {
    qinq_ndp_flow(metro_subscriber_onu, provider_bng_gw)
}
