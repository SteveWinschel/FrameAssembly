// PROMPT: Generate a QinQ double-tagged NDP Router Solicitation and Neighbor Discovery sequence for an ISP subscriber CPE
// TOKENS: host, ip, mac, flow, ndp, routersolicit, slla, qinq, innervlan, ttl, wait, ms, routeradvert, routerlifetime, neighborsolicit, target, neighboradvert, tlla, compile

// INSTRUCTION: Define the subscriber IPv6 CPE WAN interface
host cpe_wan_v6 {
    ip fe80::2100:120
    mac 00:0f:53:d5:21:01
}

// INSTRUCTION: Define the ISP Broadband Network Gateway IPv6 interface
host isp_bng_v6 {
    ip fe80::2100:1
    mac 00:0f:53:d5:21:99
}

// INSTRUCTION: Perform QinQ-tagged router discovery and link-local neighbor resolution
flow ndp_qinq_cpe_onboarding(cpe, bng) {
    cpe -> bng ndp routersolicit slla 00:0f:53:d5:21:01 qinq 2100 innervlan 120 ttl 255 wait 15ms
    bng -> cpe ndp routeradvert routerlifetime 3600 slla 00:0f:53:d5:21:99 qinq 2100 innervlan 120 ttl 255 wait 10ms
    cpe -> bng ndp neighborsolicit target fe80::2100:1 slla 00:0f:53:d5:21:01 qinq 2100 innervlan 120 ttl 255 wait 10ms
    bng -> cpe ndp neighboradvert target fe80::2100:1 tlla 00:0f:53:d5:21:99 qinq 2100 innervlan 120 ttl 255
}

// INSTRUCTION: Compile the QinQ subscriber CPE NDP onboarding trace
compile {
    ndp_qinq_cpe_onboarding(cpe_wan_v6, isp_bng_v6)
}
