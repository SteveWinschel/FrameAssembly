// IPv6 Router Advertisement publishing default router lifetime and
// reachability parameters.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host edge_ra_router { ip fe80::1 mac 00:1c:73:00:00:01 }

host all_ipv6_nodes { ip ff02::1 mac 33:33:00:00:00:01 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow router_advert_flow(gw, nodes) {
    gw -> nodes ndp routeradvert routerlifetime 1800 slla 00:1c:73:00:00:01
}

// Run router_advert_flow(edge_ra_router, all_ipv6_nodes) to generate the
// capture.
compile {
    router_advert_flow(edge_ra_router, all_ipv6_nodes)
}
