// PROMPT: IPv6 Neighbor Discovery Protocol message exchange with Router and Neighbor Solicitations and Advertisements.
// TOKENS: host, ip, flow, ndp, routersolicit, routeradvert, neighborsolicit, neighboradvert, compile

// INSTRUCTION: Define IPv6 host node.
host ndp_node { ip fe80::10 }

// INSTRUCTION: Define IPv6 default router.
host ndp_router { ip fe80::1 }

// INSTRUCTION: Define NDP router and neighbor solicitation exchange flow.
flow ndp_solicit_flow(n, r) {
    n -> r ndp routersolicit
    n <- r ndp routeradvert
    n -> r ndp neighborsolicit
    n <- r ndp neighboradvert
}

// INSTRUCTION: Compile block executing NDP discovery exchange.
compile {
    ndp_solicit_flow(ndp_node, ndp_router)
}
