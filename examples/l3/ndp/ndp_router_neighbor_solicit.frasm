// IPv6 Neighbor Discovery Protocol message exchange with Router and Neighbor
// Solicitations and Advertisements.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host ndp_node { ip fe80::10 }

host ndp_router { ip fe80::1 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow ndp_solicit_flow(n, r) {
    n -> r ndp routersolicit
    n <- r ndp routeradvert
    n -> r ndp neighborsolicit
    n <- r ndp neighboradvert
}

// Run ndp_solicit_flow(ndp_node, ndp_router) to generate the capture.
compile {
    ndp_solicit_flow(ndp_node, ndp_router)
}
