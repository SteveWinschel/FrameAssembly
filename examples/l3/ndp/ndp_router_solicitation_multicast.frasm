// IPv6 NDP Router Solicitation sent to all-routers multicast address and
// Router Advertisement reply.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host new_host { ip fe80::50 }

host gateway_router { ip fe80::1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ndp_router_discovery(h, r) {
    h -> r ndp routersolicit
    h <- r ndp routeradvert routerlifetime 1800
}

// Run ndp_router_discovery(new_host, gateway_router) to generate the capture.
compile {
    ndp_router_discovery(new_host, gateway_router)
}
