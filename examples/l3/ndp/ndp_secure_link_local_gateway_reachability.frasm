// Secure IPv6 link-local gateway address resolution with full SLLA and TLLA
// validation.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host enclave_client_host { ip fe80::e01:10 mac 00:08:74:aa:bb:01 }

host enclave_boundary_gw { ip fe80::e01:1 mac 00:08:74:aa:bb:fe }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow enclave_ndp_handshake(cli, gw) {
    cli -> gw ndp neighborsolicit target fe80::e01:1 slla 00:08:74:aa:bb:01
    cli <- gw ndp neighboradvert target fe80::e01:1 tlla 00:08:74:aa:bb:fe
}

// Run enclave_ndp_handshake(enclave_client_host, enclave_boundary_gw) to
// generate the capture.
compile {
    enclave_ndp_handshake(enclave_client_host, enclave_boundary_gw)
}
