// 802.1Q tagged Neighbor Solicitation and Advertisement on enterprise access
// VLAN 100.
// This capture targets IPv6 endpoints and wraps frames in 802.1Q VLAN 100.
// Wireshark: icmpv6.nd && vlan.id == 100

host acct_workstation { ip fe80::ac:10 mac 00:25:90:11:22:33 }

host acct_fileserver { ip fe80::ac:20 mac 00:25:90:44:55:66 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow vlan_ndp_resolution(ws, srv) {
    ws -> srv ndp neighborsolicit target 2001:db8:100::20 slla 00:25:90:11:22:33 vlan 100
    ws <- srv ndp neighboradvert target 2001:db8:100::20 tlla 00:25:90:44:55:66 vlan 100
}

// Run vlan_ndp_resolution(acct_workstation, acct_fileserver) to generate the
// capture.
compile {
    vlan_ndp_resolution(acct_workstation, acct_fileserver)
}
