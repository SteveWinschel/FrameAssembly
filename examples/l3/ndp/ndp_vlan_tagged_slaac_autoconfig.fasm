// PROMPT: Build an 802.1Q VLAN-tagged IPv6 SLAAC Router Solicitation and Router Advertisement exchange
// TOKENS: host, ip, mac, flow, router, ndp, routersolicit, slla, vlan, pcp, ttl, wait, ms, routeradvert, routerlifetime, compile

// INSTRUCTION: Define the VLAN 120 IPv6 client workstation
host vlan_client_v6 {
    ip fe80::120:45
    mac 00:1e:67:d4:12:45
}

// INSTRUCTION: Define the VLAN 120 IPv6 gateway router
host vlan_router_v6 {
    ip fe80::120:1
    mac 00:1e:67:d4:12:01
}

// INSTRUCTION: Exchange VLAN-tagged Router Solicitation and Router Advertisement messages
flow ndp_vlan_slaac_exchange(client, router) {
    client -> router ndp routersolicit slla 00:1e:67:d4:12:45 vlan 120 pcp 6 ttl 255 wait 15ms
    router -> client ndp routeradvert routerlifetime 1800 slla 00:1e:67:d4:12:01 vlan 120 pcp 6 ttl 255
}

// INSTRUCTION: Compile the VLAN 120 NDP SLAAC discovery flow
compile {
    ndp_vlan_slaac_exchange(vlan_client_v6, vlan_router_v6)
}
