// Build an 802.1Q VLAN-tagged IPv6 SLAAC Router Solicitation and Router
// Advertisement exchange.
// This capture targets IPv6 endpoints, wraps frames in 802.1Q VLAN 120, sets
// TTL 255, and uses post-packet wait gaps (15ms) between frames.
// Wireshark: icmpv6.nd && vlan.id == 120

host vlan_client_v6 {
    ip fe80::120:45
    mac 00:1e:67:d4:12:45
}

host vlan_router_v6 {
    ip fe80::120:1
    mac 00:1e:67:d4:12:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ndp_vlan_slaac_exchange(client, router) {
    client -> router ndp routersolicit slla 00:1e:67:d4:12:45 vlan 120 pcp 6 ttl 255 wait 15ms
    router -> client ndp routeradvert routerlifetime 1800 slla 00:1e:67:d4:12:01 vlan 120 pcp 6 ttl 255
}

// Run ndp_vlan_slaac_exchange(vlan_client_v6, vlan_router_v6) to generate the
// capture.
compile {
    ndp_vlan_slaac_exchange(vlan_client_v6, vlan_router_v6)
}
