// Roaming tablet asserting presence on enterprise wireless controller via
// Neighbor Advertisement.
// This capture targets IPv6 endpoints.
// Wireshark: icmpv6.nd

host roaming_tablet_device { ip fe80::7b1:1 mac b8:27:eb:11:22:33 }

host wlan_controller_gw { ip ff02::1 mac 33:33:00:00:00:01 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wireless_roaming_na(client, wlc) {
    client -> wlc ndp neighboradvert target 2001:db8:feed::50 tlla b8:27:eb:11:22:33
}

// Run wireless_roaming_na(roaming_tablet_device, wlan_controller_gw) to
// generate the capture.
compile {
    wireless_roaming_na(roaming_tablet_device, wlan_controller_gw)
}
