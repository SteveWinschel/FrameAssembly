// Freshly booted campus edge switch establishing OpenFlow control session via
// HELLO and ECHO.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host campus_sdn_director { ip 10.10.10.1 }

host boot_edge_switch { ip 10.10.10.55 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow of_switch_bootstrap(dir, sw) {
    sw -> dir openflow type hello
    dir -> sw openflow type hello
    dir -> sw openflow type echoreq xid 1
    sw -> dir openflow type echoreply xid 1
}

// Run of_switch_bootstrap(campus_sdn_director, boot_edge_switch) to generate
// the capture.
compile {
    of_switch_bootstrap(campus_sdn_director, boot_edge_switch)
}
