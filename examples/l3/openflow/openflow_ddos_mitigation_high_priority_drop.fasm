// PROMPT: SDN security controller reacting to a volumetric flood PACKET_IN by installing a priority 65000 FLOW_MOD drop rule.
// TOKENS: host, ip, mac, flow, dscp, openflow, type, packetin, version, xid, payload, wait, ms, flowmod, tableid, priority, echoreq, echoreply, compile

// INSTRUCTION: Define SDN DDoS mitigation controller monitoring border switch table-miss events.
host ddos_sdn_ctrl {
    ip 10.254.0.10
    mac 00:1c:73:fe:00:0a
}

// INSTRUCTION: Define border OpenFlow 1.3 scrubbing switch enforcing hardware ACL tables.
host border_scrub_sw {
    ip 10.254.0.20
    mac 00:1c:73:fe:00:14
}

// INSTRUCTION: Escalate anomalous packet via PACKET_IN, push high-priority FLOW_MOD in table 0, and confirm liveness.
flow openflow_ddos_mitigate(ctrl, sw) {
    sw -> ctrl dscp 48 openflow type packetin version 4 xid 801 payload "syn_flood_anomaly_sample" wait 5ms
    ctrl -> sw dscp 48 openflow type flowmod version 4 xid 802 tableid 0 priority 65000 payload "drop_malicious_prefix_oxm" wait 5ms
    ctrl -> sw dscp 48 openflow type echoreq version 4 xid 803 wait 5ms
    sw -> ctrl dscp 48 openflow type echoreply version 4 xid 803
}

// INSTRUCTION: Compile the reactive OpenFlow DDoS scrubbing flow installation sequence.
compile {
    openflow_ddos_mitigate(ddos_sdn_ctrl, border_scrub_sw)
}
