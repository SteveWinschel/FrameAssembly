// Minimal OpenFlow 1.3 (version 4) OFPT_HELLO starter packet sent over TCP
// port 6653 with PSH+ACK and automatic TCP sequence tracking. Useful for
// validating SDN controller firewall rules and OpenFlow packet dissectors.
// Wireshark: openflow_v4

host endpoint_a {
    ip 10.66.53.10
    mac 02:00:66:53:00:0a
}

host endpoint_b {
    ip 10.66.53.1
    mac 02:00:66:53:00:01
}

// Transmit one default OpenFlow Hello packet directly inside compile.
compile {
    endpoint_a -> endpoint_b openflow
}
