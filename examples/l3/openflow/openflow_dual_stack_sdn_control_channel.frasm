// Build a dual-stack OpenFlow control plane managing both IPv4 and IPv6 SDN
// switches.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs and
// uses post-packet wait gaps (10ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host ctrl_v4 {
    ip 192.168.210.1
    mac 00:50:56:e3:10:01
}

host sw_v4 {
    ip 192.168.210.11
    mac 00:50:56:e3:10:11
}

host ctrl_v6 {
    ip 2001:db8:210::1
    mac 00:50:56:e3:10:21
}

host sw_v6 {
    ip 2001:db8:210::11
    mac 00:50:56:e3:10:31
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow openflow_dual_stack_session(ctrl, sw) {
    ctrl -> sw openflow featuresreq version 4 xid 701 wait 10ms
    sw -> ctrl openflow featuresreply version 4 xid 701 dpid 987654321 wait 10ms
    ctrl -> sw openflow flowmod version 4 xid 702 tableid 0 priority 0
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    openflow_dual_stack_session(ctrl_v4, sw_v4)
    openflow_dual_stack_session(ctrl_v6, sw_v6)
}
