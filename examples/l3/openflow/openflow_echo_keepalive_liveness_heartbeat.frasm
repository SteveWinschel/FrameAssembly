// Bidirectional OpenFlow echoreq and echoreply keepalive exchange verifying
// channel liveness.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host cluster_sdn_ctrl { ip 172.28.1.5 }

host spine_openflow_sw { ip 172.28.1.15 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow of_echo_liveness(ctrl, sw) {
    ctrl -> sw openflow type echoreq xid 9999
    ctrl <- sw openflow type echoreply xid 9999
}

// Run of_echo_liveness(cluster_sdn_ctrl, spine_openflow_sw) to generate the
// capture.
compile {
    of_echo_liveness(cluster_sdn_ctrl, spine_openflow_sw)
}
