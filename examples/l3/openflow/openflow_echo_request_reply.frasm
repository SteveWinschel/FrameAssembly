// PROMPT: OpenFlow controller-to-switch liveliness verification with ECHO_REQUEST and ECHO_REPLY.
// TOKENS: host, ip, flow, s, openflow, type, echorequest, xid, echoreply, compile

// INSTRUCTION: Define SDN controller.
host sdn_ctrl { ip 192.168.100.1 }

// INSTRUCTION: Define OpenFlow hardware switch.
host sdn_switch { ip 192.168.100.2 }

// INSTRUCTION: Define OpenFlow keepalive flow verifying channel liveliness.
flow of_echo_flow(c, s) {
    c -> s openflow type echorequest xid 1001
    c <- s openflow type echoreply xid 1001
}

// INSTRUCTION: Compile block executing OpenFlow echo transaction.
compile {
    of_echo_flow(sdn_ctrl, sdn_switch)
}
