// OpenFlow controller-to-switch liveliness verification with echoreq and
// echoreply.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host sdn_ctrl { ip 192.168.100.1 }

host sdn_switch { ip 192.168.100.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow of_echo_flow(c, s) {
    c -> s openflow type echorequest xid 1001
    c <- s openflow type echoreply xid 1001
}

// Run of_echo_flow(sdn_ctrl, sdn_switch) to generate the capture.
compile {
    of_echo_flow(sdn_ctrl, sdn_switch)
}
