// PROMPT: Simulate an OpenFlow 1.3 Features Request and Features Reply exchange advertising a 64-bit switch Datapath ID
// TOKENS: host, ip, mac, flow, openflow, featuresreq, version, xid, wait, ms, featuresreply, dpid, compile

// INSTRUCTION: Define the centralized SDN controller
host sdn_ctrl {
    ip 10.100.0.10
    mac 00:1b:21:e0:00:10
}

// INSTRUCTION: Define the OpenFlow virtual switch datapath
host ovs_switch {
    ip 10.100.0.51
    mac 00:1b:21:e0:00:51
}

// INSTRUCTION: Query switch capabilities with FEATURES_REQ and return the DPID in FEATURES_REPLY
flow openflow_features_discovery(ctrl, sw) {
    ctrl -> sw openflow featuresreq version 4 xid 1010 wait 10ms
    sw -> ctrl openflow featuresreply version 4 xid 1010 dpid 72057594037927937
}

// INSTRUCTION: Compile the OpenFlow features negotiation sequence
compile {
    openflow_features_discovery(sdn_ctrl, ovs_switch)
}
