// Simulate an OpenFlow 1.3 Features Request and Features Reply exchange
// advertising a 64-bit switch Datapath ID.
// This capture uses post-packet wait gaps (10ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host sdn_ctrl {
    ip 10.100.0.10
    mac 00:1b:21:e0:00:10
}

host ovs_switch {
    ip 10.100.0.51
    mac 00:1b:21:e0:00:51
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow openflow_features_discovery(ctrl, sw) {
    ctrl -> sw openflow featuresreq version 4 xid 1010 wait 10ms
    sw -> ctrl openflow featuresreply version 4 xid 1010 dpid 72057594037927937
}

// Run openflow_features_discovery(sdn_ctrl, ovs_switch) to generate the
// capture.
compile {
    openflow_features_discovery(sdn_ctrl, ovs_switch)
}
