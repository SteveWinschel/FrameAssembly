// OpenFlow controller querying datapath capabilities via featuresreq and
// featuresreply exchange.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host sdn_central_ctrl { ip 10.100.1.10 }

host sdn_openflow_sw { ip 10.100.1.20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow of_features_handshake(ctrl, sw) {
    ctrl -> sw openflow type featuresreq xid 101
    ctrl <- sw openflow type featuresreply xid 101
}

// Run of_features_handshake(sdn_central_ctrl, sdn_openflow_sw) to generate
// the capture.
compile {
    of_features_handshake(sdn_central_ctrl, sdn_openflow_sw)
}
