// OpenFlow SDN controller programming switch flow table via flowmod message
// with table ID and priority.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host nos_controller { ip 172.16.0.10 }

host of_datapath { ip 172.16.0.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_flowmod_flow(ctrl, dp) {
    ctrl -> dp openflow type flowmod xid 2005 tableid 0 priority 1000
}

// Run of_flowmod_flow(nos_controller, of_datapath) to generate the capture.
compile {
    of_flowmod_flow(nos_controller, of_datapath)
}
