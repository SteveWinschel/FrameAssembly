// OpenFlow controller modifying switch flow table via flowmod with custom
// table ID and priority.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host enterprise_policy_ctrl { ip 10.50.1.1 }

host campus_dist_sw { ip 10.50.1.254 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_flow_mod_rule(ctrl, sw) {
    ctrl -> sw openflow type flowmod xid 4004 tableid 2 priority 500
}

// Run of_flow_mod_rule(enterprise_policy_ctrl, campus_dist_sw) to generate
// the capture.
compile {
    of_flow_mod_rule(enterprise_policy_ctrl, campus_dist_sw)
}
