// OpenFlow SDN control plane channel negotiation using Hello.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host of_controller { ip 10.200.1.1 }

host of_switch { ip 10.200.1.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_hello_flow(c, s) {
    c -> s openflow type hello
}

// Run of_hello_flow(of_controller, of_switch) to generate the capture.
compile {
    of_hello_flow(of_controller, of_switch)
}
