// PROMPT: Generate an OpenFlow 1.3 Flow-Mod message carrying raw hexadecimal OpenFlow Extensible Match (OXM) TLV instructions
// TOKENS: HOST, IP, MAC, FLOW, OPENFLOW, FLOW_MOD, VERSION, XID, TABLE_ID, PRIORITY, HEXPAYLOAD, WAIT, ECHO_REQ, ECHO_REPLY, COMPILE

// INSTRUCTION: Define the SDN policy controller
HOST policy_ctrl {
    IP 172.25.100.1
    MAC 00:1e:67:eb:64:01
}

// INSTRUCTION: Define the programmable whitebox switch
HOST whitebox_sw {
    IP 172.25.100.50
    MAC 00:1e:67:eb:64:50
}

// INSTRUCTION: Push a Flow-Mod rule with hexadecimal OXM match TLVs and verify with Echo
FLOW openflow_oxm_hex_flow_mod(ctrl, sw) {
    ctrl -> sw OPENFLOW FLOW_MOD VERSION 4 XID 7701 TABLE_ID 0 PRIORITY 50000 HEXPAYLOAD "0001000c8000000400000001000000000004001800000000000000000010000000000002ffff000000000000" WAIT 10ms
    ctrl -> sw OPENFLOW ECHO_REQ VERSION 4 XID 7702 HEXPAYLOAD "deadbeefcafebabe" WAIT 10ms
    sw -> ctrl OPENFLOW ECHO_REPLY VERSION 4 XID 7702 HEXPAYLOAD "deadbeefcafebabe"
}

// INSTRUCTION: Compile the hexadecimal OXM Flow-Mod sequence
COMPILE {
    openflow_oxm_hex_flow_mod(policy_ctrl, whitebox_sw)
}
