// PROMPT: Generate an OpenFlow 1.3 Flow-Mod message carrying raw hexadecimal OpenFlow Extensible Match (OXM) TLV instructions
// TOKENS: host, ip, mac, flow, openflow, flowmod, version, xid, tableid, priority, hexpayload, wait, ms, echoreq, echoreply, compile

// INSTRUCTION: Define the SDN policy controller
host policy_ctrl {
    ip 172.25.100.1
    mac 00:1e:67:eb:64:01
}

// INSTRUCTION: Define the programmable whitebox switch
host whitebox_sw {
    ip 172.25.100.50
    mac 00:1e:67:eb:64:50
}

// INSTRUCTION: Push a Flow-Mod rule with hexadecimal OXM match TLVs and verify with Echo
flow openflow_oxm_hex_flow_mod(ctrl, sw) {
    ctrl -> sw openflow flowmod version 4 xid 7701 tableid 0 priority 50000 hexpayload "0001000c8000000400000001000000000004001800000000000000000010000000000002ffff000000000000" wait 10ms
    ctrl -> sw openflow echoreq version 4 xid 7702 hexpayload "deadbeefcafebabe" wait 10ms
    sw -> ctrl openflow echoreply version 4 xid 7702 hexpayload "deadbeefcafebabe"
}

// INSTRUCTION: Compile the hexadecimal OXM Flow-Mod sequence
compile {
    openflow_oxm_hex_flow_mod(policy_ctrl, whitebox_sw)
}
