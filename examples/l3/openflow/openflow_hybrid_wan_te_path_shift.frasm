// Software-defined WAN controller shifting MPLS traffic-engineering paths
// across Table 1 and Table 2 via flowmod.
// This capture uses post-packet wait gaps (5ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host wan_te_ctrl {
    ip 172.30.100.1
    mac 00:50:56:30:64:01
}

host wan_edge_ofs {
    ip 172.30.100.15
    mac 00:50:56:30:64:0f
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow openflow_wan_te_shift(ctrl, ofs) {
    ctrl -> ofs openflow type featuresreq version 4 xid 301 wait 5ms
    ofs -> ctrl openflow type featuresreply version 4 xid 301 dpid 987654321 wait 5ms
    ctrl -> ofs openflow type flowmod version 4 xid 302 tableid 1 priority 40000 wait 5ms
    ctrl -> ofs openflow type flowmod version 4 xid 303 tableid 2 priority 30000
}

// Run openflow_wan_te_shift(wan_te_ctrl, wan_edge_ofs) to generate the
// capture.
compile {
    openflow_wan_te_shift(wan_te_ctrl, wan_edge_ofs)
}
