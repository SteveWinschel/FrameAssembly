// Pure IPv6 OpenFlow 1.3 control channel between cloud controller and virtual
// switch.
// This capture targets IPv6 endpoints.
// Wireshark: (openflow_v4 || openflow_v1) && ipv6

host sdn_v6_controller { ip 2001:db8:5d01::1 }

host sdn_v6_vswitch { ip 2001:db8:5d01::10 }

// Packet sequence (4 frames) with default 10ms post-packet spacing.
flow of_ipv6_session_flow(ctrl, vsw) {
    ctrl -> vsw openflow type hello
    ctrl <- vsw openflow type hello
    ctrl -> vsw openflow type echoreq xid 1001
    ctrl <- vsw openflow type echoreply xid 1001
}

// Run of_ipv6_session_flow(sdn_v6_controller, sdn_v6_vswitch) to generate the
// capture.
compile {
    of_ipv6_session_flow(sdn_v6_controller, sdn_v6_vswitch)
}
