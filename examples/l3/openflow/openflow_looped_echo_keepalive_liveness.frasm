// PROMPT: Simulate a periodic OpenFlow Echo Request and Echo Reply keepalive loop monitoring control channel liveness
// TOKENS: host, ip, mac, flow, openflow, echoreq, version, xid, payload, wait, ms, echoreply, compile

// INSTRUCTION: Define the SDN controller monitoring daemon
host health_ctrl {
    ip 10.180.0.1
    mac 00:50:56:ea:00:01
}

// INSTRUCTION: Define the monitored OpenFlow virtual switch
host monitored_ovs {
    ip 10.180.0.20
    mac 00:50:56:ea:00:20
}

// INSTRUCTION: Exchange an OpenFlow ECHO_REQ and ECHO_REPLY heartbeat pair
flow openflow_echo_heartbeat(ctrl, ovs) {
    ctrl -> ovs openflow echoreq version 4 xid 9900 payload "ofp-keepalive-probe" wait 15ms
    ovs -> ctrl openflow echoreply version 4 xid 9900 payload "ofp-keepalive-probe" wait 35ms
}

// INSTRUCTION: Compile five iterations of the OpenFlow echo keepalive cycle
compile {
    openflow_echo_heartbeat(health_ctrl, monitored_ovs) // cycle 1
    openflow_echo_heartbeat(health_ctrl, monitored_ovs) // cycle 2
    openflow_echo_heartbeat(health_ctrl, monitored_ovs) // cycle 3
    openflow_echo_heartbeat(health_ctrl, monitored_ovs) // cycle 4
    openflow_echo_heartbeat(health_ctrl, monitored_ovs) // cycle 5
}
