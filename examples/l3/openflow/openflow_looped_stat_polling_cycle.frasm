// PROMPT: Periodic OpenFlow echo keepalive requests inside a COMPILE LOOP.
// TOKENS: host, ip, flow, openflow, type, echoreq, xid, wait, ms, compile

// INSTRUCTION: Define telemetry polling SDN controller.
host stat_polling_ctrl { ip 172.31.10.1 }

// INSTRUCTION: Define leaf switch datapath.
host telemetry_leaf_sw { ip 172.31.10.22 }

// INSTRUCTION: Define periodic echo polling transmission flow.
flow of_echo_poll_flow(ctrl, sw) {
    ctrl -> sw openflow type echoreq xid 5050 wait 25ms
}

// INSTRUCTION: Compile loop executing 4 periodic echo polls.
compile {
    of_echo_poll_flow(stat_polling_ctrl, telemetry_leaf_sw) // cycle 1
    of_echo_poll_flow(stat_polling_ctrl, telemetry_leaf_sw) // cycle 2
    of_echo_poll_flow(stat_polling_ctrl, telemetry_leaf_sw) // cycle 3
    of_echo_poll_flow(stat_polling_ctrl, telemetry_leaf_sw) // cycle 4
}
