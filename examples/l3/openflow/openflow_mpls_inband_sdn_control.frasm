// PROMPT: Construct an in-band OpenFlow control session transported over an MPLS-labeled core LSP
// TOKENS: host, ip, mac, flow, lsr, openflow, echoreq, version, xid, mpls, exp, bos, mplsttl, wait, ms, echoreply, flowmod, tableid, priority, compile

// INSTRUCTION: Define the WAN SDN traffic engineering controller
host wan_te_ctrl {
    ip 10.254.0.1
    mac 00:26:99:e6:00:01
}

// INSTRUCTION: Define the core MPLS-OpenFlow hybrid router
host hybrid_lsr {
    ip 10.254.0.42
    mac 00:26:99:e6:00:42
}

// INSTRUCTION: Exchange MPLS-encapsulated OpenFlow Echo and Flow-Mod frames
flow openflow_mpls_inband_flow(ctrl, lsr) {
    ctrl -> lsr openflow echoreq version 4 xid 8100 mpls 55000 exp 6 bos 1 mplsttl 64 wait 10ms
    lsr -> ctrl openflow echoreply version 4 xid 8100 mpls 55001 exp 6 bos 1 mplsttl 64 wait 10ms
    ctrl -> lsr openflow flowmod version 4 xid 8101 tableid 0 priority 55000 mpls 55000 exp 6 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the MPLS in-band OpenFlow session trace
compile {
    openflow_mpls_inband_flow(wan_te_ctrl, hybrid_lsr)
}
