// Construct an in-band OpenFlow control session transported over an
// MPLS-labeled core LSP.
// This capture wraps frames in MPLS label 55000/55001 and uses post-packet
// wait gaps (10ms) between frames.
// Wireshark: (openflow_v4 || openflow_v1) && mpls

host wan_te_ctrl {
    ip 10.254.0.1
    mac 00:26:99:e6:00:01
}

host hybrid_lsr {
    ip 10.254.0.42
    mac 00:26:99:e6:00:42
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow openflow_mpls_inband_flow(ctrl, lsr) {
    ctrl -> lsr openflow echoreq version 4 xid 8100 mpls 55000 exp 6 bos 1 mplsttl 64 wait 10ms
    lsr -> ctrl openflow echoreply version 4 xid 8100 mpls 55001 exp 6 bos 1 mplsttl 64 wait 10ms
    ctrl -> lsr openflow flowmod version 4 xid 8101 tableid 0 priority 55000 mpls 55000 exp 6 bos 1 mplsttl 64
}

// Run openflow_mpls_inband_flow(wan_te_ctrl, hybrid_lsr) to generate the
// capture.
compile {
    openflow_mpls_inband_flow(wan_te_ctrl, hybrid_lsr)
}
