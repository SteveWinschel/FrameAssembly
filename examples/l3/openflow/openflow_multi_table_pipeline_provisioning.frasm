// PROMPT: Generate an OpenFlow 1.3 multi-table pipeline provisioning sequence across ingress ACL, routing, and egress tables
// TOKENS: host, ip, mac, flow, openflow, flowmod, version, xid, tableid, priority, wait, ms, echoreq, echoreply, compile

// INSTRUCTION: Define the SDN fabric orchestrator
host fabric_ctrl {
    ip 10.200.5.1
    mac 00:16:3e:e2:05:01
}

// INSTRUCTION: Define the multi-table OpenFlow leaf switch
host leaf_datapath {
    ip 10.200.5.12
    mac 00:16:3e:e2:05:12
}

// INSTRUCTION: Program Table 0 (ACL), Table 10 (L3 Routing), and Table 20 (Egress Rewrite)
flow openflow_multi_table_setup(ctrl, leaf) {
    ctrl -> leaf openflow flowmod version 4 xid 301 tableid 0 priority 60000 wait 5ms
    ctrl -> leaf openflow flowmod version 4 xid 302 tableid 10 priority 32768 wait 5ms
    ctrl -> leaf openflow flowmod version 4 xid 303 tableid 20 priority 16384 wait 10ms
    ctrl -> leaf openflow echoreq version 4 xid 304 wait 5ms
    leaf -> ctrl openflow echoreply version 4 xid 304
}

// INSTRUCTION: Compile the multi-table OpenFlow provisioning trace
compile {
    openflow_multi_table_setup(fabric_ctrl, leaf_datapath)
}
