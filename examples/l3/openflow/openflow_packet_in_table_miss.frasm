// OpenFlow datapath forwarding unhandled frame to controller via packetin
// message.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host edge_access_sw { ip 172.16.20.2 }

host cloud_sdn_ctrl { ip 172.16.20.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_packet_in_flow(sw, ctrl) {
    sw -> ctrl openflow type packetin xid 2001 payload "BUFFER_TABLE_MISS_RAW_FRAME"
}

// Run of_packet_in_flow(edge_access_sw, cloud_sdn_ctrl) to generate the
// capture.
compile {
    of_packet_in_flow(edge_access_sw, cloud_sdn_ctrl)
}
