// OpenFlow controller sending packetout message injecting Ethernet frame onto
// physical port.
// This capture sends OpenFlow SDN control messages over TCP port 6653.
// Wireshark: openflow_v4 || openflow_v1

host sdn_orchestrator { ip 192.168.10.1 }

host fabric_target_sw { ip 192.168.10.100 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_packet_out_flow(ctrl, sw) {
    ctrl -> sw openflow type packetout xid 3050 payload "ARP_INJECTED_PACKET_PAYLOAD"
}

// Run of_packet_out_flow(sdn_orchestrator, fabric_target_sw) to generate the
// capture.
compile {
    of_packet_out_flow(sdn_orchestrator, fabric_target_sw)
}
