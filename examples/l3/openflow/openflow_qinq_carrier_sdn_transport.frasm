// Simulate a QinQ double-tagged OpenFlow control channel managing a remote
// metro optical-packet switch.
// This capture wraps frames in QinQ S-VLAN 3200 / C-VLAN 999 and uses
// post-packet wait gaps (15ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host metro_sdn_ctrl {
    ip 172.29.0.1
    mac 00:0f:53:e5:29:01
}

host metro_agg_sw {
    ip 172.29.0.88
    mac 00:0f:53:e5:29:88
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow openflow_qinq_control(ctrl, sw) {
    sw -> ctrl openflow packetin version 4 xid 4401 tableid 1 qinq 3200 innervlan 999 wait 15ms
    ctrl -> sw openflow flowmod version 4 xid 4402 tableid 1 priority 45000 qinq 3200 innervlan 999
}

// Run openflow_qinq_control(metro_sdn_ctrl, metro_agg_sw) to generate the
// capture.
compile {
    openflow_qinq_control(metro_sdn_ctrl, metro_agg_sw)
}
