// Dual-tagged QinQ OpenFlow session across carrier transport with DSCP EF
// marking.
// This capture wraps frames in QinQ S-VLAN 200 / C-VLAN 50 and sets DSCP 46.
// Wireshark: openflow_v4 || openflow_v1

host wan_sdn_controller { ip 10.240.0.1 }

host ce_sdn_gateway { ip 10.240.0.50 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_qinq_carrier_flow(ctrl, ce) {
    ctrl -> ce openflow type hello qinq 200 innervlan 50 dscp 46
}

// Run of_qinq_carrier_flow(wan_sdn_controller, ce_sdn_gateway) to generate
// the capture.
compile {
    of_qinq_carrier_flow(wan_sdn_controller, ce_sdn_gateway)
}
