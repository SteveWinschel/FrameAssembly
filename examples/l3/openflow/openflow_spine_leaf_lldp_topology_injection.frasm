// SDN fabric controller injecting LLDP discovery probes via packetout and
// receiving neighbor reports via packetin.
// This capture uses post-packet wait gaps (10ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host fabric_topo_ctrl {
    ip 10.100.250.1
    mac 00:16:3e:64:fa:01
}

host tor_leaf_ofs {
    ip 10.100.250.12
    mac 00:16:3e:64:fa:0c
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow openflow_topo_discovery(ctrl, leaf) {
    ctrl -> leaf openflow type packetout version 4 xid 510 payload "lldp_chassis_spine01_port_eth1" wait 10ms
    leaf -> ctrl openflow type packetin version 4 xid 511 payload "lldp_chassis_spine02_port_eth4" wait 10ms
    ctrl -> leaf openflow type flowmod version 4 xid 512 tableid 0 priority 50000
}

// Run openflow_topo_discovery(fabric_topo_ctrl, tor_leaf_ofs) to generate the
// capture.
compile {
    openflow_topo_discovery(fabric_topo_ctrl, tor_leaf_ofs)
}
