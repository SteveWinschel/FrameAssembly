// PROMPT: Capture a legacy OpenFlow 1.0 (VERSION 1) switch handshake, capability exchange, and flow installation
// TOKENS: host, ip, mac, flow, openflow, version, xid, wait, ms, featuresreq, featuresreply, dpid, flowmod, tableid, priority, compile

// INSTRUCTION: Define the OpenFlow 1.0 controller
host of10_ctrl {
    ip 192.168.55.1
    mac 00:16:3e:e9:55:01
}

// INSTRUCTION: Define the OpenFlow 1.0 access switch
host of10_switch {
    ip 192.168.55.10
    mac 00:16:3e:e9:55:10
}

// INSTRUCTION: Complete the OpenFlow 1.0 HELLO, FEATURES_REQ/REPLY, and FLOW_MOD sequence
flow openflow_v10_lifecycle(ctrl, sw) {
    ctrl -> sw openflow version 1 xid 1 wait 5ms
    sw -> ctrl openflow version 1 xid 1 wait 10ms
    ctrl -> sw openflow featuresreq version 1 xid 2 wait 10ms
    sw -> ctrl openflow featuresreply version 1 xid 2 dpid 65535 wait 10ms
    ctrl -> sw openflow flowmod version 1 xid 3 tableid 0 priority 32768
}

// INSTRUCTION: Compile the OpenFlow 1.0 handshake and flow setup
compile {
    openflow_v10_lifecycle(of10_ctrl, of10_switch)
}
