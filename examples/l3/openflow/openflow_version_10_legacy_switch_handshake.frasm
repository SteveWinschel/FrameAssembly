// Capture a legacy OpenFlow 1.0 (version 1) switch handshake, capability
// exchange, and flow installation.
// This capture uses post-packet wait gaps (5ms, 10ms) between frames.
// Wireshark: openflow_v4 || openflow_v1

host of10_ctrl {
    ip 192.168.55.1
    mac 00:16:3e:e9:55:01
}

host of10_switch {
    ip 192.168.55.10
    mac 00:16:3e:e9:55:10
}

// Packet sequence (5 frames); wait pauses after a packet before the next.
flow openflow_v10_lifecycle(ctrl, sw) {
    ctrl -> sw openflow version 1 xid 1 wait 5ms
    sw -> ctrl openflow version 1 xid 1 wait 10ms
    ctrl -> sw openflow featuresreq version 1 xid 2 wait 10ms
    sw -> ctrl openflow featuresreply version 1 xid 2 dpid 65535 wait 10ms
    ctrl -> sw openflow flowmod version 1 xid 3 tableid 0 priority 32768
}

// Run openflow_v10_lifecycle(of10_ctrl, of10_switch) to generate the capture.
compile {
    openflow_v10_lifecycle(of10_ctrl, of10_switch)
}
