// Generate an 802.1Q VLAN-tagged OpenFlow session over a dedicated
// out-of-band SDN management VLAN.
// This capture wraps frames in 802.1Q VLAN 999 and uses post-packet wait gaps
// (10ms) between frames.
// Wireshark: (openflow_v4 || openflow_v1) && vlan.id == 999

host oob_ctrl {
    ip 10.99.99.1
    mac 00:1e:67:e4:09:01
}

host oob_switch {
    ip 10.99.99.25
    mac 00:1e:67:e4:09:25
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow openflow_vlan_mgmt_flow(ctrl, sw) {
    ctrl -> sw openflow featuresreq version 4 xid 9001 vlan 999 pcp 6 wait 10ms
    sw -> ctrl openflow featuresreply version 4 xid 9001 dpid 4096 vlan 999 pcp 6 wait 10ms
    ctrl -> sw openflow flowmod version 4 xid 9002 tableid 0 priority 25000 vlan 999 pcp 6
}

// Run openflow_vlan_mgmt_flow(oob_ctrl, oob_switch) to generate the capture.
compile {
    openflow_vlan_mgmt_flow(oob_ctrl, oob_switch)
}
