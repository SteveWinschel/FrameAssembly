// 802.1Q tagged OpenFlow control channel running on out-of-band management
// VLAN 99.
// This capture wraps frames in 802.1Q VLAN 99.
// Wireshark: (openflow_v4 || openflow_v1) && vlan.id == 99

host oob_sdn_controller { ip 192.168.99.1 }

host rack_mgmt_switch { ip 192.168.99.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow of_vlan_control_flow(ctrl, sw) {
    ctrl -> sw openflow type hello vlan 99 pcp 5 dei 0
}

// Run of_vlan_control_flow(oob_sdn_controller, rack_mgmt_switch) to generate
// the capture.
compile {
    of_vlan_control_flow(oob_sdn_controller, rack_mgmt_switch)
}
