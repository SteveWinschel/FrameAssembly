// PROMPT: OSPF Database Description packet exchange synchronizing link-state database headers between neighbors.
// TOKENS: HOST, IP, FLOW, ->, <-, OSPF, DBD, ROUTER_ID, AREA_ID, COMPILE

// INSTRUCTION: Define OSPF master router in area 1.
HOST ospf_master { IP 10.1.1.1 }

// INSTRUCTION: Define OSPF slave router in area 1.
HOST ospf_slave { IP 10.1.1.2 }

// INSTRUCTION: Define OSPF DBD exchange flow synchronizing link state database summaries.
FLOW ospf_dbd_flow(m, s) {
    m -> s OSPF DBD ROUTER_ID 10.1.1.1 AREA_ID 1
    m <- s OSPF DBD ROUTER_ID 10.1.1.2 AREA_ID 1
}

// INSTRUCTION: Compile block executing OSPF DBD synchronization.
COMPILE {
    ospf_dbd_flow(ospf_master, ospf_slave)
}
