// OSPF Database Description packet exchange synchronizing link-state database
// headers between neighbors.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host ospf_master { ip 10.1.1.1 }

host ospf_slave { ip 10.1.1.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ospf_dbd_flow(m, s) {
    m -> s ospf dbd routerid 10.1.1.1 areaid 1
    m <- s ospf dbd routerid 10.1.1.2 areaid 1
}

// Run ospf_dbd_flow(ospf_master, ospf_slave) to generate the capture.
compile {
    ospf_dbd_flow(ospf_master, ospf_slave)
}
