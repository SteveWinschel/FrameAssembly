// PROMPT: Data center leaf-spine OSPF point-to-point fast convergence using 1-second Hello and 4-second Dead intervals.
// TOKENS: host, ip, mac, flow, dscp, ttl, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, wait, ms, dbd, lsu, lsack, compile

// INSTRUCTION: Define spine router 1 forming point-to-point OSPF Area 0 adjacency.
host dc_spine_rtr1 {
    ip 10.255.1.1
    mac 00:1c:73:ff:01:01
}

// INSTRUCTION: Define leaf switch 4 participating in 16-way ECMP OSPF fabric routing.
host dc_leaf_sw4 {
    ip 10.255.1.2
    mac 00:1c:73:ff:01:02
}

// INSTRUCTION: Exchange fast OSPF Hellos (1s/4s), Database Description, Link State Update, and Link State Ack.
flow ospf_ecmp_fabric_sync(spine, leaf) {
    spine -> leaf dscp 48 ttl 1 ospf hello routerid 10.255.0.1 areaid 0 hellointerval 1 deadinterval 4 priority 0 wait 5ms
    leaf -> spine dscp 48 ttl 1 ospf hello routerid 10.255.0.14 areaid 0 hellointerval 1 deadinterval 4 priority 0 wait 5ms
    spine -> leaf dscp 48 ttl 1 ospf dbd routerid 10.255.0.1 areaid 0 wait 5ms
    leaf -> spine dscp 48 ttl 1 ospf lsu routerid 10.255.0.14 areaid 0 wait 5ms
    spine -> leaf dscp 48 ttl 1 ospf lsack routerid 10.255.0.1 areaid 0
}

// INSTRUCTION: Compile the data center ECMP leaf-spine OSPF fast convergence sequence.
compile {
    ospf_ecmp_fabric_sync(dc_spine_rtr1, dc_leaf_sw4)
}
