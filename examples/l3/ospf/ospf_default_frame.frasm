// Minimal OSPFv2 Hello starter packet sent over IP protocol 89 to
// AllSPFRouters multicast 224.0.0.5 (01:00:5e:00:00:05) in backbone area
// 0.0.0.0. Switch both hosts to IPv6 addresses to emit an OSPFv3 Hello packet
// instead.
// Wireshark: ospf

host endpoint_a {
    ip 10.89.0.1
    mac 02:00:89:00:00:01
}

host endpoint_b {
    ip 10.89.0.2
    mac 02:00:89:00:00:02
}

// Transmit one default OSPF Hello packet directly inside compile.
compile {
    endpoint_a -> endpoint_b ospf
}
