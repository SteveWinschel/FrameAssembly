// High priority OSPF router asserting Designated Router candidacy with
// Priority 255.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host primary_dr_candidate { ip 172.16.0.254 }

host lan_multicast_dst { ip 224.0.0.5 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_dr_election_flow(dr, dst) {
    dr -> dst ospf hello routerid 172.16.0.254 areaid 0 priority 255
}

// Run ospf_dr_election_flow(primary_dr_candidate, lan_multicast_dst) to
// generate the capture.
compile {
    ospf_dr_election_flow(primary_dr_candidate, lan_multicast_dst)
}
