// PROMPT: Simulate an OSPF broadcast LAN Designated Router (DR) and Backup Designated Router (BDR) election with distinct priorities
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, dstmac, ttl, wait, ms, lsu, lsack, compile

// INSTRUCTION: Define the Designated Router candidate with Priority 200
host dr_candidate {
    ip 192.168.100.1
    mac 00:25:90:f1:00:01
}

// INSTRUCTION: Define the Backup Designated Router candidate with Priority 100
host bdr_candidate {
    ip 192.168.100.2
    mac 00:25:90:f1:00:02
}

// INSTRUCTION: Define the DROther spoke router with Priority 0 (ineligible for DR election)
host drother_spoke {
    ip 192.168.100.3
    mac 00:25:90:f1:00:03
}

// INSTRUCTION: Exchange OSPF Hellos with priorities 200, 100, and 0 followed by DR Network-LSA flooding
flow ospf_dr_bdr_election(dr, bdr, spoke) {
    dr -> bdr ospf hello routerid 10.100.0.1 areaid 0 hellointerval 10 deadinterval 40 priority 200 dstmac 01:00:5e:00:00:05 ttl 1 wait 10ms
    bdr -> dr ospf hello routerid 10.100.0.2 areaid 0 hellointerval 10 deadinterval 40 priority 100 dstmac 01:00:5e:00:00:05 ttl 1 wait 10ms
    spoke -> dr ospf hello routerid 10.100.0.3 areaid 0 hellointerval 10 deadinterval 40 priority 0 dstmac 01:00:5e:00:00:05 ttl 1 wait 20ms
    dr -> spoke ospf lsu routerid 10.100.0.1 areaid 0 dstmac 01:00:5e:00:00:05 ttl 1 wait 10ms
    spoke -> dr ospf lsack routerid 10.100.0.3 areaid 0 dstmac 01:00:5e:00:00:06 ttl 1
}

// INSTRUCTION: Compile the three-router OSPF DR/BDR election sequence
compile {
    ospf_dr_bdr_election(dr_candidate, bdr_candidate, drother_spoke)
}
