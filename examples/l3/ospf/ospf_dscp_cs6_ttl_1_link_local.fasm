// PROMPT: Generate an OSPF control-plane exchange marked with DSCP CS6 network control priority, ECN 0, TTL 1, and Don't Fragment
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, dscp, ecn, ttl, df, wait, ms, lsr, lsu, lsack, compile

// INSTRUCTION: Define the core OSPF router 1
host core_ospf_1 {
    ip 192.0.2.210
    mac 00:25:90:f8:02:10
}

// INSTRUCTION: Define the core OSPF router 2
host core_ospf_2 {
    ip 192.0.2.211
    mac 00:25:90:f8:02:11
}

// INSTRUCTION: Exchange DSCP 48 (CS6) marked OSPF packets with TTL 1 and DF
flow ospf_dscp_cs6_exchange(r1, r2) {
    r1 -> r2 ospf hello routerid 192.0.2.210 areaid 0 hellointerval 10 deadinterval 40 priority 100 dscp 48 ecn 0 ttl 1 df wait 10ms
    r2 -> r1 ospf lsr routerid 192.0.2.211 areaid 0 dscp 48 ecn 0 ttl 1 df wait 10ms
    r1 -> r2 ospf lsu routerid 192.0.2.210 areaid 0 dscp 48 ecn 0 ttl 1 df wait 10ms
    r2 -> r1 ospf lsack routerid 192.0.2.211 areaid 0 dscp 48 ecn 0 ttl 1 df
}

// INSTRUCTION: Compile the DSCP CS6 OSPF control exchange
compile {
    ospf_dscp_cs6_exchange(core_ospf_1, core_ospf_2)
}
