// Build a dual-stack OSPF routing topology running both IPv4 OSPFv2 and IPv6
// OSPFv3 sessions.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs,
// sets TTL 1, and uses post-packet wait gaps (10ms) between frames.
// Wireshark: ospf

host ospf_v4_a {
    ip 198.51.100.10
    mac 00:1e:67:f4:04:01
}

host ospf_v4_b {
    ip 198.51.100.11
    mac 00:1e:67:f4:04:02
}

host ospf_v6_a {
    ip fe80::f4:1
    mac 00:1e:67:f4:06:01
}

host ospf_v6_b {
    ip fe80::f4:2
    mac 00:1e:67:f4:06:02
}

// Packet sequence (4 frames); wait pauses after a packet before the next.
flow ospf_dual_stack_sync(rtr_a, rtr_b) {
    rtr_a -> rtr_b ospf hello routerid 10.255.0.1 areaid 0 hellointerval 10 deadinterval 40 priority 1 ttl 1 wait 10ms
    rtr_b -> rtr_a ospf dbd routerid 10.255.0.2 areaid 0 ttl 1 wait 10ms
    rtr_a -> rtr_b ospf lsu routerid 10.255.0.1 areaid 0 ttl 1 wait 10ms
    rtr_b -> rtr_a ospf lsack routerid 10.255.0.2 areaid 0 ttl 1
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    ospf_dual_stack_sync(ospf_v4_a, ospf_v4_b)
    ospf_dual_stack_sync(ospf_v6_a, ospf_v6_b)
}
