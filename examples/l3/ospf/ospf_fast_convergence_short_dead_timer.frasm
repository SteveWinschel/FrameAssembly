// Fast convergence sub-second OSPF Hello and Dead interval tuning.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host trading_edge_rtr { ip 192.168.12.1 }

host exchange_gw_rtr { ip 224.0.0.5 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_fast_timer_flow(src, dst) {
    src -> dst ospf hello routerid 192.168.12.1 areaid 0 hellointerval 1 deadinterval 4
}

// Run ospf_fast_timer_flow(trading_edge_rtr, exchange_gw_rtr) to generate the
// capture.
compile {
    ospf_fast_timer_flow(trading_edge_rtr, exchange_gw_rtr)
}
