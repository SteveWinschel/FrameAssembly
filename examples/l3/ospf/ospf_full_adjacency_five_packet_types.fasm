// PROMPT: Capture a complete OSPF adjacency bringup exercising all five packet types: Hello, DBD, LSR, LSU, and LSAck
// TOKENS: HOST, IP, MAC, FLOW, OSPF, HELLO, ROUTER_ID, AREA_ID, HELLO_INTERVAL, DEAD_INTERVAL, PRIORITY, TTL, WAIT, DBD, LSR, LSU, LSACK, COMPILE

// INSTRUCTION: Define the primary backbone OSPF router
HOST ospf_rtr_1 {
    IP 10.0.12.1
    MAC 00:1b:21:f0:12:01
}

// INSTRUCTION: Define the neighbor backbone OSPF router
HOST ospf_rtr_2 {
    IP 10.0.12.2
    MAC 00:1b:21:f0:12:02
}

// INSTRUCTION: Transition from Down to Full using HELLO, DBD, LSR, LSU, and LSACK packets
FLOW ospf_full_five_packet_fsm(r1, r2) {
    r1 -> r2 OSPF HELLO ROUTER_ID 1.1.1.1 AREA_ID 0 HELLO_INTERVAL 10 DEAD_INTERVAL 40 PRIORITY 100 TTL 1 WAIT 10ms
    r2 -> r1 OSPF HELLO ROUTER_ID 2.2.2.2 AREA_ID 0 HELLO_INTERVAL 10 DEAD_INTERVAL 40 PRIORITY 50 TTL 1 WAIT 15ms
    r1 -> r2 OSPF DBD ROUTER_ID 1.1.1.1 AREA_ID 0 TTL 1 WAIT 10ms
    r2 -> r1 OSPF DBD ROUTER_ID 2.2.2.2 AREA_ID 0 TTL 1 WAIT 10ms
    r2 -> r1 OSPF LSR ROUTER_ID 2.2.2.2 AREA_ID 0 TTL 1 WAIT 10ms
    r1 -> r2 OSPF LSU ROUTER_ID 1.1.1.1 AREA_ID 0 TTL 1 WAIT 10ms
    r2 -> r1 OSPF LSACK ROUTER_ID 2.2.2.2 AREA_ID 0 TTL 1
}

// INSTRUCTION: Compile the complete five-packet OSPF adjacency trace
COMPILE {
    ospf_full_five_packet_fsm(ospf_rtr_1, ospf_rtr_2)
}
