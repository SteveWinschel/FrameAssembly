// PROMPT: Capture a complete OSPF adjacency bringup exercising all five packet types: Hello, DBD, LSR, LSU, and LSAck
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, ttl, wait, ms, dbd, lsr, lsu, lsack, compile

// INSTRUCTION: Define the primary backbone OSPF router
host ospf_rtr_1 {
    ip 10.0.12.1
    mac 00:1b:21:f0:12:01
}

// INSTRUCTION: Define the neighbor backbone OSPF router
host ospf_rtr_2 {
    ip 10.0.12.2
    mac 00:1b:21:f0:12:02
}

// INSTRUCTION: Transition from Down to Full using HELLO, DBD, LSR, LSU, and LSACK packets
flow ospf_full_five_packet_fsm(r1, r2) {
    r1 -> r2 ospf hello routerid 1.1.1.1 areaid 0 hellointerval 10 deadinterval 40 priority 100 ttl 1 wait 10ms
    r2 -> r1 ospf hello routerid 2.2.2.2 areaid 0 hellointerval 10 deadinterval 40 priority 50 ttl 1 wait 15ms
    r1 -> r2 ospf dbd routerid 1.1.1.1 areaid 0 ttl 1 wait 10ms
    r2 -> r1 ospf dbd routerid 2.2.2.2 areaid 0 ttl 1 wait 10ms
    r2 -> r1 ospf lsr routerid 2.2.2.2 areaid 0 ttl 1 wait 10ms
    r1 -> r2 ospf lsu routerid 1.1.1.1 areaid 0 ttl 1 wait 10ms
    r2 -> r1 ospf lsack routerid 2.2.2.2 areaid 0 ttl 1
}

// INSTRUCTION: Compile the complete five-packet OSPF adjacency trace
compile {
    ospf_full_five_packet_fsm(ospf_rtr_1, ospf_rtr_2)
}
