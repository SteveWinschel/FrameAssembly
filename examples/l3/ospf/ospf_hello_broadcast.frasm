// PROMPT: OSPFv2 Hello packet multicasting to 224.0.0.5 with explicit hello and dead intervals.
// TOKENS: host, ip, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, compile

// INSTRUCTION: Define active OSPF area 0 router.
host ospf_area0_rtr { ip 192.168.1.1 }

// INSTRUCTION: Define AllSPFRouters multicast address 224.0.0.5.
host all_spf_routers { ip 224.0.0.5 }

// INSTRUCTION: Define OSPF Hello broadcast flow configuring intervals and DR priority.
flow ospf_broadcast_flow(rtr, mcast) {
    rtr -> mcast ospf hello routerid 192.168.1.1 areaid 0 hellointerval 10 deadinterval 40 priority 1
}

// INSTRUCTION: Compile block executing OSPF Hello multicast.
compile {
    ospf_broadcast_flow(ospf_area0_rtr, all_spf_routers)
}
