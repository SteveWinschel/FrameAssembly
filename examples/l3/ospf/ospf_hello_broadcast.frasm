// OSPFv2 Hello packet multicasting to 224.0.0.5 with explicit hello and dead
// intervals.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host ospf_area0_rtr { ip 192.168.1.1 }

host all_spf_routers { ip 224.0.0.5 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_broadcast_flow(rtr, mcast) {
    rtr -> mcast ospf hello routerid 192.168.1.1 areaid 0 hellointerval 10 deadinterval 40 priority 1
}

// Run ospf_broadcast_flow(ospf_area0_rtr, all_spf_routers) to generate the
// capture.
compile {
    ospf_broadcast_flow(ospf_area0_rtr, all_spf_routers)
}
