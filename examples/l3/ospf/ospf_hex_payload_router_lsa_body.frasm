// PROMPT: Generate an OSPF Link State Update (LSU) carrying a raw hexadecimal Type-1 Router-LSA payload and LSAck response
// TOKENS: host, ip, mac, flow, ospf, lsu, routerid, areaid, ttl, hexpayload, wait, ms, lsack, compile

// INSTRUCTION: Define the originating OSPF router advertising a new stub link
host lsa_originator {
    ip 172.20.5.1
    mac 00:1e:67:fb:05:01
}

// INSTRUCTION: Define the receiving OSPF neighbor router
host lsa_receiver {
    ip 172.20.5.2
    mac 00:1e:67:fb:05:02
}

// INSTRUCTION: Flood an LSU with hex-encoded Router-LSA bytes and return a hex-encoded LSAck header
flow ospf_hex_router_lsa(orig, recv) {
    orig -> recv ospf lsu routerid 172.20.0.1 areaid 5 ttl 1 hexpayload "0000000100010201ac140001ac14000180000001a1b2002400000001ac140500ffffff000300000a" wait 10ms
    recv -> orig ospf lsack routerid 172.20.0.2 areaid 5 ttl 1 hexpayload "00010201ac140001ac14000180000001a1b20024"
}

// INSTRUCTION: Compile the hexadecimal Router-LSA OSPF flooding sequence
compile {
    ospf_hex_router_lsa(lsa_originator, lsa_receiver)
}
