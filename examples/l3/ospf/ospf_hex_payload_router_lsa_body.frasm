// Generate an OSPF Link State Update (LSU) carrying a raw hexadecimal Type-1
// Router-LSA payload and LSAck response.
// This capture sets TTL 1 and uses post-packet wait gaps (10ms) between
// frames.
// Wireshark: ospf

host lsa_originator {
    ip 172.20.5.1
    mac 00:1e:67:fb:05:01
}

host lsa_receiver {
    ip 172.20.5.2
    mac 00:1e:67:fb:05:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ospf_hex_router_lsa(orig, recv) {
    orig -> recv ospf lsu routerid 172.20.0.1 areaid 5 ttl 1 hexpayload "0000000100010201ac140001ac14000180000001a1b2002400000001ac140500ffffff000300000a" wait 10ms
    recv -> orig ospf lsack routerid 172.20.0.2 areaid 5 ttl 1 hexpayload "00010201ac140001ac14000180000001a1b20024"
}

// Run ospf_hex_router_lsa(lsa_originator, lsa_receiver) to generate the
// capture.
compile {
    ospf_hex_router_lsa(lsa_originator, lsa_receiver)
}
