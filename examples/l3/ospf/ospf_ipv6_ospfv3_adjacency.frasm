// Pure IPv6 OSPFv3 Hello exchange across link-local multicast ff02::5.
// This capture targets IPv6 endpoints.
// Wireshark: ospf && ipv6

host ospfv3_rtr_1 { ip fe80::1:1 }

host ospfv3_rtr_2 { ip fe80::1:2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ospfv3_hello_flow(r1, r2) {
    r1 -> r2 ospf hello areaid 0
    r1 <- r2 ospf hello areaid 0
}

// Run ospfv3_hello_flow(ospfv3_rtr_1, ospfv3_rtr_2) to generate the capture.
compile {
    ospfv3_hello_flow(ospfv3_rtr_1, ospfv3_rtr_2)
}
