// OSPF neighbor acknowledging received LSAs via Link State Acknowledgment
// (LSACK).
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host ospf_ack_peer { ip 172.22.1.2 }

host ospf_all_dr_mcast { ip 224.0.0.6 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_lsack_flow(peer, dr) {
    peer -> dr ospf lsack routerid 172.22.1.2 areaid 0
}

// Run ospf_lsack_flow(ospf_ack_peer, ospf_all_dr_mcast) to generate the
// capture.
compile {
    ospf_lsack_flow(ospf_ack_peer, ospf_all_dr_mcast)
}
