// OSPF router synchronizing database via Link State Request (LSR) packet.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host ospf_loading_neighbor { ip 192.168.200.2 }

host ospf_dr_peer { ip 192.168.200.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_lsr_sync_flow(nbr, dr) {
    nbr -> dr ospf lsr routerid 192.168.200.2 areaid 0
}

// Run ospf_lsr_sync_flow(ospf_loading_neighbor, ospf_dr_peer) to generate the
// capture.
compile {
    ospf_lsr_sync_flow(ospf_loading_neighbor, ospf_dr_peer)
}
