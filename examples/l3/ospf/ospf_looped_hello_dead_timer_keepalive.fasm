// PROMPT: Simulate a periodic OSPF Hello keepalive loop maintaining neighbor adjacency before the Dead Interval expires
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, ttl, wait, ms, compile

// INSTRUCTION: Define the primary WAN OSPF neighbor
host wan_ospf_a {
    ip 10.120.0.1
    mac 00:50:56:fa:12:01
}

// INSTRUCTION: Define the secondary WAN OSPF neighbor
host wan_ospf_b {
    ip 10.120.0.2
    mac 00:50:56:fa:12:02
}

// INSTRUCTION: Exchange bidirectional OSPF Hello keepalives in Area 0
flow ospf_hello_keepalive_pair(rtr_a, rtr_b) {
    rtr_a -> rtr_b ospf hello routerid 10.120.255.1 areaid 0 hellointerval 10 deadinterval 40 priority 100 ttl 1 wait 15ms
    rtr_b -> rtr_a ospf hello routerid 10.120.255.2 areaid 0 hellointerval 10 deadinterval 40 priority 100 ttl 1 wait 35ms
}

// INSTRUCTION: Compile four iterations of the OSPF Hello keepalive cycle
compile {
    ospf_hello_keepalive_pair(wan_ospf_a, wan_ospf_b) // cycle 1
    ospf_hello_keepalive_pair(wan_ospf_a, wan_ospf_b) // cycle 2
    ospf_hello_keepalive_pair(wan_ospf_a, wan_ospf_b) // cycle 3
    ospf_hello_keepalive_pair(wan_ospf_a, wan_ospf_b) // cycle 4
}
