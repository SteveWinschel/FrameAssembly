// PROMPT: Simulate a periodic OSPF Hello keepalive loop maintaining neighbor adjacency before the Dead Interval expires
// TOKENS: HOST, IP, MAC, FLOW, OSPF, HELLO, ROUTER_ID, AREA_ID, HELLO_INTERVAL, DEAD_INTERVAL, PRIORITY, TTL, WAIT, COMPILE, LOOP

// INSTRUCTION: Define the primary WAN OSPF neighbor
HOST wan_ospf_a {
    IP 10.120.0.1
    MAC 00:50:56:fa:12:01
}

// INSTRUCTION: Define the secondary WAN OSPF neighbor
HOST wan_ospf_b {
    IP 10.120.0.2
    MAC 00:50:56:fa:12:02
}

// INSTRUCTION: Exchange bidirectional OSPF Hello keepalives in Area 0
FLOW ospf_hello_keepalive_pair(rtr_a, rtr_b) {
    rtr_a -> rtr_b OSPF HELLO ROUTER_ID 10.120.255.1 AREA_ID 0 HELLO_INTERVAL 10 DEAD_INTERVAL 40 PRIORITY 100 TTL 1 WAIT 15ms
    rtr_b -> rtr_a OSPF HELLO ROUTER_ID 10.120.255.2 AREA_ID 0 HELLO_INTERVAL 10 DEAD_INTERVAL 40 PRIORITY 100 TTL 1 WAIT 35ms
}

// INSTRUCTION: Compile four iterations of the OSPF Hello keepalive cycle
COMPILE {
    LOOP 4 {
        ospf_hello_keepalive_pair(wan_ospf_a, wan_ospf_b)
    }
}
