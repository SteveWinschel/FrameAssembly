// PROMPT: Continuous OSPF Hello heartbeats inside a COMPILE LOOP maintaining adjacency.
// TOKENS: host, ip, flow, ospf, hello, routerid, areaid, wait, ms, compile

// INSTRUCTION: Define core spine router maintaining neighbor adjacency.
host spine_ospf_rtr { ip 10.0.1.1 }

// INSTRUCTION: Define All-OSPF-Routers multicast peer.
host all_ospf_peers { ip 224.0.0.5 }

// INSTRUCTION: Define periodic OSPF Hello heartbeat flow.
flow ospf_hello_heartbeat(spine, peers) {
    spine -> peers ospf hello routerid 10.0.1.1 areaid 0 wait 20ms
}

// INSTRUCTION: Compile loop executing 4 continuous OSPF Hello bursts.
compile {
    ospf_hello_heartbeat(spine_ospf_rtr, all_ospf_peers) // cycle 1
    ospf_hello_heartbeat(spine_ospf_rtr, all_ospf_peers) // cycle 2
    ospf_hello_heartbeat(spine_ospf_rtr, all_ospf_peers) // cycle 3
    ospf_hello_heartbeat(spine_ospf_rtr, all_ospf_peers) // cycle 4
}
