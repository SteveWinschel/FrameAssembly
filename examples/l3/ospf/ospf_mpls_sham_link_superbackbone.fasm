// PROMPT: Construct an OSPF sham-link session between MPLS VPN Provider Edge routers preserving intra-area routes over the superbackbone
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, mpls, exp, bos, mplsttl, ttl, wait, ms, dbd, lsu, lsack, compile

// INSTRUCTION: Define the primary MPLS VPN Provider Edge router
host pe_sham_west {
    ip 10.250.250.1
    mac 00:1b:21:f7:00:01
}

// INSTRUCTION: Define the secondary MPLS VPN Provider Edge router
host pe_sham_east {
    ip 10.250.250.2
    mac 00:1b:21:f7:00:02
}

// INSTRUCTION: Exchange MPLS-labeled OSPF sham-link packets with unicast TTL 64
flow ospf_mpls_sham_link(west, east) {
    west -> east ospf hello routerid 10.250.250.1 areaid 100 hellointerval 10 deadinterval 40 priority 0 mpls 62000 exp 6 bos 1 mplsttl 64 ttl 64 wait 10ms
    east -> west ospf hello routerid 10.250.250.2 areaid 100 hellointerval 10 deadinterval 40 priority 0 mpls 62001 exp 6 bos 1 mplsttl 64 ttl 64 wait 10ms
    west -> east ospf dbd routerid 10.250.250.1 areaid 100 mpls 62000 exp 6 bos 1 mplsttl 64 ttl 64 wait 10ms
    east -> west ospf lsu routerid 10.250.250.2 areaid 100 mpls 62001 exp 6 bos 1 mplsttl 64 ttl 64 wait 10ms
    west -> east ospf lsack routerid 10.250.250.1 areaid 100 mpls 62000 exp 6 bos 1 mplsttl 64 ttl 64
}

// INSTRUCTION: Compile the MPLS sham-link OSPF adjacency flow
compile {
    ospf_mpls_sham_link(pe_sham_west, pe_sham_east)
}
