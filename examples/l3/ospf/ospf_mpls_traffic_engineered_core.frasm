// OSPF routing packets encapsulated within MPLS label stack for core transit.
// This capture wraps frames in MPLS label 2048.
// Wireshark: ospf && mpls

host mpls_pe_ospf_rtr { ip 10.200.0.1 }

host mpls_p_core_rtr { ip 10.200.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_mpls_hello(pe, p) {
    pe -> p ospf hello routerid 10.200.0.1 areaid 0 mpls 2048
}

// Run ospf_mpls_hello(mpls_pe_ospf_rtr, mpls_p_core_rtr) to generate the
// capture.
compile {
    ospf_mpls_hello(mpls_pe_ospf_rtr, mpls_p_core_rtr)
}
