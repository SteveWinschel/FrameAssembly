// PROMPT: Simulate an OSPF Area Border Router (ABR) flooding summary LSAs between Backbone Area 0 and Regional Area 51
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, ttl, wait, ms, lsu, lsack, compile

// INSTRUCTION: Define the Backbone Area 0 internal router
host area0_core {
    ip 10.0.0.1
    mac 00:50:56:f3:00:01
}

// INSTRUCTION: Define the Area Border Router connecting Area 0 and Area 51
host abr_border {
    ip 10.0.0.2
    mac 00:50:56:f3:00:02
}

// INSTRUCTION: Define the Regional Area 51 internal router
host area51_internal {
    ip 10.51.0.2
    mac 00:50:56:f3:51:02
}

// INSTRUCTION: Receive an Area 0 LSU on the ABR and flood a summary LSU into Area 51
flow ospf_abr_inter_area_flood(core, abr, internal) {
    core -> abr ospf hello routerid 10.0.0.1 areaid 0 hellointerval 10 deadinterval 40 priority 1 ttl 1 wait 10ms
    core -> abr ospf lsu routerid 10.0.0.1 areaid 0 ttl 1 wait 5ms
    abr -> core ospf lsack routerid 10.0.0.2 areaid 0 ttl 1 wait 15ms
    abr -> internal ospf hello routerid 10.0.0.2 areaid 51 hellointerval 10 deadinterval 40 priority 100 ttl 1 wait 10ms
    abr -> internal ospf lsu routerid 10.0.0.2 areaid 51 ttl 1 wait 5ms
    internal -> abr ospf lsack routerid 10.51.0.2 areaid 51 ttl 1
}

// INSTRUCTION: Compile the multi-area ABR OSPF flooding sequence
compile {
    ospf_abr_inter_area_flood(area0_core, abr_border, area51_internal)
}
