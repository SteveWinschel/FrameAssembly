// OSPF Area Border Router advertising adjacency on Not-So-Stubby Area (NSSA)
// Area 10.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host abr_nssa_router { ip 172.19.10.1 }

host ospf_all_routers_grp { ip 224.0.0.5 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_nssa_hello(abr, mcast) {
    abr -> mcast ospf hello routerid 172.19.10.1 areaid 10 hellointerval 10 deadinterval 40
}

// Run ospf_nssa_hello(abr_nssa_router, ospf_all_routers_grp) to generate the
// capture.
compile {
    ospf_nssa_hello(abr_nssa_router, ospf_all_routers_grp)
}
