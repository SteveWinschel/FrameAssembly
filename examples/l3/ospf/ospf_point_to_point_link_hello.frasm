// OSPF Hello packets over point-to-point leased line between core routers
// with Area 0.
// This capture exchanges OSPF IP protocol 89 link-state packets toward
// AllSPFRouters.
// Wireshark: ospf

host core_ospf_r1 { ip 10.254.0.1 }

host core_ospf_r2 { ip 10.254.0.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ospf_p2p_hello(r1, r2) {
    r1 -> r2 ospf hello routerid 10.254.0.1 areaid 0
    r1 <- r2 ospf hello routerid 10.254.0.2 areaid 0
}

// Run ospf_p2p_hello(core_ospf_r1, core_ospf_r2) to generate the capture.
compile {
    ospf_p2p_hello(core_ospf_r1, core_ospf_r2)
}
