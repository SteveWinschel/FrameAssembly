// OSPF Area 0 backbone link traversing metro provider QinQ dual-VLAN
// infrastructure.
// This capture wraps frames in QinQ S-VLAN 1000 / C-VLAN 40.
// Wireshark: ospf

host dc_ospf_gw { ip 172.16.100.1 }

host dr_ospf_gw { ip 172.16.100.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ospf_qinq_hello(dc, dr) {
    dc -> dr ospf hello routerid 172.16.100.1 areaid 0 qinq 1000 innervlan 40
}

// Run ospf_qinq_hello(dc_ospf_gw, dr_ospf_gw) to generate the capture.
compile {
    ospf_qinq_hello(dc_ospf_gw, dr_ospf_gw)
}
