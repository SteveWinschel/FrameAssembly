// PROMPT: Simulate a QinQ double-tagged OSPF routing adjacency carried across a metro Ethernet E-Line service
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, qinq, innervlan, ttl, wait, ms, lsu, lsack, compile

// INSTRUCTION: Define the headquarters WAN edge router
host hq_ospf_edge {
    ip 172.30.10.1
    mac 00:26:99:f6:30:01
}

// INSTRUCTION: Define the regional office WAN edge router
host regional_ospf_edge {
    ip 172.30.10.2
    mac 00:26:99:f6:30:02
}

// INSTRUCTION: Exchange QinQ-encapsulated OSPF packets with S-VLAN 2800 and C-VLAN 310
flow ospf_qinq_metro_peering(hq, reg) {
    hq -> reg ospf hello routerid 172.30.0.1 areaid 20 hellointerval 10 deadinterval 40 priority 1 qinq 2800 innervlan 310 ttl 1 wait 10ms
    reg -> hq ospf hello routerid 172.30.0.2 areaid 20 hellointerval 10 deadinterval 40 priority 1 qinq 2800 innervlan 310 ttl 1 wait 15ms
    hq -> reg ospf lsu routerid 172.30.0.1 areaid 20 qinq 2800 innervlan 310 ttl 1 wait 10ms
    reg -> hq ospf lsack routerid 172.30.0.2 areaid 20 qinq 2800 innervlan 310 ttl 1
}

// INSTRUCTION: Compile the QinQ metro OSPF peering trace
compile {
    ospf_qinq_metro_peering(hq_ospf_edge, regional_ospf_edge)
}
