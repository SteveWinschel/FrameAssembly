// PROMPT: OSPF Area Border Router injecting Type-3 Summary default route LSA into Stub Area 51 over VLAN 510.
// TOKENS: host, ip, mac, flow, vlan, pcp, ttl, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, wait, ms, lsu, payload, lsack, compile

// INSTRUCTION: Define Area Border Router interconnecting Backbone Area 0 and Stub Area 51.
host stub_area_abr {
    ip 10.51.0.1
    mac 00:1b:21:33:00:01
}

// INSTRUCTION: Define internal Stub Area 51 router receiving default summary route over VLAN 510.
host stub_internal_rtr {
    ip 10.51.0.2
    mac 00:1b:21:33:00:02
}

// INSTRUCTION: Form Area 51 adjacency on VLAN 510 and flood Type-3 Summary default route via LSU and LSACK.
flow ospf_stub_area_flood(abr, internal) {
    abr -> internal vlan 510 pcp 6 ttl 1 ospf hello routerid 10.0.0.51 areaid 51 hellointerval 10 deadinterval 40 priority 120 wait 10ms
    internal -> abr vlan 510 pcp 6 ttl 1 ospf hello routerid 10.51.0.2 areaid 51 hellointerval 10 deadinterval 40 priority 100 wait 10ms
    abr -> internal vlan 510 pcp 6 ttl 1 ospf lsu routerid 10.0.0.51 areaid 51 payload "summary_lsa_0_0_0_0_metric_1" wait 10ms
    internal -> abr vlan 510 pcp 6 ttl 1 ospf lsack routerid 10.51.0.2 areaid 51
}

// INSTRUCTION: Compile the OSPF Stub Area 51 default summary LSA injection trace.
compile {
    ospf_stub_area_flood(stub_area_abr, stub_internal_rtr)
}
