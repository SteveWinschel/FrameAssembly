// PROMPT: Generate an 802.1Q VLAN-tagged OSPF neighbor adjacency across a campus distribution switch trunk
// TOKENS: host, ip, mac, flow, ospf, hello, routerid, areaid, hellointerval, deadinterval, priority, vlan, pcp, ttl, wait, ms, dbd, lsr, lsu, lsack, compile

// INSTRUCTION: Define the campus distribution switch A on VLAN 310
host dist_sw_a {
    ip 10.31.0.1
    mac 00:0f:53:f5:31:01
}

// INSTRUCTION: Define the campus distribution switch B on VLAN 310
host dist_sw_b {
    ip 10.31.0.2
    mac 00:0f:53:f5:31:02
}

// INSTRUCTION: Exchange VLAN 310 tagged OSPF control frames with 802.1p priority 6
flow ospf_vlan_trunk_adjacency(sw_a, sw_b) {
    sw_a -> sw_b ospf hello routerid 10.31.255.1 areaid 10 hellointerval 10 deadinterval 40 priority 128 vlan 310 pcp 6 ttl 1 wait 10ms
    sw_b -> sw_a ospf hello routerid 10.31.255.2 areaid 10 hellointerval 10 deadinterval 40 priority 64 vlan 310 pcp 6 ttl 1 wait 10ms
    sw_a -> sw_b ospf dbd routerid 10.31.255.1 areaid 10 vlan 310 pcp 6 ttl 1 wait 10ms
    sw_b -> sw_a ospf lsr routerid 10.31.255.2 areaid 10 vlan 310 pcp 6 ttl 1 wait 10ms
    sw_a -> sw_b ospf lsu routerid 10.31.255.1 areaid 10 vlan 310 pcp 6 ttl 1 wait 10ms
    sw_b -> sw_a ospf lsack routerid 10.31.255.2 areaid 10 vlan 310 pcp 6 ttl 1
}

// INSTRUCTION: Compile the VLAN-tagged OSPF campus adjacency flow
compile {
    ospf_vlan_trunk_adjacency(dist_sw_a, dist_sw_b)
}
