// OSPF routing adjacency established across 802.1Q tagged routing VLAN 50.
// This capture wraps frames in 802.1Q VLAN 50.
// Wireshark: ospf && vlan.id == 50

host dist_switch_a { ip 10.50.0.1 }

host dist_switch_b { ip 10.50.0.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ospf_vlan_peering(sw_a, sw_b) {
    sw_a -> sw_b ospf hello routerid 10.50.0.1 areaid 0 vlan 50
    sw_a <- sw_b ospf hello routerid 10.50.0.2 areaid 0 vlan 50
}

// Run ospf_vlan_peering(dist_switch_a, dist_switch_b) to generate the
// capture.
compile {
    ospf_vlan_peering(dist_switch_a, dist_switch_b)
}
