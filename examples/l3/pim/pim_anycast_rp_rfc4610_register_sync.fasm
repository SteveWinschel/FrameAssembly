// PROMPT: RFC 4610 Anycast-RP PIM Register synchronization between two Rendezvous Points sharing 10.255.255.1.
// TOKENS: host, ip, mac, flow, pim, register, group, source, rp, holdtime, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define Anycast-RP member router 1 receiving First-Hop DR Register.
host anycast_rp_member1 {
    ip 10.103.255.11
    mac 00:22:bd:67:ff:0b
}

// INSTRUCTION: Define Anycast-RP member router 2 synchronizing active (S,G) source state.
host anycast_rp_member2 {
    ip 10.103.255.12
    mac 00:22:bd:67:ff:0c
}

// INSTRUCTION: Define RFC 4610 Anycast-RP PIM REGISTER replication between RP peers.
flow pim_anycast_rp_sync_flow(rp1, rp2) {
    rp1 -> rp2 pim register group 239.100.1.1 source 10.50.1.10 rp 10.255.255.1 holdtime 105 dscp 48 ttl 62 payload "ANYCAST_RP_RFC4610_SOURCE_SYNC" wait 5ms
    rp1 <- rp2 pim register group 239.100.1.1 source 10.50.1.10 rp 10.255.255.1 holdtime 105 dscp 48 ttl 62 payload "ANYCAST_RP_REGISTER_STOP_ACK"
}

// INSTRUCTION: Compile the RFC 4610 Anycast-RP PIM Register synchronization flow.
compile {
    pim_anycast_rp_sync_flow(anycast_rp_member1, anycast_rp_member2)
}
