// RFC 7761 Section 4.6 PIM Assert election resolving duplicate multicast
// forwarders on a multi-access broadcast VLAN.
// This capture wraps frames in 802.1Q VLAN 103, sets DSCP 48, TTL 1, carries
// group 239.16.1.1, and uses post-packet wait gaps (3ms) between frames.
// Wireshark: pim && vlan.id == 103

host lan_mcast_fwd_1 {
    ip 172.16.103.1
    mac 00:1c:73:67:01:01
}

host lan_mcast_fwd_2 {
    ip 172.16.103.2
    mac 00:1c:73:67:01:02
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow pim_lan_assert_resolution(r1, r2) {
    r1 -> r2 pim hello group 239.16.1.1 source 10.16.0.10 drpriority 200 holdtime 105 vlan 103 pcp 6 dscp 48 ttl 1 payload "PIM_ASSERT_PREF_110_METRIC_5" wait 3ms
    r1 <- r2 pim hello group 239.16.1.1 source 10.16.0.10 drpriority 100 holdtime 105 vlan 103 pcp 6 dscp 48 ttl 1 payload "PIM_ASSERT_PREF_110_METRIC_20_LOSER" wait 3ms
    r1 <- r2 pim joinprune group 239.16.1.1 source 10.16.0.10 holdtime 210 vlan 103 pcp 6 dscp 48 ttl 1 payload "PIM_PRUNE_LOSING_OIL_INTERFACE"
}

// Run pim_lan_assert_resolution(lan_mcast_fwd_1, lan_mcast_fwd_2) to generate
// the capture.
compile {
    pim_lan_assert_resolution(lan_mcast_fwd_1, lan_mcast_fwd_2)
}
