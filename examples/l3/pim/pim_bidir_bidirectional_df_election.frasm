// RFC 5015 Bidirectional PIM (PIM-Bidir) Designated Forwarder (DF) election
// and Rendezvous Point Address signaling.
// This capture sets DSCP 48, TTL 1 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: pim

host bidir_pim_rtr_a {
    ip 10.50.15.1
    mac 00:1b:21:50:15:01
}

host bidir_pim_rtr_b {
    ip 10.50.15.2
    mac 00:1b:21:50:15:02
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow pim_bidir_df_election(a, b) {
    a -> b pim hello rp 10.50.0.1 drpriority 200 holdtime 105 dscp 48 ttl 1 payload "BIDIR_DF_OFFER_METRIC_10" wait 5ms
    a <- b pim hello rp 10.50.0.1 drpriority 100 holdtime 105 dscp 48 ttl 1 payload "BIDIR_DF_BACKOFF_METRIC_20" wait 5ms
    a -> b pim hello rp 10.50.0.1 drpriority 200 holdtime 105 dscp 48 ttl 1 payload "BIDIR_DF_WINNER_ASSERTED"
}

// Run pim_bidir_df_election(bidir_pim_rtr_a, bidir_pim_rtr_b) to generate the
// capture.
compile {
    pim_bidir_df_election(bidir_pim_rtr_a, bidir_pim_rtr_b)
}
