// RFC 5059 PIM Bootstrap Router (BSR) flooding Candidate-RP-Set mappings
// hop-by-hop to all PIM routers.
// This capture sets DSCP 48, TTL 1, carries group 239.0.0.0, and uses
// post-packet wait gaps (5ms) between frames.
// Wireshark: pim

host pim_elected_bsr {
    ip 10.50.59.1
    mac 00:24:38:50:59:01
}

host pim_all_routers_mcast {
    ip 224.0.0.13
    mac 01:00:5e:00:00:0d
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_bsr_rp_mapping_flood(bsr, mcast) {
    bsr -> mcast pim hello drpriority 255 holdtime 105 dscp 48 ttl 1 wait 5ms
    bsr -> mcast pim hello group 239.0.0.0 rp 10.50.59.254 drpriority 255 holdtime 130 dscp 48 ttl 1 payload "RFC5059_BSR_FRAG_TAG_1024_HASH_MASK_30"
}

// Run pim_bsr_rp_mapping_flood(pim_elected_bsr, pim_all_routers_mcast) to
// generate the capture.
compile {
    pim_bsr_rp_mapping_flood(pim_elected_bsr, pim_all_routers_mcast)
}
