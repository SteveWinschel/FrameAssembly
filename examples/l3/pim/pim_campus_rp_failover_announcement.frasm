// Secondary Rendezvous Point asserting multicast RP tree coordination.
// This capture exchanges PIM IP protocol 103 multicast routing messages.
// Wireshark: pim

host backup_rp_rtr { ip 10.60.0.2 }

host campus_pim_mcast { ip 224.0.0.13 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_rp_failover_hello(rp, dst) {
    rp -> dst pim hello drpriority 200 holdtime 105
}

// Run pim_rp_failover_hello(backup_rp_rtr, campus_pim_mcast) to generate the
// capture.
compile {
    pim_rp_failover_hello(backup_rp_rtr, campus_pim_mcast)
}
