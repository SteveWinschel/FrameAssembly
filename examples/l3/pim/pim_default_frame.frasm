// Minimal PIMv2 (RFC 7761) Hello starter packet sent over IP protocol 103 to
// All-PIM-Routers multicast 224.0.0.13 (01:00:5e:00:00:0d) with default
// Holdtime 105s and DR Priority 1. Useful for verifying multicast router
// adjacency filters on Layer 3 interfaces.
// Wireshark: pim

host endpoint_a {
    ip 10.103.0.1
    mac 02:00:01:03:00:01
}

host endpoint_b {
    ip 10.103.0.2
    mac 02:00:01:03:00:02
}

// Transmit one default PIMv2 Hello packet directly inside compile.
compile {
    endpoint_a -> endpoint_b pim
}
