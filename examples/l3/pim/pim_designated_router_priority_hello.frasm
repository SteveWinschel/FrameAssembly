// PIM Hello packet advertising custom Designated Router Priority 100 on
// multi-access LAN.
// This capture exchanges PIM IP protocol 103 multicast routing messages.
// Wireshark: pim

host core_pim_dr_node { ip 10.80.1.1 }

host all_pim_routers_dst { ip 224.0.0.13 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_dr_hello_flow(src, dst) {
    src -> dst pim hello drpriority 100 holdtime 105
}

// Run pim_dr_hello_flow(core_pim_dr_node, all_pim_routers_dst) to generate
// the capture.
compile {
    pim_dr_hello_flow(core_pim_dr_node, all_pim_routers_dst)
}
