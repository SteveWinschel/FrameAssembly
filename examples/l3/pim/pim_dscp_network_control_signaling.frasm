// PIM Join/Prune signaling prioritizing control packets with DSCP Class
// Selector 6.
// This capture sets DSCP 48, TTL 1 and carries group 239.50.50.1.
// Wireshark: pim

host priority_sub_rtr { ip 10.120.0.2 }

host backbone_mcast_rtr { ip 10.120.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_dscp_join_flow(sub, bb) {
    sub -> bb pim joinprune group 239.50.50.1 source 10.120.100.10 dscp 48 ttl 1
}

// Run pim_dscp_join_flow(priority_sub_rtr, backbone_mcast_rtr) to generate
// the capture.
compile {
    pim_dscp_join_flow(priority_sub_rtr, backbone_mcast_rtr)
}
