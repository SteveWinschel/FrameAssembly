// Dual-stack PIM-SM neighbor discovery and tree join executed across both
// IPv4 and IPv6 campus cores.
// This capture runs the same exchange over both IPv4 and IPv6 host pairs,
// sets DSCP 48, TTL 1, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: pim

host pim_v4_dist {
    ip 10.103.4.2
    mac 00:1e:be:67:04:02
}

host pim_v4_core {
    ip 10.103.4.1
    mac 00:1e:be:67:04:01
}

host pim_v6_dist {
    ip 2001:db8:103:6::2
    mac 00:1e:be:67:06:02
}

host pim_v6_core {
    ip 2001:db8:103:6::1
    mac 00:1e:be:67:06:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_dual_stack_hello_flow(dist, core) {
    dist -> core pim hello drpriority 120 holdtime 105 dscp 48 ttl 1 wait 5ms
    dist <- core pim hello drpriority 240 holdtime 105 dscp 48 ttl 1
}

// Run the flow across both the IPv4 and IPv6 host pairs.
compile {
    pim_dual_stack_hello_flow(pim_v4_dist, pim_v4_core)
    pim_dual_stack_hello_flow(pim_v6_dist, pim_v6_core)
}
