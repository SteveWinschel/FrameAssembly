// Financial exchange ultra-low-latency multicast market data feed (ITCH/OUCH)
// signaled via PIM-SSM with microsecond waits.
// This capture wraps frames in 802.1Q VLAN 200, sets DSCP 48, TTL 1, carries
// group 232.200.1.50, and uses post-packet wait gaps (500us) between frames.
// Wireshark: pim && vlan.id == 200

host trading_leaf_sw {
    ip 10.103.200.10
    mac 00:1c:73:67:c8:0a
}

host ticker_plant_gw {
    ip 10.103.200.1
    mac 00:1c:73:67:c8:01
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow pim_market_data_feed_flow(leaf, gw) {
    leaf -> gw pim hello drpriority 500 holdtime 30 vlan 200 pcp 6 dscp 48 ttl 1 wait 500us
    leaf <- gw pim hello drpriority 1000 holdtime 30 vlan 200 pcp 6 dscp 48 ttl 1 wait 500us
    leaf -> gw pim joinprune group 232.200.1.50 source 192.0.2.200 holdtime 60 vlan 200 pcp 6 dscp 48 ttl 1 payload "PITCH_FEED_A_SSM_JOIN"
}

// Run pim_market_data_feed_flow(trading_leaf_sw, ticker_plant_gw) to generate
// the capture.
compile {
    pim_market_data_feed_flow(trading_leaf_sw, ticker_plant_gw)
}
