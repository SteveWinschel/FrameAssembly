// PROMPT: RFC 7761 Section 4.3.1 PIM Graceful Shutdown sending a PIM Hello with Holdtime 0 (Goodbye) to trigger immediate DR failover.
// TOKENS: host, ip, mac, flow, pim, hello, drpriority, holdtime, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define active PIM Designated Router entering maintenance mode and sending Holdtime 0.
host maint_pim_dr {
    ip 10.103.99.1
    mac 00:1b:63:67:99:01
}

// INSTRUCTION: Define backup PIM router immediately assuming Designated Router role upon Holdtime 0 receipt.
host backup_pim_dr {
    ip 10.103.99.2
    mac 00:1b:63:67:99:02
}

// INSTRUCTION: Define PIM Hello with HOLDTIME 0 (Goodbye) followed by backup DR assertion with DR_PRIORITY 200.
flow pim_goodbye_holdtime_zero(maint, backup) {
    maint -> backup pim hello drpriority 250 holdtime 0 dscp 48 ttl 1 payload "PIM_GOODBYE_IMMEDIATE_NEIGHBOR_EXPIRE" wait 3ms
    maint <- backup pim hello drpriority 200 holdtime 105 dscp 48 ttl 1 payload "PIM_BACKUP_DR_TAKEOVER_ACTIVE"
}

// INSTRUCTION: Compile the PIM Holdtime 0 Graceful Shutdown failover flow.
compile {
    pim_goodbye_holdtime_zero(maint_pim_dr, backup_pim_dr)
}
