// RFC 7761 Section 4.3.1 PIM Graceful Shutdown sending a PIM Hello with
// Holdtime 0 (Goodbye) to trigger immediate DR failover.
// This capture sets DSCP 48, TTL 1 and uses post-packet wait gaps (3ms)
// between frames.
// Wireshark: pim

host maint_pim_dr {
    ip 10.103.99.1
    mac 00:1b:63:67:99:01
}

host backup_pim_dr {
    ip 10.103.99.2
    mac 00:1b:63:67:99:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_goodbye_holdtime_zero(maint, backup) {
    maint -> backup pim hello drpriority 250 holdtime 0 dscp 48 ttl 1 payload "PIM_GOODBYE_IMMEDIATE_NEIGHBOR_EXPIRE" wait 3ms
    maint <- backup pim hello drpriority 200 holdtime 105 dscp 48 ttl 1 payload "PIM_BACKUP_DR_TAKEOVER_ACTIVE"
}

// Run pim_goodbye_holdtime_zero(maint_pim_dr, backup_pim_dr) to generate the
// capture.
compile {
    pim_goodbye_holdtime_zero(maint_pim_dr, backup_pim_dr)
}
