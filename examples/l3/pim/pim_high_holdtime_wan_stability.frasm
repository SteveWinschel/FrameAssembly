// WAN edge router negotiating extended Holdtime 210s for high-latency
// satellite link.
// This capture exchanges PIM IP protocol 103 multicast routing messages.
// Wireshark: pim

host satellite_wan_rtr { ip 172.31.200.1 }

host sat_multicast_dst { ip 224.0.0.13 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_sat_hello_flow(sat, dst) {
    sat -> dst pim hello holdtime 210 drpriority 10
}

// Run pim_sat_hello_flow(satellite_wan_rtr, sat_multicast_dst) to generate
// the capture.
compile {
    pim_sat_hello_flow(satellite_wan_rtr, sat_multicast_dst)
}
