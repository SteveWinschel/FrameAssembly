// PROMPT: Broadband Aggregation Router (BNG) processing IPTV subscriber fast channel zap by pruning old channel and joining new channel.
// TOKENS: host, ip, mac, flow, pim, joinprune, group, source, holdtime, vlan, pcp, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define residential DSLAM / OLT aggregation router handling IPTV channel change.
host olt_iptv_agg {
    ip 10.103.150.10
    mac 00:25:b5:67:96:0a
}

// INSTRUCTION: Define regional video headend multicast distribution router.
host video_headend_rtr {
    ip 10.103.150.1
    mac 00:25:b5:67:96:01
}

// INSTRUCTION: Define rapid PIM Prune of Channel 101 (232.1.1.101) and PIM Join of Channel 102 (232.1.1.102).
flow pim_iptv_channel_zap(olt, headend) {
    olt -> headend pim joinprune group 232.1.1.101 source 10.150.0.10 holdtime 210 vlan 150 pcp 5 dscp 48 ttl 1 payload "PRUNE_TV_CH_101_HD" wait 2ms
    olt -> headend pim joinprune group 232.1.1.102 source 10.150.0.10 holdtime 210 vlan 150 pcp 5 dscp 48 ttl 1 payload "JOIN_TV_CH_102_UHD"
}

// INSTRUCTION: Compile the IPTV fast channel zap PIM Join/Prune pair flow.
compile {
    pim_iptv_channel_zap(olt_iptv_agg, video_headend_rtr)
}
