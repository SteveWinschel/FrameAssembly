// Broadband Aggregation Router (BNG) processing IPTV subscriber fast channel
// zap by pruning old channel and joining new channel.
// This capture wraps frames in 802.1Q VLAN 150, sets DSCP 48, TTL 1, carries
// group 232.1.1.101/232.1.1.102, and uses post-packet wait gaps (2ms) between
// frames.
// Wireshark: pim && vlan.id == 150

host olt_iptv_agg {
    ip 10.103.150.10
    mac 00:25:b5:67:96:0a
}

host video_headend_rtr {
    ip 10.103.150.1
    mac 00:25:b5:67:96:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_iptv_channel_zap(olt, headend) {
    olt -> headend pim joinprune group 232.1.1.101 source 10.150.0.10 holdtime 210 vlan 150 pcp 5 dscp 48 ttl 1 payload "PRUNE_TV_CH_101_HD" wait 2ms
    olt -> headend pim joinprune group 232.1.1.102 source 10.150.0.10 holdtime 210 vlan 150 pcp 5 dscp 48 ttl 1 payload "JOIN_TV_CH_102_UHD"
}

// Run pim_iptv_channel_zap(olt_iptv_agg, video_headend_rtr) to generate the
// capture.
compile {
    pim_iptv_channel_zap(olt_iptv_agg, video_headend_rtr)
}
