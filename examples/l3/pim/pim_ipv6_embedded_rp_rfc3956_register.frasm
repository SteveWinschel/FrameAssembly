// RFC 3956 / RFC 7761 IPv6 Embedded-RP PIM Register sent from First-Hop DR to
// the RP encoded in ff7e:140:2001:db8:beef::1.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 60, IPv6 Flow Label,
// carries group ff7e:140:2001:db8:beef::1, and uses post-packet wait gaps
// (5ms) between frames.
// Wireshark: pim && ipv6

host v6_fhr_dr_node {
    ip 2001:db8:100::1
    mac 00:16:3e:67:01:01
}

host v6_embedded_rp {
    ip 2001:db8:beef::1
    mac 00:16:3e:67:be:ef
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_v6_embedded_rp_reg(dr, rp) {
    dr -> rp pim register group ff7e:140:2001:db8:beef::1 source 2001:db8:100::55 rp 2001:db8:beef::1 holdtime 105 flowlabel 10300 dscp 48 ttl 60 payload "IPV6_EMBEDDED_RP_FIRST_MCAST_PKT" wait 5ms
    dr <- rp pim register group ff7e:140:2001:db8:beef::1 source 2001:db8:100::55 rp 2001:db8:beef::1 holdtime 105 flowlabel 10300 dscp 48 ttl 60 payload "IPV6_EMBEDDED_RP_REGISTER_STOP"
}

// Run pim_v6_embedded_rp_reg(v6_fhr_dr_node, v6_embedded_rp) to generate the
// capture.
compile {
    pim_v6_embedded_rp_reg(v6_fhr_dr_node, v6_embedded_rp)
}
