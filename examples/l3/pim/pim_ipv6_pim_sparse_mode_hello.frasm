// Pure IPv6 PIM-SM Hello packets exchanged on link-local multicast
// destination ff02::d.
// This capture targets IPv6 endpoints.
// Wireshark: pim && ipv6

host pim_v6_edge_1 { ip fe80::101:1 }

host pim_v6_edge_2 { ip fe80::102:2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow pim_v6_hello_flow(r1, r2) {
    r1 -> r2 pim hello
    r1 <- r2 pim hello
}

// Run pim_v6_hello_flow(pim_v6_edge_1, pim_v6_edge_2) to generate the
// capture.
compile {
    pim_v6_hello_flow(pim_v6_edge_1, pim_v6_edge_2)
}
