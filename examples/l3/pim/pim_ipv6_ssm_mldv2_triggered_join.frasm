// RFC 7761 IPv6 PIM-SM / PIM-SSM (S,G) Join triggered by an MLDv2 listener
// for ff3e::8000:1.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 1, carries group
// ff3e::8000:1, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: pim && ipv6

host v6_pim_lhr {
    ip fe80::67:2
    mac 00:25:90:67:00:02
}

host v6_pim_rpf_nbr {
    ip fe80::67:1
    mac 00:25:90:67:00:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_v6_ssm_join_flow(lhr, rpf) {
    lhr -> rpf pim hello drpriority 150 holdtime 105 dscp 48 ttl 1 wait 5ms
    lhr -> rpf pim joinprune group ff3e::8000:1 source 2001:db8:500::10 holdtime 210 dscp 48 ttl 1 payload "IPV6_PIM_SSM_JOIN_SG"
}

// Run pim_v6_ssm_join_flow(v6_pim_lhr, v6_pim_rpf_nbr) to generate the
// capture.
compile {
    pim_v6_ssm_join_flow(v6_pim_lhr, v6_pim_rpf_nbr)
}
