// PROMPT: RFC 7761 IPv6 PIM-SM / PIM-SSM (S,G) Join triggered by an MLDv2 listener for ff3e::8000:1.
// TOKENS: host, ip, mac, flow, pim, hello, drpriority, holdtime, dscp, ttl, wait, ms, joinprune, group, source, payload, compile

// INSTRUCTION: Define IPv6 Last-Hop Designated Router on link-local subnet.
host v6_pim_lhr {
    ip fe80::67:2
    mac 00:25:90:67:00:02
}

// INSTRUCTION: Define IPv6 upstream RPF neighbor router.
host v6_pim_rpf_nbr {
    ip fe80::67:1
    mac 00:25:90:67:00:01
}

// INSTRUCTION: Define IPv6 PIM HELLO and JOIN_PRUNE for SSM group ff3e::8000:1.
flow pim_v6_ssm_join_flow(lhr, rpf) {
    lhr -> rpf pim hello drpriority 150 holdtime 105 dscp 48 ttl 1 wait 5ms
    lhr -> rpf pim joinprune group ff3e::8000:1 source 2001:db8:500::10 holdtime 210 dscp 48 ttl 1 payload "IPV6_PIM_SSM_JOIN_SG"
}

// INSTRUCTION: Compile the IPv6 PIM-SSM (S,G) Join flow.
compile {
    pim_v6_ssm_join_flow(v6_pim_lhr, v6_pim_rpf_nbr)
}
