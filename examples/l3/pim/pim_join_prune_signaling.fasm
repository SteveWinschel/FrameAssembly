// PROMPT: PIM Join message signaling upstream multicast distribution tree for group and source.
// TOKENS: host, ip, flow, pim, joinprune, group, source, compile

// INSTRUCTION: Define downstream PIM router initiating tree join.
host pim_downstream { ip 10.10.1.2 }

// INSTRUCTION: Define upstream PIM reverse path forwarding neighbor.
host pim_upstream_rpf { ip 10.10.1.1 }

// INSTRUCTION: Define PIM Join signaling flow subscribing to source 10.20.30.40 on group 239.1.2.3.
flow pim_join_flow(down, up) {
    down -> up pim joinprune group 239.1.2.3 source 10.20.30.40
}

// INSTRUCTION: Compile block executing PIM Join propagation.
compile {
    pim_join_flow(pim_downstream, pim_upstream_rpf)
}
