// PIM Join message signaling upstream multicast distribution tree for group
// and source.
// This capture carries group 239.1.2.3.
// Wireshark: pim

host pim_downstream { ip 10.10.1.2 }

host pim_upstream_rpf { ip 10.10.1.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_join_flow(down, up) {
    down -> up pim joinprune group 239.1.2.3 source 10.20.30.40
}

// Run pim_join_flow(pim_downstream, pim_upstream_rpf) to generate the
// capture.
compile {
    pim_join_flow(pim_downstream, pim_upstream_rpf)
}
