// RFC 7761 Section 4.3.3 LAN Prune Delay where a downstream router overrides
// a peer's Prune before the Override-Interval expires.
// This capture sets DSCP 48, TTL 1, carries group 239.30.1.1, and uses
// post-packet wait gaps (2ms) between frames.
// Wireshark: pim

host lan_pim_down_1 {
    ip 10.103.30.11
    mac 00:16:3e:67:1e:0b
}

host lan_pim_up_rtr {
    ip 10.103.30.1
    mac 00:16:3e:67:1e:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_prune_override_flow(down, up) {
    down -> up pim joinprune group 239.30.1.1 rp 10.103.0.1 holdtime 210 dscp 48 ttl 1 payload "LAN_PRUNE_PENDING_TIMER_3000MS" wait 2ms
    down -> up pim joinprune group 239.30.1.1 rp 10.103.0.1 holdtime 210 dscp 48 ttl 1 payload "LAN_JOIN_OVERRIDE_KEEP_FORWARDING"
}

// Run pim_prune_override_flow(lan_pim_down_1, lan_pim_up_rtr) to generate the
// capture.
compile {
    pim_prune_override_flow(lan_pim_down_1, lan_pim_up_rtr)
}
