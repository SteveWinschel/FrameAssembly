// PROMPT: Continuous PIM Hello heartbeats inside a COMPILE LOOP maintaining neighbor adjacency.
// TOKENS: host, ip, flow, dst, pim, hello, wait, ms, compile

// INSTRUCTION: Define campus multicast router keeping neighbor adjacency alive.
host campus_pim_rtr { ip 10.77.1.1 }

// INSTRUCTION: Define All-PIM-Routers multicast peer destination.
host all_pim_peers_dst { ip 224.0.0.13 }

// INSTRUCTION: Define periodic PIM Hello heartbeat flow.
flow pim_liveness_heartbeat(rtr, dst) {
    rtr -> dst pim hello wait 30ms
}

// INSTRUCTION: Compile loop executing 4 periodic PIM Hello transmissions.
compile {
    pim_liveness_heartbeat(campus_pim_rtr, all_pim_peers_dst) // cycle 1
    pim_liveness_heartbeat(campus_pim_rtr, all_pim_peers_dst) // cycle 2
    pim_liveness_heartbeat(campus_pim_rtr, all_pim_peers_dst) // cycle 3
    pim_liveness_heartbeat(campus_pim_rtr, all_pim_peers_dst) // cycle 4
}
