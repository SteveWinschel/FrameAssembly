// PROMPT: RFC 6037 / Draft-Rosen Multicast VPN (mVPN) Provider Edge routers running PIM over a Default-MDT group.
// TOKENS: host, ip, mac, flow, pim, hello, drpriority, holdtime, mpls, exp, bos, mplsttl, dscp, ttl, wait, ms, joinprune, group, source, rp, payload, compile

// INSTRUCTION: Define mVPN Provider Edge router PE-1 encapsulating customer PIM inside provider MPLS/GRE.
host mvpn_pe_west {
    ip 10.60.37.1
    mac 00:22:bd:60:37:01
}

// INSTRUCTION: Define mVPN Provider Edge router PE-2 joining Default-MDT 239.255.0.1.
host mvpn_pe_east {
    ip 10.60.37.2
    mac 00:22:bd:60:37:02
}

// INSTRUCTION: Define mVPN PIM adjacency and customer multicast tree Join with MPLS shim 60370.
flow pim_mvpn_default_mdt_flow(pe1, pe2) {
    pe1 -> pe2 pim hello drpriority 100 holdtime 105 mpls 60370 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 wait 5ms
    pe1 <- pe2 pim joinprune group 239.255.0.1 source 10.60.37.1 rp 10.60.37.254 holdtime 210 mpls 60370 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 payload "MVPN_DEFAULT_MDT_JOIN"
}

// INSTRUCTION: Compile the RFC 6037 mVPN Default-MDT PIM flow.
compile {
    pim_mvpn_default_mdt_flow(mvpn_pe_west, mvpn_pe_east)
}
