// RFC 6037 / Draft-Rosen Multicast VPN (mVPN) Provider Edge routers running
// PIM over a Default-MDT group.
// This capture wraps frames in MPLS label 60370, sets DSCP 48, TTL 1, carries
// group 239.255.0.1, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: pim && mpls

host mvpn_pe_west {
    ip 10.60.37.1
    mac 00:22:bd:60:37:01
}

host mvpn_pe_east {
    ip 10.60.37.2
    mac 00:22:bd:60:37:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow pim_mvpn_default_mdt_flow(pe1, pe2) {
    pe1 -> pe2 pim hello drpriority 100 holdtime 105 mpls 60370 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 wait 5ms
    pe1 <- pe2 pim joinprune group 239.255.0.1 source 10.60.37.1 rp 10.60.37.254 holdtime 210 mpls 60370 exp 6 bos 1 mplsttl 64 dscp 48 ttl 1 payload "MVPN_DEFAULT_MDT_JOIN"
}

// Run pim_mvpn_default_mdt_flow(mvpn_pe_west, mvpn_pe_east) to generate the
// capture.
compile {
    pim_mvpn_default_mdt_flow(mvpn_pe_west, mvpn_pe_east)
}
