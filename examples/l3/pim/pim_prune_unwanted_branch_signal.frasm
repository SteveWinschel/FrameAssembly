// Router pruning unneeded multicast distribution tree branch via PIM
// Join/Prune message.
// This capture carries group 239.10.10.1.
// Wireshark: pim

host leaf_dist_router { ip 10.14.0.2 }

host upstream_transit_rtr { ip 10.14.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_prune_branch_flow(leaf, up) {
    leaf -> up pim joinprune group 239.10.10.1 source 10.14.100.5
}

// Run pim_prune_branch_flow(leaf_dist_router, upstream_transit_rtr) to
// generate the capture.
compile {
    pim_prune_branch_flow(leaf_dist_router, upstream_transit_rtr)
}
