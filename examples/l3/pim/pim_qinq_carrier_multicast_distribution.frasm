// PIM multicast signaling transported across provider QinQ dual-VLAN bridge.
// This capture wraps frames in QinQ S-VLAN 800 / C-VLAN 30.
// Wireshark: pim

host broadcast_source_gw { ip 192.168.90.1 }

host carrier_transit_gw { ip 192.168.90.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_qinq_hello_flow(src, gw) {
    src -> gw pim hello qinq 800 innervlan 30
}

// Run pim_qinq_hello_flow(broadcast_source_gw, carrier_transit_gw) to
// generate the capture.
compile {
    pim_qinq_hello_flow(broadcast_source_gw, carrier_transit_gw)
}
