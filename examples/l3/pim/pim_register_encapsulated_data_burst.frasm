// First-hop router encapsulating multicast source stream in PIM REGISTER to
// Rendezvous Point.
// This capture carries group 239.1.1.100.
// Wireshark: pim

host first_hop_source_rtr { ip 10.33.1.1 }

host rendezvous_point_rtr { ip 10.33.254.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_register_flow(fhr, rp) {
    fhr -> rp pim register rp 10.33.254.1 group 239.1.1.100 source 10.33.1.50 payload "RTP_VIDEO_PAYLOAD"
}

// Run pim_register_flow(first_hop_source_rtr, rendezvous_point_rtr) to
// generate the capture.
compile {
    pim_register_flow(first_hop_source_rtr, rendezvous_point_rtr)
}
