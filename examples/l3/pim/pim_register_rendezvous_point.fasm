// PROMPT: PIM Register message transmitting encapsulated multicast data to Rendezvous Point.
// TOKENS: HOST, IP, FLOW, PIM, REGISTER, RP, GROUP, COMPILE

// INSTRUCTION: Define designated router connected to multicast source.
HOST pim_source_dr { IP 192.168.10.1 }

// INSTRUCTION: Define active Rendezvous Point router.
HOST pim_rendezvous_pt { IP 10.254.254.1 }

// INSTRUCTION: Define PIM Register unicast flow to RP for group 239.255.0.1.
FLOW pim_register_flow(dr, rp) {
    dr -> rp PIM REGISTER RP 10.254.254.1 GROUP 239.255.0.1
}

// INSTRUCTION: Compile block executing PIM Register packet.
COMPILE {
    pim_register_flow(pim_source_dr, pim_rendezvous_pt)
}
