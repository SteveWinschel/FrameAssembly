// Downstream PIM router subscribing to shared (*,G) multicast tree toward
// Rendezvous Point.
// This capture carries group 239.255.0.1.
// Wireshark: pim

host branch_pim_downstream { ip 172.25.1.2 }

host upstream_rp_neighbor { ip 172.25.1.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_rp_join_flow(down, up) {
    down -> up pim joinprune group 239.255.0.1 rp 10.0.0.1
}

// Run pim_rp_join_flow(branch_pim_downstream, upstream_rp_neighbor) to
// generate the capture.
compile {
    pim_rp_join_flow(branch_pim_downstream, upstream_rp_neighbor)
}
