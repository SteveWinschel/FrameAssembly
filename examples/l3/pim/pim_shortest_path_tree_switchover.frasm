// Last-hop router initiating source-specific (S,G) Join toward high-bitrate
// media server.
// This capture carries group 232.1.1.1.
// Wireshark: pim

host last_hop_receiver_rtr { ip 192.168.150.2 }

host rpf_neighbor_to_source { ip 192.168.150.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_spt_switchover(lhr, rpf) {
    lhr -> rpf pim joinprune group 232.1.1.1 source 198.51.100.50 holdtime 210
}

// Run pim_spt_switchover(last_hop_receiver_rtr, rpf_neighbor_to_source) to
// generate the capture.
compile {
    pim_spt_switchover(last_hop_receiver_rtr, rpf_neighbor_to_source)
}
