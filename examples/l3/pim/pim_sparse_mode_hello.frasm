// Protocol Independent Multicast sparse-mode Hello packet for neighbor
// discovery.
// This capture exchanges PIM IP protocol 103 multicast routing messages.
// Wireshark: pim

host pim_router_a { ip 10.200.1.1 }

host pim_all_routers { ip 224.0.0.13 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow pim_hello_flow(src, dst) {
    src -> dst pim hello
}

// Run pim_hello_flow(pim_router_a, pim_all_routers) to generate the capture.
compile {
    pim_hello_flow(pim_router_a, pim_all_routers)
}
