// RFC 7761 / RFC 4607 PIM Source-Specific Multicast (PIM-SSM) (S,G) Join in
// the 232.0.0.0/8 SSM range without an RP.
// This capture sets DSCP 48, TTL 1, carries group 232.10.20.30, and uses
// post-packet wait gaps (5ms) between frames.
// Wireshark: pim

host ssm_lhr_router {
    ip 10.103.10.2
    mac 00:1c:73:67:10:02
}

host ssm_upstream_rtr {
    ip 10.103.10.1
    mac 00:1c:73:67:10:01
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow pim_ssm_sg_join_flow(lhr, up) {
    lhr -> up pim hello drpriority 100 holdtime 105 dscp 48 ttl 1 wait 5ms
    lhr <- up pim hello drpriority 200 holdtime 105 dscp 48 ttl 1 wait 5ms
    lhr -> up pim joinprune group 232.10.20.30 source 10.200.1.50 holdtime 210 dscp 48 ttl 1 payload "PIM_SSM_SG_JOIN_NO_RP"
}

// Run pim_ssm_sg_join_flow(ssm_lhr_router, ssm_upstream_rtr) to generate the
// capture.
compile {
    pim_ssm_sg_join_flow(ssm_lhr_router, ssm_upstream_rtr)
}
