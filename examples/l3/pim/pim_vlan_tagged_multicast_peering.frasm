// PIM neighbor Hello exchange over 802.1Q tagged video delivery VLAN 300.
// This capture wraps frames in 802.1Q VLAN 300.
// Wireshark: pim && vlan.id == 300

host video_headend_rtr { ip 172.16.30.1 }

host video_dist_switch { ip 172.16.30.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow pim_vlan_peering(v_src, v_dst) {
    v_src -> v_dst pim hello vlan 300 pcp 5 dei 0
    v_src <- v_dst pim hello vlan 300 pcp 5 dei 0
}

// Run pim_vlan_peering(video_headend_rtr, video_dist_switch) to generate the
// capture.
compile {
    pim_vlan_peering(video_headend_rtr, video_dist_switch)
}
