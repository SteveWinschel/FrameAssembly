// Data center Spine-Leaf underlay using PIM-SM ASM multicast group
// 239.1.1.100 for VXLAN BUM replication.
// This capture sets DSCP 48, TTL 1, carries group 239.1.1.100, and uses
// post-packet wait gaps (3ms) between frames.
// Wireshark: pim

host vtep_leaf4_pim {
    ip 10.250.0.14
    mac 00:1c:73:fa:00:0e
}

host spine1_anycast_rp {
    ip 10.250.0.1
    mac 00:1c:73:fa:00:01
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow pim_vxlan_underlay_bum_tree(leaf, spine) {
    leaf -> spine pim hello drpriority 100 holdtime 90 dscp 48 ttl 1 wait 3ms
    leaf <- spine pim hello drpriority 200 holdtime 90 dscp 48 ttl 1 wait 3ms
    leaf -> spine pim joinprune group 239.1.1.100 rp 10.250.255.1 holdtime 180 dscp 48 ttl 1 payload "VXLAN_BUM_UNDERLAY_MCAST_GROUP_JOIN"
}

// Run pim_vxlan_underlay_bum_tree(vtep_leaf4_pim, spine1_anycast_rp) to
// generate the capture.
compile {
    pim_vxlan_underlay_bum_tree(vtep_leaf4_pim, spine1_anycast_rp)
}
