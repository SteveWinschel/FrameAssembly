// Minimal RIPv2 (RFC 2453) Request starter packet sent over UDP port 520 to
// All-RIP-Routers multicast 224.0.0.9 (01:00:5e:00:00:09). Switch both hosts
// to IPv6 addresses to generate an RFC 2080 RIPng packet on UDP port 521
// toward ff02::9.
// Wireshark: rip

host endpoint_a {
    ip 10.52.0.1
    mac 02:00:05:20:00:01
}

host endpoint_b {
    ip 10.52.0.2
    mac 02:00:05:20:00:02
}

// Transmit one default RIP packet directly inside compile.
compile {
    endpoint_a -> endpoint_b rip
}
