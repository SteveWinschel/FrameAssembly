// RFC 2453 RIPv2 border gateway originating default route 0.0.0.0 with metric
// 1 and external route tag 65001.
// This capture sets DSCP 48, TTL 1 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: rip

host rip_inet_border {
    ip 192.168.254.1
    mac 00:1c:73:fe:00:01
}

host rip_campus_core {
    ip 192.168.254.2
    mac 00:1c:73:fe:00:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_default_originate_flow(core, border) {
    core -> border rip request prefix 0.0.0.0 metric 16 dscp 48 ttl 1 wait 5ms
    core <- border rip response prefix 0.0.0.0 metric 1 nexthop 192.168.254.1 tag 65001 dscp 48 ttl 1
}

// Run rip_default_originate_flow(rip_campus_core, rip_inet_border) to
// generate the capture.
compile {
    rip_default_originate_flow(rip_campus_core, rip_inet_border)
}
