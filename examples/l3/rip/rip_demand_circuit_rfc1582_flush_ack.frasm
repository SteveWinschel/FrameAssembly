// PROMPT: RFC 1582 RIP on Demand Circuits suppressing periodic updates over a metered satellite link after initial table sync.
// TOKENS: host, ip, mac, flow, rip, request, prefix, metric, dscp, ttl, payload, wait, ms, response, nexthop, tag, compile

// INSTRUCTION: Define remote maritime VSAT router running RFC 1582 Demand Circuit RIPv2.
host vsat_demand_rtr {
    ip 172.31.52.10
    mac 00:a0:bc:52:00:0a
}

// INSTRUCTION: Define shore station aggregation router acknowledging demand-circuit table sync.
host shore_demand_agg {
    ip 172.31.52.1
    mac 00:a0:bc:52:00:01
}

// INSTRUCTION: Define initial RIPv2 REQUEST and RESPONSE sync before quieting periodic broadcasts.
flow rip_rfc1582_demand_circuit(vsat, shore) {
    vsat -> shore rip request prefix 0.0.0.0 metric 16 dscp 48 ttl 64 payload "RFC1582_DEMAND_CIRCUIT_POLL" wait 10ms
    vsat <- shore rip response prefix 10.0.0.0 metric 1 nexthop 172.31.52.1 tag 1582 dscp 48 ttl 64 payload "RFC1582_PRESERVED_TABLE_SYNC"
}

// INSTRUCTION: Compile the RFC 1582 RIP Demand Circuit synchronization flow.
compile {
    rip_rfc1582_demand_circuit(vsat_demand_rtr, shore_demand_agg)
}
