// RIP route advertisement prioritizing control plane traffic with DSCP CS6.
// This capture sets DSCP 48, TTL 2.
// Wireshark: rip

host campus_core_dist { ip 10.2.0.1 }

host rip_listener_mcast { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_dscp_update(core, dst) {
    core -> dst rip response prefix 10.2.10.0 metric 1 dscp 48 ttl 2
}

// Run rip_dscp_update(campus_core_dist, rip_listener_mcast) to generate the
// capture.
compile {
    rip_dscp_update(campus_core_dist, rip_listener_mcast)
}
