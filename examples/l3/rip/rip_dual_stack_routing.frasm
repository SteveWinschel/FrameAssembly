// RIP route request query sent to broadcast and multicast routing
// destinations.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host edge_router { ip 172.16.0.10 }

host rip_all_routers { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_inquiry_flow(src, dst) {
    src -> dst rip request
}

// Run rip_inquiry_flow(edge_router, rip_all_routers) to generate the capture.
compile {
    rip_inquiry_flow(edge_router, rip_all_routers)
}
