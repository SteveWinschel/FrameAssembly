// PROMPT: Two parallel distribution routers advertising equal hop-count metric 2 for 10.80.0.0/24 enabling RIPv2 ECMP load balancing.
// TOKENS: host, ip, mac, flow, rip, response, prefix, metric, nexthop, tag, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define distribution router 1 advertising 10.80.0.0 at metric 2.
host ecmp_rip_dist1 {
    ip 192.168.80.1
    mac 00:1c:73:50:00:01
}

// INSTRUCTION: Define access router installing dual equal-cost paths to 10.80.0.0.
host ecmp_rip_access {
    ip 192.168.80.10
    mac 00:1c:73:50:00:0a
}

// INSTRUCTION: Define RIPv2 updates advertising equal METRIC 2 across distinct NEXTHOPs.
flow rip_ecmp_load_share_flow(dist, access) {
    dist -> access rip response prefix 10.80.0.0 metric 2 nexthop 192.168.80.1 tag 80 dscp 48 ttl 1 wait 5ms
    dist -> access rip response prefix 10.80.0.0 metric 2 nexthop 192.168.80.2 tag 80 dscp 48 ttl 1
}

// INSTRUCTION: Compile the RIPv2 Equal-Cost Multipath route advertisement flow.
compile {
    rip_ecmp_load_share_flow(ecmp_rip_dist1, ecmp_rip_access)
}
