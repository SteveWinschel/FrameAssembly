// Two parallel distribution routers advertising equal hop-count metric 2 for
// 10.80.0.0/24 enabling RIPv2 ECMP load balancing.
// This capture sets DSCP 48, TTL 1 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: rip

host ecmp_rip_dist1 {
    ip 192.168.80.1
    mac 00:1c:73:50:00:01
}

host ecmp_rip_access {
    ip 192.168.80.10
    mac 00:1c:73:50:00:0a
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_ecmp_load_share_flow(dist, access) {
    dist -> access rip response prefix 10.80.0.0 metric 2 nexthop 192.168.80.1 tag 80 dscp 48 ttl 1 wait 5ms
    dist -> access rip response prefix 10.80.0.0 metric 2 nexthop 192.168.80.2 tag 80 dscp 48 ttl 1
}

// Run rip_ecmp_load_share_flow(ecmp_rip_dist1, ecmp_rip_access) to generate
// the capture.
compile {
    rip_ecmp_load_share_flow(ecmp_rip_dist1, ecmp_rip_access)
}
