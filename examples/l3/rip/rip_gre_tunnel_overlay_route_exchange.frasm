// PROMPT: RIPv2 routing table exchange traversing a point-to-point overlay subnet between remote retail store gateways.
// TOKENS: host, ip, mac, flow, rip, response, prefix, metric, nexthop, tag, df, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define retail store 101 gateway advertising POS VLAN subnet via RIPv2.
host store_101_gw {
    ip 10.254.101.2
    mac 00:1e:be:fe:65:02
}

// INSTRUCTION: Define retail regional hub gateway aggregating store subnets.
host retail_hub_gw {
    ip 10.254.101.1
    mac 00:1e:be:fe:65:01
}

// INSTRUCTION: Define bidirectional RIPv2 RESPONSE exchange with store TAG 101 and DF bit.
flow rip_retail_overlay_exchange(store, hub) {
    store -> hub rip response prefix 192.168.101.0 metric 1 nexthop 10.254.101.2 tag 101 df dscp 48 ttl 2 wait 5ms
    store <- hub rip response prefix 10.100.0.0 metric 1 nexthop 10.254.101.1 tag 1 df dscp 48 ttl 2
}

// INSTRUCTION: Compile the retail overlay RIPv2 route exchange flow.
compile {
    rip_retail_overlay_exchange(store_101_gw, retail_hub_gw)
}
