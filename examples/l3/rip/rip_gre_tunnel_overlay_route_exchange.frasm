// RIPv2 routing table exchange traversing a point-to-point overlay subnet
// between remote retail store gateways.
// This capture sets DSCP 48, TTL 2, DF bit set and uses post-packet wait gaps
// (5ms) between frames.
// Wireshark: rip

host store_101_gw {
    ip 10.254.101.2
    mac 00:1e:be:fe:65:02
}

host retail_hub_gw {
    ip 10.254.101.1
    mac 00:1e:be:fe:65:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_retail_overlay_exchange(store, hub) {
    store -> hub rip response prefix 192.168.101.0 metric 1 nexthop 10.254.101.2 tag 101 df dscp 48 ttl 2 wait 5ms
    store <- hub rip response prefix 10.100.0.0 metric 1 nexthop 10.254.101.1 tag 1 df dscp 48 ttl 2
}

// Run rip_retail_overlay_exchange(store_101_gw, retail_hub_gw) to generate
// the capture.
compile {
    rip_retail_overlay_exchange(store_101_gw, retail_hub_gw)
}
