// PROMPT: RFC 2453 boundary test advertising the maximum reachable RIPv2 hop count (METRIC 15) before reaching infinity (16).
// TOKENS: host, ip, mac, flow, rip, response, prefix, metric, nexthop, tag, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define 15th-hop daisy-chained industrial telemetry router advertising METRIC 15.
host hop15_field_rtr {
    ip 10.52.15.15
    mac 00:21:59:52:0f:0f
}

// INSTRUCTION: Define 16th-hop edge collector accepting METRIC 15 as the final reachable diameter hop.
host hop16_edge_collector {
    ip 10.52.15.16
    mac 00:21:59:52:0f:10
}

// INSTRUCTION: Define RIPv2 RESPONSE at maximum valid reachable METRIC 15 vs unreachable METRIC 16.
flow rip_metric_15_boundary_flow(hop15, hop16) {
    hop15 -> hop16 rip response prefix 10.1.0.0 metric 15 nexthop 10.52.15.15 tag 15 dscp 48 ttl 1 payload "MAX_REACHABLE_RIP_DIAMETER_15" wait 5ms
    hop15 <- hop16 rip response prefix 10.1.0.0 metric 16 nexthop 0.0.0.0 tag 15 dscp 48 ttl 1 payload "POISON_REVERSE_AT_BOUNDARY_16"
}

// INSTRUCTION: Compile the RIPv2 maximum reachable hop-count metric 15 boundary flow.
compile {
    rip_metric_15_boundary_flow(hop15_field_rtr, hop16_edge_collector)
}
