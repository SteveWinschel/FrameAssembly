// Provider Edge (PE) and Customer Edge (CE) exchanging RIP routes across MPLS
// VPN.
// This capture wraps frames in MPLS label 100.
// Wireshark: rip && mpls

host cust_edge_rtr { ip 10.10.10.2 }

host prov_edge_rtr { ip 10.10.10.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow rip_mpls_pe_ce(ce, pe) {
    ce -> pe rip request mpls 100
    ce <- pe rip response prefix 10.0.0.0 metric 1 mpls 100
}

// Run rip_mpls_pe_ce(cust_edge_rtr, prov_edge_rtr) to generate the capture.
compile {
    rip_mpls_pe_ce(cust_edge_rtr, prov_edge_rtr)
}
