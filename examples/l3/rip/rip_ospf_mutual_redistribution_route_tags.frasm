// Autonomous System Boundary Router (ASBR) redistributing OSPF Area 10 routes
// into RIPv2 with loop-prevention TAG 110.
// This capture sets DSCP 48, TTL 1 and uses post-packet wait gaps (5ms)
// between frames.
// Wireshark: rip

host ospf_rip_asbr1 {
    ip 10.52.10.1
    mac 00:22:bd:52:10:01
}

host ospf_rip_asbr2 {
    ip 10.52.10.2
    mac 00:22:bd:52:10:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_ospf_redistribution_tags(asbr1, asbr2) {
    asbr1 -> asbr2 rip response prefix 10.10.10.0 metric 5 nexthop 10.52.10.1 tag 110 dscp 48 ttl 1 wait 5ms
    asbr1 <- asbr2 rip response prefix 10.20.20.0 metric 2 nexthop 10.52.10.2 tag 120 dscp 48 ttl 1
}

// Run rip_ospf_redistribution_tags(ospf_rip_asbr1, ospf_rip_asbr2) to
// generate the capture.
compile {
    rip_ospf_redistribution_tags(ospf_rip_asbr1, ospf_rip_asbr2)
}
