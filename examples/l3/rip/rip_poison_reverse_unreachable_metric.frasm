// RIPv2 routing update advertising unreachable network route with infinity
// metric 16.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host failed_link_gw { ip 10.15.1.1 }

host rip_all_rtrs_mcast { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_poison_reverse(gw, dst) {
    gw -> dst rip response prefix 10.15.99.0 metric 16
}

// Run rip_poison_reverse(failed_link_gw, rip_all_rtrs_mcast) to generate the
// capture.
compile {
    rip_poison_reverse(failed_link_gw, rip_all_rtrs_mcast)
}
