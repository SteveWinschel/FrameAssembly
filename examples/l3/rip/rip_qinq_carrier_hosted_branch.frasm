// Dual-tagged QinQ RIPv2 frame connecting remote retail branch site.
// This capture wraps frames in QinQ S-VLAN 700 / C-VLAN 12.
// Wireshark: rip

host store_edge_rtr { ip 192.168.12.1 }

host hq_agg_rtr { ip 192.168.12.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_qinq_update(store, hq) {
    store -> hq rip response prefix 192.168.50.0 metric 2 qinq 700 innervlan 12
}

// Run rip_qinq_update(store_edge_rtr, hq_agg_rtr) to generate the capture.
compile {
    rip_qinq_update(store_edge_rtr, hq_agg_rtr)
}
