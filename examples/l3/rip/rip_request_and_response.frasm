// Routing Information Protocol table request and routing response exchange.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host branch_router { ip 192.168.1.1 }

host dist_router { ip 192.168.1.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow rip_exchange_flow(br, dr) {
    br -> dr rip request
    br <- dr rip response
}

// Run rip_exchange_flow(branch_router, dist_router) to generate the capture.
compile {
    rip_exchange_flow(branch_router, dist_router)
}
