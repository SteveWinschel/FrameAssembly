// PROMPT: Routing Information Protocol table request and routing response exchange.
// TOKENS: host, ip, flow, rip, request, response, compile

// INSTRUCTION: Define local branch router.
host branch_router { ip 192.168.1.1 }

// INSTRUCTION: Define regional distribution router.
host dist_router { ip 192.168.1.2 }

// INSTRUCTION: Define RIP request and response flow exchanging routing tables.
flow rip_exchange_flow(br, dr) {
    br -> dr rip request
    br <- dr rip response
}

// INSTRUCTION: Compile block executing RIP routing discovery.
compile {
    rip_exchange_flow(branch_router, dist_router)
}
