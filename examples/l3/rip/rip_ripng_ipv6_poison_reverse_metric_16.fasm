// PROMPT: RFC 2080 RIPng over IPv6 performing Split Horizon with Poisoned Reverse (METRIC 16) between link-local routers.
// TOKENS: host, ip, mac, flow, rip, response, prefix, metric, tag, srcport, dstport, dscp, ttl, wait, ms, payload, compile

// INSTRUCTION: Define IPv6 branch router A advertising prefix 2001:db8:10:: with metric 1.
host ripng_peer_a {
    ip fe80::a:1
    mac 00:1a:a1:05:21:0a
}

// INSTRUCTION: Define IPv6 branch router B echoing the learned prefix back with poisoned metric 16.
host ripng_peer_b {
    ip fe80::b:2
    mac 00:1a:a1:05:21:0b
}

// INSTRUCTION: Define RIPng route advertisement followed by Poison Reverse METRIC 16 response.
flow ripng_v6_poison_reverse(a, b) {
    a -> b rip response prefix 2001:db8:10:: metric 1 tag 10 srcport 521 dstport 521 dscp 48 ttl 255 wait 5ms
    a <- b rip response prefix 2001:db8:10:: metric 16 tag 10 srcport 521 dstport 521 dscp 48 ttl 255 payload "RIPNG_POISON_REVERSE_INFINITY"
}

// INSTRUCTION: Compile the RFC 2080 RIPng IPv6 Poison Reverse flow.
compile {
    ripng_v6_poison_reverse(ripng_peer_a, ripng_peer_b)
}
