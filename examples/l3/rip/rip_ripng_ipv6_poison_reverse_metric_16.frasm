// RFC 2080 RIPng over IPv6 performing Split Horizon with Poisoned Reverse
// (METRIC 16) between link-local routers.
// This capture targets IPv6 endpoints, sets DSCP 48, TTL 255, carries
// destination port 521, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: ripng

host ripng_peer_a {
    ip fe80::a:1
    mac 00:1a:a1:05:21:0a
}

host ripng_peer_b {
    ip fe80::b:2
    mac 00:1a:a1:05:21:0b
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow ripng_v6_poison_reverse(a, b) {
    a -> b rip response prefix 2001:db8:10:: metric 1 tag 10 srcport 521 dstport 521 dscp 48 ttl 255 wait 5ms
    a <- b rip response prefix 2001:db8:10:: metric 16 tag 10 srcport 521 dstport 521 dscp 48 ttl 255 payload "RIPNG_POISON_REVERSE_INFINITY"
}

// Run ripng_v6_poison_reverse(ripng_peer_a, ripng_peer_b) to generate the
// capture.
compile {
    ripng_v6_poison_reverse(ripng_peer_a, ripng_peer_b)
}
