// Pure IPv6 RIPng route advertisement sent to multicast ff02::9 on UDP port
// 521.
// This capture targets IPv6 endpoints.
// Wireshark: ripng

host ripng_rtr_1 { ip fe80::1001:1 }

host ripng_all_routers_dst { ip ff02::9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow ripng_advert_flow(rtr, dst) {
    rtr -> dst rip response
}

// Run ripng_advert_flow(ripng_rtr_1, ripng_all_routers_dst) to generate the
// capture.
compile {
    ripng_advert_flow(ripng_rtr_1, ripng_all_routers_dst)
}
