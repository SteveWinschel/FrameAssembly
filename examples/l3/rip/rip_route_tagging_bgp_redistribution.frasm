// RIPv2 route update carrying autonomous system route tag 65001 for BGP
// redistribution.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host asbr_redist_rtr { ip 192.168.44.1 }

host internal_rip_peers { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_tagging_flow(asbr, peers) {
    asbr -> peers rip response prefix 192.168.100.0 metric 2 tag 65001
}

// Run rip_tagging_flow(asbr_redist_rtr, internal_rip_peers) to generate the
// capture.
compile {
    rip_tagging_flow(asbr_redist_rtr, internal_rip_peers)
}
