// RIPv2 routing update advertising network prefixes, hop metric, and next
// hop.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host core_rip_gw { ip 10.0.0.1 }

host rip_mcast_dst { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_update_flow(gw, dst) {
    gw -> dst rip response prefix 10.10.0.0 metric 2 nexthop 10.0.0.1
}

// Run rip_update_flow(core_rip_gw, rip_mcast_dst) to generate the capture.
compile {
    rip_update_flow(core_rip_gw, rip_mcast_dst)
}
