// Network management station querying a router's RIPv2 table for specific
// subnet entries via Command 1 (REQUEST).
// This capture sets DSCP 16/48, TTL 64, carries destination port 520/55520,
// and uses post-packet wait gaps (4ms) between frames.
// Wireshark: rip

host nms_rip_poller {
    ip 10.52.250.100
    mac 00:50:56:52:fa:64
}

host managed_rip_rtr {
    ip 10.52.250.1
    mac 00:50:56:52:fa:01
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_diagnostic_entry_poll(nms, rtr) {
    nms -> rtr rip request prefix 10.120.0.0 metric 16 srcport 55520 dstport 520 dscp 16 ttl 64 wait 4ms
    nms <- rtr rip response prefix 10.120.0.0 metric 4 nexthop 10.52.250.254 tag 400 srcport 520 dstport 55520 dscp 48 ttl 64
}

// Run rip_diagnostic_entry_poll(nms_rip_poller, managed_rip_rtr) to generate
// the capture.
compile {
    rip_diagnostic_entry_poll(nms_rip_poller, managed_rip_rtr)
}
