// RIPv2 distribution update advertising branch route with metric 3 and
// explicit NEXTHOP.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host reg_dist_router { ip 172.20.1.1 }

host branch_agg_peer { ip 172.20.1.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_split_horizon(dist, br) {
    dist -> br rip response prefix 172.20.10.0 metric 3 nexthop 172.20.1.254
}

// Run rip_split_horizon(reg_dist_router, branch_agg_peer) to generate the
// capture.
compile {
    rip_split_horizon(reg_dist_router, branch_agg_peer)
}
