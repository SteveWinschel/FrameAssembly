// RFC 2453 Section 4 RIPv2 advertising a third-party NEXTHOP on a shared
// multi-access broadcast subnet to avoid extra hop.
// This capture wraps frames in 802.1Q VLAN 52, sets DSCP 48, TTL 1, and uses
// post-packet wait gaps (5ms) between frames.
// Wireshark: rip && vlan.id == 52

host dmz_rip_speaker {
    ip 172.16.52.1
    mac 00:16:3e:52:00:01
}

host dmz_fw_listener {
    ip 172.16.52.2
    mac 00:16:3e:52:00:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_third_party_nexthop(speaker, fw) {
    speaker -> fw rip response prefix 10.100.50.0 metric 3 nexthop 172.16.52.254 tag 100 vlan 52 pcp 6 dscp 48 ttl 1 wait 5ms
    speaker <- fw rip response prefix 192.168.0.0 metric 1 nexthop 0.0.0.0 tag 0 vlan 52 pcp 6 dscp 48 ttl 1
}

// Run rip_third_party_nexthop(dmz_rip_speaker, dmz_fw_listener) to generate
// the capture.
compile {
    rip_third_party_nexthop(dmz_rip_speaker, dmz_fw_listener)
}
