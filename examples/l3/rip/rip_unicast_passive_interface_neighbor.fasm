// PROMPT: RIPv2 unicast neighbor exchange over a non-broadcast multi-access (NBMA) link with passive-interface enabled.
// TOKENS: HOST, IP, MAC, FLOW, RIP, REQUEST, PREFIX, METRIC, SRCPORT, DSTPORT, DF, DSCP, TTL, WAIT, RESPONSE, NEXTHOP, TAG, COMPILE

// INSTRUCTION: Define headquarters NBMA hub router sending unicast RIPv2 updates to configured neighbor.
HOST nbma_rip_hub {
    IP 172.25.52.1
    MAC 00:1e:13:52:00:01
}

// INSTRUCTION: Define remote NBMA spoke router exchanging unicast UDP port 520 packets.
HOST nbma_rip_spoke {
    IP 172.25.52.10
    MAC 00:1e:13:52:00:0a
}

// INSTRUCTION: Define unicast RIPv2 REQUEST and RESPONSE on UDP port 520 with DF flag set.
FLOW rip_unicast_nbma_flow(hub, spoke) {
    hub -> spoke RIP REQUEST PREFIX 172.25.100.0 METRIC 1 SRCPORT 520 DSTPORT 520 DF DSCP 48 TTL 64 WAIT 10ms
    hub <- spoke RIP RESPONSE PREFIX 172.25.100.0 METRIC 2 NEXTHOP 172.25.52.10 TAG 25 SRCPORT 520 DSTPORT 520 DF DSCP 48 TTL 64
}

// INSTRUCTION: Compile the unicast NBMA passive-interface RIPv2 neighbor flow.
COMPILE {
    rip_unicast_nbma_flow(nbma_rip_hub, nbma_rip_spoke)
}
