// RIPv2 unicast neighbor exchange over a non-broadcast multi-access (NBMA)
// link with passive-interface enabled.
// This capture sets DSCP 48, TTL 64, DF bit set, carries destination port
// 520, and uses post-packet wait gaps (10ms) between frames.
// Wireshark: rip

host nbma_rip_hub {
    ip 172.25.52.1
    mac 00:1e:13:52:00:01
}

host nbma_rip_spoke {
    ip 172.25.52.10
    mac 00:1e:13:52:00:0a
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow rip_unicast_nbma_flow(hub, spoke) {
    hub -> spoke rip request prefix 172.25.100.0 metric 1 srcport 520 dstport 520 df dscp 48 ttl 64 wait 10ms
    hub <- spoke rip response prefix 172.25.100.0 metric 2 nexthop 172.25.52.10 tag 25 srcport 520 dstport 520 df dscp 48 ttl 64
}

// Run rip_unicast_nbma_flow(nbma_rip_hub, nbma_rip_spoke) to generate the
// capture.
compile {
    rip_unicast_nbma_flow(nbma_rip_hub, nbma_rip_spoke)
}
