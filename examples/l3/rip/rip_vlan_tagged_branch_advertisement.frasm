// 802.1Q tagged RIPv2 update broadcast across branch routing VLAN 20.
// This capture wraps frames in 802.1Q VLAN 20.
// Wireshark: rip && vlan.id == 20

host branch_gw_vlan20 { ip 10.20.0.1 }

host vlan20_broadcast { ip 224.0.0.9 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_vlan_update(gw, dst) {
    gw -> dst rip response prefix 10.20.100.0 metric 1 vlan 20
}

// Run rip_vlan_update(branch_gw_vlan20, vlan20_broadcast) to generate the
// capture.
compile {
    rip_vlan_update(branch_gw_vlan20, vlan20_broadcast)
}
