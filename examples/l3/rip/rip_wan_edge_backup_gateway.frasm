// WAN edge router advertising failover default route with higher metric 5.
// This capture sends UDP port 520/521 RIP route requests and updates.
// Wireshark: rip

host backup_wan_gw { ip 172.28.0.2 }

host internal_core_gw { ip 172.28.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow rip_backup_route_flow(wan, core) {
    wan -> core rip response prefix 0.0.0.0 metric 5
}

// Run rip_backup_route_flow(backup_wan_gw, internal_core_gw) to generate the
// capture.
compile {
    rip_backup_route_flow(backup_wan_gw, internal_core_gw)
}
