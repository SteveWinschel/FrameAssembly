// IPv6 branch router soliciting routing table updates via RIPng REQUEST.
// This capture targets IPv6 endpoints.
// Wireshark: ripng

host ripng_edge_boot { ip fe80::e01:1 }

host ripng_core_dist { ip fe80::c01:1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow ripng_query_exchange(edge, core) {
    edge -> core rip request
    edge <- core rip response
}

// Run ripng_query_exchange(ripng_edge_boot, ripng_core_dist) to generate the
// capture.
compile {
    ripng_query_exchange(ripng_edge_boot, ripng_core_dist)
}
