// PROMPT: Data center ToR pair running VRRPv3 over SVI VLAN 400 with ultra-fast 5-centisecond (50ms) advertisement intervals.
// TOKENS: host, ip, mac, flow, vrrp, vrid, priority, advint, vip, version, vlan, pcp, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define ToR Leaf Switch A acting as VRRPv3 Master on VLAN 400.
host tor_svi400_leaf_a {
    ip 10.40.0.252
    mac 00:00:5e:00:01:90
}

// INSTRUCTION: Define ToR Leaf Switch B acting as VRRPv3 Backup on VLAN 400.
host tor_svi400_leaf_b {
    ip 10.40.0.253
    mac 00:1c:73:40:00:fd
}

// INSTRUCTION: Define VLAN 400 VRRPv3 advertisements with ADV_INT 5 (50ms) and VRID 144.
flow vrrp_tor_svi_5cs_flow(leaf_a, leaf_b) {
    leaf_a -> leaf_b vrrp vrid 144 priority 210 advint 5 vip 10.40.0.1 version 3 vlan 400 pcp 7 dscp 56 ttl 255 wait 50ms
    leaf_a -> leaf_b vrrp vrid 144 priority 210 advint 5 vip 10.40.0.1 version 3 vlan 400 pcp 7 dscp 56 ttl 255
}

// INSTRUCTION: Compile the ToR SVI 5-centisecond VRRPv3 flow.
compile {
    vrrp_tor_svi_5cs_flow(tor_svi400_leaf_a, tor_svi400_leaf_b)
}
