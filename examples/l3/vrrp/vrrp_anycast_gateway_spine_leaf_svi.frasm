// Data center ToR pair running VRRPv3 over SVI VLAN 400 with ultra-fast
// 5-centisecond (50ms) advertisement intervals.
// This capture wraps frames in 802.1Q VLAN 400, sets DSCP 56, TTL 255,
// carries VRID 144, and uses post-packet wait gaps (50ms) between frames.
// Wireshark: vrrp && vlan.id == 400

host tor_svi400_leaf_a {
    ip 10.40.0.252
    mac 00:00:5e:00:01:90
}

host tor_svi400_leaf_b {
    ip 10.40.0.253
    mac 00:1c:73:40:00:fd
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_tor_svi_5cs_flow(leaf_a, leaf_b) {
    leaf_a -> leaf_b vrrp vrid 144 priority 210 advint 5 vip 10.40.0.1 version 3 vlan 400 pcp 7 dscp 56 ttl 255 wait 50ms
    leaf_a -> leaf_b vrrp vrid 144 priority 210 advint 5 vip 10.40.0.1 version 3 vlan 400 pcp 7 dscp 56 ttl 255
}

// Run vrrp_tor_svi_5cs_flow(tor_svi400_leaf_a, tor_svi400_leaf_b) to generate
// the capture.
compile {
    vrrp_tor_svi_5cs_flow(tor_svi400_leaf_a, tor_svi400_leaf_b)
}
