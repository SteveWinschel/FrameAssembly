// VRRP backup gateway monitoring virtual router with low priority 50 on VRID
// 10.
// This capture carries VRID 10.
// Wireshark: vrrp

host vrrp_secondary_backup { ip 10.1.1.253 }

host vrrp_mcast_dest { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_backup_flow(backup, dst) {
    backup -> dst vrrp vrid 10 priority 50 vip 10.1.1.1
}

// Run vrrp_backup_flow(vrrp_secondary_backup, vrrp_mcast_dest) to generate
// the capture.
compile {
    vrrp_backup_flow(vrrp_secondary_backup, vrrp_mcast_dest)
}
