// Minimal VRRPv3 (RFC 5798) Advertisement starter packet sent over IP
// protocol 112 to multicast 224.0.0.18 (01:00:5e:00:00:12) with VRID 1,
// Priority 100, and TTL 255. Useful for validating FHRP firewall rules and
// switch multicast flood limits.
// Wireshark: vrrp

host endpoint_a {
    ip 10.112.0.2
    mac 02:00:01:12:00:02
}

host endpoint_b {
    ip 10.112.0.3
    mac 02:00:01:12:00:03
}

// Transmit one default VRRP advertisement directly inside compile.
compile {
    endpoint_a -> endpoint_b vrrp
}
