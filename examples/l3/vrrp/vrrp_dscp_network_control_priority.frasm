// VRRP master advertisement marked with DSCP Class Selector 6 for control
// plane prioritization.
// This capture sets DSCP 48, TTL 255 and carries VRID 8.
// Wireshark: vrrp

host campus_core_gw { ip 172.18.1.254 }

host vrrp_mcast_addr { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_dscp_flow(gw, dst) {
    gw -> dst vrrp vrid 8 priority 160 vip 172.18.1.1 dscp 48 ttl 255
}

// Run vrrp_dscp_flow(campus_core_gw, vrrp_mcast_addr) to generate the
// capture.
compile {
    vrrp_dscp_flow(campus_core_gw, vrrp_mcast_addr)
}
