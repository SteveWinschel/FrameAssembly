// VRRP router redundancy advertisement specifying advertisement interval.
// This capture carries VRID 5.
// Wireshark: vrrp

host ha_router_a { ip 172.16.1.254 }

host vrrp_listener { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_fast_hb(rtr, mcast) {
    rtr -> mcast vrrp vrid 5 priority 200 advint 100 vip 172.16.1.1
}

// Run vrrp_fast_hb(ha_router_a, vrrp_listener) to generate the capture.
compile {
    vrrp_fast_hb(ha_router_a, vrrp_listener)
}
