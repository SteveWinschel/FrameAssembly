// Active-Standby enterprise firewall cluster synchronizing state and
// executing VRRP VRID 75 failover across DMZ VLAN 75.
// This capture wraps frames in 802.1Q VLAN 75, sets DSCP 48, TTL 255, carries
// VRID 75, and uses post-packet wait gaps (20ms, 5ms) between frames.
// Wireshark: vrrp && vlan.id == 75

host fw_ha_node_1 {
    ip 172.20.75.2
    mac 00:00:5e:00:01:4b
}

host fw_ha_node_2 {
    ip 172.20.75.3
    mac 00:00:5e:00:01:4b
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow vrrp_fw_cluster_failover(fw1, fw2) {
    fw1 -> fw2 vrrp vrid 75 priority 200 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255 wait 20ms
    fw1 -> fw2 vrrp vrid 75 priority 0 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255 wait 5ms
    fw1 <- fw2 vrrp vrid 75 priority 190 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255
}

// Run vrrp_fw_cluster_failover(fw_ha_node_1, fw_ha_node_2) to generate the
// capture.
compile {
    vrrp_fw_cluster_failover(fw_ha_node_1, fw_ha_node_2)
}
