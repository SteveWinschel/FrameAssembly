// PROMPT: Active-Standby enterprise firewall cluster synchronizing state and executing VRRP VRID 75 failover across DMZ VLAN 75.
// TOKENS: host, ip, mac, flow, vrrp, vrid, priority, advint, vip, version, vlan, pcp, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define Active Firewall Node 1 on DMZ VLAN 75.
host fw_ha_node_1 {
    ip 172.20.75.2
    mac 00:00:5e:00:01:4b
}

// INSTRUCTION: Define Standby Firewall Node 2 assuming DMZ VIP 172.20.75.1 during failover test.
host fw_ha_node_2 {
    ip 172.20.75.3
    mac 00:00:5e:00:01:4b
}

// INSTRUCTION: Define VLAN 75 VRRP failover from Node 1 (PRIORITY 0) to Node 2 (PRIORITY 190).
flow vrrp_fw_cluster_failover(fw1, fw2) {
    fw1 -> fw2 vrrp vrid 75 priority 200 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255 wait 20ms
    fw1 -> fw2 vrrp vrid 75 priority 0 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255 wait 5ms
    fw1 <- fw2 vrrp vrid 75 priority 190 advint 20 vip 172.20.75.1 version 3 vlan 75 pcp 6 dscp 48 ttl 255
}

// INSTRUCTION: Compile the enterprise firewall HA cluster VRRP failover flow.
compile {
    vrrp_fw_cluster_failover(fw_ha_node_1, fw_ha_node_2)
}
