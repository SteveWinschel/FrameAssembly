// VRRPv3 (RFC 5798) gateway failover trace on VRID 55 (VIP 10.55.0.1) showing
// Master priority dropping from 120 to 70 after WAN uplink tracking loss, Backup
// preemption at Priority 100, and final Priority 0 release with TTL 255 and DSCP 48.
// Wireshark: vrrp

host primary_gw {
    ip 10.55.0.2
    mac 00:00:5e:00:01:37
}

host standby_gw {
    ip 10.55.0.3
    mac 00:1c:73:55:00:03
}

// Wait 200ms after the tracked priority drop before Backup claims Master, then 50ms to release.
flow vrrp_failover_sequence(pri, sec) {
    pri -> sec dscp 48 ttl 255 vrrp vrid 55 priority 120 advint 20 vip 10.55.0.1 version 3 wait 200ms
    pri -> sec dscp 48 ttl 255 vrrp vrid 55 priority 70 advint 20 vip 10.55.0.1 version 3 wait 200ms
    pri <- sec dscp 48 ttl 255 vrrp vrid 55 priority 100 advint 20 vip 10.55.0.1 version 3 wait 50ms
    pri -> sec dscp 48 ttl 255 vrrp vrid 55 priority 0 advint 20 vip 10.55.0.1 version 3
}

// Compile the tracked gateway failover sequence.
compile {
    vrrp_failover_sequence(primary_gw, standby_gw)
}
