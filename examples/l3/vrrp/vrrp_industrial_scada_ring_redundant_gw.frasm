// Industrial Ethernet ring gateway redundancy using VRRPv3 with 802.1Q VLAN
// 10, PCP 7, and sub-second 20cs intervals.
// This capture wraps frames in 802.1Q VLAN 10, sets DSCP 56, TTL 255, carries
// VRID 10, and uses post-packet wait gaps (20ms) between frames.
// Wireshark: vrrp && vlan.id == 10

host scada_vrrp_gw_a {
    ip 192.168.10.252
    mac 00:00:5e:00:01:0a
}

host scada_vrrp_gw_b {
    ip 192.168.10.253
    mac 00:21:59:10:00:fd
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_scada_ring_redundancy(gw_a, gw_b) {
    gw_a -> gw_b vrrp vrid 10 priority 240 advint 20 vip 192.168.10.1 version 3 vlan 10 pcp 7 dei 0 dscp 56 ttl 255 wait 20ms
    gw_a -> gw_b vrrp vrid 10 priority 240 advint 20 vip 192.168.10.1 version 3 vlan 10 pcp 7 dei 0 dscp 56 ttl 255
}

// Run vrrp_scada_ring_redundancy(scada_vrrp_gw_a, scada_vrrp_gw_b) to
// generate the capture.
compile {
    vrrp_scada_ring_redundancy(scada_vrrp_gw_a, scada_vrrp_gw_b)
}
