// PROMPT: IPv6 VRRPv3 Master failure and Backup takeover protecting a global IPv6 subnet gateway VIP 2001:db8:112::1.
// TOKENS: host, ip, mac, flow, pri, vrrp, vrid, priority, advint, vip, version, flowlabel, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define primary IPv6 core router releasing VRID 112 with Priority 0.
host v6_core_vrrp_pri {
    ip 2001:db8:112::2
    mac 00:00:5e:00:02:70
}

// INSTRUCTION: Define backup IPv6 core router assuming ownership of 2001:db8:112::1 with Priority 200.
host v6_core_vrrp_sec {
    ip 2001:db8:112::3
    mac 00:00:5e:00:02:70
}

// INSTRUCTION: Define IPv6 VRRPv3 failover sequence with FLOWLABEL 11200 and TTL 255.
flow vrrp_v6_global_vip_failover(pri, sec) {
    pri -> sec vrrp vrid 112 priority 220 advint 100 vip 2001:db8:112::1 version 3 flowlabel 11200 dscp 48 ttl 255 wait 20ms
    pri -> sec vrrp vrid 112 priority 0 advint 100 vip 2001:db8:112::1 version 3 flowlabel 11200 dscp 48 ttl 255 wait 5ms
    pri <- sec vrrp vrid 112 priority 200 advint 100 vip 2001:db8:112::1 version 3 flowlabel 11200 dscp 48 ttl 255
}

// INSTRUCTION: Compile the IPv6 VRRPv3 global VIP failover flow.
compile {
    vrrp_v6_global_vip_failover(v6_core_vrrp_pri, v6_core_vrrp_sec)
}
