// Pure IPv6 VRRPv3 master router advertising virtual IPv6 gateway to
// ff02::12.
// This capture targets IPv6 endpoints and carries VRID 1.
// Wireshark: vrrp && ipv6

host vrrp3_v6_master { ip fe80::100:1 }

host vrrp3_v6_mcast { ip ff02::12 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp3_v6_advert_flow(master, dst) {
    master -> dst vrrp vrid 1 priority 200 vip fe80::1
}

// Run vrrp3_v6_advert_flow(vrrp3_v6_master, vrrp3_v6_mcast) to generate the
// capture.
compile {
    vrrp3_v6_advert_flow(vrrp3_v6_master, vrrp3_v6_mcast)
}
