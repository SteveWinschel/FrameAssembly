// PROMPT: Steady-state VRRP master advertisement heartbeats inside a COMPILE LOOP.
// TOKENS: host, ip, flow, dst, vrrp, vrid, priority, advint, vip, wait, ms, compile

// INSTRUCTION: Define master core gateway router.
host master_core_gw { ip 10.0.0.254 }

// INSTRUCTION: Define standard VRRP multicast listener address.
host vrrp_peers_dst { ip 224.0.0.18 }

// INSTRUCTION: Define periodic 10ms heartbeat burst flow.
flow vrrp_loop_heartbeat(gw, dst) {
    gw -> dst vrrp vrid 1 priority 100 advint 100 vip 10.0.0.1 wait 10ms
}

// INSTRUCTION: Compile loop executing 5 VRRP master heartbeats.
compile {
    vrrp_loop_heartbeat(master_core_gw, vrrp_peers_dst) // cycle 1
    vrrp_loop_heartbeat(master_core_gw, vrrp_peers_dst) // cycle 2
    vrrp_loop_heartbeat(master_core_gw, vrrp_peers_dst) // cycle 3
    vrrp_loop_heartbeat(master_core_gw, vrrp_peers_dst) // cycle 4
    vrrp_loop_heartbeat(master_core_gw, vrrp_peers_dst) // cycle 5
}
