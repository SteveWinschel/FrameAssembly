// PROMPT: Virtual Router Redundancy Protocol master router advertisement with VRID and priority.
// TOKENS: host, ip, flow, vrrp, vrid, priority, compile

// INSTRUCTION: Define primary master gateway router.
host vrrp_master_gw { ip 192.168.1.254 }

// INSTRUCTION: Define secondary backup gateway router.
host vrrp_backup_gw { ip 192.168.1.253 }

// INSTRUCTION: Define VRRP master router advertisement flow.
flow vrrp_master_flow(p, b) {
    p -> b vrrp vrid 1 priority 120
}

// INSTRUCTION: Compile block executing VRRP master advertisement.
compile {
    vrrp_master_flow(vrrp_master_gw, vrrp_backup_gw)
}
