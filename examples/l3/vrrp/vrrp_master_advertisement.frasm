// Virtual Router Redundancy Protocol master router advertisement with VRID
// and priority.
// This capture carries VRID 1.
// Wireshark: vrrp

host vrrp_master_gw { ip 192.168.1.254 }

host vrrp_backup_gw { ip 192.168.1.253 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_master_flow(p, b) {
    p -> b vrrp vrid 1 priority 120
}

// Run vrrp_master_flow(vrrp_master_gw, vrrp_backup_gw) to generate the
// capture.
compile {
    vrrp_master_flow(vrrp_master_gw, vrrp_backup_gw)
}
