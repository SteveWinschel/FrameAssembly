// RFC 5798 VRRPv3 boundary verification testing maximum 8-bit Virtual Router
// ID (VRID 255) with Virtual MAC 00:00:5e:00:01:ff.
// This capture sets DSCP 48, TTL 255, carries VRID 255, and uses post-packet
// wait gaps (50ms) between frames.
// Wireshark: vrrp

host vrrp_vrid255_master {
    ip 10.255.255.252
    mac 00:00:5e:00:01:ff
}

host vrrp_vrid255_mcast {
    ip 224.0.0.18
    mac 01:00:5e:00:00:12
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_vrid_255_boundary(master, mcast) {
    master -> mcast vrrp vrid 255 priority 254 advint 100 vip 10.255.255.1 version 3 srcmac 00:00:5e:00:01:ff dstmac 01:00:5e:00:00:12 dscp 48 ttl 255 wait 50ms
    master -> mcast vrrp vrid 255 priority 254 advint 100 vip 10.255.255.1 version 3 srcmac 00:00:5e:00:01:ff dstmac 01:00:5e:00:00:12 dscp 48 ttl 255
}

// Run vrrp_vrid_255_boundary(vrrp_vrid255_master, vrrp_vrid255_mcast) to
// generate the capture.
compile {
    vrrp_vrid_255_boundary(vrrp_vrid255_master, vrrp_vrid255_mcast)
}
