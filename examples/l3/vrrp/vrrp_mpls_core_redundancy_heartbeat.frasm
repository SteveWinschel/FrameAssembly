// VRRP failover redundancy signaling encapsulated across MPLS core network.
// This capture wraps frames in MPLS label 4096 and carries VRID 50.
// Wireshark: vrrp && mpls

host mpls_pe_redundancy_gw { ip 172.24.0.254 }

host mpls_core_mcast_dst { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_mpls_flow(gw, dst) {
    gw -> dst vrrp vrid 50 priority 210 vip 172.24.0.1 mpls 4096
}

// Run vrrp_mpls_flow(mpls_pe_redundancy_gw, mpls_core_mcast_dst) to generate
// the capture.
compile {
    vrrp_mpls_flow(mpls_pe_redundancy_gw, mpls_core_mcast_dst)
}
