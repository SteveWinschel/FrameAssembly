// Dual active-active VRRP gateway setup load sharing traffic across VRID 1
// and VRID 2.
// This capture carries VRID 1/2.
// Wireshark: vrrp

host gw_router_a { ip 192.168.1.254 }

host gw_router_b { ip 192.168.1.253 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow vrrp_load_share_flow(gw_a, gw_b) {
    gw_a -> gw_b vrrp vrid 1 priority 200 vip 192.168.1.1
    gw_b -> gw_a vrrp vrid 2 priority 200 vip 192.168.1.2
}

// Run vrrp_load_share_flow(gw_router_a, gw_router_b) to generate the capture.
compile {
    vrrp_load_share_flow(gw_router_a, gw_router_b)
}
