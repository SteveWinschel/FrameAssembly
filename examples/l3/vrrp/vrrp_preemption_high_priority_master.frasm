// VRRP master router asserting preemption with high priority 254 and VIP
// 10.1.1.1 on VRID 10.
// This capture carries VRID 10.
// Wireshark: vrrp

host vrrp_primary_master { ip 10.1.1.254 }

host vrrp_mcast_group { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_preempt_flow(master, dst) {
    master -> dst vrrp vrid 10 priority 254 vip 10.1.1.1
}

// Run vrrp_preempt_flow(vrrp_primary_master, vrrp_mcast_group) to generate
// the capture.
compile {
    vrrp_preempt_flow(vrrp_primary_master, vrrp_mcast_group)
}
