// PROMPT: RFC 5798 Section 5.4.3 VRRP Master sending a Priority 0 advertisement on graceful shutdown to trigger immediate Backup takeover.
// TOKENS: host, ip, mac, flow, vrrp, vrid, priority, advint, vip, version, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define active VRRP Master router shutting down interface and releasing VRID 20 with Priority 0.
host vrrp_shutting_master {
    ip 192.168.20.2
    mac 00:00:5e:00:01:14
}

// INSTRUCTION: Define VRRP Backup router immediately transitioning to Master without waiting for Master_Down_Interval.
host vrrp_standby_takeover {
    ip 192.168.20.3
    mac 00:00:5e:00:01:14
}

// INSTRUCTION: Define VRRP PRIORITY 0 release followed within 5ms by Backup takeover at PRIORITY 150.
flow vrrp_priority_zero_handover(old_m, new_m) {
    old_m -> new_m vrrp vrid 20 priority 0 advint 100 vip 192.168.20.1 version 3 dscp 48 ttl 255 payload "MASTER_SHUTDOWN_PRIO_ZERO_RELEASE" wait 5ms
    old_m <- new_m vrrp vrid 20 priority 150 advint 100 vip 192.168.20.1 version 3 dscp 48 ttl 255 payload "IMMEDIATE_BACKUP_TO_MASTER_TRANSITION"
}

// INSTRUCTION: Compile the RFC 5798 VRRP Priority 0 graceful master release flow.
compile {
    vrrp_priority_zero_handover(vrrp_shutting_master, vrrp_standby_takeover)
}
