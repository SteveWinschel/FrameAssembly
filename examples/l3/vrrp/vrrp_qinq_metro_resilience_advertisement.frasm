// Carrier Ethernet dual-tagged QinQ VRRP heartbeat across redundant uplinks.
// This capture wraps frames in QinQ S-VLAN 900 / C-VLAN 45 and carries VRID
// 45.
// Wireshark: vrrp

host metro_edge_gw { ip 192.168.100.254 }

host carrier_pe_listener { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_qinq_flow(gw, pe) {
    gw -> pe vrrp vrid 45 priority 150 vip 192.168.100.1 qinq 900 innervlan 45
}

// Run vrrp_qinq_flow(metro_edge_gw, carrier_pe_listener) to generate the
// capture.
compile {
    vrrp_qinq_flow(metro_edge_gw, carrier_pe_listener)
}
