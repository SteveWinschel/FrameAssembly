// PROMPT: VRRP failover advertisement with virtual IP and preemption priority.
// TOKENS: host, ip, flow, vrrp, vrid, priority, vip, compile

// INSTRUCTION: Define backup gateway assuming master state upon failover.
host backup_assuming_master { ip 10.0.0.253 }

// INSTRUCTION: Define VRRP multicast group destination 224.0.0.18.
host vrrp_mcast_group { ip 224.0.0.18 }

// INSTRUCTION: Define VRRP advertisement flow asserting high priority ownership of VIP 10.0.0.1.
flow vrrp_failover_flow(new_master, mcast) {
    new_master -> mcast vrrp vrid 10 priority 250 vip 10.0.0.1
}

// INSTRUCTION: Compile block executing VRRP preemption failover.
compile {
    vrrp_failover_flow(backup_assuming_master, vrrp_mcast_group)
}
