// VRRP failover advertisement with virtual IP and preemption priority.
// This capture carries VRID 10.
// Wireshark: vrrp

host backup_assuming_master { ip 10.0.0.253 }

host vrrp_mcast_group { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_failover_flow(new_master, mcast) {
    new_master -> mcast vrrp vrid 10 priority 250 vip 10.0.0.1
}

// Run vrrp_failover_flow(backup_assuming_master, vrrp_mcast_group) to
// generate the capture.
compile {
    vrrp_failover_flow(backup_assuming_master, vrrp_mcast_group)
}
