// RFC 5798 Section 6.1 VRRPv3 Master_Down_Timer expiry and Skew_Time
// preemption convergence across three routers.
// This capture sets DSCP 48, TTL 255, carries VRID 90, and uses post-packet
// wait gaps (50ms) between frames.
// Wireshark: vrrp

host vrrp_backup_b1 {
    ip 10.112.90.3
    mac 00:00:5e:00:01:5a
}

host vrrp_backup_b2 {
    ip 10.112.90.4
    mac 00:1e:be:70:90:04
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_skew_time_convergence(b1, b2) {
    b1 -> b2 vrrp vrid 90 priority 180 advint 100 vip 10.112.90.1 version 3 dscp 48 ttl 255 payload "B1_SKEW_TIME_EXPIRED_FIRST_MASTER" wait 50ms
    b1 -> b2 vrrp vrid 90 priority 180 advint 100 vip 10.112.90.1 version 3 dscp 48 ttl 255 payload "B2_CANCELS_MASTER_DOWN_TIMER"
}

// Run vrrp_skew_time_convergence(vrrp_backup_b1, vrrp_backup_b2) to generate
// the capture.
compile {
    vrrp_skew_time_convergence(vrrp_backup_b1, vrrp_backup_b2)
}
