// Aggressive fast failover VRRP tuning with 20 centisecond (200ms)
// advertisement interval.
// This capture carries VRID 25.
// Wireshark: vrrp

host ha_fast_router { ip 172.16.50.254 }

host vrrp_fast_mcast { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_fast_timer(rtr, dst) {
    rtr -> dst vrrp vrid 25 priority 220 advint 20 vip 172.16.50.1
}

// Run vrrp_fast_timer(ha_fast_router, vrrp_fast_mcast) to generate the
// capture.
compile {
    vrrp_fast_timer(ha_fast_router, vrrp_fast_mcast)
}
