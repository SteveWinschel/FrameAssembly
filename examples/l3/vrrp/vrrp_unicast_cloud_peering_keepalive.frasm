// Cloud virtual router pair exchanging unicast VRRPv3 heartbeats in an
// environment where L2 multicast is restricted.
// This capture sets DSCP 48, TTL 255, DF bit set, carries VRID 212, and uses
// post-packet wait gaps (50ms) between frames.
// Wireshark: vrrp

host cloud_vrrp_vr1 {
    ip 10.212.0.11
    mac 02:11:22:70:00:0b
}

host cloud_vrrp_vr2 {
    ip 10.212.0.12
    mac 02:11:22:70:00:0c
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_cloud_unicast_flow(vr1, vr2) {
    vr1 -> vr2 vrrp vrid 212 priority 180 advint 50 vip 10.212.0.1 version 3 df dscp 48 ttl 255 payload "UNICAST_VRRP_CLOUD_HA_PRIMARY" wait 50ms
    vr1 -> vr2 vrrp vrid 212 priority 180 advint 50 vip 10.212.0.1 version 3 df dscp 48 ttl 255 payload "UNICAST_VRRP_CLOUD_HA_SEQ2"
}

// Run vrrp_cloud_unicast_flow(cloud_vrrp_vr1, cloud_vrrp_vr2) to generate the
// capture.
compile {
    vrrp_cloud_unicast_flow(cloud_vrrp_vr1, cloud_vrrp_vr2)
}
