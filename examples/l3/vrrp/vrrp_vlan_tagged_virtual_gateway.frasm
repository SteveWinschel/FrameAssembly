// 802.1Q tagged VRRP master advertisement transmitting on voice VLAN 120.
// This capture wraps frames in 802.1Q VLAN 120 and carries VRID 12.
// Wireshark: vrrp && vlan.id == 120

host voice_gw_router { ip 10.120.1.254 }

host voice_vrrp_mcast { ip 224.0.0.18 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vrrp_voice_vlan_flow(gw, dst) {
    gw -> dst vrrp vrid 12 priority 180 vip 10.120.1.1 vlan 120 pcp 6 dei 0
}

// Run vrrp_voice_vlan_flow(voice_gw_router, voice_vrrp_mcast) to generate the
// capture.
compile {
    vrrp_voice_vlan_flow(voice_gw_router, voice_vrrp_mcast)
}
