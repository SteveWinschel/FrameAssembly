// RFC 3768 VRRPv2 legacy advertisement (version 2) interoperating on a mixed
// campus gateway subnet.
// This capture sets DSCP 48, TTL 255, carries VRID 12, and uses post-packet
// wait gaps (50ms) between frames.
// Wireshark: vrrp

host vrrpv2_legacy_gw {
    ip 172.16.12.2
    mac 00:00:5e:00:01:0c
}

host vrrpv2_mcast_dst {
    ip 224.0.0.18
    mac 01:00:5e:00:00:12
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrpv2_legacy_advert_flow(gw, mcast) {
    gw -> mcast vrrp vrid 12 priority 110 advint 1 vip 172.16.12.1 version 2 dscp 48 ttl 255 wait 50ms
    gw -> mcast vrrp vrid 12 priority 110 advint 1 vip 172.16.12.1 version 2 dscp 48 ttl 255
}

// Run vrrpv2_legacy_advert_flow(vrrpv2_legacy_gw, vrrpv2_mcast_dst) to
// generate the capture.
compile {
    vrrpv2_legacy_advert_flow(vrrpv2_legacy_gw, vrrpv2_mcast_dst)
}
