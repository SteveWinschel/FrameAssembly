// VRRPv3 site-local active gateway advertisements across a stretched DCI VLAN
// 500 with custom Virtual MAC addressing.
// This capture wraps frames in 802.1Q VLAN 500, sets DSCP 48, TTL 255,
// carries VRID 55, and uses post-packet wait gaps (50ms) between frames.
// Wireshark: vrrp && vlan.id == 500

host dci_site1_vrrp {
    ip 10.155.0.2
    mac 00:00:5e:00:01:37
}

host dci_vrrp_mcast {
    ip 224.0.0.18
    mac 01:00:5e:00:00:12
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vrrp_dci_stretched_vlan_flow(site1, mcast) {
    site1 -> mcast vrrp vrid 55 priority 175 advint 100 vip 10.155.0.1 version 3 vlan 500 pcp 6 srcmac 00:00:5e:00:01:37 dstmac 01:00:5e:00:00:12 dscp 48 ttl 255 wait 50ms
    site1 -> mcast vrrp vrid 55 priority 175 advint 100 vip 10.155.0.1 version 3 vlan 500 pcp 6 srcmac 00:00:5e:00:01:37 dstmac 01:00:5e:00:00:12 dscp 48 ttl 255
}

// Run vrrp_dci_stretched_vlan_flow(dci_site1_vrrp, dci_vrrp_mcast) to
// generate the capture.
compile {
    vrrp_dci_stretched_vlan_flow(dci_site1_vrrp, dci_vrrp_mcast)
}
