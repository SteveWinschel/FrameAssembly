// PROMPT: RFC 7348 Section 4.2 VXLAN Broadcast, Unknown-Unicast, and Multicast (BUM) frame replicated over underlay group 239.1.1.100.
// TOKENS: host, ip, mac, flow, src, vxlan, vni, srcport, dstport, df, dscp, ttl, hexpayload, wait, ms, compile

// INSTRUCTION: Define source VTEP encapsulating an inner broadcast ARP request into underlay multicast 239.1.1.100.
host vtep_bum_source {
    ip 10.250.10.11
    mac 00:1c:73:fa:10:0b
}

// INSTRUCTION: Define underlay multicast group 239.1.1.100 mapped to VNI 10100.
host vxlan_mcast_239 {
    ip 239.1.1.100
    mac 01:00:5e:01:01:64
}

// INSTRUCTION: Define VXLAN multicast underlay flood on VNI 10100 with inner broadcast Ethernet header.
flow vxlan_bum_mcast_flood(src, mcast) {
    src -> mcast vxlan vni 10100 srcport 50100 dstport 4789 df dscp 8 ttl 64 hexpayload "ffffffffffff00163e10000108060001080006040001" wait 5ms
    src -> mcast vxlan vni 10100 srcport 50101 dstport 4789 df dscp 8 ttl 64 hexpayload "ffffffffffff00163e10000208004500002012340000"
}

// INSTRUCTION: Compile the RFC 7348 VXLAN BUM underlay multicast replication flow.
compile {
    vxlan_bum_mcast_flood(vtep_bum_source, vxlan_mcast_239)
}
