// VXLAN packet with customized hash-based UDP source port 54321 for ECMP
// underlay load balancing.
// This capture carries VNI 20000.
// Wireshark: vxlan && vxlan.vni == 20000

host ecmp_leaf_vtep { ip 192.168.220.10 }

host ecmp_spine_peer { ip 192.168.220.20 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_entropy_flow(src, dst) {
    src -> dst vxlan vni 20000 srcport 54321
}

// Run vxlan_entropy_flow(ecmp_leaf_vtep, ecmp_spine_peer) to generate the
// capture.
compile {
    vxlan_entropy_flow(ecmp_leaf_vtep, ecmp_spine_peer)
}
