// Minimal VXLAN (RFC 7348) overlay starter packet sent over UDP port 4789
// with the I-flag set and default VNI 4096 wrapping an inner Ethernet stub.
// Useful for checking VTEP UDP 4789 firewall traversal and Wireshark VXLAN
// decoding.
// Wireshark: vxlan

host endpoint_a {
    ip 10.47.89.1
    mac 02:00:47:89:00:01
}

host endpoint_b {
    ip 10.47.89.2
    mac 02:00:47:89:00:02
}

// Transmit one default VXLAN frame directly inside compile.
compile {
    endpoint_a -> endpoint_b vxlan
}
