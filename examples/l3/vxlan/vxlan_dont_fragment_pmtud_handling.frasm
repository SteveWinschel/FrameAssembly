// VXLAN underlay packet with Don't Fragment (DF) flag set for Path MTU
// Discovery.
// This capture sets TTL 64, DF bit set and carries VNI 30303.
// Wireshark: vxlan && vxlan.vni == 30303

host pmtud_vtep_gw { ip 172.17.0.1 }

host pmtud_remote_vtep { ip 172.17.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_pmtud_flow(gw, rem) {
    gw -> rem vxlan vni 30303 df ttl 64
}

// Run vxlan_pmtud_flow(pmtud_vtep_gw, pmtud_remote_vtep) to generate the
// capture.
compile {
    vxlan_pmtud_flow(pmtud_vtep_gw, pmtud_remote_vtep)
}
