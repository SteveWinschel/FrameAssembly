// VXLAN underlay transport preserving DSCP AF41 QoS markings for interactive
// video overlay.
// This capture sets DSCP 34, TTL 64 and carries VNI 40001.
// Wireshark: vxlan && vxlan.vni == 40001

host media_vtep_src { ip 172.16.80.1 }

host media_vtep_dst { ip 172.16.80.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_qos_flow(src, dst) {
    src -> dst vxlan vni 40001 dscp 34 ttl 64
}

// Run vxlan_qos_flow(media_vtep_src, media_vtep_dst) to generate the capture.
compile {
    vxlan_qos_flow(media_vtep_src, media_vtep_dst)
}
