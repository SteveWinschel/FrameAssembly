// East-West tenant traffic hairpinned through a centralized Service Leaf
// Firewall VTEP using ingress L3VNI 50100 and egress L3VNI 50200.
// This capture sets DSCP 34, TTL 63, DF bit set, carries VNI 50100/50200,
// destination port 4789, and uses post-packet wait gaps (2ms) between frames.
// Wireshark: vxlan

host compute_zone_vtep {
    ip 10.255.50.10
    mac 00:1c:73:50:00:0a
}

host service_fw_vtep {
    ip 10.255.50.250
    mac 00:1c:73:50:00:fa
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vxlan_fw_service_hairpin(compute, svc) {
    compute -> svc vxlan vni 50100 srcport 50100 dstport 4789 df dscp 34 ttl 63 payload "UNTRUST_VRF_TO_FIREWALL_INSPECTION" wait 2ms
    compute <- svc vxlan vni 50200 srcport 50200 dstport 4789 df dscp 34 ttl 63 payload "TRUST_VRF_POST_FIREWALL_PERMITTED"
}

// Run vxlan_fw_service_hairpin(compute_zone_vtep, service_fw_vtep) to
// generate the capture.
compile {
    vxlan_fw_service_hairpin(compute_zone_vtep, service_fw_vtep)
}
