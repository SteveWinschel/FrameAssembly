// VXLAN tunnel encapsulating maximum 24-bit VNI boundary identifier
// (16777215).
// This capture carries VNI 16777215.
// Wireshark: vxlan && vxlan.vni == 16777215

host vtep_boundary_gen { ip 10.99.99.1 }

host vtep_boundary_rec { ip 10.99.99.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_max_vni_flow(gen, rec) {
    gen -> rec vxlan vni 16777215
}

// Run vxlan_max_vni_flow(vtep_boundary_gen, vtep_boundary_rec) to generate
// the capture.
compile {
    vxlan_max_vni_flow(vtep_boundary_gen, vtep_boundary_rec)
}
