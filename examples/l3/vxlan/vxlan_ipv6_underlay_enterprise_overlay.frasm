// Pure IPv6 underlay transport encapsulating VNI 50000 enterprise overlay
// frames.
// This capture targets IPv6 endpoints and carries VNI 50000.
// Wireshark: vxlan && vxlan.vni == 50000 && ipv6

host vtep6_hv_a { ip 2001:db8:dc01::1 }

host vtep6_hv_b { ip 2001:db8:dc01::2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow vxlan_v6_enterprise(a, b) {
    a -> b vxlan vni 50000
    a <- b vxlan vni 50000
}

// Run vxlan_v6_enterprise(vtep6_hv_a, vtep6_hv_b) to generate the capture.
compile {
    vxlan_v6_enterprise(vtep6_hv_a, vtep6_hv_b)
}
