// VXLAN overlay tunneling across an IPv6 transport underlay between VTEPs.
// This capture targets IPv6 endpoints and carries VNI 30000.
// Wireshark: vxlan && vxlan.vni == 30000 && ipv6

host vtep6_a { ip 2001:db8:beef::1 }

host vtep6_b { ip 2001:db8:beef::2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_v6_flow(a, b) {
    a -> b vxlan vni 30000
}

// Run vxlan_v6_flow(vtep6_a, vtep6_b) to generate the capture.
compile {
    vxlan_v6_flow(vtep6_a, vtep6_b)
}
