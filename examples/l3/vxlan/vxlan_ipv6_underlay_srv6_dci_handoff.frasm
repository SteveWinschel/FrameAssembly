// PROMPT: IPv6-only data center Spine-Leaf fabric transporting VXLAN over IPv6 with 20-bit Flow Label ECMP distribution.
// TOKENS: host, ip, mac, flow, v1, v2, vxlan, vni, srcport, dstport, flowlabel, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define IPv6 Leaf-1 VTEP encapsulating dual-stack tenant frames in VXLAN-over-IPv6.
host v6_fabric_vtep1 {
    ip 2001:db8:4789:1::11
    mac 00:1c:73:66:47:0b
}

// INSTRUCTION: Define IPv6 Leaf-2 VTEP terminating UDP 4789 over IPv6.
host v6_fabric_vtep2 {
    ip 2001:db8:4789:2::22
    mac 00:1c:73:66:47:16
}

// INSTRUCTION: Define IPv6 VXLAN exchange with FLOWLABEL 478900 and VNI 604789.
flow vxlan_v6_fabric_ecmp_flow(v1, v2) {
    v1 -> v2 vxlan vni 604789 srcport 54789 dstport 4789 flowlabel 478900 dscp 26 ttl 64 payload "IPV6_UNDERLAY_VXLAN_TENANT_FRAME_1" wait 3ms
    v1 <- v2 vxlan vni 604789 srcport 54790 dstport 4789 flowlabel 478900 dscp 26 ttl 64 payload "IPV6_UNDERLAY_VXLAN_TENANT_FRAME_2"
}

// INSTRUCTION: Compile the IPv6 underlay VXLAN Flow Label ECMP scenario.
compile {
    vxlan_v6_fabric_ecmp_flow(v6_fabric_vtep1, v6_fabric_vtep2)
}
