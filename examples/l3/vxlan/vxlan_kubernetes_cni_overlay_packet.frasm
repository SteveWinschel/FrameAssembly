// Kubernetes CNI pod-to-pod network overlay communication encapsulated over
// VNI 4096.
// This capture carries VNI 4096.
// Wireshark: vxlan && vxlan.vni == 4096

host k8s_worker_1 { ip 10.244.1.1 }

host k8s_worker_2 { ip 10.244.2.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow k8s_cni_overlay_flow(w1, w2) {
    w1 -> w2 vxlan vni 4096 payload "HTTP_GET_POD_REST_API"
    w1 <- w2 vxlan vni 4096 payload "HTTP_200_POD_REST_RESP"
}

// Run k8s_cni_overlay_flow(k8s_worker_1, k8s_worker_2) to generate the
// capture.
compile {
    k8s_cni_overlay_flow(k8s_worker_1, k8s_worker_2)
}
