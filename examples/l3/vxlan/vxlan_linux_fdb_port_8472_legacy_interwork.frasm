// Linux kernel bridge VXLAN interface using legacy IANA/early-vendor UDP port
// 8472 for OVS/Flannel interworking.
// This capture sets TTL 64, DF bit set, carries VNI 8472, destination port
// 8472, and uses post-packet wait gaps (2ms) between frames.
// Wireshark: vxlan && vxlan.vni == 8472 && udp.port == 8472

host linux_kvm_vxlan1 {
    ip 10.84.72.11
    mac 52:54:00:84:72:0b
}

host linux_kvm_vxlan2 {
    ip 10.84.72.12
    mac 52:54:00:84:72:0c
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vxlan_legacy_port_8472_flow(h1, h2) {
    h1 -> h2 vxlan vni 8472 srcport 58472 dstport 8472 df ttl 64 payload "LINUX_VXLAN_UDP_8472_FLANNEL_BACKEND" wait 2ms
    h1 <- h2 vxlan vni 8472 srcport 58473 dstport 8472 df ttl 64 payload "LINUX_VXLAN_UDP_8472_FDB_LEARNED_ACK"
}

// Run vxlan_legacy_port_8472_flow(linux_kvm_vxlan1, linux_kvm_vxlan2) to
// generate the capture.
compile {
    vxlan_legacy_port_8472_flow(linux_kvm_vxlan1, linux_kvm_vxlan2)
}
