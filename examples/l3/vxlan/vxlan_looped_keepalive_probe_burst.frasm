// Continuous VXLAN tunnel keepalive heartbeat probes across repeated cycles
// in compile.
// This capture carries VNI 1001, executes 4 cycles in compile, and uses
// post-packet wait gaps (15ms) between frames.
// Wireshark: vxlan && vxlan.vni == 1001

host hv_node_alpha { ip 192.168.111.1 }

host hv_node_beta { ip 192.168.111.2 }

// Packet sequence (1 frame); wait pauses after a packet before the next.
flow vxlan_probe_burst(a, b) {
    a -> b vxlan vni 1001 payload "VTEP_LIVENESS_PROBE_ECHO" wait 15ms
}

// Emit 4 sequential cycles of vxlan_probe_burst.
compile {
    vxlan_probe_burst(hv_node_alpha, hv_node_beta) // cycle 1
    vxlan_probe_burst(hv_node_alpha, hv_node_beta) // cycle 2
    vxlan_probe_burst(hv_node_alpha, hv_node_beta) // cycle 3
    vxlan_probe_burst(hv_node_alpha, hv_node_beta) // cycle 4
}
