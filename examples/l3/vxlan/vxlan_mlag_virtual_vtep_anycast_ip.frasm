// PROMPT: Dual-homed MLAG / vPC ToR switches sharing a common Virtual VTEP Anycast IP 10.255.0.100 for active-active forwarding.
// TOKENS: host, ip, mac, flow, vxlan, vni, srcport, dstport, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define MLAG Virtual VTEP Anycast loopback shared by ToR-1A and ToR-1B.
host mlag_anycast_vtep {
    ip 10.255.0.100
    mac 00:1c:73:00:01:00
}

// INSTRUCTION: Define remote Border Leaf VTEP communicating with the MLAG Anycast VTEP IP.
host border_leaf_vtep {
    ip 10.255.0.254
    mac 00:1c:73:00:02:54
}

// INSTRUCTION: Define active-active VXLAN flows using varied UDP source ports for Spine ECMP hashing.
flow vxlan_mlag_anycast_vtep_flow(mlag, border) {
    mlag -> border vxlan vni 30100 srcport 49152 dstport 4789 df dscp 26 ttl 63 payload "MLAG_MEMBER_A_LAG_HASH_FLOW1" wait 2ms
    mlag -> border vxlan vni 30100 srcport 61000 dstport 4789 df dscp 26 ttl 63 payload "MLAG_MEMBER_B_LAG_HASH_FLOW2" wait 2ms
    mlag <- border vxlan vni 30100 srcport 55555 dstport 4789 df dscp 26 ttl 63 payload "BORDER_TO_ANYCAST_VTEP_RETURN"
}

// INSTRUCTION: Compile the MLAG Virtual VTEP Anycast IP VXLAN flow.
compile {
    vxlan_mlag_anycast_vtep_flow(mlag_anycast_vtep, border_leaf_vtep)
}
