// VXLAN overlay packet traversing MPLS-based DCI core with label 5000.
// This capture wraps frames in MPLS label 5000 and carries VNI 75000.
// Wireshark: vxlan && vxlan.vni == 75000 && mpls

host dci_ingress_vtep { ip 10.210.0.1 }

host dci_egress_vtep { ip 10.210.0.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_mpls_dci(ing, eg) {
    ing -> eg vxlan vni 75000 mpls 5000
}

// Run vxlan_mpls_dci(dci_ingress_vtep, dci_egress_vtep) to generate the
// capture.
compile {
    vxlan_mpls_dci(dci_ingress_vtep, dci_egress_vtep)
}
