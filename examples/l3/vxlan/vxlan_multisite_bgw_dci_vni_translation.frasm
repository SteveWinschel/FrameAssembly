// EVPN Multi-Site Border Gateways (BGWs) re-encapsulating VXLAN traffic
// between Site-1 Fabric and DCI Core.
// This capture sets DSCP 26, TTL 60, DF bit set, carries VNI 90001,
// destination port 4789, and uses post-packet wait gaps (5ms) between frames.
// Wireshark: vxlan && vxlan.vni == 90001

host site1_ms_bgw {
    ip 172.31.47.1
    mac 00:22:bd:47:89:01
}

host site2_ms_bgw {
    ip 172.31.47.2
    mac 00:22:bd:47:89:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vxlan_multisite_bgw_dci(bgw1, bgw2) {
    bgw1 -> bgw2 vxlan vni 90001 srcport 59001 dstport 4789 df dscp 26 ttl 60 payload "EVPN_MULTISITE_SITE1_TO_SITE2_L2_EXTENSION" wait 5ms
    bgw1 <- bgw2 vxlan vni 90001 srcport 59002 dstport 4789 df dscp 26 ttl 60 payload "EVPN_MULTISITE_SITE2_TO_SITE1_L2_EXTENSION"
}

// Run vxlan_multisite_bgw_dci(site1_ms_bgw, site2_ms_bgw) to generate the
// capture.
compile {
    vxlan_multisite_bgw_dci(site1_ms_bgw, site2_ms_bgw)
}
