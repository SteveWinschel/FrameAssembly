// Simulate VXLAN overlay data-plane keepalive packet on UDP 4789 with
// explicit VNI.
// This capture carries VNI 5001.
// Wireshark: vxlan && vxlan.vni == 5001

host vtep_hv1 { ip 10.10.10.1 }

host vtep_hv2 { ip 10.10.10.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_hb_flow(src, dst) {
    src -> dst vxlan vni 5001 payload "vxlan_heartbeat_ping"
}

// Run vxlan_hb_flow(vtep_hv1, vtep_hv2) to generate the capture.
compile {
    vxlan_hb_flow(vtep_hv1, vtep_hv2)
}
