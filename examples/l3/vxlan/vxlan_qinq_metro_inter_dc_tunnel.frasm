// Metro data center interconnect tunneling VXLAN through dual-tagged QinQ
// carrier backbone.
// This capture wraps frames in QinQ S-VLAN 1000 / C-VLAN 80 and carries VNI
// 90000.
// Wireshark: vxlan && vxlan.vni == 90000

host west_dc_border_vtep { ip 172.29.1.1 }

host east_dc_border_vtep { ip 172.29.1.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_qinq_dci_flow(w, e) {
    w -> e vxlan vni 90000 qinq 1000 innervlan 80
}

// Run vxlan_qinq_dci_flow(west_dc_border_vtep, east_dc_border_vtep) to
// generate the capture.
compile {
    vxlan_qinq_dci_flow(west_dc_border_vtep, east_dc_border_vtep)
}
