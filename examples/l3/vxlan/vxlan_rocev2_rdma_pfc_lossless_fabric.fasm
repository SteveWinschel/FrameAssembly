// PROMPT: Lossless AI/ML GPU fabric carrying RoCEv2 RDMA frames inside VXLAN with IEEE 802.1p PCP 3, DSCP 26, and ECN ECT(1).
// TOKENS: host, ip, mac, flow, vxlan, vni, vlan, pcp, dei, srcport, dstport, dscp, ecn, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define GPU Rack Leaf-1 VTEP encapsulating RoCEv2 RDMA Write over VXLAN.
host gpu_leaf1_vtep {
    ip 10.200.47.1
    mac 00:1c:73:c8:2f:01
}

// INSTRUCTION: Define GPU Rack Leaf-2 VTEP with Priority Flow Control (PFC) enabled on Priority 3.
host gpu_leaf2_vtep {
    ip 10.200.47.2
    mac 00:1c:73:c8:2f:02
}

// INSTRUCTION: Define lossless VXLAN flow with VLAN 400 PCP 3, DSCP 26 (AF31), and ECN 1 (ECT1).
flow vxlan_rocev2_lossless_flow(g1, g2) {
    g1 -> g2 vxlan vni 40000 vlan 400 pcp 3 dei 0 srcport 53001 dstport 4789 dscp 26 ecn 1 df ttl 64 payload "ROCEV2_RDMA_WRITE_ONLY_QP_256_PSN_1001" wait 1ms
    g1 <- g2 vxlan vni 40000 vlan 400 pcp 3 dei 0 srcport 53002 dstport 4789 dscp 26 ecn 1 df ttl 64 payload "ROCEV2_RDMA_RC_ACKNOWLEDGE_PSN_1001"
}

// INSTRUCTION: Compile the lossless RoCEv2 RDMA over VXLAN GPU fabric flow.
compile {
    vxlan_rocev2_lossless_flow(gpu_leaf1_vtep, gpu_leaf2_vtep)
}
