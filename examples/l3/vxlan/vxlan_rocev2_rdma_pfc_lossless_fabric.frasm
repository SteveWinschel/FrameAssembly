// Lossless AI/ML GPU fabric carrying RoCEv2 RDMA frames inside VXLAN with
// IEEE 802.1p PCP 3, DSCP 26, and ECN ECT(1).
// This capture wraps frames in 802.1Q VLAN 400, sets DSCP 26, TTL 64, DF bit
// set, carries VNI 40000, destination port 4789, and uses post-packet wait
// gaps (1ms) between frames.
// Wireshark: vxlan && vxlan.vni == 40000 && vlan.id == 400

host gpu_leaf1_vtep {
    ip 10.200.47.1
    mac 00:1c:73:c8:2f:01
}

host gpu_leaf2_vtep {
    ip 10.200.47.2
    mac 00:1c:73:c8:2f:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vxlan_rocev2_lossless_flow(g1, g2) {
    g1 -> g2 vxlan vni 40000 vlan 400 pcp 3 dei 0 srcport 53001 dstport 4789 dscp 26 ecn 1 df ttl 64 payload "ROCEV2_RDMA_WRITE_ONLY_QP_256_PSN_1001" wait 1ms
    g1 <- g2 vxlan vni 40000 vlan 400 pcp 3 dei 0 srcport 53002 dstport 4789 dscp 26 ecn 1 df ttl 64 payload "ROCEV2_RDMA_RC_ACKNOWLEDGE_PSN_1001"
}

// Run vxlan_rocev2_lossless_flow(gpu_leaf1_vtep, gpu_leaf2_vtep) to generate
// the capture.
compile {
    vxlan_rocev2_lossless_flow(gpu_leaf1_vtep, gpu_leaf2_vtep)
}
