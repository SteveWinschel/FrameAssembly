// PROMPT: Data center network overlay virtualization using VXLAN tunneling protocol.
// TOKENS: HOST, IP, FLOW, VXLAN, VNI, COMPILE

// INSTRUCTION: Define VTEP overlay gateway A.
HOST vtep_a { IP 192.168.100.1 }

// INSTRUCTION: Define VTEP overlay gateway B.
HOST vtep_b { IP 192.168.100.2 }

// INSTRUCTION: Define VXLAN tunnel transmission flow with VNI 10000.
FLOW vxlan_tunnel_flow(a, b) {
    a -> b VXLAN VNI 10000
}

// INSTRUCTION: Compile block executing VXLAN encapsulation.
COMPILE {
    vxlan_tunnel_flow(vtep_a, vtep_b)
}
