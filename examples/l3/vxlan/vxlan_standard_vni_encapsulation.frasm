// Data center network overlay virtualization using VXLAN tunneling protocol.
// This capture carries VNI 10000.
// Wireshark: vxlan && vxlan.vni == 10000

host vtep_a { ip 192.168.100.1 }

host vtep_b { ip 192.168.100.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_tunnel_flow(a, b) {
    a -> b vxlan vni 10000
}

// Run vxlan_tunnel_flow(vtep_a, vtep_b) to generate the capture.
compile {
    vxlan_tunnel_flow(vtep_a, vtep_b)
}
