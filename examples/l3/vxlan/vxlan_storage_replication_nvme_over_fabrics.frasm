// High-priority storage cluster replication traffic encapsulated across
// dedicated VNI 8888.
// This capture sets DSCP 46 and carries VNI 8888.
// Wireshark: vxlan && vxlan.vni == 8888

host primary_nvme_vtep { ip 192.168.250.1 }

host replica_nvme_vtep { ip 192.168.250.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_nvme_replication(p, r) {
    p -> r vxlan vni 8888 dscp 46 payload "NVME_FABRICS_WRITE_COMMAND_BLOCK"
}

// Run vxlan_nvme_replication(primary_nvme_vtep, replica_nvme_vtep) to
// generate the capture.
compile {
    vxlan_nvme_replication(primary_nvme_vtep, replica_nvme_vtep)
}
