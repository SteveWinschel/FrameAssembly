// VXLAN underlay packet transported across 802.1Q tagged data center transit
// VLAN 800.
// This capture wraps frames in 802.1Q VLAN 800 and carries VNI 12000.
// Wireshark: vxlan && vxlan.vni == 12000 && vlan.id == 800

host rack_vtep_server { ip 10.80.0.10 }

host agg_leaf_vtep { ip 10.80.0.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow vxlan_vlan_underlay(srv, leaf) {
    srv -> leaf vxlan vni 12000 vlan 800 pcp 4 dei 0
}

// Run vxlan_vlan_underlay(rack_vtep_server, agg_leaf_vtep) to generate the
// capture.
compile {
    vxlan_vlan_underlay(rack_vtep_server, agg_leaf_vtep)
}
