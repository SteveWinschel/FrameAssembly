// RFC 7348 VXLAN tunnel configured using the VNID keyword alias alongside
// standard VNI syntax.
// This capture sets TTL 64, DF bit set, carries VNI 77777, destination port
// 4789, and uses post-packet wait gaps (3ms) between frames.
// Wireshark: vxlan && vxlan.vni == 77777

host vnid_vtep_alpha {
    ip 10.47.89.10
    mac 00:16:3e:47:89:0a
}

host vnid_vtep_beta {
    ip 10.47.89.20
    mac 00:16:3e:47:89:14
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow vxlan_vnid_alias_flow(alpha, beta) {
    alpha -> beta vxlan vnid 77777 srcport 57777 dstport 4789 df ttl 64 payload "VXLAN_SPECIFIED_WITH_VNID_KEYWORD" wait 3ms
    alpha <- beta vxlan vni 77777 srcport 57778 dstport 4789 df ttl 64 payload "VXLAN_SPECIFIED_WITH_VNI_KEYWORD"
}

// Run vxlan_vnid_alias_flow(vnid_vtep_alpha, vnid_vtep_beta) to generate the
// capture.
compile {
    vxlan_vnid_alias_flow(vnid_vtep_alpha, vnid_vtep_beta)
}
