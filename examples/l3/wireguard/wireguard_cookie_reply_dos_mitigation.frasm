// WireGuard concentrator issuing Cookie Reply to mitigate denial-of-service
// flood.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host wg_loaded_concentrator { ip 198.51.100.1 }

host wg_incoming_peer { ip 203.0.113.77 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wg_cookie_mitigation_flow(conc, peer) {
    conc -> peer wireguard type cookie receiver 987654321
}

// Run wg_cookie_mitigation_flow(wg_loaded_concentrator, wg_incoming_peer) to
// generate the capture.
compile {
    wg_cookie_mitigation_flow(wg_loaded_concentrator, wg_incoming_peer)
}
