// WireGuard encrypted transport data packet advancing 64-bit transmission
// counter.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host wg_client_station { ip 10.70.1.15 }

host wg_central_gw { ip 10.70.1.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wg_data_counter_flow(cli, gw) {
    cli -> gw wireguard type data receiver 409600 counter 1050 payload "ENCRYPTED_DATABASE_RECORD"
}

// Run wg_data_counter_flow(wg_client_station, wg_central_gw) to generate the
// capture.
compile {
    wg_data_counter_flow(wg_client_station, wg_central_gw)
}
