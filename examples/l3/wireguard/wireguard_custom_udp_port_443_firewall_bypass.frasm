// PROMPT: WireGuard tunnel operating over custom UDP port 443 to traverse restrictive guest Wi-Fi firewalls.
// TOKENS: host, ip, mac, flow, wireguard, initiation, sender, srcport, dstport, df, ttl, wait, ms, type, response, receiver, data, counter, payload, compile

// INSTRUCTION: Define laptop WireGuard client binding to ephemeral source port and targeting UDP 443.
host wg_roaming_laptop {
    ip 172.16.88.45
    mac 00:1c:b3:88:45:01
}

// INSTRUCTION: Define enterprise WireGuard gateway listening on UDP port 443.
host wg_port443_gateway {
    ip 198.51.100.43
    mac 00:1c:b3:64:2b:02
}

// INSTRUCTION: Define WireGuard handshake and DATA over custom DSTPORT 443.
flow wg_custom_port_443_flow(laptop, gw) {
    laptop -> gw wireguard initiation sender 44301 srcport 54321 dstport 443 df ttl 64 wait 5ms
    laptop <- gw wireguard type response sender 44302 receiver 44301 srcport 443 dstport 54321 df ttl 64 wait 5ms
    laptop -> gw wireguard data receiver 44302 counter 0 srcport 54321 dstport 443 df ttl 64 payload "SSH_SESSION_OVER_WG_PORT_443"
}

// INSTRUCTION: Compile the WireGuard custom UDP port 443 traversal flow.
compile {
    wg_custom_port_443_flow(wg_roaming_laptop, wg_port443_gateway)
}
