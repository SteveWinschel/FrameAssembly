// WireGuard VPN prioritizing voice/video packets with DSCP Expedited
// Forwarding (DSCP 46).
// This capture sets DSCP 46, TTL 64.
// Wireshark: wg

host voip_media_server { ip 172.20.10.5 }

host branch_voip_gateway { ip 172.20.10.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wg_voip_ef_flow(src, dst) {
    src -> dst wireguard type data receiver 654321 counter 888 dscp 46 ttl 64
}

// Run wg_voip_ef_flow(voip_media_server, branch_voip_gateway) to generate the
// capture.
compile {
    wg_voip_ef_flow(voip_media_server, branch_voip_gateway)
}
