// PROMPT: RFC 6040 Explicit Congestion Notification (ECN) propagation across a WireGuard encrypted tunnel.
// TOKENS: host, ip, mac, flow, wireguard, type, data, receiver, counter, dscp, ecn, df, ttl, payload, wait, ms, compile

// INSTRUCTION: Define WireGuard ingress gateway copying inner TCP ECT(0) (2) to outer UDP header.
host wg_ecn_ingress {
    ip 10.60.51.1
    mac 00:24:38:60:51:01
}

// INSTRUCTION: Define WireGuard egress gateway decapsulating ECN Congestion Experienced (ECN 3) packet.
host wg_ecn_egress {
    ip 10.60.51.2
    mac 00:24:38:60:51:02
}

// INSTRUCTION: Define WireGuard DATA packets transitioning from ECN 2 (ECT0) to ECN 3 (CE).
flow wg_ecn_propagation_flow(ing, egr) {
    ing -> egr wireguard type data receiver 60401 counter 10 dscp 18 ecn 2 df ttl 64 payload "WG_INNER_TCP_ECT0_NORMAL" wait 2ms
    ing -> egr wireguard type data receiver 60401 counter 11 dscp 18 ecn 3 df ttl 64 payload "WG_INNER_TCP_CE_MARKED_BY_CORE" wait 2ms
    ing <- egr wireguard type data receiver 60402 counter 5 dscp 18 ecn 2 df ttl 64 payload "WG_INNER_TCP_ECE_FEEDBACK"
}

// INSTRUCTION: Compile the RFC 6040 ECN propagation over WireGuard flow.
compile {
    wg_ecn_propagation_flow(wg_ecn_ingress, wg_ecn_egress)
}
