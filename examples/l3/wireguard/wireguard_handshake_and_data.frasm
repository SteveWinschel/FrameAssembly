// WireGuard VPN protocol handshake initiation, response, and encrypted data
// packet transmission on UDP 51820.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host wg_peer_a { ip 198.51.100.10 }

host wg_peer_b { ip 198.51.100.20 }

// Packet sequence (3 frames) with default 10ms post-packet spacing.
flow wireguard_session(a, b) {
    a -> b wireguard type initiation
    a <- b wireguard type response
    a -> b wireguard type data
}

// Run wireguard_session(wg_peer_a, wg_peer_b) to generate the capture.
compile {
    wireguard_session(wg_peer_a, wg_peer_b)
}
