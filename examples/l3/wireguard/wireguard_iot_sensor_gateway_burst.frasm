// Embedded IoT gateway transmitting encrypted telemetry to cloud WireGuard
// receiver.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host iot_sensor_node { ip 172.30.99.10 }

host cloud_iot_receiver { ip 172.30.99.1 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wg_iot_telemetry_flow(sensor, cloud) {
    sensor -> cloud wireguard type data receiver 90901 counter 1 payload "SENSOR_TEMP_HUMIDITY_DATA"
}

// Run wg_iot_telemetry_flow(iot_sensor_node, cloud_iot_receiver) to generate
// the capture.
compile {
    wg_iot_telemetry_flow(iot_sensor_node, cloud_iot_receiver)
}
