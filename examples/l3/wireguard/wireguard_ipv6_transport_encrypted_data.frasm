// Pure IPv6 WireGuard transport carrying sequenced encrypted data packets.
// This capture targets IPv6 endpoints.
// Wireshark: wg && ipv6

host wg_v6_host_alpha { ip 2001:db8:beef:2::10 }

host wg_v6_host_beta { ip 2001:db8:beef:2::20 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow wg_v6_data_exchange(a, b) {
    a -> b wireguard type data receiver 2001 counter 100
    a <- b wireguard type data receiver 1001 counter 50
}

// Run wg_v6_data_exchange(wg_v6_host_alpha, wg_v6_host_beta) to generate the
// capture.
compile {
    wg_v6_data_exchange(wg_v6_host_alpha, wg_v6_host_beta)
}
