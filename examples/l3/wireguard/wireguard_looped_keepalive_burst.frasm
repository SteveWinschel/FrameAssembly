// PROMPT: Periodic WireGuard authenticated keepalive packet burst inside a COMPILE LOOP.
// TOKENS: host, ip, flow, wireguard, type, data, receiver, counter, wait, ms, compile

// INSTRUCTION: Define remote mobile worker maintaining tunnel NAT mapping.
host roaming_nat_client { ip 192.0.2.77 }

// INSTRUCTION: Define enterprise VPN gateway endpoint.
host enterprise_vpn_gw { ip 198.51.100.10 }

// INSTRUCTION: Define periodic WireGuard keepalive burst flow.
flow wg_keepalive_burst(cli, gw) {
    cli -> gw wireguard type data receiver 12345 counter 0 wait 25ms
}

// INSTRUCTION: Compile loop executing 4 periodic WireGuard keepalives.
compile {
    wg_keepalive_burst(roaming_nat_client, enterprise_vpn_gw) // cycle 1
    wg_keepalive_burst(roaming_nat_client, enterprise_vpn_gw) // cycle 2
    wg_keepalive_burst(roaming_nat_client, enterprise_vpn_gw) // cycle 3
    wg_keepalive_burst(roaming_nat_client, enterprise_vpn_gw) // cycle 4
}
