// WireGuard peer endpoint migration confirming updated external client
// address.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host mobile_smartphone { ip 198.51.100.99 }

host corp_wg_access_hub { ip 203.0.113.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow wg_roaming_migration(phone, hub) {
    phone -> hub wireguard type initiation sender 991122
    phone <- hub wireguard type response sender 554433 receiver 991122
}

// Run wg_roaming_migration(mobile_smartphone, corp_wg_access_hub) to generate
// the capture.
compile {
    wg_roaming_migration(mobile_smartphone, corp_wg_access_hub)
}
