// PROMPT: High-speed 100GbE WireGuard router varying outer UDP source ports across flows for NIC Receive Side Scaling (RSS).
// TOKENS: host, ip, mac, flow, wireguard, type, data, receiver, counter, srcport, dstport, df, dscp, ttl, payload, wait, ms, compile

// INSTRUCTION: Define 100GbE WireGuard router distributing encrypted flows across NIC RSS queues.
host wg_100g_tx_rtr {
    ip 10.100.51.1
    mac 00:1c:73:64:33:01
}

// INSTRUCTION: Define 100GbE peer WireGuard router processing multi-core decrypted queues.
host wg_100g_rx_rtr {
    ip 10.100.51.2
    mac 00:1c:73:64:33:02
}

// INSTRUCTION: Define parallel WireGuard DATA frames with varied SRCPORTs (51821..51823) and sequential counters.
flow wg_multi_queue_rss_flow(tx, rx) {
    tx -> rx wireguard type data receiver 100001 counter 1 srcport 51821 dstport 51820 df dscp 34 ttl 64 payload "RSS_QUEUE_0_STREAM" wait 1ms
    tx -> rx wireguard type data receiver 100001 counter 2 srcport 51822 dstport 51820 df dscp 34 ttl 64 payload "RSS_QUEUE_1_STREAM" wait 1ms
    tx -> rx wireguard type data receiver 100001 counter 3 srcport 51823 dstport 51820 df dscp 34 ttl 64 payload "RSS_QUEUE_2_STREAM"
}

// INSTRUCTION: Compile the multi-queue RSS WireGuard source-port hashing flow.
compile {
    wg_multi_queue_rss_flow(wg_100g_tx_rtr, wg_100g_rx_rtr)
}
