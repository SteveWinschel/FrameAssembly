// PROMPT: WireGuard client behind stateful carrier-grade NAT sending 0-length encrypted DATA frames every 25s (PersistentKeepalive).
// TOKENS: host, ip, mac, flow, wireguard, type, data, receiver, counter, srcport, dstport, df, ttl, wait, ms, compile

// INSTRUCTION: Define WireGuard peer behind CGNAT maintaining UDP pinhole state.
host wg_cgnat_client {
    ip 100.64.10.55
    mac 00:1e:67:64:0a:37
}

// INSTRUCTION: Define public cloud WireGuard bounce server.
host wg_public_relay {
    ip 203.0.113.200
    mac 00:1e:67:71:c8:01
}

// INSTRUCTION: Define empty-payload Type 4 DATA PersistentKeepalive frames advancing COUNTER 50..52.
flow wg_nat_persistent_keepalive(cli, relay) {
    cli -> relay wireguard type data receiver 77001 counter 50 srcport 41920 dstport 51820 df ttl 64 wait 25ms
    cli -> relay wireguard type data receiver 77001 counter 51 srcport 41920 dstport 51820 df ttl 64 wait 25ms
    cli <- relay wireguard type data receiver 44001 counter 12 srcport 51820 dstport 41920 df ttl 64
}

// INSTRUCTION: Compile the WireGuard NAT-Traversal PersistentKeepalive flow.
compile {
    wg_nat_persistent_keepalive(wg_cgnat_client, wg_public_relay)
}
