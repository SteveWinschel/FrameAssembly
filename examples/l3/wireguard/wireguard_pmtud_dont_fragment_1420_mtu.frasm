// WireGuard outer UDP datagram Path MTU Discovery (1420-byte inner MTU +
// 60-byte IPv4/UDP/WG overhead) with DF bit enforced.
// This capture sets DSCP 26, TTL 64, DF bit set and uses post-packet wait
// gaps (3ms) between frames.
// Wireshark: wg

host wg_mtu_ingress {
    ip 172.24.51.1
    mac 00:1a:a1:51:82:01
}

host wg_mtu_egress {
    ip 172.24.51.2
    mac 00:1a:a1:51:82:02
}

// Packet sequence (2 frames); wait pauses after a packet before the next.
flow wg_pmtud_df_probe_flow(ing, egr) {
    ing -> egr wireguard type data receiver 14201 counter 1 ipid 5181 df dscp 26 ttl 64 payload "WG_1420_MTU_PROBE_FRAME_FORWARD" wait 3ms
    ing <- egr wireguard type data receiver 14202 counter 1 ipid 5182 df dscp 26 ttl 64 payload "WG_1420_MTU_PROBE_FRAME_RETURN"
}

// Run wg_pmtud_df_probe_flow(wg_mtu_ingress, wg_mtu_egress) to generate the
// capture.
compile {
    wg_pmtud_df_probe_flow(wg_mtu_ingress, wg_mtu_egress)
}
