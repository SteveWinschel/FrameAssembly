// WireGuard Noise_IKpsk2 handshake incorporating a 256-bit PresharedKey (PSK)
// for post-quantum resistance.
// This capture sets DSCP 34/48, TTL 64, DF bit set and uses post-packet wait
// gaps (4ms) between frames.
// Wireshark: wg

host wg_pq_psk_init {
    ip 10.251.0.10
    mac 00:1b:63:fb:00:0a
}

host wg_pq_psk_resp {
    ip 10.251.0.20
    mac 00:1b:63:fb:00:14
}

// Packet sequence (3 frames); wait pauses after a packet before the next.
flow wg_psk_post_quantum_flow(init, resp) {
    init -> resp wireguard initiation sender 256001 df dscp 48 ttl 64 wait 4ms
    init <- resp wireguard type response sender 256002 receiver 256001 df dscp 48 ttl 64 wait 4ms
    init -> resp wireguard data receiver 256002 counter 0 df dscp 34 ttl 64 payload "NOISE_IKPSK2_QUANTUM_RESISTANT_SESSION"
}

// Run wg_psk_post_quantum_flow(wg_pq_psk_init, wg_pq_psk_resp) to generate
// the capture.
compile {
    wg_psk_post_quantum_flow(wg_pq_psk_init, wg_pq_psk_resp)
}
