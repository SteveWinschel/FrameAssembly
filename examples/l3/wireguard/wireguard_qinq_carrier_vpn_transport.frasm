// Dual-tagged QinQ carrier transport carrying WireGuard encrypted tunnel.
// This capture wraps frames in QinQ S-VLAN 600 / C-VLAN 88.
// Wireshark: wg

host enterprise_site_rtr { ip 192.168.188.1 }

host carrier_edge_rtr { ip 192.168.188.2 }

// Single-frame sequence using default 10ms post-packet spacing across cycles.
flow wg_qinq_carrier_flow(site, edge) {
    site -> edge wireguard type data receiver 55500 counter 42 qinq 600 innervlan 88
}

// Run wg_qinq_carrier_flow(enterprise_site_rtr, carrier_edge_rtr) to generate
// the capture.
compile {
    wg_qinq_carrier_flow(enterprise_site_rtr, carrier_edge_rtr)
}
