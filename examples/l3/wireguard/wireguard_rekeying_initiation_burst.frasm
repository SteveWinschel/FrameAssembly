// WireGuard peer initiating scheduled session rekeying via Handshake
// Initiation on UDP 51820.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host wg_branch_peer { ip 172.16.200.1 }

host wg_dc_peer { ip 172.16.200.2 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow wg_rekey_exchange(br, dc) {
    br -> dc wireguard type initiation sender 334455
    br <- dc wireguard type response sender 778899 receiver 334455
}

// Run wg_rekey_exchange(wg_branch_peer, wg_dc_peer) to generate the capture.
compile {
    wg_rekey_exchange(wg_branch_peer, wg_dc_peer)
}
