// Site-to-site branch routers establishing direct WireGuard mesh peering.
// This capture models UDP port 51820 WireGuard handshake and transport
// frames.
// Wireshark: wg

host wg_branch_tokyo { ip 10.210.1.1 }

host wg_branch_sydney { ip 10.210.2.1 }

// Packet sequence (2 frames) with default 10ms post-packet spacing.
flow wg_mesh_peering_flow(tokyo, sydney) {
    tokyo -> sydney wireguard type initiation sender 70701
    tokyo <- sydney wireguard type response sender 70702 receiver 70701
}

// Run wg_mesh_peering_flow(wg_branch_tokyo, wg_branch_sydney) to generate the
// capture.
compile {
    wg_mesh_peering_flow(wg_branch_tokyo, wg_branch_sydney)
}
