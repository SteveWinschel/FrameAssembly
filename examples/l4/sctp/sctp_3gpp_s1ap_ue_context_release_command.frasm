// PROMPT: 4G LTE MME and eNodeB exchanging S1AP UE Context Release Command and Complete over SCTP port 36412 (PPID 18).
// TOKENS: host, ip, mac, flow, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, payload, wait, ms, sack, compile

// INSTRUCTION: Define 4G Mobility Management Entity (MME) signaling endpoint.
host lte_mme_core {
    ip 10.36.12.1
    mac 00:1c:73:24:0c:01
}

// INSTRUCTION: Define 4G eNodeB macro cell site signaling endpoint.
host lte_enb_macro {
    ip 10.36.12.50
    mac 00:1c:73:24:0c:32
}

// INSTRUCTION: Send S1AP UE Context Release Command on Stream 1 (PPID 18), receive SACK, and receive Release Complete.
flow sctp_s1ap_ue_release(mme, enb) {
    mme -> enb dscp 46 sctp chunk data vtag 364121 stream 1 ssn 12 ppid 18 srcport 36412 dstport 36412 payload "s1ap_ue_context_release_cmd_cause_normal" wait 2ms
    mme <- enb dscp 46 sctp chunk sack vtag 364121 srcport 36412 dstport 36412 wait 2ms
    mme <- enb dscp 46 sctp chunk data vtag 364121 stream 1 ssn 12 ppid 18 srcport 36412 dstport 36412 payload "s1ap_ue_context_release_complete_ok" wait 2ms
    mme -> enb dscp 46 sctp chunk sack vtag 364121 srcport 36412 dstport 36412
}

// INSTRUCTION: Compile the 4G LTE S1AP UE Context Release SCTP exchange.
compile {
    sctp_s1ap_ue_release(lte_mme_core, lte_enb_macro)
}
