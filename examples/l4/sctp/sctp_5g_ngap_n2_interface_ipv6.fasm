// PROMPT: 5G NGAP (N2 interface) SCTP signaling between gNodeB and AMF on port 38412 with PPID 60 over IPv6.
// TOKENS: host, ip, flow, dscp, sctp, chunk, init, vtag, srcport, dstport, initack, wait, ms, cookieecho, payload, cookieack, data, stream, ssn, ppid, sack, compile

// INSTRUCTION: Define 5G gNodeB base station IPv6 N2 endpoint.
host gnb_n2_v6 { ip 2001:db8:5000:a2::10 }

// INSTRUCTION: Define 5G Access and Mobility Management Function (AMF) IPv6 N2 endpoint.
host amf_n2_v6 { ip 2001:db8:5000:a2::1 }

// INSTRUCTION: Define 5G N2 SCTP association setup and NGAP Setup Request/Response exchange (PPID 60).
flow sctp_5g_ngap_n2(gnb, amf) {
    gnb -> amf dscp 46 sctp chunk init vtag 0 srcport 38412 dstport 38412
    gnb <- amf dscp 46 sctp chunk initack vtag 384120 srcport 38412 dstport 38412 wait 1ms
    gnb -> amf dscp 46 sctp chunk cookieecho vtag 384120 srcport 38412 dstport 38412 payload "state_cookie_n2_5g" wait 1ms
    gnb <- amf dscp 46 sctp chunk cookieack vtag 384120 srcport 38412 dstport 38412 wait 1ms
    gnb -> amf dscp 46 sctp chunk data vtag 384120 stream 0 ssn 0 ppid 60 srcport 38412 dstport 38412 payload "ngap_ng_setup_request_gnb_id_001" wait 2ms
    gnb <- amf dscp 46 sctp chunk sack vtag 384120 srcport 38412 dstport 38412 wait 1ms
}

// INSTRUCTION: Compile block executing 5G NGAP over SCTP IPv6 session.
compile {
    sctp_5g_ngap_n2(gnb_n2_v6, amf_n2_v6)
}
