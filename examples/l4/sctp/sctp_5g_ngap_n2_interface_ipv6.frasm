// 5G NGAP (N2 interface) SCTP signaling between gNodeB and AMF on port 38412 with
// PPID 60 over IPv6.
// Wire profile: 6 frames; 2 IPv6 hosts; SCTP; SCTP
// COOKIEACK/COOKIEECHO/DATA/INIT; PPID 60; dstport 38412; DSCP 46; waits 1ms,
// 2ms.
// Wireshark: sctp && sctp.data_ppid == 60

host gnb_n2_v6 { ip 2001:db8:5000:a2::10 }

host amf_n2_v6 { ip 2001:db8:5000:a2::1 }

flow sctp_5g_ngap_n2(gnb, amf) {
    gnb -> amf dscp 46 sctp chunk init vtag 0 srcport 38412 dstport 38412 wait 1ms
    gnb <- amf dscp 46 sctp chunk initack vtag 384120 srcport 38412 dstport 38412 wait 1ms
    gnb -> amf dscp 46 sctp chunk cookieecho vtag 384120 srcport 38412 dstport 38412 payload "state_cookie_n2_5g" wait 1ms
    gnb <- amf dscp 46 sctp chunk cookieack vtag 384120 srcport 38412 dstport 38412 wait 2ms
    gnb -> amf dscp 46 sctp chunk data vtag 384120 stream 0 ssn 0 ppid 60 srcport 38412 dstport 38412 payload "ngap_ng_setup_request_gnb_id_001" wait 1ms
    gnb <- amf dscp 46 sctp chunk sack vtag 384120 srcport 38412 dstport 38412
}

compile {
    sctp_5g_ngap_n2(gnb_n2_v6, amf_n2_v6)
}
