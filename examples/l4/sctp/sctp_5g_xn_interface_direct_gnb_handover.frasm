// 5G XnAP direct inter-gNodeB signaling over IPv6 SCTP port 38422 with PPID 61.
// Wire profile: 6 frames; 2 IPv6 hosts; SCTP; SCTP
// COOKIEACK/COOKIEECHO/DATA/INIT; PPID 61; dstport 38422; DSCP 46; waits 2ms.
// Wireshark: sctp && sctp.data_ppid == 61

host gnb_west_xn_v6 {
    ip 2001:db8:384:22::1
    mac 00:11:22:38:22:01
}

host gnb_east_xn_v6 {
    ip 2001:db8:384:22::2
    mac 00:11:22:38:22:02
}

flow sctp_5g_xnap_setup(west, east) {
    west -> east dscp 46 sctp chunk init vtag 0 srcport 38422 dstport 38422 wait 2ms
    west <- east dscp 46 sctp chunk initack vtag 610022 srcport 38422 dstport 38422 wait 2ms
    west -> east dscp 46 sctp chunk cookieecho vtag 610022 srcport 38422 dstport 38422 payload "xnap_cookie_v6" wait 2ms
    west <- east dscp 46 sctp chunk cookieack vtag 610022 srcport 38422 dstport 38422 wait 2ms
    west -> east dscp 46 sctp chunk data vtag 610022 stream 0 ssn 0 ppid 61 srcport 38422 dstport 38422 payload "xnap_xn_setup_request_tai_list" wait 2ms
    west <- east dscp 46 sctp chunk sack vtag 610022 srcport 38422 dstport 38422
}

compile {
    sctp_5g_xnap_setup(gnb_west_xn_v6, gnb_east_xn_v6)
}
