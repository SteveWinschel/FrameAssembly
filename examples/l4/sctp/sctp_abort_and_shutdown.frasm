// SCTP graceful shutdown association termination sequence with verification tag.
// Wire profile: 2 frames; 2 IPv4 hosts; SCTP; SCTP SHUTDOWN/SHUTDOWNACK.
// Wireshark: sctp

host sctp_close_cli { ip 10.0.1.10 }

host sctp_close_srv { ip 10.0.1.20 }

flow sctp_teardown_flow(cli, srv) {
    cli -> srv sctp chunk shutdown vtag 54321
    cli <- srv sctp chunk shutdownack vtag 54321
}

compile {
    sctp_teardown_flow(sctp_close_cli, sctp_close_srv)
}
