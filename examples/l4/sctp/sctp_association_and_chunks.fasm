// PROMPT: Stream Control Transmission Protocol 4-way association handshake and data chunk transmission with CRC32c.
// TOKENS: HOST, IP, FLOW, ->, <-, SCTP, CHUNK, INIT, INIT_ACK, COOKIE_ECHO, COOKIE_ACK, VTAG, COMPILE

// INSTRUCTION: Define SCTP client endpoint.
HOST sctp_ep_a { IP 192.168.10.1 }

// INSTRUCTION: Define SCTP server endpoint.
HOST sctp_ep_b { IP 192.168.10.2 }

// INSTRUCTION: Define SCTP association handshake flow.
FLOW sctp_assoc_flow(a, b) {
    a -> b SCTP CHUNK INIT VTAG 0
    a <- b SCTP CHUNK INIT_ACK VTAG 100
    a -> b SCTP CHUNK COOKIE_ECHO VTAG 100
    a <- b SCTP CHUNK COOKIE_ACK VTAG 100
}

// INSTRUCTION: Compile block executing SCTP association handshake.
COMPILE {
    sctp_assoc_flow(sctp_ep_a, sctp_ep_b)
}
