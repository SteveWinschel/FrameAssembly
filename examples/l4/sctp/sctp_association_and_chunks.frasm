// Stream Control Transmission Protocol 4-way association handshake and data chunk
// transmission with CRC32c.
// Wire profile: 4 frames; 2 IPv4 hosts; SCTP; SCTP
// COOKIEACK/COOKIEECHO/INIT/INITACK.
// Wireshark: sctp

host sctp_ep_a { ip 192.168.10.1 }

host sctp_ep_b { ip 192.168.10.2 }

flow sctp_assoc_flow(a, b) {
    a -> b sctp chunk init vtag 0
    a <- b sctp chunk initack vtag 100
    a -> b sctp chunk cookieecho vtag 100
    a <- b sctp chunk cookieack vtag 100
}

compile {
    sctp_assoc_flow(sctp_ep_a, sctp_ep_b)
}
