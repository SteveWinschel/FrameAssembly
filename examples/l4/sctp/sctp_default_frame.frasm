// Minimal two-block RFC 9260 SCTP starter emitting a default INIT chunk on port 80.
// Computes the IPv4 header and Castagnoli CRC-32c SCTP checksum automatically
// between two endpoints without requiring explicit flow parameters or sequence setup.
// Inspect summary output via `frameassembly show sctp_default_frame.frasm` or
// write a capture with `frameassembly sctp_default_frame.frasm`.
// Wireshark: sctp && sctp.chunk_type == 1

host client_ep { ip 10.32.0.1 }
host server_ep { ip 10.32.0.2 }

compile {
    client_ep -> server_ep sctp
}
