// International LTE roaming Diameter Routing Agent (DRA) S6a authentication relay
// over SCTP port 3868 (PPID 46).
// Wire profile: 5 frames; 3 IPv4 hosts; SCTP; SCTP DATA/SACK; PPID 46; dstport
// 3868; DSCP 34; waits 2ms, 3ms, 1ms.
// Wireshark: sctp && sctp.data_ppid == 46

host visited_mme_s6a { ip 172.24.38.10 }

host border_dra_node { ip 172.24.38.1 }

host home_hss_s6a { ip 172.24.38.200 }

flow sctp_diameter_roaming_dra(mme, dra, hss) {
    mme -> dra dscp 34 sctp chunk data vtag 600101 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_air_visited_plmn_26201" wait 2ms
    dra -> hss dscp 34 sctp chunk data vtag 600202 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_air_routed_via_dra" wait 3ms
    dra <- hss dscp 34 sctp chunk data vtag 600202 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_aia_eutran_vector_kasme" wait 2ms
    mme <- dra dscp 34 sctp chunk data vtag 600101 stream 1 ssn 0 ppid 46 srcport 3868 dstport 3868 payload "diameter_aia_eutran_vector_kasme" wait 1ms
    mme -> dra dscp 34 sctp chunk sack vtag 600101 srcport 3868 dstport 3868
}

compile {
    sctp_diameter_roaming_dra(visited_mme_s6a, border_dra_node, home_hss_s6a)
}
