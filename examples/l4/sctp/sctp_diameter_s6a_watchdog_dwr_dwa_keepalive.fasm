// PROMPT: HSS and MME maintaining an idle Diameter S6a SCTP association via periodic HEARTBEAT and Diameter Watchdog (DWR/DWA) frames.
// TOKENS: host, ip, mac, flow, dscp, sctp, chunk, heartbeat, vtag, srcport, dstport, payload, wait, ms, heartbeatack, data, stream, ssn, ppid, compile

// INSTRUCTION: Define Home Subscriber Server (HSS) Diameter S6a endpoint.
host hss_s6a_node {
    ip 10.66.38.1
    mac 00:1c:73:42:26:01
}

// INSTRUCTION: Define Mobility Management Entity (MME) Diameter S6a peer.
host mme_s6a_node {
    ip 10.66.38.2
    mac 00:1c:73:42:26:02
}

// INSTRUCTION: Exchange SCTP HEARTBEAT/HEARTBEAT_ACK followed by Diameter Device-Watchdog-Request/Answer on Stream 0.
flow sctp_s6a_watchdog(hss, mme) {
    hss -> mme dscp 46 sctp chunk heartbeat vtag 663800 srcport 3868 dstport 3868 payload "hb_path_primary_10_66_38_2" wait 5ms
    hss <- mme dscp 46 sctp chunk heartbeatack vtag 663800 srcport 3868 dstport 3868 payload "hb_path_primary_10_66_38_2" wait 5ms
    hss -> mme dscp 46 sctp chunk data vtag 663800 stream 0 ssn 50 ppid 46 srcport 3868 dstport 3868 payload "DIAMETER_DWR_ORIGIN_HSS01_REALM_EPC" wait 2ms
    hss <- mme dscp 46 sctp chunk data vtag 663800 stream 0 ssn 50 ppid 46 srcport 3868 dstport 3868 payload "DIAMETER_DWA_RESULT_2001_SUCCESS"
}

// INSTRUCTION: Compile the Diameter S6a SCTP Heartbeat and Watchdog trace.
compile {
    sctp_s6a_watchdog(hss_s6a_node, mme_s6a_node)
}
