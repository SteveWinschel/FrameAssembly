// PROMPT: Emergency Services IP Network (ESInet) Call Routing Function querying Location Information Server over SCTP.
// TOKENS: host, ip, mac, flow, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, payload, wait, ms, sack, compile

// INSTRUCTION: Define Next-Generation 911 Emergency Call Routing Function (ECRF).
host ng911_ecrf_node {
    ip 192.168.91.10
    mac 00:25:90:5b:00:0a
}

// INSTRUCTION: Define carrier Location Information Server (LIS) returning civic/geodetic coordinates.
host carrier_lis_srv {
    ip 192.168.91.1
    mac 00:25:90:5b:00:01
}

// INSTRUCTION: Query emergency caller location over high-priority DSCP EF SCTP Stream 0 and acknowledge via SACK.
flow sctp_ng911_location_query(ecrf, lis) {
    ecrf -> lis dscp 46 sctp chunk data vtag 911911 stream 0 ssn 1 ppid 0 srcport 5060 dstport 5060 payload "HELD_LOCATION_REQ_ANI_12125550199" wait 2ms
    ecrf <- lis dscp 46 sctp chunk sack vtag 911911 srcport 5060 dstport 5060 wait 2ms
    ecrf <- lis dscp 46 sctp chunk data vtag 911911 stream 0 ssn 1 ppid 0 srcport 5060 dstport 5060 payload "PIDF_LO_LAT_40_7128_LON_74_0060_PSAP_NYC" wait 2ms
    ecrf -> lis dscp 46 sctp chunk sack vtag 911911 srcport 5060 dstport 5060
}

// INSTRUCTION: Compile the NG911 emergency location retrieval SCTP trace.
compile {
    sctp_ng911_location_query(ng911_ecrf_node, carrier_lis_srv)
}
