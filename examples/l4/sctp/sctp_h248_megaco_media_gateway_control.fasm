// PROMPT: IMS Media Gateway Controller (MGC) controlling a trunking Media Gateway (MGW) via H.248/Megaco over SCTP port 2944 (PPID 7).
// TOKENS: host, ip, mac, flow, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, payload, wait, ms, sack, compile

// INSTRUCTION: Define IMS Media Gateway Controller (Softswitch MGC) on SCTP port 2944.
host ims_mgc_ctrl {
    ip 172.25.29.1
    mac 00:1c:73:19:1d:01
}

// INSTRUCTION: Define Voice-over-LTE trunking Media Gateway (MGW) on SCTP port 2944.
host ims_mgw_trunk {
    ip 172.25.29.44
    mac 00:1c:73:19:1d:2c
}

// INSTRUCTION: Send H.248 Add command allocating RTP termination on Stream 1 (PPID 7) and receive H.248 Reply.
flow sctp_h248_megaco_call(mgc, mgw) {
    mgc -> mgw dscp 46 sctp chunk data vtag 294401 stream 1 ssn 5 ppid 7 srcport 2944 dstport 2944 payload "MEGACO/3 [172.25.29.1] Transaction=105{Context=${Add=ep1}}" wait 2ms
    mgc <- mgw dscp 46 sctp chunk sack vtag 294401 srcport 2944 dstport 2944 wait 2ms
    mgc <- mgw dscp 46 sctp chunk data vtag 294401 stream 1 ssn 5 ppid 7 srcport 2944 dstport 2944 payload "MEGACO/3 [172.25.29.44] Reply=105{Context=5001{Add=ep1}}" wait 2ms
    mgc -> mgw dscp 46 sctp chunk sack vtag 294401 srcport 2944 dstport 2944
}

// INSTRUCTION: Compile the IMS H.248/Megaco Media Gateway Control SCTP trace.
compile {
    sctp_h248_megaco_call(ims_mgc_ctrl, ims_mgw_trunk)
}
