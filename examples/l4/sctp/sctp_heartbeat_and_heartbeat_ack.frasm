// PROMPT: SCTP Path Heartbeat (HEARTBEAT and HEARTBEAT_ACK chunks) probing multi-homed transport path reachability.
// TOKENS: host, ip, flow, sctp, chunk, heartbeat, vtag, srcport, dstport, payload, heartbeatack, wait, ms, compile

// INSTRUCTION: Define primary SCTP multi-homed host probing secondary path.
host sctp_hb_sender { ip 172.16.40.10 }

// INSTRUCTION: Define remote SCTP multi-homed peer echoing Heartbeat Information TLV.
host sctp_hb_responder { ip 172.16.40.20 }

// INSTRUCTION: Define SCTP HEARTBEAT and HEARTBEAT_ACK exchange with path timestamp payload.
flow sctp_path_heartbeat(snd, rsp) {
    snd -> rsp sctp chunk heartbeat vtag 440100 srcport 2905 dstport 2905 payload "hb_info_path_172_16_40_20_ts_1001"
    snd <- rsp sctp chunk heartbeatack vtag 440100 srcport 2905 dstport 2905 payload "hb_info_path_172_16_40_20_ts_1001" wait 2ms
}

// INSTRUCTION: Compile block executing SCTP path heartbeat verification.
compile {
    sctp_path_heartbeat(sctp_hb_sender, sctp_hb_responder)
}
