// SCTP Path Heartbeat (HEARTBEAT and HEARTBEAT_ACK chunks) probing multi-homed
// transport path reachability.
// Wire profile: 2 frames; 2 IPv4 hosts; SCTP; SCTP HEARTBEAT/HEARTBEATACK;
// dstport 2905; waits 2ms.
// Wireshark: sctp && sctp.port == 2905

host sctp_hb_sender { ip 172.16.40.10 }

host sctp_hb_responder { ip 172.16.40.20 }

flow sctp_path_heartbeat(snd, rsp) {
    snd -> rsp sctp chunk heartbeat vtag 440100 srcport 2905 dstport 2905 payload "hb_info_path_172_16_40_20_ts_1001" wait 2ms
    snd <- rsp sctp chunk heartbeatack vtag 440100 srcport 2905 dstport 2905 payload "hb_info_path_172_16_40_20_ts_1001"
}

compile {
    sctp_path_heartbeat(sctp_hb_sender, sctp_hb_responder)
}
