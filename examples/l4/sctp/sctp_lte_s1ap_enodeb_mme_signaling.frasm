// 4G LTE S1-AP signaling over SCTP port 36412 (PPID 18) between eNodeB and MME
// with Selective Acknowledgment (SACK).
// Wire profile: 5 frames; 2 IPv4 hosts; SCTP; SCTP DATA/SACK; PPID 18; dstport
// 36412; waits 1ms, 2ms.
// Wireshark: sctp && sctp.data_ppid == 18

host lte_enodeb { ip 10.140.36.11 }

host lte_mme_core { ip 10.140.36.1 }

flow sctp_lte_s1ap_exchange(enb, mme) {
    enb -> mme sctp chunk data vtag 364121 stream 0 ssn 0 ppid 18 srcport 36412 dstport 36412 payload "s1ap_s1_setup_request" wait 1ms
    enb <- mme sctp chunk sack vtag 364121 srcport 36412 dstport 36412 wait 1ms
    enb <- mme sctp chunk data vtag 364121 stream 0 ssn 0 ppid 18 srcport 36412 dstport 36412 payload "s1ap_s1_setup_response" wait 2ms
    enb -> mme sctp chunk data vtag 364121 stream 1 ssn 0 ppid 18 srcport 36412 dstport 36412 payload "s1ap_initial_ue_message_attach_req" wait 1ms
    enb <- mme sctp chunk sack vtag 364121 srcport 36412 dstport 36412
}

compile {
    sctp_lte_s1ap_exchange(lte_enodeb, lte_mme_core)
}
