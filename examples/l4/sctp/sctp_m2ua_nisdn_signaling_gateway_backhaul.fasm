// PROMPT: RFC 3331 SIGTRAN M2UA (MTP2-User Adaptation Layer, PPID 2) backhauling narrowband SS7 links from a media gateway on port 2904.
// TOKENS: host, ip, mac, flow, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, payload, wait, ms, sack, compile

// INSTRUCTION: Define TDM-to-IP Signaling Gateway (SGW) terminating E1/T1 SS7 links.
host tdm_sgw_edge {
    ip 10.29.4.10
    mac 00:25:90:1d:04:0a
}

// INSTRUCTION: Define IP Softswitch Media Gateway Controller on SCTP port 2904.
host softswitch_mgc {
    ip 10.29.4.1
    mac 00:25:90:1d:04:01
}

// INSTRUCTION: Exchange M2UA ASP Up/Ack and MTP2 data payload over SCTP port 2904 with PPID 2.
flow sctp_m2ua_backhaul(sgw, mgc) {
    sgw -> mgc dscp 46 sctp chunk data vtag 290400 stream 0 ssn 0 ppid 2 srcport 2904 dstport 2904 payload "M2UA_MSG_CLASS3_ASP_UP" wait 2ms
    sgw <- mgc dscp 46 sctp chunk data vtag 290400 stream 0 ssn 0 ppid 2 srcport 2904 dstport 2904 payload "M2UA_MSG_CLASS3_ASP_UP_ACK" wait 2ms
    sgw -> mgc dscp 46 sctp chunk data vtag 290400 stream 1 ssn 0 ppid 2 srcport 2904 dstport 2904 payload "M2UA_MAUP_DATA_E1_LINK_0_SIO_83" wait 2ms
    sgw <- mgc dscp 46 sctp chunk sack vtag 290400 srcport 2904 dstport 2904
}

// INSTRUCTION: Compile the RFC 3331 SIGTRAN M2UA SS7 backhaul SCTP trace.
compile {
    sctp_m2ua_backhaul(tdm_sgw_edge, softswitch_mgc)
}
