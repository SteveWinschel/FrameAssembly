// Minimal RFC 9260 SCTP packet using default INIT chunk and Castagnoli CRC-32c checksum.
// Uses direct two-block host and compile syntax without a flow block, defaulting
// to srcport 12345, dstport 80, verification tag 0, and IP protocol 132.
// Inspect chunk details via `frameassembly show sctp_minimal_zero_keyword_default.frasm`.
// Wireshark: sctp && sctp.chunk_type == 1

host sctp_min_a { ip 10.32.0.1 }
host sctp_min_b { ip 10.32.0.2 }

compile {
    sctp_min_a -> sctp_min_b sctp
}
