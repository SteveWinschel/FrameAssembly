// Multi-stream SCTP Head-of-Line (HoL) blocking avoidance multiplexing
// independent streams 0, 1, 2, and 3 on a single association.
// Wire profile: 5 frames; 2 IPv4 hosts; SCTP; SCTP DATA/SACK; PPID 39; dstport
// 9899; waits 500us, 1ms.
// Wireshark: sctp && sctp.data_ppid == 39

host sctp_mux_sender { ip 172.22.90.1 }

host sctp_mux_receiver { ip 172.22.90.2 }

flow sctp_multistream_mux(tx, rx) {
    tx -> rx sctp chunk data vtag 800100 stream 0 ssn 0 ppid 39 srcport 9899 dstport 9899 payload "stream_0_control_channel_msg_0" wait 500us
    tx -> rx sctp chunk data vtag 800100 stream 1 ssn 0 ppid 39 srcport 9899 dstport 9899 payload "stream_1_telemetry_channel_msg_0" wait 500us
    tx -> rx sctp chunk data vtag 800100 stream 2 ssn 0 ppid 39 srcport 9899 dstport 9899 payload "stream_2_audit_channel_msg_0" wait 500us
    tx -> rx sctp chunk data vtag 800100 stream 3 ssn 0 ppid 39 srcport 9899 dstport 9899 payload "stream_3_Alert_channel_msg_0" wait 1ms
    tx <- rx sctp chunk sack vtag 800100 srcport 9899 dstport 9899
}

compile {
    sctp_multistream_mux(sctp_mux_sender, sctp_mux_receiver)
}
