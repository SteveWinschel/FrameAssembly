// Multi-homed SCTP failover switching active Diameter Gy charging traffic from
// primary subnet to secondary subnet after Heartbeat timeout.
// Wire profile: 3 frames; 4 IPv4 hosts; SCTP; SCTP DATA/HEARTBEAT/SACK; PPID 46;
// dstport 3868; waits 1s, 2ms.
// Wireshark: sctp && sctp.data_ppid == 46

host ocs_primary_ip { ip 10.71.1.10 }

host ocs_secondary_ip { ip 10.71.2.10 }

host pgw_primary_ip { ip 10.71.1.1 }

host pgw_secondary_ip { ip 10.71.2.1 }

flow sctp_multihomed_failover(pgw1, ocs1, pgw2, ocs2) {
    pgw1 -> ocs1 sctp chunk heartbeat vtag 710001 srcport 3868 dstport 3868 payload "hb_primary_path_probe" wait 1s
    pgw2 -> ocs2 sctp chunk data vtag 710001 stream 1 ssn 10 ppid 46 srcport 3868 dstport 3868 payload "diameter_ccr_failover_secondary_path" wait 2ms
    pgw2 <- ocs2 sctp chunk sack vtag 710001 srcport 3868 dstport 3868
}

compile {
    sctp_multihomed_failover(pgw_primary_ip, ocs_primary_ip, pgw_secondary_ip, ocs_secondary_ip)
}
