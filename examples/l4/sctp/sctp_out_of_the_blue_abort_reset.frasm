// SCTP sudden association abort via ABORT chunk (Type 6) after receiving an out-
// of-the-blue invalid stream frame.
// Wire profile: 2 frames; 2 IPv4 hosts; SCTP; SCTP ABORT/DATA; PPID 0; dstport
// 3868,41000; waits 1ms.
// Wireshark: sctp && sctp.data_ppid == 0

host stale_sctp_client { ip 10.19.1.50 }

host restarted_sctp_srv { ip 10.19.1.1 }

flow sctp_ootb_abort_reset(cli, srv) {
    cli -> srv sctp chunk data vtag 999111 stream 0 ssn 5 ppid 0 srcport 41000 dstport 3868 payload "stale_association_payload" wait 1ms
    cli <- srv sctp chunk abort vtag 999111 srcport 3868 dstport 41000
}

compile {
    sctp_ootb_abort_reset(stale_sctp_client, restarted_sctp_srv)
}
