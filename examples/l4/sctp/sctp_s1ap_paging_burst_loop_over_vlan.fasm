// PROMPT: 4G MME broadcasting periodic S1AP Paging messages to an eNodeB tracking area over VLAN 412 SCTP port 36412.
// TOKENS: host, ip, mac, flow, vlan, pcp, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, payload, wait, ms, sack, compile

// INSTRUCTION: Define MME paging controller on RAN signaling VLAN 412.
host mme_paging_ctrl {
    ip 172.19.12.1
    mac 00:1c:73:13:0c:01
}

// INSTRUCTION: Define eNodeB tracking area cell receiving S1AP Paging bursts on VLAN 412.
host enb_tac_cell {
    ip 172.19.12.20
    mac 00:1c:73:13:0c:14
}

// INSTRUCTION: Send non-UE-associated S1AP Paging message on Stream 0 (PPID 18) and receive SACK in a 2-iteration loop.
flow sctp_s1ap_paging_loop(mme, enb) {
    mme -> enb vlan 412 pcp 6 dscp 46 sctp chunk data vtag 412001 stream 0 ssn 1 ppid 18 srcport 36412 dstport 36412 payload "s1ap_paging_s_tmsi_00112233_tai_310_410" wait 5ms
    mme <- enb vlan 412 pcp 6 dscp 46 sctp chunk sack vtag 412001 srcport 36412 dstport 36412
}

// INSTRUCTION: Compile 2 iterations of the VLAN 412 S1AP Paging SCTP burst.
compile {
    sctp_s1ap_paging_loop(mme_paging_ctrl, enb_tac_cell) // cycle 1
    sctp_s1ap_paging_loop(mme_paging_ctrl, enb_tac_cell) // cycle 2
}
