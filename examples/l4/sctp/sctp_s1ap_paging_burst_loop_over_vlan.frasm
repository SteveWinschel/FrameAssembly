// 4G MME broadcasting periodic S1AP Paging messages to an eNodeB tracking area
// over VLAN 412 SCTP port 36412.
// Wire profile: 4 frames; 2 IPv4 hosts; VLAN 412; PCP 6; SCTP; SCTP DATA/SACK;
// PPID 18; dstport 36412; DSCP 46; waits 5ms.
// Wireshark: sctp && sctp.data_ppid == 18

host mme_paging_ctrl {
    ip 172.19.12.1
    mac 00:1c:73:13:0c:01
}

host enb_tac_cell {
    ip 172.19.12.20
    mac 00:1c:73:13:0c:14
}

flow sctp_s1ap_paging_loop(mme, enb) {
    mme -> enb vlan 412 pcp 6 dscp 46 sctp chunk data vtag 412001 stream 0 ssn 1 ppid 18 srcport 36412 dstport 36412 payload "s1ap_paging_s_tmsi_00112233_tai_310_410" wait 5ms
    mme <- enb vlan 412 pcp 6 dscp 46 sctp chunk sack vtag 412001 srcport 36412 dstport 36412
}

compile {
    sctp_s1ap_paging_loop(mme_paging_ctrl, enb_tac_cell) // Iteration 1 of 2
    sctp_s1ap_paging_loop(mme_paging_ctrl, enb_tac_cell) // Iteration 2 of 2
}
