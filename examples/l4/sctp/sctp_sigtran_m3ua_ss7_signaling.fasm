// PROMPT: SS7 SIGTRAN M3UA (MTP3 User Adaptation Layer, PPID 3, Port 2905) signaling between Signaling Gateway and IP Softswitch.
// TOKENS: host, ip, flow, dscp, sctp, chunk, data, vtag, stream, ssn, ppid, srcport, dstport, hexpayload, wait, ms, sack, compile

// INSTRUCTION: Define SS7 Signaling Gateway (SGW) terminating TDM links.
host ss7_sgw_node { ip 10.65.29.1 }

// INSTRUCTION: Define Media Gateway Controller (MGC) IP softswitch.
host mgc_softswitch { ip 10.65.29.2 }

// INSTRUCTION: Define SIGTRAN M3UA ASP Up, ASP Active, and ISUP IAM Payload Data over SCTP PPID 3.
flow sigtran_m3ua_sctp(sgw, mgc) {
    sgw <- mgc dscp 46 sctp chunk data vtag 290501 stream 0 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "0100030100000008"
    sgw -> mgc dscp 46 sctp chunk data vtag 290501 stream 0 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "0100030400000008" wait 2ms
    sgw -> mgc dscp 46 sctp chunk data vtag 290501 stream 1 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "01000101000000180210001000000101" wait 2ms
    sgw <- mgc dscp 46 sctp chunk sack vtag 290501 srcport 2905 dstport 2905 wait 1ms
}

// INSTRUCTION: Compile block executing SS7 SIGTRAN M3UA over SCTP.
compile {
    sigtran_m3ua_sctp(ss7_sgw_node, mgc_softswitch)
}
