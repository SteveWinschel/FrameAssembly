// SS7 SIGTRAN M3UA (MTP3 User Adaptation Layer, PPID 3, Port 2905) signaling
// between Signaling Gateway and IP Softswitch.
// Wire profile: 4 frames; 2 IPv4 hosts; SCTP; SCTP DATA/SACK; PPID 3; dstport
// 2905; DSCP 46; waits 2ms, 1ms.
// Wireshark: sctp && sctp.data_ppid == 3

host ss7_sgw_node { ip 10.65.29.1 }

host mgc_softswitch { ip 10.65.29.2 }

flow sigtran_m3ua_sctp(sgw, mgc) {
    sgw <- mgc dscp 46 sctp chunk data vtag 290501 stream 0 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "0100030100000008" wait 2ms
    sgw -> mgc dscp 46 sctp chunk data vtag 290501 stream 0 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "0100030400000008" wait 2ms
    sgw -> mgc dscp 46 sctp chunk data vtag 290501 stream 1 ssn 0 ppid 3 srcport 2905 dstport 2905 hexpayload "01000101000000180210001000000101" wait 1ms
    sgw <- mgc dscp 46 sctp chunk sack vtag 290501 srcport 2905 dstport 2905
}

compile {
    sigtran_m3ua_sctp(ss7_sgw_node, mgc_softswitch)
}
