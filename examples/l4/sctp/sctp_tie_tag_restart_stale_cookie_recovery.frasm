// SCTP endpoint restart recovery re-running INIT, INIT_ACK, COOKIE_ECHO, and
// COOKIE_ACK before resuming DATA transmission.
// Wire profile: 6 frames; 2 IPv4 hosts; SCTP; SCTP
// COOKIEACK/COOKIEECHO/DATA/INIT; PPID 3; dstport 2905; waits 2ms.
// Wireshark: sctp && sctp.data_ppid == 3

host restarting_sctp_a {
    ip 192.168.132.10
    mac 00:50:56:84:00:0a
}

host surviving_sctp_b {
    ip 192.168.132.20
    mac 00:50:56:84:00:14
}

flow sctp_restart_handshake(a, b) {
    a -> b sctp chunk init vtag 0 srcport 2905 dstport 2905 wait 2ms
    a <- b sctp chunk initack vtag 778899 srcport 2905 dstport 2905 wait 2ms
    a -> b sctp chunk cookieecho vtag 778899 srcport 2905 dstport 2905 payload "restart_tie_tag_cookie_vtag_778899" wait 2ms
    a <- b sctp chunk cookieack vtag 778899 srcport 2905 dstport 2905 wait 2ms
    a -> b sctp chunk data vtag 778899 stream 0 ssn 0 ppid 3 srcport 2905 dstport 2905 payload "m3ua_asp_active_post_restart" wait 2ms
    a <- b sctp chunk sack vtag 778899 srcport 2905 dstport 2905
}

compile {
    sctp_restart_handshake(restarting_sctp_a, surviving_sctp_b)
}
