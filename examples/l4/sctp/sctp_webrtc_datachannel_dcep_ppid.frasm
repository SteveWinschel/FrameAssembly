// WebRTC DataChannel establishment (DCEP PPID 50) and UTF-8 text message exchange
// (PPID 51) over SCTP.
// Wire profile: 4 frames; 2 IPv4 hosts; SCTP; SCTP DATA/SACK; PPID 50,51; dstport
// 5000; waits 2ms, 1ms.
// Wireshark: sctp && sctp.data_ppid == 50

host webrtc_peer_a { ip 192.168.55.101 }

host webrtc_peer_b { ip 192.168.55.102 }

flow webrtc_datachannel_sctp(a, b) {
    a -> b sctp chunk data vtag 500051 stream 1 ssn 0 ppid 50 srcport 5000 dstport 5000 payload "dcep_channel_open_chat_stream" wait 2ms
    a <- b sctp chunk data vtag 500051 stream 1 ssn 0 ppid 50 srcport 5000 dstport 5000 payload "dcep_channel_ack" wait 2ms
    a -> b sctp chunk data vtag 500051 stream 1 ssn 1 ppid 51 srcport 5000 dstport 5000 payload "{\"type\":\"chat\",\"text\":\"Hello WebRTC SCTP\"}" wait 1ms
    a <- b sctp chunk sack vtag 500051 srcport 5000 dstport 5000
}

compile {
    webrtc_datachannel_sctp(webrtc_peer_a, webrtc_peer_b)
}
