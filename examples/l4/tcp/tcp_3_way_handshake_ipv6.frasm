// PROMPT: Complete TCP 3-way handshake over IPv6 with two-stage port inheritance across forward and reversed arrows.
// TOKENS: host, ip, flow, s, tcp, syn, srcport, dstport, ack, compile

// INSTRUCTION: Define IPv6 client host.
host ipv6_client { ip 2001:db8:1::10 }

// INSTRUCTION: Define IPv6 HTTP server host.
host ipv6_server { ip 2001:db8:1::80 }

// INSTRUCTION: Define TCP 3-way handshake flow inheriting ports.
flow tcp_v6_handshake(c, s) {
    c -> s tcp syn srcport 45000 dstport 80
    c <- s tcp syn ack
    c -> s tcp ack
}

// INSTRUCTION: Compile block executing IPv6 TCP handshake.
compile {
    tcp_v6_handshake(ipv6_client, ipv6_server)
}
