// Complete TCP 3-way handshake over IPv6 with two-stage port inheritance across
// forward and reversed arrows.
// Wire profile: 3 frames; 2 IPv6 hosts; TCP; TCP flags SYN/ACK; dstport 80.
// Wireshark: tcp.port == 80

host ipv6_client { ip 2001:db8:1::10 }

host ipv6_server { ip 2001:db8:1::80 }

flow tcp_v6_handshake(c, s) {
    c -> s tcp syn srcport 45000 dstport 80
    c <- s tcp syn ack
    c -> s tcp ack
}

compile {
    tcp_v6_handshake(ipv6_client, ipv6_server)
}
