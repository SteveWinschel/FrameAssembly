// Craft a Christmas/Kamikaze TCP test packet with all 8 TCP header flags enabled
// simultaneously (SYN, ACK, FIN, RST, PSH, URG, ECE, CWR).
// Wire profile: 2 frames; 2 IPv4 hosts; TCP; TCP flags
// SYN/ACK/FIN/RST/PSH/URG/ECE/CWR; dstport 80,65535; waits 10ms.
// Wireshark: (tcp.port == 80 || tcp.port == 65535) && (tcp.window_size_value == 0 || tcp.analysis.zero_window)

host fuzzer_node { ip 10.99.99.1 mac 00:ff:ff:00:00:01 }

host ids_sensor_target { ip 10.99.99.2 mac 00:ff:ff:00:00:02 }

flow all_flags_kamikaze(fuzzer, sensor) {
    fuzzer -> sensor tcp syn ack fin rst psh urg ece cwr srcport 65535 dstport 80 seq 424242 acknum 424242 win 8192 payload "ALL_FLAGS_TEST_VECTOR" wait 10ms
    fuzzer <- sensor tcp rst ack srcport 80 dstport 65535 seq 0 acknum 424264 win 0
}

compile {
    all_flags_kamikaze(fuzzer_node, ids_sensor_target)
}
