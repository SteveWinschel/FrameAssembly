// Closed-port TCP probe answered by an immediate rst ack with Window 0 and RFC
// 793 sequence-plus-one acknowledgment.
// Wire profile: 2 frames; 2 IPv4 hosts; TCP; TCP flags SYN/ACK/RST; dstport
// 8443,61000; waits 500us.
// Wireshark: (tcp.port == 8443 || tcp.port == 61000) && (tcp.window_size_value == 0 || tcp.analysis.zero_window)

host port_prober { ip 10.48.0.15 }

host hardened_host { ip 10.48.0.100 }

flow tcp_closed_port_rst_ack(prober, host) {
    prober -> host tcp syn srcport 61000 dstport 8443 seq 700000 win 64240 wait 500us
    prober <- host tcp rst ack srcport 8443 dstport 61000 seq 0 acknum 700001 win 0
}

compile {
    tcp_closed_port_rst_ack(port_prober, hardened_host)
}
