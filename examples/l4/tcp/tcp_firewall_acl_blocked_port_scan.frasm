// Perimeter firewall ACL validation trace comparing allowed HTTPS, rejected Telnet, and filtered SSH.
// Permits port 443 through a full 3-way handshake, rejects Telnet port 23 with RST ACK
// and win 0, and logs silent drops on SSH 22 and ICMP admin-prohibited on RDP 3389.
// Wireshark: tcp.port == 443 || tcp.port == 23 || tcp.port == 22 || icmp

host external_tester {
    ip 198.51.100.45
    mac 00:16:3e:aa:11:01
}

host dmz_firewall {
    ip 203.0.113.10
    mac 00:1b:17:bb:22:01
}

flow firewall_acl_audit(client, fw) {
    // Allowed HTTPS service completes 3-way handshake
    client -> fw tcp syn srcport 54001 dstport 443 win 64240 mss 1460 wait 2ms
    client <- fw tcp syn ack win 65535 mss 1460 wait 1ms
    client -> fw tcp ack wait 5ms

    // Blocked Telnet port returns immediate RST ACK
    client -> fw tcp syn srcport 54002 dstport 23 win 64240 wait 1ms
    client <- fw tcp rst ack srcport 23 dstport 54002 win 0 wait 5ms

    // Silently dropped SSH probe followed by RDP rejected via ICMP code 13
    client -> fw tcp syn srcport 54003 dstport 22 win 64240 wait 10ms
    client -> fw tcp syn srcport 54004 dstport 3389 win 64240 wait 2ms
    client <- fw icmp destunreach code 13
}

compile {
    firewall_acl_audit(external_tester, dmz_firewall)
}
