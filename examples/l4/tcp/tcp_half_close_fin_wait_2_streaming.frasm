// TCP half-close (FIN_WAIT_2 / CLOSE_WAIT) where the client closes its write side
// while the server continues streaming response data.
// Wire profile: 9 frames; 2 IPv4 hosts; TCP; TCP flags SYN/ACK/FIN/PSH; dstport
// 9200; waits 1ms, 5ms, 2ms.
// Wireshark: tcp.port == 9200

host half_close_cli { ip 192.168.92.10 }

host stream_log_srv { ip 192.168.92.20 }

flow tcp_half_close_stream(cli, srv) {
    cli -> srv tcp syn srcport 53100 dstport 9200 win 64240 wait 1ms
    cli <- srv tcp syn ack win 65535 wait 1ms
    cli -> srv tcp psh ack payload "EXPORT_ALL_LOGS\n" wait 1ms
    cli -> srv tcp fin ack wait 1ms
    cli <- srv tcp ack wait 5ms
    cli <- srv tcp psh ack payload "log_chunk_001: system boot ok\n" wait 5ms
    cli <- srv tcp psh ack payload "log_chunk_002: audit complete\n" wait 2ms
    cli <- srv tcp fin ack wait 1ms
    cli -> srv tcp ack
}

compile {
    tcp_half_close_stream(half_close_cli, stream_log_srv)
}
