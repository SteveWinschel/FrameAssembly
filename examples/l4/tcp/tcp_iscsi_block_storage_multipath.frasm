// iSCSI SAN block storage session over TCP port 3260 with 802.1Q VLAN priority
// tagging and DSCP AF31 marking.
// Wire profile: 7 frames; 2 IPv4 hosts; VLAN 320; PCP 3; TCP; TCP flags
// SYN/ACK/PSH; dstport 3260; DSCP 26; waits 500us, 200us, 1ms.
// Wireshark: tcp.port == 3260

host esxi_iscsi_init {
    ip 172.18.32.11
    mac 00:50:56:c0:32:0b
}

host flash_iscsi_tgt {
    ip 172.18.32.200
    mac 00:a0:98:c0:32:c8
}

flow tcp_iscsi_san_io(init, tgt) {
    init -> tgt vlan 320 pcp 3 dscp 26 tcp syn srcport 49200 dstport 3260 mss 1460 wscale 7 sackperm wait 500us
    init <- tgt vlan 320 pcp 3 dscp 26 tcp syn ack mss 1460 wscale 7 sackperm wait 200us
    init -> tgt vlan 320 pcp 3 dscp 26 tcp ack wait 500us
    init -> tgt vlan 320 pcp 3 dscp 26 tcp psh ack payload "iscsi_login_req_iqn_2026_01_com_corp_esxi01" wait 500us
    init <- tgt vlan 320 pcp 3 dscp 26 tcp psh ack payload "iscsi_login_rsp_status_success_tsih_0001" wait 500us
    init -> tgt vlan 320 pcp 3 dscp 26 tcp psh ack payload "iscsi_scsi_read10_lun0_lba_0x001000_len_64" wait 1ms
    init <- tgt vlan 320 pcp 3 dscp 26 tcp psh ack payload "iscsi_data_in_block_payload_4096b_good"
}

compile {
    tcp_iscsi_san_io(esxi_iscsi_init, flash_iscsi_tgt)
}
