// High-Performance Computing (HPC) 9000-byte Jumbo Frame TCP negotiation with MSS
// 8960 and Window Scale 14.
// Wire profile: 4 frames; 2 IPv4 hosts; VLAN 90; PCP 3; TCP; TCP flags
// SYN/ACK/PSH; dstport 988; waits 200us, 100us.
// Wireshark: tcp.port == 988

host hpc_node_01 {
    ip 172.30.90.1
    mac 0c:42:a1:90:00:01
}

host hpc_lustre_oss {
    ip 172.30.90.2
    mac 0c:42:a1:90:00:02
}

flow tcp_jumbo_mss_8960(node, oss) {
    node -> oss vlan 90 pcp 3 df tcp syn srcport 52100 dstport 988 win 65535 mss 8960 wscale 14 sackperm tsval 500100 tsecr 0 wait 200us
    node <- oss vlan 90 pcp 3 df tcp syn ack win 65535 mss 8960 wscale 14 sackperm tsval 800100 tsecr 500100 wait 100us
    node -> oss vlan 90 pcp 3 df tcp ack win 4096 tsval 500101 tsecr 800100 wait 200us
    node -> oss vlan 90 pcp 3 df tcp psh ack win 4096 tsval 500102 tsecr 800100 payload "lustre_ost_bulk_write_jumbo_segment"
}

compile {
    tcp_jumbo_mss_8960(hpc_node_01, hpc_lustre_oss)
}
