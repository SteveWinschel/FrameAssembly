// Minimal TCP frame emitting an RFC 793 default SYN segment to destination port 80.
// Uses direct two-block host and compile syntax with automatic IPv4/TCP checksums,
// initial seq 1000, and srcport 12345 ready for quick firewall or lab checks.
// Preview with `frameassembly show tcp_minimal_zero_keyword_default.frasm`.
// Wireshark: tcp.flags.syn == 1 && tcp.flags.ack == 0

host tcp_min_client { ip 10.6.0.10 }
host tcp_min_server { ip 10.6.0.80 }

compile {
    tcp_min_client -> tcp_min_server tcp
}
