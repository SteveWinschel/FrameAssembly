// TCP SYN negotiation with comprehensive TCP options including MSS, WSCALE,
// SACK_PERM, TSVAL, and TSECR.
// Wire profile: 2 frames; 2 IPv4 hosts; TCP; TCP flags SYN/ACK; dstport 443.
// Wireshark: tcp.port == 443

host client_opt { ip 10.1.1.1 }

host server_opt { ip 10.1.1.2 }

flow tcp_opt_flow(c, s) {
    c -> s tcp syn srcport 50000 dstport 443 mss 1460 wscale 7 sackperm tsval 1000 tsecr 0
    c <- s tcp syn ack mss 1460 wscale 7 sackperm tsval 2000 tsecr 1000
}

compile {
    tcp_opt_flow(client_opt, server_opt)
}
