// PROMPT: RFC 7323 PAWS (Protection Against Wrapped Sequences) high-speed TCP timestamp wraparound validation near 2^32-1.
// TOKENS: host, ip, flow, tcp, psh, ack, srcport, dstport, seq, acknum, win, tsval, tsecr, payload, wait, ms, compile

// INSTRUCTION: Define 100GbE sender testing RFC 7323 PAWS timestamp wraparound.
host paws_sender { ip 10.73.23.1 }

// INSTRUCTION: Define 100GbE receiver validating monotonically advancing 32-bit TSVAL across wraparound.
host paws_receiver { ip 10.73.23.2 }

// INSTRUCTION: Define TCP segments crossing the 32-bit unsigned TSVAL boundary (4294967294 -> 4294967295 -> 10).
flow tcp_paws_tsval_wraparound(tx, rx) {
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100000 acknum 1 win 32768 tsval 4294967294 tsecr 900000 payload "iperf3_block_pre_wrap_01"
    tx <- rx tcp ack srcport 5201 dstport 48000 seq 1 acknum 100024 win 32768 tsval 900005 tsecr 4294967294 wait 1ms
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100024 acknum 1 win 32768 tsval 4294967295 tsecr 900005 payload "iperf3_block_at_u32_max" wait 1ms
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100047 acknum 1 win 32768 tsval 10 tsecr 900005 payload "iperf3_block_post_wrap_02" wait 2ms
    tx <- rx tcp ack srcport 5201 dstport 48000 seq 1 acknum 100072 win 32768 tsval 900010 tsecr 10 wait 1ms
}

// INSTRUCTION: Compile block executing TCP PAWS timestamp wraparound test.
compile {
    tcp_paws_tsval_wraparound(paws_sender, paws_receiver)
}
