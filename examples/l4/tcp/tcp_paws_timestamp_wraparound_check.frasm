// RFC 7323 PAWS (Protection Against Wrapped Sequences) high-speed TCP timestamp
// wraparound validation near 2^32-1.
// Wire profile: 5 frames; 2 IPv4 hosts; TCP; TCP flags ACK/PSH; dstport
// 5201,48000; waits 1ms, 2ms.
// Wireshark: (tcp.port == 5201 || tcp.port == 48000)

host paws_sender { ip 10.73.23.1 }

host paws_receiver { ip 10.73.23.2 }

flow tcp_paws_tsval_wraparound(tx, rx) {
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100000 acknum 1 win 32768 tsval 4294967294 tsecr 900000 payload "iperf3_block_pre_wrap_01" wait 1ms
    tx <- rx tcp ack srcport 5201 dstport 48000 seq 1 acknum 100024 win 32768 tsval 900005 tsecr 4294967294 wait 1ms
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100024 acknum 1 win 32768 tsval 4294967295 tsecr 900005 payload "iperf3_block_at_u32_max" wait 2ms
    tx -> rx tcp psh ack srcport 48000 dstport 5201 seq 100047 acknum 1 win 32768 tsval 10 tsecr 900005 payload "iperf3_block_post_wrap_02" wait 1ms
    tx <- rx tcp ack srcport 5201 dstport 48000 seq 1 acknum 100072 win 32768 tsval 900010 tsecr 10
}

compile {
    tcp_paws_tsval_wraparound(paws_sender, paws_receiver)
}
