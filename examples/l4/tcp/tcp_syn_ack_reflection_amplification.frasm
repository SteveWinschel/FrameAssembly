// Simulate a TCP SYN-ACK reflection attack where a reflector server sends
// unsolicited SYN-ACK packets to a spoofed victim IP in a loop.
// Wire profile: 10 frames; 2 IPv4 hosts; TCP; TCP flags SYN/ACK/RST; dstport
// 80,53000; waits 2ms.
// Wireshark: (tcp.port == 80 || tcp.port == 53000) && (tcp.window_size_value == 0 || tcp.analysis.zero_window)

host spoofed_victim { ip 192.0.2.50 mac 00:50:56:c0:00:08 }

host reflector_server { ip 198.51.100.200 mac 00:50:56:c0:00:09 }

flow syn_ack_reflection(victim, reflector) {
    victim <- reflector tcp syn ack srcport 80 dstport 53000 seq 40000 acknum 1001 win 65535 wait 2ms
    victim -> reflector tcp rst srcport 53000 dstport 80 seq 1001 win 0 wait 2ms
}

compile {
    syn_ack_reflection(spoofed_victim, reflector_server) // Iteration 1 of 5
    syn_ack_reflection(spoofed_victim, reflector_server) // Iteration 2 of 5
    syn_ack_reflection(spoofed_victim, reflector_server) // Iteration 3 of 5
    syn_ack_reflection(spoofed_victim, reflector_server) // Iteration 4 of 5
    syn_ack_reflection(spoofed_victim, reflector_server) // Iteration 5 of 5
}
