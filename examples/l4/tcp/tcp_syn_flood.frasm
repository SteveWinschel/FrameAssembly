// Simulate a TCP SYN flood attack from an attacker to a victim web server on port
// 80 using a 5-probe burst with 1ms delay.
// Wire profile: 5 frames; 2 IPv4 hosts; TCP; TCP flags SYN; dstport 80; waits
// 1ms.
// Wireshark: tcp.port == 80 && tcp.flags.syn == 1 && tcp.flags.ack == 0

host victim_server { ip 192.168.1.100 mac 00:11:22:33:44:55 }

host attacker { ip 10.0.0.50 }

flow syn_flood(src, dst) {
    src -> dst tcp syn dstport 80 wait 1ms
}

compile {
    syn_flood(attacker, victim_server) // Iteration 1 of 5
    syn_flood(attacker, victim_server) // Iteration 2 of 5
    syn_flood(attacker, victim_server) // Iteration 3 of 5
    syn_flood(attacker, victim_server) // Iteration 4 of 5
    syn_flood(attacker, victim_server) // Iteration 5 of 5
}
