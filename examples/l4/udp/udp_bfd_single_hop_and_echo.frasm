// PROMPT: RFC 5881 BFD over IPv4/UDP using Control port 3784 and Echo port 3785 with TTL 255 GTSM validation.
// TOKENS: host, ip, flow, ttl, dscp, udp, srcport, dstport, hexpayload, wait, ms, payload, us, compile

// INSTRUCTION: Define core router A running hardware-offloaded BFD Echo.
host bfd_udp_rtr_a { ip 172.20.37.1 }

// INSTRUCTION: Define core router B looping back BFD Echo frames in data plane.
host bfd_udp_rtr_b { ip 172.20.37.2 }

// INSTRUCTION: Define UDP port 3784 BFD Control exchange and UDP port 3785 BFD Echo loopback with TTL 255.
flow udp_bfd_control_and_echo(a, b) {
    a -> b ttl 255 dscp 48 udp srcport 49152 dstport 3784 hexpayload "20c0031800000101000001020000c3500000c3500000c350"
    a <- b ttl 255 dscp 48 udp srcport 49153 dstport 3784 hexpayload "20c0031800000102000001010000c3500000c3500000c350" wait 1ms
    a -> b ttl 255 dscp 48 udp srcport 3785 dstport 3785 payload "bfd_echo_hw_loopback_seq_0001" wait 5ms
    a <- b ttl 254 dscp 48 udp srcport 3785 dstport 3785 payload "bfd_echo_hw_loopback_seq_0001" wait 200us
}

// INSTRUCTION: Compile block executing BFD Control and Echo over UDP ports 3784 and 3785.
compile {
    udp_bfd_control_and_echo(bfd_udp_rtr_a, bfd_udp_rtr_b)
}
