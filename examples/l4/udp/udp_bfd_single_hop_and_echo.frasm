// RFC 5881 BFD over IPv4/UDP using Control port 3784 and Echo port 3785 with TTL
// 255 GTSM validation.
// Wire profile: 4 frames; 2 IPv4 hosts; UDP; dstport 3784,3785; DSCP 48; waits
// 1ms, 5ms, 200us.
// Wireshark: udp.port == 3784 || udp.port == 3785

host bfd_udp_rtr_a { ip 172.20.37.1 }

host bfd_udp_rtr_b { ip 172.20.37.2 }

flow udp_bfd_control_and_echo(a, b) {
    a -> b ttl 255 dscp 48 udp srcport 49152 dstport 3784 hexpayload "20c0031800000101000001020000c3500000c3500000c350" wait 1ms
    a <- b ttl 255 dscp 48 udp srcport 49153 dstport 3784 hexpayload "20c0031800000102000001010000c3500000c3500000c350" wait 5ms
    a -> b ttl 255 dscp 48 udp srcport 3785 dstport 3785 payload "bfd_echo_hw_loopback_seq_0001" wait 200us
    a <- b ttl 254 dscp 48 udp srcport 3785 dstport 3785 payload "bfd_echo_hw_loopback_seq_0001"
}

compile {
    udp_bfd_control_and_echo(bfd_udp_rtr_a, bfd_udp_rtr_b)
}
