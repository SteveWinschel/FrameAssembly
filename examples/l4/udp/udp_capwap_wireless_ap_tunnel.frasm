// RFC 5415 CAPWAP wireless controller Discovery/Join on UDP port 5246 and split-
// MAC data tunnel on UDP port 5247.
// Wire profile: 4 frames; 2 IPv4 hosts; UDP; dstport 5246,5247,52460,52470; DSCP
// 34,48; waits 2ms.
// Wireshark: udp.port == 5246 || udp.port == 5247 || udp.port == 52460

host capwap_wtp_ap { ip 10.72.10.50 }

host capwap_wlc_ac { ip 10.72.0.10 }

flow udp_capwap_ap_tunnel(ap, wlc) {
    ap -> wlc dscp 48 udp srcport 52460 dstport 5246 payload "capwap_control_discovery_request_wtp_radio_80211ax" wait 2ms
    ap <- wlc dscp 48 udp srcport 5246 dstport 52460 payload "capwap_control_discovery_response_ac_name_wlc01" wait 2ms
    ap -> wlc dscp 34 udp srcport 52470 dstport 5247 payload "capwap_data_split_mac_80211_qos_data_frame" wait 2ms
    ap <- wlc dscp 34 udp srcport 5247 dstport 52470 payload "capwap_data_keepalive_echo"
}

compile {
    udp_capwap_ap_tunnel(capwap_wtp_ap, capwap_wlc_ac)
}
