// Minimal two-block RFC 768 UDP datagram starter sending to destination port 80.
// Automatically populates srcport 12345, dstport 80, length, and IPv4/UDP
// checksums directly inside compile without needing a separate flow definition.
// Verify packet fields with `frameassembly show udp_default_frame.frasm` or save
// a trace using `frameassembly udp_default_frame.frasm`.
// Wireshark: udp.dstport == 80

host sender_host { ip 10.17.0.1 }
host receiver_host { ip 10.17.0.2 }

compile {
    sender_host -> receiver_host udp
}
