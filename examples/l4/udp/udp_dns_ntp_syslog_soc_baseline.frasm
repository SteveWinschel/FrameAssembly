// Minimal branch UDP infrastructure baseline combining DNS resolution, NTP sync, and Syslog SIEM heartbeat.
// Emits 5 datagrams (DNS ports 53, NTP port 123, Syslog port 514) with realistic
// post-packet pacing to validate SOC collector and Suricata UDP visibility.
// Wireshark: dns || ntp || syslog

host branch_server {
    ip 10.45.10.25
    mac 00:50:56:45:0a:19
}

host infra_services {
    ip 10.45.1.10
    mac 00:50:56:45:01:0a
}

flow udp_infra_baseline(srv, core) {
    srv -> core dns qname "siem.corp.internal" qtype "A" wait 2ms
    srv <- core dns qname "siem.corp.internal" qtype "A" rcode 0 isresponse rdata "10.45.1.10" wait 5ms
    srv -> core ntp version 4 mode 3 wait 2ms
    srv <- core ntp version 4 mode 4 stratum 1 wait 5ms
    srv -> core syslog pri 134 app "branch-gw" msg "Daily UDP telemetry baseline verified"
}

compile {
    udp_infra_baseline(branch_server, infra_services)
}
