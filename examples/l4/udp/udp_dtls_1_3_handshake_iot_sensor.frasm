// RFC 9147 DTLS 1.3 over UDP port 5684 with stateless HelloRetryRequest cookie
// exchange for constrained IoT sensors.
// Wire profile: 4 frames; 2 IPv6 hosts; UDP; dstport 5684,49684; waits 4ms, 5ms.
// Wireshark: udp.port == 5684 || udp.port == 49684

host dtls_iot_sensor { ip 2001:db8:5684:1::55 }

host dtls_cloud_gw { ip 2001:db8:5684:1::1 }

flow udp_dtls13_handshake(sensor, gw) {
    sensor -> gw udp srcport 49684 dstport 5684 hexpayload "16fefd0000000000000001001001000004" wait 4ms
    sensor <- gw udp srcport 5684 dstport 49684 hexpayload "16fefd0000000000000001001002000004" wait 4ms
    sensor -> gw udp srcport 49684 dstport 5684 hexpayload "16fefd0000000000000002001001000004" wait 5ms
    sensor -> gw udp srcport 49684 dstport 5684 hexpayload "2f0001aabbccddeeff1122334455667788"
}

compile {
    udp_dtls13_handshake(dtls_iot_sensor, dtls_cloud_gw)
}
