// GENEVE network virtualization overlay encapsulated in UDP port 6081 with
// entropy source port hashing.
// Wire profile: 3 frames; 2 IPv4 hosts; UDP; dstport 6081; DSCP 18; waits 1ms.
// Wireshark: udp.port == 6081

host ovn_chassis_a {
    ip 10.244.0.11
    mac 52:54:00:f4:00:0b
}

host ovn_chassis_b {
    ip 10.244.0.12
    mac 52:54:00:f4:00:0c
}

flow udp_geneve_ecmp_entropy(a, b) {
    a -> b dscp 18 udp srcport 58101 dstport 6081 hexpayload "02006558000101000108018000010002" wait 1ms
    a -> b dscp 18 udp srcport 61204 dstport 6081 hexpayload "02006558000101000108018000010003" wait 1ms
    a <- b dscp 18 udp srcport 59333 dstport 6081 hexpayload "02006558000101000108018000020001"
}

compile {
    udp_geneve_ecmp_entropy(ovn_chassis_a, ovn_chassis_b)
}
