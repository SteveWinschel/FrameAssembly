// PROMPT: GENEVE network virtualization overlay encapsulated in UDP port 6081 with entropy source port hashing.
// TOKENS: host, ip, mac, flow, dscp, udp, srcport, dstport, hexpayload, wait, ms, compile

// INSTRUCTION: Define Kubernetes OVN-Kubernetes hypervisor chassis A.
host ovn_chassis_a {
    ip 10.244.0.11
    mac 52:54:00:f4:00:0b
}

// INSTRUCTION: Define Kubernetes OVN-Kubernetes hypervisor chassis B.
host ovn_chassis_b {
    ip 10.244.0.12
    mac 52:54:00:f4:00:0c
}

// INSTRUCTION: Define UDP port 6081 GENEVE tunnel frames with distinct entropy source ports for ECMP spreading.
flow udp_geneve_ecmp_entropy(a, b) {
    a -> b dscp 18 udp srcport 58101 dstport 6081 hexpayload "02006558000101000108018000010002"
    a -> b dscp 18 udp srcport 61204 dstport 6081 hexpayload "02006558000101000108018000010003" wait 1ms
    a <- b dscp 18 udp srcport 59333 dstport 6081 hexpayload "02006558000101000108018000020001" wait 1ms
}

// INSTRUCTION: Compile block executing UDP 6081 GENEVE overlay encapsulation.
compile {
    udp_geneve_ecmp_entropy(ovn_chassis_a, ovn_chassis_b)
}
