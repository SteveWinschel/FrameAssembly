// PROMPT: IPv4 UDP datagram fragmentation across two fragments using IPID, MF (More Fragments), and FRAGOFFSET modifiers.
// TOKENS: host, ip, flow, ipid, mf, fragoffset, udp, srcport, dstport, payload, wait, us, compile

// INSTRUCTION: Define source host transmitting oversized UDP datagram across constrained MTU link.
host frag_udp_sender { ip 172.16.77.10 }

// INSTRUCTION: Define destination host reassembling fragmented IPv4 UDP datagram.
host frag_udp_receiver { ip 172.16.77.20 }

// INSTRUCTION: Define first UDP fragment (MF set, FRAGOFFSET 0) and trailing fragment (FRAGOFFSET 185) with shared IPID 4242.
flow udp_ipv4_fragmentation(tx, rx) {
    tx -> rx ipid 4242 mf fragoffset 0 udp srcport 51000 dstport 8125 payload "udp_fragment_1_statsd_metrics_batch_part_a"
    tx -> rx ipid 4242 fragoffset 185 udp srcport 51000 dstport 8125 payload "udp_fragment_2_statsd_metrics_batch_part_b" wait 500us
}

// INSTRUCTION: Compile block executing fragmented IPv4 UDP transmission.
compile {
    udp_ipv4_fragmentation(frag_udp_sender, frag_udp_receiver)
}
