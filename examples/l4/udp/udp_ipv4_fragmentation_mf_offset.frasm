// IPv4 UDP datagram fragmentation across two fragments using ipid, mf (More
// Fragments), and fragoffset modifiers.
// Wire profile: 2 frames; 2 IPv4 hosts; UDP; dstport 8125; waits 500us.
// Wireshark: udp && (ip.frag_offset > 0 || ip.flags.mf == 1)

host frag_udp_sender { ip 172.16.77.10 }

host frag_udp_receiver { ip 172.16.77.20 }

flow udp_ipv4_fragmentation(tx, rx) {
    tx -> rx ipid 4242 mf fragoffset 0 udp srcport 51000 dstport 8125 payload "udp_fragment_1_statsd_metrics_batch_part_a" wait 500us
    tx -> rx ipid 4242 fragoffset 185 udp srcport 51000 dstport 8125 payload "udp_fragment_2_statsd_metrics_batch_part_b"
}

compile {
    udp_ipv4_fragmentation(frag_udp_sender, frag_udp_receiver)
}
