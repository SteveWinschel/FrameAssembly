// PROMPT: Minimal zero-keyword UDP datagram using RFC 768 default destination port 80 and automatic checksum calculation.
// TOKENS: host, ip, flow, udp, compile

// INSTRUCTION: Define stateless UDP sender host.
host udp_min_tx { ip 10.17.0.1 }

// INSTRUCTION: Define stateless UDP receiver host.
host udp_min_rx { ip 10.17.0.2 }

// INSTRUCTION: Define zero-argument UDP statement relying on RFC-compliant defaults.
flow udp_minimal_default(tx, rx) {
    tx -> rx udp
}

// INSTRUCTION: Compile block executing minimal default UDP datagram generation.
compile {
    udp_minimal_default(udp_min_tx, udp_min_rx)
}
