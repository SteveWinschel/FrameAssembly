// Minimal UDP datagram using RFC 768 default destination port 80 and computed checksums.
// Uses direct two-block host and compile syntax between two IPv4 endpoints with
// automatic srcport 12345, length calculation, and IPv4/UDP checksum generation.
// Preview with `frameassembly show udp_minimal_zero_keyword_default.frasm`.
// Wireshark: udp.dstport == 80

host udp_min_tx { ip 10.17.0.1 }
host udp_min_rx { ip 10.17.0.2 }

compile {
    udp_min_tx -> udp_min_rx udp
}
