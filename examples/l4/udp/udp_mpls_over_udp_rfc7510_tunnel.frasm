// RFC 7510 MPLS-in-UDP encapsulation on UDP port 6635 tunneling labeled VPN
// packets across an IP-only underlay core.
// Wire profile: 2 frames; 2 IPv4 hosts; UDP; dstport 6635; DSCP 34; waits 2ms.
// Wireshark: udp.port == 6635

host mpls_udp_pe_west { ip 198.18.66.1 }

host mpls_udp_pe_east { ip 198.18.66.2 }

flow udp_rfc7510_mpls_tunnel(west, east) {
    west -> east dscp 34 df udp srcport 54110 dstport 6635 hexpayload "00100b404500001c0001000040117c9f" wait 2ms
    west <- east dscp 34 df udp srcport 60220 dstport 6635 hexpayload "00200b404500001c0002000040117c9e"
}

compile {
    udp_rfc7510_mpls_tunnel(mpls_udp_pe_west, mpls_udp_pe_east)
}
