// PROMPT: RFC 7510 MPLS-in-UDP encapsulation on UDP port 6635 tunneling labeled VPN packets across an IP-only underlay core.
// TOKENS: host, ip, flow, dscp, df, udp, srcport, dstport, hexpayload, wait, ms, compile

// INSTRUCTION: Define ingress PE router encapsulating MPLS label stack inside UDP port 6635.
host mpls_udp_pe_west { ip 198.18.66.1 }

// INSTRUCTION: Define egress PE router decapsulating MPLS-in-UDP on port 6635.
host mpls_udp_pe_east { ip 198.18.66.2 }

// INSTRUCTION: Define RFC 7510 UDP port 6635 datagrams with entropy source ports and 32-bit MPLS label header payload.
flow udp_rfc7510_mpls_tunnel(west, east) {
    west -> east dscp 34 df udp srcport 54110 dstport 6635 hexpayload "00100b404500001c0001000040117c9f"
    west <- east dscp 34 df udp srcport 60220 dstport 6635 hexpayload "00200b404500001c0002000040117c9e" wait 2ms
}

// INSTRUCTION: Compile block executing RFC 7510 MPLS-in-UDP encapsulation.
compile {
    udp_rfc7510_mpls_tunnel(mpls_udp_pe_west, mpls_udp_pe_east)
}
