// PROMPT: Simulate a core router exporting NetFlow v9 template and flow-set telemetry records to a traffic analyzer on UDP port 2055.
// TOKENS: host, ip, mac, flow, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define a core aggregation router with IP 10.0.255.1.
host netflow_exporter { ip 10.0.255.1 mac 00:1b:54:00:ff:01 }

// INSTRUCTION: Define a NetFlow traffic collector with IP 10.0.255.100.
host netflow_collector { ip 10.0.255.100 mac 00:1b:54:00:ff:64 }

// INSTRUCTION: Define a flow exporting a NetFlow v9 template record followed by data flowsets on UDP port 2055.
flow export_netflow_v9(exporter, collector) {
    exporter -> collector udp srcport 42055 dstport 2055 payload "NETFLOW_V9_TEMPLATE_ID_256" wait 50ms
    exporter -> collector udp srcport 42055 dstport 2055 payload "NETFLOW_V9_DATA_FLOWSET_256" wait 50ms
}

// INSTRUCTION: Compile block to repeat the NetFlow export 5 times.
compile {
    export_netflow_v9(netflow_exporter, netflow_collector) // cycle 1
    export_netflow_v9(netflow_exporter, netflow_collector) // cycle 2
    export_netflow_v9(netflow_exporter, netflow_collector) // cycle 3
    export_netflow_v9(netflow_exporter, netflow_collector) // cycle 4
    export_netflow_v9(netflow_exporter, netflow_collector) // cycle 5
}
