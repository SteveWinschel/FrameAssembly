// Simulate a core router exporting NetFlow v9 template and flow-set telemetry
// records to a traffic analyzer on UDP port 2055.
// Wire profile: 10 frames; 2 IPv4 hosts; UDP; dstport 2055; waits 50ms.
// Wireshark: udp.port == 2055

host netflow_exporter { ip 10.0.255.1 mac 00:1b:54:00:ff:01 }

host netflow_collector { ip 10.0.255.100 mac 00:1b:54:00:ff:64 }

flow export_netflow_v9(exporter, collector) {
    exporter -> collector udp srcport 42055 dstport 2055 payload "NETFLOW_V9_TEMPLATE_ID_256" wait 50ms
    exporter -> collector udp srcport 42055 dstport 2055 payload "NETFLOW_V9_DATA_FLOWSET_256" wait 50ms
}

compile {
    export_netflow_v9(netflow_exporter, netflow_collector) // Iteration 1 of 5
    export_netflow_v9(netflow_exporter, netflow_collector) // Iteration 2 of 5
    export_netflow_v9(netflow_exporter, netflow_collector) // Iteration 3 of 5
    export_netflow_v9(netflow_exporter, netflow_collector) // Iteration 4 of 5
    export_netflow_v9(netflow_exporter, netflow_collector) // Iteration 5 of 5
}
