// Simulate Network Time Protocol (NTP) clock synchronization polling between a
// Linux host and a Stratum-1 NTP server on UDP port 123 with 1s wait intervals.
// Wire profile: 8 frames; 2 IPv4 hosts; UDP; dstport 123; waits 1s.
// Wireshark: udp.port == 123

host ntp_client { ip 10.10.5.20 mac 00:15:5d:01:05:14 }

host stratum1_ntp { ip 10.10.5.1 mac 00:15:5d:01:05:01 }

flow ntp_time_sync(client, server) {
    client -> server udp srcport 123 dstport 123 payload "NTPv4_MODE3_CLIENT_REQ" wait 1s
    client <- server udp srcport 123 dstport 123 payload "NTPv4_MODE4_STRATUM1_GPS" wait 1s
}

compile {
    ntp_time_sync(ntp_client, stratum1_ntp) // Iteration 1 of 4
    ntp_time_sync(ntp_client, stratum1_ntp) // Iteration 2 of 4
    ntp_time_sync(ntp_client, stratum1_ntp) // Iteration 3 of 4
    ntp_time_sync(ntp_client, stratum1_ntp) // Iteration 4 of 4
}
