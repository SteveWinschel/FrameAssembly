// PROMPT: Paris Traceroute UDP probes with incrementing TTL (1, 2, 3) and high ports (33434..33436) eliciting ICMP Time Exceeded and Port Unreachable.
// TOKENS: host, ip, flow, src, dst, ttl, udp, srcport, dstport, payload, icmp, timeexceeded, code, wait, ms, destunreach, compile

// INSTRUCTION: Define diagnostic workstation running UDP traceroute.
host traceroute_src { ip 10.88.1.10 }

// INSTRUCTION: Define hop-1 router returning ICMP Time Exceeded.
host hop1_router { ip 10.88.1.1 }

// INSTRUCTION: Define destination server returning ICMP Port Unreachable (Code 3).
host target_dest_srv { ip 10.88.2.50 }

// INSTRUCTION: Define UDP traceroute probes on ports 33434 and 33435 with TTL 1 and TTL 2.
flow udp_paris_traceroute(src, hop1, dst) {
    src -> hop1 ttl 1 udp srcport 54321 dstport 33434 payload "paris_traceroute_probe_ttl_1"
    src <- hop1 icmp timeexceeded code 0 wait 2ms
    src -> dst ttl 2 udp srcport 54321 dstport 33435 payload "paris_traceroute_probe_ttl_2" wait 2ms
    src <- dst icmp destunreach code 3 wait 2ms
}

// INSTRUCTION: Compile block executing UDP traceroute hop discovery.
compile {
    udp_paris_traceroute(traceroute_src, hop1_router, target_dest_srv)
}
