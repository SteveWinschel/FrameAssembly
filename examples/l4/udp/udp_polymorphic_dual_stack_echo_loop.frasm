// Shared dual-stack IPv4 and IPv6 RFC 862 UDP Echo service (port 7) jitter
// test executed across repeated flow calls.
// Wire profile: 12 frames; 4 dual-stack IPv4/IPv6 hosts; UDP; dstport 7,50007;
// DSCP 46; waits 5ms.
// Wireshark: udp.port == 7 || udp.port == 50007

host sla_gen_v4 { ip 10.70.7.10 }

host sla_echo_v4 { ip 10.70.7.1 }

host sla_gen_v6 { ip 2001:db8:70:7::10 }

host sla_echo_v6 { ip 2001:db8:70:7::1 }

flow udp_rfc862_echo_probe(gen, echo) {
    gen -> echo ttl 64 dscp 46 flowlabel 0x70007 udp srcport 50007 dstport 7 payload "rfc862_sla_jitter_beacon" wait 5ms
    gen <- echo ttl 64 dscp 46 flowlabel 0x70007 udp srcport 7 dstport 50007 payload "rfc862_sla_jitter_beacon" wait 5ms
}

compile {
    udp_rfc862_echo_probe(sla_gen_v4, sla_echo_v4) // Iteration 1 of 6
    udp_rfc862_echo_probe(sla_gen_v6, sla_echo_v6) // Iteration 2 of 6
    udp_rfc862_echo_probe(sla_gen_v4, sla_echo_v4) // Iteration 3 of 6
    udp_rfc862_echo_probe(sla_gen_v6, sla_echo_v6) // Iteration 4 of 6
    udp_rfc862_echo_probe(sla_gen_v4, sla_echo_v4) // Iteration 5 of 6
    udp_rfc862_echo_probe(sla_gen_v6, sla_echo_v6) // Iteration 6 of 6
}
