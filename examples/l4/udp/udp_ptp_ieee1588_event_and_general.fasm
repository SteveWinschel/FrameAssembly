// PROMPT: IEEE 1588v2 Precision Time Protocol (PTP) Event messages on UDP port 319 and General messages on UDP port 320.
// TOKENS: host, ip, mac, flow, vlan, pcp, dscp, udp, srcport, dstport, payload, wait, us, compile

// INSTRUCTION: Define broadcast studio ST 2110 PTP Grandmaster clock.
host ptp_gm_clock {
    ip 10.158.8.1
    mac 00:1c:73:9e:08:01
}

// INSTRUCTION: Define broadcast IP camera boundary clock slave.
host ptp_cam_slave {
    ip 10.158.8.42
    mac 00:1c:73:9e:08:2a
}

// INSTRUCTION: Define UDP port 319 Event (Sync / Delay_Req) with DSCP 56 and UDP port 320 General (Follow_Up / Delay_Resp).
flow udp_ptp_319_320_sync(gm, slave) {
    gm -> slave vlan 158 pcp 7 dscp 56 udp srcport 319 dstport 319 payload "ptp_v2_event_sync_seq_1040"
    gm -> slave vlan 158 pcp 6 dscp 46 udp srcport 320 dstport 320 payload "ptp_v2_general_follow_up_seq_1040" wait 250us
    gm <- slave vlan 158 pcp 7 dscp 56 udp srcport 319 dstport 319 payload "ptp_v2_event_delay_req_seq_512" wait 500us
    gm -> slave vlan 158 pcp 6 dscp 46 udp srcport 320 dstport 320 payload "ptp_v2_general_delay_resp_seq_512" wait 250us
}

// INSTRUCTION: Compile block executing IEEE 1588 PTP over UDP ports 319 and 320.
compile {
    udp_ptp_319_320_sync(ptp_gm_clock, ptp_cam_slave)
}
