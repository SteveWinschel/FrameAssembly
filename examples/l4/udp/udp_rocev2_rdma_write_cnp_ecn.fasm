// PROMPT: RoCEv2 (RDMA over Converged Ethernet v2) over UDP port 4791 with ECN congestion encountered marking and CNP feedback.
// TOKENS: host, ip, mac, flow, vlan, pcp, dscp, ecn, df, udp, srcport, dstport, hexpayload, wait, us, compile

// INSTRUCTION: Define AI training GPU node A sending RDMA Write over UDP 4791.
host gpu_rdma_tx {
    ip 10.200.47.11
    mac 0c:42:a1:2f:00:0b
}

// INSTRUCTION: Define AI training GPU node B returning RoCEv2 Congestion Notification Packet (CNP).
host gpu_rdma_rx {
    ip 10.200.47.12
    mac 0c:42:a1:2f:00:0c
}

// INSTRUCTION: Define RoCEv2 InfiniBand BTH RDMA Write (Opcode 0x0A) with ECN=3 (CE) and CNP response (Opcode 0x81).
flow udp_rocev2_ecn_cnp(tx, rx) {
    tx -> rx vlan 470 pcp 3 dscp 26 ecn 3 df udp srcport 53111 dstport 4791 hexpayload "0a40ffff0000020080000010"
    tx <- rx vlan 470 pcp 6 dscp 48 ecn 0 df udp srcport 53111 dstport 4791 hexpayload "8100ffff000002000000000000000000" wait 50us
}

// INSTRUCTION: Compile block executing RoCEv2 UDP port 4791 ECN and CNP control loop.
compile {
    udp_rocev2_ecn_cnp(gpu_rdma_tx, gpu_rdma_rx)
}
