// RoCEv2 (RDMA over Converged Ethernet v2) over UDP port 4791 with ECN congestion
// encountered marking and CNP feedback.
// Wire profile: 2 frames; 2 IPv4 hosts; VLAN 470; PCP 3,6; UDP; dstport 4791;
// DSCP 26,48; waits 50us.
// Wireshark: udp.port == 4791

host gpu_rdma_tx {
    ip 10.200.47.11
    mac 0c:42:a1:2f:00:0b
}

host gpu_rdma_rx {
    ip 10.200.47.12
    mac 0c:42:a1:2f:00:0c
}

flow udp_rocev2_ecn_cnp(tx, rx) {
    tx -> rx vlan 470 pcp 3 dscp 26 ecn 3 df udp srcport 53111 dstport 4791 hexpayload "0a40ffff0000020080000010" wait 50us
    tx <- rx vlan 470 pcp 6 dscp 48 ecn 0 df udp srcport 53111 dstport 4791 hexpayload "8100ffff000002000000000000000000"
}

compile {
    udp_rocev2_ecn_cnp(gpu_rdma_tx, gpu_rdma_rx)
}
