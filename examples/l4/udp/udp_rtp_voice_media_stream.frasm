// Simulate a bidirectional G.711 RTP voice media stream exchanging 20ms audio
// frames on UDP port 16384 in a loop.
// Wire profile: 10 frames; 2 IPv4 hosts; UDP; dstport 16384; waits 20ms.
// Wireshark: udp.port == 16384

host rtp_endpoint_a { ip 10.60.2.11 mac 00:04:f2:aa:00:01 }

host rtp_endpoint_b { ip 10.60.2.12 mac 00:04:f2:aa:00:02 }

flow rtp_audio_frame(ep_a, ep_b) {
    ep_a -> ep_b udp srcport 16384 dstport 16384 payload "RTP_PT0_PCMU_160B_A2B" wait 20ms
    ep_a <- ep_b udp srcport 16384 dstport 16384 payload "RTP_PT0_PCMU_160B_B2A" wait 20ms
}

compile {
    rtp_audio_frame(rtp_endpoint_a, rtp_endpoint_b) // Iteration 1 of 5
    rtp_audio_frame(rtp_endpoint_a, rtp_endpoint_b) // Iteration 2 of 5
    rtp_audio_frame(rtp_endpoint_a, rtp_endpoint_b) // Iteration 3 of 5
    rtp_audio_frame(rtp_endpoint_a, rtp_endpoint_b) // Iteration 4 of 5
    rtp_audio_frame(rtp_endpoint_a, rtp_endpoint_b) // Iteration 5 of 5
}
