// Send minimal zero-length UDP datagrams without PAYLOAD using both default ports
// and explicit high-numbered ports for traceroute probing.
// Wire profile: 4 frames; 2 IPv4 hosts; UDP; dstport 33434,33435,45001; waits
// 5ms.
// Wireshark: udp.port == 33434 || udp.port == 33435 || udp.port == 45001

host trace_source { ip 10.0.1.10 }

host trace_dest { ip 10.0.9.99 }

flow empty_udp_probes(src, dst) {
    src -> dst udp wait 5ms
    src -> dst udp srcport 45000 dstport 33434 wait 5ms
    src -> dst udp srcport 45001 dstport 33435 wait 5ms
    src <- dst udp srcport 33435 dstport 45001
}

compile {
    empty_udp_probes(trace_source, trace_dest)
}
