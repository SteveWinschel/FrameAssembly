// PROMPT: DogStatsD / StatsD application telemetry counter, gauge, and histogram batch export over UDP port 8125.
// TOKENS: host, ip, flow, app, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define checkout microservice pod emitting non-blocking StatsD UDP datagrams.
host checkout_svc_pod { ip 10.244.3.45 }

// INSTRUCTION: Define node-local Datadog / StatsD telemetry agent on UDP port 8125.
host statsd_daemon { ip 10.244.3.1 }

// INSTRUCTION: Define multi-metric StatsD UDP datagrams reporting request latency and error counts.
flow udp_statsd_telemetry(app, agent) {
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.requests:1|c|#env:prod,region:us-east"
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.latency_ms:42.7|h|#env:prod,payment:stripe" wait 1ms
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.queue_depth:18|g|#env:prod" wait 1ms
}

// INSTRUCTION: Compile block executing StatsD UDP port 8125 metrics export.
compile {
    udp_statsd_telemetry(checkout_svc_pod, statsd_daemon)
}
