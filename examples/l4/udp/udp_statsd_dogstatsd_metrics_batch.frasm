// DogStatsD / StatsD application telemetry counter, gauge, and histogram batch
// export over UDP port 8125.
// Wire profile: 3 frames; 2 IPv4 hosts; UDP; dstport 8125; waits 1ms.
// Wireshark: udp.port == 8125

host checkout_svc_pod { ip 10.244.3.45 }

host statsd_daemon { ip 10.244.3.1 }

flow udp_statsd_telemetry(app, agent) {
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.requests:1|c|#env:prod,region:us-east" wait 1ms
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.latency_ms:42.7|h|#env:prod,payment:stripe" wait 1ms
    app -> agent udp srcport 55120 dstport 8125 payload "checkout.queue_depth:18|g|#env:prod"
}

compile {
    udp_statsd_telemetry(checkout_svc_pod, statsd_daemon)
}
