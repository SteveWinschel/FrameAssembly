// PROMPT: Simulate VXLAN overlay tunnel encapsulation traffic between two VTEP leaf switches on UDP port 4789.
// TOKENS: host, ip, mac, flow, udp, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define VTEP Leaf Switch 1 with underlay IP 10.250.0.11 and MAC 00:02:c9:aa:00:11.
host vtep_leaf_1 { ip 10.250.0.11 mac 00:02:c9:aa:00:11 }

// INSTRUCTION: Define VTEP Leaf Switch 2 with underlay IP 10.250.0.12 and MAC 00:02:c9:aa:00:12.
host vtep_leaf_2 { ip 10.250.0.12 mac 00:02:c9:aa:00:12 }

// INSTRUCTION: Define a flow exchanging VXLAN VNI 10500 encapsulated frames over UDP destination port 4789.
flow vxlan_tunnel_traffic(vtep_a, vtep_b) {
    vtep_a -> vtep_b udp srcport 55100 dstport 4789 payload "VXLAN_VNI_10500_INNER_FRAME_REQ" wait 2ms
    vtep_a <- vtep_b udp srcport 55200 dstport 4789 payload "VXLAN_VNI_10500_INNER_FRAME_REP" wait 2ms
}

// INSTRUCTION: Compile block to repeat the VXLAN overlay exchange 15 times.
compile {
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // cycle 1 of 15
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // cycle 2 of 15
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // cycle 3 of 15
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // cycle 4 of 15
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // cycle 5 of 15
}
