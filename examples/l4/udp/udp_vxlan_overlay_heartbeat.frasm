// Simulate VXLAN overlay tunnel encapsulation traffic between two VTEP leaf
// switches on UDP port 4789.
// Wire profile: 10 frames; 2 IPv4 hosts; UDP; dstport 4789; waits 2ms.
// Wireshark: udp.port == 4789

host vtep_leaf_1 { ip 10.250.0.11 mac 00:02:c9:aa:00:11 }

host vtep_leaf_2 { ip 10.250.0.12 mac 00:02:c9:aa:00:12 }

flow vxlan_tunnel_traffic(vtep_a, vtep_b) {
    vtep_a -> vtep_b udp srcport 55100 dstport 4789 payload "VXLAN_VNI_10500_INNER_FRAME_REQ" wait 2ms
    vtep_a <- vtep_b udp srcport 55200 dstport 4789 payload "VXLAN_VNI_10500_INNER_FRAME_REP" wait 2ms
}

compile {
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // Iteration 1 of 5
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // Iteration 2 of 5
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // Iteration 3 of 5
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // Iteration 4 of 5
    vxlan_tunnel_traffic(vtep_leaf_1, vtep_leaf_2) // Iteration 5 of 5
}
