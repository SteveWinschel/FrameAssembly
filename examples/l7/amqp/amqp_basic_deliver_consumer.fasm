// PROMPT: AMQP Basic.Deliver push notification from broker to consumer with JSON payload.
// TOKENS: host, ip, flow, amqp, basicdeliver, channel, exchange, routingkey, payload, tcp, ack, compile

// INSTRUCTION: Define the order processing microservice consumer.
host order_consumer { ip 10.50.0.42 }

// INSTRUCTION: Define the AMQP event broker endpoint.
host event_broker { ip 10.50.0.10 }

// INSTRUCTION: Deliver an asynchronous event message to the subscribed consumer channel.
flow amqp_consumer_delivery(cons, brk) {
    cons <- brk amqp basicdeliver channel 2 exchange "orders.topic" routingkey "order.created" payload "{\"id\":9012}"
    cons -> brk tcp ack
}

// INSTRUCTION: Execute the AMQP consumer delivery flow.
compile {
    amqp_consumer_delivery(order_consumer, event_broker)
}
