// AMQP bidirectional heartbeat exchange maintaining connection liveness while
// publisher traffic is paused.
// Wireshark: amqp

host log_producer {
    ip 10.115.100.33
    mac 00:1a:2b:73:a0:33
}

// Memory-constrained RabbitMQ node.
host busy_rmq {
    ip 10.115.100.1
    mac 00:1a:2b:73:a0:01
}

// Publish one batch, then exchange bidirectional HEARTBEAT frames on channel
// 0.
flow amqp_paused_heartbeat(p, b) {
    p -> b amqp basicpublish channel 1 exchange "logs.fanout" routingkey "" payload "LOG_BATCH_9912" wait 5ms
    p <- b amqp heartbeat channel 0 wait 1ms
    p -> b amqp heartbeat channel 0 wait 5ms
    p <- b amqp heartbeat channel 0 wait 1ms
    p -> b amqp heartbeat channel 0
}

compile {
    amqp_paused_heartbeat(log_producer, busy_rmq)
}
