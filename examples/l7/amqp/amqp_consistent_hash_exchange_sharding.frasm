// RabbitMQ x-consistent-hash exchange distributing order stream messages
// across sharded consumer queues.
// Wireshark: amqp

host stream_ingester {
    ip 10.115.120.44
    mac 00:1a:2b:73:c0:44
}

// RabbitMQ broker running rabbitmq_consistent_hash_exchange.
host hash_broker {
    ip 10.115.120.1
    mac 00:1a:2b:73:c0:01
}

// Publish messages with customer IDs as routing keys to
// orders.consistent_hash.
flow amqp_consistent_hash(c, b) {
    c -> b amqp basicpublish channel 1 exchange "orders.consistent_hash" routingkey "cust_10491" payload "{'seq':1,'cust':10491}" wait 1ms
    c -> b amqp basicpublish channel 1 exchange "orders.consistent_hash" routingkey "cust_88310" payload "{'seq':2,'cust':88310}" wait 1ms
    c <- b amqp basicdeliver channel 1 exchange "orders.consistent_hash" routingkey "cust_10491" payload "{'seq':1,'cust':10491}"
}

compile {
    amqp_consistent_hash(stream_ingester, hash_broker)
}
