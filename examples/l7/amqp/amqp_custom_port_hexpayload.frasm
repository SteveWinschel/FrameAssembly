// AMQP custom port override on TCP 15672 with binary HEXPAYLOAD protobuf
// body.
// Wireshark: amqp || tcp.port == 15672

// Financial trading feed publisher.
host trade_feed { ip 192.168.88.10 }

// Custom-port AMQP ingest broker.
host ingest_broker { ip 192.168.88.20 }

// Publish binary protobuf tick data over non-standard TCP port 15672.
flow amqp_binary_feed(f, b) {
    f -> b amqp basicpublish channel 7 exchange "market.ticks" routingkey "nyse.aapl" srcport 49152 dstport 15672 hexpayload "08960112044141504c"
}

compile {
    amqp_binary_feed(trade_feed, ingest_broker)
}
