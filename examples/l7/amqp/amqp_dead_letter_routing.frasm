// High-priority dead-letter queue routing over AMQP with DF flag and custom
// IP ID.
// Wireshark: amqp

// Retry processor service.
host retry_svc { ip 172.31.10.50 }

// Dead-letter AMQP broker.
host dlx_broker { ip 172.31.10.10 }

// Route failed task to dead-letter exchange with Don't Fragment and ECN
// marking. Encapsulation and QoS markings: DSCP 46.
flow amqp_dead_letter_route(r, d) {
    r -> d amqp basicpublish channel 9 exchange "dlx.exchange" routingkey "failed.payment" df ipid 0x4410 dscp 46 ecn 2 payload "{\"Attempt\":5}"
}

compile {
    amqp_dead_letter_route(retry_svc, dlx_broker)
}
