// AMQP publication to the nameless default exchange ("") routing directly to
// queue billing_invoices.
// Wireshark: amqp

// Invoice PDF generator service.
host pdf_service {
    ip 10.115.80.25
    mac 00:1a:2b:73:80:25
}

// Internal RabbitMQ broker.
host internal_rmq {
    ip 10.115.80.1
    mac 00:1a:2b:73:80:01
}

// Publish directly to queue billing_invoices via the empty default exchange
// name.
flow amqp_nameless_exchange(c, b) {
    c -> b amqp channelopen channel 1
    c <- b amqp channelopen channel 1 wait 1ms
    c -> b amqp basicpublish channel 1 exchange "" routingkey "billing_invoices" payload "{'invoice_no':'INV-2026-8841'}"
    c <- b amqp basicdeliver channel 1 exchange "" routingkey "billing_invoices" payload "{'invoice_no':'INV-2026-8841'}"
}

compile {
    amqp_nameless_exchange(pdf_service, internal_rmq)
}
