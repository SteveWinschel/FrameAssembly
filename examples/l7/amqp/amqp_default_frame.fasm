// PROMPT: AMQP 0-9-1 zero-argument default frame emission between producer and broker.
// TOKENS: host, ip, mac, flow, amqp, compile

// INSTRUCTION: Define the AMQP producer host with IPv4 and MAC addresses.
host amqp_producer {
    ip 10.20.1.10
    mac 00:1a:2b:3c:4d:01
}

// INSTRUCTION: Define the AMQP message broker host.
host amqp_broker {
    ip 10.20.1.100
    mac 00:1a:2b:3c:4d:02
}

// INSTRUCTION: Define a minimal AMQP flow using smart RFC defaults.
flow amqp_default_flow(prod, brk) {
    prod -> brk amqp
}

// INSTRUCTION: Compile the default AMQP packet scenario.
compile {
    amqp_default_flow(amqp_producer, amqp_broker)
}
