// AMQP 0-9-1 starter packet on TCP port 5672 using built-in defaults. Without
// extra fields, this sends the 8-byte AMQP 0-9-1 protocol header.
// Wireshark: amqp

host amqp_producer {
    ip 10.20.1.10
    mac 00:1a:2b:3c:4d:01
}

host amqp_broker {
    ip 10.20.1.100
    mac 00:1a:2b:3c:4d:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    amqp_producer -> amqp_broker amqp
}
