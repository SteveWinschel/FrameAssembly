// PROMPT: Dual-stack AMQP message publishing executing the same polymorphic flow over IPv4 and IPv6.
// TOKENS: host, ip, flow, amqp, channelopen, channel, basicpublish, exchange, routingkey, basicdeliver, compile

// INSTRUCTION: Define IPv4 AMQP publisher.
host pub_v4 { ip 10.10.5.20 }

// INSTRUCTION: Define IPv4 AMQP broker.
host brk_v4 { ip 10.10.5.1 }

// INSTRUCTION: Define IPv6 AMQP publisher.
host pub_v6 { ip 2001:db8:5672::20 }

// INSTRUCTION: Define IPv6 AMQP broker.
host brk_v6 { ip 2001:db8:5672::1 }

// INSTRUCTION: Define polymorphic AMQP channel open, publish, and delivery flow.
flow amqp_dual_dispatch(p, b) {
    p -> b amqp channelopen channel 1
    p -> b amqp basicpublish channel 1 exchange "events.fanout" routingkey ""
    p <- b amqp basicdeliver channel 1 exchange "events.fanout" routingkey ""
}

// INSTRUCTION: Execute the polymorphic flow over both IPv4 and IPv6 endpoint pairs.
compile {
    amqp_dual_dispatch(pub_v4, brk_v4)
    amqp_dual_dispatch(pub_v6, brk_v6)
}
