// PROMPT: Complete AMQP lifecycle from TCP SYN through publish/deliver and graceful TCP FIN teardown.
// TOKENS: host, ip, flow, tcp, syn, srcport, dstport, ack, amqp, protocolheader, connectionstart, channelopen, channel, basicpublish, exchange, routingkey, basicdeliver, fin, compile

// INSTRUCTION: Define microservice worker endpoint.
host worker_ep { ip 10.0.55.12 }

// INSTRUCTION: Define AMQP broker endpoint.
host broker_ep { ip 10.0.55.1 }

// INSTRUCTION: Execute full connection setup, message exchange, and TCP FIN teardown.
flow amqp_full_lifecycle(w, b) {
    w -> b tcp syn srcport 54001 dstport 5672
    w <- b tcp syn ack
    w -> b tcp ack
    w -> b amqp protocolheader
    w <- b amqp connectionstart
    w -> b amqp channelopen channel 1
    w -> b amqp basicpublish channel 1 exchange "rpc.direct" routingkey "calc"
    w <- b amqp basicdeliver channel 1 exchange "" routingkey "amq.gen-reply1"
    w -> b tcp fin ack
    w <- b tcp fin ack
    w -> b tcp ack
}

// INSTRUCTION: Compile the complete AMQP session lifecycle.
compile {
    amqp_full_lifecycle(worker_ep, broker_ep)
}
