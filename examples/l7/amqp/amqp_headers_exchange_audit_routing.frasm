// AMQP publishing compliance events to the amq.headers exchange for
// attribute-based routing.
// Wireshark: amqp || tcp

host audit_producer {
    ip 10.115.10.30
    mac 00:1a:2b:73:10:30
}

// Central compliance RabbitMQ broker.
host compliance_rmq {
    ip 10.115.10.1
    mac 00:1a:2b:73:10:01
}

// Publish an authentication audit event to amq.headers with empty routing key
// on channel 2.
flow amqp_headers_pub(p, b) {
    p -> b amqp channelopen channel 2
    p <- b amqp channelopen channel 2 wait 1ms
    p -> b amqp basicpublish channel 2 exchange "amq.headers" routingkey "" payload "{'event':'mfa_enrolled','severity':'high'}"
    p <- b tcp srcport 5672 dstport 49152 ack seq 1 acknum 100
}

compile {
    amqp_headers_pub(audit_producer, compliance_rmq)
}
