// Periodic AMQP heartbeat keepalive frames exchanged in a loop with
// inter-frame delays.
// Wireshark: amqp

host sub_client { ip 192.168.40.15 }

host broker_srv { ip 192.168.40.1 }

// Exchange bidirectional AMQP heartbeat frames on channel 0. Repeats 3 times;
// each wait value pauses after sending its packet.
flow amqp_heartbeat_cycle(c, s) {
    c -> s amqp heartbeat channel 0 wait 1s
    c <- s amqp heartbeat channel 0 wait 1s
}

// Run 3 consecutive heartbeat cycles in the compile block.
compile {
    amqp_heartbeat_cycle(sub_client, broker_srv) // cycle 1
    amqp_heartbeat_cycle(sub_client, broker_srv) // cycle 2
    amqp_heartbeat_cycle(sub_client, broker_srv) // cycle 3
}
