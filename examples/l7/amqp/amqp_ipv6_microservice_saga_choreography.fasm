// PROMPT: IPv6 event-driven microservice saga choreography exchanging OrderCreated and PaymentReserved events via AMQP.
// TOKENS: host, ip, mac, flow, s, amqp, basicdeliver, channel, exchange, routingkey, payload, wait, ms, basicpublish, compile

// INSTRUCTION: Define the IPv6 payment microservice host.
host payment_svc_v6 {
    ip 2001:db8:115:50::30
    mac 00:1a:2b:73:50:30
}

// INSTRUCTION: Define the IPv6 RabbitMQ event mesh broker.
host broker_v6 {
    ip 2001:db8:115:50::1
    mac 00:1a:2b:73:50:01
}

// INSTRUCTION: Consume OrderCreated via Basic.Deliver and publish PaymentReserved via Basic.Publish over IPv6.
flow amqp_ipv6_saga(s, b) {
    s <- b amqp basicdeliver channel 1 exchange "saga.events" routingkey "order.created" payload "{'saga_id':'s_99','amount':75.00}" wait 2ms
    s -> b amqp basicpublish channel 1 exchange "saga.events" routingkey "payment.reserved" payload "{'saga_id':'s_99','status':'RESERVED'}"
}

// INSTRUCTION: Compile the IPv6 AMQP saga choreography flow.
compile {
    amqp_ipv6_saga(payment_svc_v6, broker_v6)
}
