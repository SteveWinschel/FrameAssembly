// PROMPT: Advanced Message Queuing Protocol 0-9-1 connection initialization and message publishing on TCP 5672.
// TOKENS: HOST, IP, FLOW, ->, AMQP, PROTOCOL_HEADER, CHANNEL_OPEN, CHANNEL, BASIC_PUBLISH, ROUTING_KEY, COMPILE

// INSTRUCTION: Define AMQP publisher client.
HOST publisher { IP 10.10.0.10 }

// INSTRUCTION: Define RabbitMQ message broker.
HOST rabbit_broker { IP 10.10.0.1 }

// INSTRUCTION: Define AMQP publishing sequence flow.
FLOW amqp_flow(p, b) {
    p -> b AMQP PROTOCOL_HEADER
    p -> b AMQP CHANNEL_OPEN CHANNEL 1
    p -> b AMQP BASIC_PUBLISH ROUTING_KEY "orders"
}

// INSTRUCTION: Compile block executing AMQP message delivery.
COMPILE {
    amqp_flow(publisher, rabbit_broker)
}
