// Advanced Message Queuing Protocol 0-9-1 connection initialization and
// message publishing on TCP 5672.
// Wireshark: amqp

host publisher { ip 10.10.0.10 }

// RabbitMQ message broker.
host rabbit_broker { ip 10.10.0.1 }

// AMQP publishing sequence flow.
flow amqp_flow(p, b) {
    p -> b amqp protocolheader
    p -> b amqp channelopen channel 1
    p -> b amqp basicpublish routingkey "orders"
}

compile {
    amqp_flow(publisher, rabbit_broker)
}
