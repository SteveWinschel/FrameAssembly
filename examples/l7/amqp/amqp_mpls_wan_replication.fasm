// PROMPT: AMQP inter-datacenter replication traffic encapsulated with MPLS label switching.
// TOKENS: host, ip, flow, src, dst, amqp, basicpublish, channel, exchange, routingkey, mpls, exp, bos, mplsttl, payload, compile

// INSTRUCTION: Define primary datacenter AMQP shovel node.
host dc1_shovel { ip 172.20.1.10 }

// INSTRUCTION: Define secondary datacenter AMQP mirror node.
host dc2_mirror { ip 172.20.2.10 }

// INSTRUCTION: Replicate payment settlement messages over MPLS label 10450.
flow amqp_mpls_shovel(src, dst) {
    src -> dst amqp basicpublish channel 5 exchange "ledger.direct" routingkey "settlement.eu" mpls 10450 exp 5 bos 1 mplsttl 64 payload "TX-9941"
}

// INSTRUCTION: Compile the MPLS-labeled AMQP replication flow.
compile {
    amqp_mpls_shovel(dc1_shovel, dc2_mirror)
}
