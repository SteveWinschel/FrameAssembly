// AMQP inter-datacenter replication traffic encapsulated with MPLS label
// switching.
// Wireshark: amqp

// Primary datacenter AMQP shovel node.
host dc1_shovel { ip 172.20.1.10 }

// Secondary datacenter AMQP mirror node.
host dc2_mirror { ip 172.20.2.10 }

// Replicate payment settlement messages over MPLS label 10450. Encapsulation
// and QoS markings: MPLS label 10450.
flow amqp_mpls_shovel(src, dst) {
    src -> dst amqp basicpublish channel 5 exchange "ledger.direct" routingkey "settlement.eu" mpls 10450 exp 5 bos 1 mplsttl 64 payload "TX-9941"
}

compile {
    amqp_mpls_shovel(dc1_shovel, dc2_mirror)
}
