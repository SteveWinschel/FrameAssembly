// AMQP high-priority emergency alert publication and immediate Basic.Deliver
// dispatch with DSCP EF.
// Wireshark: amqp

// Industrial safety monitor publishing emergency trip alerts.
host safety_monitor {
    ip 10.115.20.15
    mac 00:1a:2b:73:20:15
}

// Real-time plant RabbitMQ broker.
host plant_broker {
    ip 10.115.20.1
    mac 00:1a:2b:73:20:01
}

// Publish emergency stop alert with DSCP 46 (EF) and deliver to the SCADA
// alarm console. Encapsulation and QoS markings: DSCP 46.
flow amqp_emergency_alert(m, b) {
    m -> b amqp basicpublish channel 1 exchange "plant.alerts" routingkey "estop.zone4" dscp 46 payload "{'zone':4,'tripped':true}"
    m <- b amqp basicdeliver channel 1 exchange "plant.alerts" routingkey "estop.zone4" dscp 46 payload "{'zone':4,'tripped':true}"
}

compile {
    amqp_emergency_alert(safety_monitor, plant_broker)
}
