// AMQP 0-9-1 connection initialization protocol header handshake.
// Wireshark: amqp
// Automatic Ethernet MAC addresses and TCP port 5672 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 10.0.0.10 }

host server { ip 10.0.0.1 }

flow amqp_hdr(c, s) {
    c -> s amqp protocolheader
}

compile {
    amqp_hdr(client, server)
}
