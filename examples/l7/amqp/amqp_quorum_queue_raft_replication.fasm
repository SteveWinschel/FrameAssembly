// PROMPT: RabbitMQ quorum queue publishing persistent financial ledger events over VLAN 567.
// TOKENS: host, ip, mac, flow, amqp, channelopen, channel, vlan, pcp, wait, ms, basicpublish, exchange, routingkey, payload, compile

// INSTRUCTION: Define the core banking transaction publisher.
host ledger_pub {
    ip 10.115.40.22
    mac 00:1a:2b:73:40:22
}

// INSTRUCTION: Define the quorum queue leader node on VLAN 567.
host quorum_leader {
    ip 10.115.40.1
    mac 00:1a:2b:73:40:01
}

// INSTRUCTION: Publish two sequential ledger postings to the quorum exchange on channel 5 over VLAN 567.
flow amqp_quorum_publish(p, l) {
    p -> l amqp channelopen channel 5 vlan 567 pcp 5
    p <- l amqp channelopen channel 5 vlan 567 pcp 5 wait 1ms
    p -> l amqp basicpublish channel 5 exchange "ledger.quorum" routingkey "tx.debit" vlan 567 pcp 5 payload "{'tx_id':'tx_1001','amt':500}"
    p -> l amqp basicpublish channel 5 exchange "ledger.quorum" routingkey "tx.credit" vlan 567 pcp 5 payload "{'tx_id':'tx_1001','amt':500}"
}

// INSTRUCTION: Compile the VLAN-tagged AMQP quorum queue flow.
compile {
    amqp_quorum_publish(ledger_pub, quorum_leader)
}
