// Star topology AMQP fanout from one central broker delivering to two worker
// consumers.
// Wireshark: amqp

// Job dispatcher producer.
host job_dispatcher { ip 10.80.1.5 }

// Central AMQP broker.
host central_mq { ip 10.80.1.1 }

// Worker consumer alpha.
host worker_alpha { ip 10.80.1.21 }

// Worker consumer beta.
host worker_beta { ip 10.80.1.22 }

// Dispatch a broadcast event from producer to both consumers via the broker.
flow amqp_star_fanout(disp, mq, wa, wb) {
    disp -> mq amqp basicpublish channel 1 exchange "cache.invalidate" routingkey "all" payload "flush_all"
    wa <- mq amqp basicdeliver channel 1 exchange "cache.invalidate" routingkey "all" payload "flush_all"
    wb <- mq amqp basicdeliver channel 1 exchange "cache.invalidate" routingkey "all" payload "flush_all"
}

compile {
    amqp_star_fanout(job_dispatcher, central_mq, worker_alpha, worker_beta)
}
