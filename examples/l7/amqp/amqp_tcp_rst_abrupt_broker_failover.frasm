// AMQP publisher detecting abrupt broker node crash via TCP RST during
// Basic.Publish.
// Wireshark: tcp

// Resilient event publisher service.
host resilient_pub {
    ip 10.115.130.20
    mac 00:1a:2b:73:d0:20
}

// Failing RabbitMQ cluster node.
host failing_rmq {
    ip 10.115.130.1
    mac 00:1a:2b:73:d0:01
}

// Publish a message on channel 1 and receive an abrupt TCP RST from the
// crashing node.
flow amqp_broker_crash_rst(c, b) {
    c -> b srcport 53100 dstport 5672 amqp basicpublish channel 1 exchange "tx.events" routingkey "tx.new" payload "{'id':551}"
    c <- b tcp srcport 5672 dstport 53100 rst seq 4000
}

compile {
    amqp_broker_crash_rst(resilient_pub, failing_rmq)
}
