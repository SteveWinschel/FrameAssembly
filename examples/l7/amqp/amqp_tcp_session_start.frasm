// Full TCP 3-way handshake followed by AMQP protocol header and
// Connection.Start negotiation.
// Wireshark: tcp || amqp

host queue_worker { ip 172.16.10.25 }

// Central RabbitMQ cluster node.
host rmq_node { ip 172.16.10.5 }

// Establish TCP session and exchange AMQP connection negotiation frames.
flow amqp_tcp_session(w, n) {
    w -> n tcp syn srcport 51200 dstport 5672
    w <- n tcp syn ack
    w -> n tcp ack
    w -> n amqp protocolheader wait 5ms
    w <- n amqp connectionstart
}

compile {
    amqp_tcp_session(queue_worker, rmq_node)
}
