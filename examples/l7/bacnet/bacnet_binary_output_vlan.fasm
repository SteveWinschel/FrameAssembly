// PROMPT: BACnet/IP WriteProperty toggling a Binary Output lighting relay with VLAN tagging.
// TOKENS: host, ip, flow, bacnet, writeproperty, invokeid, objecttype, objectinstance, propertyid, value, vlan, pcp, compile

// INSTRUCTION: Define the smart building lighting panel.
host lighting_panel { ip 172.18.5.10 }

// INSTRUCTION: Define the floor relay controller on OT VLAN 50.
host relay_ctrl { ip 172.18.5.102 }

// INSTRUCTION: Command Binary Output (ObjectType 4) Instance 12 to active state (1) over VLAN 50.
flow bacnet_binary_write(p, r) {
    p -> r bacnet writeproperty invokeid 33 objecttype 4 objectinstance 12 propertyid 85 value 1 vlan 50 pcp 5
}

// INSTRUCTION: Compile the VLAN-tagged BACnet binary relay command.
compile {
    bacnet_binary_write(lighting_panel, relay_ctrl)
}
