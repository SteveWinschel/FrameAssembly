// BACnet/IP WriteProperty toggling a Binary Output lighting relay with VLAN
// tagging.
// Wireshark: bacapp || udp.port == 47808

// Smart building lighting panel.
host lighting_panel { ip 172.18.5.10 }

// Floor relay controller on OT VLAN 50.
host relay_ctrl { ip 172.18.5.102 }

// Command Binary Output (ObjectType 4) Instance 12 to active state (1) over
// VLAN 50. Encapsulation and QoS markings: 802.1Q VLAN 50. BACnet/IP on UDP
// 47808 (objects: 4 (Binary Output); properties: 85 (Present_Value)).
flow bacnet_binary_write(p, r) {
    p -> r bacnet writeproperty invokeid 33 objecttype 4 objectinstance 12 propertyid 85 value 1 vlan 50 pcp 5
}

compile {
    bacnet_binary_write(lighting_panel, relay_ctrl)
}
