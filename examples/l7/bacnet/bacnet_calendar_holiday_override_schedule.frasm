// PROMPT: BACnet/IP Calendar object (Object Type 6) Present_Value check determining active holiday building mode.
// TOKENS: host, ip, mac, flow, s, bacnet, readproperty, invokeid, objecttype, objectinstance, propertyid, value, wait, ms, writeproperty, compile

// INSTRUCTION: Define the supervisory scheduler engine host.
host bms_scheduler {
    ip 10.120.30.10
    mac 00:1a:2b:78:30:10
}

// INSTRUCTION: Define the rooftop unit (RTU) BACnet controller.
host rtu_controller {
    ip 10.120.30.50
    mac 00:1a:2b:78:30:50
}

// INSTRUCTION: Read Calendar (Object Type 6, Instance 1) Present_Value (85) and set Binary Value (Object Type 5) unoccupied mode.
flow bacnet_holiday_check(s, r) {
    s -> r bacnet readproperty invokeid 40 objecttype 6 objectinstance 1 propertyid 85
    s <- r bacnet readproperty invokeid 40 objecttype 6 objectinstance 1 propertyid 85 value 1 wait 2ms
    s -> r bacnet writeproperty invokeid 41 objecttype 5 objectinstance 10 propertyid 85 value 0
    s <- r bacnet writeproperty invokeid 41 objecttype 5 objectinstance 10 propertyid 85 value 0
}

// INSTRUCTION: Compile the BACnet calendar holiday override flow.
compile {
    bacnet_holiday_check(bms_scheduler, rtu_controller)
}
