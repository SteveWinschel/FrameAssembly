// BACnet/IP Calendar object (Object Type 6) Present_Value check determining
// active holiday building mode.
// Wireshark: bacapp || udp.port == 47808

host bms_scheduler {
    ip 10.120.30.10
    mac 00:1a:2b:78:30:10
}

// Rooftop unit (RTU) BACnet controller.
host rtu_controller {
    ip 10.120.30.50
    mac 00:1a:2b:78:30:50
}

// Read Calendar (Object Type 6, Instance 1) Present_Value (85) and set Binary
// Value (Object Type 5) unoccupied mode. BACnet/IP on UDP 47808 (objects: 5
// (Binary Value), 6 (Calendar); properties: 85 (Present_Value)).
flow bacnet_holiday_check(s, r) {
    s -> r bacnet readproperty invokeid 40 objecttype 6 objectinstance 1 propertyid 85
    s <- r bacnet readproperty invokeid 40 objecttype 6 objectinstance 1 propertyid 85 value 1 wait 2ms
    s -> r bacnet writeproperty invokeid 41 objecttype 5 objectinstance 10 propertyid 85 value 0
    s <- r bacnet writeproperty invokeid 41 objecttype 5 objectinstance 10 propertyid 85 value 0
}

compile {
    bacnet_holiday_check(bms_scheduler, rtu_controller)
}
