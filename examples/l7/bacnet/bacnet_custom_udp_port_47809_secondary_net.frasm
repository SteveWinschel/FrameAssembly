// PROMPT: BACnet/IP communication on alternate UDP port 47809 (0xBAC1) for an isolated laboratory HVAC network.
// TOKENS: host, ip, mac, flow, bacnet, srcport, dstport, whois, iam, objecttype, objectinstance, wait, ms, readproperty, invokeid, propertyid, value, compile

// INSTRUCTION: Define the laboratory BMS gateway on UDP port 47809.
host lab_bms {
    ip 172.28.120.10
    mac 00:1a:2b:1c:78:10
}

// INSTRUCTION: Define the fume hood sash controller on UDP port 47809.
host fume_hood_ctrl {
    ip 172.28.120.55
    mac 00:1a:2b:1c:78:55
}

// INSTRUCTION: Exchange Who-Is, I-Am, and sash height ReadProperty on UDP port 47809.
flow bacnet_port_47809(b, f) {
    b -> f bacnet srcport 47809 dstport 47809  whois
    b <- f bacnet srcport 47809 dstport 47809  iam objecttype 8 objectinstance 5500 wait 1ms
    b -> f bacnet srcport 47809 dstport 47809  readproperty invokeid 101 objecttype 0 objectinstance 1 propertyid 85
    b <- f bacnet srcport 47809 dstport 47809  readproperty invokeid 101 objecttype 0 objectinstance 1 propertyid 85 value 35
}

// INSTRUCTION: Compile the custom port 47809 laboratory BACnet flow.
compile {
    bacnet_port_47809(lab_bms, fume_hood_ctrl)
}
