// PROMPT: Datacenter Computer Room Air Conditioning (CRAC) cold-aisle temperature setpoint adjustment via Analog Value (Type 2).
// TOKENS: host, ip, mac, flow, bacnet, writeproperty, invokeid, objecttype, objectinstance, propertyid, value, wait, ms, readproperty, compile

// INSTRUCTION: Define the Datacenter Infrastructure Management (DCIM) server.
host dcim_server {
    ip 10.120.60.5
    mac 00:1a:2b:78:60:05
}

// INSTRUCTION: Define the CRAC unit 7 BACnet/IP interface.
host crac_unit_07 {
    ip 10.120.60.77
    mac 00:1a:2b:78:60:77
}

// INSTRUCTION: Write new cold-aisle setpoint (21 C) to Analog Value Object Type 2 Instance 1 and verify return air temperature.
flow bacnet_crac_setpoint(d, c) {
    d -> c bacnet writeproperty invokeid 70 objecttype 2 objectinstance 1 propertyid 85 value 21
    d <- c bacnet writeproperty invokeid 70 objecttype 2 objectinstance 1 propertyid 85 value 21 wait 2ms
    d -> c bacnet readproperty invokeid 71 objecttype 0 objectinstance 1 propertyid 85
    d <- c bacnet readproperty invokeid 71 objecttype 0 objectinstance 1 propertyid 85 value 29
}

// INSTRUCTION: Compile the datacenter CRAC BACnet setpoint flow.
compile {
    bacnet_crac_setpoint(dcim_server, crac_unit_07)
}
