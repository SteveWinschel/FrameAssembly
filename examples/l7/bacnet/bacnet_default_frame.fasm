// PROMPT: BACnet/IP default frame emission over UDP port 47808 using smart protocol defaults.
// TOKENS: host, ip, mac, flow, bacnet, compile

// INSTRUCTION: Define the BACnet operator workstation.
host bacnet_ws {
    ip 192.168.100.10
    mac 00:50:56:a1:01:01
}

// INSTRUCTION: Define the BACnet field controller.
host bacnet_plc {
    ip 192.168.100.20
    mac 00:50:56:a1:01:02
}

// INSTRUCTION: Emit a default BACnet/IP frame with zero optional overrides.
flow bacnet_default(ws, plc) {
    ws -> plc bacnet
}

// INSTRUCTION: Compile the default BACnet/IP scenario.
compile {
    bacnet_default(bacnet_ws, bacnet_plc)
}
