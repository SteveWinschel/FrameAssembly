// BACnet/IP starter packet on UDP port 47808 using built-in defaults.
// Omitting extra keywords emits a ReadProperty request for Device:1234
// Present_Value (85).
// Wireshark: bacapp || udp.port == 47808

host bacnet_ws {
    ip 192.168.100.10
    mac 00:50:56:a1:01:01
}

host bacnet_plc {
    ip 192.168.100.20
    mac 00:50:56:a1:01:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    bacnet_ws -> bacnet_plc bacnet
}
