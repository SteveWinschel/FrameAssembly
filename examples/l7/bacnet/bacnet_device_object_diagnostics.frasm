// BACnet/IP reading Device Object Status_Flags and Out_Of_Service properties.
// Wireshark: bacapp || udp.port == 47808

host facility_srv { ip 10.12.0.5 }

// Chiller plant BACnet gateway.
host chiller_gw { ip 10.12.0.80 }

// Query Device Object (ObjectType 8) properties 111 (Status_Flags) and 81
// (Out_Of_Service). BACnet/IP on UDP 47808 (objects: 8 (Device); properties:
// 81 (Object_List), 111 (Status_Flags)).
flow bacnet_device_diag(srv, gw) {
    srv -> gw bacnet readproperty invokeid 1 objecttype 8 objectinstance 8000 propertyid 111 wait 20ms
    srv -> gw bacnet readproperty invokeid 2 objecttype 8 objectinstance 8000 propertyid 81
}

compile {
    bacnet_device_diag(facility_srv, chiller_gw)
}
