// PROMPT: BACnet/IP to DALI lighting gateway dimming command on Lighting Output object (Object Type 54).
// TOKENS: host, ip, mac, flow, m, bacnet, writeproperty, invokeid, objecttype, objectinstance, propertyid, value, wait, ms, readproperty, compile

// INSTRUCTION: Define the smart building lighting controller host.
host lighting_master {
    ip 10.120.70.1
    mac 00:1a:2b:78:70:01
}

// INSTRUCTION: Define the floor 4 DALI-to-BACnet lighting gateway.
host dali_gateway {
    ip 10.120.70.40
    mac 00:1a:2b:78:70:40
}

// INSTRUCTION: Set conference room dimming level to 40% for presentation mode on Object Type 54 Instance 12.
flow bacnet_dali_dimming(m, g) {
    m -> g bacnet writeproperty invokeid 80 objecttype 54 objectinstance 12 propertyid 85 value 40
    m <- g bacnet writeproperty invokeid 80 objecttype 54 objectinstance 12 propertyid 85 value 40 wait 1ms
    m -> g bacnet readproperty invokeid 81 objecttype 54 objectinstance 12 propertyid 85
    m <- g bacnet readproperty invokeid 81 objecttype 54 objectinstance 12 propertyid 85 value 40
}

// INSTRUCTION: Compile the BACnet DALI lighting control flow.
compile {
    bacnet_dali_dimming(lighting_master, dali_gateway)
}
