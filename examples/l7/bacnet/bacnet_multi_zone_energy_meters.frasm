// BACnet/IP multi-controller discovery and accumulator meter reading across
// three HVAC zones.
// Wireshark: bacapp || udp.port == 47808

// Building energy gateway.
host energy_gw { ip 192.168.120.1 }

// North Wing sub-meter.
host meter_north { ip 192.168.120.11 }

// South Wing sub-meter.
host meter_south { ip 192.168.120.12 }

// Discover both zone meters and read Accumulator (ObjectType 23) kWh totals.
// BACnet/IP on UDP 47808 (objects: 23 (Accumulator); properties: 85
// (Present_Value)).
flow bacnet_zone_meters(gw, mn, ms) {
    gw -> mn bacnet whois
    gw <- mn bacnet iam
    gw -> mn bacnet readproperty invokeid 50 objecttype 23 objectinstance 1 propertyid 85
    gw -> ms bacnet whois
    gw <- ms bacnet iam
    gw -> ms bacnet readproperty invokeid 51 objecttype 23 objectinstance 1 propertyid 85
}

compile {
    bacnet_zone_meters(energy_gw, meter_north, meter_south)
}
