// BACnet/IP Multi-state Value life-safety fire alarm mode override on UDP
// port 47809.
// Wireshark: bacapp || udp.port == 47808

// Fire alarm control panel (FACP).
host facp_master { ip 10.90.0.10 }

// Smoke purge fan controller.
host smoke_fan { ip 10.90.0.99 }

// Write Multi-state Value (ObjectType 19) Instance 1 to Emergency Purge state
// 3 on port 47809. Encapsulation and QoS markings: DSCP 46. BACnet/IP on UDP
// 47808 (objects: 19 (Multi-State Value); properties: 85 (Present_Value)).
flow bacnet_fire_override(f, s) {
    f -> s bacnet writeproperty invokeid 99 objecttype 19 objectinstance 1 propertyid 85 value 3 srcport 47809 dstport 47809 dscp 46
}

compile {
    bacnet_fire_override(facp_master, smoke_fan)
}
