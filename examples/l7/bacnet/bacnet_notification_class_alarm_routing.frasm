// BACnet/IP Notification Class object (Object Type 15) priority array
// inspection and configuration.
// Wireshark: bacapp || udp.port == 47808

// HVAC alarm engineering console.
host alarm_console {
    ip 10.120.20.15
    mac 00:1a:2b:78:20:15
}

// Central plant BACnet building controller.
host plant_controller {
    ip 10.120.20.1
    mac 00:1a:2b:78:20:01
}

// Read Ack_Required (Property 1) and Write Priority (Property 86) on
// Notification Class 15 Instance 5. BACnet/IP on UDP 47808 (objects: 15
// (Notification Class); properties: 1 (Prop), 86 (Prop)).
flow bacnet_notif_class(c, p) {
    c -> p bacnet readproperty invokeid 30 objecttype 15 objectinstance 5 propertyid 1
    c <- p bacnet readproperty invokeid 30 objecttype 15 objectinstance 5 propertyid 1 value 7 wait 2ms
    c -> p bacnet writeproperty invokeid 31 objecttype 15 objectinstance 5 propertyid 86 value 1
    c <- p bacnet writeproperty invokeid 31 objecttype 15 objectinstance 5 propertyid 86 value 1
}

compile {
    bacnet_notif_class(alarm_console, plant_controller)
}
