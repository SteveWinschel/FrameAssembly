// BACnet/IP Binary Input occupancy sensor polling with custom Ethernet MAC
// overrides and DF flag.
// Wireshark: bacapp || udp.port == 47808

// Room automation controller.
host room_ctrl { ip 192.168.15.10 }

// Ceiling occupancy sensor node.
host occ_sensor { ip 192.168.15.90 }

// Read Binary Input (ObjectType 3) Instance 5 with explicit MAC addresses and
// IPv4 DF flag. BACnet/IP on UDP 47808 (objects: 3 (Binary Input);
// properties: 85 (Present_Value)).
flow bacnet_occupancy_read(c, s) {
    c -> s bacnet readproperty invokeid 15 objecttype 3 objectinstance 5 propertyid 85 srcmac 00:11:22:aa:bb:01 dstmac 00:11:22:aa:bb:02 df ipid 0x1020
}

compile {
    bacnet_occupancy_read(room_ctrl, occ_sensor)
}
