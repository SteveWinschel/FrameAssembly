// PROMPT: BACnet/IP Binary Input occupancy sensor polling with custom Ethernet MAC overrides and DF flag.
// TOKENS: host, ip, flow, s, bacnet, readproperty, invokeid, objecttype, objectinstance, propertyid, srcmac, dstmac, df, ipid, compile

// INSTRUCTION: Define room automation controller.
host room_ctrl { ip 192.168.15.10 }

// INSTRUCTION: Define ceiling occupancy sensor node.
host occ_sensor { ip 192.168.15.90 }

// INSTRUCTION: Read Binary Input (ObjectType 3) Instance 5 with explicit MAC addresses and IPv4 DF flag.
flow bacnet_occupancy_read(c, s) {
    c -> s bacnet readproperty invokeid 15 objecttype 3 objectinstance 5 propertyid 85 srcmac 00:11:22:aa:bb:01 dstmac 00:11:22:aa:bb:02 df ipid 0x1020
}

// INSTRUCTION: Compile the BACnet occupancy sensor query.
compile {
    bacnet_occupancy_read(room_ctrl, occ_sensor)
}
