// Underground parking garage carbon monoxide (CO) ppm threshold triggering
// BACnet exhaust fan startup.
// Wireshark: bacapp || udp.port == 47808

// Garage safety ventilation controller.
host garage_vent_ctrl {
    ip 10.120.130.1
    mac 00:1a:2b:78:d0:01
}

// CO gas detector and exhaust fan BACnet IO module.
host co_fan_module {
    ip 10.120.130.15
    mac 00:1a:2b:78:d0:15
}

// Read CO concentration (42 ppm) from Analog Input 1 and activate Binary
// Output 1 exhaust fan. BACnet/IP on UDP 47808 (objects: 0 (Analog Input), 4
// (Binary Output); properties: 85 (Present_Value)).
flow bacnet_co_exhaust(c, m) {
    c -> m bacnet readproperty invokeid 150 objecttype 0 objectinstance 1 propertyid 85
    c <- m bacnet readproperty invokeid 150 objecttype 0 objectinstance 1 propertyid 85 value 42 wait 1ms
    c -> m bacnet writeproperty invokeid 151 objecttype 4 objectinstance 1 propertyid 85 value 1
    c <- m bacnet writeproperty invokeid 151 objecttype 4 objectinstance 1 propertyid 85 value 1
}

compile {
    bacnet_co_exhaust(garage_vent_ctrl, co_fan_module)
}
