// PROMPT: Periodic BACnet/IP temperature and humidity polling loop with 500ms interval.
// TOKENS: host, ip, flow, s, bacnet, readproperty, invokeid, objecttype, objectinstance, propertyid, wait, ms, compile

// INSTRUCTION: Define the BACnet historian logger.
host historian { ip 10.60.10.2 }

// INSTRUCTION: Define the cleanroom environmental sensor node.
host env_sensor { ip 10.60.10.44 }

// INSTRUCTION: Poll temperature (Instance 1) and relative humidity (Instance 2) analog inputs.
flow bacnet_env_poll(h, s) {
    h -> s bacnet readproperty invokeid 10 objecttype 0 objectinstance 1 propertyid 85 wait 500ms
    h -> s bacnet readproperty invokeid 11 objecttype 0 objectinstance 2 propertyid 85 wait 500ms
}

// INSTRUCTION: Repeat the environmental sensor polling cycle 4 times.
compile {
    bacnet_env_poll(historian, env_sensor) // cycle 1
    bacnet_env_poll(historian, env_sensor) // cycle 2
    bacnet_env_poll(historian, env_sensor) // cycle 3
    bacnet_env_poll(historian, env_sensor) // cycle 4
}
