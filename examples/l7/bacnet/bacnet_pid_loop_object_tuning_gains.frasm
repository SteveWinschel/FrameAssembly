// PROMPT: BACnet/IP Loop object (Object Type 12) proportional and integral gain parameter tuning.
// TOKENS: host, ip, mac, flow, bacnet, writeproperty, invokeid, objecttype, objectinstance, propertyid, value, wait, ms, compile

// INSTRUCTION: Define the commissioning laptop tuning chilled water valve PID loops.
host commissioning_tool {
    ip 10.120.40.99
    mac 00:1a:2b:78:40:99
}

// INSTRUCTION: Define the Air Handling Unit (AHU) BACnet controller.
host ahu_pid_ctrl {
    ip 10.120.40.12
    mac 00:1a:2b:78:40:12
}

// INSTRUCTION: Write Proportional_Constant (Property 93) and Integral_Constant (Property 49) on Loop Object Type 12 Instance 1.
flow bacnet_pid_tuning(t, a) {
    t -> a bacnet writeproperty invokeid 50 objecttype 12 objectinstance 1 propertyid 93 value 15
    t <- a bacnet writeproperty invokeid 50 objecttype 12 objectinstance 1 propertyid 93 value 15 wait 2ms
    t -> a bacnet writeproperty invokeid 51 objecttype 12 objectinstance 1 propertyid 49 value 4
    t <- a bacnet writeproperty invokeid 51 objecttype 12 objectinstance 1 propertyid 49 value 4
}

// INSTRUCTION: Compile the BACnet PID Loop object tuning flow.
compile {
    bacnet_pid_tuning(commissioning_tool, ahu_pid_ctrl)
}
