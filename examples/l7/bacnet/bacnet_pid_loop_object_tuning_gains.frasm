// BACnet/IP Loop object (Object Type 12) proportional and integral gain
// parameter tuning.
// Wireshark: bacapp || udp.port == 47808

// Commissioning laptop tuning chilled water valve PID loops.
host commissioning_tool {
    ip 10.120.40.99
    mac 00:1a:2b:78:40:99
}

// Air Handling Unit (AHU) BACnet controller.
host ahu_pid_ctrl {
    ip 10.120.40.12
    mac 00:1a:2b:78:40:12
}

// Write Proportional_Constant (Property 93) and Integral_Constant (Property
// 49) on Loop Object Type 12 Instance 1. BACnet/IP on UDP 47808 (objects: 12
// (Loop); properties: 49 (Integral_Constant), 93 (Proportional_Constant)).
flow bacnet_pid_tuning(t, a) {
    t -> a bacnet writeproperty invokeid 50 objecttype 12 objectinstance 1 propertyid 93 value 15
    t <- a bacnet writeproperty invokeid 50 objecttype 12 objectinstance 1 propertyid 93 value 15 wait 2ms
    t -> a bacnet writeproperty invokeid 51 objecttype 12 objectinstance 1 propertyid 49 value 4
    t <- a bacnet writeproperty invokeid 51 objecttype 12 objectinstance 1 propertyid 49 value 4
}

compile {
    bacnet_pid_tuning(commissioning_tool, ahu_pid_ctrl)
}
