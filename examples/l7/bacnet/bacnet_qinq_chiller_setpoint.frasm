// BACnet/IP smart campus QinQ double-VLAN tagged chiller setpoint adjustment.
// Wireshark: bacapp || udp.port == 47808

// Central energy management system (EMS).
host central_ems { ip 10.77.1.1 }

// Building 4 rooftop chiller controller.
host rooftop_chiller { ip 10.77.4.50 }

// Read Analog Value (ObjectType 2) setpoint and write updated chilled water
// setpoint. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 500 / C-VLAN
// 40. BACnet/IP on UDP 47808 (objects: 2 (Analog Value); properties: 85
// (Present_Value)).
flow bacnet_qinq_setpoint(ems, ch) {
    ems -> ch bacnet readproperty invokeid 40 objecttype 2 objectinstance 10 propertyid 85 qinq 500 innervlan 40
    ems -> ch bacnet writeproperty invokeid 41 objecttype 2 objectinstance 10 propertyid 85 value 44 qinq 500 innervlan 40
}

compile {
    bacnet_qinq_setpoint(central_ems, rooftop_chiller)
}
