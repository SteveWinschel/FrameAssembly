// BACnet/IP confirmed ReadProperty querying room temperature sensor over
// IPv6.
// Wireshark: bacapp || udp.port == 47808

host client { ip 2001:db8::50 }

host server { ip 2001:db8::20 }

// BACnet/IP on UDP 47808 (objects: 0 (Analog Input); properties: 85
// (Present_Value)).
flow bacnet_read(c, s) {
    c -> s bacnet readproperty invokeid 1 objecttype 0 objectinstance 101 propertyid 85
}

compile {
    bacnet_read(client, server)
}
