// PROMPT: BACnet/IP Variable Air Volume (VAV) box damper position WriteProperty and ReadProperty verification.
// TOKENS: host, ip, mac, flow, bacnet, writeproperty, invokeid, objecttype, objectinstance, propertyid, value, wait, ms, readproperty, compile

// INSTRUCTION: Define the Building Management System (BMS) supervisory workstation.
host bms_workstation {
    ip 10.120.1.10
    mac 00:1a:2b:78:01:10
}

// INSTRUCTION: Define the floor 3 VAV terminal unit controller.
host vav_box_304 {
    ip 10.120.1.44
    mac 00:1a:2b:78:01:44
}

// INSTRUCTION: Command Analog Output (Object Type 1, Instance 2) Present_Value (Property 85) to 75% open and read back.
flow bacnet_vav_damper(bms, vav) {
    bms -> vav bacnet writeproperty invokeid 10 objecttype 1 objectinstance 2 propertyid 85 value 75
    bms <- vav bacnet writeproperty invokeid 10 objecttype 1 objectinstance 2 propertyid 85 value 75 wait 2ms
    bms -> vav bacnet readproperty invokeid 11 objecttype 1 objectinstance 2 propertyid 85
    bms <- vav bacnet readproperty invokeid 11 objecttype 1 objectinstance 2 propertyid 85 value 75
}

// INSTRUCTION: Compile the BACnet VAV damper control flow.
compile {
    bacnet_vav_damper(bms_workstation, vav_box_304)
}
