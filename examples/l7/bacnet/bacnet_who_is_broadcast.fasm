// PROMPT: BACnet/IP building automation unconfirmed Who-Is device discovery broadcast.
// TOKENS: HOST, IP, FLOW, ->, BACNET, WHO_IS, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 192.168.10.50 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 192.168.10.255 }

// INSTRUCTION: Define application traffic flow.
FLOW bacnet_whois(c, s) {
    c -> s BACNET WHO_IS
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    bacnet_whois(client, server)
}
