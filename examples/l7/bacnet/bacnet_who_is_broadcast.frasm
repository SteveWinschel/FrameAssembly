// BACnet/IP building automation unconfirmed Who-Is device discovery
// broadcast.
// Wireshark: bacapp || udp.port == 47808
// Automatic Ethernet MAC addresses and UDP port 47808 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.10.50 }

host server { ip 192.168.10.255 }

flow bacnet_whois(c, s) {
    c -> s bacnet whois
}

compile {
    bacnet_whois(client, server)
}
