// BACnet/IP WriteProperty service setting an Analog Output damper position
// value.
// Wireshark: bacapp || udp.port == 47808

// HVAC supervisory controller.
host hvac_supervisor { ip 10.40.1.10 }

// Variable air volume (VAV) damper actuator.
host vav_damper { ip 10.40.1.55 }

// Write present-value (Property 85) on Analog Output (ObjectType 1) Instance
// 4. BACnet/IP on UDP 47808 (objects: 1 (Analog Output); properties: 85
// (Present_Value)).
flow bacnet_write_damper(sup, vav) {
    sup -> vav bacnet writeproperty invokeid 12 objecttype 1 objectinstance 4 propertyid 85 value 75
}

compile {
    bacnet_write_damper(hvac_supervisor, vav_damper)
}
