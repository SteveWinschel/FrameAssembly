// Building automation and HVAC control using BACnet/IP broadcast WHO-IS and
// I-AM on UDP 47808 (0xBAC0).
// Wireshark: bacapp || udp.port == 47808

// Building management system controller.
host bms_controller { ip 192.168.10.10 }

// Smart HVAC controller unit.
host hvac_unit { ip 192.168.10.20 }

// BACnet device discovery exchange flow.
flow bacnet_flow(b, h) {
    b -> h bacnet whois
    b <- h bacnet iam
}

compile {
    bacnet_flow(bms_controller, hvac_unit)
}
