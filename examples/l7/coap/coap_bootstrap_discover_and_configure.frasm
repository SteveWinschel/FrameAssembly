// LwM2M Bootstrap sequence: client requests bootstrap on /bs and server
// writes credentials via PUT.
// Wireshark: coap

// Factory-fresh IoT device initiating bootstrap.
host fresh_device {
    ip 10.110.140.90
    mac 00:1a:2b:6e:e0:90
}

host bootstrap_srv {
    ip 10.110.140.1
    mac 00:1a:2b:6e:e0:01
}

// Send POST to /bs, receive 2.04 Changed, then receive server-initiated CON
// PUT provisioning /0/0. CoAP over UDP 5683: codes 0.02 (POST), 2.04
// (Changed), 0.03 (PUT); content-format 11542 (oma.lwm2m+tlv).
flow coap_lwm2m_bootstrap(d, b) {
    d -> b coap con code "0.02" msgid 14001 token 801 uripath "bs"
    d <- b coap ack code "2.04" msgid 14001 token 801 wait 2ms
    d <- b coap con code "0.03" msgid 9001 token 802 uripath "0/0" contentformat 11542 hexpayload "c80014636f6170733a2f2f"
    d -> b coap ack code "2.04" msgid 9001 token 802
}

compile {
    coap_lwm2m_bootstrap(fresh_device, bootstrap_srv)
}
