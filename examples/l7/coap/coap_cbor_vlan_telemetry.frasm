// CoAP CBOR binary telemetry (Content-Format 60) with HEXPAYLOAD over VLAN
// 310.
// Wireshark: coap

// Industrial vibration sensor.
host vib_sensor { ip 10.110.31.19 }

// Edge analytics sink.
host edge_sink { ip 10.110.31.1 }

// Transmit CBOR-encoded payload (Content-Format 60) tagged on VLAN 310.
// Encapsulation and QoS markings: 802.1Q VLAN 310. CoAP over UDP 5683: codes
// 0.02 (POST), 2.01 (Created); content-format 60 (application/cbor).
flow coap_cbor_vlan(s, k) {
    s -> k coap con code "0.02" msgid 701 token 0x3100 uripath "cbor/vib" contentformat 60 vlan 310 pcp 3 hexpayload "a16176182a"
    s <- k coap ack code "2.01" msgid 701 token 0x3100 vlan 310 pcp 3
}

compile {
    coap_cbor_vlan(vib_sensor, edge_sink)
}
