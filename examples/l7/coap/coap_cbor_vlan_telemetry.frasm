// PROMPT: CoAP CBOR binary telemetry (Content-Format 60) with HEXPAYLOAD over VLAN 310.
// TOKENS: host, ip, flow, s, coap, con, code, msgid, token, uripath, contentformat, vlan, pcp, hexpayload, ack, compile

// INSTRUCTION: Define industrial vibration sensor.
host vib_sensor { ip 10.110.31.19 }

// INSTRUCTION: Define edge analytics sink.
host edge_sink { ip 10.110.31.1 }

// INSTRUCTION: Transmit CBOR-encoded payload (Content-Format 60) tagged on VLAN 310.
flow coap_cbor_vlan(s, k) {
    s -> k coap con code "0.02" msgid 701 token 0x3100 uripath "cbor/vib" contentformat 60 vlan 310 pcp 3 hexpayload "a16176182a"
    s <- k coap ack code "2.01" msgid 701 token 0x3100 vlan 310 pcp 3
}

// INSTRUCTION: Compile the CBOR VLAN CoAP exchange.
compile {
    coap_cbor_vlan(vib_sensor, edge_sink)
}
