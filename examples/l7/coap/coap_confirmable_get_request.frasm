// RFC 7252 CoAP Confirmable (CON) GET request targeting resource URI path.
// Wireshark: coap
// Automatic Ethernet MAC addresses and UDP port 5683 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.25 }

host server { ip 192.168.1.1 }

flow coap_con(c, s) {
    c -> s coap con uripath "telemetry/status" msgid 101
}

compile {
    coap_con(client, server)
}
