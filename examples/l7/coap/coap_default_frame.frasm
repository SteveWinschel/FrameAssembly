// CoAP starter packet on UDP port 5683 using built-in defaults. Omitting
// extra keywords emits a 4-byte Confirmable (CON) GET request.
// Wireshark: coap

host iot_mote {
    ip 192.168.60.15
    mac 00:12:4b:00:01:01
}

host border_router {
    ip 192.168.60.1
    mac 00:12:4b:00:01:fe
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    iot_mote -> border_router coap
}
