// PROMPT: CoAP Confirmable DELETE resource removal and 2.02 Deleted response over IPv6.
// TOKENS: host, ip, flow, coap, con, code, msgid, token, uripath, ack, compile

// INSTRUCTION: Define IPv6 provisioning server.
host prov_srv { ip 2001:db8:c0a0::1 }

// INSTRUCTION: Define IPv6 constrained luminaire node.
host luminaire { ip 2001:db8:c0a0::42 }

// INSTRUCTION: Issue CoAP CON DELETE (0.04) and receive 2.02 Deleted ACK.
flow coap_delete_resource(p, l) {
    p -> l coap con code "0.04" msgid 910 token 0x7788 uripath "config/schedule"
    p <- l coap ack code "2.02" msgid 910 token 0x7788
}

// INSTRUCTION: Compile the IPv6 CoAP DELETE scenario.
compile {
    coap_delete_resource(prov_srv, luminaire)
}
