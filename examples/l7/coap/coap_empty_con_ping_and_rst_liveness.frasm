// CoAP application-layer ping using an Empty Confirmable (0.00) message
// eliciting a Reset (RST) reply.
// Wireshark: coap

// Border router probing constrained node liveness.
host border_router {
    ip 2001:db8:110:40::1
    mac 00:1a:2b:6e:40:01
}

// 6LoWPAN sleepy end-device over IPv6.
host sleepy_mote {
    ip 2001:db8:110:40::99
    mac 00:1a:2b:6e:40:99
}

// Send an empty CON (code 0.00, token 0) and receive an immediate CoAP RST
// liveness reply. CoAP over UDP 5683: codes 0.00 (Empty).
flow coap_ping_rst(r, m) {
    r -> m coap con code "0.00" msgid 5500 token 0
    r <- m coap rst code "0.00" msgid 5500 token 0
}

compile {
    coap_ping_rst(border_router, sleepy_mote)
}
