// PROMPT: CoAP request rejected with 4.00 Bad Request due to an invalid query parameter payload.
// TOKENS: host, ip, mac, flow, s, coap, con, code, msgid, token, uripath, contentformat, payload, ack, compile

// INSTRUCTION: Define the third-party gateway sending an improperly formatted CoAP command.
host third_party_gw {
    ip 10.110.100.40
    mac 00:1a:2b:6e:a0:40
}

// INSTRUCTION: Define the industrial pressure transmitter CoAP server.
host pressure_tx {
    ip 10.110.100.2
    mac 00:1a:2b:6e:a0:02
}

// INSTRUCTION: Send a PUT with malformed calibration payload and receive 4.00 Bad Request.
flow coap_400_bad_req(c, s) {
    c -> s coap con code "0.03" msgid 10200 token 99 uripath "cal/zero_offset" contentformat 50 payload "{bad_json"
    c <- s coap ack code "4.00" msgid 10200 token 99 payload "Malformed JSON payload"
}

// INSTRUCTION: Compile the CoAP 4.00 Bad Request error flow.
compile {
    coap_400_bad_req(third_party_gw, pressure_tx)
}
