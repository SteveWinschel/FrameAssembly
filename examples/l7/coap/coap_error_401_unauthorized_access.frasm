// PROMPT: CoAP Confirmable PUT to a restricted firmware resource rejected with 4.01 Unauthorized.
// TOKENS: host, ip, mac, flow, s, coap, con, code, msgid, token, uripath, contentformat, payload, ack, compile

// INSTRUCTION: Define the unprovisioned field sensor attempting to modify actuator state.
host untrusted_mote {
    ip 10.110.10.88
    mac 00:1a:2b:6e:10:88
}

// INSTRUCTION: Define the building automation CoAP gateway.
host bms_coap_gw {
    ip 10.110.10.1
    mac 00:1a:2b:6e:10:01
}

// INSTRUCTION: Issue a CON PUT to /actuators/lock and receive a piggybacked 4.01 Unauthorized response.
flow coap_401_unauth(c, s) {
    c -> s coap con code "0.03" msgid 2040 token 901 uripath "actuators/lock" contentformat 0 payload "UNLOCK"
    c <- s coap ack code "4.01" msgid 2040 token 901 payload "DTLS session required"
}

// INSTRUCTION: Compile the CoAP 4.01 Unauthorized rejection flow.
compile {
    coap_401_unauth(untrusted_mote, bms_coap_gw)
}
