// CoAP 4.04 Not Found error response when querying a non-existent URI path.
// Wireshark: coap

host diag_cli { ip 172.16.90.10 }

// Embedded CoAP gateway.
host emb_gw { ip 172.16.90.1 }

// Query missing URI path and receive CoAP ACK with 4.04 Not Found diagnostic
// payload. CoAP over UDP 5683: codes 0.01 (GET), 4.04 (Not Found).
flow coap_not_found(c, g) {
    c -> g coap con code "0.01" msgid 303 token 0x5501 uripath "firmware/beta"
    c <- g coap ack code "4.04" msgid 303 token 0x5501 payload "Resource not found"
}

compile {
    coap_not_found(diag_cli, emb_gw)
}
