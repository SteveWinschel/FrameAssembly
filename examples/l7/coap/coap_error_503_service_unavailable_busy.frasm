// CoAP Confirmable GET during flash calibration returning 5.03 Service
// Unavailable before succeeding on retry.
// Wireshark: coap

// Edge gateway polling an optical air quality sensor.
host edge_poller {
    ip 10.110.30.10
    mac 00:1a:2b:6e:30:10
}

// Particulate matter CoAP sensor node.
host pm25_sensor {
    ip 10.110.30.42
    mac 00:1a:2b:6e:30:42
}

// Receive 5.03 Service Unavailable during sensor warmup, wait 10ms, and retry
// GET successfully. CoAP over UDP 5683: codes 0.01 (GET), 5.03 (Service
// Unavailable), 2.05 (Content); content-format 50 (application/json).
flow coap_503_retry(c, s) {
    c -> s coap con code "0.01" msgid 4100 token 301 uripath "air/pm25"
    c <- s coap ack code "5.03" msgid 4100 token 301 payload "Warmup in progress" wait 10ms
    c -> s coap con code "0.01" msgid 4101 token 302 uripath "air/pm25"
    c <- s coap ack code "2.05" msgid 4101 token 302 contentformat 50 payload "{'pm25':11.4}"
}

compile {
    coap_503_retry(edge_poller, pm25_sensor)
}
