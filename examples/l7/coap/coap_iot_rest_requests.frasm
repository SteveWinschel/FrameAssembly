// Constrained Application Protocol RESTful request over UDP 5683 with
// confirmable GET message.
// Wireshark: coap

host coap_node { ip 2001:db8:5683::1 }

host coap_server { ip 2001:db8:5683::2 }

// CoAP confirmable telemetry GET flow.
flow coap_flow(c, s) {
    c -> s coap con get uripath "/telemetry"
}

compile {
    coap_flow(coap_node, coap_server)
}
