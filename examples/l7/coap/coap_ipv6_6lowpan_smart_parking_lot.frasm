// IPv6 CoAP smart parking bay occupancy updates with DSCP CS2 and hop limit
// 64.
// Wireshark: coap

// Underground magnetic parking bay sensor over IPv6.
host bay_sensor_42 {
    ip 2001:db8:110:120::42
    mac 00:1a:2b:6e:c0:42
}

// Parking garage signage controller over IPv6.
host garage_controller {
    ip 2001:db8:110:120::1
    mac 00:1a:2b:6e:c0:01
}

// Send Confirmable PUT occupancy state transition and receive 2.04 Changed
// over IPv6. Encapsulation and QoS markings: DSCP 16. CoAP over UDP 5683:
// codes 0.03 (PUT), 2.04 (Changed); content-format 50 (application/json).
flow coap_parking_update(s, c) {
    s -> c coap con code "0.03" msgid 12400 token 420 uripath "lot/level2/bay42" contentformat 50 dscp 16 ttl 64 payload "{'occupied':true}"
    s <- c coap ack code "2.04" msgid 12400 token 420 dscp 16 ttl 64
}

compile {
    coap_parking_update(bay_sensor_42, garage_controller)
}
