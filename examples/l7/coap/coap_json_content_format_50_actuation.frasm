// CoAP Confirmable PUT updating smart HVAC valve position using
// application/json (Content-Format 50).
// Wireshark: coap

host climate_ctrl {
    ip 10.110.70.10
    mac 00:1a:2b:6e:70:10
}

// Motorized radiator valve CoAP endpoint.
host valve_node {
    ip 10.110.70.33
    mac 00:1a:2b:6e:70:33
}

// Put new JSON valve opening percentage and verify current reading via GET.
// CoAP over UDP 5683: codes 0.03 (PUT), 2.04 (Changed), 0.01 (GET), 2.05
// (Content); content-format 50 (application/json).
flow coap_json_valve(c, s) {
    c -> s coap con code "0.03" msgid 8100 token 401 uripath "valve/opening" contentformat 50 payload "{'pct':65}"
    c <- s coap ack code "2.04" msgid 8100 token 401 wait 2ms
    c -> s coap con code "0.01" msgid 8101 token 402 uripath "valve/opening"
    c <- s coap ack code "2.05" msgid 8101 token 402 contentformat 50 payload "{'pct':65}"
}

compile {
    coap_json_valve(climate_ctrl, valve_node)
}
