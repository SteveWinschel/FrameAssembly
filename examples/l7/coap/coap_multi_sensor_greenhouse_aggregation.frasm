// Two greenhouse agricultural soil sensors reporting Non-Confirmable moisture
// readings to a central gateway.
// Wireshark: coap

// Soil moisture probe 1 in Bed A.
host soil_probe_a {
    ip 10.110.90.11
    mac 00:1a:2b:6e:90:11
}

// Soil moisture probe 2 in Bed B.
host soil_probe_b {
    ip 10.110.90.12
    mac 00:1a:2b:6e:90:12
}

// Greenhouse irrigation CoAP gateway.
host irrigation_gw {
    ip 10.110.90.1
    mac 00:1a:2b:6e:90:01
}

// Report Bed A soil moisture via NON POST. CoAP over UDP 5683: codes 0.02
// (POST); content-format 0 (text/plain).
flow report_bed_a(p, g) {
    p -> g coap non code "0.02" msgid 1101 token 11 uripath "soil/bed_a" contentformat 0 payload "vwc=34.2"
}

// Report Bed B soil moisture via NON POST.
flow report_bed_b(p, g) {
    p -> g coap non code "0.02" msgid 2201 token 22 uripath "soil/bed_b" contentformat 0 payload "vwc=28.9"
}

compile {
    report_bed_a(soil_probe_a, irrigation_gw)
    report_bed_b(soil_probe_b, irrigation_gw)
}
