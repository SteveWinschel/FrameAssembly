// PROMPT: RFC 7641 CoAP Observe periodic temperature notifications in a loop with WAIT delays.
// TOKENS: HOST, IP, FLOW, COAP, NON, CODE, MSGID, TOKEN, URI_PATH, CONTENT_FORMAT, PAYLOAD, WAIT, COMPILE, LOOP

// INSTRUCTION: Define CoAP dashboard observer client.
HOST dash_observer { IP 10.22.0.10 }

// INSTRUCTION: Define CoAP environmental probe server.
HOST probe_srv { IP 10.22.0.99 }

// INSTRUCTION: Push periodic NON 2.05 Content notifications sharing the observer token.
FLOW coap_observe_tick(obs, srv) {
    obs <- srv COAP NON CODE "2.05" MSGID 6100 TOKEN 0xabcd URI_PATH "env/temp" CONTENT_FORMAT 0 PAYLOAD "23.4 C" WAIT 250ms
}

// INSTRUCTION: Loop the CoAP observer notification 5 times.
COMPILE {
    LOOP 5 {
        coap_observe_tick(dash_observer, probe_srv)
    }
}
