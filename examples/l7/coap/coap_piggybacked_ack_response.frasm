// CoAP acknowledgment (ACK) response with content payload over IPv6.
// Wireshark: coap

host client { ip 2001:db8::25 }

host server { ip 2001:db8::1 }

// CoAP over UDP 5683: codes 2.05 (Content).
flow coap_ack(c, s) {
    c <- s coap ack code "2.05" msgid 101
}

compile {
    coap_ack(client, server)
}
