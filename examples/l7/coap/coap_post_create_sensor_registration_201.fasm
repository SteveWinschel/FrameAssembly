// PROMPT: CoAP Confirmable POST request registering a new LwM2M endpoint and receiving 2.01 Created.
// TOKENS: HOST, IP, MAC, FLOW, COAP, CON, CODE, MSGID, TOKEN, URI_PATH, CONTENT_FORMAT, PAYLOAD, ACK, COMPILE

// INSTRUCTION: Define the LwM2M cellular IoT sensor node.
HOST lwm2m_client {
    IP 10.110.1.50
    MAC 00:1a:2b:6e:01:50
}

// INSTRUCTION: Define the LwM2M device management server.
HOST lwm2m_server {
    IP 10.110.1.1
    MAC 00:1a:2b:6e:01:01
}

// INSTRUCTION: Send a Confirmable POST to /rd with Link-Format payload (Content-Format 40) and receive 2.01 Created.
FLOW coap_lwm2m_register(c, s) {
    c -> s COAP CON CODE "0.02" MSGID 1010 TOKEN 5001 URI_PATH "rd" CONTENT_FORMAT 40 PAYLOAD "</3/0>,</3303/0>"
    c <- s COAP ACK CODE "2.01" MSGID 1010 TOKEN 5001 URI_PATH "rd"
}

// INSTRUCTION: Compile the CoAP LwM2M registration POST flow.
COMPILE {
    coap_lwm2m_register(lwm2m_client, lwm2m_server)
}
