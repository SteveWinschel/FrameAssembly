// CoAP Confirmable POST request registering a new LwM2M endpoint and
// receiving 2.01 Created.
// Wireshark: coap

// LwM2M cellular IoT sensor node.
host lwm2m_client {
    ip 10.110.1.50
    mac 00:1a:2b:6e:01:50
}

host lwm2m_server {
    ip 10.110.1.1
    mac 00:1a:2b:6e:01:01
}

// Send a Confirmable POST to /rd with Link-Format payload (Content-Format 40)
// and receive 2.01 Created. CoAP over UDP 5683: codes 0.02 (POST), 2.01
// (Created); content-format 40 (application/link-format).
flow coap_lwm2m_register(c, s) {
    c -> s coap con code "0.02" msgid 1010 token 5001 uripath "rd" contentformat 40 payload "</3/0>,</3303/0>"
    c <- s coap ack code "2.01" msgid 1010 token 5001 uripath "rd"
}

compile {
    coap_lwm2m_register(lwm2m_client, lwm2m_server)
}
