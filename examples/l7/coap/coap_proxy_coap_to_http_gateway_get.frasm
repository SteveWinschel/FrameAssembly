// IoT sensor querying an external weather forecast API through a CoAP-to-HTTP
// cross-protocol proxy.
// Wireshark: coap

// Constrained irrigation controller requesting forecast data.
host smart_sprinkler {
    ip 10.110.130.30
    mac 00:1a:2b:6e:d0:30
}

// Border CoAP-to-HTTP reverse proxy gateway.
host cross_proxy {
    ip 10.110.130.1
    mac 00:1a:2b:6e:d0:01
}

// Issue CON GET to /proxy/forecast and receive JSON precipitation
// probability. CoAP over UDP 5683: codes 0.01 (GET), 2.05 (Content);
// content-format 50 (application/json).
flow coap_cross_proxy(c, p) {
    c -> p coap con code "0.01" msgid 13100 token 710 uripath "proxy/forecast/rain_prob"
    c <- p coap ack code "2.05" msgid 13100 token 710 contentformat 50 payload "{'rain_prob_pct':85}"
}

compile {
    coap_cross_proxy(smart_sprinkler, cross_proxy)
}
