// CoAP smart metering uplink over MPLS and QinQ carrier transport.
// Wireshark: coap

// Residential smart electric meter.
host smart_meter { ip 100.64.10.55 }

// Utility head-end CoAP concentrator.
host utility_hes { ip 100.64.0.1 }

// Report kWh meter reading over QinQ and MPLS backhaul. Encapsulation and QoS
// markings: 802.1ad QinQ S-VLAN 2000 / C-VLAN 105, MPLS label 8080. CoAP over
// UDP 5683: codes 0.02 (POST), 2.04 (Changed).
flow coap_ami_backhaul(m, h) {
    m -> h coap con code "0.02" msgid 7700 token 0x9001 uripath "ami/kwh" qinq 2000 innervlan 105 mpls 8080 payload "14820.5"
    m <- h coap ack code "2.04" msgid 7700 token 0x9001 qinq 2000 innervlan 105 mpls 8080
}

compile {
    coap_ami_backhaul(smart_meter, utility_hes)
}
