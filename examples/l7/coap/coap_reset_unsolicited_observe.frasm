// PROMPT: CoAP Reset (RST) message rejecting an unrecognized non-confirmable observer notification.
// TOKENS: host, ip, flow, s, coap, non, code, msgid, token, uripath, rst, compile

// INSTRUCTION: Define rebooted CoAP client node.
host coap_client { ip 192.168.70.20 }

// INSTRUCTION: Define CoAP observable temperature server.
host temp_server { ip 192.168.70.5 }

// INSTRUCTION: Server pushes stale observer update; client replies with CoAP RST matching MSGID.
flow coap_rst_reject(c, s) {
    c <- s coap non code "2.05" msgid 8821 token 0x1122 uripath "temp"
    c -> s coap rst code "0.00" msgid 8821
}

// INSTRUCTION: Compile the CoAP observer RST cancellation flow.
compile {
    coap_rst_reject(coap_client, temp_server)
}
