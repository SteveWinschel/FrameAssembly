// CoAP Reset (RST) message rejecting an unrecognized non-confirmable observer
// notification.
// Wireshark: coap

host coap_client { ip 192.168.70.20 }

host temp_server { ip 192.168.70.5 }

// Server pushes stale observer update; client replies with CoAP RST matching
// MSGID. CoAP over UDP 5683: codes 2.05 (Content), 0.00 (Empty).
flow coap_rst_reject(c, s) {
    c <- s coap non code "2.05" msgid 8821 token 0x1122 uripath "temp"
    c -> s coap rst code "0.00" msgid 8821
}

compile {
    coap_rst_reject(coap_client, temp_server)
}
