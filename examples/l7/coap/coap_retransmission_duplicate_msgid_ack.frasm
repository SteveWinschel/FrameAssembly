// CoAP Confirmable request retransmission with identical MSGID and TOKEN
// after a simulated loss timeout.
// Wireshark: coap

host solar_inverter {
    ip 10.110.50.25
    mac 00:1a:2b:6e:50:25
}

// Microgrid CoAP collector.
host microgrid_collector {
    ip 10.110.50.1
    mac 00:1a:2b:6e:50:01
}

// Transmit initial CON POST, wait 20ms for ACK_TIMEOUT, retransmit identical
// MSGID 6200, and receive ACK. CoAP over UDP 5683: codes 0.02 (POST), 2.04
// (Changed); content-format 50 (application/json).
flow coap_retransmit(c, s) {
    c -> s coap con code "0.02" msgid 6200 token 812 uripath "grid/kw" contentformat 50 payload "{'kw':4.82}" wait 20ms
    c -> s coap con code "0.02" msgid 6200 token 812 uripath "grid/kw" contentformat 50 payload "{'kw':4.82}"
    c <- s coap ack code "2.04" msgid 6200 token 812
}

compile {
    coap_retransmit(solar_inverter, microgrid_collector)
}
