// PROMPT: CoAP over custom UDP port 5684 with SenML JSON payload and DSCP Expedited Forwarding.
// TOKENS: host, ip, flow, m, coap, con, code, msgid, token, uripath, contentformat, srcport, dstport, dscp, df, payload, ack, compile

// INSTRUCTION: Define medical wearable CoAP monitor.
host med_monitor { ip 172.28.4.12 }

// INSTRUCTION: Define hospital ward CoAP gateway.
host ward_gw { ip 172.28.4.1 }

// INSTRUCTION: Send high-priority SenML JSON vital signs (Content-Format 110) with DSCP 46.
flow coap_medical_vitals(m, g) {
    m -> g coap con code "0.02" msgid 999 token 0xbeef uripath "vitals/hr" contentformat 110 srcport 49200 dstport 5684 dscp 46 df payload "[{\"n\":\"hr\",\"v\":72}]"
    m <- g coap ack code "2.01" msgid 999 token 0xbeef srcport 5684 dstport 49200 dscp 46 df
}

// INSTRUCTION: Compile the medical telemetry CoAP exchange.
compile {
    coap_medical_vitals(med_monitor, ward_gw)
}
