// CoAP Separate Response pattern with empty ACK followed by asynchronous CON
// response.
// Wireshark: coap

// CoAP client requesting slow cryptographic signing operation.
host sign_client { ip 10.44.1.10 }

// Hardware security CoAP node.
host hsm_node { ip 10.44.1.2 }

// Client sends CON request; server sends empty ACK, computes result, then
// sends CON 2.05. CoAP over UDP 5683: codes 0.02 (POST), 0.00 (Empty), 2.05
// (Content). Uses post-packet wait timing (50ms, 200ms) to space follow-up
// packets.
flow coap_separate_response(c, h) {
    c -> h coap con code "0.02" msgid 1100 token 0x4455 uripath "crypto/sign" payload "digest_01"
    c <- h coap ack code "0.00" msgid 1100 wait 50ms
    c <- h coap con code "2.05" msgid 1101 token 0x4455 payload "sig_verified" wait 200ms
    c -> h coap ack code "0.00" msgid 1101
}

compile {
    coap_separate_response(sign_client, hsm_node)
}
