// PROMPT: Simulate a branch office DHCP lease transaction transported across an MPLS enterprise WAN (label 6700).
// TOKENS: host, ip, mac, flow, s, dhcp, request, xid, ciaddr, yiaddr, chaddr, hostname, mpls, exp, bos, mplsttl, wait, ms, ack, subnetmask, router, dnsserver, leasetime, compile

// INSTRUCTION: Define the DHCP client endpoint requesting dynamic network configuration.
host dhcp_client {
    ip 10.140.20.15
    mac 00:25:90:67:01:0a
}

// INSTRUCTION: Define the DHCP server or relay agent endpoint.
host dhcp_server {
    ip 10.140.0.10
    mac 00:25:90:67:01:01
}

// INSTRUCTION: Execute the DHCP address assignment and option negotiation flow.
flow dhcp_scenario_flow(c, s) {
    c -> s dhcp request xid 0x31001004 ciaddr 10.140.20.15 yiaddr 10.140.20.15 chaddr 00:1c:42:8c:14:0f hostname "branch-pos-03" mpls 6700 exp 4 bos 1 mplsttl 64 wait 6ms
    c <- s dhcp ack xid 0x31001004 ciaddr 10.140.20.15 yiaddr 10.140.20.15 subnetmask 255.255.255.0 router 10.140.20.1 dnsserver 10.140.0.53 leasetime 43200 mpls 6700 exp 4 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the DHCP provisioning scenario into a PCAP file.
compile {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
