// PROMPT: Broadband subscriber DHCPv4 acquisition over IEEE 802.1ad QinQ S-VLAN 1200 and C-VLAN 25.
// TOKENS: host, ip, flow, dhcp, discover, chaddr, qinq, innervlan, offer, yiaddr, router, dnsserver, subnetmask, leasetime, compile

// INSTRUCTION: Define residential CPE router.
host cpe_router { ip 0.0.0.0 }

// INSTRUCTION: Define BNG broadband network gateway DHCP server.
host bng_server { ip 100.64.0.1 }

// INSTRUCTION: Exchange QinQ double-tagged DHCP Discover and Offer frames.
flow dhcp_bng_qinq(cpe, bng) {
    cpe -> bng dhcp discover chaddr 3c:fd:fe:90:12:34 qinq 1200 innervlan 25
    cpe <- bng dhcp offer chaddr 3c:fd:fe:90:12:34 yiaddr 100.64.25.10 router 100.64.0.1 dnsserver 8.8.4.4 subnetmask 255.255.0.0 leasetime 3600 qinq 1200 innervlan 25
}

// INSTRUCTION: Compile the broadband QinQ DHCP flow.
compile {
    dhcp_bng_qinq(cpe_router, bng_server)
}
