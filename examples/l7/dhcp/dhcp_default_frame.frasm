// DHCPv4 starter packet on UDP ports 68 -> 67 using built-in defaults. Emits
// a broadcast DHCP Discover frame (xid 0x12345678) by default.
// Wireshark: dhcp

host pxe_client {
    ip 0.0.0.0
    mac 00:0c:29:4f:8e:11
}

host bcast_target {
    ip 255.255.255.255
    mac ff:ff:ff:ff:ff:ff
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    pxe_client -> bcast_target dhcp
}
