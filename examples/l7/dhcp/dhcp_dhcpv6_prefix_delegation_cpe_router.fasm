// PROMPT: Model a residential fiber CPE gateway requesting an IPv6 prefix via DHCPv6 SOLICIT, ADVERTISE, REQUEST, and REPLY.
// TOKENS: HOST, IP, MAC, FLOW, DHCP, SOLICIT, XID, HOSTNAME, TTL, WAIT, ADVERTISE, YIADDR, DNS_SERVER, LEASE_TIME, REQUEST, REPLY, COMPILE

// INSTRUCTION: Define the DHCP client endpoint requesting dynamic network configuration.
HOST dhcp_client {
    IP fe80::224:e8ff:fe54:6001
    MAC 00:25:90:67:01:0a
}

// INSTRUCTION: Define the DHCP server or relay agent endpoint.
HOST dhcp_server {
    IP fe80::224:e8ff:fe54:1
    MAC 00:25:90:67:01:01
}

// INSTRUCTION: Execute the DHCP address assignment and option negotiation flow.
FLOW dhcp_scenario_flow(c, s) {
    c -> s DHCP SOLICIT XID 0x00546010 HOSTNAME "home-rgw-v6" TTL 64 WAIT 5ms
    c <- s DHCP ADVERTISE XID 0x00546010 YIADDR 2001:db8:cafe::1 DNS_SERVER 2001:4860:4860::8888 LEASE_TIME 86400 TTL 64 WAIT 5ms
    c -> s DHCP REQUEST XID 0x00546010 HOSTNAME "home-rgw-v6" TTL 64 WAIT 5ms
    c <- s DHCP REPLY XID 0x00546010 YIADDR 2001:db8:cafe::1 DNS_SERVER 2001:4860:4860::8888 LEASE_TIME 86400 TTL 64
}

// INSTRUCTION: Compile the DHCP provisioning scenario into a PCAP file.
COMPILE {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
