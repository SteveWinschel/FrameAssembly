// PROMPT: Unanswered DHCPv4 DISCOVER retransmission backoff loop when no DHCP server is reachable.
// TOKENS: host, ip, flow, dhcp, discover, chaddr, hostname, wait, s, compile

// INSTRUCTION: Define isolated client attempting to acquire an IPv4 lease.
host isolated_node { ip 0.0.0.0 }

// INSTRUCTION: Define local subnet broadcast address.
host local_bcast { ip 255.255.255.255 }

// INSTRUCTION: Broadcast DHCPDISCOVER with 2-second retry timeout.
flow dhcp_retry_discover(c, b) {
    c -> b dhcp discover chaddr 00:16:3e:77:66:55 hostname "kiosk-01" wait 2s
}

// INSTRUCTION: Execute 4 DHCPDISCOVER retransmission attempts.
compile {
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 1
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 2
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 3
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 4
}
