// Unanswered DHCPv4 DISCOVER retransmission backoff loop when no DHCP server
// is reachable.
// Wireshark: dhcp

// Isolated client attempting to acquire an IPv4 lease.
host isolated_node { ip 0.0.0.0 }

// Local subnet broadcast address.
host local_bcast { ip 255.255.255.255 }

// Broadcast DHCPDISCOVER with 2-second retry timeout. DHCPv4 BOOTP exchange
// over UDP ports 68 (client) and 67 (server). Repeats 4 times; each wait
// value pauses after sending its packet.
flow dhcp_retry_discover(c, b) {
    c -> b dhcp discover chaddr 00:16:3e:77:66:55 hostname "kiosk-01" wait 2s
}

// Four DHCPDISCOVER retransmission attempts.
compile {
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 1
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 2
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 3
    dhcp_retry_discover(isolated_node, local_bcast) // cycle 4
}
