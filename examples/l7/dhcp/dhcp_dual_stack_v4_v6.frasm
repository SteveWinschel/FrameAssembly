// Dual-stack dynamic host configuration with DHCPv4 Discover (68->67) and
// DHCPv6 Solicit (546->547).
// Wireshark: dhcp || dhcpv6

host dhcp_v4_client { ip 0.0.0.0 }

host dhcp_v4_server { ip 255.255.255.255 }

host dhcp_v6_client { ip fe80::10 }

host dhcp_v6_server { ip ff02::1:2 }

// Dual-stack DHCP configuration flow. Runs the same flow definition over both
// IPv4 and IPv6 host pairs.
flow dhcp_dual_flow(c4, s4, c6, s6) {
    c4 -> s4 dhcp discover
    c6 -> s6 dhcp solicit
}

compile {
    dhcp_dual_flow(dhcp_v4_client, dhcp_v4_server, dhcp_v6_client, dhcp_v6_server)
}
