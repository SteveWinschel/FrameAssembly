// Full 4-step DHCPv4 DORA lease exchange on VLAN 20 (UDP ports 68 and 67).
// Uses direct 2-block host + compile ordering with post-packet wait gaps.
// Assigns 10.20.20.115/24 for 8 hours (28800s) with gateway and DNS options.
// Wireshark: dhcp

host branch_laptop {
    ip 0.0.0.0
    mac 3c:22:fb:20:04:15
}

host dhcp_srv {
    ip 10.20.20.1
    mac 00:0c:29:20:20:01
}

// Discover -> Offer -> Request -> Ack on 802.1Q VLAN 20.
compile {
    branch_laptop -> dhcp_srv dhcp discover xid 0x444f5241
        chaddr 3c:22:fb:20:04:15 hostname "branch-laptop-04" vlan 20 wait 5ms
    branch_laptop <- dhcp_srv dhcp offer xid 0x444f5241
        chaddr 3c:22:fb:20:04:15 yiaddr 10.20.20.115 siaddr 10.20.20.1
        subnetmask 255.255.255.0 router 10.20.20.1 dnsserver 10.20.0.53
        leasetime 28800 vlan 20 wait 2ms
    branch_laptop -> dhcp_srv dhcp request xid 0x444f5241
        chaddr 3c:22:fb:20:04:15 yiaddr 10.20.20.115 siaddr 10.20.20.1
        hostname "branch-laptop-04" vlan 20 wait 4ms
    branch_laptop <- dhcp_srv dhcp ack xid 0x444f5241
        chaddr 3c:22:fb:20:04:15 yiaddr 10.20.20.115 siaddr 10.20.20.1
        subnetmask 255.255.255.0 router 10.20.20.1 dnsserver 10.20.0.53
        leasetime 28800 vlan 20
}
