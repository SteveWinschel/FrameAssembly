// Complete 4-step DHCPv4 DORA (Discover, Offer, Request, Ack) address
// assignment lifecycle.
// Wireshark: dhcp

host dora_client { ip 0.0.0.0 }

host dora_server { ip 192.168.10.1 }

// Full 4-way DHCPv4 DORA lease negotiation. DHCPv4 BOOTP exchange over UDP
// ports 68 (client) and 67 (server).
flow dhcp_dora_full(c, s) {
    c -> s dhcp discover chaddr 00:1b:63:84:45:e6
    c <- s dhcp offer chaddr 00:1b:63:84:45:e6 yiaddr 192.168.10.105 siaddr 192.168.10.1 subnetmask 255.255.255.0 router 192.168.10.1 dnsserver 1.1.1.1 leasetime 43200
    c -> s dhcp request chaddr 00:1b:63:84:45:e6 yiaddr 192.168.10.105 siaddr 192.168.10.1
    c <- s dhcp ack chaddr 00:1b:63:84:45:e6 yiaddr 192.168.10.105 siaddr 192.168.10.1 subnetmask 255.255.255.0 router 192.168.10.1 dnsserver 1.1.1.1 leasetime 43200
}

compile {
    dhcp_dora_full(dora_client, dora_server)
}
