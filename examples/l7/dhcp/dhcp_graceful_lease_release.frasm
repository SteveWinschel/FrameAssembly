// PROMPT: Graceful DHCPv4 RELEASE message relinquishing an assigned IPv4 lease upon shutdown.
// TOKENS: host, ip, flow, s, dhcp, release, ciaddr, chaddr, hostname, compile

// INSTRUCTION: Define departing laptop client.
host laptop_client { ip 192.168.42.88 }

// INSTRUCTION: Define wireless LAN DHCP server.
host wlan_dhcp { ip 192.168.42.1 }

// INSTRUCTION: Transmit DHCPRELEASE with client IP and hardware MAC address.
flow dhcp_release_flow(c, s) {
    c -> s dhcp release ciaddr 192.168.42.88 chaddr a4:5e:60:c1:d2:e3 hostname "macbook-pro"
}

// INSTRUCTION: Compile the DHCPv4 lease release scenario.
compile {
    dhcp_release_flow(laptop_client, wlan_dhcp)
}
