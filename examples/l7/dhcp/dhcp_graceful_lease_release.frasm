// Graceful DHCPv4 RELEASE message relinquishing an assigned IPv4 lease upon
// shutdown.
// Wireshark: dhcp

host laptop_client { ip 192.168.42.88 }

host wlan_dhcp { ip 192.168.42.1 }

// Transmit DHCPRELEASE with client IP and hardware MAC address. DHCPv4 BOOTP
// exchange over UDP ports 68 (client) and 67 (server).
flow dhcp_release_flow(c, s) {
    c -> s dhcp release ciaddr 192.168.42.88 chaddr a4:5e:60:c1:d2:e3 hostname "macbook-pro"
}

compile {
    dhcp_release_flow(laptop_client, wlan_dhcp)
}
