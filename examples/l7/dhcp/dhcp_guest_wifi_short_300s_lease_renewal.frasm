// High-turnover airport guest Wi-Fi client renewing a 300-second DHCP lease
// in-place via unicast REQUEST/ACK.
// Wireshark: dhcp

// DHCP client endpoint requesting dynamic network configuration.
host dhcp_client {
    ip 100.64.88.142
    mac 00:25:90:67:01:0a
}

// DHCP server or relay agent endpoint.
host dhcp_server {
    ip 100.64.88.1
    mac 00:25:90:67:01:01
}

flow dhcp_scenario_flow(c, s) {
    c -> s dhcp request xid 0x31001005 ciaddr 100.64.88.142 chaddr 3c:22:fb:58:00:8e hostname "iphone-traveler" wait 3ms
    c <- s dhcp ack xid 0x31001005 ciaddr 100.64.88.142 yiaddr 100.64.88.142 subnetmask 255.255.252.0 router 100.64.88.1 dnsserver 1.1.1.1 leasetime 300
}

compile {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
