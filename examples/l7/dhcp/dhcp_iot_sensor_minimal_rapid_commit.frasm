// Rapid-commit two-message DHCP DISCOVER and immediate ACK exchange for a
// battery-powered IoT sensor.
// Wireshark: dhcp

// DHCP client endpoint requesting dynamic network configuration.
host dhcp_client {
    ip 192.168.44.80
    mac 00:25:90:67:01:0a
}

// DHCP server or relay agent endpoint.
host dhcp_server {
    ip 192.168.44.1
    mac 00:25:90:67:01:01
}

flow dhcp_scenario_flow(c, s) {
    c -> s dhcp discover xid 0x31001003 chaddr 00:17:88:44:00:50 hostname "zigbee-gw-04" wait 2ms
    c <- s dhcp ack xid 0x31001003 yiaddr 192.168.44.80 subnetmask 255.255.255.0 router 192.168.44.1 dnsserver 192.168.44.1 leasetime 86400
}

compile {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
