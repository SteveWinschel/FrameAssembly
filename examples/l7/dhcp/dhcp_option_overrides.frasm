// DHCPv4 ACK frame delivering configuration options including DNS server,
// router gateway, and lease time.
// Wireshark: dhcp

host client { ip 192.168.1.150 }

host server { ip 192.168.1.1 }

// DHCPv4 BOOTP exchange over UDP ports 68 (client) and 67 (server).
flow dhcp_ack(c, s) {
    c <- s dhcp ack chaddr 00:11:22:33:44:55 yiaddr 192.168.1.150 dnsserver 8.8.8.8 router 192.168.1.1 leasetime 86400
}

compile {
    dhcp_ack(client, server)
}
