// PROMPT: Simulate a PXE network boot DHCP DORA exchange assigning YIADDR and pointing SIADDR to a TFTP boot server.
// TOKENS: HOST, IP, MAC, FLOW, DHCP, DISCOVER, XID, CHADDR, HOSTNAME, WAIT, OFFER, YIADDR, SIADDR, SUBNET_MASK, ROUTER, LEASE_TIME, REQUEST, ACK, COMPILE

// INSTRUCTION: Define the DHCP client endpoint requesting dynamic network configuration.
HOST dhcp_client {
    IP 10.67.10.200
    MAC 00:25:90:67:01:0a
}

// INSTRUCTION: Define the DHCP server or relay agent endpoint.
HOST dhcp_server {
    IP 10.67.10.1
    MAC 00:25:90:67:01:01
}

// INSTRUCTION: Execute the DHCP address assignment and option negotiation flow.
FLOW dhcp_scenario_flow(c, s) {
    c -> s DHCP DISCOVER XID 0x31001001 CHADDR 00:25:90:67:10:01 HOSTNAME "pxe-blade-01" WAIT 4ms
    c <- s DHCP OFFER XID 0x31001001 YIADDR 10.67.10.50 SIADDR 10.67.10.5 SUBNET_MASK 255.255.255.0 ROUTER 10.67.10.1 LEASE_TIME 3600 WAIT 4ms
    c -> s DHCP REQUEST XID 0x31001001 YIADDR 10.67.10.50 SIADDR 10.67.10.5 CHADDR 00:25:90:67:10:01 WAIT 4ms
    c <- s DHCP ACK XID 0x31001001 YIADDR 10.67.10.50 SIADDR 10.67.10.5 SUBNET_MASK 255.255.255.0 ROUTER 10.67.10.1 LEASE_TIME 3600
}

// INSTRUCTION: Compile the DHCP provisioning scenario into a PCAP file.
COMPILE {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
