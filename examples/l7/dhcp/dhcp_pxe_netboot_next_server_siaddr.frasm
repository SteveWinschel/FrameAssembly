// PXE network boot DHCP DORA exchange assigning YIADDR and pointing SIADDR to
// a TFTP boot server.
// Wireshark: dhcp

// DHCP client endpoint requesting dynamic network configuration.
host dhcp_client {
    ip 10.67.10.200
    mac 00:25:90:67:01:0a
}

// DHCP server or relay agent endpoint.
host dhcp_server {
    ip 10.67.10.1
    mac 00:25:90:67:01:01
}

flow dhcp_scenario_flow(c, s) {
    c -> s dhcp discover xid 0x31001001 chaddr 00:25:90:67:10:01 hostname "pxe-blade-01" wait 4ms
    c <- s dhcp offer xid 0x31001001 yiaddr 10.67.10.50 siaddr 10.67.10.5 subnetmask 255.255.255.0 router 10.67.10.1 leasetime 3600 wait 4ms
    c -> s dhcp request xid 0x31001001 yiaddr 10.67.10.50 siaddr 10.67.10.5 chaddr 00:25:90:67:10:01 wait 4ms
    c <- s dhcp ack xid 0x31001001 yiaddr 10.67.10.50 siaddr 10.67.10.5 subnetmask 255.255.255.0 router 10.67.10.1 leasetime 3600
}

compile {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
