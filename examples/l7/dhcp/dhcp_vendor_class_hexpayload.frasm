// DHCPv4 DISCOVER with custom vendor class option bytes appended via
// HEXPAYLOAD.
// Wireshark: dhcp

// OpenWRT embedded router WAN interface.
host openwrt_wan { ip 0.0.0.0 }

host isp_dhcp { ip 10.100.0.1 }

// Send DHCPDISCOVER with Option 60 (Vendor Class Identifier "udhcp") in
// HEXPAYLOAD. DHCPv4 BOOTP exchange over UDP ports 68 (client) and 67
// (server).
flow dhcp_vendor_opt60(c, s) {
    c -> s dhcp discover chaddr b8:27:eb:10:20:30 hostname "openwrt-gw" hexpayload "3c057564686370"
    c <- s dhcp offer chaddr b8:27:eb:10:20:30 yiaddr 10.100.4.88
}

compile {
    dhcp_vendor_opt60(openwrt_wan, isp_dhcp)
}
