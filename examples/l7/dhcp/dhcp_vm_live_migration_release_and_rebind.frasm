// Virtual machine releasing its old subnet DHCP lease via RELEASE before
// acquiring a new lease.
// Wireshark: dhcp

// DHCP client endpoint requesting dynamic network configuration.
host dhcp_client {
    ip 10.200.12.75
    mac 00:25:90:67:01:0a
}

// DHCP server or relay agent endpoint.
host dhcp_server {
    ip 10.200.12.1
    mac 00:25:90:67:01:01
}

flow dhcp_scenario_flow(c, s) {
    c -> s dhcp release xid 0x31001009 ciaddr 10.200.12.75 chaddr 00:50:56:c8:0c:4b hostname "vm-app-12" wait 10ms
    c -> s dhcp discover xid 0x31001010 chaddr 00:50:56:c8:0c:4b hostname "vm-app-12" wait 4ms
    c <- s dhcp offer xid 0x31001010 yiaddr 10.200.12.75 subnetmask 255.255.255.0 router 10.200.12.1 dnsserver 10.200.0.53 leasetime 14400 wait 4ms
    c -> s dhcp request xid 0x31001010 yiaddr 10.200.12.75 chaddr 00:50:56:c8:0c:4b wait 4ms
    c <- s dhcp ack xid 0x31001010 yiaddr 10.200.12.75 subnetmask 255.255.255.0 router 10.200.12.1 dnsserver 10.200.0.53 leasetime 14400
}

compile {
    dhcp_scenario_flow(dhcp_client, dhcp_server)
}
