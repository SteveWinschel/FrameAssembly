// PROMPT: DHCPv4 voice VLAN 150 IP phone provisioning with Option 12 hostname and TFTP next-server SIADDR.
// TOKENS: HOST, IP, FLOW, DHCP, DISCOVER, CHADDR, HOSTNAME, VLAN, PCP, DSCP, OFFER, YIADDR, SIADDR, SUBNET_MASK, ROUTER, REQUEST, ACK, COMPILE

// INSTRUCTION: Define VoIP desk phone booting on Voice VLAN 150.
HOST voip_phone { IP 0.0.0.0 }

// INSTRUCTION: Define unified communications DHCP server.
HOST uc_dhcp_srv { IP 10.150.0.1 }

// INSTRUCTION: Provision VoIP phone with SIADDR pointing to TFTP provisioning server on VLAN 150.
FLOW dhcp_voip_vlan(p, s) {
    p -> s DHCP DISCOVER CHADDR 00:04:f2:11:22:33 HOSTNAME "SEP0004F2112233" VLAN 150 PCP 5 DSCP 46
    p <- s DHCP OFFER CHADDR 00:04:f2:11:22:33 YIADDR 10.150.0.45 SIADDR 10.150.0.10 SUBNET_MASK 255.255.255.0 ROUTER 10.150.0.1 VLAN 150 PCP 5 DSCP 46
    p -> s DHCP REQUEST CHADDR 00:04:f2:11:22:33 YIADDR 10.150.0.45 SIADDR 10.150.0.10 HOSTNAME "SEP0004F2112233" VLAN 150 PCP 5 DSCP 46
    p <- s DHCP ACK CHADDR 00:04:f2:11:22:33 YIADDR 10.150.0.45 SIADDR 10.150.0.10 SUBNET_MASK 255.255.255.0 ROUTER 10.150.0.1 VLAN 150 PCP 5 DSCP 46
}

// INSTRUCTION: Compile the VoIP VLAN DHCP provisioning sequence.
COMPILE {
    dhcp_voip_vlan(voip_phone, uc_dhcp_srv)
}
