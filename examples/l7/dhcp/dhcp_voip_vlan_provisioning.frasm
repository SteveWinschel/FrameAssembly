// DHCPv4 voice VLAN 150 IP phone provisioning with Option 12 hostname and
// TFTP next-server SIADDR.
// Wireshark: dhcp

// VoIP desk phone booting on Voice VLAN 150.
host voip_phone { ip 0.0.0.0 }

host uc_dhcp_srv { ip 10.150.0.1 }

// Provision VoIP phone with SIADDR pointing to TFTP provisioning server on
// VLAN 150. Encapsulation and QoS markings: 802.1Q VLAN 150, DSCP 46. DHCPv4
// BOOTP exchange over UDP ports 68 (client) and 67 (server).
flow dhcp_voip_vlan(p, s) {
    p -> s dhcp discover chaddr 00:04:f2:11:22:33 hostname "SEP0004F2112233" vlan 150 pcp 5 dscp 46
    p <- s dhcp offer chaddr 00:04:f2:11:22:33 yiaddr 10.150.0.45 siaddr 10.150.0.10 subnetmask 255.255.255.0 router 10.150.0.1 vlan 150 pcp 5 dscp 46
    p -> s dhcp request chaddr 00:04:f2:11:22:33 yiaddr 10.150.0.45 siaddr 10.150.0.10 hostname "SEP0004F2112233" vlan 150 pcp 5 dscp 46
    p <- s dhcp ack chaddr 00:04:f2:11:22:33 yiaddr 10.150.0.45 siaddr 10.150.0.10 subnetmask 255.255.255.0 router 10.150.0.1 vlan 150 pcp 5 dscp 46
}

compile {
    dhcp_voip_vlan(voip_phone, uc_dhcp_srv)
}
