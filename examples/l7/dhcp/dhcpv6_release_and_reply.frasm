// DHCPv6 lease release and server reply confirmation over link-local IPv6
// addresses.
// Wireshark: dhcpv6

// Link-local IPv6 container host releasing its address.
host container_v6 { ip fe80::a00:27ff:fe44:5566 }

host server_v6 { ip fe80::1:1 }

// Send DHCPv6 RELEASE (type 8) and receive DHCPv6 REPLY (type 7). DHCPv6
// stateful exchange over UDP ports 546 (client) and 547 (server).
flow dhcpv6_release_flow(c, s) {
    c -> s dhcp release flowlabel 0x05460 ttl 64
    c <- s dhcp reply flowlabel 0x05470 ttl 64
}

compile {
    dhcpv6_release_flow(container_v6, server_v6)
}
