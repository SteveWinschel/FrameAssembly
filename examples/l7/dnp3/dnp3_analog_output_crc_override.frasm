// PROMPT: DNP3 Analog Output setpoint command (Group 41 Variation 2) with explicit CRC override.
// TOKENS: host, ip, flow, m, dnp3, func, src, dst, group, variation, crc, payload, compile

// INSTRUCTION: Define hydro generation dispatch master.
host hydro_master { ip 172.30.5.1 }

// INSTRUCTION: Define turbine governor PLC outstation.
host turbine_plc { ip 172.30.5.20 }

// INSTRUCTION: Issue Direct Operate on Analog Output Block (Group 41 Var 2) with custom CRC.
flow dnp3_analog_setpoint(m, p) {
    m -> p dnp3 func "directoperate" src 10 dst 20 group 41 variation 2 crc 0xe5a2 payload "\x00\x00\x01\xf4\x00"
    m <- p dnp3 func "response" src 20 dst 10 group 41 variation 2 crc 0x91c4
}

// INSTRUCTION: Compile the DNP3 analog output governor setpoint flow.
compile {
    dnp3_analog_setpoint(hydro_master, turbine_plc)
}
