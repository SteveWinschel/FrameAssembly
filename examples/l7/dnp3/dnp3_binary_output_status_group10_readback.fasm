// PROMPT: DNP3 Group 10 Variation 2 (Binary Output Status) read verifying capacitor bank switch states.
// TOKENS: HOST, IP, MAC, FLOW, DNP3, FUNC, SRC, DST, GROUP, VARIATION, WAIT, COMPILE

// INSTRUCTION: Define the Volt-VAR Optimization (VVO) controller master.
HOST vvo_master {
    IP 10.125.30.1
    MAC 00:1a:2b:7d:30:01
}

// INSTRUCTION: Define the feeder capacitor bank RTU outstation.
HOST capbank_rtu {
    IP 10.125.30.33
    MAC 00:1a:2b:7d:30:33
}

// INSTRUCTION: Poll Binary Output Status (Group 10 Var 2) and execute Direct Operate (Group 12 Var 1) to switch bank online.
FLOW dnp3_capbank_vvo(m, c) {
    m -> c DNP3 FUNC "READ" SRC 1 DST 33 GROUP 10 VARIATION 2
    m <- c DNP3 FUNC "RESPONSE" SRC 33 DST 1 GROUP 10 VARIATION 2 WAIT 2ms
    m -> c DNP3 FUNC "DIRECT_OPERATE" SRC 1 DST 33 GROUP 12 VARIATION 1
    m <- c DNP3 FUNC "RESPONSE" SRC 33 DST 1 GROUP 12 VARIATION 1
}

// INSTRUCTION: Compile the DNP3 Volt-VAR capacitor bank control flow.
COMPILE {
    dnp3_capbank_vvo(vvo_master, capbank_rtu)
}
