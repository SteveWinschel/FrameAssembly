// PROMPT: DNP3 Integrity Poll reading Class 0 static data (Group 60 Variation 1) after TCP 3-way handshake.
// TOKENS: host, ip, flow, m, tcp, syn, srcport, dstport, ack, dnp3, func, src, dst, group, variation, compile

// INSTRUCTION: Define utility EMS master host.
host ems_master { ip 192.168.200.1 }

// INSTRUCTION: Define substation bay controller RTU.
host bay_rtu { ip 192.168.200.25 }

// INSTRUCTION: Establish TCP connection on port 20000 and issue Class 0 integrity poll.
flow dnp3_class0_integrity(m, r) {
    m -> r tcp syn srcport 52100 dstport 20000
    m <- r tcp syn ack
    m -> r tcp ack
    m -> r dnp3 func "read" src 1 dst 25 group 60 variation 1
    m <- r dnp3 func "response" src 25 dst 1 group 30 variation 1
}

// INSTRUCTION: Compile the DNP3 TCP handshake and Class 0 integrity poll.
compile {
    dnp3_class0_integrity(ems_master, bay_rtu)
}
