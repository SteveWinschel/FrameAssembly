// PROMPT: DNP3 over TCP port 20001 addressing a legacy serial RS-485 RTU behind a substation terminal server.
// TOKENS: host, ip, mac, flow, srcport, dstport, dnp3, func, src, dst, group, variation, crc, compile

// INSTRUCTION: Define the central SCADA front-end processor (FEP).
host scada_fep {
    ip 10.125.110.1
    mac 00:1a:2b:7d:b0:01
}

// INSTRUCTION: Define the RS-485 terminal server listening on TCP port 20001.
host term_server {
    ip 10.125.110.25
    mac 00:1a:2b:7d:b0:25
}

// INSTRUCTION: Poll static analog inputs (Group 30 Var 1) on outstation address 4 via TCP port 20001.
flow dnp3_port_20001(f, t) {
    f -> t srcport 51200 dstport 20001 dnp3 func "read" src 1 dst 4 group 30 variation 1
    f <- t srcport 20001 dstport 51200 dnp3 func "response" src 4 dst 1 group 30 variation 1 crc 46458
}

// INSTRUCTION: Compile the custom port 20001 terminal server DNP3 flow.
compile {
    dnp3_port_20001(scada_fep, term_server)
}
