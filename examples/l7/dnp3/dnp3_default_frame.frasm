// PROMPT: Default IEEE 1815 DNP3 frame emission on TCP port 20000 with automatic link-layer CRC.
// TOKENS: host, ip, mac, flow, m, dnp3, compile

// INSTRUCTION: Define SCADA master station host.
host scada_master {
    ip 10.200.1.10
    mac 00:0e:8c:10:00:01
}

// INSTRUCTION: Define remote terminal unit (RTU) outstation.
host rtu_outstation {
    ip 10.200.1.50
    mac 00:0e:8c:10:00:50
}

// INSTRUCTION: Emit a default DNP3 frame with smart protocol defaults.
flow dnp3_default(m, o) {
    m -> o dnp3
}

// INSTRUCTION: Compile the default DNP3 frame scenario.
compile {
    dnp3_default(scada_master, rtu_outstation)
}
