// DNP3 SCADA starter packet on TCP port 20000 using built-in defaults.
// Omitting extra keywords emits a 15-byte Class 0 Read frame (Group 60 Var 1)
// with CRC-16.
// Wireshark: dnp3

host scada_master {
    ip 10.200.1.10
    mac 00:0e:8c:10:00:01
}

host rtu_outstation {
    ip 10.200.1.50
    mac 00:0e:8c:10:00:50
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    scada_master -> rtu_outstation dnp3
}
