// DNP3 SCADA direct operate command pulsing substation breaker relay over
// IPv6.
// Wireshark: dnp3

host client { ip 2001:db8::10 }

host server { ip 2001:db8::20 }

// DNP3 data groups: Group 12 (CROB Control Relay).
flow dnp3_operate(c, s) {
    c -> s dnp3 func "directoperate" src 10 dst 20 group 12 variation 1
}

compile {
    dnp3_operate(client, server)
}
