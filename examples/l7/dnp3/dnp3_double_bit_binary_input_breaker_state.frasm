// DNP3 Group 3 Variation 2 (Double-Bit Binary Input) read monitoring
// high-voltage disconnect switch intermediate states.
// Wireshark: dnp3

// Transmission control center master station.
host trans_master {
    ip 10.125.10.1
    mac 00:1a:2b:7d:10:01
}

// 230kV switchyard bay controller outstation.
host switchyard_ied {
    ip 10.125.10.23
    mac 00:1a:2b:7d:10:23
}

// Poll Group 3 Variation 2 Double-Bit Binary Inputs and receive breaker
// closed state (0b10). DNP3 data groups: Group 3 (Object).
flow dnp3_double_bit_input(m, i) {
    m -> i dnp3 func "read" src 1 dst 23 group 3 variation 2
    m <- i dnp3 func "response" src 23 dst 1 group 3 variation 2 hexpayload "00038102"
}

compile {
    dnp3_double_bit_input(trans_master, switchyard_ied)
}
