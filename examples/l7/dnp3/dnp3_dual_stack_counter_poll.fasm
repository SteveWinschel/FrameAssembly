// PROMPT: Dual-stack DNP3 Counter object freeze and read (Group 20 Variation 1) over IPv4 and IPv6.
// TOKENS: host, ip, flow, m, dnp3, func, src, dst, group, variation, compile

// INSTRUCTION: Define IPv4 SCADA master.
host master_v4 { ip 10.210.1.1 }

// INSTRUCTION: Define IPv4 substation meter RTU.
host meter_rtu_v4 { ip 10.210.1.30 }

// INSTRUCTION: Define IPv6 SCADA master.
host master_v6 { ip 2001:db8:2000::1 }

// INSTRUCTION: Define IPv6 substation meter RTU.
host meter_rtu_v6 { ip 2001:db8:2000::30 }

// INSTRUCTION: Read 32-bit binary counters (Group 20 Variation 1) and return response.
flow dnp3_counter_poll(m, r) {
    m -> r dnp3 func "read" src 1 dst 30 group 20 variation 1
    m <- r dnp3 func "response" src 30 dst 1 group 20 variation 1
}

// INSTRUCTION: Execute the polymorphic DNP3 counter flow over IPv4 and IPv6.
compile {
    dnp3_counter_poll(master_v4, meter_rtu_v4)
    dnp3_counter_poll(master_v6, meter_rtu_v6)
}
