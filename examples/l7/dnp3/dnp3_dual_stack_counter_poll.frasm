// Dual-stack DNP3 Counter object freeze and read (Group 20 Variation 1) over
// IPv4 and IPv6.
// Wireshark: dnp3

// IPv4 SCADA master.
host master_v4 { ip 10.210.1.1 }

// IPv4 substation meter RTU.
host meter_rtu_v4 { ip 10.210.1.30 }

// IPv6 SCADA master.
host master_v6 { ip 2001:db8:2000::1 }

// IPv6 substation meter RTU.
host meter_rtu_v6 { ip 2001:db8:2000::30 }

// Read 32-bit binary counters (Group 20 Variation 1) and return response.
// Runs the same flow definition over both IPv4 and IPv6 host pairs. DNP3 data
// groups: Group 20 (Counter).
flow dnp3_counter_poll(m, r) {
    m -> r dnp3 func "read" src 1 dst 30 group 20 variation 1
    m <- r dnp3 func "response" src 30 dst 1 group 20 variation 1
}

compile {
    dnp3_counter_poll(master_v4, meter_rtu_v4)
    dnp3_counter_poll(master_v6, meter_rtu_v6)
}
