// PROMPT: DNP3 Group 32 Variation 5 (32-bit Floating-Point Analog Change Event) reporting transformer oil temperature.
// TOKENS: host, ip, mac, flow, m, dnp3, func, src, dst, group, variation, hexpayload, compile

// INSTRUCTION: Define the substation asset health monitoring master.
host asset_master {
    ip 10.125.50.1
    mac 00:1a:2b:7d:50:01
}

// INSTRUCTION: Define the dissolved gas and thermal transformer monitor RTU.
host xfmr_monitor {
    ip 10.125.50.45
    mac 00:1a:2b:7d:50:45
}

// INSTRUCTION: Poll Group 32 Variation 5 single-precision float analog events from outstation 45.
flow dnp3_float_analog_events(m, x) {
    m -> x dnp3 func "read" src 1 dst 45 group 32 variation 5
    m <- x dnp3 func "response" src 45 dst 1 group 32 variation 5 hexpayload "0100009a42"
}

// INSTRUCTION: Compile the DNP3 Group 32 Variation 5 float analog event flow.
compile {
    dnp3_float_analog_events(asset_master, xfmr_monitor)
}
