// DNP3 Group 32 Variation 5 (32-bit Floating-Point Analog Change Event)
// reporting transformer oil temperature.
// Wireshark: dnp3

// Substation asset health monitoring master.
host asset_master {
    ip 10.125.50.1
    mac 00:1a:2b:7d:50:01
}

// Dissolved gas and thermal transformer monitor RTU.
host xfmr_monitor {
    ip 10.125.50.45
    mac 00:1a:2b:7d:50:45
}

// Poll Group 32 Variation 5 single-precision float analog events from
// outstation 45. DNP3 data groups: Group 32 (Analog Input Event).
flow dnp3_float_analog_events(m, x) {
    m -> x dnp3 func "read" src 1 dst 45 group 32 variation 5
    m <- x dnp3 func "response" src 45 dst 1 group 32 variation 5 hexpayload "0100009a42"
}

compile {
    dnp3_float_analog_events(asset_master, xfmr_monitor)
}
