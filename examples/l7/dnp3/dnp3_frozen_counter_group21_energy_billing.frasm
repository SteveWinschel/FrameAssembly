// DNP3 Group 21 Variation 1 (32-bit Frozen Counter with Flag) read for
// substation revenue metering.
// Wireshark: dnp3

// Utility energy settlement SCADA master.
host settlement_master {
    ip 10.125.1.1
    mac 00:1a:2b:7d:01:01
}

// Substation revenue meter RTU outstation.
host meter_rtu {
    ip 10.125.1.50
    mac 00:1a:2b:7d:01:50
}

// Read Frozen Counters (Group 21 Variation 1) from outstation address 50 and
// receive RESPONSE. DNP3 data groups: Group 21 (Frozen Counter).
flow dnp3_frozen_counters(m, o) {
    m -> o dnp3 func "read" src 1 dst 50 group 21 variation 1
    m <- o dnp3 func "response" src 50 dst 1 group 21 variation 1 payload "MWH_EXPORT_FROZEN_104920"
}

compile {
    dnp3_frozen_counters(settlement_master, meter_rtu)
}
