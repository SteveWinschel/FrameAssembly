// IPv6 DNP3 microgrid controller commanding point-of-common-coupling (PCC)
// breaker open for islanding.
// Wireshark: dnp3

// Campus microgrid master controller over IPv6.
host microgrid_master {
    ip 2001:db8:125:100::1
    mac 00:1a:2b:7d:a0:01
}

// PCC interconnection relay outstation over IPv6.
host pcc_relay {
    ip 2001:db8:125:100::10
    mac 00:1a:2b:7d:a0:10
}

// Command PCC breaker open via Direct Operate and read binary status
// confirmation over IPv6. DNP3 data groups: Group 1 (Binary Input), Group 12
// (CROB Control Relay).
flow dnp3_ipv6_island(m, r) {
    m -> r dnp3 func "directoperate" src 1 dst 10 group 12 variation 1
    m <- r dnp3 func "response" src 10 dst 1 group 12 variation 1 wait 1ms
    m -> r dnp3 func "read" src 1 dst 10 group 1 variation 2
    m <- r dnp3 func "response" src 10 dst 1 group 1 variation 2
}

compile {
    dnp3_ipv6_island(microgrid_master, pcc_relay)
}
