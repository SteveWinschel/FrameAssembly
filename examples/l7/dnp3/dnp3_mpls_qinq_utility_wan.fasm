// PROMPT: Wide-area utility WAN DNP3 teleprotection telemetry transported over MPLS and QinQ tags.
// TOKENS: host, ip, flow, dnp3, func, src, dst, group, variation, qinq, innervlan, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define regional grid control center.
host grid_cc { ip 10.240.0.1 }

// INSTRUCTION: Define remote switching station RTU.
host switch_rtu { ip 10.240.50.10 }

// INSTRUCTION: Poll Double-bit Binary Input (Group 3 Variation 2) over QinQ and MPLS transport.
flow dnp3_wan_mpls(cc, rtu) {
    cc -> rtu dnp3 func "read" src 1 dst 500 group 3 variation 2 qinq 3000 innervlan 200 mpls 9001 exp 6 bos 1 mplsttl 64
    cc <- rtu dnp3 func "response" src 500 dst 1 group 3 variation 2 qinq 3000 innervlan 200 mpls 9001 exp 6 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the utility WAN MPLS/QinQ DNP3 flow.
compile {
    dnp3_wan_mpls(grid_cc, switch_rtu)
}
