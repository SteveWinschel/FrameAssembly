// Wide-area utility WAN DNP3 teleprotection telemetry transported over MPLS
// and QinQ tags.
// Wireshark: dnp3

// Regional grid control center.
host grid_cc { ip 10.240.0.1 }

// Remote switching station RTU.
host switch_rtu { ip 10.240.50.10 }

// Poll Double-bit Binary Input (Group 3 Variation 2) over QinQ and MPLS
// transport. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 3000 /
// C-VLAN 200, MPLS label 9001. DNP3 data groups: Group 3 (Object).
flow dnp3_wan_mpls(cc, rtu) {
    cc -> rtu dnp3 func "read" src 1 dst 500 group 3 variation 2 qinq 3000 innervlan 200 mpls 9001 exp 6 bos 1 mplsttl 64
    cc <- rtu dnp3 func "response" src 500 dst 1 group 3 variation 2 qinq 3000 innervlan 200 mpls 9001 exp 6 bos 1 mplsttl 64
}

compile {
    dnp3_wan_mpls(grid_cc, switch_rtu)
}
