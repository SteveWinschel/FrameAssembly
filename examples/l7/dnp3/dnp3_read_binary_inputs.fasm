// PROMPT: DNP3 SCADA application layer Read function querying binary input objects.
// TOKENS: host, ip, flow, s, dnp3, func, src, dst, group, variation, compile

// INSTRUCTION: Define client endpoint.
host client { ip 10.0.0.10 }

// INSTRUCTION: Define server endpoint.
host server { ip 10.0.0.20 }

// INSTRUCTION: Define application traffic flow.
flow dnp3_read(c, s) {
    c -> s dnp3 func "read" src 10 dst 20 group 1 variation 2
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    dnp3_read(client, server)
}
