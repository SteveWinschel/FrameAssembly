// DNP3 SCADA application layer Read function querying binary input objects.
// Wireshark: dnp3

host client { ip 10.0.0.10 }

host server { ip 10.0.0.20 }

// DNP3 data groups: Group 1 (Binary Input).
flow dnp3_read(c, s) {
    c -> s dnp3 func "read" src 10 dst 20 group 1 variation 2
}

compile {
    dnp3_read(client, server)
}
