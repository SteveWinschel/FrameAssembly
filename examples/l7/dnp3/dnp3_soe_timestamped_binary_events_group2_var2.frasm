// DNP3 Sequence of Events (SOE) retrieval using Group 2 Variation 2 (Binary
// Input Event with Absolute Time).
// Wireshark: dnp3

// Fault analysis SCADA historian master.
host soe_master {
    ip 10.125.40.1
    mac 00:1a:2b:7d:40:01
}

// Protective relay IED outstation.
host protection_relay {
    ip 10.125.40.19
    mac 00:1a:2b:7d:40:19
}

// Receive Unsolicited Response with Group 2 Var 2 SOE events and send
// application CONFIRM. DNP3 data groups: Group 2 (Binary Input Event).
flow dnp3_soe_events(m, r) {
    m <- r dnp3 func "unsolicitedresponse" src 19 dst 1 group 2 variation 2 hexpayload "8124eb8c0100" wait 1ms
    m -> r dnp3 func "confirm" src 1 dst 19 group 2 variation 2
}

compile {
    dnp3_soe_events(soe_master, protection_relay)
}
