// Full DNP3 TCP 3-way handshake on port 20000 followed by initial unsolicited
// null response and Class 0 poll.
// Wireshark: tcp || dnp3

// Primary SCADA master station.
host primary_master {
    ip 10.125.120.1
    mac 00:1a:2b:7d:c0:01
}

// Newly rebooted substation RTU outstation.
host rebooted_rtu {
    ip 10.125.120.8
    mac 00:1a:2b:7d:c0:08
}

// Complete TCP handshake on port 20000, confirm outstation restart
// unsolicited response, and poll Class 0. DNP3 data groups: Group 60 (Class
// 0/1/2/3/4 Data), Group 80 (Internal Indications).
flow dnp3_tcp_startup(m, o) {
    m -> o tcp srcport 49500 dstport 20000 syn seq 100
    m <- o tcp srcport 20000 dstport 49500 syn ack seq 800 acknum 101
    m -> o tcp srcport 49500 dstport 20000 ack seq 101 acknum 801
    m <- o dnp3 func "unsolicitedresponse" src 8 dst 1 group 80 variation 1 wait 1ms
    m -> o dnp3 func "confirm" src 1 dst 8 group 80 variation 1 wait 1ms
    m -> o dnp3 func "read" src 1 dst 8 group 60 variation 1
    m <- o dnp3 func "response" src 8 dst 1 group 60 variation 1
}

compile {
    dnp3_tcp_startup(primary_master, rebooted_rtu)
}
