// PROMPT: DNP3 Time and Date synchronization write (Group 50 Variation 1) with binary timestamp HEXPAYLOAD.
// TOKENS: host, ip, flow, m, dnp3, func, src, dst, group, variation, hexpayload, compile

// INSTRUCTION: Define GPS-synchronized SCADA master.
host gps_master { ip 10.160.1.1 }

// INSTRUCTION: Define remote capacitor bank RTU.
host capbank_rtu { ip 10.160.1.75 }

// INSTRUCTION: Write 48-bit UTC millisecond time (Group 50 Var 1) to outstation clock.
flow dnp3_time_sync(m, c) {
    m -> c dnp3 func "write" src 1 dst 75 group 50 variation 1 hexpayload "018b9a4f2c00"
    m <- c dnp3 func "response" src 75 dst 1 group 50 variation 1
}

// INSTRUCTION: Compile the DNP3 clock synchronization write flow.
compile {
    dnp3_time_sync(gps_master, capbank_rtu)
}
