// DNP3 Time and Date synchronization write (Group 50 Variation 1) with binary
// timestamp HEXPAYLOAD.
// Wireshark: dnp3

// GPS-synchronized SCADA master.
host gps_master { ip 10.160.1.1 }

// Remote capacitor bank RTU.
host capbank_rtu { ip 10.160.1.75 }

// Write 48-bit UTC millisecond time (Group 50 Var 1) to outstation clock.
// DNP3 data groups: Group 50 (Time and Date).
flow dnp3_time_sync(m, c) {
    m -> c dnp3 func "write" src 1 dst 75 group 50 variation 1 hexpayload "018b9a4f2c00"
    m <- c dnp3 func "response" src 75 dst 1 group 50 variation 1
}

compile {
    dnp3_time_sync(gps_master, capbank_rtu)
}
