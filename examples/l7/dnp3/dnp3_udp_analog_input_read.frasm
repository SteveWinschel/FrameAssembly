// PROMPT: DNP3 over UDP transport reading 32-bit Analog Input measurements (Group 30 Variation 1).
// TOKENS: host, ip, flow, m, s, dnp3, transport, udp, func, src, dst, group, variation, compile

// INSTRUCTION: Define telemetry concentrator master.
host udp_master { ip 10.95.0.1 }

// INSTRUCTION: Define solar inverter DNP3 UDP outstation.
host solar_rtu { ip 10.95.0.12 }

// INSTRUCTION: Query Analog Input Group 30 Variation 1 over connectionless UDP port 20000.
flow dnp3_udp_analog(m, s) {
    m -> s dnp3 transport udp func "read" src 1 dst 12 group 30 variation 1
    m <- s dnp3 transport udp func "response" src 12 dst 1 group 30 variation 1
}

// INSTRUCTION: Compile the DNP3 over UDP analog measurement query.
compile {
    dnp3_udp_analog(udp_master, solar_rtu)
}
