// DNP3 over UDP transport reading 32-bit Analog Input measurements (Group 30
// Variation 1).
// Wireshark: dnp3

// Telemetry concentrator master.
host udp_master { ip 10.95.0.1 }

// Solar inverter DNP3 UDP outstation.
host solar_rtu { ip 10.95.0.12 }

// Query Analog Input Group 30 Variation 1 over connectionless UDP port 20000.
// Overrides default TCP with UDP transport on port 20000. DNP3 data groups:
// Group 30 (Analog Input).
flow dnp3_udp_analog(m, s) {
    m -> s dnp3 transport udp func "read" src 1 dst 12 group 30 variation 1
    m <- s dnp3 transport udp func "response" src 12 dst 1 group 30 variation 1
}

compile {
    dnp3_udp_analog(udp_master, solar_rtu)
}
