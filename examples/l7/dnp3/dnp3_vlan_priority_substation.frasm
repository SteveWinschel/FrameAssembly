// Substation LAN DNP3 traffic on IEEE 802.1Q VLAN 100 with highest 802.1p
// priority (PCP 7).
// Wireshark: dnp3

host sub_hmi { ip 192.168.110.5 }

// Transformer tap changer IED.
host tap_changer { ip 192.168.110.65 }

// Command tap raise via Direct Operate over high-priority VLAN 100 and DSCP
// CS6. Encapsulation and QoS markings: 802.1Q VLAN 100, DSCP 48. DNP3 data
// groups: Group 12 (CROB Control Relay).
flow dnp3_vlan_tap_change(h, t) {
    h -> t dnp3 func "directoperate" src 5 dst 65 group 12 variation 1 vlan 100 pcp 7 dscp 48
    h <- t dnp3 func "response" src 65 dst 5 group 12 variation 1 vlan 100 pcp 7 dscp 48
}

compile {
    dnp3_vlan_tap_change(sub_hmi, tap_changer)
}
