// Electric utility substation telemetry using Distributed Network Protocol
// DNP3 on TCP 20000.
// Wireshark: dnp3

// Substation control center master.
host substation_master { ip 10.10.100.1 }

// Remote terminal unit outstation.
host outstation_rtu { ip 10.10.100.2 }

// DNP3 read and operate command flow.
flow dnp3_flow(m, r) {
    m -> r dnp3 func read
    m -> r dnp3 func operate
}

compile {
    dnp3_flow(substation_master, outstation_rtu)
}
