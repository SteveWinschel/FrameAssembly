// DNS CAA record query and response verifying authorized TLS certificate
// issuers for a banking domain.
// Wireshark: dns

// DNS stub resolver client endpoint.
host dns_client {
    ip 10.53.1.10
    mac 00:1b:21:53:01:0a
}

// Authoritative or recursive DNS server endpoint.
host dns_server {
    ip 10.53.1.53
    mac 00:1b:21:53:01:35
}

// DNS wire details: record types CAA; rcode 0 (NOERROR).
flow dns_scenario_flow(c, s) {
    c -> s dns query txid 2101 qname "secure.bank.example.com" qtype "caa" wait 3ms
    c <- s dns response txid 2101 rcode 0 qname "secure.bank.example.com" qtype "caa" rdata "0 issue letsencrypt.org" ansttl 3600
}

compile {
    dns_scenario_flow(dns_client, dns_server)
}
