// PROMPT: DNS CNAME alias resolution followed by target A record lookup.
// TOKENS: host, ip, flow, dns, query, txid, qname, qtype, response, rdata, ansttl, compile

// INSTRUCTION: Define web browser workstation.
host browser_ws { ip 192.168.5.22 }

// INSTRUCTION: Define local DNS forwarder.
host dns_fw { ip 192.168.5.1 }

// INSTRUCTION: Resolve CNAME alias cdn.example.com and then its canonical target A record.
flow dns_cname_chain(b, d) {
    b -> d dns query txid 0x5001 qname "cdn.example.com" qtype "cname"
    b <- d dns response txid 0x5001 qname "cdn.example.com" qtype "cname" rdata "edge.akamaiedge.net" ansttl 600
    b -> d dns query txid 0x5002 qname "edge.akamaiedge.net" qtype "a"
    b <- d dns response txid 0x5002 qname "edge.akamaiedge.net" qtype "a" rdata "23.45.67.89" ansttl 60
}

// INSTRUCTION: Compile the DNS CNAME chain resolution flow.
compile {
    dns_cname_chain(browser_ws, dns_fw)
}
