// DNS starter query on UDP port 53 using built-in defaults. Omitting extra
// keywords emits a standard A record lookup for example.com (txid 0x1234).
// Wireshark: dns

host stub_client {
    ip 192.168.1.55
    mac 00:1c:42:10:20:30
}

host dns_recursor {
    ip 1.1.1.1
    mac 00:1c:42:10:20:01
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    stub_client -> dns_recursor dns
}
