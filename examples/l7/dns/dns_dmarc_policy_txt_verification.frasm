// Email gateway querying a _dmarc TXT record via DNS to enforce domain
// alignment and reject spoofing.
// Wireshark: dns

// DNS stub resolver client endpoint.
host dns_client {
    ip 172.16.53.20
    mac 00:1b:21:53:01:0a
}

// Authoritative or recursive DNS server endpoint.
host dns_server {
    ip 172.16.53.1
    mac 00:1b:21:53:01:35
}

// DNS wire details: record types TXT; rcode 0 (NOERROR).
flow dns_scenario_flow(c, s) {
    c -> s dns query txid 2102 qname "_dmarc.corp.example.org" qtype "txt" wait 4ms
    c <- s dns response txid 2102 rcode 0 qname "_dmarc.corp.example.org" qtype "txt" rdata "v=DMARC1; p=reject; rua=mailto:dmarc@corp.example.org" ansttl 1800
}

compile {
    dns_scenario_flow(dns_client, dns_server)
}
