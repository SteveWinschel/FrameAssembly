// PROMPT: Dual-stack DNS happy eyeballs parallel A and AAAA lookups over IPv4 and IPv6 resolvers.
// TOKENS: host, ip, flow, dns, query, txid, qname, qtype, response, rdata, ansttl, compile

// INSTRUCTION: Define dual-stack client IPv4 interface.
host client_v4 { ip 192.168.100.20 }

// INSTRUCTION: Define IPv4 public DNS resolver.
host dns_v4 { ip 8.8.4.4 }

// INSTRUCTION: Define dual-stack client IPv6 interface.
host client_v6 { ip 2001:db8:100::20 }

// INSTRUCTION: Define IPv6 public DNS resolver.
host dns_v6 { ip 2001:4860:4860::8844 }

// INSTRUCTION: Query A and AAAA records polymorphically across IPv4 and IPv6 transport.
flow dns_happy_eyeballs(c, d) {
    c -> d dns query txid 0x1010 qname "dual.example.com" qtype "a"
    c <- d dns response txid 0x1010 qname "dual.example.com" qtype "a" rdata "93.184.216.34" ansttl 300
    c -> d dns query txid 0x1011 qname "dual.example.com" qtype "aaaa"
    c <- d dns response txid 0x1011 qname "dual.example.com" qtype "aaaa" rdata "2606:2800:220:1::248" ansttl 300
}

// INSTRUCTION: Execute happy eyeballs DNS resolution on both IPv4 and IPv6 stacks.
compile {
    dns_happy_eyeballs(client_v4, dns_v4)
    dns_happy_eyeballs(client_v6, dns_v6)
}
