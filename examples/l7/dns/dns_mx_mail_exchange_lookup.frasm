// DNS MX mail exchanger record lookup and response with explicit answer TTL.
// Wireshark: dns

host smtp_mta { ip 172.16.40.10 }

// Upstream DNS resolver.
host dns_resolver { ip 9.9.9.9 }

// Query MX record for example.org and receive mail server target with 3600s
// TTL. DNS wire details: record types MX.
flow dns_mx_lookup(m, r) {
    m -> r dns query txid 0x8801 qname "example.org" qtype "mx"
    m <- r dns response txid 0x8801 qname "example.org" qtype "mx" rdata "10 mail.example.org" ansttl 3600
}

compile {
    dns_mx_lookup(smtp_mta, dns_resolver)
}
