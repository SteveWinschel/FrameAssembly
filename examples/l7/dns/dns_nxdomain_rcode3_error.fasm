// PROMPT: DNS NXDOMAIN (RCODE 3) negative response for a non-existent domain lookup.
// TOKENS: host, ip, flow, s, dns, query, txid, qname, qtype, response, rcode, ansttl, compile

// INSTRUCTION: Define enterprise client host.
host corp_ws { ip 10.15.20.45 }

// INSTRUCTION: Define internal authoritative DNS server.
host auth_dns { ip 10.15.20.2 }

// INSTRUCTION: Query unknown hostname and return RCODE 3 (NXDOMAIN).
flow dns_nxdomain_flow(c, s) {
    c -> s dns query txid 0x4f12 qname "missing-host.corp.internal" qtype "a"
    c <- s dns response txid 0x4f12 qname "missing-host.corp.internal" qtype "a" rcode 3 ansttl 300
}

// INSTRUCTION: Compile the DNS NXDOMAIN negative response flow.
compile {
    dns_nxdomain_flow(corp_ws, auth_dns)
}
