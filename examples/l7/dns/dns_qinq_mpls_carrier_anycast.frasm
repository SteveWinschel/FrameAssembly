// PROMPT: Carrier ISP DNS resolution carried over QinQ subscriber VLANs and MPLS core label.
// TOKENS: host, ip, flow, dns, query, txid, qname, qtype, qinq, innervlan, mpls, dscp, response, rdata, ansttl, compile

// INSTRUCTION: Define subscriber home gateway.
host home_gw { ip 100.64.55.12 }

// INSTRUCTION: Define ISP anycast DNS resolver.
host isp_anycast_dns { ip 198.18.0.53 }

// INSTRUCTION: Exchange QinQ and MPLS encapsulated DNS lookup frames.
flow dns_carrier_anycast(g, d) {
    g -> d dns query txid 0xaa55 qname "portal.isp.net" qtype "a" qinq 800 innervlan 55 mpls 12053 dscp 16
    g <- d dns response txid 0xaa55 qname "portal.isp.net" qtype "a" rdata "198.18.10.20" ansttl 600 qinq 800 innervlan 55 mpls 12053 dscp 16
}

// INSTRUCTION: Compile the ISP carrier QinQ/MPLS DNS scenario.
compile {
    dns_carrier_anycast(home_gw, isp_anycast_dns)
}
