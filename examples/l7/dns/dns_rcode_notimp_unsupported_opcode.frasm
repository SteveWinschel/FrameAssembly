// DNS response with RCODE 4 (NOTIMP) when a client sends an unsupported query
// type to a minimal forwarder.
// Wireshark: dns

// DNS stub resolver client endpoint.
host dns_client {
    ip 10.53.99.10
    mac 00:1b:21:53:01:0a
}

// Authoritative or recursive DNS server endpoint.
host dns_server {
    ip 10.53.99.1
    mac 00:1b:21:53:01:35
}

// DNS wire details: record types HINFO; rcode 4 (NOTIMP).
flow dns_scenario_flow(c, s) {
    c -> s dns query txid 2111 qname "legacy.router.local" qtype "hinfo" wait 2ms
    c <- s dns response txid 2111 rcode 4 qname "legacy.router.local" qtype "hinfo" ansttl 0
}

compile {
    dns_scenario_flow(dns_client, dns_server)
}
