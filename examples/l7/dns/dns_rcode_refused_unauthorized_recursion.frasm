// Authoritative DNS server returning RCODE 5 (REFUSED) to an unauthorized
// recursive query from an external host.
// Wireshark: dns

// DNS stub resolver client endpoint.
host dns_client {
    ip 203.0.113.88
    mac 00:1b:21:53:01:0a
}

// Authoritative or recursive DNS server endpoint.
host dns_server {
    ip 198.51.100.53
    mac 00:1b:21:53:01:35
}

// DNS wire details: record types A; rcode 5 (REFUSED).
flow dns_scenario_flow(c, s) {
    c -> s dns query txid 2110 qname "www.external-domain.org" qtype "a" wait 2ms
    c <- s dns response txid 2110 rcode 5 qname "www.external-domain.org" qtype "a" ansttl 0
}

compile {
    dns_scenario_flow(dns_client, dns_server)
}
