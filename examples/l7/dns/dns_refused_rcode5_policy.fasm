// PROMPT: DNS REFUSED (RCODE 5) response when an external host attempts unauthorized recursion.
// TOKENS: host, ip, flow, dns, query, txid, qname, qtype, response, rcode, compile

// INSTRUCTION: Define external scanner host.
host ext_scanner { ip 198.51.100.77 }

// INSTRUCTION: Define authoritative-only nameserver refusing recursion.
host auth_ns { ip 203.0.113.53 }

// INSTRUCTION: Send recursive query and receive RCODE 5 (REFUSED).
flow dns_refused_recursion(e, a) {
    e -> a dns query txid 0xdead qname "google.com" qtype "a"
    e <- a dns response txid 0xdead qname "google.com" qtype "a" rcode 5
}

// INSTRUCTION: Compile the DNS RCODE 5 REFUSED scenario.
compile {
    dns_refused_recursion(ext_scanner, auth_ns)
}
