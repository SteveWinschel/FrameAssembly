// DNS SERVFAIL (RCODE 2) response when upstream DNSSEC validation fails.
// Wireshark: dns

// Client querying a domain with broken DNSSEC signatures.
host sec_client { ip 10.45.0.100 }

// Validating DNSSEC recursive resolver.
host dnssec_val { ip 10.45.0.1 }

// Query domain and receive RCODE 2 (SERVFAIL) after validation failure. DNS
// wire details: record types A; rcode 2 (SERVFAIL). Uses post-packet wait
// timing (50ms) to space follow-up packets.
flow dns_servfail_rcode2(c, v) {
    c -> v dns query txid 0x6601 qname "dnssec-failed.org" qtype "a" wait 50ms
    c <- v dns response txid 0x6601 qname "dnssec-failed.org" qtype "a" rcode 2
}

compile {
    dns_servfail_rcode2(sec_client, dnssec_val)
}
