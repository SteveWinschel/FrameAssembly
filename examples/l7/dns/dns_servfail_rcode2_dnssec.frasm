// PROMPT: DNS SERVFAIL (RCODE 2) response when upstream DNSSEC validation fails.
// TOKENS: host, ip, flow, dns, query, txid, qname, qtype, wait, ms, response, rcode, compile

// INSTRUCTION: Define client querying a domain with broken DNSSEC signatures.
host sec_client { ip 10.45.0.100 }

// INSTRUCTION: Define validating DNSSEC recursive resolver.
host dnssec_val { ip 10.45.0.1 }

// INSTRUCTION: Query domain and receive RCODE 2 (SERVFAIL) after validation failure.
flow dns_servfail_rcode2(c, v) {
    c -> v dns query txid 0x6601 qname "dnssec-failed.org" qtype "a" wait 50ms
    c <- v dns response txid 0x6601 qname "dnssec-failed.org" qtype "a" rcode 2
}

// INSTRUCTION: Compile the DNS SERVFAIL scenario.
compile {
    dns_servfail_rcode2(sec_client, dnssec_val)
}
