// DNS SOA start of authority serial number check between secondary and
// primary nameservers.
// Wireshark: dns

host ns_secondary { ip 10.53.0.2 }

host ns_primary { ip 10.53.0.1 }

// Query zone SOA record on management VLAN 53 to check zone serial.
// Encapsulation and QoS markings: 802.1Q VLAN 53. DNS wire details: record
// types SOA.
flow dns_soa_serial_check(sec, pri) {
    sec -> pri dns query txid 0x5301 qname "corp.example.net" qtype "soa" vlan 53
    sec <- pri dns response txid 0x5301 qname "corp.example.net" qtype "soa" rdata "ns1.corp.example.net hostmaster.corp.example.net" ansttl 86400 vlan 53
}

compile {
    dns_soa_serial_check(ns_secondary, ns_primary)
}
