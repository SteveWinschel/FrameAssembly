// Split-horizon DNS verification comparing internal corporate and public
// views. Internal resolver returns RFC 1918 IP 10.42.8.15; external returns
// NXDOMAIN (3). Useful for verifying private DNS leaks and firewall DNS
// policy boundaries.
// Wireshark: dns

host corp_laptop {
    ip 10.42.1.50
}

host internal_dns {
    ip 10.42.0.53
}

host public_dns {
    ip 198.51.100.53
}

// Query payroll.internal.corp against internal and external resolvers.
compile {
    corp_laptop -> internal_dns dns query txid 0x4101 qname "payroll.internal.corp" qtype "a" wait 2ms
    corp_laptop <- internal_dns dns response txid 0x4101 rcode 0 qname "payroll.internal.corp" qtype "a" rdata "10.42.8.15" ansttl 120 wait 10ms
    corp_laptop -> public_dns dns query txid 0x4102 qname "payroll.internal.corp" qtype "a" wait 3ms
    corp_laptop <- public_dns dns response txid 0x4102 rcode 3 qname "payroll.internal.corp" qtype "a"
}
