// PROMPT: DNS SRV service location query discovering Kubernetes etcd cluster endpoints.
// TOKENS: HOST, IP, FLOW, DNS, QUERY, TXID, QNAME, QTYPE, RESPONSE, RDATA, ANS_TTL, COMPILE

// INSTRUCTION: Define Kubernetes worker node.
HOST k8s_node { IP 10.96.1.15 }

// INSTRUCTION: Define CoreDNS cluster service IP.
HOST coredns_svc { IP 10.96.0.10 }

// INSTRUCTION: Query _etcd-server._tcp.cluster.local SRV record and return service target.
FLOW dns_k8s_srv(n, c) {
    n -> c DNS QUERY TXID 0x7100 QNAME "_etcd-server._tcp.cluster.local" QTYPE "SRV"
    n <- c DNS RESPONSE TXID 0x7100 QNAME "_etcd-server._tcp.cluster.local" QTYPE "SRV" RDATA "0 10 2380 etcd-0.cluster.local" ANS_TTL 30
}

// INSTRUCTION: Compile the Kubernetes CoreDNS SRV query flow.
COMPILE {
    dns_k8s_srv(k8s_node, coredns_svc)
}
