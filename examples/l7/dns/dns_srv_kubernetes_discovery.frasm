// DNS SRV service location query discovering Kubernetes etcd cluster
// endpoints.
// Wireshark: dns

// Kubernetes worker node.
host k8s_node { ip 10.96.1.15 }

// CoreDNS cluster service IP.
host coredns_svc { ip 10.96.0.10 }

// Query _etcd-server._tcp.cluster.local SRV record and return service target.
// DNS wire details: record types SRV.
flow dns_k8s_srv(n, c) {
    n -> c dns query txid 0x7100 qname "_etcd-server._tcp.cluster.local" qtype "srv"
    n <- c dns response txid 0x7100 qname "_etcd-server._tcp.cluster.local" qtype "srv" rdata "0 10 2380 etcd-0.cluster.local" ansttl 30
}

compile {
    dns_k8s_srv(k8s_node, coredns_svc)
}
