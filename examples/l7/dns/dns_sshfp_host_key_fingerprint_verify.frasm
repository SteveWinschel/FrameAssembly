// SSH client querying a DNS SSHFP record (RFC 4255) to verify a remote server
// Ed25519 host key.
// Wireshark: dns

// DNS stub resolver client endpoint.
host dns_client {
    ip 192.168.22.50
    mac 00:1b:21:53:01:0a
}

// Authoritative or recursive DNS server endpoint.
host dns_server {
    ip 192.168.22.53
    mac 00:1b:21:53:01:35
}

// DNS wire details: record types SSHFP; rcode 0 (NOERROR).
flow dns_scenario_flow(c, s) {
    c -> s dns query txid 2109 qname "bastion.ops.example.com" qtype "sshfp" wait 2ms
    c <- s dns response txid 2109 rcode 0 qname "bastion.ops.example.com" qtype "sshfp" rdata "4 2 9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b" ansttl 3600
}

compile {
    dns_scenario_flow(dns_client, dns_server)
}
