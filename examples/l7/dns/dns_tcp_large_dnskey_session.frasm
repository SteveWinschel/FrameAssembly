// PROMPT: Full TCP 3-way handshake and DNS over TCP query for large DNSKEY response payload.
// TOKENS: host, ip, flow, tcp, syn, srcport, dstport, ack, dns, transport, query, txid, qname, qtype, response, rdata, ansttl, fin, compile

// INSTRUCTION: Define recursive resolver initiating TCP fallback.
host tcp_resolver { ip 172.20.53.10 }

// INSTRUCTION: Define authoritative DNS server listening on TCP port 53.
host tcp_auth_ns { ip 172.20.53.1 }

// INSTRUCTION: Perform TCP handshake, send 2-byte length-prefixed DNS over TCP query, and close.
flow dns_tcp_fallback_session(r, a) {
    r -> a tcp syn srcport 54321 dstport 53
    r <- a tcp syn ack
    r -> a tcp ack
    r -> a dns transport tcp query txid 0x2201 qname "iana.org" qtype "dnskey"
    r <- a dns transport tcp response txid 0x2201 qname "iana.org" qtype "dnskey" rdata "257 3 13 ksk-pub-key" ansttl 3600
    r -> a tcp fin ack
    r <- a tcp fin ack
    r -> a tcp ack
}

// INSTRUCTION: Compile the complete DNS over TCP session.
compile {
    dns_tcp_fallback_session(tcp_resolver, tcp_auth_ns)
}
