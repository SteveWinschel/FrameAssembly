// DNS TXT record query verifying SPF and DMARC email authentication policies.
// Wireshark: dns

// Email security gateway verifying sender SPF policy.
host mail_filter { ip 10.50.10.12 }

host dns_cache { ip 10.50.10.1 }

// Query SPF and DMARC TXT records in sequence. DNS wire details: record types
// TXT.
flow dns_txt_spf_dmarc(f, d) {
    f -> d dns query txid 0x3101 qname "example.com" qtype "txt"
    f <- d dns response txid 0x3101 qname "example.com" qtype "txt" rdata "v=spf1 include:_spf.example.com -all" ansttl 1800
    f -> d dns query txid 0x3102 qname "_dmarc.example.com" qtype "txt"
    f <- d dns response txid 0x3102 qname "_dmarc.example.com" qtype "txt" rdata "v=DMARC1; p=reject;" ansttl 1800
}

compile {
    dns_txt_spf_dmarc(mail_filter, dns_cache)
}
