// EtherNet/IP CIP Connection Manager (Class 6) Forward_Open service request.
// Wireshark: enip || cip

// Supervisory PLC controller.
host sup_plc { ip 172.21.10.1 }

// Remote Flex I/O chassis.
host flex_io { ip 172.21.10.40 }

// Invoke CIP Service 84 (Forward_Open) on Connection Manager Class 6 Instance
// 1.
flow enip_forward_open(s, f) {
    s -> f ethernetip cmd "sendrrdata" sessionhandle 0x2000 cipservice 84 cipclass 6 cipinstance 1 cipattr 1
    s <- f ethernetip cmd "sendrrdata" sessionhandle 0x2000 status 0
}

compile {
    enip_forward_open(sup_plc, flex_io)
}
