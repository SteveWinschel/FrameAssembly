// PROMPT: EtherNet/IP CIP Ethernet Link Object (Class 0xF6 = 246) reading link speed (Attr 1) and interface counters (Attr 4).
// TOKENS: host, ip, mac, flow, ethernetip, cmd, sessionhandle, context, cipservice, cipclass, cipinstance, cipattr, status, hexpayload, wait, ms, compile

// INSTRUCTION: Define the industrial network NMS poller.
host ind_nms {
    ip 10.135.40.5
    mac 00:1a:2b:87:40:05
}

// INSTRUCTION: Define the CompactLogix 5380 dual-IP controller.
host compactlogix {
    ip 10.135.40.1
    mac 00:1a:2b:87:40:01
}

// INSTRUCTION: Query CIP Class 246 (Ethernet Link Object) Instance 1 Attributes 1 (Interface Speed) and 4 (Interface Counters).
flow enip_eth_link_obj(n, c) {
    n -> c ethernetip cmd "sendrrdata" sessionhandle 3000 context 801 cipservice 14 cipclass 246 cipinstance 1 cipattr 1
    n <- c ethernetip cmd "sendrrdata" status 0 sessionhandle 3000 context 801 cipservice 142 cipclass 246 cipinstance 1 cipattr 1 hexpayload "e8030000" wait 1ms
    n -> c ethernetip cmd "sendrrdata" sessionhandle 3000 context 802 cipservice 14 cipclass 246 cipinstance 1 cipattr 4
    n <- c ethernetip cmd "sendrrdata" status 0 sessionhandle 3000 context 802 cipservice 142 cipclass 246 cipinstance 1 cipattr 4
}

// INSTRUCTION: Compile the CIP Ethernet Link Object diagnostic flow.
compile {
    enip_eth_link_obj(ind_nms, compactlogix)
}
