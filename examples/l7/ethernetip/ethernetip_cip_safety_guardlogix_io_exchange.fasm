// PROMPT: GuardLogix CIP Safety controller reading safety input assembly from a Guardmaster safety light curtain.
// TOKENS: host, ip, mac, flow, ethernetip, cmd, sessionhandle, context, cipservice, cipclass, cipinstance, cipattr, vlan, pcp, status, hexpayload, compile

// INSTRUCTION: Define the GuardLogix 5580 safety PLC.
host guardlogix_plc {
    ip 10.135.90.1
    mac 00:1a:2b:87:90:01
}

// INSTRUCTION: Define the CIP Safety light curtain adapter.
host light_curtain {
    ip 10.135.90.18
    mac 00:1a:2b:87:90:18
}

// INSTRUCTION: Exchange connected CIP Safety payload packets over VLAN 135 with PCP 7.
flow enip_cip_safety(g, l) {
    g -> l ethernetip cmd "sendunitdata" sessionhandle 9100 context 1401 cipservice 14 cipclass 4 cipinstance 190 cipattr 3 vlan 135 pcp 7
    g <- l ethernetip cmd "sendunitdata" status 0 sessionhandle 9100 context 1401 cipservice 142 cipclass 4 cipinstance 190 cipattr 3 vlan 135 pcp 7 hexpayload "ff0055aa9c31"
}

// INSTRUCTION: Compile the GuardLogix CIP Safety I/O exchange flow.
compile {
    enip_cip_safety(guardlogix_plc, light_curtain)
}
