// PROMPT: EtherNet/IP CIP Set_Attribute_Single (Service 16) writing output assembly data with HEXPAYLOAD.
// TOKENS: host, ip, flow, ethernetip, cmd, sessionhandle, cipservice, cipclass, cipinstance, cipattr, hexpayload, status, compile

// INSTRUCTION: Define conveyor PLC master.
host conveyor_plc { ip 192.168.44.1 }

// INSTRUCTION: Define pneumatic solenoid valve island.
host valve_island { ip 192.168.44.50 }

// INSTRUCTION: Write 4-byte output bitmask to Assembly Class 4 Instance 150 Attribute 3 using Service 16.
flow enip_cip_write_outputs(p, v) {
    p -> v ethernetip cmd "sendrrdata" sessionhandle 500 cipservice 16 cipclass 4 cipinstance 150 cipattr 3 hexpayload "ff00aa55"
    p <- v ethernetip cmd "sendrrdata" sessionhandle 500 status 0
}

// INSTRUCTION: Compile the EtherNet/IP CIP Set_Attribute_Single flow.
compile {
    enip_cip_write_outputs(conveyor_plc, valve_island)
}
