// PROMPT: EtherNet/IP CIP Time Sync Object (Class 0x43 = 67) reading IEEE 1588 PTP grandmaster clock synchronization status.
// TOKENS: HOST, IP, MAC, FLOW, ETHERNETIP, CMD, SESSION_HANDLE, CONTEXT, CIP_SERVICE, CIP_CLASS, CIP_INSTANCE, CIP_ATTR, STATUS, HEXPAYLOAD, WAIT, COMPILE

// INSTRUCTION: Define the Sequence of Events (SOE) recorder supervisor.
HOST soe_supervisor {
    IP 10.135.130.10
    MAC 00:1a:2b:87:d0:10
}

// INSTRUCTION: Define the 1756-TIME GPS/PTP module.
HOST time_module {
    IP 10.135.130.1
    MAC 00:1a:2b:87:d0:01
}

// INSTRUCTION: Read Attribute 1 (PTP_Enable) and Attribute 2 (Is_Synchronized) from CIP Time Sync Class 67 Instance 1.
FLOW enip_cip_timesync(s, t) {
    s -> t ETHERNETIP CMD "SEND_RR_DATA" SESSION_HANDLE 8800 CONTEXT 1801 CIP_SERVICE 14 CIP_CLASS 67 CIP_INSTANCE 1 CIP_ATTR 1
    s <- t ETHERNETIP CMD "SEND_RR_DATA" STATUS 0 SESSION_HANDLE 8800 CONTEXT 1801 CIP_SERVICE 142 CIP_CLASS 67 CIP_INSTANCE 1 CIP_ATTR 1 HEXPAYLOAD "01" WAIT 1ms
    s -> t ETHERNETIP CMD "SEND_RR_DATA" SESSION_HANDLE 8800 CONTEXT 1802 CIP_SERVICE 14 CIP_CLASS 67 CIP_INSTANCE 1 CIP_ATTR 2
    s <- t ETHERNETIP CMD "SEND_RR_DATA" STATUS 0 SESSION_HANDLE 8800 CONTEXT 1802 CIP_SERVICE 142 CIP_CLASS 67 CIP_INSTANCE 1 CIP_ATTR 2 HEXPAYLOAD "01"
}

// INSTRUCTION: Compile the CIP Time Sync Object inspection flow.
COMPILE {
    enip_cip_timesync(soe_supervisor, time_module)
}
