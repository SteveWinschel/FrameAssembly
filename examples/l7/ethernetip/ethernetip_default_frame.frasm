// ODVA EtherNet/IP starter packet on TCP port 44818 using built-in defaults.
// Omitting extra keywords emits a 24-byte ListIdentity (0x0063) encapsulation
// request.
// Wireshark: enip || cip

host clx_scanner {
    ip 192.168.1.10
    mac 00:00:bc:11:22:01
}

host pio_adapter {
    ip 192.168.1.20
    mac 00:00:bc:11:22:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    clx_scanner -> pio_adapter ethernetip
}
