// PROMPT: Dual-stack EtherNet/IP ListIdentity broadcast and response across IPv4 and IPv6 plant networks.
// TOKENS: host, ip, flow, m, s, ethernetip, transport, udp, cmd, context, status, compile

// INSTRUCTION: Define IPv4 plant asset manager.
host asset_mgr_v4 { ip 10.88.44.10 }

// INSTRUCTION: Define IPv4 smart motor starter.
host starter_v4 { ip 10.88.44.50 }

// INSTRUCTION: Define IPv6 plant asset manager.
host asset_mgr_v6 { ip 2001:db8:4481::10 }

// INSTRUCTION: Define IPv6 smart motor starter.
host starter_v6 { ip 2001:db8:4481::50 }

// INSTRUCTION: Query device identity via ListIdentity over UDP.
flow enip_dual_identity(m, s) {
    m -> s ethernetip transport udp cmd "listidentity" context 0x55aa55aa
    m <- s ethernetip transport udp cmd "listidentity" status 0 context 0x55aa55aa
}

// INSTRUCTION: Execute the polymorphic ListIdentity flow over IPv4 and IPv6.
compile {
    enip_dual_identity(asset_mgr_v4, starter_v4)
    enip_dual_identity(asset_mgr_v6, starter_v6)
}
