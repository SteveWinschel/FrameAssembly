// High-speed cyclic EtherNet/IP implicit I/O polling loop on UDP port 2222
// with VLAN priority.
// Wireshark: enip || cip || udp.port == 2222

// Motion control PLC scanner.
host motion_plc { ip 192.168.22.1 }

// Kinetix servo drive adapter.
host servo_drive { ip 192.168.22.10 }

// Exchange cyclic UDP I/O frames on port 2222 over VLAN 22 with PCP 6 and 5ms
// cycle time. Encapsulation and QoS markings: 802.1Q VLAN 22, DSCP 46.
// Overrides default TCP with UDP transport on port 44818. Repeats 4 times;
// each wait value pauses after sending its packet.
flow enip_implicit_io_cycle(plc, drv) {
    plc -> drv ethernetip transport udp cmd "sendunitdata" sessionhandle 1 srcport 2222 dstport 2222 vlan 22 pcp 6 dscp 46 wait 5ms
    plc <- drv ethernetip transport udp cmd "sendunitdata" sessionhandle 1 srcport 2222 dstport 2222 vlan 22 pcp 6 dscp 46 wait 5ms
}

// 4 cyclic implicit I/O exchanges.
compile {
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 1
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 2
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 3
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 4
}
