// PROMPT: High-speed cyclic EtherNet/IP implicit I/O polling loop on UDP port 2222 with VLAN priority.
// TOKENS: host, ip, flow, ethernetip, transport, udp, cmd, sessionhandle, srcport, dstport, vlan, pcp, dscp, wait, ms, compile

// INSTRUCTION: Define motion control PLC scanner.
host motion_plc { ip 192.168.22.1 }

// INSTRUCTION: Define Kinetix servo drive adapter.
host servo_drive { ip 192.168.22.10 }

// INSTRUCTION: Exchange cyclic UDP I/O frames on port 2222 over VLAN 22 with PCP 6 and 5ms cycle time.
flow enip_implicit_io_cycle(plc, drv) {
    plc -> drv ethernetip transport udp cmd "sendunitdata" sessionhandle 1 srcport 2222 dstport 2222 vlan 22 pcp 6 dscp 46 wait 5ms
    plc <- drv ethernetip transport udp cmd "sendunitdata" sessionhandle 1 srcport 2222 dstport 2222 vlan 22 pcp 6 dscp 46 wait 5ms
}

// INSTRUCTION: Execute 4 cyclic implicit I/O exchanges.
compile {
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 1
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 2
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 3
    enip_implicit_io_cycle(motion_plc, servo_drive) // cycle 4
}
