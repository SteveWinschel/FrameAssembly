// PROMPT: EtherNet/IP encapsulation error response returning Status 1 (Invalid or unsupported command).
// TOKENS: host, ip, flow, s, ethernetip, cmd, sessionhandle, context, status, compile

// INSTRUCTION: Define diagnostic scanner client.
host diag_scanner { ip 10.44.18.99 }

// INSTRUCTION: Define legacy EtherNet/IP gateway.
host legacy_gw { ip 10.44.18.1 }

// INSTRUCTION: Send SendRRData with invalid session handle and receive Status 100 (Invalid Session Handle).
flow enip_error_invalid_handle(s, g) {
    s -> g ethernetip cmd "sendrrdata" sessionhandle 0xdeadbeef context 42
    s <- g ethernetip cmd "sendrrdata" sessionhandle 0xdeadbeef status 100 context 42
}

// INSTRUCTION: Compile the EtherNet/IP invalid session handle error scenario.
compile {
    enip_error_invalid_handle(diag_scanner, legacy_gw)
}
