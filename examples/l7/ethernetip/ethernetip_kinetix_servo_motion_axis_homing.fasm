// PROMPT: EtherNet/IP CIP Motion Object (Class 0x42 = 66) homing command and axis status read on a Kinetix 5700 servo drive.
// TOKENS: host, ip, mac, flow, m, ethernetip, cmd, sessionhandle, context, cipservice, cipclass, cipinstance, cipattr, dscp, hexpayload, status, wait, ms, compile

// INSTRUCTION: Define the high-speed pick-and-place motion controller.
host motion_plc {
    ip 10.135.70.1
    mac 00:1a:2b:87:70:01
}

// INSTRUCTION: Define the Kinetix 5700 dual-axis servo drive.
host kinetix_drive {
    ip 10.135.70.5
    mac 00:1a:2b:87:70:05
}

// INSTRUCTION: Set homing command on CIP Motion Axis Class 66 Instance 1 and read actual position Attribute 12.
flow enip_kinetix_home(m, k) {
    m -> k ethernetip cmd "sendrrdata" sessionhandle 7200 context 1201 cipservice 16 cipclass 66 cipinstance 1 cipattr 5 dscp 46 hexpayload "01"
    m <- k ethernetip cmd "sendrrdata" status 0 sessionhandle 7200 context 1201 cipservice 144 cipclass 66 cipinstance 1 cipattr 5 dscp 46 wait 2ms
    m -> k ethernetip cmd "sendrrdata" sessionhandle 7200 context 1202 cipservice 14 cipclass 66 cipinstance 1 cipattr 12 dscp 46
    m <- k ethernetip cmd "sendrrdata" status 0 sessionhandle 7200 context 1202 cipservice 142 cipclass 66 cipinstance 1 cipattr 12 dscp 46 hexpayload "00000000"
}

// INSTRUCTION: Compile the Kinetix servo motion axis homing flow.
compile {
    enip_kinetix_home(motion_plc, kinetix_drive)
}
