// EtherNet/IP ListInterfaces (0x0064) encapsulation request enumerating
// non-CIP communication interfaces.
// Wireshark: enip || cip

// RSLinx Classic network browser workstation.
host rslinx_pc {
    ip 10.135.10.50
    mac 00:1a:2b:87:10:50
}

// 1756-EN2TR dual-port EtherNet/IP bridge module.
host en2tr_bridge {
    ip 10.135.10.1
    mac 00:1a:2b:87:10:01
}

// Query ListInterfaces (CMD listinterfaces) and ListServices (CMD
// listservices) on TCP 44818.
flow enip_list_interfaces(c, b) {
    c -> b ethernetip cmd "listinterfaces" status 0 sessionhandle 0 context 1001
    c <- b ethernetip cmd "listinterfaces" status 0 sessionhandle 0 context 1001 wait 1ms
    c -> b ethernetip cmd "listservices" status 0 sessionhandle 0 context 1002
    c <- b ethernetip cmd "listservices" status 0 sessionhandle 0 context 1002
}

compile {
    enip_list_interfaces(rslinx_pc, en2tr_bridge)
}
