// PROMPT: PanelView Plus HMI reading controller-scoped symbolic tags via CIP Service 0x4C (76 = Read_Tag_Service).
// TOKENS: host, ip, mac, flow, ethernetip, cmd, sessionhandle, context, cipservice, cipclass, cipinstance, cipattr, payload, status, hexpayload, wait, ms, compile

// INSTRUCTION: Define the PanelView Plus 7 operator terminal.
host panelview_hmi {
    ip 10.135.110.20
    mac 00:1a:2b:87:b0:20
}

// INSTRUCTION: Define the ControlLogix batch reactor PLC.
host reactor_clx {
    ip 10.135.110.1
    mac 00:1a:2b:87:b0:01
}

// INSTRUCTION: Invoke CIP Service 76 (Read_Tag) and CIP Service 77 (Write_Tag) on Symbol Object Class 107 (0x6B).
flow enip_hmi_tags(h, p) {
    h -> p ethernetip cmd "sendrrdata" sessionhandle 4400 context 1601 cipservice 76 cipclass 107 cipinstance 1 cipattr 0 payload " Reactor_Temp_PV"
    h <- p ethernetip cmd "sendrrdata" status 0 sessionhandle 4400 context 1601 cipservice 204 cipclass 107 cipinstance 1 hexpayload "ca000000aa42" wait 2ms
    h -> p ethernetip cmd "sendrrdata" sessionhandle 4400 context 1602 cipservice 77 cipclass 107 cipinstance 2 cipattr 0 payload " Reactor_Agitator_Auto"
    h <- p ethernetip cmd "sendrrdata" status 0 sessionhandle 4400 context 1602 cipservice 205 cipclass 107 cipinstance 2
}

// INSTRUCTION: Compile the PanelView HMI symbolic tag read/write flow.
compile {
    enip_hmi_tags(panelview_hmi, reactor_clx)
}
