// PROMPT: EtherNet/IP CIP TCP/IP Interface Object (Class 245) configuration inspection over QinQ.
// TOKENS: host, ip, flow, s, ethernetip, cmd, sessionhandle, cipservice, cipclass, cipinstance, cipattr, qinq, innervlan, status, compile

// INSTRUCTION: Define OT network management appliance.
host ot_nms { ip 10.130.0.10 }

// INSTRUCTION: Define Stratix managed industrial switch.
host stratix_sw { ip 10.130.0.2 }

// INSTRUCTION: Read TCP/IP Interface Object (Class 245, Instance 1, Attr 5) over QinQ tags.
flow enip_tcpip_interface_qinq(n, s) {
    n -> s ethernetip cmd "sendrrdata" sessionhandle 777 cipservice 14 cipclass 245 cipinstance 1 cipattr 5 qinq 900 innervlan 30
    n <- s ethernetip cmd "sendrrdata" sessionhandle 777 status 0 qinq 900 innervlan 30
}

// INSTRUCTION: Compile the QinQ EtherNet/IP TCP/IP Interface Object inspection.
compile {
    enip_tcpip_interface_qinq(ot_nms, stratix_sw)
}
