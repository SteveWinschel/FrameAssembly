// EtherNet/IP encapsulation command 0x0065 RegisterSession establishing
// session.
// Wireshark: enip || cip
// Automatic Ethernet MAC addresses and TCP port 44818 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.10 }

host server { ip 192.168.1.2 }

flow enip_register(c, s) {
    c -> s ethernetip cmd "registersession" status 0
}

compile {
    enip_register(client, server)
}
