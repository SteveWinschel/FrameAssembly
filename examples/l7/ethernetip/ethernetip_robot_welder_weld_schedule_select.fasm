// PROMPT: FANUC robotic welder cell selecting spot weld schedule via EtherNet/IP Assembly Object Instance 112.
// TOKENS: HOST, IP, MAC, FLOW, ETHERNETIP, CMD, SESSION_HANDLE, CONTEXT, CIP_SERVICE, CIP_CLASS, CIP_INSTANCE, CIP_ATTR, HEXPAYLOAD, STATUS, WAIT, COMPILE

// INSTRUCTION: Define the weld line master PLC.
HOST weld_line_plc {
    IP 10.135.140.1
    MAC 00:1a:2b:87:e0:01
}

// INSTRUCTION: Define the FANUC R-30iB Plus robot EtherNet/IP adapter.
HOST fanuc_robot {
    IP 10.135.140.30
    MAC 00:1a:2b:87:e0:30
}

// INSTRUCTION: Send weld schedule 14 via SendUnitData to Instance 112 and receive weld complete confirmation from Instance 111.
FLOW enip_fanuc_weld(p, r) {
    p -> r ETHERNETIP CMD "SEND_UNIT_DATA" SESSION_HANDLE 9900 CONTEXT 1901 CIP_SERVICE 16 CIP_CLASS 4 CIP_INSTANCE 112 CIP_ATTR 3 HEXPAYLOAD "0e000100"
    p <- r ETHERNETIP CMD "SEND_UNIT_DATA" STATUS 0 SESSION_HANDLE 9900 CONTEXT 1901 CIP_SERVICE 144 CIP_CLASS 4 CIP_INSTANCE 112 CIP_ATTR 3 WAIT 5ms
    p -> r ETHERNETIP CMD "SEND_UNIT_DATA" SESSION_HANDLE 9900 CONTEXT 1902 CIP_SERVICE 14 CIP_CLASS 4 CIP_INSTANCE 111 CIP_ATTR 3
    p <- r ETHERNETIP CMD "SEND_UNIT_DATA" STATUS 0 SESSION_HANDLE 9900 CONTEXT 1902 CIP_SERVICE 142 CIP_CLASS 4 CIP_INSTANCE 111 CIP_ATTR 3 HEXPAYLOAD "0e008000"
}

// INSTRUCTION: Compile the FANUC robot weld schedule EtherNet/IP flow.
COMPILE {
    enip_fanuc_weld(weld_line_plc, fanuc_robot)
}
