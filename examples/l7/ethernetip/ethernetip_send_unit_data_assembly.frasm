// PROMPT: EtherNet/IP SendUnitData connected explicit messaging reading CIP Assembly Object (Class 4).
// TOKENS: host, ip, flow, ethernetip, cmd, sessionhandle, context, cipservice, cipclass, cipinstance, cipattr, status, compile

// INSTRUCTION: Define robotics cell controller.
host robot_ctrl { ip 172.16.44.10 }

// INSTRUCTION: Define weld controller EtherNet/IP target.
host weld_unit { ip 172.16.44.20 }

// INSTRUCTION: Exchange connected SendUnitData frames targeting CIP Assembly Class 4 Instance 100 Attribute 3.
flow enip_send_unit_data(r, w) {
    r -> w ethernetip cmd "sendunitdata" sessionhandle 0x10203040 context 0x99887766 cipservice 14 cipclass 4 cipinstance 100 cipattr 3
    r <- w ethernetip cmd "sendunitdata" sessionhandle 0x10203040 context 0x99887766 status 0
}

// INSTRUCTION: Compile the EtherNet/IP SendUnitData connected messaging flow.
compile {
    enip_send_unit_data(robot_ctrl, weld_unit)
}
