// EtherNet/IP target returning encapsulation error status 1
// (Invalid/Unsupported Command) and status 101 (Invalid Length).
// Wireshark: enip || cip

// Protocol fuzzing security scanner host.
host sec_fuzzer {
    ip 10.135.100.200
    mac 00:1a:2b:87:a0:c8
}

// Hardened industrial EtherNet/IP gateway.
host hardened_gw {
    ip 10.135.100.1
    mac 00:1a:2b:87:a0:01
}

// Send malformed encapsulation requests and receive error status codes 1 and
// 101.
flow enip_error_codes(f, g) {
    f -> g ethernetip cmd "sendrrdata" sessionhandle 0 context 1501
    f <- g ethernetip cmd "sendrrdata" status 1 sessionhandle 0 context 1501 wait 1ms
    f -> g ethernetip cmd "registersession" sessionhandle 0 context 1502
    f <- g ethernetip cmd "registersession" status 101 sessionhandle 0 context 1502
}

compile {
    enip_error_codes(sec_fuzzer, hardened_gw)
}
