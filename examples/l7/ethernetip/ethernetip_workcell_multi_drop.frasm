// Multi-adapter EtherNet/IP cell controller polling three distributed I/O
// drops in a workcell.
// Wireshark: enip || cip

// Workcell master PLC.
host cell_plc { ip 192.168.33.1 }

// Gripper I/O drop.
host io_gripper { ip 192.168.33.11 }

// Vision sensor drop.
host io_vision { ip 192.168.33.12 }

// Safety light curtain drop.
host io_curtain { ip 192.168.33.13 }

// Poll input assemblies on all three EtherNet/IP workcell drops.
flow enip_workcell_scan(plc, g, v, c) {
    plc -> g ethernetip cmd "sendrrdata" sessionhandle 11 cipservice 14 cipclass 4 cipinstance 101 cipattr 3
    plc <- g ethernetip cmd "sendrrdata" sessionhandle 11 status 0
    plc -> v ethernetip cmd "sendrrdata" sessionhandle 12 cipservice 14 cipclass 4 cipinstance 101 cipattr 3
    plc <- v ethernetip cmd "sendrrdata" sessionhandle 12 status 0
    plc -> c ethernetip cmd "sendrrdata" sessionhandle 13 cipservice 14 cipclass 4 cipinstance 101 cipattr 3
    plc <- c ethernetip cmd "sendrrdata" sessionhandle 13 status 0
}

compile {
    enip_workcell_scan(cell_plc, io_gripper, io_vision, io_curtain)
}
