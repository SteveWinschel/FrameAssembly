// Common Industrial Protocol CIP encapsulation over EtherNet/IP on TCP 44818.
// Wireshark: enip || cip

host enip_scanner { ip 192.168.1.10 }

// EtherNet/IP adapter drive.
host enip_adapter { ip 192.168.1.20 }

// EtherNet/IP session establishment flow.
flow enip_flow(s, a) {
    s -> a ethernetip cmd listidentity
    s -> a ethernetip cmd registersession
}

compile {
    enip_flow(enip_scanner, enip_adapter)
}
