// FTP client issuing an urgent ABOR command to cancel an in-flight large file
// RETR transfer.
// Wireshark: ftp

// Workstation client cancelling an accidental large ISO download.
host cancel_client {
    ip 192.168.21.77
    mac 00:24:e8:15:00:4d
}

host dept_ftp_srv {
    ip 192.168.21.1
    mac 00:24:e8:15:00:01
}

// Start RETR download then abort with ABOR receiving 426 and 226 replies.
flow ftp_abort_transfer(c, s) {
    c -> s ftp cmd "RETR" arg "dvd-archive-full.iso"
    c <- s ftp code 150 reply "Opening BINARY data connection"
    c -> s ftp cmd "ABOR"
    c <- s ftp code 426 reply "Data connection closed; transfer aborted"
    c <- s ftp code 226 reply "ABOR command successful"
}

compile {
    ftp_abort_transfer(cancel_client, dept_ftp_srv)
}
