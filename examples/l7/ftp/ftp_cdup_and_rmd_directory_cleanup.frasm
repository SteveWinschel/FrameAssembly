// FTP CDUP parent directory navigation followed by RMD removal of an obsolete
// staging directory.
// Wireshark: ftp

host cicd_runner {
    ip 10.112.21.19
    mac 02:42:0a:70:15:13
}

host staging_ftp {
    ip 10.112.21.1
    mac 02:42:0a:70:15:01
}

// Navigate to parent directory using CDUP and remove temporary build folder
// with RMD.
flow ftp_cdup_rmd_clean(c, s) {
    c -> s ftp cmd "CDUP"
    c <- s ftp code 250 reply "CDUP command successful"
    c -> s ftp cmd "RMD" arg "build-tmp-9042"
    c <- s ftp code 250 reply "Remove directory operation successful"
}

compile {
    ftp_cdup_rmd_clean(cicd_runner, staging_ftp)
}
