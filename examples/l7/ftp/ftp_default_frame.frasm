// FTP starter control command on TCP port 21 using built-in defaults.
// Omitting extra keywords emits an ASCII 'USER anonymous' control-channel
// request.
// Wireshark: ftp

host ftp_ws {
    ip 192.168.21.10
    mac 00:11:22:33:21:01
}

host ftp_srv {
    ip 192.168.21.1
    mac 00:11:22:33:21:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    ftp_ws -> ftp_srv ftp
}
