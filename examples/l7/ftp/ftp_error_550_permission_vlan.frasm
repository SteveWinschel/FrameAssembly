// FTP 550 File unavailable error when attempting to download a restricted
// configuration file.
// Wireshark: ftp

host dmz_client { ip 172.16.100.50 }

// DMZ FTP server on VLAN 100.
host dmz_ftp { ip 172.16.100.21 }

// Request restricted file and receive 550 Permission denied over VLAN 100.
// Encapsulation and QoS markings: 802.1Q VLAN 100, DSCP 10.
flow ftp_error_550_vlan(c, s) {
    c -> s ftp cmd "RETR" arg "/etc/shadow" vlan 100 dscp 10
    c <- s ftp code 550 reply "Permission denied" vlan 100 dscp 10
}

compile {
    ftp_error_550_vlan(dmz_client, dmz_ftp)
}
