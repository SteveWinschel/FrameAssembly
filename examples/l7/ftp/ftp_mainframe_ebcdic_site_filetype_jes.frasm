// PROMPT: IBM z/OS mainframe FTP job submission using TYPE E (EBCDIC) and SITE FILETYPE=JES before STOR.
// TOKENS: host, ip, mac, flow, s, ftp, cmd, arg, code, reply, compile

// INSTRUCTION: Define enterprise batch scheduler submitting JCL jobs to a mainframe.
host batch_scheduler {
    ip 10.10.21.50
    mac 00:14:5e:0a:15:32
}

// INSTRUCTION: Define IBM z/OS mainframe FTP server listener.
host zos_mainframe {
    ip 10.10.21.1
    mac 00:14:5e:0a:15:01
}

// INSTRUCTION: Configure EBCDIC type and JES job queue mode via SITE before submitting JCL.
flow ftp_mainframe_jes(c, s) {
    c -> s ftp cmd "TYPE" arg "E"
    c <- s ftp code 200 reply "Representation type is Ebcdic"
    c -> s ftp cmd "SITE" arg "FILETYPE=JES"
    c <- s ftp code 200 reply "SITE command was accepted"
    c -> s ftp cmd "STOR" arg "PAYROLL.JCL"
    c <- s ftp code 250 reply "It is known to JES as JOB04912"
}

// INSTRUCTION: Compile the mainframe EBCDIC JES job submission FTP scenario.
compile {
    ftp_mainframe_jes(batch_scheduler, zos_mainframe)
}
