// File Transfer Protocol command interaction over IPv6 on TCP 21 for user
// login and passive transfer request.
// Wireshark: ftp

host ftp_client { ip 2001:db8:21::1 }

host ftp_server { ip 2001:db8:21::2 }

// FTP login and status flow.
flow ftp_session(c, s) {
    c -> s ftp cmd "USER" arg "anonymous"
    c -> s ftp cmd "PASV"
}

compile {
    ftp_session(ftp_client, ftp_server)
}
