// PROMPT: File Transfer Protocol command interaction over IPv6 on TCP 21 for user login and passive transfer request.
// TOKENS: host, ip, flow, s, ftp, cmd, arg, compile

// INSTRUCTION: Define FTP client on IPv6 network.
host ftp_client { ip 2001:db8:21::1 }

// INSTRUCTION: Define FTP server on IPv6 network.
host ftp_server { ip 2001:db8:21::2 }

// INSTRUCTION: Define FTP login and status flow.
flow ftp_session(c, s) {
    c -> s ftp cmd "USER" arg "anonymous"
    c -> s ftp cmd "PASV"
}

// INSTRUCTION: Compile block executing FTP session.
compile {
    ftp_session(ftp_client, ftp_server)
}
