// PROMPT: FTP Passive Mode (PASV) negotiation and MLSD machine-readable directory listing over MPLS and QinQ.
// TOKENS: host, ip, flow, s, ftp, cmd, qinq, innervlan, mpls, code, reply, compile

// INSTRUCTION: Define enterprise branch archival client.
host branch_archiver { ip 10.70.1.25 }

// INSTRUCTION: Define HQ mainframes FTP gateway.
host hq_mainframe_ftp { ip 10.70.0.1 }

// INSTRUCTION: Enter PASV mode and request MLSD directory listing across QinQ and MPLS transport.
flow ftp_pasv_mlsd_mpls(c, s) {
    c -> s ftp cmd "PASV" qinq 400 innervlan 21 mpls 2100
    c <- s ftp code 227 reply "Entering Passive Mode (10,70,0,1,195,80)" qinq 400 innervlan 21 mpls 2100
    c -> s ftp cmd "MLSD" qinq 400 innervlan 21 mpls 2100
    c <- s ftp code 150 reply "Opening ASCII mode data connection for MLSD" qinq 400 innervlan 21 mpls 2100
}

// INSTRUCTION: Compile the QinQ/MPLS FTP PASV and MLSD flow.
compile {
    ftp_pasv_mlsd_mpls(branch_archiver, hq_mainframe_ftp)
}
