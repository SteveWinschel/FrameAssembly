// PROMPT: FTP SITE CHMOD permissions update on custom control port 2121 with DF flag.
// TOKENS: host, ip, flow, s, ftp, cmd, arg, srcport, dstport, df, ttl, code, reply, compile

// INSTRUCTION: Define web developer workstation.
host dev_ws { ip 192.168.80.15 }

// INSTRUCTION: Define custom-port staging FTP server on port 2121.
host custom_ftp { ip 192.168.80.2 }

// INSTRUCTION: Execute SITE CHMOD 755 deploy.sh on non-standard TCP port 2121.
flow ftp_site_chmod(c, s) {
    c -> s ftp cmd "SITE" arg "CHMOD 755 deploy.sh" srcport 55100 dstport 2121 df ttl 64
    c <- s ftp code 200 reply "SITE CHMOD command ok" srcport 2121 dstport 55100 df ttl 64
}

// INSTRUCTION: Compile the custom-port FTP SITE CHMOD scenario.
compile {
    ftp_site_chmod(dev_ws, custom_ftp)
}
