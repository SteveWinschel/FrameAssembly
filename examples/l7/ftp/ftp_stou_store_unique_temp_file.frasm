// FTP STOU (Store Unique) command generating a server-assigned collision-free
// filename on VLAN 210.
// Wireshark: ftp

// Medical imaging scanner uploading DICOM spool files over VLAN 210.
host dicom_scanner {
    ip 10.210.21.40
    mac 00:0f:fe:d2:15:28
}

host pacs_ftp_srv {
    ip 10.210.21.1
    mac 00:0f:fe:d2:15:01
}

// Request unique file creation via STOU over VLAN 210 with DSCP 18.
// Encapsulation and QoS markings: 802.1Q VLAN 210, DSCP 18.
flow ftp_stou_unique(c, s) {
    c -> s ftp cmd "STOU" arg "scan_spool.dcm" vlan 210 pcp 3 dscp 18
    c <- s ftp code 150 reply "FILE: scan_spool.dcm.88412" vlan 210 pcp 3 dscp 18
    c <- s ftp code 226 reply "Transfer complete" vlan 210 pcp 3 dscp 18
}

compile {
    ftp_stou_unique(dicom_scanner, pacs_ftp_srv)
}
