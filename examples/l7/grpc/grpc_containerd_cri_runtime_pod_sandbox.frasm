// Kubernetes kubelet invoking containerd CRI RunPodSandbox and
// CreateContainer gRPC methods on node localhost.
// Wireshark: grpc || http2

host kubelet_cri {
    ip 10.240.10.11
    mac 02:42:0a:f0:0a:0b
}

// Containerd CRI gRPC runtime daemon endpoint.
host containerd_daemon {
    ip 10.240.10.12
    mac 02:42:0a:f0:0a:0c
}

// Invoke CRI RunPodSandbox followed by CreateContainer and StartContainer
// with grpcstatus 0. gRPC status codes observed: 0 (OK) on TCP port 50051.
flow grpc_cri_pod_launch(k, c) {
    k -> c grpc service "runtime.v1.RuntimeService" method "RunPodSandbox"
    k <- c grpc service "runtime.v1.RuntimeService" method "RunPodSandbox" grpcstatus 0
    k -> c grpc service "runtime.v1.RuntimeService" method "CreateContainer"
    k <- c grpc service "runtime.v1.RuntimeService" method "CreateContainer" grpcstatus 0
    k -> c grpc service "runtime.v1.RuntimeService" method "StartContainer"
    k <- c grpc service "runtime.v1.RuntimeService" method "StartContainer" grpcstatus 0
}

compile {
    grpc_cri_pod_launch(kubelet_cri, containerd_daemon)
}
