// gRPC starter frame on TCP port 50051 using built-in defaults. Omitting
// extra keywords emits a 5-byte length-prefixed gRPC frame header.
// Wireshark: grpc || http2 || tcp.port == 50051

host grpc_caller {
    ip 10.100.50.10
    mac 02:42:0a:64:32:0a
}

host grpc_callee {
    ip 10.100.50.20
    mac 02:42:0a:64:32:14
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    grpc_caller -> grpc_callee grpc
}
