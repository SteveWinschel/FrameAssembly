// PROMPT: Dual-stack gRPC Envoy xDS ClusterDiscoveryService configuration fetch over IPv4 and IPv6.
// TOKENS: host, ip, flow, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define IPv4 Envoy sidecar proxy.
host envoy_v4 { ip 10.120.1.10 }

// INSTRUCTION: Define IPv4 Istio control plane.
host istiod_v4 { ip 10.120.0.1 }

// INSTRUCTION: Define IPv6 Envoy sidecar proxy.
host envoy_v6 { ip 2001:db8:5005::10 }

// INSTRUCTION: Define IPv6 Istio control plane.
host istiod_v6 { ip 2001:db8:5005::1 }

// INSTRUCTION: Stream xDS StreamClusters request and response polymorphically.
flow grpc_xds_sync(e, i) {
    e -> i grpc service "envoy.service.cluster.v3.ClusterDiscoveryService" method "StreamClusters"
    e <- i grpc service "envoy.service.cluster.v3.ClusterDiscoveryService" method "StreamClusters" grpcstatus 0
}

// INSTRUCTION: Execute the Envoy xDS gRPC flow over IPv4 and IPv6 stacks.
compile {
    grpc_xds_sync(envoy_v4, istiod_v4)
    grpc_xds_sync(envoy_v6, istiod_v6)
}
