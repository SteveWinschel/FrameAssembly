// PROMPT: gRPC procedure response returning error status code GRPC_STATUS 5 (NOT_FOUND) over IPv6.
// TOKENS: host, ip, flow, s, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow grpc_err(c, s) {
    c <- s grpc service "InventoryService" method "GetItem" grpcstatus 5
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    grpc_err(client, server)
}
