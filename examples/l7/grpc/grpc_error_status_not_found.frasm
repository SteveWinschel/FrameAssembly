// gRPC procedure response returning error status code grpcstatus 5
// (NOT_FOUND) over IPv6.
// Wireshark: grpc || http2

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

// gRPC status codes observed: 5 (NOT_FOUND) on TCP port 50051.
flow grpc_err(c, s) {
    c <- s grpc service "InventoryService" method "GetItem" grpcstatus 5
}

compile {
    grpc_err(client, server)
}
