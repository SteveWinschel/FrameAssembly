// PROMPT: OpenConfig gNMI collector subscribing to router interface counters on TCP port 9339 over management VLAN 90.
// TOKENS: host, ip, mac, flow, grpc, service, method, srcport, dstport, vlan, pcp, dscp, grpcstatus, payload, compile

// INSTRUCTION: Define OpenConfig telemetry collector host.
host gnmi_collector {
    ip 10.90.93.100
    mac 00:1c:73:5a:5d:64
}

// INSTRUCTION: Define data center spine router running gNMI agent on TCP port 9339.
host spine_gnmi_rtr {
    ip 10.90.93.1
    mac 00:1c:73:5a:5d:01
}

// INSTRUCTION: Invoke gNMI Capabilities and Subscribe RPCs on port 9339 tagged with VLAN 90.
flow grpc_gnmi_telemetry(col, rtr) {
    col -> rtr grpc service "gnmi.gNMI" method "Capabilities" srcport 51939 dstport 9339 vlan 90 pcp 4 dscp 16
    col <- rtr grpc service "gnmi.gNMI" method "Capabilities" srcport 9339 dstport 51939 vlan 90 pcp 4 dscp 16 grpcstatus 0
    col -> rtr grpc service "gnmi.gNMI" method "Subscribe" srcport 51939 dstport 9339 vlan 90 pcp 4 dscp 16 payload "/interfaces/interface/state/counters"
    col <- rtr grpc service "gnmi.gNMI" method "Subscribe" srcport 9339 dstport 51939 vlan 90 pcp 4 dscp 16 grpcstatus 0
}

// INSTRUCTION: Compile the OpenConfig gNMI network telemetry subscription gRPC scenario.
compile {
    grpc_gnmi_telemetry(gnmi_collector, spine_gnmi_rtr)
}
