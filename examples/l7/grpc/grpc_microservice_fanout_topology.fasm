// PROMPT: Microservice fanout where an API gateway calls Inventory, Pricing, and Shipping gRPC services.
// TOKENS: host, ip, flow, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define storefront BFF orchestrator.
host storefront_bff { ip 10.99.0.1 }

// INSTRUCTION: Define Inventory gRPC microservice.
host inventory_svc { ip 10.99.0.11 }

// INSTRUCTION: Define Pricing gRPC microservice.
host pricing_svc { ip 10.99.0.12 }

// INSTRUCTION: Define Shipping gRPC microservice.
host shipping_svc { ip 10.99.0.13 }

// INSTRUCTION: Fan out RPC requests to all three downstream microservices.
flow grpc_microservice_fanout(bff, inv, prc, shp) {
    bff -> inv grpc service "catalog.Inventory" method "CheckStock"
    bff <- inv grpc service "catalog.Inventory" method "CheckStock" grpcstatus 0
    bff -> prc grpc service "catalog.Pricing" method "GetQuote"
    bff <- prc grpc service "catalog.Pricing" method "GetQuote" grpcstatus 0
    bff -> shp grpc service "logistics.Shipping" method "EstimateDelivery"
    bff <- shp grpc service "logistics.Shipping" method "EstimateDelivery" grpcstatus 0
}

// INSTRUCTION: Compile the 4-host gRPC microservice fanout topology.
compile {
    grpc_microservice_fanout(storefront_bff, inventory_svc, pricing_svc, shipping_svc)
}
