// SDN controller programming a P4 programmable switch pipeline via P4Runtime
// Write RPC on TCP port 9559.
// Wireshark: grpc || http2 || tcp.port == 9559

host sdn_controller {
    ip 10.95.59.10
    mac 00:1c:73:5f:3b:0a
}

// Tofino P4 programmable switch running P4Runtime server on port 9559.
host p4_tofino_sw {
    ip 10.95.59.1
    mac 00:1c:73:5f:3b:01
}

// Establish master arbitration via StreamChannel and push flow table entry
// via Write RPC. gRPC status codes observed: 0 (OK) on TCP port 9559.
flow grpc_p4runtime_write(ctrl, sw) {
    ctrl -> sw grpc service "p4.v1.P4Runtime" method "SetForwardingPipelineConfig" srcport 49559 dstport 9559
    ctrl <- sw grpc service "p4.v1.P4Runtime" method "SetForwardingPipelineConfig" srcport 9559 dstport 49559 grpcstatus 0
    ctrl -> sw grpc service "p4.v1.P4Runtime" method "Write" srcport 49559 dstport 9559 hexpayload "000000120801120e"
    ctrl <- sw grpc service "p4.v1.P4Runtime" method "Write" srcport 9559 dstport 49559 grpcstatus 0
}

compile {
    grpc_p4runtime_write(sdn_controller, p4_tofino_sw)
}
