// PROMPT: Multi-tenant cloud gRPC service mesh routing with IEEE 802.1ad QinQ double VLAN encapsulation.
// TOKENS: host, ip, flow, grpc, service, method, qinq, innervlan, flowlabel, ttl, grpcstatus, compile

// INSTRUCTION: Define IPv6 ingress gateway proxy.
host mesh_ingress { ip 2001:db8:ae00::1 }

// INSTRUCTION: Define IPv6 tenant billing gRPC service.
host billing_svc { ip 2001:db8:ae00::88 }

// INSTRUCTION: Invoke CalculateInvoice RPC encapsulated in QinQ outer 2100 / inner 88.
flow grpc_qinq_billing(ing, svc) {
    ing -> svc grpc service "billing.v1.InvoiceService" method "CalculateInvoice" qinq 2100 innervlan 88 flowlabel 0x50051 ttl 64
    ing <- svc grpc service "billing.v1.InvoiceService" method "CalculateInvoice" grpcstatus 0 qinq 2100 innervlan 88 flowlabel 0x50051 ttl 64
}

// INSTRUCTION: Compile the QinQ IPv6 gRPC mesh flow.
compile {
    grpc_qinq_billing(mesh_ingress, billing_svc)
}
