// PROMPT: gRPC procedure response returning successful status code GRPC_STATUS 0 (OK).
// TOKENS: HOST, IP, FLOW, GRPC, SERVICE, METHOD, GRPC_STATUS, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 10.0.0.10 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
FLOW grpc_resp(c, s) {
    c <- s GRPC SERVICE "UserService" METHOD "GetUserProfile" GRPC_STATUS 0
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    grpc_resp(client, server)
}
