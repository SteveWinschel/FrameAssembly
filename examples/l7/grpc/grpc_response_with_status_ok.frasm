// PROMPT: gRPC procedure response returning successful status code GRPC_STATUS 0 (OK).
// TOKENS: host, ip, flow, s, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define client endpoint.
host client { ip 10.0.0.10 }

// INSTRUCTION: Define server endpoint.
host server { ip 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
flow grpc_resp(c, s) {
    c <- s grpc service "UserService" method "GetUserProfile" grpcstatus 0
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    grpc_resp(client, server)
}
