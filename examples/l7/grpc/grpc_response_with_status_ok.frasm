// gRPC procedure response returning successful status code grpcstatus 0 (OK).
// Wireshark: grpc || http2

host client { ip 10.0.0.10 }

host server { ip 10.0.0.1 }

// gRPC status codes observed: 0 (OK) on TCP port 50051.
flow grpc_resp(c, s) {
    c <- s grpc service "UserService" method "GetUserProfile" grpcstatus 0
}

compile {
    grpc_resp(client, server)
}
