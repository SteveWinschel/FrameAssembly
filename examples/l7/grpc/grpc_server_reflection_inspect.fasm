// PROMPT: gRPC Server Reflection API query inspecting exposed protobuf service definitions.
// TOKENS: host, ip, flow, s, grpc, service, method, df, ipid, payload, grpcstatus, compile

// INSTRUCTION: Define grpcurl developer CLI host.
host grpcurl_cli { ip 192.168.45.10 }

// INSTRUCTION: Define staging gRPC server with reflection enabled.
host staging_grpc { ip 192.168.45.20 }

// INSTRUCTION: Call ServerReflectionInfo and receive service list with GRPC_STATUS 0.
flow grpc_server_reflection(c, s) {
    c -> s grpc service "grpc.reflection.v1alpha.ServerReflection" method "ServerReflectionInfo" df ipid 0x3001 payload "*"
    c <- s grpc service "grpc.reflection.v1alpha.ServerReflection" method "ServerReflectionInfo" grpcstatus 0 df ipid 0x4001
}

// INSTRUCTION: Compile the gRPC server reflection inspection scenario.
compile {
    grpc_server_reflection(grpcurl_cli, staging_grpc)
}
