// Distributed database transaction coordinator returning grpcstatus 10
// (ABORTED) on optimistic lock conflict.
// Wireshark: grpc || http2

// Inventory reservation service worker.
host inv_worker {
    ip 10.100.45.21
    mac 02:42:0a:64:2d:15
}

// Distributed Spanner/CockroachDB gRPC transaction node.
host txn_coord_node {
    ip 10.100.45.1
    mac 02:42:0a:64:2d:01
}

// Attempt CommitTransaction with stale read timestamp and receive grpcstatus
// 10 ABORTED. gRPC status codes observed: 10 (ABORTED) on TCP port 50051.
flow grpc_err_aborted_conflict(w, db) {
    w -> db grpc service "storage.v1.TransactionService" method "CommitTransaction"
    w <- db grpc service "storage.v1.TransactionService" method "CommitTransaction" grpcstatus 10
}

compile {
    grpc_err_aborted_conflict(inv_worker, txn_coord_node)
}
