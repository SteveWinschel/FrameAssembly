// PROMPT: gRPC client invoking a deprecated RPC method and receiving GRPC_STATUS 12 (UNIMPLEMENTED) from server.
// TOKENS: host, ip, mac, flow, s, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define canary client testing v2 beta RPC endpoint.
host canary_client {
    ip 10.100.22.15
    mac 02:42:0a:64:16:0f
}

// INSTRUCTION: Define legacy v1 production gRPC server.
host legacy_grpc_srv {
    ip 10.100.22.1
    mac 02:42:0a:64:16:01
}

// INSTRUCTION: Invoke BatchPredictV2 and receive GRPC_STATUS 12 UNIMPLEMENTED.
flow grpc_err_unimplemented(c, s) {
    c -> s grpc service "ml.inference.v2.Predictor" method "BatchPredictV2"
    c <- s grpc service "ml.inference.v2.Predictor" method "BatchPredictV2" grpcstatus 12
}

// INSTRUCTION: Compile the gRPC status 12 UNIMPLEMENTED method scenario.
compile {
    grpc_err_unimplemented(canary_client, legacy_grpc_srv)
}
