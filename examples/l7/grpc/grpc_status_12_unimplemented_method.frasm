// gRPC client invoking a deprecated RPC method and receiving grpcstatus 12
// (UNIMPLEMENTED) from server.
// Wireshark: grpc || http2

// Canary client testing v2 beta RPC endpoint.
host canary_client {
    ip 10.100.22.15
    mac 02:42:0a:64:16:0f
}

host legacy_grpc_srv {
    ip 10.100.22.1
    mac 02:42:0a:64:16:01
}

// Invoke BatchPredictV2 and receive grpcstatus 12 UNIMPLEMENTED. gRPC status
// codes observed: 12 (UNIMPLEMENTED) on TCP port 50051.
flow grpc_err_unimplemented(c, s) {
    c -> s grpc service "ml.inference.v2.Predictor" method "BatchPredictV2"
    c <- s grpc service "ml.inference.v2.Predictor" method "BatchPredictV2" grpcstatus 12
}

compile {
    grpc_err_unimplemented(canary_client, legacy_grpc_srv)
}
