// PROMPT: gRPC backend panic recovery middleware returning GRPC_STATUS 13 (INTERNAL) to upstream caller.
// TOKENS: host, ip, mac, flow, s, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define API gateway calling recommendation engine.
host rec_gateway {
    ip 10.100.30.5
    mac 02:42:0a:64:1e:05
}

// INSTRUCTION: Define recommendation engine gRPC pod experiencing a database driver error.
host rec_engine_pod {
    ip 10.100.30.50
    mac 02:42:0a:64:1e:32
}

// INSTRUCTION: Call RankCandidates and receive GRPC_STATUS 13 INTERNAL error code.
flow grpc_err_internal(c, s) {
    c -> s grpc service "rec.v1.RankingService" method "RankCandidates"
    c <- s grpc service "rec.v1.RankingService" method "RankCandidates" grpcstatus 13
}

// INSTRUCTION: Compile the gRPC status 13 INTERNAL server error scenario.
compile {
    grpc_err_internal(rec_gateway, rec_engine_pod)
}
