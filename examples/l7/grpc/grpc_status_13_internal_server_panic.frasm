// gRPC backend panic recovery middleware returning grpcstatus 13 (INTERNAL)
// to upstream caller.
// Wireshark: grpc || http2

// API gateway calling recommendation engine.
host rec_gateway {
    ip 10.100.30.5
    mac 02:42:0a:64:1e:05
}

// Recommendation engine gRPC pod experiencing a database driver error.
host rec_engine_pod {
    ip 10.100.30.50
    mac 02:42:0a:64:1e:32
}

// Call RankCandidates and receive grpcstatus 13 INTERNAL error code. gRPC
// status codes observed: 13 (INTERNAL) on TCP port 50051.
flow grpc_err_internal(c, s) {
    c -> s grpc service "rec.v1.RankingService" method "RankCandidates"
    c <- s grpc service "rec.v1.RankingService" method "RankCandidates" grpcstatus 13
}

compile {
    grpc_err_internal(rec_gateway, rec_engine_pod)
}
