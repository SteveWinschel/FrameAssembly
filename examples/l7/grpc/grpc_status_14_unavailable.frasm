// PROMPT: gRPC Unavailable error returning GRPC_STATUS 14 during rolling pod restart.
// TOKENS: host, ip, flow, grpc, service, method, ecn, ttl, grpcstatus, compile

// INSTRUCTION: Define order router service.
host order_router { ip 10.85.1.5 }

// INSTRUCTION: Define draining backend gRPC pod.
host draining_pod { ip 10.85.1.80 }

// INSTRUCTION: Call SubmitOrder and receive GRPC_STATUS 14 (UNAVAILABLE).
flow grpc_unavailable_14(r, p) {
    r -> p grpc service "orders.v1.OrderService" method "SubmitOrder" ecn 2 ttl 64
    r <- p grpc service "orders.v1.OrderService" method "SubmitOrder" grpcstatus 14 ecn 2 ttl 64
}

// INSTRUCTION: Compile the gRPC status 14 UNAVAILABLE scenario.
compile {
    grpc_unavailable_14(order_router, draining_pod)
}
