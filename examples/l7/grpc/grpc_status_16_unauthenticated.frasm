// PROMPT: gRPC Unauthenticated error returning GRPC_STATUS 16 when bearer token is expired.
// TOKENS: host, ip, flow, s, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define mobile backend client.
host mobile_bff { ip 172.17.0.15 }

// INSTRUCTION: Define identity verification gRPC service.
host auth_grpc { ip 172.17.0.5 }

// INSTRUCTION: Call VerifyToken and receive gRPC status code 16 (UNAUTHENTICATED).
flow grpc_unauthenticated_16(c, s) {
    c -> s grpc service "auth.v2.TokenService" method "VerifyToken"
    c <- s grpc service "auth.v2.TokenService" method "VerifyToken" grpcstatus 16
}

// INSTRUCTION: Compile the gRPC status 16 UNAUTHENTICATED scenario.
compile {
    grpc_unauthenticated_16(mobile_bff, auth_grpc)
}
