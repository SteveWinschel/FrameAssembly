// gRPC Unauthenticated error returning grpcstatus 16 when bearer token is
// expired.
// Wireshark: grpc || http2

host mobile_bff { ip 172.17.0.15 }

// Identity verification gRPC service.
host auth_grpc { ip 172.17.0.5 }

// Call VerifyToken and receive gRPC status code 16 (UNAUTHENTICATED). gRPC
// status codes observed: 16 (UNAUTHENTICATED) on TCP port 50051.
flow grpc_unauthenticated_16(c, s) {
    c -> s grpc service "auth.v2.TokenService" method "VerifyToken"
    c <- s grpc service "auth.v2.TokenService" method "VerifyToken" grpcstatus 16
}

compile {
    grpc_unauthenticated_16(mobile_bff, auth_grpc)
}
