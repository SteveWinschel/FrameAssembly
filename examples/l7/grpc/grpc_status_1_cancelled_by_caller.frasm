// gRPC context cancellation propagation returning grpcstatus 1 (CANCELLED)
// when upstream client disconnects.
// Wireshark: grpc || http2

// Search aggregator service cancelling an expensive shard query.
host search_aggregator {
    ip 10.100.35.10
    mac 02:42:0a:64:23:0a
}

// Vector index shard gRPC worker node.
host vector_shard {
    ip 10.100.35.99
    mac 02:42:0a:64:23:63
}

// Dispatch NearestNeighbors RPC and terminate with grpcstatus 1 CANCELLED
// after 10ms. gRPC status codes observed: 1 (CANCELLED) on TCP port 50051.
flow grpc_err_cancelled(agg, shard) {
    agg -> shard grpc service "vector.v1.IndexService" method "NearestNeighbors" wait 10ms
    agg <- shard grpc service "vector.v1.IndexService" method "NearestNeighbors" grpcstatus 1
}

compile {
    grpc_err_cancelled(search_aggregator, vector_shard)
}
