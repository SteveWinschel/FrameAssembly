// gRPC Deadline Exceeded error returning grpcstatus 4 after a 500ms upstream
// timeout.
// Wireshark: grpc || http2

host search_agg { ip 10.32.1.8 }

// Vector similarity gRPC engine.
host vector_engine { ip 10.32.1.99 }

// Invoke NearestNeighbors RPC and return grpcstatus 4 (DEADLINE_EXCEEDED)
// after 500ms. gRPC status codes observed: 4 (DEADLINE_EXCEEDED) on TCP port
// 50051. Uses post-packet wait timing (500ms) to space follow-up packets.
flow grpc_deadline_exceeded(a, v) {
    a -> v grpc service "ml.v1.VectorIndex" method "NearestNeighbors" wait 500ms
    a <- v grpc service "ml.v1.VectorIndex" method "NearestNeighbors" grpcstatus 4
}

compile {
    grpc_deadline_exceeded(search_agg, vector_engine)
}
