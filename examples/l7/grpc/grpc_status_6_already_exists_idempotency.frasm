// gRPC ledger service enforcing idempotency keys by returning grpcstatus 6
// (ALREADY_EXISTS) on duplicate create.
// Wireshark: grpc || http2

// Payment retry worker submitting duplicate transaction creation.
host retry_worker {
    ip 10.100.40.12
    mac 02:42:0a:64:28:0c
}

// Immutable financial ledger gRPC service.
host ledger_service {
    ip 10.100.40.1
    mac 02:42:0a:64:28:01
}

// First RecordEntry succeeds with grpcstatus 0; duplicate retry returns
// grpcstatus 6. gRPC status codes observed: 0 (OK), 6 (ALREADY_EXISTS) on TCP
// port 50051.
flow grpc_err_already_exists(w, l) {
    w -> l grpc service "ledger.v1.JournalService" method "RecordEntry" payload "tx_id=9901"
    w <- l grpc service "ledger.v1.JournalService" method "RecordEntry" grpcstatus 0
    w -> l grpc service "ledger.v1.JournalService" method "RecordEntry" payload "tx_id=9901"
    w <- l grpc service "ledger.v1.JournalService" method "RecordEntry" grpcstatus 6
}

compile {
    grpc_err_already_exists(retry_worker, ledger_service)
}
