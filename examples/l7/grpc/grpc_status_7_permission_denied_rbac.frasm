// Service mesh RBAC policy enforcement rejecting an unauthorized gRPC call
// with grpcstatus 7 (PERMISSION_DENIED).
// Wireshark: grpc || http2

// Untrusted workload pod attempting administrative RPC call.
host untrusted_pod {
    ip 10.100.18.44
    mac 02:42:0a:64:12:2c
}

// Vault secrets manager gRPC server enforcing mTLS RBAC.
host vault_grpc_srv {
    ip 10.100.18.1
    mac 02:42:0a:64:12:01
}

// Call RotateMasterKey and receive grpcstatus 7 PERMISSION_DENIED. gRPC
// status codes observed: 7 (PERMISSION_DENIED) on TCP port 50051.
flow grpc_err_permission_denied(c, s) {
    c -> s grpc service "security.v1.KmsService" method "RotateMasterKey"
    c <- s grpc service "security.v1.KmsService" method "RotateMasterKey" grpcstatus 7
}

compile {
    grpc_err_permission_denied(untrusted_pod, vault_grpc_srv)
}
