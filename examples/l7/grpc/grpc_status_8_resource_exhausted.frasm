// gRPC Resource Exhausted rate-limit rejection returning grpcstatus 8.
// Wireshark: grpc || http2

// Batch ingestion worker.
host ingest_worker { ip 10.64.2.30 }

host llm_inference { ip 10.64.2.1 }

// Call GenerateEmbeddings and receive grpcstatus 8 (RESOURCE_EXHAUSTED). gRPC
// status codes observed: 8 (RESOURCE_EXHAUSTED) on TCP port 50051.
flow grpc_rate_limited_8(w, l) {
    w -> l grpc service "ai.v1.EmbeddingService" method "GenerateEmbeddings"
    w <- l grpc service "ai.v1.EmbeddingService" method "GenerateEmbeddings" grpcstatus 8
}

compile {
    grpc_rate_limited_8(ingest_worker, llm_inference)
}
