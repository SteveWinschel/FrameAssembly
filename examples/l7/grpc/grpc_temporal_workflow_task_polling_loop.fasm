// PROMPT: Temporal workflow worker long-polling PollWorkflowTaskQueue and completing workflow tasks in a COMPILE LOOP.
// TOKENS: host, ip, mac, flow, grpc, service, method, srcport, dstport, grpcstatus, wait, ms, compile

// INSTRUCTION: Define Temporal workflow worker pod.
host temporal_worker {
    ip 10.115.72.33
    mac 02:42:0a:73:48:21
}

// INSTRUCTION: Define Temporal frontend service listening on TCP port 7233.
host temporal_frontend {
    ip 10.115.72.1
    mac 02:42:0a:73:48:01
}

// INSTRUCTION: Poll workflow task queue on port 7233 and respond with RespondWorkflowTaskCompleted.
flow grpc_temporal_poll(w, fe) {
    w -> fe grpc service "temporal.api.workflowservice.v1.WorkflowService" method "PollWorkflowTaskQueue" srcport 57233 dstport 7233
    w <- fe grpc service "temporal.api.workflowservice.v1.WorkflowService" method "PollWorkflowTaskQueue" srcport 7233 dstport 57233 grpcstatus 0
    w -> fe grpc service "temporal.api.workflowservice.v1.WorkflowService" method "RespondWorkflowTaskCompleted" srcport 57233 dstport 7233
    w <- fe grpc service "temporal.api.workflowservice.v1.WorkflowService" method "RespondWorkflowTaskCompleted" srcport 7233 dstport 57233 grpcstatus 0 wait 25ms
}

// INSTRUCTION: Execute 3 workflow task poll and completion cycles in a COMPILE LOOP.
compile {
    grpc_temporal_poll(temporal_worker, temporal_frontend) // cycle 1
    grpc_temporal_poll(temporal_worker, temporal_frontend) // cycle 2
    grpc_temporal_poll(temporal_worker, temporal_frontend) // cycle 3
}
