// AI gateway invoking NVIDIA Triton Inference Server ModelStreamInfer gRPC
// method for LLM token generation.
// Wireshark: grpc || http2 || tcp.port == 8001

// AI orchestrator gateway requesting LLM completion.
host llm_gateway {
    ip 10.200.50.10
    mac 00:02:c9:c8:32:0a
}

// GPU node running Triton Inference Server on gRPC port 8001.
host triton_gpu_srv {
    ip 10.200.50.100
    mac 00:02:c9:c8:32:64
}

// Check ModelReady status then stream tokens via ModelStreamInfer on TCP port
// 8001. gRPC status codes observed: 0 (OK) on TCP port 8001.
flow grpc_triton_infer(gw, gpu) {
    gw -> gpu grpc service "inference.GRPCInferenceService" method "ModelReady" srcport 58001 dstport 8001 df ipid 8001
    gw <- gpu grpc service "inference.GRPCInferenceService" method "ModelReady" srcport 8001 dstport 58001 df ipid 8002 grpcstatus 0
    gw -> gpu grpc service "inference.GRPCInferenceService" method "ModelStreamInfer" srcport 58001 dstport 8001 df ipid 8003 payload "model=llama3-70b"
    gw <- gpu grpc service "inference.GRPCInferenceService" method "ModelStreamInfer" srcport 8001 dstport 58001 df ipid 8004 grpcstatus 0
}

compile {
    grpc_triton_infer(llm_gateway, triton_gpu_srv)
}
