// gRPC unary Remote Procedure Call requesting user profile information.
// Wireshark: grpc || http2
// Automatic Ethernet MAC addresses and TCP port 50051 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 10.0.0.10 }

host server { ip 10.0.0.1 }

flow grpc_call(c, s) {
    c -> s grpc service "UserService" method "GetUserProfile"
}

compile {
    grpc_call(client, server)
}
