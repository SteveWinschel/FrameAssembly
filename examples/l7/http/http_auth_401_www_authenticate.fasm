// PROMPT: HTTP 401 Unauthorized challenge with WWW-Authenticate header and authenticated retry.
// TOKENS: host, ip, flow, s, http, method, uri, hosthdr, status, reason, header, body, compile

// INSTRUCTION: Define API consumer service.
host api_consumer { ip 172.19.0.25 }

// INSTRUCTION: Define protected OAuth2 resource server.
host resource_srv { ip 172.19.0.1 }

// INSTRUCTION: Request resource without credentials, receive 401 WWW-Authenticate, and retry with Bearer token.
flow http_auth_401_challenge(c, s) {
    c -> s http method "GET" uri "/api/secrets" hosthdr "vault.internal"
    c <- s http status 401 reason "Unauthorized" header "WWW-Authenticate" "Bearer realm=\"vault\""
    c -> s http method "GET" uri "/api/secrets" hosthdr "vault.internal" header "Authorization" "Bearer tok_998877"
    c <- s http status 200 reason "OK" body "{\"key\":\"ok\"}"
}

// INSTRUCTION: Compile the HTTP 401 authentication challenge flow.
compile {
    http_auth_401_challenge(api_consumer, resource_srv)
}
