// HTTP data streaming upload using chunked Transfer-Encoding over 802.1Q
// tagged VLAN 220.
// Wireshark: http

// Telemetry sensor streaming node.
host telemetry_streamer {
    ip 10.99.22.4
}

// Central event ingest receiver cluster.
host ingest_cluster {
    ip 10.99.22.1
}

// Stream chunked metrics over prioritized VLAN 220. Encapsulation and QoS
// markings: 802.1Q VLAN 220.
flow http_chunked_stream(c, s) {
    c -> s http method "POST" uri "/stream/events"
           hosthdr "ingest.telemetry.net"
           header "Transfer-Encoding" "chunked"
           vlan 220 pcp 4 dei 0
    c <- s http status 200 reason "OK"
           header "Transfer-Encoding" "chunked"
           vlan 220 pcp 4 dei 0
}

compile {
    http_chunked_stream(telemetry_streamer, ingest_cluster)
}
