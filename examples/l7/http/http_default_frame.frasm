// HTTP/1.1 starter request on TCP port 80 using built-in defaults. Omitting
// extra keywords emits a 'GET / HTTP/1.1' request with default Host header.
// Wireshark: http

host web_client {
    ip 192.168.80.100
    mac 00:16:3e:80:00:01
}

host nginx_srv {
    ip 192.168.80.1
    mac 00:16:3e:80:00:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    web_client -> nginx_srv http
}
