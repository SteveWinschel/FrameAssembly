// Dual-stack HTTP GraphQL query execution over both IPv4 and IPv6 endpoints.
// Wireshark: http

// IPv4 frontend SSR worker.
host ssr_v4 { ip 10.11.80.10 }

// IPv4 GraphQL gateway.
host gql_v4 { ip 10.11.80.1 }

// IPv6 frontend SSR worker.
host ssr_v6 { ip 2001:db8:80::10 }

// IPv6 GraphQL gateway.
host gql_v6 { ip 2001:db8:80::1 }

// POST GraphQL query JSON and return data payload. Runs the same flow
// definition over both IPv4 and IPv6 host pairs.
flow http_graphql_query(c, s) {
    c -> s http method "POST" uri "/graphql" hosthdr "gql.example.com" contenttype "application/json" body "{\"query\":\"{viewer{id}}\"}"
    c <- s http status 200 reason "OK" contenttype "application/json" body "{\"data\":{\"viewer\":{\"id\":\"u1\"}}}"
}

compile {
    http_graphql_query(ssr_v4, gql_v4)
    http_graphql_query(ssr_v6, gql_v6)
}
