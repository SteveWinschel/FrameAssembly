// HTTP GET request for non-existent resource resulting in 404 Not Found
// response.
// Wireshark: http

host client_404 {
    ip 192.168.104.55
}

host web_origin_404 {
    ip 192.168.104.10
}

// Request and 404 Not Found response exchange.
flow http_missing_resource(c, s) {
    c -> s http method "GET" uri "/missing/doc.html"
           hosthdr "docs.example.org"
           useragent "Wget/1.21.3"
    c <- s http status 404 reason "Not Found"
           contenttype "text/html"
           body "<html><body>404 Not Found</body></html>"
}

compile {
    http_missing_resource(client_404, web_origin_404)
}
