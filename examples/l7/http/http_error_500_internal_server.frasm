// HTTP POST request triggering unhandled backend database exception and 500
// Internal Server Error.
// Wireshark: http

host billing_svc {
    ip 10.200.50.8
}

host payment_gateway {
    ip 10.200.50.1
}

// Send POST payment charge and receive 500 error response.
flow http_server_fault(c, s) {
    c -> s http method "POST" uri "/v1/charge"
           hosthdr "pay.cloudcorp.io"
           contenttype "application/json"
           body "{\"txn_id\":\"tx-9912\"}"
    c <- s http status 500 reason "Internal Server Error"
           contenttype "application/json"
           body "{\"error\":\"database_timeout\"}"
}

compile {
    http_server_fault(billing_svc, payment_gateway)
}
