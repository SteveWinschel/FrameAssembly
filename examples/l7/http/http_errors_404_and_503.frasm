// HTTP 404 Not Found and 503 Service Unavailable error responses with
// Retry-After header.
// Wireshark: http

// Synthetic monitoring probe.
host synth_probe { ip 10.75.1.10 }

host origin_srv { ip 10.75.1.100 }

// Probe missing route (404) and overloaded health endpoint (503 Retry-After).
flow http_404_and_503(p, o) {
    p -> o http method "GET" uri "/missing.js" hosthdr "cdn.example.com"
    p <- o http status 404 reason "Not Found" body "Not Found"
    p -> o http method "GET" uri "/checkout" hosthdr "cdn.example.com"
    p <- o http status 503 reason "Service Unavailable" header "Retry-After" "30" body "Overloaded"
}

compile {
    http_404_and_503(synth_probe, origin_srv)
}
