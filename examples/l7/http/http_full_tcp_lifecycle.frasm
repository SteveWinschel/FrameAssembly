// Full TCP 3-way handshake, HTTP GET with Host and User-Agent headers, 200
// OK, and FIN teardown.
// Wireshark: tcp || http

host browser_host { ip 10.0.80.25 }

host apache_srv { ip 10.0.80.1 }

// Complete TCP handshake, fetch /index.html with custom User-Agent, and close
// TCP session.
flow http_full_tcp_session(c, s) {
    c -> s tcp syn srcport 51080 dstport 80
    c <- s tcp syn ack
    c -> s tcp ack
    c -> s http method "GET" uri "/index.html" hosthdr "www.example.com" useragent "Mozilla/5.0"
    c <- s http status 200 reason "OK" contenttype "text/html" body "<html><body>Hello</body></html>"
    c -> s tcp fin ack
    c <- s tcp fin ack
    c -> s tcp ack
}

compile {
    http_full_tcp_session(browser_host, apache_srv)
}
