// HTTP 206 Partial Content byte-range video segment fetch on custom port 8080
// with DF flag.
// Wireshark: http || tcp.port == 8080

host media_player { ip 192.168.95.40 }

// Local HLS media caching server on port 8080.
host media_cache { ip 192.168.95.1 }

// Send Range bytes=0-1023 request on port 8080 and receive 206 Partial
// Content.
flow http_range_206(m, c) {
    m -> c http method "GET" uri "/video/seg_01.mp4" hosthdr "media.local:8080" header "Range" "bytes=0-1023" srcport 53000 dstport 8080 df ipid 0x8080
    m <- c http status 206 reason "Partial Content" contenttype "video/mp4" header "Content-Range" "bytes 0-1023/1048576" srcport 8080 dstport 53000 df ipid 0x8081
}

compile {
    http_range_206(media_player, media_cache)
}
