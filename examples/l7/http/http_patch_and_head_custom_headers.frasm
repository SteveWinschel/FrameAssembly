// HTTP PATCH partial JSON document update and HTTP HEAD metadata check with
// custom HEADER pairs.
// Wireshark: http

host spa_client { ip 10.25.0.50 }

// Backend API gateway.
host api_gw { ip 10.25.0.1 }

// Send HEAD check with If-None-Match header followed by PATCH partial update
// with Authorization.
flow http_head_and_patch(c, s) {
    c -> s http method "HEAD" uri "/v2/profile" hosthdr "app.example.io" header "If-None-Match" "\"etag-101\""
    c <- s http status 200 reason "OK" header "ETag" "\"etag-102\""
    c -> s http method "PATCH" uri "/v2/profile" hosthdr "app.example.io" contenttype "application/merge-patch+json" header "Authorization" "Bearer eyJhbGci" body "{\"theme\":\"dark\"}"
    c <- s http status 200 reason "OK"
}

compile {
    http_head_and_patch(spa_client, api_gw)
}
