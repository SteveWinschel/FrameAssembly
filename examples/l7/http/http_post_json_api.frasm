// HTTP/1.1 POST API request submitting JSON payload and receiving 201
// Created.
// Wireshark: http

host client { ip 10.0.0.5 }

host server { ip 10.0.0.1 }

flow http_post(c, s) {
    c -> s http method "POST" uri "/api/v1/telemetry" contenttype "application/json" body "{\"temp\":22.5}"
    c <- s http status 201 reason "Created" body "{\"status\":\"recorded\"}"
}

compile {
    http_post(client, server)
}
