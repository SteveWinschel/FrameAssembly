// PROMPT: Generate a Prometheus server HTTP scrape of /metrics in OpenMetrics text format over MPLS label 9090.
// TOKENS: host, ip, mac, flow, exp, http, method, uri, hosthdr, useragent, header, mpls, wait, ms, status, reason, contenttype, body, compile

// INSTRUCTION: Define the central Prometheus scraper instance.
host prometheus_srv {
    ip 172.19.90.10
    mac 00:1b:21:5a:90:0a
}

// INSTRUCTION: Define the node_exporter telemetry target across an MPLS backbone.
host node_exporter_tgt {
    ip 172.19.90.50
    mac 00:1b:21:5a:90:32
}

// INSTRUCTION: Request /metrics with OpenMetrics Accept header and return counter metrics over MPLS 9090.
flow http_prometheus_scrape(prom, exp) {
    prom -> exp http method "GET" uri "/metrics" hosthdr "node01.metrics.local"
        useragent "Prometheus/2.51.0" header "Accept" "application/openmetrics-text;version=1.0.0" mpls 9090 wait 4ms
    prom <- exp http status 200 reason "OK" contenttype "application/openmetrics-text;version=1.0.0"
        body "node_network_receive_bytes_total{device='eth0'} 948102400\n# EOF\n" mpls 9090
}

// INSTRUCTION: Compile the MPLS-encapsulated Prometheus HTTP metrics scrape flow.
compile {
    http_prometheus_scrape(prometheus_srv, node_exporter_tgt)
}
