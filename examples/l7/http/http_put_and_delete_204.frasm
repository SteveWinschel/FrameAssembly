// HTTP PUT idempotent resource replacement and HTTP DELETE resource removal
// with 204 No Content.
// Wireshark: http

host api_admin { ip 172.16.80.10 }

host rest_svc { ip 172.16.80.2 }

// Update user record via PUT and delete stale session via DELETE returning
// 204.
flow http_put_and_delete(c, s) {
    c -> s http method "PUT" uri "/api/v1/users/42" hosthdr "api.internal" contenttype "application/json" body "{\"role\":\"admin\"}"
    c <- s http status 200 reason "OK" contenttype "application/json" body "{\"updated\":true}"
    c -> s http method "DELETE" uri "/api/v1/sessions/99" hosthdr "api.internal"
    c <- s http status 204 reason "No Content"
}

compile {
    http_put_and_delete(api_admin, rest_svc)
}
