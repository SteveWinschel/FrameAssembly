// PROMPT: HTTP telemetry query encapsulated in QinQ 802.1ad double VLAN tags and carrier MPLS label stack.
// TOKENS: host, ip, flow, s, http, method, uri, hosthdr, qinq, innervlan, mpls, status, reason, compile

// INSTRUCTION: Define tenant application client in carrier network.
host tenant_app {
    ip 10.250.77.10
}

// INSTRUCTION: Define carrier health check proxy endpoint.
host carrier_proxy {
    ip 10.250.77.1
}

// INSTRUCTION: Perform health check with double VLAN and MPLS encapsulation.
flow http_carrier_encap(c, s) {
    c -> s http method "GET" uri "/healthz"
           hosthdr "status.carrier.net"
           qinq 200 innervlan 100 mpls 1048
    c <- s http status 200 reason "OK"
           qinq 200 innervlan 100 mpls 1048
}

// INSTRUCTION: Compile QinQ and MPLS encapsulated HTTP scenario.
compile {
    http_carrier_encap(tenant_app, carrier_proxy)
}
