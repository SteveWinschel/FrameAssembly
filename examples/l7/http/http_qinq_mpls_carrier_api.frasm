// HTTP telemetry query encapsulated in QinQ 802.1ad double VLAN tags and
// carrier MPLS label stack.
// Wireshark: http

// Tenant application client in carrier network.
host tenant_app {
    ip 10.250.77.10
}

host carrier_proxy {
    ip 10.250.77.1
}

// Perform health check with double VLAN and MPLS encapsulation. Encapsulation
// and QoS markings: 802.1ad QinQ S-VLAN 200 / C-VLAN 100, MPLS label 1048.
flow http_carrier_encap(c, s) {
    c -> s http method "GET" uri "/healthz"
           hosthdr "status.carrier.net"
           qinq 200 innervlan 100 mpls 1048
    c <- s http status 200 reason "OK"
           qinq 200 innervlan 100 mpls 1048
}

compile {
    http_carrier_encap(tenant_app, carrier_proxy)
}
