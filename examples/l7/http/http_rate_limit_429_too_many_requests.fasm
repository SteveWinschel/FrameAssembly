// PROMPT: Generate an HTTP API rate-limiting rejection returning 429 Too Many Requests and a Retry-After header.
// TOKENS: host, ip, mac, flow, http, method, uri, hosthdr, contenttype, body, wait, ms, status, reason, header, compile

// INSTRUCTION: Define the automated API scraper exceeding its token-bucket quota.
host api_consumer {
    ip 172.22.80.91
    mac 00:25:90:16:50:5b
}

// INSTRUCTION: Define the API gateway enforcing per-client request rate limits.
host kong_api_gw {
    ip 172.22.80.10
    mac 00:25:90:16:50:0a
}

// INSTRUCTION: Send an API request and receive 429 Too Many Requests with Retry-After and X-RateLimit headers.
flow http_rate_limit_429(client, gw) {
    client -> gw http method "POST" uri "/v2/orders/quote" hosthdr "api.trading.local"
        contenttype "application/json" body "{'symbol':'BTC-USD','qty':5}" wait 2ms
    client <- gw http status 429 reason "Too Many Requests" contenttype "application/json"
        header "Retry-After" "30" header "X-RateLimit-Remaining" "0" body "{'error':'rate_limit_exceeded','retry_after_sec':30}"
}

// INSTRUCTION: Compile the HTTP 429 Too Many Requests API rate-limit scenario.
compile {
    http_rate_limit_429(api_consumer, kong_api_gw)
}
