// HTTP 301 Moved Permanently redirect followed by GET request to the new
// Location URI.
// Wireshark: http

host redir_client { ip 10.18.80.12 }

// Reverse proxy load balancer.
host rev_proxy { ip 10.18.80.1 }

// Request legacy URI, receive 301 with Location header, and fetch new URI.
flow http_redirect_301(c, p) {
    c -> p http method "GET" uri "/legacy-docs" hosthdr "docs.example.com"
    c <- p http status 301 reason "Moved Permanently" header "Location" "/v2/docs"
    c -> p http method "GET" uri "/v2/docs" hosthdr "docs.example.com"
    c <- p http status 200 reason "OK"
}

compile {
    http_redirect_301(redir_client, rev_proxy)
}
