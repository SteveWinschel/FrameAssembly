// HTTP/1.1 REST API interaction over IPv6 with GET request, headers, and 200
// OK JSON response.
// Wireshark: http

host rest_client { ip 2001:db8:cafe::1 }

host rest_server { ip 2001:db8:cafe::2 }

// HTTP GET request and JSON response flow.
flow http_api_flow(c, s) {
    c -> s http get uri "/v1/metrics" hosthdr "api.local"
    c <- s http status 200 body "{\"status\":\"ok\"}"
}

compile {
    http_api_flow(rest_client, rest_server)
}
