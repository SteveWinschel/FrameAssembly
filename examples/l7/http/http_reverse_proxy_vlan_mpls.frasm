// HTTP reverse proxy X-Forwarded-For request forwarding over VLAN 80 and MPLS
// label 8000.
// Wireshark: http

// Edge CDN reverse proxy.
host cdn_edge { ip 172.25.80.1 }

host internal_origin { ip 172.25.80.50 }

// Forward HTTP GET with X-Forwarded-For and X-Request-ID headers over VLAN 80
// and MPLS. Encapsulation and QoS markings: 802.1Q VLAN 80, MPLS label 8000,
// DSCP 20.
flow http_proxy_vlan_mpls(e, o) {
    e -> o http method "GET" uri "/static/app.bundle.js" hosthdr "assets.example.com" header "X-Forwarded-For" "203.0.113.9" header "X-Request-ID" "req-771" vlan 80 mpls 8000 dscp 20
    e <- o http status 200 reason "OK" header "Cache-Control" "max-age=31536000" vlan 80 mpls 8000 dscp 20
}

compile {
    http_proxy_vlan_mpls(cdn_edge, internal_origin)
}
