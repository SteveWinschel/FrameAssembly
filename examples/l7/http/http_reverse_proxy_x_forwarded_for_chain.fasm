// PROMPT: Simulate an HTTP reverse-proxy ingress forwarding request with X-Forwarded-For, X-Forwarded-Proto, and Traceparent headers.
// TOKENS: host, ip, mac, flow, http, srcport, dstport, method, uri, hosthdr, header, vlan, wait, ms, status, reason, contenttype, body, compile

// INSTRUCTION: Define the edge load balancer forwarding client requests to an internal upstream pod.
host envoy_ingress_lb {
    ip 10.50.1.5
    mac 00:16:3e:32:01:05
}

// INSTRUCTION: Define the internal backend microservice pod on port 8080.
host upstream_app_pod {
    ip 10.50.2.40
    mac 00:16:3e:32:02:28
}

// INSTRUCTION: Forward GET /api/v1/profile on DSTPORT 8080 with W3C traceparent and X-Forwarded-For headers.
flow http_proxy_forwarded_flow(lb, pod) {
    lb -> pod http srcport 48200 dstport 8080 method "GET" uri "/api/v1/profile" hosthdr "users.internal.svc"
        header "X-Forwarded-For" "203.0.113.77, 10.50.1.5" header "X-Forwarded-Proto" "https"
        header "traceparent" "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" vlan 50 wait 4ms
    lb <- pod http srcport 8080 dstport 48200 status 200 reason "OK" contenttype "application/json"
        body "{'user_id':'u-9921','tier':'enterprise'}" vlan 50
}

// INSTRUCTION: Compile the reverse proxy X-Forwarded-For HTTP flow.
compile {
    http_proxy_forwarded_flow(envoy_ingress_lb, upstream_app_pod)
}
