// PROMPT: HTTP 101 Switching Protocols upgrade handshake over IEEE 802.1ad QinQ double VLAN tags.
// TOKENS: host, ip, flow, s, http, method, uri, hosthdr, header, qinq, innervlan, status, reason, compile

// INSTRUCTION: Define realtime dashboard client.
host rt_client { ip 10.65.1.20 }

// INSTRUCTION: Define event streaming server.
host stream_srv { ip 10.65.1.1 }

// INSTRUCTION: Request Connection Upgrade to websocket and receive HTTP 101 Switching Protocols over QinQ.
flow http_upgrade_101_qinq(c, s) {
    c -> s http method "GET" uri "/realtime" hosthdr "ws.example.com" header "Connection" "Upgrade" header "Upgrade" "websocket" qinq 1800 innervlan 80
    c <- s http status 101 reason "Switching Protocols" header "Connection" "Upgrade" header "Upgrade" "websocket" qinq 1800 innervlan 80
}

// INSTRUCTION: Compile the QinQ HTTP 101 protocol upgrade scenario.
compile {
    http_upgrade_101_qinq(rt_client, stream_srv)
}
