// 3GPP 5G N12 interface HTTP/2 exchange between AMF and AUSF performing UE
// 5G-AKA authentication on Stream 17.
// Wireshark: http2

// 5G Access and Mobility Management Function (AMF).
host amf_node {
    ip 172.31.12.10
    mac 00:1e:49:1f:0c:0a
}

host ausf_node {
    ip 172.31.12.20
    mac 00:1e:49:1f:0c:14
}

// Nausf_UEAuthentication POST request and 201 Created response on HTTP/2
// Stream 17. Encapsulation and QoS markings: DSCP 34.
flow http2_5g_n12_ausf(amf, ausf) {
    amf -> ausf http2 headers streamid 17 dscp 34
    amf -> ausf http2 data streamid 17 dscp 34 payload "{'supiOrSuci':'suci-0-001-01-0'}"
    amf <- ausf http2 headers streamid 17 dscp 34
    amf <- ausf http2 data streamid 17 dscp 34 payload "{'authType':'5G_AKA'}"
}

compile {
    http2_5g_n12_ausf(amf_node, ausf_node)
}
