// PROMPT: 5G Service-Based Architecture (SBA) Nnrf NFDiscovery HTTP/2 exchange over MPLS.
// TOKENS: host, ip, flow, http2, headers, streamid, mpls, exp, bos, mplsttl, dscp, payload, compile

// INSTRUCTION: Define 5G AMF network function consumer.
host nf_amf { ip 172.31.50.10 }

// INSTRUCTION: Define 5G NRF Network Repository Function producer.
host nf_nrf { ip 172.31.50.1 }

// INSTRUCTION: Query 3GPP Nnrf_NFDiscovery over HTTP/2 Stream 9 encapsulated in MPLS label 5000.
flow http2_5g_sba_nrf(amf, nrf) {
    amf -> nrf http2 headers streamid 9 mpls 5000 exp 5 bos 1 mplsttl 64 dscp 34 payload "target-nf-type=SMF"
    amf <- nrf http2 headers streamid 9 mpls 5000 exp 5 bos 1 mplsttl 64 dscp 34 payload "{\"nfInstances\":[]}"
}

// INSTRUCTION: Compile the 5G SBA HTTP/2 over MPLS scenario.
compile {
    http2_5g_sba_nrf(nf_amf, nf_nrf)
}
