// Mobile backend server dispatching push notifications over HTTP/2 Streams 1
// and 3 to a push gateway.
// Wireshark: http2

// Mobile backend push notification worker.
host push_worker {
    ip 10.105.4.30
    mac 02:42:0a:69:04:1e
}

// APNs HTTP/2 push notification gateway.
host apns_gateway {
    ip 10.105.4.1
    mac 02:42:0a:69:04:01
}

// Dispatch two concurrent push notifications on Streams 1 and 3 with JSON
// alert payloads.
flow http2_apns_push(w, gw) {
    w -> gw http2 headers streamid 1
    w -> gw http2 data streamid 1 payload "{'aps':{'alert':'New message','sound':'default'}}"
    w -> gw http2 headers streamid 3
    w -> gw http2 data streamid 3 payload "{'aps':{'badge':5}}"
    w <- gw http2 headers streamid 1
    w <- gw http2 headers streamid 3
}

compile {
    http2_apns_push(push_worker, apns_gateway)
}
