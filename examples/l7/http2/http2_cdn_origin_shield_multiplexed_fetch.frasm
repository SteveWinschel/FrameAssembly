// CDN edge cache multiplexing three concurrent asset revalidation streams
// (11, 13, 15) over a single origin connection.
// Wireshark: http2

// CDN edge PoP proxy node.
host cdn_edge_proxy {
    ip 198.51.100.12
    mac 00:25:90:64:00:0c
}

host origin_shield {
    ip 198.51.100.1
    mac 00:25:90:64:00:01
}

// Multiplex conditional GET HEADERS and DATA responses on odd Streams 11, 13,
// and 15.
flow http2_cdn_origin_mux(edge, origin) {
    edge -> origin http2 headers streamid 11
    edge -> origin http2 headers streamid 13
    edge -> origin http2 headers streamid 15
    edge <- origin http2 headers streamid 11
    edge <- origin http2 data streamid 11 payload "asset-bundle-main.js"
    edge <- origin http2 headers streamid 13
    edge <- origin http2 headers streamid 15
}

compile {
    http2_cdn_origin_mux(cdn_edge_proxy, origin_shield)
}
