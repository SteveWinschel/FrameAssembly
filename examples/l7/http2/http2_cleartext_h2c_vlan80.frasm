// PROMPT: HTTP/2 Cleartext (h2c) prior-knowledge microservice communication on TCP port 8080 over VLAN 80.
// TOKENS: host, ip, flow, http2, preface, srcport, dstport, vlan, pcp, dscp, settings, streamid, headers, compile

// INSTRUCTION: Define internal ingress controller.
host ingress_ctrl { ip 10.80.80.5 }

// INSTRUCTION: Define Go h2c backend service on port 8080.
host h2c_backend { ip 10.80.80.40 }

// INSTRUCTION: Initiate h2c prior-knowledge session on TCP port 8080 tagged with VLAN 80.
flow http2_h2c_vlan(i, b) {
    i -> b http2 preface srcport 50800 dstport 8080 vlan 80 pcp 3 dscp 26
    i -> b http2 settings streamid 0 srcport 50800 dstport 8080 vlan 80 pcp 3 dscp 26
    i -> b http2 headers streamid 1 srcport 50800 dstport 8080 vlan 80 pcp 3 dscp 26
    i <- b http2 headers streamid 1 srcport 8080 dstport 50800 vlan 80 pcp 3 dscp 26
}

// INSTRUCTION: Compile the h2c cleartext HTTP/2 over VLAN 80 scenario.
compile {
    http2_h2c_vlan(ingress_ctrl, h2c_backend)
}
