// Full TCP 3-way handshake followed by HTTP/2 Preface, Settings, and
// concurrent streams 1, 3, and 5.
// Wireshark: tcp || http2

// Modern web client multiplexing asset requests.
host mux_browser { ip 172.16.43.50 }

// CDN HTTP/2 termination proxy.
host cdn_h2 { ip 172.16.43.1 }

// Perform TCP handshake, HTTP/2 connection preface, and open odd-numbered
// client streams 1, 3, 5.
flow http2_concurrent_streams(b, c) {
    b -> c tcp syn srcport 54443 dstport 443
    b <- c tcp syn ack
    b -> c tcp ack
    b -> c http2 preface
    b -> c http2 settings streamid 0
    b <- c http2 settings streamid 0
    b -> c http2 headers streamid 1
    b -> c http2 headers streamid 3
    b -> c http2 headers streamid 5
    b <- c http2 headers streamid 1
    b <- c http2 headers streamid 3
    b <- c http2 headers streamid 5
}

compile {
    http2_concurrent_streams(mux_browser, cdn_h2)
}
