// PROMPT: HTTP/2 extended CONNECT tunnel established on Stream 1 for proxied TCP traffic through a corporate forward proxy.
// TOKENS: host, ip, mac, flow, http2, headers, streamid, payload, data, compile

// INSTRUCTION: Define corporate workstation establishing an HTTP/2 CONNECT tunnel.
host corp_workstation {
    ip 10.18.40.22
    mac 00:21:70:12:28:16
}

// INSTRUCTION: Define corporate secure web gateway HTTP/2 proxy.
host swg_h2_proxy {
    ip 10.18.40.1
    mac 00:21:70:12:28:01
}

// INSTRUCTION: Send CONNECT HEADERS on Stream 1, receive 200 OK HEADERS, and tunnel DATA frames bidirectionally.
flow http2_connect_tunnel(c, p) {
    c -> p http2 headers streamid 1 payload ":method=CONNECT :authority=git.internal:22"
    c <- p http2 headers streamid 1 payload ":status=200"
    c -> p http2 data streamid 1 payload "SSH-2.0-OpenSSH_9.6"
    c <- p http2 data streamid 1 payload "SSH-2.0-OpenSSH_9.6-Server"
}

// INSTRUCTION: Compile the HTTP/2 CONNECT tunnel proxy scenario.
compile {
    http2_connect_tunnel(corp_workstation, swg_h2_proxy)
}
