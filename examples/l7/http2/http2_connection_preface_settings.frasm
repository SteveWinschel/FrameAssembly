// HTTP/2 client connection preface and initial SETTINGS frame exchange.
// Wireshark: http2
// Automatic Ethernet MAC addresses and TCP port 443 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.100 }

host server { ip 192.168.1.1 }

flow http2_init(c, s) {
    c -> s http2 preface
    c -> s http2 settings
    c <- s http2 settings
}

compile {
    http2_init(client, server)
}
