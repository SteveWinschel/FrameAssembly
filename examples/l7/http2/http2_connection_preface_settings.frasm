// PROMPT: HTTP/2 client connection preface and initial SETTINGS frame exchange.
// TOKENS: host, ip, flow, s, http2, preface, settings, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
flow http2_init(c, s) {
    c -> s http2 preface
    c -> s http2 settings
    c <- s http2 settings
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    http2_init(client, server)
}
