// HTTP/2 starter frame on TCP port 443 using built-in defaults. Omitting
// extra keywords emits a 9-byte HTTP/2 SETTINGS control frame on stream 0.
// Wireshark: http2 || tcp.port == 443

host h2_client {
    ip 192.168.43.10
    mac 00:1a:11:44:33:01
}

host h2_server {
    ip 192.168.43.1
    mac 00:1a:11:44:33:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    h2_client -> h2_server http2
}
