// HTTP/2 DoH (DNS over HTTPS) wireformat query carried inside Stream 13 with
// DF flag.
// Wireshark: http2

host doh_client { ip 192.168.53.10 }

// Public DoH resolver on port 443.
host doh_server { ip 1.1.1.1 }

// Send HTTP/2 HEADERS on Stream 13 carrying /dns-query path and receive
// response.
flow http2_doh_query(c, s) {
    c -> s http2 headers streamid 13 df ipid 0x4431 payload "/dns-query?dns=AAABAAABAAAAAAAAA3d3dw"
    c <- s http2 headers streamid 13 df ipid 0x4432
}

compile {
    http2_doh_query(doh_client, doh_server)
}
