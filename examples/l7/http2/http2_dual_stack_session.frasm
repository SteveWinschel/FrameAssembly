// Dual-stack HTTP/2 connection preface, settings, and stream headers over
// IPv4 and IPv6.
// Wireshark: http2

host h2_c4 { ip 192.168.143.10 }

host h2_s4 { ip 192.168.143.1 }

host h2_c6 { ip 2001:db8:443::10 }

host h2_s6 { ip 2001:db8:443::1 }

// Exchange HTTP/2 preface, settings, and stream 1 headers over both IPv4
// and IPv6 host pairs using one shared flow.
flow http2_dual_exchange(c, s) {
    c -> s http2 preface
    c -> s http2 settings streamid 0
    c <- s http2 settings streamid 0
    c -> s http2 headers streamid 1
    c <- s http2 headers streamid 1
}

compile {
    http2_dual_exchange(h2_c4, h2_s4)
    http2_dual_exchange(h2_c6, h2_s6)
}
