// RFC 9113 two-stage graceful HTTP/2 connection drain sending an advisory
// GOAWAY followed by final GOAWAY.
// Wireshark: http2

// External API consumer connected to an Envoy edge proxy.
host ext_consumer {
    ip 192.0.2.88
    mac 00:1b:17:02:00:58
}

// Envoy edge ingress proxy initiating graceful connection drain.
host envoy_ingress {
    ip 192.0.2.1
    mac 00:1b:17:02:00:01
}

// Send initial GOAWAY + PING, complete in-flight Stream 9, and send final
// GOAWAY.
flow http2_two_stage_goaway(c, e) {
    c -> e http2 headers streamid 9
    c <- e http2 goaway streamid 0
    c <- e http2 ping streamid 0
    c -> e http2 ping streamid 0
    c <- e http2 headers streamid 9
    c <- e http2 data streamid 9 payload "{'status':'completed_before_drain'}"
    c <- e http2 goaway streamid 0
}

compile {
    http2_two_stage_goaway(ext_consumer, envoy_ingress)
}
