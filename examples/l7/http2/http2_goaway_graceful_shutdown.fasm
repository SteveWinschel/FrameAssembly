// PROMPT: HTTP/2 graceful connection shutdown via GOAWAY frame on Stream 0 followed by TCP FIN teardown.
// TOKENS: host, ip, flow, s, http2, headers, streamid, goaway, tcp, fin, ack, compile

// INSTRUCTION: Define HTTP/2 client host.
host h2_peer_c { ip 10.43.0.25 }

// INSTRUCTION: Define HTTP/2 origin server initiating drain.
host h2_peer_s { ip 10.43.0.1 }

// INSTRUCTION: Complete active stream 1 headers, emit GOAWAY on stream 0, and close TCP connection.
flow http2_goaway_shutdown(c, s) {
    c -> s http2 headers streamid 1
    c <- s http2 headers streamid 1
    c <- s http2 goaway streamid 0
    c -> s tcp fin ack
    c <- s tcp fin ack
    c -> s tcp ack
}

// INSTRUCTION: Compile the HTTP/2 GOAWAY connection drain scenario.
compile {
    http2_goaway_shutdown(h2_peer_c, h2_peer_s)
}
