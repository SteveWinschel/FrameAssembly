// HTTP/2 graceful connection shutdown via GOAWAY frame on Stream 0 followed
// by TCP FIN teardown.
// Wireshark: http2 || tcp

host h2_peer_c { ip 10.43.0.25 }

host h2_peer_s { ip 10.43.0.1 }

// Complete active stream 1 headers, emit GOAWAY on stream 0, and close TCP
// connection.
flow http2_goaway_shutdown(c, s) {
    c -> s http2 headers streamid 1
    c <- s http2 headers streamid 1
    c <- s http2 goaway streamid 0
    c -> s tcp fin ack
    c <- s tcp fin ack
    c -> s tcp ack
}

compile {
    http2_goaway_shutdown(h2_peer_c, h2_peer_s)
}
