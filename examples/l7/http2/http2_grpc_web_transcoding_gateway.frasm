// API gateway accepting an HTTP/2 browser request on Stream 1 and invoking a
// backend gRPC service.
// Wireshark: http2 || grpc || http2

// Browser client speaking HTTP/2 to an edge gateway.
host web_h2_client { ip 10.72.1.50 }

// Envoy gRPC-JSON transcoding gateway.
host transcode_gw { ip 10.72.1.1 }

// Backend gRPC catalog microservice.
host catalog_grpc { ip 10.72.2.10 }

// Accept HTTP/2 request on Stream 1 from browser client.
flow frontend_h2_req(c, gw) {
    c -> gw http2 headers streamid 1
    c -> gw http2 data streamid 1 payload "{'sku':'NB-2026'}"
}

// Dispatch transcoded gRPC call to backend catalog service and return HTTP/2
// response.
flow backend_grpc_call(gw, svc) {
    gw -> svc grpc service "shop.CatalogService" method "GetItem"
    gw <- svc grpc service "shop.CatalogService" method "GetItem" grpcstatus 0
}

// Return transcoded HTTP/2 DATA response to browser client on Stream 1.
flow frontend_h2_resp(c, gw) {
    c <- gw http2 headers streamid 1
    c <- gw http2 data streamid 1 payload "{'sku':'NB-2026','inStock':true}"
}

compile {
    frontend_h2_req(web_h2_client, transcode_gw)
    backend_grpc_call(transcode_gw, catalog_grpc)
    frontend_h2_resp(web_h2_client, transcode_gw)
}
