// HTTP/2 HPACK Huffman-compressed header block transmission using HEXPAYLOAD
// over QinQ.
// Wireshark: http2

// Carrier edge proxy.
host edge_proxy { ip 100.64.43.10 }

// Upstream HTTP/2 origin cluster.
host origin_h2 { ip 100.64.43.1 }

// Transmit HTTP/2 HEADERS with custom HPACK indexed header bytes in
// HEXPAYLOAD. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 1443 /
// C-VLAN 43.
flow http2_hpack_qinq(e, o) {
    e -> o http2 headers streamid 11 qinq 1443 innervlan 43 hexpayload "828684410f777777"
    e <- o http2 headers streamid 11 qinq 1443 innervlan 43 hexpayload "88"
}

compile {
    http2_hpack_qinq(edge_proxy, origin_h2)
}
