// IPv6 HTTP/2 Multi-access Edge Computing (MEC) inference request
// encapsulated in carrier QinQ VLANs.
// Wireshark: http2

// 5G MEC edge gateway over IPv6.
host mec_edge_v6 {
    ip 2001:db8:8080:1::10
    mac 00:1e:49:80:80:0a
}

// MEC GPU inference server over IPv6.
host mec_infer_v6 {
    ip 2001:db8:8080:1::100
    mac 00:1e:49:80:80:64
}

// Exchange HTTP/2 HEADERS and DATA on Stream 1 over IPv6 with QinQ outer 700
// and inner 80. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 700 /
// C-VLAN 80.
flow http2_v6_mec_qinq(edge, srv) {
    edge -> srv http2 headers streamid 1 qinq 700 innervlan 80 flowlabel 80801 ttl 64
    edge -> srv http2 data streamid 1 qinq 700 innervlan 80 flowlabel 80801 ttl 64 hexpayload "828684418aa0e41d139d09"
    edge <- srv http2 headers streamid 1 qinq 700 innervlan 80 flowlabel 80801 ttl 64
    edge <- srv http2 data streamid 1 qinq 700 innervlan 80 flowlabel 80801 ttl 64 payload "{'bbox':[12,34,120,240]}"
}

compile {
    http2_v6_mec_qinq(mec_edge_v6, mec_infer_v6)
}
