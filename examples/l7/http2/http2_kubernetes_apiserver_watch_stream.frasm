// Kubernetes kubelet watching Pod state changes over a multiplexed HTTP/2
// Stream 7 to kube-apiserver on port 6443.
// Wireshark: http2 || tcp.port == 6443

// Kubernetes worker node kubelet agent.
host kubelet_node {
    ip 10.240.1.51
    mac 02:42:0a:f0:01:33
}

// Kubernetes control-plane kube-apiserver on TCP port 6443.
host kube_apiserver {
    ip 10.240.0.1
    mac 02:42:0a:f0:00:01
}

// Subscribe to /api/v1/pods?watch=true on Stream 7 over TCP port 6443.
flow http2_k8s_watch(kubelet, api) {
    kubelet -> api http2 headers streamid 7 srcport 48200 dstport 6443
    kubelet <- api http2 headers streamid 7 srcport 6443 dstport 48200
    kubelet <- api http2 data streamid 7 srcport 6443 dstport 48200 payload "{'type':'ADDED','kind':'Pod'}"
    kubelet -> api http2 ping streamid 0 srcport 48200 dstport 6443
    kubelet <- api http2 ping streamid 0 srcport 6443 dstport 48200
}

compile {
    http2_k8s_watch(kubelet_node, kube_apiserver)
}
