// HTTP/2 binary framing connection preface and gRPC unary remote procedure
// call over TCP 443 / 50051.
// Wireshark: http2 || grpc || http2

host grpc_client { ip 10.100.1.10 }

host grpc_server { ip 10.100.1.20 }

// HTTP/2 negotiation and gRPC procedure call flow.
flow grpc_flow(c, s) {
    c -> s http2 settings
    c <- s http2 settings
    c -> s grpc service "EchoService" method "Echo"
}

compile {
    grpc_flow(grpc_client, grpc_server)
}
