// PROMPT: HTTP/2 client uploading large POST DATA frames on Stream 3 paused until server sends WINDOW_UPDATE.
// TOKENS: host, ip, mac, flow, s, http2, headers, streamid, data, payload, windowupdate, compile

// INSTRUCTION: Define mobile client uploading media payload over HTTP/2.
host mobile_uploader {
    ip 172.20.80.45
    mac 02:42:ac:14:50:2d
}

// INSTRUCTION: Define media ingestion HTTP/2 server enforcing flow-control windows.
host media_ingest_srv {
    ip 172.20.80.1
    mac 02:42:ac:14:50:01
}

// INSTRUCTION: Send POST HEADERS and initial DATA on Stream 3, wait for server WINDOW_UPDATE, then finish DATA.
flow http2_post_backpressure(c, s) {
    c -> s http2 headers streamid 3
    c -> s http2 data streamid 3 payload "chunk-01-65535-bytes-window-exhausted"
    c <- s http2 windowupdate streamid 0
    c <- s http2 windowupdate streamid 3
    c -> s http2 data streamid 3 payload "chunk-02-final-eof"
    c <- s http2 headers streamid 3
}

// INSTRUCTION: Compile the HTTP/2 POST upload flow-control backpressure scenario.
compile {
    http2_post_backpressure(mobile_uploader, media_ingest_srv)
}
