// HTTP/2 connection coalescing across two virtual hosts sharing a wildcard
// TLS certificate on Streams 1 and 3.
// Wireshark: http2

// Enterprise client reusing a coalesced HTTP/2 connection.
host coalesced_client {
    ip 10.35.10.90
    mac 00:1a:a0:23:0a:5a
}

// Multi-domain reverse proxy terminating coalesced HTTP/2 traffic.
host multi_domain_proxy {
    ip 10.35.10.1
    mac 00:1a:a0:23:0a:01
}

// Issue PREFACE and SETTINGS, then dispatch Stream 1 to app.example.com and
// Stream 3 to api.example.com.
flow http2_coalesced_domains(c, p) {
    c -> p http2 preface
    c -> p http2 settings streamid 0
    c <- p http2 settings streamid 0
    c -> p http2 headers streamid 1 payload ":authority=app.example.com"
    c -> p http2 headers streamid 3 payload ":authority=api.example.com"
    c <- p http2 headers streamid 1
    c <- p http2 headers streamid 3
}

compile {
    http2_coalesced_domains(coalesced_client, multi_domain_proxy)
}
