// HTTP/2 long-lived Server-Sent Events (SSE) notification stream delivering
// periodic DATA frames on Stream 5.
// Wireshark: http2

// Browser dashboard client subscribing to real-time alerts.
host sse_dashboard {
    ip 10.92.10.25
    mac 00:1c:42:5c:0a:19
}

host sse_broker_srv {
    ip 10.92.10.1
    mac 00:1c:42:5c:0a:01
}

// Open Stream 5 for text/event-stream and push two event DATA frames
// separated by 20ms.
flow http2_sse_events(c, s) {
    c -> s http2 headers streamid 5
    c <- s http2 headers streamid 5
    c <- s http2 data streamid 5 payload "event: metric data: cpu=42" wait 20ms
    c <- s http2 data streamid 5 payload "event: metric data: cpu=39"
}

compile {
    http2_sse_events(sse_dashboard, sse_broker_srv)
}
