// HTTP/2 server settings renegotiation and GOAWAY rejection on high-numbered
// stream 101.
// Wireshark: http2

host scraper_h2 { ip 10.77.43.20 }

host ratelimit_h2 { ip 10.77.43.1 }

// Open stream 101, receive updated SETTINGS and WINDOW_UPDATE, then GOAWAY on
// stream 0.
flow http2_stream101_goaway(c, s) {
    c -> s http2 headers streamid 101 wait 5ms
    c <- s http2 settings streamid 0 wait 5ms
    c <- s http2 windowupdate streamid 101 wait 5ms
    c <- s http2 goaway streamid 0
}

compile {
    http2_stream101_goaway(scraper_h2, ratelimit_h2)
}
