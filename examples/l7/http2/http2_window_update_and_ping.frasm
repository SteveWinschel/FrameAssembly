// HTTP/2 flow control WINDOW_UPDATE and round-trip PING latency probe over
// IPv6.
// Wireshark: http2

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow http2_ping(c, s) {
    c -> s http2 streamid 1 windowupdate
    c -> s http2 ping
    c <- s http2 ping
}

compile {
    http2_ping(client, server)
}
