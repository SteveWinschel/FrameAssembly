// IMAP starter command on TCP port 143 using built-in defaults. Omitting
// extra keywords emits an 'A01 NOOP' mail server keepalive command.
// Wireshark: imap

host mail_client {
    ip 192.168.14.10
    mac 00:1b:21:14:30:01
}

host dovecot_srv {
    ip 192.168.14.1
    mac 00:1b:21:14:30:02
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    mail_client -> dovecot_srv imap
}
