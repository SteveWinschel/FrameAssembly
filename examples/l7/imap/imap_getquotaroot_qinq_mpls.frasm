// PROMPT: RFC 2087 IMAP GETQUOTAROOT storage quota check over MPLS and QinQ carrier tags.
// TOKENS: host, ip, flow, imap, tag, cmd, arg, qinq, innervlan, mpls, compile

// INSTRUCTION: Define hosted webmail proxy.
host webmail_proxy { ip 100.64.143.10 }

// INSTRUCTION: Define backend multi-tenant IMAP storage node.
host quota_imap { ip 100.64.143.1 }

// INSTRUCTION: Query mailbox storage usage via GETQUOTAROOT over QinQ and MPLS.
flow imap_quota_qinq_mpls(p, q) {
    p -> q imap tag "Q01" cmd "GETQUOTAROOT" arg "INBOX" qinq 1143 innervlan 143 mpls 1430
    p <- q imap tag "*" cmd "QUOTA" arg "\"\" (STORAGE 40960 102400)" qinq 1143 innervlan 143 mpls 1430
    p <- q imap tag "Q01" cmd "OK" arg "GETQUOTAROOT completed" qinq 1143 innervlan 143 mpls 1430
}

// INSTRUCTION: Compile the QinQ and MPLS IMAP quota check flow.
compile {
    imap_quota_qinq_mpls(webmail_proxy, quota_imap)
}
