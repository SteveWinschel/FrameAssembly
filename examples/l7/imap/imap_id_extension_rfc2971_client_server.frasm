// RFC 2971 IMAP ID command exchanging client and server software vendor
// version strings.
// Wireshark: imap

// Enterprise mobile mail client identifying its version via RFC 2971 ID.
host mobile_client {
    ip 10.143.80.33
    mac 00:16:3e:8f:50:21
}

// Corporate IMAP proxy logging client telemetry.
host imap_proxy {
    ip 10.143.80.1
    mac 00:16:3e:8f:50:01
}

// Exchange RFC 2971 ID parameters between the client and IMAP server.
flow imap_rfc2971_id(c, s) {
    c -> s imap tag "I01" cmd "ID" arg "('name' 'FrameMail' 'version' '4.2.0' 'os' 'Linux')" wait 2ms
    c <- s imap tag "*" status "ID" response "('name' 'Dovecot' 'version' '2.3.21' 'support-url' 'https://dovecot.org')" wait 1ms
    c <- s imap tag "I01" status "OK" response "ID completed"
}

compile {
    imap_rfc2971_id(mobile_client, imap_proxy)
}
