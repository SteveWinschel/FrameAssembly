// PROMPT: RFC 2177 IMAP IDLE push notification session and DONE termination.
// TOKENS: host, ip, flow, s, imap, tag, cmd, wait, arg, compile

// INSTRUCTION: Define smartphone push email client.
host mobile_mua { ip 172.16.14.88 }

// INSTRUCTION: Define IMAP push mail server.
host imap_push_srv { ip 172.16.14.1 }

// INSTRUCTION: Enter IDLE mode, receive new mail EXISTS notification after 5s, and exit with DONE.
flow imap_idle_push(c, s) {
    c -> s imap tag "B01" cmd "IDLE"
    c <- s imap tag "+" cmd "idling" wait 5s
    c <- s imap tag "*" cmd "24" arg "EXISTS"
    c -> s imap tag "DONE" cmd "NOOP"
    c <- s imap tag "B01" cmd "OK" arg "IDLE terminated"
}

// INSTRUCTION: Compile the RFC 2177 IMAP IDLE push scenario.
compile {
    imap_idle_push(mobile_mua, imap_push_srv)
}
