// PROMPT: IMAP folder management with LIST hierarchy discovery, CREATE new folder, and SUBSCRIBE.
// TOKENS: host, ip, flow, s, imap, tag, cmd, arg, compile

// INSTRUCTION: Define corporate email client.
host corp_mail { ip 192.168.143.25 }

// INSTRUCTION: Define Exchange IMAP4 service.
host exchange_imap { ip 192.168.143.5 }

// INSTRUCTION: List mailbox hierarchy, create Archive/2026 folder, and subscribe to it.
flow imap_folder_management(c, s) {
    c -> s imap tag "D01" cmd "LIST" arg "\"\" \"*\""
    c <- s imap tag "D01" cmd "OK" arg "LIST completed"
    c -> s imap tag "D02" cmd "CREATE" arg "Archive/2026"
    c <- s imap tag "D02" cmd "OK" arg "CREATE completed"
    c -> s imap tag "D03" cmd "SUBSCRIBE" arg "Archive/2026"
    c <- s imap tag "D03" cmd "OK" arg "SUBSCRIBE completed"
}

// INSTRUCTION: Compile the IMAP folder LIST, CREATE, and SUBSCRIBE scenario.
compile {
    imap_folder_management(corp_mail, exchange_imap)
}
