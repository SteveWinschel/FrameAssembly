// PROMPT: IMAP session authentication and mailbox capability discovery.
// TOKENS: HOST, IP, FLOW, ->, <-, IMAP, TAG, CMD, ARG, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 192.168.1.20 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
FLOW imap_login(c, s) {
    c -> s IMAP TAG "A01" CMD "LOGIN" ARG "user pass"
    c -> s IMAP TAG "A02" CMD "CAPABILITY"
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    imap_login(client, server)
}
