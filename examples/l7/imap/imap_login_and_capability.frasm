// PROMPT: IMAP session authentication and mailbox capability discovery.
// TOKENS: host, ip, flow, s, imap, tag, cmd, arg, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.20 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
flow imap_login(c, s) {
    c -> s imap tag "A01" cmd "LOGIN" arg "user pass"
    c -> s imap tag "A02" cmd "CAPABILITY"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    imap_login(client, server)
}
