// IMAP graceful session logout closing connection over IPv6.
// Wireshark: imap
// Automatic Ethernet MAC addresses and TCP port 143 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 2001:db8::25 }

host server { ip 2001:db8::1 }

flow imap_logout(c, s) {
    c -> s imap tag "A04" cmd "NOOP"
    c -> s imap tag "A05" cmd "LOGOUT"
}

compile {
    imap_logout(client, server)
}
