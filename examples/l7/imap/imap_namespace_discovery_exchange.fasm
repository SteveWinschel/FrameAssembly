// PROMPT: Simulate an IMAP4rev2 NAMESPACE discovery command and server response revealing personal, other users, and shared prefixes.
// TOKENS: host, ip, mac, flow, s, imap, tag, cmd, dscp, ttl, wait, ms, status, response, compile

// INSTRUCTION: Define the desktop mail client discovering server hierarchy namespaces.
host thunderbird_mua {
    ip 10.143.10.21
    mac 00:1b:21:8f:0a:15
}

// INSTRUCTION: Define the Dovecot IMAP mailstore server.
host dovecot_srv {
    ip 10.143.10.1
    mac 00:1b:21:8f:0a:01
}

// INSTRUCTION: Send tagged NAMESPACE command and receive untagged namespace hierarchy delimiters.
flow imap_namespace_query(c, s) {
    c -> s imap tag "A001" cmd "NAMESPACE" dscp 16 ttl 64 wait 2ms
    c <- s imap tag "*" status "NAMESPACE" response "(('INBOX.' '.')) (('user.' '.')) (('shared.' '.'))" dscp 16 ttl 64 wait 1ms
    c <- s imap tag "A001" status "OK" response "Namespace completed (0.001 + 0.000 secs)." dscp 16 ttl 64
}

// INSTRUCTION: Compile the IMAP NAMESPACE discovery scenario.
compile {
    imap_namespace_query(thunderbird_mua, dovecot_srv)
}
