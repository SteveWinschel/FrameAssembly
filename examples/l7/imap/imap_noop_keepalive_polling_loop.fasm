// PROMPT: Create an IMAP periodic NOOP polling loop checking for new mail arrivals on an active connection.
// TOKENS: host, ip, mac, flow, s, imap, tag, cmd, wait, ms, status, response, compile

// INSTRUCTION: Define the legacy IMAP mail notifier applet.
host notifier_applet {
    ip 10.143.30.55
    mac 00:15:5d:8f:1e:37
}

// INSTRUCTION: Define the corporate IMAP server.
host corp_imap {
    ip 10.143.30.1
    mac 00:15:5d:8f:1e:01
}

// INSTRUCTION: Send a tagged NOOP command and receive EXISTS/RECENT updates followed by OK.
flow imap_noop_poll(c, s) {
    c -> s imap tag "N99" cmd "NOOP" wait 2ms
    c <- s imap tag "*" status "42 EXISTS" response "New mail count" wait 1ms
    c <- s imap tag "N99" status "OK" response "NOOP completed" wait 25ms
}

// INSTRUCTION: Execute 3 consecutive IMAP NOOP polls inside a COMPILE repeated flow calls.
compile {
    imap_noop_poll(notifier_applet, corp_imap) // cycle 1
    imap_noop_poll(notifier_applet, corp_imap) // cycle 2
    imap_noop_poll(notifier_applet, corp_imap) // cycle 3
}
