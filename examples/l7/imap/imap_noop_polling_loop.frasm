// Periodic IMAP NOOP mailbox polling loop checking for new messages every 30
// seconds.
// Wireshark: imap

host legacy_mua { ip 10.14.99.10 }

host internal_imap { ip 10.14.99.1 }

// Send tagged NOOP command and receive OK completion every 30 seconds.
// Repeats 3 times; each wait value pauses after sending its packet.
flow imap_noop_poll(c, s) {
    c -> s imap tag "N01" cmd "NOOP" wait 30s
    c <- s imap tag "N01" cmd "OK" arg "NOOP completed"
}

// Run 3 iterations of the IMAP NOOP polling loop.
compile {
    imap_noop_poll(legacy_mua, internal_imap) // cycle 1
    imap_noop_poll(legacy_mua, internal_imap) // cycle 2
    imap_noop_poll(legacy_mua, internal_imap) // cycle 3
}
