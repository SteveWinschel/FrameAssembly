// PROMPT: IMAP mailbox selection and email header retrieval.
// TOKENS: HOST, IP, FLOW, ->, IMAP, TAG, CMD, ARG, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 10.0.0.25 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
FLOW imap_select(c, s) {
    c -> s IMAP TAG "A02" CMD "SELECT" ARG "INBOX"
    c -> s IMAP TAG "A03" CMD "FETCH" ARG "1"
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    imap_select(client, server)
}
