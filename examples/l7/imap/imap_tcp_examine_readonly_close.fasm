// PROMPT: Full TCP 3-way handshake, IMAP EXAMINE read-only mailbox inspection, and TCP FIN teardown.
// TOKENS: host, ip, flow, s, tcp, syn, srcport, dstport, ack, imap, tag, cmd, arg, fin, compile

// INSTRUCTION: Define compliance audit reader host.
host audit_reader { ip 10.50.143.30 }

// INSTRUCTION: Define archival IMAP server.
host archive_imap { ip 10.50.143.1 }

// INSTRUCTION: Establish TCP connection, open INBOX read-only with EXAMINE, and close session.
flow imap_tcp_examine_readonly(c, s) {
    c -> s tcp syn srcport 52143 dstport 143
    c <- s tcp syn ack
    c -> s tcp ack
    c -> s imap tag "G01" cmd "EXAMINE" arg "INBOX"
    c <- s imap tag "G01" cmd "OK" arg "[READ-ONLY] EXAMINE completed"
    c -> s imap tag "G02" cmd "CLOSE"
    c <- s imap tag "G02" cmd "OK" arg "CLOSE completed"
    c -> s tcp fin ack
    c <- s tcp fin ack
    c -> s tcp ack
}

// INSTRUCTION: Compile the full TCP IMAP EXAMINE read-only lifecycle.
compile {
    imap_tcp_examine_readonly(audit_reader, archive_imap)
}
