// PROMPT: Simulate an IPv6 IMAP UID FETCH command retrieving ENVELOPE and RFC822.SIZE metadata for unread messages.
// TOKENS: host, ip, mac, flow, s, imap, tag, cmd, arg, flowlabel, ttl, wait, ms, status, response, compile

// INSTRUCTION: Define the IPv6 mobile mail client synchronizing message headers.
host ios_mail_v6 {
    ip 2001:db8:143:2::40
    mac 00:16:3e:8f:02:28
}

// INSTRUCTION: Define the IPv6 enterprise IMAP server.
host imap_edge_v6 {
    ip 2001:db8:143:2::1
    mac 00:16:3e:8f:02:01
}

// INSTRUCTION: Execute UID FETCH over IPv6 for message sequence range 501:502.
flow imap_uid_fetch_v6(c, s) {
    c -> s imap tag "U201" cmd "UID FETCH" arg "501:502 (UID FLAGS RFC822.SIZE ENVELOPE)" flowlabel 0x14302 ttl 64 wait 3ms
    c <- s imap tag "*" status "501 FETCH" response "(UID 501 FLAGS (\Seen) RFC822.SIZE 4821)" flowlabel 0x14302 ttl 64 wait 1ms
    c <- s imap tag "*" status "502 FETCH" response "(UID 502 FLAGS () RFC822.SIZE 12940)" flowlabel 0x14302 ttl 64 wait 1ms
    c <- s imap tag "U201" status "OK" response "UID FETCH completed" flowlabel 0x14302 ttl 64
}

// INSTRUCTION: Compile the IPv6 IMAP UID FETCH header synchronization flow.
compile {
    imap_uid_fetch_v6(ios_mail_v6, imap_edge_v6)
}
