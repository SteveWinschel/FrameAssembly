// PROMPT: Simulate an RFC 6851 IMAP UID MOVE command atomically relocating spam messages to the Junk folder.
// TOKENS: host, ip, mac, flow, s, imap, tag, cmd, arg, wait, ms, status, response, compile

// INSTRUCTION: Define the mail filtering agent moving classified messages.
host sieve_worker {
    ip 10.143.20.15
    mac 00:1a:4a:8f:14:0f
}

// INSTRUCTION: Define the IMAP server supporting the MOVE extension.
host imap_move_srv {
    ip 10.143.20.1
    mac 00:1a:4a:8f:14:01
}

// INSTRUCTION: Issue UID MOVE for UIDs 880:885 into the Junk mailbox and receive COPYUID and EXPUNGE notifications.
flow imap_uid_move_junk(c, s) {
    c -> s imap tag "M01" cmd "UID MOVE" arg "880:885 Junk" wait 3ms
    c <- s imap tag "*" status "OK" response "[COPYUID 17119001 880:885 401:406] Moved UIDs" wait 1ms
    c <- s imap tag "*" status "EXPUNGE" response "880" wait 1ms
    c <- s imap tag "M01" status "OK" response "Move completed"
}

// INSTRUCTION: Compile the RFC 6851 IMAP UID MOVE scenario.
compile {
    imap_uid_move_junk(sieve_worker, imap_move_srv)
}
