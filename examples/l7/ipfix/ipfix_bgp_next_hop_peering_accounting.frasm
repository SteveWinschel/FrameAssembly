// PROMPT: Simulate an IPFIX transit peering accounting export reporting high-volume HTTPS flow octets on Observation Domain 400.
// TOKENS: host, ip, mac, flow, exp, ipfix, domainid, srcip, dstip, srcport, dstport, proto, packets, octets, dscp, wait, ms, compile

// INSTRUCTION: Define the peering edge router exporting IPFIX flow records.
host peering_exporter {
    ip 198.51.100.1
    mac 00:1b:21:47:39:01
}

// INSTRUCTION: Define the peering billing IPFIX collector appliance.
host billing_collector {
    ip 198.51.100.200
    mac 00:1b:21:47:39:c8
}

// INSTRUCTION: Export two peering traffic flow records on Observation Domain 400 over UDP port 4739.
flow ipfix_peering_billing(exp, col) {
    exp -> col ipfix domainid 400 srcip 203.0.113.45 dstip 192.0.2.180 srcport 54321 dstport 443 proto 6 packets 18500 octets 26640000 dscp 16 wait 5ms
    exp -> col ipfix domainid 400 srcip 192.0.2.180 dstip 203.0.113.45 srcport 443 dstport 54321 proto 6 packets 9200 octets 644000 dscp 16
}

// INSTRUCTION: Compile the IPFIX peering accounting export flow.
compile {
    ipfix_peering_billing(peering_exporter, billing_collector)
}
