// PROMPT: IPFIX bidirectional biflow telemetry reporting TCP payload metrics between core routers.
// TOKENS: host, ip, flow, ipfix, domainid, srcip, dstip, srcport, dstport, proto, packets, octets, wait, ms, compile

// INSTRUCTION: Define core router ingress interface.
host core_ingress { ip 10.150.1.1 }

// INSTRUCTION: Define centralized IPFIX collector node.
host ipfix_collector { ip 10.150.10.50 }

// INSTRUCTION: Define bidirectional flow export metrics.
flow biflow_telemetry(ing, col) {
    ing -> col ipfix domainid 501 srcip 172.20.10.14 dstip 172.20.20.88 srcport 443 dstport 51234 proto 6 packets 320 octets 450200 wait 10ms
    ing -> col ipfix domainid 501 srcip 172.20.20.88 dstip 172.20.10.14 srcport 51234 dstport 443 proto 6 packets 410 octets 52400
}

// INSTRUCTION: Compile biflow telemetry export scenario.
compile {
    biflow_telemetry(core_ingress, ipfix_collector)
}
