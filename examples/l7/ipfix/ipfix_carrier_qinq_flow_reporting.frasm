// Carrier Ethernet QinQ stacked VLAN underlay transporting IPFIX flow
// datagrams.
// Wireshark: cflow || udp.port == 4739

// Broadband network gateway exporter.
host bng_router { ip 100.64.1.1 }

// Carrier wholesale telemetry collector.
host carrier_noc { ip 100.64.1.200 }

// QinQ encapsulated IPFIX export flow. Encapsulation and QoS markings: 802.1Q
// VLAN 100. Reports IP protocol 17 (UDP) flow records to UDP 4739.
flow qinq_ipfix_stream(bng, noc) {
    bng -> noc ipfix domainid 8000 srcip 100.64.10.5 dstip 100.64.20.9 proto 17 packets 450 octets 57600 vlan 100
}

compile {
    qinq_ipfix_stream(bng_router, carrier_noc)
}
