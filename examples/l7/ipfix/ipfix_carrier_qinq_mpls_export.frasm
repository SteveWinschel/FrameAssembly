// Carrier core router IPFIX export encapsulated in MPLS and IEEE 802.1ad QinQ
// tags.
// Wireshark: cflow || udp.port == 4739

// Provider edge (PE) router exporter.
host pe_router { ip 100.64.47.1 }

// Central traffic engineering IPFIX collector.
host te_collector { ip 100.64.47.99 }

// Export BGP peer traffic statistics over QinQ and MPLS label 4739.
// Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 2500 / C-VLAN 47, MPLS
// label 4739. Reports IP protocol 6 (TCP) flow records to UDP 4739.
flow ipfix_carrier_mpls_qinq(pe, te) {
    pe -> te ipfix domainid 1001 srcip 198.18.1.1 dstip 198.18.2.1 proto 6 packets 45000 octets 64000000 qinq 2500 innervlan 47 mpls 4739 exp 3 bos 1 mplsttl 64
}

compile {
    ipfix_carrier_mpls_qinq(pe_router, te_collector)
}
