// PROMPT: IPFIX export to custom collector port 9995 with enterprise Information Element HEXPAYLOAD.
// TOKENS: host, ip, flow, ipfix, domainid, srcip, dstip, proto, packets, octets, srcport, dstport, df, hexpayload, compile

// INSTRUCTION: Define SD-WAN branch appliance.
host sdwan_branch { ip 192.168.199.1 }

// INSTRUCTION: Define custom-port IPFIX collector on UDP 9995.
host custom_ipfix_col { ip 192.168.199.250 }

// INSTRUCTION: Send IPFIX record to UDP 9995 with trailing enterprise vendor extension bytes.
flow ipfix_custom_port_enterprise(b, c) {
    b -> c ipfix domainid 77 srcip 172.16.1.10 dstip 172.16.2.20 proto 17 packets 500 octets 256000 srcport 54739 dstport 9995 df hexpayload "8001000400001a2b"
}

// INSTRUCTION: Compile the custom-port enterprise IPFIX export scenario.
compile {
    ipfix_custom_port_enterprise(sdwan_branch, custom_ipfix_col)
}
