// IPFIX export to custom collector port 9995 with enterprise Information
// Element HEXPAYLOAD.
// Wireshark: cflow || udp.port == 4739 || udp.port == 9995

// SD-WAN branch appliance.
host sdwan_branch { ip 192.168.199.1 }

// Custom-port IPFIX collector on UDP 9995.
host custom_ipfix_col { ip 192.168.199.250 }

// Send IPFIX record to UDP 9995 with trailing enterprise vendor extension
// bytes. Reports IP protocol 17 (UDP) flow records to UDP 4739.
flow ipfix_custom_port_enterprise(b, c) {
    b -> c ipfix domainid 77 srcip 172.16.1.10 dstip 172.16.2.20 proto 17 packets 500 octets 256000 srcport 54739 dstport 9995 df hexpayload "8001000400001a2b"
}

compile {
    ipfix_custom_port_enterprise(sdwan_branch, custom_ipfix_col)
}
