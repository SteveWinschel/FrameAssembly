// IPFIX DNS amplification DDoS anomaly telemetry reporting high-octet UDP
// responses.
// Wireshark: cflow || udp.port == 4739

// DDoS scrubbing center border router.
host scrubber_rtr { ip 198.19.47.1 }

// DDoS mitigation controller.
host mitigation_ctrl { ip 198.19.47.10 }

// Export high-volume UDP (Proto 17) amplification flow record with DSCP 46.
// Encapsulation and QoS markings: DSCP 46. Reports IP protocol 17 (UDP) flow
// records to UDP 4739.
flow ipfix_ddos_telemetry(r, m) {
    r -> m ipfix domainid 911 srcip 8.8.8.8 dstip 198.51.100.50 proto 17 packets 95000 octets 133000000 dscp 46 ecn 1 ttl 255
}

compile {
    ipfix_ddos_telemetry(scrubber_rtr, mitigation_ctrl)
}
