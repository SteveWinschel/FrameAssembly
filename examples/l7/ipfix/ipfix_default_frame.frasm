// IPFIX (NetFlow v10) starter export on UDP port 4739 using built-in
// defaults. Omitting extra keywords emits a 49-byte IPFIX flow record for the
// two hosts.
// Wireshark: cflow || udp.port == 4739

host ipfix_exporter {
    ip 10.47.39.1
    mac 00:1e:f6:47:39:01
}

host ipfix_collector {
    ip 10.47.39.100
    mac 00:1e:f6:47:39:64
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    ipfix_exporter -> ipfix_collector ipfix
}
