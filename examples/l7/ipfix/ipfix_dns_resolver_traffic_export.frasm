// IPFIX export datagram capturing recursive DNS resolver UDP port 53 traffic
// volumes.
// Wireshark: cflow || udp.port == 4739 || udp.port == 53

// Caching DNS resolver exporter.
host dns_cache_rtr { ip 192.0.2.53 }

// DNS security telemetry analytics engine.
host dns_analytics { ip 192.0.2.200 }

// DNS volume export flow. Reports IP protocol 17 (UDP) flow records to UDP
// 4739.
flow dns_ipfix_flow(rtr, ana) {
    rtr -> ana ipfix domainid 5353 srcip 10.2.1.15 dstip 192.0.2.53 srcport 61240 dstport 53 proto 17 packets 24 octets 1920
}

compile {
    dns_ipfix_flow(dns_cache_rtr, dns_analytics)
}
