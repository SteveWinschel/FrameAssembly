// IPFIX export datagram specifying observation domain ID for flow tracking.
// Wireshark: cflow || udp.port == 4739

host client { ip 10.1.1.1 }

host server { ip 10.1.1.200 }

// Reports IP protocol 17 (UDP) flow records to UDP 4739.
flow ipfix_domain(c, s) {
    c -> s ipfix domainid 100 srcip 10.10.1.5 dstip 10.10.2.5 proto 17
}

compile {
    ipfix_domain(client, server)
}
