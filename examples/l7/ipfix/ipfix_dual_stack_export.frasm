// PROMPT: IPFIX datagram exported across an IPv6 transport underlay.
// TOKENS: host, ip, flow, s, ipfix, domainid, srcip, dstip, packets, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::200 }

// INSTRUCTION: Define application traffic flow.
flow ipfix_v6(c, s) {
    c -> s ipfix domainid 200 srcip 192.0.2.1 dstip 192.0.2.2 packets 500
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    ipfix_v6(client, server)
}
