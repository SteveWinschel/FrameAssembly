// IPFIX datagram exported across an IPv6 transport underlay.
// Wireshark: cflow || udp.port == 4739
// Automatic Ethernet MAC addresses and UDP port 4739 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 2001:db8::10 }

host server { ip 2001:db8::200 }

flow ipfix_v6(c, s) {
    c -> s ipfix domainid 200 srcip 192.0.2.1 dstip 192.0.2.2 packets 500
}

compile {
    ipfix_v6(client, server)
}
