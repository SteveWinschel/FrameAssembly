// IPFIX bifurcated telemetry replication exporting identical flow records to
// primary and DR collectors.
// Wireshark: cflow || udp.port == 4739

// Datacenter border router.
host dc_border { ip 10.220.0.1 }

// Primary IPFIX collector.
host pri_collector { ip 10.220.1.10 }

// Disaster-recovery IPFIX collector.
host dr_collector { ip 10.220.2.10 }

// Replicate IPFIX flow export to both primary and DR collectors. Reports IP
// protocol 6 (TCP) flow records to UDP 4739.
flow ipfix_ha_replication(b, p, d) {
    b -> p ipfix domainid 220 srcip 10.10.1.1 dstip 10.20.2.2 proto 6 packets 5000 octets 7200000 payload "DC1_EXPORT"
    b -> d ipfix domainid 220 srcip 10.10.1.1 dstip 10.20.2.2 proto 6 packets 5000 octets 7200000 payload "DC1_EXPORT"
}

compile {
    ipfix_ha_replication(dc_border, pri_collector, dr_collector)
}
