// IPv6-native IPFIX collector receiving SCTP (Protocol 132) mobile core
// signaling flow metrics.
// Wireshark: cflow || udp.port == 4739

// IPv6 5G UPF observation point.
host upf_exporter_v6 { ip 2001:db8:4739::1 }

// IPv6 telecom analytics collector.
host telco_collector_v6 { ip 2001:db8:4739::100 }

// Export SCTP (Proto 132) signaling telemetry over IPv6 with FlowLabel.
// Reports IP protocol 132 (132) flow records to UDP 4739.
flow ipfix_ipv6_sctp_telemetry(e, c) {
    e -> c ipfix domainid 300 srcip 10.200.10.1 dstip 10.200.10.2 proto 132 packets 3400 octets 544000 flowlabel 0x47390 ttl 64
}

compile {
    ipfix_ipv6_sctp_telemetry(upf_exporter_v6, telco_collector_v6)
}
