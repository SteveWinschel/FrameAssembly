// IPFIX flow exporter running on MPLS PE router with traffic class marking.
// Wireshark: cflow || udp.port == 4739

// MPLS provider edge router exporter.
host pe_exporter { ip 192.168.210.1 }

// Carrier analytics collector.
host carrier_collector { ip 192.168.210.254 }

// MPLS encapsulated IPFIX export flow. Encapsulation and QoS markings: MPLS
// label 2048. Reports IP protocol 6 (TCP) flow records to UDP 4739.
flow pe_ipfix_flow(pe, col) {
    pe -> col ipfix domainid 1002 srcip 10.80.4.1 dstip 10.80.5.2 proto 6 packets 1420 octets 1845000 mpls 2048
}

compile {
    pe_ipfix_flow(pe_exporter, carrier_collector)
}
