// PROMPT: Multi-domain IPFIX aggregation exporting telemetry from access and aggregation domains.
// TOKENS: host, ip, flow, ipfix, domainid, srcip, dstip, proto, packets, octets, wait, ms, compile

// INSTRUCTION: Define multi-tenant border router.
host border_router { ip 172.31.1.1 }

// INSTRUCTION: Define corporate flow collector.
host corp_collector { ip 172.31.2.20 }

// INSTRUCTION: Define multi-domain telemetry export flow.
flow domain_aggregation_flow(rtr, col) {
    rtr -> col ipfix domainid 10 srcip 192.168.1.10 dstip 198.51.100.5 proto 6 packets 50 octets 64000 wait 5ms
    rtr -> col ipfix domainid 20 srcip 192.168.2.20 dstip 203.0.113.8 proto 17 packets 12 octets 1440
}

// INSTRUCTION: Compile domain aggregation export scenario.
compile {
    domain_aggregation_flow(border_router, corp_collector)
}
