// IPFIX flow telemetry exported over out-of-band management VLAN 400 with
// DSCP CS2 marking.
// Wireshark: cflow || udp.port == 4739

// Top-of-rack leaf switch exporter.
host tor_leaf { ip 10.40.0.11 }

// Management VLAN IPFIX collector.
host mgmt_collector { ip 10.40.0.250 }

// Export IPFIX datagram tagged on management VLAN 400 with DSCP 16 (CS2).
// Encapsulation and QoS markings: 802.1Q VLAN 400, DSCP 16. Reports IP
// protocol 6 (TCP) flow records to UDP 4739.
flow ipfix_mgmt_vlan(l, c) {
    l -> c ipfix domainid 400 srcip 10.1.10.5 dstip 10.1.20.8 proto 6 packets 850 octets 612000 vlan 400 pcp 2 dscp 16
}

compile {
    ipfix_mgmt_vlan(tor_leaf, mgmt_collector)
}
