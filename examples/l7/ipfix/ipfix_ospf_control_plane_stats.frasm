// PROMPT: IPFIX OSPF (Proto 89) control-plane routing traffic accounting export with custom MACs.
// TOKENS: host, ip, flow, ipfix, domainid, srcip, dstip, proto, packets, octets, srcmac, dstmac, compile

// INSTRUCTION: Define core router exporting control-plane flow stats.
host core_rtr { ip 10.0.47.1 }

// INSTRUCTION: Define local flow analyzer appliance.
host flow_analyzer { ip 10.0.47.2 }

// INSTRUCTION: Report OSPF (Proto 89) multicast hello accounting with explicit Ethernet MACs.
flow ipfix_ospf_control_plane(r, a) {
    r -> a ipfix domainid 1 srcip 10.0.0.1 dstip 224.0.0.5 proto 89 packets 60 octets 4800 srcmac 00:11:22:33:44:01 dstmac 00:11:22:33:44:02
}

// INSTRUCTION: Compile the IPFIX OSPF control-plane accounting flow.
compile {
    ipfix_ospf_control_plane(core_rtr, flow_analyzer)
}
