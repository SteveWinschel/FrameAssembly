// 1-in-1000 sampled IPFIX export from enterprise edge gateway reporting
// egress stats.
// Wireshark: cflow || udp.port == 4739

// Enterprise Internet edge firewall.
host edge_firewall { ip 198.51.100.1 }

// Security information and event collector.
host siem_collector { ip 198.51.100.50 }

// Sampled egress IPFIX export flow. Reports IP protocol 6 (TCP) flow records
// to UDP 4739.
flow sampled_egress_flow(fw, siem) {
    fw -> siem ipfix domainid 1000 srcip 10.1.50.120 dstip 198.51.100.254 proto 6 packets 1000 octets 1420000
}

compile {
    sampled_egress_flow(edge_firewall, siem_collector)
}
