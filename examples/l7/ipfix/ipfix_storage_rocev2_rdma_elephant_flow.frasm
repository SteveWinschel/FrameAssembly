// IPFIX telemetry export capturing a lossless RoCEv2 RDMA over Converged
// Ethernet elephant flow on UDP port 4791.
// Wireshark: cflow || udp.port == 4739 || udp.port == 4791

// AI training fabric Top-of-Rack switch exporting IPFIX metrics.
host ai_tor_switch {
    ip 172.30.100.1
    mac 00:02:c9:30:64:01
}

// AI fabric telemetry analyzer.
host fabric_analyzer {
    ip 172.30.100.50
    mac 00:02:c9:30:64:32
}

// Report a high-throughput UDP port 4791 RoCEv2 RDMA flow record in IPFIX.
// Encapsulation and QoS markings: DSCP 26. Reports IP protocol 17 (UDP) flow
// records to UDP 4739.
flow ipfix_rocev2_rdma_export(tor, col) {
    tor -> col ipfix domainid 800 srcip 172.30.1.11 dstip 172.30.1.12 srcport 59100 dstport 4791 proto 17 packets 250000 octets 1024000000 dscp 26 ecn 2
}

compile {
    ipfix_rocev2_rdma_export(ai_tor_switch, fabric_analyzer)
}
