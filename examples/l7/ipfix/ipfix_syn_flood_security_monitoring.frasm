// High packet volume IPFIX security export recording detected TCP SYN flood
// anomaly.
// Wireshark: cflow || udp.port == 4739 || udp.port == 80

// DDoS mitigation appliance.
host ddos_scrubber { ip 198.18.0.1 }

// Central security operations center.
host soc_collector { ip 198.18.0.254 }

// SYN flood anomaly IPFIX report flow. Reports IP protocol 6 (TCP) flow
// records to UDP 4739.
flow syn_flood_report(scrub, soc) {
    scrub -> soc ipfix domainid 9999 srcip 203.0.113.77 dstip 198.18.10.1 srcport 45123 dstport 80 proto 6 packets 50000 octets 2000000
}

compile {
    syn_flood_report(ddos_scrubber, soc_collector)
}
