// IPFIX elephant flow telemetry export reporting high-bandwidth TCP data
// transfer metrics.
// Wireshark: cflow || udp.port == 4739

// Spine switch exporter.
host spine_exporter { ip 172.16.47.1 }

// Network analytics collector.
host analytics_sink { ip 172.16.47.200 }

// Export TCP (Proto 6) elephant flow record with 250,000 packets and 360 MB
// octets. Reports IP protocol 6 (TCP) flow records to UDP 4739.
flow ipfix_elephant_flow(e, c) {
    e -> c ipfix domainid 10 srcip 10.100.1.50 dstip 10.200.2.50 proto 6 packets 250000 octets 360000000
}

compile {
    ipfix_elephant_flow(spine_exporter, analytics_sink)
}
