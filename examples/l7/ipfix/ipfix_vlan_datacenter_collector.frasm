// IPFIX telemetry collection over 802.1Q tagged datacenter monitoring VLAN.
// Wireshark: cflow || udp.port == 4739

// Datacenter spine switch exporter.
host spine_switch { ip 10.240.0.1 }

// Network operations collector on monitoring VLAN 400.
host noc_collector { ip 10.240.0.100 }

// Tagged VLAN telemetry export flow. Encapsulation and QoS markings: 802.1Q
// VLAN 400. Reports IP protocol 17 (UDP) flow records to UDP 4739.
flow vlan_ipfix_flow(sw, noc) {
    sw -> noc ipfix domainid 4001 srcip 10.100.1.50 dstip 10.200.2.60 proto 17 packets 85 octets 12400 vlan 400 pcp 4 dei 0
}

compile {
    vlan_ipfix_flow(spine_switch, noc_collector)
}
