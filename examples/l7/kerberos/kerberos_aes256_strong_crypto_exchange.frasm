// Kerberos AS-REQ ticket request negotiating AES256-CTS-HMAC-SHA1-96
// encryption type 18.
// Wireshark: kerberos

// Secure banking workstation.
host finance_pc { ip 10.88.2.14 }

// Security hardened domain controller.
host secure_dc { ip 10.88.2.1 }

// AES256 ticket request flow. Kerberos encryption types: 18 (AES256-CTS).
flow krb_aes_req_flow(pc, dc) {
    pc -> dc kerberos asreq realm "BANKING.INTERNAL" cname "auditor" etype 18
}

compile {
    krb_aes_req_flow(finance_pc, secure_dc)
}
