// Kerberos AS-REP reply from KDC returning encrypted Ticket Granting Ticket
// to client.
// Wireshark: kerberos

// Authenticating enterprise workstation.
host corp_workstation { ip 10.20.1.80 }

// Primary Key Distribution Center (KDC).
host central_kdc { ip 10.20.1.5 }

// AS-REP ticket issuance flow. Kerberos encryption types: 18 (AES256-CTS).
flow krb_as_rep_flow(w, kdc) {
    w <- kdc kerberos asrep realm "ENTERPRISE.CORP" cname "jdoe" etype 18
}

compile {
    krb_as_rep_flow(corp_workstation, central_kdc)
}
