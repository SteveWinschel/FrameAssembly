// Kerberos AS-REQ initial authentication requesting Ticket Granting Ticket
// (TGT).
// Wireshark: kerberos

host client { ip 10.0.0.100 }

host server { ip 10.0.0.1 }

// Kerberos encryption types: 18 (AES256-CTS).
flow krb_as_req(c, s) {
    c -> s kerberos asreq realm "CORP.NET" cname "alice" etype 18
}

compile {
    krb_as_req(client, server)
}
