// Kerberos TGS-REQ service ticket request for enterprise CIFS/SMB storage
// cluster.
// Wireshark: kerberos

host storage_client { ip 10.50.2.100 }

host file_kdc { ip 10.50.2.1 }

// CIFS ticket acquisition flow. Kerberos encryption types: 18 (AES256-CTS).
flow cifs_ticket_flow(cli, kdc) {
    cli -> kdc kerberos tgsreq realm "STORAGE.CORP" sname "cifs/nas01.storage.corp" etype 18
}

compile {
    cifs_ticket_flow(storage_client, file_kdc)
}
