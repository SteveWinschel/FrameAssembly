// PROMPT: Generate a Kerberos KRB_ERROR response for clock skew too great (KRB_AP_ERR_SKEW) followed by a corrected AS_REQ.
// TOKENS: host, ip, mac, flow, s, kerberos, asreq, realm, cname, sname, etype, wait, ms, krberror, payload, asrep, compile

// INSTRUCTION: Define the client workstation with an unsynchronized system clock.
host skewed_client {
    ip 192.168.70.112
    mac 00:1b:63:70:01:12
}

// INSTRUCTION: Define the realm KDC enforcing a strict 5-minute clock skew window.
host strict_kdc {
    ip 192.168.70.10
    mac 00:1b:63:70:00:10
}

// INSTRUCTION: Reject the initial AS_REQ with KRB_ERROR due to clock skew, then succeed after NTP resynchronization.
flow clock_skew_recovery(c, s) {
    c -> s kerberos asreq realm "LAB.EXAMPLE.ORG" cname "devops" sname "krbtgt/LAB.EXAMPLE.ORG" etype 18 wait 3ms
    c <- s kerberos krberror realm "LAB.EXAMPLE.ORG" cname "devops" sname "krbtgt/LAB.EXAMPLE.ORG" payload "KRB5KRB_AP_ERR_SKEW: Clock skew too great" wait 50ms
    c -> s kerberos asreq realm "LAB.EXAMPLE.ORG" cname "devops" sname "krbtgt/LAB.EXAMPLE.ORG" etype 18 wait 4ms
    c <- s kerberos asrep realm "LAB.EXAMPLE.ORG" cname "devops" sname "krbtgt/LAB.EXAMPLE.ORG" etype 18
}

// INSTRUCTION: Compile the Kerberos clock skew error and recovery trace into a PCAP file.
compile {
    clock_skew_recovery(skewed_client, strict_kdc)
}
