// Kerberos TGS-REQ cross-realm trust referral requesting ticket from foreign
// partner realm.
// Wireshark: kerberos

host member_server { ip 172.24.1.10 }

// Local Kerberos KDC proxy.
host local_kdc { ip 172.24.1.1 }

// Cross-realm trust ticket request flow. Kerberos encryption types: 18
// (AES256-CTS).
flow cross_realm_flow(srv, kdc) {
    srv -> kdc kerberos tgsreq realm "PARTNER.EXT" sname "krbtgt/PARTNER.EXT" etype 18
}

compile {
    cross_realm_flow(member_server, local_kdc)
}
