// Kerberos v5 starter ticket request on UDP port 88 using built-in defaults.
// Omitting extra keywords emits an ASN.1 DER-encoded AS-REQ message.
// Wireshark: kerberos

host ad_workstation {
    ip 10.88.0.25
    mac 00:15:5d:88:00:19
}

host kdc_server {
    ip 10.88.0.1
    mac 00:15:5d:88:00:01
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    ad_workstation -> kdc_server kerberos
}
