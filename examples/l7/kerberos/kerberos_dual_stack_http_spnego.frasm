// Dual-stack Kerberos v5 HTTP SPNEGO service ticket request (HTTP/intranet)
// over IPv4 and IPv6.
// Wireshark: kerberos

host spnego_c4 { ip 192.168.88.25 }

host kdc_v4 { ip 192.168.88.1 }

host spnego_c6 { ip 2001:db8:88::25 }

host kdc_v6 { ip 2001:db8:88::1 }

// Request HTTP/intranet.corp.net SPNEGO service ticket via TGS-REQ and
// TGS-REP. Runs the same flow definition over both IPv4 and IPv6 host pairs.
// Kerberos encryption types: 18 (AES256-CTS).
flow krb5_spnego_http(c, k) {
    c -> k kerberos tgsreq realm "CORP.NET" cname "alice" sname "HTTP/intranet.corp.net" etype 18
    c <- k kerberos tgsrep realm "CORP.NET" cname "alice" sname "HTTP/intranet.corp.net" etype 18
}

compile {
    krb5_spnego_http(spnego_c4, kdc_v4)
    krb5_spnego_http(spnego_c6, kdc_v6)
}
