// Kerberos KRB-ERROR response signaling pre-authentication required before
// ticket issuance.
// Wireshark: kerberos

host unauth_client { ip 192.168.100.12 }

// Enterprise KDC authenticator.
host auth_kdc { ip 192.168.100.1 }

// KRB-ERROR preauth notification flow.
flow krb_error_preauth(c, kdc) {
    c <- kdc kerberos krberror realm "ACME.ORG" sname "krbtgt/ACME.ORG"
}

compile {
    krb_error_preauth(unauth_client, auth_kdc)
}
