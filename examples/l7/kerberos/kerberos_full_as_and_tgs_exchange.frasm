// Complete 4-step Kerberos v5 AS-REQ, AS-REP, TGS-REQ, and TGS-REP ticket
// acquisition workflow.
// Wireshark: kerberos

// Domain user workstation.
host corp_user_ws { ip 10.10.88.50 }

host corp_kdc { ip 10.10.88.1 }

// Acquire TGT via AS-REQ/AS-REP and CIFS service ticket via TGS-REQ/TGS-REP.
// Kerberos encryption types: 18 (AES256-CTS).
flow krb5_full_ticket_flow(c, kdc) {
    c -> kdc kerberos asreq realm "EXAMPLE.COM" cname "jdoe" sname "krbtgt/EXAMPLE.COM" etype 18
    c <- kdc kerberos asrep realm "EXAMPLE.COM" cname "jdoe" sname "krbtgt/EXAMPLE.COM" etype 18
    c -> kdc kerberos tgsreq realm "EXAMPLE.COM" cname "jdoe" sname "cifs/fileserver.example.com" etype 18
    c <- kdc kerberos tgsrep realm "EXAMPLE.COM" cname "jdoe" sname "cifs/fileserver.example.com" etype 18
}

compile {
    krb5_full_ticket_flow(corp_user_ws, corp_kdc)
}
