// Kerberos SPNEGO ticket request for intranet web application single sign-on.
// Wireshark: kerberos

// Web browser workstation.
host web_workstation { ip 192.168.12.45 }

host auth_server { ip 192.168.12.1 }

// SPNEGO HTTP service ticket request flow. Kerberos encryption types: 18
// (AES256-CTS).
flow spnego_req_flow(w, a) {
    w -> a kerberos tgsreq realm "INTRANET.NET" sname "HTTP/wiki.intranet.net" etype 18
}

compile {
    spnego_req_flow(web_workstation, auth_server)
}
