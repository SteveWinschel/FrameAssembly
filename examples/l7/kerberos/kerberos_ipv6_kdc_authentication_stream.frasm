// Full Kerberos authentication exchange AS-REQ and AS-REP across IPv6 domain
// controller underlay.
// Wireshark: kerberos

host v6_client { ip 2001:db8:acad::15 }

host v6_kdc { ip 2001:db8:acad::1 }

// Full IPv6 Kerberos AS exchange flow. Kerberos encryption types: 18
// (AES256-CTS).
flow krb_v6_exchange(c, kdc) {
    c -> kdc kerberos asreq realm "IPV6.ACADEMY" cname "student_lab" etype 18 wait 15ms
    c <- kdc kerberos asrep realm "IPV6.ACADEMY" cname "student_lab" etype 18
}

compile {
    krb_v6_exchange(v6_client, v6_kdc)
}
