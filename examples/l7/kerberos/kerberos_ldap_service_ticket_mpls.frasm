// Kerberos v5 TGS-REQ and TGS-REP exchange for an ldap/dc01.corp.net service
// principal over MPLS label 4088.
// Wireshark: kerberos

// Branch office domain client requesting an LDAP service ticket.
host branch_client {
    ip 172.29.88.40
    mac 00:15:5d:1d:58:28
}

// Headquarters KDC reachable across an MPLS WAN core.
host hq_kdc {
    ip 172.29.1.10
    mac 00:15:5d:1d:01:0a
}

// Request and receive an LDAP directory service ticket encapsulated in MPLS
// label 4088. Encapsulation and QoS markings: MPLS label 4088. Kerberos
// encryption types: 18 (AES256-CTS).
flow krb5_ldap_tgs_mpls(c, k) {
    c -> k kerberos tgsreq realm "CORP.NET" cname "netadmin" sname "ldap/dc01.corp.net" etype 18
        mpls 4088 exp 5 bos 1 mplsttl 64 wait 4ms
    c <- k kerberos tgsrep realm "CORP.NET" cname "netadmin" sname "ldap/dc01.corp.net" etype 18
        mpls 4088 exp 5 bos 1 mplsttl 64
}

compile {
    krb5_ldap_tgs_mpls(branch_client, hq_kdc)
}
