// Kerberos AS-REQ ticket request with legacy RC4-HMAC encryption type 23 for
// backward compatibility.
// Wireshark: kerberos

host legacy_terminal { ip 192.168.4.99 }

// Active Directory domain controller.
host ad_controller { ip 192.168.4.10 }

// RC4-HMAC legacy ticket request flow. Kerberos encryption types: 23
// (RC4-HMAC).
flow krb_rc4_req_flow(term, dc) {
    term -> dc kerberos asreq realm "LEGACY.CORP" cname "scanner_svc" etype 23
}

compile {
    krb_rc4_req_flow(legacy_terminal, ad_controller)
}
