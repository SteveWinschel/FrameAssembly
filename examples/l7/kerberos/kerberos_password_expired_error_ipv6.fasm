// PROMPT: Generate an IPv6 Kerberos v5 AS_REQ that triggers KRB_ERROR KDC_ERR_KEY_EXPIRED requiring password rotation.
// TOKENS: host, ip, mac, flow, kerberos, asreq, realm, cname, sname, etype, flowlabel, ttl, wait, ms, krberror, payload, compile

// INSTRUCTION: Define the IPv6 developer laptop with an expired Kerberos principal key.
host dev_laptop_v6 {
    ip 2001:db8:88:4::99
    mac 00:25:90:88:04:63
}

// INSTRUCTION: Define the IPv6 enterprise KDC server.
host corp_kdc_v6 {
    ip 2001:db8:88:4::1
    mac 00:25:90:88:04:01
}

// INSTRUCTION: Attempt initial authentication over IPv6 and receive KRB_ERROR for expired credentials.
flow krb5_key_expired_v6(c, k) {
    c -> k kerberos asreq realm "ENG.EXAMPLE.COM" cname "contractor07" sname "krbtgt/ENG.EXAMPLE.COM" etype 18
        flowlabel 0x10088 ttl 64 wait 3ms
    c <- k kerberos krberror realm "ENG.EXAMPLE.COM" cname "contractor07" sname "krbtgt/ENG.EXAMPLE.COM"
        payload "KDC_ERR_KEY_EXPIRED: Password has expired" flowlabel 0x10088 ttl 64
}

// INSTRUCTION: Compile the IPv6 Kerberos password-expired error scenario.
compile {
    krb5_key_expired_v6(dev_laptop_v6, corp_kdc_v6)
}
