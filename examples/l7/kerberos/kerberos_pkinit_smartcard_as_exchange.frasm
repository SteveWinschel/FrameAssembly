// Kerberos v5 PKINIT smartcard pre-authentication AS-REQ and AS-REP exchange
// using AES256-CTS-HMAC-SHA1-96.
// Wireshark: kerberos

// Smartcard-enabled federal workstation.
host piv_workstation {
    ip 10.140.12.50
    mac 00:1b:21:8c:0c:32
}

// Realm Key Distribution Center validating X.509 client certificates.
host pkinit_kdc {
    ip 10.140.12.1
    mac 00:1b:21:8c:0c:01
}

// Send an AS-REQ with PA-PK-AS-REQ in HEXPAYLOAD and receive an AES-256
// AS-REP ticket. Encapsulation and QoS markings: DSCP 32. Kerberos encryption
// types: 18 (AES256-CTS).
flow krb5_pkinit_smartcard(c, k) {
    c -> k kerberos asreq realm "FED.EXAMPLE.GOV" cname "piv_operator" sname "krbtgt/FED.EXAMPLE.GOV" etype 18
        hexpayload "3014a103020110a20d040b30098007706b696e6974" dscp 32 wait 5ms
    c <- k kerberos asrep realm "FED.EXAMPLE.GOV" cname "piv_operator" sname "krbtgt/FED.EXAMPLE.GOV" etype 18
        dscp 32
}

compile {
    krb5_pkinit_smartcard(piv_workstation, pkinit_kdc)
}
