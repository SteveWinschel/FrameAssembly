// Build a Kerberos authentication flow over an MPLS and QinQ carrier backbone
// for a branch office domain join.
// Wireshark: kerberos

// Branch office workstation joining the corporate domain.
host branch_pc {
    ip 10.120.8.55
    mac 00:50:56:78:08:55
}

// Central headquarters Active Directory KDC reachable over MPLS.
host hq_kdc {
    ip 10.1.1.10
    mac 00:50:56:01:01:10
}

// Exchange Kerberos AS-REQ and AS-REP frames encapsulated in QinQ tags 300/45
// and MPLS label 42000. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN
// 300 / C-VLAN 45, MPLS label 42000, DSCP 32. Kerberos encryption types: 18
// (AES256-CTS).
flow branch_domain_auth(c, s) {
    c -> s kerberos asreq realm "HQ.GLOBAL.CORP" cname "BRANCH-PC01$" sname "krbtgt/HQ.GLOBAL.CORP" etype 18 qinq 300 innervlan 45 mpls 42000 dscp 32 ttl 59 wait 18ms
    c <- s kerberos asrep realm "HQ.GLOBAL.CORP" cname "BRANCH-PC01$" sname "krbtgt/HQ.GLOBAL.CORP" etype 18 qinq 300 innervlan 45 mpls 42000 dscp 32 ttl 59
}

compile {
    branch_domain_auth(branch_pc, hq_kdc)
}
