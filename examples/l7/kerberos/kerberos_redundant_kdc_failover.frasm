// Kerberos ticket request failover sequence querying primary and secondary
// KDC nodes.
// Wireshark: kerberos

host branch_client { ip 172.22.1.80 }

// Primary site KDC.
host primary_kdc { ip 172.22.1.10 }

// Secondary site backup KDC.
host backup_kdc { ip 172.22.2.10 }

// Failover ticket request flow. Kerberos encryption types: 18 (AES256-CTS).
// Uses post-packet wait timing (50ms) to space follow-up packets.
flow kdc_failover_flow(c, k1, k2) {
    c -> k1 kerberos asreq realm "BRANCH.INTERNAL" cname "teller01" etype 18 wait 50ms
    c -> k2 kerberos asreq realm "BRANCH.INTERNAL" cname "teller01" etype 18
}

compile {
    kdc_failover_flow(branch_client, primary_kdc, backup_kdc)
}
