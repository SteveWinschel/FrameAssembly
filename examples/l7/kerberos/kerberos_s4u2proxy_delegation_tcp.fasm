// PROMPT: Generate a Kerberos S4U2Proxy constrained delegation exchange where a web frontend requests a backend CIFS ticket over TCP.
// TOKENS: host, ip, mac, flow, s, tcp, srcport, dstport, syn, seq, win, wait, ms, ack, acknum, kerberos, transport, tgsreq, realm, cname, sname, etype, hexpayload, tgsrep, fin, compile

// INSTRUCTION: Define the middle-tier web portal performing Kerberos constrained delegation.
host web_portal {
    ip 10.55.10.20
    mac 00:15:5d:55:10:20
}

// INSTRUCTION: Define the Active Directory KDC validating the S4U2Proxy evidence ticket.
host ad_kdc {
    ip 10.55.1.10
    mac 00:15:5d:55:01:10
}

// INSTRUCTION: Establish a TCP connection on port 88 and exchange a delegated CIFS service ticket with custom PA-PAC-OPTIONS hex payload.
flow s4u2proxy_delegation(c, s) {
    c -> s tcp srcport 54120 dstport 88 syn seq 700000 win 64240 wait 1ms
    c <- s tcp srcport 88 dstport 54120 syn ack seq 800000 acknum 700001 win 65535 wait 1ms
    c -> s tcp srcport 54120 dstport 88 ack seq 700001 acknum 800001 win 64240 wait 2ms
    c -> s kerberos transport tcp srcport 54120 dstport 88 seq 700001 acknum 800001 tgsreq realm "CORP.LOCAL" cname "svc_webapp" sname "cifs/fileserver01.corp.local" etype 18
        hexpayload "300ba0030201a7a20404021000" wait 6ms
    c <- s kerberos transport tcp srcport 88 dstport 54120 seq 800001 acknum 700130 tgsrep realm "CORP.LOCAL" cname "svc_webapp" sname "cifs/fileserver01.corp.local" etype 18 wait 2ms
    c -> s tcp srcport 54120 dstport 88 fin ack seq 700130 acknum 800120 win 64240 wait 1ms
    c <- s tcp srcport 88 dstport 54120 fin ack seq 800120 acknum 700131 win 65535 wait 1ms
    c -> s tcp srcport 54120 dstport 88 ack seq 700131 acknum 800121 win 64240
}

// INSTRUCTION: Compile the Kerberos S4U2Proxy TCP trace into a PCAP file.
compile {
    s4u2proxy_delegation(web_portal, ad_kdc)
}
