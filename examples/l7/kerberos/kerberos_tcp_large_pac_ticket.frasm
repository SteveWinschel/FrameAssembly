// Kerberos over TCP port 88 with full 3-way handshake for large PAC-heavy
// Active Directory tickets.
// Wireshark: tcp || kerberos

// Windows enterprise workstation with large group membership PAC.
host pac_client { ip 10.88.10.99 }

// Active Directory KDC listening on TCP port 88.
host tcp_kdc { ip 10.88.10.1 }

// Establish TCP connection on port 88, exchange Kerberos AS-REQ/AS-REP over
// TCP, and close. Uses TCP transport on port 88 (overriding default UDP).
// Kerberos encryption types: 18 (AES256-CTS).
flow krb5_tcp_session(c, k) {
    c -> k tcp syn srcport 51088 dstport 88
    c <- k tcp syn ack
    c -> k tcp ack
    c -> k kerberos transport tcp asreq realm "AD.ENTERPRISE.COM" cname "svc_sql" sname "krbtgt/AD.ENTERPRISE.COM" etype 18
    c <- k kerberos transport tcp asrep realm "AD.ENTERPRISE.COM" cname "svc_sql" sname "krbtgt/AD.ENTERPRISE.COM" etype 18
    c -> k tcp fin ack
    c <- k tcp fin ack
    c -> k tcp ack
}

compile {
    krb5_tcp_session(pac_client, tcp_kdc)
}
