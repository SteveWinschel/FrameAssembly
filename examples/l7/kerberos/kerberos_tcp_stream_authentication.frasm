// Kerberos authentication over TCP port 88 handling large ticket structures.
// Wireshark: tcp || kerberos

host dir_client { ip 10.10.5.25 }

// Domain controller port 88 listener.
host kdc_tcp_node { ip 10.10.5.1 }

// TCP handshake and Kerberos AS exchange flow. Kerberos encryption types: 18
// (AES256-CTS).
flow krb_tcp_stream(c, s) {
    c -> s tcp syn dstport 88
    c <- s tcp syn ack
    c -> s tcp ack wait 2ms
    c -> s kerberos asreq realm "GLOBAL.CORP" cname "service_admin" etype 18 wait 10ms
    c <- s kerberos asrep realm "GLOBAL.CORP" cname "service_admin" etype 18
}

compile {
    krb_tcp_stream(dir_client, kdc_tcp_node)
}
