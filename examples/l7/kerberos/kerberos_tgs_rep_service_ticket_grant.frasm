// Kerberos TGS-REP response from KDC delivering service ticket for
// application server.
// Wireshark: kerberos

host app_client { ip 172.16.8.50 }

host kdc_server { ip 172.16.8.1 }

// TGS-REP service ticket delivery flow. Kerberos encryption types: 18
// (AES256-CTS).
flow krb_tgs_rep_flow(c, kdc) {
    c <- kdc kerberos tgsrep realm "SERVICES.LOCAL" sname "http/portal.services.local" etype 18
}

compile {
    krb_tgs_rep_flow(app_client, kdc_server)
}
