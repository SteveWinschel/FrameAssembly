// Kerberos periodic TGT renewal TGS-REQ and TGS-REP polling loop from a Linux
// daemon to a FreeIPA KDC.
// Wireshark: kerberos

// Linux application node running a long-lived k5start renewal daemon.
host app_daemon {
    ip 172.22.5.40
    mac 00:16:3e:22:05:40
}

// FreeIPA Kerberos Key Distribution Center.
host ipa_kdc {
    ip 172.22.1.5
    mac 00:16:3e:22:01:05
}

// Three consecutive TGT renewal exchanges using TGS-REQ for krbtgt. Kerberos
// encryption types: 18 (AES256-CTS). Repeats 3 times; each wait value pauses
// after sending its packet.
flow tgt_renewal_loop(c, s) {
    c -> s kerberos tgsreq realm "IPA.INTERNAL.NET" cname "svc_kafka" sname "krbtgt/IPA.INTERNAL.NET" etype 18 wait 5ms
    c <- s kerberos tgsrep realm "IPA.INTERNAL.NET" cname "svc_kafka" sname "krbtgt/IPA.INTERNAL.NET" etype 18 wait 50ms
}

compile {
    tgt_renewal_loop(app_daemon, ipa_kdc) // cycle 1
    tgt_renewal_loop(app_daemon, ipa_kdc) // cycle 2
    tgt_renewal_loop(app_daemon, ipa_kdc) // cycle 3
}
