// PROMPT: Create a Kerberos KRB_ERROR KDC_ERR_C_PRINCIPAL_UNKNOWN response for a nonexistent user account on a custom KDC port 8888.
// TOKENS: host, ip, mac, flow, s, kerberos, srcport, dstport, asreq, realm, cname, sname, etype, vlan, wait, ms, krberror, payload, compile

// INSTRUCTION: Define the test client attempting authentication against a containerized KDC on UDP port 8888.
host dev_client {
    ip 172.18.0.15
    mac 02:42:ac:12:00:0f
}

// INSTRUCTION: Define the containerized MIT Kerberos KDC listening on custom port 8888.
host container_kdc {
    ip 172.18.0.2
    mac 02:42:ac:12:00:02
}

// INSTRUCTION: Send an AS_REQ for an unknown principal and receive a KRB_ERROR response over VLAN 180.
flow unknown_principal_error(c, s) {
    c -> s kerberos srcport 49800 dstport 8888 asreq realm "DEV.DOCKER.LOCAL" cname "ghost_user" sname "krbtgt/DEV.DOCKER.LOCAL" etype 23 vlan 180 wait 2ms
    c <- s kerberos srcport 8888 dstport 49800 krberror realm "DEV.DOCKER.LOCAL" cname "ghost_user" sname "krbtgt/DEV.DOCKER.LOCAL"
        payload "KDC_ERR_C_PRINCIPAL_UNKNOWN: Client not found in Kerberos database" vlan 180
}

// INSTRUCTION: Compile the unknown principal Kerberos error trace into a PCAP file.
compile {
    unknown_principal_error(dev_client, container_kdc)
}
