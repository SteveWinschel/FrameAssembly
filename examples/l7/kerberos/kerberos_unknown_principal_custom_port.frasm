// Kerberos KRB-ERROR KDC_ERR_C_PRINCIPAL_UNKNOWN response for a nonexistent
// user account on a custom KDC port 8888.
// Wireshark: kerberos || udp.port == 8888

// Test client attempting authentication against a containerized KDC on UDP
// port 8888.
host dev_client {
    ip 172.18.0.15
    mac 02:42:ac:12:00:0f
}

// Containerized MIT Kerberos KDC listening on custom port 8888.
host container_kdc {
    ip 172.18.0.2
    mac 02:42:ac:12:00:02
}

// Send an AS-REQ for an unknown principal and receive a KRB-ERROR response
// over VLAN 180. Encapsulation and QoS markings: 802.1Q VLAN 180. Kerberos
// encryption types: 23 (RC4-HMAC).
flow unknown_principal_error(c, s) {
    c -> s kerberos srcport 49800 dstport 8888 asreq realm "DEV.DOCKER.LOCAL" cname "ghost_user" sname "krbtgt/DEV.DOCKER.LOCAL" etype 23 vlan 180 wait 2ms
    c <- s kerberos srcport 8888 dstport 49800 krberror realm "DEV.DOCKER.LOCAL" cname "ghost_user" sname "krbtgt/DEV.DOCKER.LOCAL"
        payload "KDC_ERR_C_PRINCIPAL_UNKNOWN: Client not found in Kerberos database" vlan 180
}

compile {
    unknown_principal_error(dev_client, container_kdc)
}
