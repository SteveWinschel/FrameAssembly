// Kerberos authentication traffic isolated on 802.1Q tagged security
// management VLAN.
// Wireshark: kerberos

host bastion_host { ip 10.99.1.5 }

// Authentication realm controller.
host realm_controller { ip 10.99.1.20 }

// VLAN tagged authentication flow. Encapsulation and QoS markings: 802.1Q
// VLAN 99. Kerberos encryption types: 18 (AES256-CTS).
flow krb_vlan_auth(bas, ctl) {
    bas -> ctl kerberos asreq realm "MGMT.ZONE" cname "admin_sec" etype 18 vlan 99 pcp 6 dei 0
}

compile {
    krb_vlan_auth(bastion_host, realm_controller)
}
