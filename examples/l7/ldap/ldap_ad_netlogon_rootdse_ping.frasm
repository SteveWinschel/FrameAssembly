// Active Directory CLDAP UDP port 389 Netlogon DnsDomain ping and response.
// Wireshark: ldap

// Windows domain member locating the closest site-aware domain controller.
host domain_member {
    ip 10.45.12.90
    mac 00:15:5d:2d:0c:5a
}

// Active Directory Domain Controller answering CLDAP pings.
host site_dc {
    ip 10.45.1.10
    mac 00:15:5d:2d:01:0a
}

// Send an LDAP RootDSE Netlogon filter search and receive the Netlogon
// attribute entry and completion. LDAP result codes: 0 (success).
flow cldap_netlogon_ping(c, s) {
    c -> s ldap srcport 58412 dstport 389 msgid 1 searchreq basedn "" filter "(&(DnsDomain=CORP.EXAMPLE.COM)(Host=WIN-CLIENT01)(NtVer=\06\00\00\00))" wait 2ms
    c <- s ldap srcport 389 dstport 58412 msgid 1 searchentry basedn "" wait 1ms
    c <- s ldap srcport 389 dstport 58412 msgid 1 searchdone resultcode 0
}

compile {
    cldap_netlogon_ping(domain_member, site_dc)
}
