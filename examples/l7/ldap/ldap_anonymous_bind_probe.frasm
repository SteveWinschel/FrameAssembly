// Anonymous LDAP bind probe checking public directory schema accessibility.
// Wireshark: ldap

// Security audit scanner.
host audit_scanner { ip 10.30.1.200 }

host public_directory { ip 10.30.1.5 }

// Anonymous bind request flow.
flow anon_bind_flow(scan, dir) {
    scan -> dir ldap bindreq msgid 1 basedn ""
}

compile {
    anon_bind_flow(audit_scanner, public_directory)
}
