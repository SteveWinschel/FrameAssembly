// PROMPT: Model a Linux autofs daemon querying LDAP nisMap and nisObject entries to automount /home network shares.
// TOKENS: host, ip, mac, flow, s, ldap, msgid, searchreq, basedn, filter, dscp, ttl, wait, ms, searchentry, payload, searchdone, resultcode, compile

// INSTRUCTION: Define the Linux compute workstation running autofs LDAP integration.
host compute_ws {
    ip 10.44.10.75
    mac 00:1a:4a:44:0a:4b
}

// INSTRUCTION: Define the campus NIS-to-LDAP directory server.
host nis_ldap_srv {
    ip 10.44.10.10
    mac 00:1a:4a:44:0a:0a
}

// INSTRUCTION: Query auto.home automount map entries and receive the NFS server mount location.
flow ldap_autofs_lookup(c, s) {
    c -> s ldap msgid 10 searchreq basedn "nisMapName=auto.home,dc=campus,dc=edu" filter "(cn=researcher)"
        dscp 24 ttl 64 wait 2ms
    c <- s ldap msgid 10 searchentry basedn "cn=researcher,nisMapName=auto.home,dc=campus,dc=edu"
        payload "-fstype=nfs4,rw nas01.campus.edu:/export/home/researcher" dscp 24 ttl 64 wait 1ms
    c <- s ldap msgid 10 searchdone resultcode 0 dscp 24 ttl 64
}

// INSTRUCTION: Compile the LDAP autofs NFS map lookup scenario.
compile {
    ldap_autofs_lookup(compute_ws, nis_ldap_srv)
}
