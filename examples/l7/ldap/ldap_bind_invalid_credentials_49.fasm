// PROMPT: Generate an LDAP bind failure with resultCode 49 (invalidCredentials) followed by a successful retry bind.
// TOKENS: host, ip, mac, flow, s, ldap, msgid, bindreq, basedn, wait, ms, bindres, resultcode, compile

// INSTRUCTION: Define the VPN concentrator verifying user credentials via LDAP bind.
host vpn_gateway {
    ip 192.168.100.2
    mac 00:1b:21:64:00:02
}

// INSTRUCTION: Define the Active Directory LDAP domain controller.
host ad_ldap {
    ip 192.168.100.10
    mac 00:1b:21:64:00:0a
}

// INSTRUCTION: Attempt an LDAP bind that fails with invalidCredentials (49), then succeed on the second attempt (0).
flow bind_error_retry(c, s) {
    c -> s ldap msgid 10 bindreq basedn "cn=bob,ou=staff,dc=corp,dc=local" wait 5ms
    c <- s ldap msgid 10 bindres resultcode 49 wait 25ms
    c -> s ldap msgid 11 bindreq basedn "cn=bob,ou=staff,dc=corp,dc=local" wait 4ms
    c <- s ldap msgid 11 bindres resultcode 0
}

// INSTRUCTION: Compile the LDAP invalid credentials and retry trace into a PCAP file.
compile {
    bind_error_retry(vpn_gateway, ad_ldap)
}
