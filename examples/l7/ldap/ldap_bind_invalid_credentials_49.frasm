// LDAP bind failure with resultCode 49 (invalidCredentials) followed by a
// successful retry bind.
// Wireshark: ldap

// VPN concentrator verifying user credentials via LDAP bind.
host vpn_gateway {
    ip 192.168.100.2
    mac 00:1b:21:64:00:02
}

// Active Directory LDAP domain controller.
host ad_ldap {
    ip 192.168.100.10
    mac 00:1b:21:64:00:0a
}

// Attempt an LDAP bind that fails with invalidCredentials (49), then succeed
// on the second attempt (0). LDAP result codes: 0 (success), 49
// (invalidCredentials).
flow bind_error_retry(c, s) {
    c -> s ldap msgid 10 bindreq basedn "cn=bob,ou=staff,dc=corp,dc=local" wait 5ms
    c <- s ldap msgid 10 bindres resultcode 49 wait 25ms
    c -> s ldap msgid 11 bindreq basedn "cn=bob,ou=staff,dc=corp,dc=local" wait 4ms
    c <- s ldap msgid 11 bindres resultcode 0
}

compile {
    bind_error_retry(vpn_gateway, ad_ldap)
}
