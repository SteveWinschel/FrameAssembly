// LDAP directory BindResponse confirming successful administrative
// authentication.
// Wireshark: ldap

// Administrative management console.
host admin_console { ip 10.0.15.50 }

host ldap_server { ip 10.0.15.1 }

// BindResponse success flow. LDAP result codes: 0 (success).
flow bind_response_flow(c, s) {
    c <- s ldap bindres msgid 1 resultcode 0
}

compile {
    bind_response_flow(admin_console, ldap_server)
}
