// Domain workstation computer account lookup via LDAP SearchRequest.
// Wireshark: ldap

// Domain join provisioning agent.
host provisioning_agent { ip 10.25.1.40 }

// Active Directory domain service node.
host domain_service_node { ip 10.25.1.1 }

// Computer object lookup flow.
flow computer_lookup_flow(agent, dc) {
    agent -> dc ldap searchreq msgid 15 basedn "ou=computers,dc=domain,dc=local" filter "(sAMAccountName=ws-desk-404$)"
}

compile {
    computer_lookup_flow(provisioning_agent, domain_service_node)
}
