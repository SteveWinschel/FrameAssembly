// PROMPT: Generate a minimal default LDAP frame with default protocol parameters between an LDAP client and directory server.
// TOKENS: host, ip, mac, flow, s, ldap, compile

// INSTRUCTION: Define the client host querying the directory service.
host ldap_client {
    ip 10.10.15.20
    mac 00:1a:2b:15:00:20
}

// INSTRUCTION: Define the OpenLDAP directory server.
host ldap_server {
    ip 10.10.15.5
    mac 00:1a:2b:15:00:05
}

// INSTRUCTION: Emit a default LDAP protocol frame using built-in defaults.
flow default_ldap_flow(c, s) {
    c -> s ldap
}

// INSTRUCTION: Compile the default LDAP packet into a PCAP file.
compile {
    default_ldap_flow(ldap_client, ldap_server)
}
