// LDAPv3 starter directory request on TCP port 389 using built-in defaults.
// Omitting extra keywords emits a 30-byte BER BindRequest (msgid 1).
// Wireshark: ldap

host ldap_client {
    ip 10.10.15.20
    mac 00:1a:2b:15:00:20
}

host ldap_server {
    ip 10.10.15.5
    mac 00:1a:2b:15:00:05
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    ldap_client -> ldap_server ldap
}
