// LDAP SearchResponse returning matched SearchResultEntry followed by
// SearchResultDone.
// Wireshark: ldap

host search_client { ip 192.168.1.150 }

// Directory search responder.
host ldap_responder { ip 192.168.1.10 }

// Search response sequence flow. LDAP result codes: 0 (success).
flow search_response_stream(c, s) {
    c <- s ldap searchentry msgid 7 wait 3ms
    c <- s ldap searchdone msgid 7 resultcode 0
}

compile {
    search_response_stream(search_client, ldap_responder)
}
