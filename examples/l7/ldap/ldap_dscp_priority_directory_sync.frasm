// LDAP directory synchronization with DSCP expedited forwarding priority
// marking.
// Wireshark: ldap

// High-priority identity sync service.
host identity_sync_svc { ip 10.70.1.15 }

host identity_master { ip 10.70.1.2 }

// DSCP prioritized search flow. Encapsulation and QoS markings: DSCP 46.
flow priority_ldap_search(sync, mstr) {
    sync -> mstr ldap searchreq msgid 501 basedn "ou=executives,dc=identity,dc=net" filter "(status=active)" dscp 46
}

compile {
    priority_ldap_search(identity_sync_svc, identity_master)
}
