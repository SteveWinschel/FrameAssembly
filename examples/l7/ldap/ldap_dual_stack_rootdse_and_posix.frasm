// Dual-stack IPv4 and IPv6 LDAP RootDSE capability discovery flow querying
// namingContexts.
// Wireshark: ldap

// Dual-stack SSSD client discovering directory capabilities (IPv4).
host sssd_node_v4 {
    ip 10.60.1.35
    mac 00:1a:4a:60:01:35
}

// Dual-stack SSSD client discovering directory capabilities (IPv6).
host sssd_node_v6 {
    ip 2001:db8:60:1::35
    mac 00:1a:4a:60:01:35
}

// Dual-stack 389 Directory Server (IPv4).
host ds389_srv_v4 {
    ip 10.60.1.10
    mac 00:1a:4a:60:01:10
}

// Dual-stack 389 Directory Server (IPv6).
host ds389_srv_v6 {
    ip 2001:db8:60:1::10
    mac 00:1a:4a:60:01:10
}

// Perform an anonymous RootDSE search over IPv4. Encapsulation and QoS
// markings: DSCP 16. Runs the same flow definition over both IPv4 and IPv6
// host pairs. LDAP result codes: 0 (success). Repeats 2 times; each wait
// value pauses after sending its packet.
flow ipv4_rootdse_probe(c, s) {
    c -> s ldap msgid 1 searchreq basedn "" filter "(objectClass=*)" dscp 16 wait 2ms
    c <- s ldap msgid 1 searchentry basedn "" dscp 16 wait 1ms
    c <- s ldap msgid 1 searchdone resultcode 0 dscp 16
}

// Perform a POSIX account lookup over IPv6 with flow label 0x61000.
flow ipv6_posix_lookup(c, s) {
    c -> s ldap msgid 2 searchreq basedn "cn=accounts,dc=linux,dc=org" filter "(uidNumber=10042)" flowlabel 0x61000 ttl 64 wait 3ms
    c <- s ldap msgid 2 searchentry basedn "uid=ops,cn=users,cn=accounts,dc=linux,dc=org" flowlabel 0x61000 ttl 64 wait 1ms
    c <- s ldap msgid 2 searchdone resultcode 0 flowlabel 0x61000 ttl 64
}

compile {
    ipv4_rootdse_probe(sssd_node_v4, ds389_srv_v4)
    ipv6_posix_lookup(sssd_node_v6, ds389_srv_v6)
}
