// Complete TCP-connected LDAP session performing bind, user search, entry
// retrieval, search done, and unbind.
// Wireshark: tcp || ldap

// Application server authenticating users against LDAP.
host auth_service {
    ip 10.20.30.50
}

// Enterprise OpenLDAP directory server listening on TCP port 389.
host openldap_srv {
    ip 10.20.30.10
}

// Establish a TCP handshake, execute a full LDAP bind-search-unbind
// lifecycle, and close with FIN. LDAP result codes: 0 (success).
flow full_ldap_lifecycle(c, s) {
    c -> s tcp dstport 389 syn seq 100000 wait 1ms
    c <- s tcp syn ack seq 200000 acknum 100001 wait 1ms
    c -> s tcp dstport 389 ack seq 100001 acknum 200001 wait 2ms
    c -> s ldap dstport 389 seq 100001 acknum 200001 msgid 1 bindreq basedn "cn=readonly,dc=example,dc=com" wait 3ms
    c <- s ldap seq 200001 acknum 100046 msgid 1 bindres resultcode 0 wait 2ms
    c -> s ldap dstport 389 seq 100046 acknum 200015 msgid 2 searchreq basedn "ou=users,dc=example,dc=com" filter "(uid=jdoe)" wait 4ms
    c <- s ldap seq 200015 acknum 100105 msgid 2 searchentry basedn "uid=jdoe,ou=users,dc=example,dc=com" wait 1ms
    c <- s ldap seq 200068 acknum 100105 msgid 2 searchdone resultcode 0 wait 2ms
    c -> s ldap dstport 389 seq 100105 acknum 200082 msgid 3 unbindreq wait 1ms
    c -> s tcp dstport 389 fin ack seq 100112 acknum 200082 wait 1ms
    c <- s tcp fin ack seq 200082 acknum 100113 wait 1ms
    c -> s tcp dstport 389 ack seq 100113 acknum 200083
}

compile {
    full_ldap_lifecycle(auth_service, openldap_srv)
}
