// PROMPT: Build an Active Directory Global Catalog LDAP query on TCP port 3268 over MPLS and QinQ encapsulation.
// TOKENS: host, ip, mac, flow, s, ldap, srcport, dstport, msgid, searchreq, basedn, filter, qinq, innervlan, mpls, dscp, ttl, wait, ms, searchentry, searchdone, resultcode, compile

// INSTRUCTION: Define the Exchange mail router querying the Global Catalog for universal group membership.
host mail_router {
    ip 10.140.20.15
    mac 00:50:56:8c:14:0f
}

// INSTRUCTION: Define the Active Directory Global Catalog server listening on TCP port 3268.
host gc_server {
    ip 10.10.1.20
    mac 00:50:56:0a:01:14
}

// INSTRUCTION: Query port 3268 for a userPrincipalName across the enterprise forest using QinQ 400/80 and MPLS label 65000.
flow global_catalog_lookup(c, s) {
    c -> s ldap srcport 55320 dstport 3268 msgid 44 searchreq basedn "dc=enterprise,dc=global"
        filter "(userPrincipalName=ceo@enterprise.global)" qinq 400 innervlan 80 mpls 65000 dscp 24 ttl 61 wait 9ms
    c <- s ldap srcport 3268 dstport 55320 msgid 44 searchentry basedn "cn=Executive,ou=HQ,dc=americas,dc=enterprise,dc=global" qinq 400 innervlan 80 mpls 65000 dscp 24 ttl 61 wait 2ms
    c <- s ldap srcport 3268 dstport 55320 msgid 44 searchdone resultcode 0 qinq 400 innervlan 80 mpls 65000 dscp 24 ttl 61
}

// INSTRUCTION: Compile the Global Catalog port 3268 QinQ/MPLS LDAP trace into a PCAP file.
compile {
    global_catalog_lookup(mail_router, gc_server)
}
