// LDAP directory SearchRequest looking up security group memberships for
// authorization.
// Wireshark: ldap

// VPN gateway authorization module.
host vpn_gateway { ip 192.168.88.1 }

// Corporate directory replica.
host directory_replica { ip 192.168.88.10 }

// Security group membership query flow.
flow group_search_flow(vpn, dir) {
    vpn -> dir ldap searchreq msgid 42 basedn "ou=groups,dc=corp,dc=org" filter "(member=cn=eng_lead)"
}

compile {
    group_search_flow(vpn_gateway, directory_replica)
}
