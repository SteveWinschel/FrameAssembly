// PROMPT: Create an IPv6 LDAP PKI certificate revocation list (CRL) and userCertificate lookup over IPv6.
// TOKENS: HOST, IP, MAC, FLOW, LDAP, MSGID, BIND_REQ, BASE_DN, FLOWLABEL, ECN, TTL, WAIT, BIND_RES, RESULT_CODE, SEARCH_REQ, FILTER, SEARCH_ENTRY, SEARCH_DONE, UNBIND_REQ, COMPILE

// INSTRUCTION: Define the IPv6 mail gateway verifying S/MIME certificates and CRLs via LDAP.
HOST smime_gateway {
    IP 2001:db8:950:2::15
    MAC 00:1b:21:95:02:15
}

// INSTRUCTION: Define the IPv6 PKI directory server publishing X.509 certificates and CRLs.
HOST pki_directory {
    IP 2001:db8:950:2::5
    MAC 00:1b:21:95:02:05
}

// INSTRUCTION: Bind anonymously and query the PKI directory for a certificateRevocationList entry over IPv6.
FLOW ipv6_pki_crl_lookup(c, s) {
    c -> s LDAP MSGID 1 BIND_REQ BASE_DN "" FLOWLABEL 0x77100 ECN 1 TTL 64 WAIT 2ms
    c <- s LDAP MSGID 1 BIND_RES RESULT_CODE 0 FLOWLABEL 0x77100 ECN 1 TTL 64 WAIT 2ms
    c -> s LDAP MSGID 2 SEARCH_REQ BASE_DN "cn=SubCA01,ou=PKI,dc=trust,dc=gov" FILTER "(certificateRevocationList=*)" FLOWLABEL 0x77100 ECN 1 TTL 64 WAIT 6ms
    c <- s LDAP MSGID 2 SEARCH_ENTRY BASE_DN "cn=SubCA01,ou=PKI,dc=trust,dc=gov" FLOWLABEL 0x77100 ECN 1 TTL 64 WAIT 1ms
    c <- s LDAP MSGID 2 SEARCH_DONE RESULT_CODE 0 FLOWLABEL 0x77100 ECN 1 TTL 64 WAIT 1ms
    c -> s LDAP MSGID 3 UNBIND_REQ FLOWLABEL 0x77100 ECN 1 TTL 64
}

// INSTRUCTION: Compile the IPv6 PKI CRL LDAP lookup into a PCAP file.
COMPILE {
    ipv6_pki_crl_lookup(smime_gateway, pki_directory)
}
