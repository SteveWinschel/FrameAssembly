// Inter-site LDAP replication across MPLS VPN backbone connecting enterprise
// datacenters.
// Wireshark: ldap

// Branch office directory replica.
host branch_replica { ip 10.180.1.5 }

host hq_master_ldap { ip 10.180.2.5 }

// Inter-site directory replication flow.
flow intersite_replication(br, hq) {
    br -> hq ldap bindreq msgid 1 basedn "cn=repl_agent,dc=enterprise,dc=net"
    br -> hq ldap searchreq msgid 2 basedn "ou=global,dc=enterprise,dc=net" filter "(modifyTimestamp>=20261024000000Z)"
}

compile {
    intersite_replication(branch_replica, hq_master_ldap)
}
