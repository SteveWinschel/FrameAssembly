// LDAP search query that returns multiple SearchResultEntry responses before
// completing with SearchResultDone.
// Wireshark: ldap

// Internal address book service querying all engineering group members.
host addressbook_app {
    ip 10.30.5.40
    mac 00:16:3e:30:05:40
}

// Corporate directory server returning multiple matching entries.
host dir_server {
    ip 10.30.5.10
    mac 00:16:3e:30:05:10
}

// Issue a single SearchRequest and receive three separate SearchResultEntry
// packets followed by SearchResultDone. LDAP result codes: 0 (success).
flow multi_entry_search(c, s) {
    c -> s ldap msgid 5 searchreq basedn "ou=engineering,dc=acme,dc=io" filter "(objectClass=inetOrgPerson)" wait 3ms
    c <- s ldap msgid 5 searchentry basedn "cn=alice,ou=engineering,dc=acme,dc=io" wait 1ms
    c <- s ldap msgid 5 searchentry basedn "cn=charlie,ou=engineering,dc=acme,dc=io" wait 1ms
    c <- s ldap msgid 5 searchentry basedn "cn=diana,ou=engineering,dc=acme,dc=io" wait 1ms
    c <- s ldap msgid 5 searchdone resultcode 0
}

compile {
    multi_entry_search(addressbook_app, dir_server)
}
