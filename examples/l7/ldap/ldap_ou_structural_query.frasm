// LDAP query navigating organizational unit hierarchy using base DN scoping.
// Wireshark: ldap

// HR portal directory service.
host hr_portal { ip 172.28.1.10 }

host hr_ldap_host { ip 172.28.1.2 }

// Organizational hierarchy query flow.
flow ou_hierarchy_query(app, dir) {
    app -> dir ldap searchreq msgid 33 basedn "ou=departments,ou=emea,dc=global,dc=com" filter "(objectClass=organizationalUnit)"
}

compile {
    ou_hierarchy_query(hr_portal, hr_ldap_host)
}
