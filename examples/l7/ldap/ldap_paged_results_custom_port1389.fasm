// PROMPT: Generate an LDAP search with paged results control appended via HEXPAYLOAD on custom port 1389.
// TOKENS: host, ip, mac, flow, s, ldap, srcport, dstport, msgid, searchreq, basedn, filter, hexpayload, wait, ms, searchentry, searchdone, resultcode, compile

// INSTRUCTION: Define the identity sync connector running paged queries against an unprivileged LDAP instance.
host sync_connector {
    ip 172.28.4.12
    mac 00:25:90:28:04:0c
}

// INSTRUCTION: Define the directory server listening on non-privileged port 1389.
host unpriv_ldap {
    ip 172.28.4.10
    mac 00:25:90:28:04:0a
}

// INSTRUCTION: Execute a search on port 1389 carrying an ASN.1 pagedResultsControl (1.2.840.113556.1.4.319) suffix in HEXPAYLOAD.
flow paged_search_custom_port(c, s) {
    c -> s ldap srcport 48920 dstport 1389 msgid 77 searchreq basedn "ou=employees,dc=hr,dc=local" filter "(employeeType=fulltime)"
        hexpayload "a01b30190416312e322e3834302e3131333535362e312e342e333139" wait 5ms
    c <- s ldap srcport 1389 dstport 48920 msgid 77 searchentry basedn "uid=emp1001,ou=employees,dc=hr,dc=local" wait 2ms
    c <- s ldap srcport 1389 dstport 48920 msgid 77 searchdone resultcode 0
}

// INSTRUCTION: Compile the custom-port LDAP paged search trace into a PCAP file.
compile {
    paged_search_custom_port(sync_connector, unpriv_ldap)
}
