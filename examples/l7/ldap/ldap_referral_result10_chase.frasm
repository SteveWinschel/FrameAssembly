// LDAP referrals response (resultCode 10) redirecting a client from a
// read-only replica to a master server.
// Wireshark: ldap

// Directory administration client querying a subordinate subtree.
host admin_workstation {
    ip 10.75.4.50
    mac 00:1a:2b:4b:04:32
}

// Regional LDAP replica that holds a referral for the research subtree.
host regional_replica {
    ip 10.75.4.10
    mac 00:1a:2b:4b:04:0a
}

// Master LDAP server authoritative for the research subtree.
host research_master {
    ip 10.75.99.10
    mac 00:1a:2b:4b:63:0a
}

// Receive resultCode 10 (referral) from the regional replica, then query the
// authoritative master server. LDAP result codes: 0 (success), 10 (result).
// Repeats 2 times; each wait value pauses after sending its packet.
flow referral_chase_flow(c, s) {
    c -> s ldap msgid 1 searchreq basedn "ou=labs,dc=research,dc=example,dc=com" filter "(cn=quantum*)" wait 3ms
    c <- s ldap msgid 1 searchdone resultcode 10
}

// Chase the LDAP referral by binding and searching on the authoritative
// research master server.
flow master_query_flow(c, s) {
    c -> s ldap msgid 2 bindreq basedn "cn=admin,dc=research,dc=example,dc=com" wait 3ms
    c <- s ldap msgid 2 bindres resultcode 0 wait 2ms
    c -> s ldap msgid 3 searchreq basedn "ou=labs,dc=research,dc=example,dc=com" filter "(cn=quantum*)" wait 4ms
    c <- s ldap msgid 3 searchentry basedn "cn=quantum-rig-01,ou=labs,dc=research,dc=example,dc=com" wait 1ms
    c <- s ldap msgid 3 searchdone resultcode 0
}

compile {
    referral_chase_flow(admin_workstation, regional_replica)
    master_query_flow(admin_workstation, research_master)
}
