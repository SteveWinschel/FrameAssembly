// PROMPT: LDAP subtree search request filtering for user accounts.
// TOKENS: HOST, IP, FLOW, ->, <-, LDAP, SEARCH_REQ, SEARCH_ENTRY, SEARCH_DONE, MSGID, BASE_DN, FILTER, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 10.0.0.50 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
FLOW ldap_search(c, s) {
    c -> s LDAP SEARCH_REQ MSGID 2 BASE_DN "dc=corp,dc=net" FILTER "(sAMAccountName=alice)"
    c <- s LDAP SEARCH_ENTRY MSGID 2
    c <- s LDAP SEARCH_DONE MSGID 2
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    ldap_search(client, server)
}
