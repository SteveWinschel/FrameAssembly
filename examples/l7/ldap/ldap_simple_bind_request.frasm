// LDAP simple directory bind authentication request.
// Wireshark: ldap
// Automatic Ethernet MAC addresses and TCP port 389 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.10 }

host server { ip 192.168.1.1 }

flow ldap_bind(c, s) {
    c -> s ldap bindreq msgid 1 basedn "cn=admin,dc=corp,dc=net"
}

compile {
    ldap_bind(client, server)
}
