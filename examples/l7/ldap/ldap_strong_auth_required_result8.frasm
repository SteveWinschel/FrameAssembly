// PROMPT: Simulate an LDAP server rejecting an unencrypted simple bind with resultCode 8 (strongAuthRequired).
// TOKENS: host, ip, mac, flow, s, ldap, msgid, bindreq, basedn, vlan, pcp, wait, ms, bindres, resultcode, payload, unbindreq, compile

// INSTRUCTION: Define the legacy client attempting a cleartext simple bind on port 389.
host legacy_app {
    ip 192.168.120.44
    mac 00:50:56:78:00:2c
}

// INSTRUCTION: Define the security-hardened directory server enforcing StartTLS or SASL GSSAPI.
host hardened_ldap {
    ip 192.168.120.10
    mac 00:50:56:78:00:0a
}

// INSTRUCTION: Send BIND_REQ without TLS and receive BIND_RES with RESULT_CODE 8 (strongAuthRequired).
flow ldap_reject_cleartext_bind(c, s) {
    c -> s ldap msgid 1 bindreq basedn "uid=legacy_svc,ou=apps,dc=corp,dc=local" vlan 120 pcp 3 wait 2ms
    c <- s ldap msgid 1 bindres resultcode 8 payload "Confidentiality required: use StartTLS" vlan 120 pcp 3 wait 1ms
    c -> s ldap msgid 2 unbindreq vlan 120 pcp 3
}

// INSTRUCTION: Compile the LDAP resultCode 8 strongAuthRequired rejection flow.
compile {
    ldap_reject_cleartext_bind(legacy_app, hardened_ldap)
}
