// LDAP server rejecting an unencrypted simple bind with resultCode 8
// (strongAuthRequired).
// Wireshark: ldap

// Legacy client attempting a cleartext simple bind on port 389.
host legacy_app {
    ip 192.168.120.44
    mac 00:50:56:78:00:2c
}

// Security-hardened directory server enforcing StartTLS or SASL GSSAPI.
host hardened_ldap {
    ip 192.168.120.10
    mac 00:50:56:78:00:0a
}

// Send BindRequest without TLS and receive BindResponse with resultcode 8
// (strongAuthRequired). Encapsulation and QoS markings: 802.1Q VLAN 120. LDAP
// result codes: 8 (strongAuthRequired).
flow ldap_reject_cleartext_bind(c, s) {
    c -> s ldap msgid 1 bindreq basedn "uid=legacy_svc,ou=apps,dc=corp,dc=local" vlan 120 pcp 3 wait 2ms
    c <- s ldap msgid 1 bindres resultcode 8 payload "Confidentiality required: use StartTLS" vlan 120 pcp 3 wait 1ms
    c -> s ldap msgid 2 unbindreq vlan 120 pcp 3
}

compile {
    ldap_reject_cleartext_bind(legacy_app, hardened_ldap)
}
