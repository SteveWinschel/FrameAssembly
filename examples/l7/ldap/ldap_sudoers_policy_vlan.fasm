// PROMPT: Create an LDAP sudoers policy lookup from a Linux server checking sudoRole entries over VLAN 510.
// TOKENS: HOST, IP, MAC, FLOW, LDAP, MSGID, BIND_REQ, BASE_DN, VLAN, DSCP, TTL, WAIT, BIND_RES, RESULT_CODE, SEARCH_REQ, FILTER, SEARCH_ENTRY, SEARCH_DONE, UNBIND_REQ, COMPILE

// INSTRUCTION: Define the production Linux bastion host verifying sudo privileges via LDAP.
HOST bastion_host {
    IP 10.51.0.25
    MAC 00:16:3e:51:00:19
}

// INSTRUCTION: Define the central security LDAP server hosting sudoers rules.
HOST sec_ldap {
    IP 10.51.0.5
    MAC 00:16:3e:51:00:05
}

// INSTRUCTION: Bind, query ou=sudoers for matching sudoUser rules over VLAN 510, and cleanly unbind.
FLOW sudoers_policy_lookup(c, s) {
    c -> s LDAP MSGID 1 BIND_REQ BASE_DN "cn=sudo_proxy,ou=services,dc=sec,dc=corp" VLAN 510 DSCP 32 TTL 64 WAIT 2ms
    c <- s LDAP MSGID 1 BIND_RES RESULT_CODE 0 VLAN 510 DSCP 32 TTL 64 WAIT 2ms
    c -> s LDAP MSGID 2 SEARCH_REQ BASE_DN "ou=sudoers,dc=sec,dc=corp" FILTER "(&(objectClass=sudoRole)(|(sudoUser=sre_lead)(sudoUser=%wheel)(sudoUser=ALL)))" VLAN 510 DSCP 32 TTL 64 WAIT 4ms
    c <- s LDAP MSGID 2 SEARCH_ENTRY BASE_DN "cn=sre_full_root,ou=sudoers,dc=sec,dc=corp" VLAN 510 DSCP 32 TTL 64 WAIT 1ms
    c <- s LDAP MSGID 2 SEARCH_DONE RESULT_CODE 0 VLAN 510 DSCP 32 TTL 64 WAIT 1ms
    c -> s LDAP MSGID 3 UNBIND_REQ VLAN 510 DSCP 32 TTL 64
}

// INSTRUCTION: Compile the LDAP sudoers policy lookup trace into a PCAP file.
COMPILE {
    sudoers_policy_lookup(bastion_host, sec_ldap)
}
