// LDAP unbind request gracefully terminating directory session over IPv6.
// Wireshark: ldap
// Automatic Ethernet MAC addresses and TCP port 389 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

flow ldap_unbind(c, s) {
    c -> s ldap unbindreq msgid 3
}

compile {
    ldap_unbind(client, server)
}
