// LDAP graceful session termination with UnbindRequest after operations.
// Wireshark: ldap
// Automatic Ethernet MAC addresses and TCP port 389 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host app_session_client { ip 192.168.200.75 }

host directory_service { ip 192.168.200.1 }

// Graceful unbind termination flow.
flow unbind_close_flow(c, s) {
    c -> s ldap unbindreq msgid 99
}

compile {
    unbind_close_flow(app_session_client, directory_service)
}
