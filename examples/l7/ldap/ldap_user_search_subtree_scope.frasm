// LDAP subtree SearchRequest querying active user accounts matching filter
// criteria.
// Wireshark: ldap

// Web application user authenticator.
host app_auth_worker { ip 172.16.20.10 }

// Central LDAP directory directory.
host corporate_ldap { ip 172.16.20.2 }

// User search query flow.
flow user_search_flow(app, dir) {
    app -> dir ldap searchreq msgid 10 basedn "ou=users,dc=enterprise,dc=com" filter "(mail=user@enterprise.com)"
}

compile {
    user_search_flow(app_auth_worker, corporate_ldap)
}
