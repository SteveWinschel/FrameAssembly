// Enterprise LDAP directory authentication on 802.1Q tagged management VLAN.
// Wireshark: ldap

host bmc_controller { ip 10.110.5.8 }

// Identity directory server on VLAN 310.
host vlan_ldap_server { ip 10.110.5.1 }

// Tagged VLAN LDAP bind flow. Encapsulation and QoS markings: 802.1Q VLAN
// 310.
flow vlan_ldap_bind(bmc, srv) {
    bmc -> srv ldap bindreq msgid 2 basedn "cn=admin,ou=systems,dc=local" vlan 310 pcp 5 dei 0
}

compile {
    vlan_ldap_bind(bmc_controller, vlan_ldap_server)
}
