// Apple AirPlay media streaming device announcement using mDNS TXT and SRV
// records.
// Wireshark: mdns

// Media receiver device.
host apple_tv_device { ip 192.168.2.40 }

// MDNS multicast group.
host lan_multicast { ip 224.0.0.251 }

// AirPlay beacon announcement flow. DNS wire details: record types SRV;
// multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow airplay_beacon_flow(dev, grp) {
    dev -> grp mdns response txid 0 qname "LivingRoom._airplay._tcp.local" qtype "srv" rdata "LivingRoom.local:7000" ansttl 4500
}

compile {
    airplay_beacon_flow(apple_tv_device, lan_multicast)
}
