// MDNS Time Machine backup discovery flow querying _adisk._tcp.local and
// receiving TXT and SRV records.
// Wireshark: mdns

// MacOS laptop searching for network Time Machine backup volumes.
host macbook_pro {
    ip 192.168.15.42
    mac f0:18:98:15:00:42
}

// Network-attached storage appliance advertising _adisk._tcp.local.
host timemachine_nas {
    ip 192.168.15.200
    mac 00:11:32:15:02:00
}

// Query _adisk._tcp.local PTR and receive the SRV and TXT volume metadata
// responses. DNS wire details: record types PTR, TXT; multicast 224.0.0.251 /
// ff02::fb UDP 5353 (TTL 255).
flow adisk_timemachine_lookup(client, nas) {
    client -> nas mdns query txid 0 qname "_adisk._tcp.local" qtype "ptr" ttl 255 wait 4ms
    client <- nas mdns response txid 0 qname "_adisk._tcp.local" qtype "ptr" rdata "Vault-NAS._adisk._tcp.local" ansttl 4500 ttl 255 wait 2ms
    client <- nas mdns response txid 0 qname "Vault-NAS._adisk._tcp.local" qtype "txt" rdata "dk0=adVN=TimeMachine,adVF=0x82" ansttl 4500 ttl 255
}

compile {
    adisk_timemachine_lookup(macbook_pro, timemachine_nas)
}
