// Google Cast device discovery query matching _googlecast._tcp.local service
// pointers.
// Wireshark: mdns

host media_client { ip 10.0.50.40 }

host mcast_dest { ip 224.0.0.251 }

// Google Cast query flow. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow cast_query_flow(app, dst) {
    app -> dst mdns query txid 7007 qname "_googlecast._tcp.local" qtype "ptr"
}

compile {
    cast_query_flow(media_client, mcast_dest)
}
