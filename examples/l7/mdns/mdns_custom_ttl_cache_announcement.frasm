// mDNS service announcement with custom 4500-second cache time-to-live
// parameter.
// Wireshark: mdns

// Network attached storage device.
host nas_device { ip 192.168.1.200 }

// Multicast broadcast receiver.
host mdns_addr { ip 224.0.0.251 }

// Long TTL announcement flow. DNS wire details: record types A; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow long_ttl_announce(nas, grp) {
    nas -> grp mdns response txid 0 qname "storage-vault.local" qtype "a" rdata "192.168.1.200" ansttl 4500
}

compile {
    long_ttl_announce(nas_device, mdns_addr)
}
