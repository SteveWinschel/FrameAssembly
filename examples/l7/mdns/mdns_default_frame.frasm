// Multicast DNS (mDNS) starter query on UDP port 5353 using built-in
// defaults. Omitting extra keywords emits a multicast A query for example.com
// to 224.0.0.251.
// Wireshark: mdns

host lan_host {
    ip 192.168.1.40
    mac 00:1a:2b:01:00:40
}

host mdns_multicast {
    ip 224.0.0.251
    mac 01:00:5e:00:00:fb
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    lan_host -> mdns_multicast mdns
}
