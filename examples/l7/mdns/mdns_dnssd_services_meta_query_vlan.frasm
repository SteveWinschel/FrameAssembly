// MDNS DNS-SD meta-query for _services._dns-sd._udp.local enumerating
// available service types on VLAN 110.
// Wireshark: mdns

// Avahi browser workstation discovering all advertised service types on VLAN
// 110.
host avahi_browser {
    ip 10.110.0.25
    mac 00:24:e8:6e:00:19
}

// Multi-function network printer responding with its _ipp._tcp.local service
// type.
host office_printer {
    ip 10.110.0.90
    mac 00:24:e8:6e:00:5a
}

// Query _services._dns-sd._udp.local PTR and receive the _ipp._tcp.local
// service type announcement. Encapsulation and QoS markings: 802.1Q VLAN 110.
// DNS wire details: record types PTR; multicast 224.0.0.251 / ff02::fb UDP
// 5353 (TTL 255).
flow dnssd_meta_query(c, s) {
    c -> s mdns query txid 0 qname "_services._dns-sd._udp.local" qtype "ptr" vlan 110 ttl 255 wait 5ms
    c <- s mdns response txid 0 qname "_services._dns-sd._udp.local" qtype "ptr" rdata "_ipp._tcp.local" ansttl 4500 vlan 110 ttl 255
}

compile {
    dnssd_meta_query(avahi_browser, office_printer)
}
