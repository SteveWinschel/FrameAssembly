// Dual-stack mDNS Google Cast (_googlecast._tcp.local) discovery across IPv4
// and IPv6 endpoints.
// Wireshark: mdns

// IPv4 smartphone searching for Chromecast receivers on the home Wi-Fi.
host mobile_phone_v4 {
    ip 192.168.86.24
    mac 46:55:66:77:88:24
}

// IPv4 Smart TV running the Google Cast receiver daemon.
host smart_tv_v4 {
    ip 192.168.86.60
    mac 46:55:66:77:88:60
}

// IPv6 smartphone searching for Chromecast receivers on the home Wi-Fi.
host mobile_phone_v6 {
    ip fe80::4455:66ff:fe77:8824
    mac 46:55:66:77:88:24
}

// IPv6 Smart TV running the Google Cast receiver daemon.
host smart_tv_v6 {
    ip fe80::4455:66ff:fe77:8860
    mac 46:55:66:77:88:60
}

// Query _googlecast._tcp.local PTR over IPv4 and receive the Chromecast
// instance name. Runs the same flow definition over both IPv4 and IPv6 host
// pairs. DNS wire details: record types PTR, AAAA; multicast 224.0.0.251 /
// ff02::fb UDP 5353 (TTL 255). Repeats 2 times; each wait value pauses after
// sending its packet.
flow cast_discovery_v4(c4, s4) {
    c4 -> s4 mdns query txid 0 qname "_googlecast._tcp.local" qtype "ptr" wait 6ms
    c4 <- s4 mdns response txid 0 qname "_googlecast._tcp.local" qtype "ptr" rdata "Chromecast-Ultra._googlecast._tcp.local" ansttl 120
}

// Resolve the Chromecast-Ultra.local AAAA record over IPv6.
flow cast_resolve_v6(c6, s6) {
    c6 -> s6 mdns query txid 0 qname "Chromecast-Ultra.local" qtype "aaaa" wait 4ms
    c6 <- s6 mdns response txid 0 qname "Chromecast-Ultra.local" qtype "aaaa" rdata "fe80::4455:66ff:fe77:8860" ansttl 120
}

compile {
    cast_discovery_v4(mobile_phone_v4, smart_tv_v4)
    cast_resolve_v6(mobile_phone_v6, smart_tv_v6)
}
