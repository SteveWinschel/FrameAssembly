// PROMPT: Create a dual-stack mDNS Google Cast (_googlecast._tcp.local) discovery across IPv4 and IPv6 endpoints.
// TOKENS: host, ip, mac, flow, mdns, query, txid, qname, qtype, wait, ms, response, rdata, ansttl, compile

// INSTRUCTION: Define the IPv4 smartphone searching for Chromecast receivers on the home Wi-Fi.
host mobile_phone_v4 {
    ip 192.168.86.24
    mac 46:55:66:77:88:24
}

// INSTRUCTION: Define the IPv4 Smart TV running the Google Cast receiver daemon.
host smart_tv_v4 {
    ip 192.168.86.60
    mac 46:55:66:77:88:60
}

// INSTRUCTION: Define the IPv6 smartphone searching for Chromecast receivers on the home Wi-Fi.
host mobile_phone_v6 {
    ip fe80::4455:66ff:fe77:8824
    mac 46:55:66:77:88:24
}

// INSTRUCTION: Define the IPv6 Smart TV running the Google Cast receiver daemon.
host smart_tv_v6 {
    ip fe80::4455:66ff:fe77:8860
    mac 46:55:66:77:88:60
}

// INSTRUCTION: Query _googlecast._tcp.local PTR over IPv4 and receive the Chromecast instance name.
flow cast_discovery_v4(c4, s4) {
    c4 -> s4 mdns query txid 0 qname "_googlecast._tcp.local" qtype "ptr" wait 6ms
    c4 <- s4 mdns response txid 0 qname "_googlecast._tcp.local" qtype "ptr" rdata "Chromecast-Ultra._googlecast._tcp.local" ansttl 120
}

// INSTRUCTION: Resolve the Chromecast-Ultra.local AAAA record over IPv6.
flow cast_resolve_v6(c6, s6) {
    c6 -> s6 mdns query txid 0 qname "Chromecast-Ultra.local" qtype "aaaa" wait 4ms
    c6 <- s6 mdns response txid 0 qname "Chromecast-Ultra.local" qtype "aaaa" rdata "fe80::4455:66ff:fe77:8860" ansttl 120
}

// INSTRUCTION: Compile the dual-stack Google Cast mDNS discovery trace into a PCAP file.
compile {
    cast_discovery_v4(mobile_phone_v4, smart_tv_v4)
    cast_resolve_v6(mobile_phone_v6, smart_tv_v6)
}
