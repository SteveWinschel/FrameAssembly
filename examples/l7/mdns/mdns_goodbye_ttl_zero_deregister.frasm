// MDNS goodbye packet announcement (ansttl 0) when an AirPlay speaker
// gracefully leaves the network.
// Wireshark: mdns

// Smart speaker shutting down its AirPlay service.
host airplay_speaker {
    ip 192.168.10.85
    mac f0:18:98:10:00:85
}

// MDNS multicast destination group.
host mdns_group {
    ip 224.0.0.251
    mac 01:00:5e:00:00:fb
}

// First announce the active PTR record with TTL 4500, then multicast a
// goodbye record with ansttl 0. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255). Uses post-packet wait timing
// (50ms) to space follow-up packets.
flow airplay_goodbye_flow(spk, grp) {
    spk -> grp mdns response txid 0 qname "_airplay._tcp.local" qtype "ptr" rdata "LivingRoom-Speaker._airplay._tcp.local" ansttl 4500 ttl 255 wait 50ms
    spk -> grp mdns response txid 0 qname "_airplay._tcp.local" qtype "ptr" rdata "LivingRoom-Speaker._airplay._tcp.local" ansttl 0 ttl 255
}

compile {
    airplay_goodbye_flow(airplay_speaker, mdns_group)
}
