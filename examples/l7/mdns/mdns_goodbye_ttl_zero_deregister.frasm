// PROMPT: Simulate an mDNS goodbye packet announcement (ANS_TTL 0) when an AirPlay speaker gracefully leaves the network.
// TOKENS: host, ip, mac, flow, mdns, response, txid, qname, qtype, rdata, ansttl, ttl, wait, ms, compile

// INSTRUCTION: Define the smart speaker shutting down its AirPlay service.
host airplay_speaker {
    ip 192.168.10.85
    mac f0:18:98:10:00:85
}

// INSTRUCTION: Define the mDNS multicast destination group.
host mdns_group {
    ip 224.0.0.251
    mac 01:00:5e:00:00:fb
}

// INSTRUCTION: First announce the active PTR record with TTL 4500, then multicast a goodbye record with ANS_TTL 0.
flow airplay_goodbye_flow(spk, grp) {
    spk -> grp mdns response txid 0 qname "_airplay._tcp.local" qtype "ptr" rdata "LivingRoom-Speaker._airplay._tcp.local" ansttl 4500 ttl 255 wait 50ms
    spk -> grp mdns response txid 0 qname "_airplay._tcp.local" qtype "ptr" rdata "LivingRoom-Speaker._airplay._tcp.local" ansttl 0 ttl 255
}

// INSTRUCTION: Compile the mDNS service announcement and TTL=0 goodbye packet into a PCAP file.
compile {
    airplay_goodbye_flow(airplay_speaker, mdns_group)
}
