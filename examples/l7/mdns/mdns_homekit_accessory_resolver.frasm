// Apple HomeKit smart home accessory resolver query over local multicast.
// Wireshark: mdns

// Smart home mobile controller.
host mobile_device { ip 192.168.100.88 }

// Local link multicast receiver.
host mcast_listener { ip 224.0.0.251 }

// HomeKit accessory query flow. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow homekit_query_flow(mob, grp) {
    mob -> grp mdns query txid 6006 qname "_hap._tcp.local" qtype "ptr"
}

compile {
    homekit_query_flow(mobile_device, mcast_listener)
}
