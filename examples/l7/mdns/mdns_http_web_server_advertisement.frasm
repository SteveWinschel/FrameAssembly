// Embedded device advertising internal HTTP web management server via mDNS
// response.
// Wireshark: mdns

// Smart router embedded device.
host embedded_router { ip 192.168.1.1 }

// Local link multicast target.
host mcast_target { ip 224.0.0.251 }

// DNS wire details: record types SRV; multicast 224.0.0.251 / ff02::fb UDP
// 5353 (TTL 255).
flow http_advertisement(rtr, tgt) {
    rtr -> tgt mdns response txid 0 qname "router-ui._http._tcp.local" qtype "srv" rdata "router.local:80" ansttl 300
}

compile {
    http_advertisement(embedded_router, mcast_target)
}
