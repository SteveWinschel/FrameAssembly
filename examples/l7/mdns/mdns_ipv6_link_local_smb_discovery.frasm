// mDNS discovery for SMB file shares over IPv6 link-local multicast ff02::fb.
// Wireshark: mdns

host v6_workstation { ip fe80::20c:29ff:fe4a:1234 }

// IPv6 mDNS link-local multicast group.
host v6_mdns_group { ip ff02::fb }

// SMB file share query flow. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow smb_query_flow(w, g) {
    w -> g mdns query txid 3003 qname "_smb._tcp.local" qtype "ptr"
}

compile {
    smb_query_flow(v6_workstation, v6_mdns_group)
}
