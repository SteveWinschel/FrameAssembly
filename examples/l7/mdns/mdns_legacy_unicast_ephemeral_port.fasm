// PROMPT: Generate a legacy unicast mDNS query from a non-5353 source port receiving a direct unicast response with matching TXID.
// TOKENS: host, ip, mac, flow, s, mdns, srcport, dstport, query, txid, qname, qtype, wait, ms, response, rcode, rdata, ansttl, compile

// INSTRUCTION: Define the legacy DNS stub resolver sending a one-shot unicast query to port 5353 from ephemeral port 54112.
host legacy_resolver {
    ip 10.0.10.33
    mac 00:1c:42:0a:00:21
}

// INSTRUCTION: Define the mDNS responder answering the legacy unicast query directly.
host mdns_responder {
    ip 10.0.10.80
    mac 00:1c:42:0a:00:50
}

// INSTRUCTION: Send an mDNS A query from SRCPORT 54112 with TXID 0x4210 and receive a direct unicast reply with RCODE 0.
flow legacy_unicast_mdns(c, s) {
    c -> s mdns srcport 54112 dstport 5353 query txid 0x4210 qname "build-cache.local" qtype "a" wait 2ms
    c <- s mdns srcport 5353 dstport 54112 response txid 0x4210 rcode 0 qname "build-cache.local" qtype "a" rdata "10.0.10.80" ansttl 10
}

// INSTRUCTION: Compile the legacy unicast mDNS query and response into a PCAP file.
compile {
    legacy_unicast_mdns(legacy_resolver, mdns_responder)
}
