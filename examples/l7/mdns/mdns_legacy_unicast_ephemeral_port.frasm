// Legacy unicast mDNS query from a non-5353 source port receiving a direct
// unicast response with matching TXID.
// Wireshark: mdns

// Legacy DNS stub resolver sending a one-shot unicast query to port 5353 from
// ephemeral port 54112.
host legacy_resolver {
    ip 10.0.10.33
    mac 00:1c:42:0a:00:21
}

// MDNS responder answering the legacy unicast query directly.
host mdns_responder {
    ip 10.0.10.80
    mac 00:1c:42:0a:00:50
}

// Send an mDNS A query from SRCPORT 54112 with TXID 0x4210 and receive a
// direct unicast reply with RCODE 0. DNS wire details: record types A; rcode
// 0 (NOERROR); multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow legacy_unicast_mdns(c, s) {
    c -> s mdns srcport 54112 dstport 5353 query txid 0x4210 qname "build-cache.local" qtype "a" wait 2ms
    c <- s mdns srcport 5353 dstport 54112 response txid 0x4210 rcode 0 qname "build-cache.local" qtype "a" rdata "10.0.10.80" ansttl 10
}

compile {
    legacy_unicast_mdns(legacy_resolver, mdns_responder)
}
