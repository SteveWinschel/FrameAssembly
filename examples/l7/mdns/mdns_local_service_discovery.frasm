// Multicast DNS local zero-configuration service discovery over UDP 5353.
// Wireshark: mdns

host workstation { ip 192.168.1.15 }

// Standard mDNS IPv4 multicast group.
host mdns_group { ip 224.0.0.251 }

// Local service discovery flow. DNS wire details: multicast 224.0.0.251 /
// ff02::fb UDP 5353 (TTL 255).
flow mdns_query_flow(w, g) {
    w -> g mdns query qname "printer.local" qtype a
}

compile {
    mdns_query_flow(workstation, mdns_group)
}
