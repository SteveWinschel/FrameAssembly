// PROMPT: Simulate a multi-responder mDNS star scenario where one workstation queries _ssh._tcp.local and three servers respond.
// TOKENS: host, ip, mac, flow, m, mdns, query, txid, qname, qtype, wait, ms, response, rdata, ansttl, compile

// INSTRUCTION: Define the sysadmin laptop browsing for local SSH hosts via mDNS.
host admin_macbook {
    ip 192.168.20.5
    mac a4:83:e7:20:00:05
}

// INSTRUCTION: Define the mDNS multicast destination group.
host mdns_dest {
    ip 224.0.0.251
    mac 01:00:5e:00:00:fb
}

// INSTRUCTION: Define the first Linux lab server advertising _ssh._tcp.local over mDNS.
host lab_node1 {
    ip 192.168.20.101
    mac 00:16:3e:20:01:01
}

// INSTRUCTION: Define the second Linux lab server advertising _ssh._tcp.local.
host lab_node2 {
    ip 192.168.20.102
    mac 00:16:3e:20:01:02
}

// INSTRUCTION: Define the third Linux lab server advertising _ssh._tcp.local.
host lab_node3 {
    ip 192.168.20.103
    mac 00:16:3e:20:01:03
}

// INSTRUCTION: Multicast the _ssh._tcp.local PTR query and receive responses from three cluster nodes.
flow ssh_cluster_browse(c, m, n1, n2, n3) {
    c -> m mdns query txid 0 qname "_ssh._tcp.local" qtype "ptr" wait 3ms
    n1 -> m mdns response txid 0 qname "_ssh._tcp.local" qtype "ptr" rdata "node1._ssh._tcp.local" ansttl 4500 wait 2ms
    n2 -> m mdns response txid 0 qname "_ssh._tcp.local" qtype "ptr" rdata "node2._ssh._tcp.local" ansttl 4500 wait 2ms
    n3 -> m mdns response txid 0 qname "_ssh._tcp.local" qtype "ptr" rdata "node3._ssh._tcp.local" ansttl 4500
}

// INSTRUCTION: Compile the multi-responder mDNS SSH discovery trace into a PCAP file.
compile {
    ssh_cluster_browse(admin_macbook, mdns_dest, lab_node1, lab_node2, lab_node3)
}
