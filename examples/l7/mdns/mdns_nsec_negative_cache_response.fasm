// PROMPT: Generate an mDNS NSEC negative response asserting that a local host has no AAAA IPv6 record.
// TOKENS: host, ip, mac, flow, s, mdns, query, txid, qname, qtype, wait, ms, response, rcode, rdata, ansttl, hexpayload, compile

// INSTRUCTION: Define the dual-stack client querying an IPv4-only printer for an AAAA record.
host dual_client {
    ip 192.168.30.12
    mac 00:25:90:30:00:0c
}

// INSTRUCTION: Define the IPv4-only embedded thermal printer returning an mDNS NSEC record.
host ipv4_printer {
    ip 192.168.30.200
    mac 00:25:90:30:00:c8
}

// INSTRUCTION: Query label-printer.local AAAA and receive an NSEC negative caching response with a bitmap in HEXPAYLOAD.
flow nsec_negative_reply(c, s) {
    c -> s mdns query txid 0 qname "label-printer.local" qtype "aaaa" wait 2ms
    c <- s mdns response txid 0 rcode 0 qname "label-printer.local" qtype "nsec" rdata "label-printer.local" ansttl 120 hexpayload "000440000000"
}

// INSTRUCTION: Compile the mDNS NSEC negative response trace into a PCAP file.
compile {
    nsec_negative_reply(dual_client, ipv4_printer)
}
