// MDNS NSEC negative response asserting that a local host has no AAAA IPv6
// record.
// Wireshark: mdns

// Dual-stack client querying an IPv4-only printer for an AAAA record.
host dual_client {
    ip 192.168.30.12
    mac 00:25:90:30:00:0c
}

// IPv4-only embedded thermal printer returning an mDNS NSEC record.
host ipv4_printer {
    ip 192.168.30.200
    mac 00:25:90:30:00:c8
}

// Query label-printer.local AAAA and receive an NSEC negative caching
// response with a bitmap in HEXPAYLOAD. DNS wire details: record types AAAA,
// NSEC; rcode 0 (NOERROR); multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL
// 255).
flow nsec_negative_reply(c, s) {
    c -> s mdns query txid 0 qname "label-printer.local" qtype "aaaa" wait 2ms
    c <- s mdns response txid 0 rcode 0 qname "label-printer.local" qtype "nsec" rdata "label-printer.local" ansttl 120 hexpayload "000440000000"
}

compile {
    nsec_negative_reply(dual_client, ipv4_printer)
}
