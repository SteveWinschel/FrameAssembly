// Continuous mDNS background service poll loop discovering dynamic network
// endpoints.
// Wireshark: mdns

// Discovery agent scanner.
host scanner_host { ip 192.168.5.25 }

// Local multicast address.
host local_mcast { ip 224.0.0.251 }

// Periodic discovery query flow. DNS wire details: record types PTR;
// multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL 255). Repeats 3 times; each
// wait value pauses after sending its packet.
flow mcast_poll_flow(s, g) {
    s -> g mdns query txid 5005 qname "_services._dns-sd._udp.local" qtype "ptr" wait 30ms
}

compile {
    mcast_poll_flow(scanner_host, local_mcast) // cycle 1
    mcast_poll_flow(scanner_host, local_mcast) // cycle 2
    mcast_poll_flow(scanner_host, local_mcast) // cycle 3
}
