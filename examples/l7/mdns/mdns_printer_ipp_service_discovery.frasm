// Multicast DNS discovery querying Internet Printing Protocol (IPP) services
// on local link.
// Wireshark: mdns

host office_desktop { ip 192.168.1.105 }

// Standard mDNS multicast group.
host mdns_multicast { ip 224.0.0.251 }

// IPP print service query flow. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow ipp_discovery_flow(cli, grp) {
    cli -> grp mdns query txid 1001 qname "_ipp._tcp.local" qtype "ptr"
}

compile {
    ipp_discovery_flow(office_desktop, mdns_multicast)
}
