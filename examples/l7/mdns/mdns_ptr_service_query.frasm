// mDNS local service discovery PTR query on multicast 224.0.0.251 port 5353.
// Wireshark: mdns

host client { ip 192.168.1.50 }

host server { ip 224.0.0.251 }

// DNS wire details: record types PTR; multicast 224.0.0.251 / ff02::fb UDP
// 5353 (TTL 255).
flow mdns_query(c, s) {
    c -> s mdns query txid 0 qname "_http._tcp.local" qtype "ptr"
}

compile {
    mdns_query(client, server)
}
