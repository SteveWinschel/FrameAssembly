// Build an enterprise mDNS reflector gateway forwarding Bonjour AirPrint
// discovery across QinQ and MPLS campus trunks.
// Wireshark: mdns

// Campus wireless controller reflecting mDNS queries between student and
// printer subnets.
host wlc_reflector {
    ip 10.200.1.1
    mac 00:1e:be:c8:01:01
}

// Shared campus AirPrint print server on the services VLAN.
host airprint_srv {
    ip 10.200.50.10
    mac 00:1e:be:c8:32:0a
}

// Forward an _ipp._tcp.local mDNS query and response across QinQ 600/50 and
// MPLS label 31050. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 600 /
// C-VLAN 50, MPLS label 31050, DSCP 16. DNS wire details: record types PTR;
// multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow bonjour_gateway_reflection(wlc, srv) {
    wlc -> srv mdns query txid 0 qname "_ipp._tcp.local" qtype "ptr" qinq 600 innervlan 50 mpls 31050 dscp 16 ttl 255 wait 4ms
    wlc <- srv mdns response txid 0 qname "_ipp._tcp.local" qtype "ptr" rdata "Library-LaserJet._ipp._tcp.local" ansttl 4500 qinq 600 innervlan 50 mpls 31050 dscp 16 ttl 255
}

compile {
    bonjour_gateway_reflection(wlc_reflector, airprint_srv)
}
