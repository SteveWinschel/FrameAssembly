// RFC 6762 mDNS tiebreaking probe loop (3 QTYPE ANY queries separated by
// 25ms) followed by an authoritative A record announcement.
// Wireshark: mdns

// Newly booted IoT camera probing for uniqueness of cam-lobby.local.
host iot_camera {
    ip 192.168.50.140
    mac 00:60:2f:50:01:40
}

// IPv4 mDNS multicast address receiving the probes and announcement.
host mdns_mcast {
    ip 224.0.0.251
    mac 01:00:5e:00:00:fb
}

// Send an ANY probe query with 25ms wait interval. DNS wire details: record
// types ANY, A; multicast 224.0.0.251 / ff02::fb UDP 5353 (TTL 255). Repeats
// 4 times; each wait value pauses after sending its packet.
flow rfc6762_probe_step(cam, mcast) {
    cam -> mcast mdns query txid 0 qname "cam-lobby.local" qtype "any" wait 25ms
}

// Broadcast the authoritative A record response after probing completes.
flow rfc6762_announce_step(cam, mcast) {
    cam -> mcast mdns response txid 0 qname "cam-lobby.local" qtype "a" rdata "192.168.50.140" ansttl 120
}

compile {
    rfc6762_probe_step(iot_camera, mdns_mcast) // cycle 1
    rfc6762_probe_step(iot_camera, mdns_mcast) // cycle 2
    rfc6762_probe_step(iot_camera, mdns_mcast) // cycle 3
    rfc6762_announce_step(iot_camera, mdns_mcast)
}
