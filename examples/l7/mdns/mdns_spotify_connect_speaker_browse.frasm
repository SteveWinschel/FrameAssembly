// PROMPT: Simulate a Spotify Connect smart speaker discovery over mDNS querying _spotify-connect._tcp.local on VLAN 25.
// TOKENS: host, ip, mac, flow, mdns, query, txid, qname, qtype, vlan, pcp, ttl, wait, ms, response, rdata, ansttl, compile

// INSTRUCTION: Define the mobile listener endpoint on home entertainment VLAN 25.
host listener_phone {
    ip 10.25.0.34
    mac 3c:22:fb:25:00:34
}

// INSTRUCTION: Define the Wi-Fi soundbar responder on VLAN 25.
host wifi_soundbar {
    ip 10.25.0.88
    mac 00:0e:58:25:00:88
}

// INSTRUCTION: Query _spotify-connect._tcp.local and return the CPath API endpoint over VLAN 25.
flow spotify_connect_mdns(phone, speaker) {
    phone -> speaker mdns query txid 0 qname "_spotify-connect._tcp.local" qtype "ptr" vlan 25 pcp 2 ttl 255 wait 5ms
    phone <- speaker mdns response txid 0 qname "_spotify-connect._tcp.local" qtype "ptr" rdata "LivingRoom-Bar._spotify-connect._tcp.local" ansttl 120 vlan 25 pcp 2 ttl 255 wait 2ms
    phone <- speaker mdns response txid 0 qname "LivingRoom-Bar._spotify-connect._tcp.local" qtype "srv" rdata "soundbar.local:4070" ansttl 120 vlan 25 pcp 2 ttl 255
}

// INSTRUCTION: Compile the VLAN-tagged Spotify Connect mDNS browse trace.
compile {
    spotify_connect_mdns(listener_phone, wifi_soundbar)
}
