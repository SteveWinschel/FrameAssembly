// mDNS local service announcement response with SRV record over IPv6
// link-local multicast.
// Wireshark: mdns

host client { ip fe80::1 }

host server { ip ff02::fb }

// DNS wire details: record types SRV; multicast 224.0.0.251 / ff02::fb UDP
// 5353 (TTL 255).
flow mdns_announce(c, s) {
    c -> s mdns response txid 0 qname "printer._ipp._tcp.local" qtype "srv" rdata "printer.local:631"
}

compile {
    mdns_announce(client, server)
}
