// mDNS PTR record query enumerating local workstation hostnames on
// 224.0.0.251:5353.
// Wireshark: mdns

// Network auditing probe.
host audit_probe { ip 10.0.8.55 }

host link_multicast { ip 224.0.0.251 }

// Workstation enumeration flow. DNS wire details: record types PTR; multicast
// 224.0.0.251 / ff02::fb UDP 5353 (TTL 255).
flow workstation_enum_flow(prb, grp) {
    prb -> grp mdns query txid 2002 qname "_workstation._tcp.local" qtype "ptr"
}

compile {
    workstation_enum_flow(audit_probe, link_multicast)
}
