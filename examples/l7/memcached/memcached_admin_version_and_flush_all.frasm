// Administrative Memcached flushall cache invalidation and VERSION check
// during a blue-green deployment.
// Wireshark: memcache || tcp.port == 11211

// Deployment automation runner flushing stale schema caches during cutover.
host deploy_runner {
    ip 10.12.99.5
    mac 00:16:3e:0c:63:05
}

// Staging Memcached instance being reset.
host staging_cache {
    ip 10.12.99.20
    mac 00:16:3e:0c:63:14
}

// Query server VERSION and then execute flushall with a 10-second grace
// delay.
flow admin_flush_and_version(c, s) {
    c -> s memcached cmd "version" key "server" opaque 1 wait 1ms
    c <- s memcached cmd "version" key "server" opaque 1 payload "VERSION 1.6.22\r\n" wait 5ms
    c -> s memcached cmd "flushall" key "all" exptime 10 opaque 2 wait 2ms
    c <- s memcached cmd "ok" key "all" opaque 2 payload "OK\r\n"
}

compile {
    admin_flush_and_version(deploy_runner, staging_cache)
}
