// Memcached binary protocol command execution over IPv6.
// Wireshark: memcache || tcp.port == 11211
// Automatic Ethernet MAC addresses and TCP port 11211 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow memcached_bin(c, s) {
    c -> s memcached cmd "get" key "cached_data" opaque 1234
}

compile {
    memcached_bin(client, server)
}
