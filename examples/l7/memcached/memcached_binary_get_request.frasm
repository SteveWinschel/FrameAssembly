// PROMPT: Memcached binary protocol command execution over IPv6.
// TOKENS: host, ip, flow, s, memcached, cmd, key, opaque, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow memcached_bin(c, s) {
    c -> s memcached cmd "get" key "cached_data" opaque 1234
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    memcached_bin(client, server)
}
