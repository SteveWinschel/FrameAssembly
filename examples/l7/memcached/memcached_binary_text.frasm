// Memcached distributed memory caching protocol interaction on TCP 11211.
// Wireshark: memcache || tcp.port == 11211

// Web application worker.
host cache_client { ip 172.16.50.1 }

// Memcached memory node.
host cache_node { ip 172.16.50.2 }

flow memcached_flow(c, n) {
    c -> n memcached cmd "stats"
}

compile {
    memcached_flow(cache_client, cache_node)
}
