// Administrative cache invalidation purging all cached entries via flush_all
// command.
// Wireshark: memcache || tcp.port == 11211

// Cache maintenance orchestrator.
host devops_admin { ip 10.10.10.99 }

// Target Memcached instance.
host target_cache { ip 10.10.10.2 }

// Cache flush command flow.
flow flush_cache_flow(adm, srv) {
    adm -> srv memcached cmd "flushall"
}

compile {
    flush_cache_flow(devops_admin, target_cache)
}
