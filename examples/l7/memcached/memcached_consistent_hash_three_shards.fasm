// PROMPT: Build a consistent-hashing Memcached ring topology where an application client shards keys across three cache servers.
// TOKENS: host, ip, mac, flow, s, memcached, set, key, exptime, opaque, payload, wait, ms, get, compile

// INSTRUCTION: Define the application router sharding keys across a 3-node ketama consistent hash ring.
host ketama_router {
    ip 10.95.0.5
    mac 00:50:56:95:00:05
}

// INSTRUCTION: Define shard 1 of the Memcached cluster.
host shard_node1 {
    ip 10.95.0.101
    mac 00:50:56:95:01:01
}

// INSTRUCTION: Define shard 2 of the Memcached cluster.
host shard_node2 {
    ip 10.95.0.102
    mac 00:50:56:95:01:02
}

// INSTRUCTION: Define shard 3 of the Memcached cluster.
host shard_node3 {
    ip 10.95.0.103
    mac 00:50:56:95:01:03
}

// INSTRUCTION: Route key shard_a to shard_node1.
flow route_shard1(c, s) {
    c -> s memcached set key "cart:shard_a:101" exptime 900 opaque 1 payload "item_count=3" wait 2ms
    c <- s memcached set key "cart:shard_a:101" opaque 1
}

// INSTRUCTION: Route key shard_b to shard_node2.
flow route_shard2(c, s) {
    c -> s memcached get key "cart:shard_b:202" opaque 2 wait 2ms
    c <- s memcached get key "cart:shard_b:202" opaque 2 payload "item_count=1"
}

// INSTRUCTION: Route key shard_c to shard_node3.
flow route_shard3(c, s) {
    c -> s memcached get key "cart:shard_c:303" opaque 3 wait 2ms
    c <- s memcached get key "cart:shard_c:303" opaque 3 payload "item_count=7"
}

// INSTRUCTION: Compile the 3-shard ketama consistent-hashing Memcached trace into a PCAP file.
compile {
    route_shard1(ketama_router, shard_node1)
    route_shard2(ketama_router, shard_node2)
    route_shard3(ketama_router, shard_node3)
}
