// PROMPT: Generate a minimal default Memcached frame with default protocol parameters between an application server and cache node.
// TOKENS: host, ip, mac, flow, s, memcached, compile

// INSTRUCTION: Define the web application server querying Memcached.
host web_worker {
    ip 10.10.40.20
    mac 00:1a:2b:40:00:20
}

// INSTRUCTION: Define the Memcached in-memory caching server.
host cache_node {
    ip 10.10.40.10
    mac 00:1a:2b:40:00:10
}

// INSTRUCTION: Emit a default Memcached protocol frame using built-in defaults.
flow default_memcached_flow(c, s) {
    c -> s memcached
}

// INSTRUCTION: Compile the default Memcached packet into a PCAP file.
compile {
    default_memcached_flow(web_worker, cache_node)
}
