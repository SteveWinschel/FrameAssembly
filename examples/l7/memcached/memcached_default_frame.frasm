// Memcached starter cache lookup on TCP port 11211 using built-in defaults.
// Omitting extra keywords emits a 9-byte ASCII 'get' cache request.
// Wireshark: memcache || tcp.port == 11211

host web_worker {
    ip 10.10.40.20
    mac 00:1a:2b:40:00:20
}

host cache_node {
    ip 10.10.40.10
    mac 00:1a:2b:40:00:10
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    web_worker -> cache_node memcached
}
