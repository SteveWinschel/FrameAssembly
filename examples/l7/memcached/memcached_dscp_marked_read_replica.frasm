// Low-latency DSCP marked Memcached lookup from application microservice.
// Wireshark: memcache || tcp.port == 11211

host trading_engine { ip 10.200.1.5 }

// In-memory cache replica.
host memory_replica { ip 10.200.1.2 }

// DSCP expedited forwarding lookup flow. Encapsulation and QoS markings: DSCP
// 46.
flow low_latency_lookup(trd, rep) {
    trd -> rep memcached cmd "get" key "ticker:quote:GOOG" dscp 46
}

compile {
    low_latency_lookup(trading_engine, memory_replica)
}
