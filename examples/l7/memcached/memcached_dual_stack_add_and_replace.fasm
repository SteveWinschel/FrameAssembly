// PROMPT: Create a dual-stack IPv4 and IPv6 Memcached deployment comparing ADD and REPLACE conditional storage commands.
// TOKENS: host, ip, mac, flow, s, memcached, cmd, key, exptime, opaque, value, dscp, wait, ms, flowlabel, ttl, compile

// INSTRUCTION: Define the dual-stack distributed lock client using Memcached ADD and REPLACE primitives (IPv4).
host lock_client_v4 {
    ip 10.65.1.25
    mac 00:1a:4a:65:01:25
}

// INSTRUCTION: Define the dual-stack distributed lock client using Memcached ADD and REPLACE primitives (IPv6).
host lock_client_v6 {
    ip 2001:db8:65:1::25
    mac 00:1a:4a:65:01:25
}

// INSTRUCTION: Define the dual-stack Memcached lock server (IPv4).
host lock_memcache_v4 {
    ip 10.65.1.10
    mac 00:1a:4a:65:01:10
}

// INSTRUCTION: Define the dual-stack Memcached lock server (IPv6).
host lock_memcache_v6 {
    ip 2001:db8:65:1::10
    mac 00:1a:4a:65:01:10
}

// INSTRUCTION: Acquire a distributed lock over IPv4 using ADD (succeeds only if key does not exist).
flow ipv4_add_lock(c, s) {
    c -> s memcached cmd "add" key "lock:cron:daily_billing" exptime 120 opaque 401 value 1 dscp 24 wait 2ms
    c <- s memcached cmd "stored" key "lock:cron:daily_billing" opaque 401 value 1 dscp 24
}

// INSTRUCTION: Renew the existing lock lease over IPv6 using REPLACE with flow label 0x55300.
flow ipv6_replace_lock(c, s) {
    c -> s memcached cmd "replace" key "lock:cron:daily_billing" exptime 240 opaque 402 value 2 flowlabel 0x55300 ttl 64 wait 2ms
    c <- s memcached cmd "stored" key "lock:cron:daily_billing" opaque 402 value 2 flowlabel 0x55300 ttl 64
}

// INSTRUCTION: Compile the dual-stack Memcached ADD and REPLACE trace into a PCAP file.
compile {
    ipv4_add_lock(lock_client_v4, lock_memcache_v4)
    ipv6_replace_lock(lock_client_v6, lock_memcache_v6)
}
