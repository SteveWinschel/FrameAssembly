// PROMPT: Model an IPv6 Memcached GETS and CAS optimistic lock contention and retry sequence.
// TOKENS: host, ip, mac, flow, s, memcached, cmd, key, opaque, flowlabel, ttl, wait, ms, value, cas, exptime, compile

// INSTRUCTION: Define the IPv6 inventory checkout worker.
host checkout_v6 {
    ip 2001:db8:1121:1::50
    mac 00:16:3e:11:21:50
}

// INSTRUCTION: Define the IPv6 Memcached hot-item cluster node.
host cache_v6 {
    ip 2001:db8:1121:1::10
    mac 00:16:3e:11:21:10
}

// INSTRUCTION: Fetch item with GETS, experience EXISTS on stale CAS token, re-fetch, and succeed with updated CAS.
flow memcached_cas_retry_v6(c, s) {
    c -> s memcached cmd "gets" key "sku:gpu_h200:stock" opaque 101 flowlabel 0x11211 ttl 64 wait 1ms
    c <- s memcached cmd "value" key "sku:gpu_h200:stock" value "8" cas 5001 opaque 101 flowlabel 0x11211 ttl 64 wait 2ms
    c -> s memcached cmd "cas" key "sku:gpu_h200:stock" value "7" cas 5000 exptime 300 opaque 102 flowlabel 0x11211 ttl 64 wait 1ms
    c <- s memcached cmd "exists" key "sku:gpu_h200:stock" opaque 102 flowlabel 0x11211 ttl 64 wait 2ms
    c -> s memcached cmd "cas" key "sku:gpu_h200:stock" value "7" cas 5001 exptime 300 opaque 103 flowlabel 0x11211 ttl 64 wait 1ms
    c <- s memcached cmd "stored" key "sku:gpu_h200:stock" cas 5002 opaque 103 flowlabel 0x11211 ttl 64
}

// INSTRUCTION: Compile the IPv6 Memcached CAS retry flow.
compile {
    memcached_cas_retry_v6(checkout_v6, cache_v6)
}
