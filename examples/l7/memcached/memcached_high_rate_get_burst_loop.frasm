// PROMPT: High-throughput Memcached cache read benchmark executed inside compile loop.
// TOKENS: host, ip, flow, memcached, cmd, key, wait, ms, compile

// INSTRUCTION: Define performance benchmark runner.
host benchmark_runner { ip 172.30.1.100 }

// INSTRUCTION: Define high-concurrency Memcached target.
host cache_target { ip 172.30.1.1 }

// INSTRUCTION: Define rapid get request burst flow.
flow burst_get_flow(cli, srv) {
    cli -> srv memcached cmd "get" key "hot:item:key" wait 5ms
}

// INSTRUCTION: Compile high rate get burst in loop.
compile {
    burst_get_flow(benchmark_runner, cache_target) // cycle 1
    burst_get_flow(benchmark_runner, cache_target) // cycle 2
    burst_get_flow(benchmark_runner, cache_target) // cycle 3
    burst_get_flow(benchmark_runner, cache_target) // cycle 4
}
