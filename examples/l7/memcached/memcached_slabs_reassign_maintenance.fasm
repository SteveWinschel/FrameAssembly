// PROMPT: Simulate an administrative Memcached slabs reassign and lru_crawler maintenance session.
// TOKENS: host, ip, mac, flow, s, memcached, cmd, key, opaque, dscp, wait, ms, payload, compile

// INSTRUCTION: Define the cache SRE automation host.
host sre_controller {
    ip 10.66.11.5
    mac 00:25:90:66:0b:05
}

// INSTRUCTION: Define the production Memcached instance undergoing slab rebalancing.
host prod_memcached {
    ip 10.66.11.100
    mac 00:25:90:66:0b:64
}

// INSTRUCTION: Trigger slab page reassignment and asynchronous LRU metadata crawl.
flow memcached_slab_maintenance(c, s) {
    c -> s memcached cmd "slabs" key "reassign 3 7" opaque 301 dscp 16 wait 3ms
    c <- s memcached cmd "ok" key "reassign 3 7" opaque 301 payload "OK
" dscp 16 wait 5ms
    c -> s memcached cmd "lrucrawler" key "crawl all" opaque 302 dscp 16 wait 2ms
    c <- s memcached cmd "ok" key "crawl all" opaque 302 payload "OK
" dscp 16
}

// INSTRUCTION: Compile the Memcached slab maintenance flow.
compile {
    memcached_slab_maintenance(sre_controller, prod_memcached)
}
