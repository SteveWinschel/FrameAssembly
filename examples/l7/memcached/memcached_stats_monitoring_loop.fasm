// PROMPT: Generate a Memcached STATS monitoring polling loop from a Prometheus exporter to a cache node.
// TOKENS: host, ip, mac, flow, s, memcached, cmd, key, opaque, wait, ms, payload, compile

// INSTRUCTION: Define the Prometheus memcached_exporter scraping runtime slab and eviction statistics.
host stats_exporter {
    ip 10.50.20.90
    mac 00:16:3e:50:20:5a
}

// INSTRUCTION: Define the monitored Memcached server.
host monitored_cache {
    ip 10.50.20.10
    mac 00:16:3e:50:20:0a
}

// INSTRUCTION: Poll Memcached STATS slabs 3 times in a repeated flow calls.
flow stats_polling_loop(c, s) {
    c -> s memcached cmd "stats" key "items" opaque 900 wait 2ms
    c <- s memcached cmd "stat" key "items" opaque 900 payload "STAT curr_items 14820\r\nSTAT evictions 0\r\nEND\r\n" wait 25ms
}

// INSTRUCTION: Compile the Memcached STATS monitoring loop into a PCAP file.
compile {
    stats_polling_loop(stats_exporter, monitored_cache) // cycle 1
    stats_polling_loop(stats_exporter, monitored_cache) // cycle 2
    stats_polling_loop(stats_exporter, monitored_cache) // cycle 3
}
