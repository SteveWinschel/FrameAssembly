// Monitoring agent querying Memcached runtime statistics and memory metrics.
// Wireshark: memcache || tcp.port == 11211

// Prometheus monitoring exporter.
host prometheus_exporter { ip 192.168.70.15 }

// Production Memcached node.
host prod_memcached { ip 192.168.70.2 }

// Stats query command flow.
flow stats_query_flow(exp, node) {
    exp -> node memcached cmd "stats"
}

compile {
    stats_query_flow(prometheus_exporter, prod_memcached)
}
