// PROMPT: Memcached text protocol key storage and retrieval.
// TOKENS: host, ip, flow, s, memcached, cmd, key, compile

// INSTRUCTION: Define client endpoint.
host client { ip 10.0.0.10 }

// INSTRUCTION: Define server endpoint.
host server { ip 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
flow memcached_text(c, s) {
    c -> s memcached cmd "set" key "user_100"
    c -> s memcached cmd "get" key "user_100"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    memcached_text(client, server)
}
