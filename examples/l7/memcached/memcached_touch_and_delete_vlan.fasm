// PROMPT: Generate a Memcached cache eviction and TTL refresh sequence using DELETE and TOUCH commands over VLAN 240.
// TOKENS: host, ip, mac, flow, s, memcached, cmd, key, exptime, opaque, vlan, dscp, ttl, wait, ms, compile

// INSTRUCTION: Define the session manager invalidating an expired token and extending an active session TTL.
host session_mgr {
    ip 10.24.0.50
    mac 00:1b:21:18:00:32
}

// INSTRUCTION: Define the Memcached cluster node on VLAN 240.
host memcache_vlan {
    ip 10.24.0.10
    mac 00:1b:21:18:00:0a
}

// INSTRUCTION: Issue a TOUCH command to extend an active session's EXPTIME to 1800s, then DELETE a revoked token.
flow touch_and_delete_flow(c, s) {
    c -> s memcached cmd "touch" key "sess:active:7712" exptime 1800 opaque 301 vlan 240 dscp 16 ttl 64 wait 2ms
    c <- s memcached cmd "touched" key "sess:active:7712" opaque 301 vlan 240 dscp 16 ttl 64 wait 5ms
    c -> s memcached cmd "delete" key "sess:revoked:4409" opaque 302 vlan 240 dscp 16 ttl 64 wait 2ms
    c <- s memcached cmd "deleted" key "sess:revoked:4409" opaque 302 vlan 240 dscp 16 ttl 64
}

// INSTRUCTION: Compile the Memcached TOUCH and DELETE VLAN 240 trace into a PCAP file.
compile {
    touch_and_delete_flow(session_mgr, memcache_vlan)
}
