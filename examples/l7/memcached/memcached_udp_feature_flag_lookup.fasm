// PROMPT: Simulate a Memcached UDP transport datagram GET and response exchange for low-latency feature flag lookups.
// TOKENS: host, ip, mac, flow, s, memcached, transport, udp, srcport, dstport, get, key, opaque, wait, ms, payload, compile

// INSTRUCTION: Define the low-latency ad-bidding engine querying feature flags over Memcached UDP port 11211.
host bidder_engine {
    ip 10.88.1.120
    mac 00:0c:29:88:01:78
}

// INSTRUCTION: Define the Memcached server with UDP listener enabled on port 11211.
host udp_memcache {
    ip 10.88.1.10
    mac 00:0c:29:88:01:0a
}

// INSTRUCTION: Send a Memcached GET over TRANSPORT UDP and receive the cached feature flag value.
flow udp_feature_flag_lookup(c, s) {
    c -> s memcached transport udp srcport 53110 dstport 11211 get key "ff:dark_mode_v2" opaque 801 wait 1ms
    c <- s memcached transport udp srcport 11211 dstport 53110 get key "ff:dark_mode_v2" opaque 801 payload "enabled=true"
}

// INSTRUCTION: Compile the UDP Memcached feature flag lookup into a PCAP file.
compile {
    udp_feature_flag_lookup(bidder_engine, udp_memcache)
}
