// Modbus TCP to RTU serial bridge routing command to slave device unit ID 15.
// Wireshark: mbtcp || modbus

// Multi-drop master poller.
host master_poller { ip 10.10.8.5 }

// RS485 serial gateway bridge.
host rs485_gateway { ip 10.10.8.20 }

// Bridged serial command flow. Modbus functions: FC 3 Read Holding Registers.
flow bridged_unit_flow(mst, gw) {
    mst -> gw modbus func "readholdingregisters" addr 50 count 10 unitid 15 txid 7788
}

compile {
    bridged_unit_flow(master_poller, rs485_gateway)
}
