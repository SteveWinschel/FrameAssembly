// Modbus TCP starter request on TCP port 502 using built-in defaults.
// Omitting extra keywords emits a 12-byte FC 3 Read Holding Registers query
// (unit 1).
// Wireshark: mbtcp || modbus

host hmi_master {
    ip 192.168.100.10
    mac 00:1a:2b:64:00:10
}

host plc_slave {
    ip 192.168.100.50
    mac 00:1a:2b:64:00:50
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    hmi_master -> plc_slave modbus
}
