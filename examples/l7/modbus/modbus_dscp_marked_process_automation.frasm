// Modbus industrial automation command with DSCP expedited forwarding
// priority marking.
// Wireshark: mbtcp || modbus

// Emergency shutdown safety system.
host safety_system { ip 192.168.1.99 }

// Emergency relief valve actuator.
host valve_actuator { ip 192.168.1.150 }

// DSCP prioritized emergency coil write flow. Encapsulation and QoS markings:
// DSCP 46. Modbus functions: FC 5 Write Single Coil.
flow emergency_valve_trip(sys, act) {
    sys -> act modbus func "writesinglecoil" addr 10 value 65280 unitid 1 dscp 46
}

compile {
    emergency_valve_trip(safety_system, valve_actuator)
}
