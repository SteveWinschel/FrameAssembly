// Modern electrical substation RTU communication running Modbus TCP over
// IPv6.
// Wireshark: mbtcp || modbus

// Electrical grid control center.
host grid_control { ip 2001:db8:5ca0::10 }

// Smart grid feeder RTU.
host feeder_rtu { ip 2001:db8:5ca0::200 }

// IPv6 Modbus telemetry flow. Modbus functions: FC 3 Read Holding Registers.
flow v6_substation_poll(ctrl, rtu) {
    ctrl -> rtu modbus func "readholdingregisters" addr 1000 count 8 unitid 5
}

compile {
    v6_substation_poll(grid_control, feeder_rtu)
}
