// PROMPT: Create a Modbus Function Code 22 (Mask Write Register) and Function Code 43 (Read Device Identification MEI) exchange.
// TOKENS: host, ip, mac, flow, s, modbus, txid, unitid, func, addr, value, hexpayload, wait, ms, isresponse, compile

// INSTRUCTION: Define the asset inventory scanner reading device identification and toggling status bits.
host ot_asset_scanner {
    ip 10.30.100.15
    mac 00:16:3e:30:64:0f
}

// INSTRUCTION: Define the Schneider Electric Modicon PLC responding to MEI 0x2B/0x0E and FC 22 requests.
host modicon_plc {
    ip 10.30.100.80
    mac 00:80:f4:30:64:50
}

// INSTRUCTION: Request Read Device Identification (FC 43 / 0x2B) via HEXPAYLOAD and then execute a Mask Write Register (FC 22).
flow mei_id_and_mask_write(c, s) {
    c -> s modbus txid 1101 unitid 1 func "encapsulatedinterface" addr 0 value 1 hexpayload "2b0e0100" wait 4ms
    c <- s modbus txid 1101 unitid 1 func "encapsulatedinterface" isresponse value 1 hexpayload "2b0e010100000100095363686e6569646572" wait 8ms
    c -> s modbus txid 1102 unitid 1 func "maskwriteregister" addr 40 value 0x00f2 hexpayload "00f20025" wait 3ms
    c <- s modbus txid 1102 unitid 1 func "maskwriteregister" addr 40 value 0x00f2 isresponse hexpayload "00f20025"
}

// INSTRUCTION: Compile the Modbus MEI device identification and Mask Write Register trace into a PCAP file.
compile {
    mei_id_and_mask_write(ot_asset_scanner, modicon_plc)
}
