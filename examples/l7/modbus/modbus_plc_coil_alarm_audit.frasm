// OT/SCADA Modbus TCP coil alarm activation and holding-register audit.
// Covers FC 1 Read Coils, FC 5 Write Single Coil (0xFF00 = ON), and FC 3 Read
// Holding Registers for safety alarm telemetry on TCP 502.
// Wireshark: mbtcp || modbus

host safety_hmi {
    ip 10.88.10.10
    mac 00:1b:1b:88:0a:0a
}

host safety_plc {
    ip 10.88.10.50
    mac 00:1b:1b:88:0a:32
}

// Poll safety coils, assert alarm coil 4 (65280), and read alarm register
// 100.
flow modbus_alarm_audit(hmi, plc) {
    hmi -> plc modbus txid 101 unitid 1 func "readcoils"
        addr 0 count 8 wait 3ms
    hmi <- plc modbus txid 101 unitid 1 func "readcoils"
        isresponse count 8 value 0 wait 5ms
    hmi -> plc modbus txid 102 unitid 1 func "writesinglecoil"
        addr 4 value 65280 wait 3ms
    hmi <- plc modbus txid 102 unitid 1 func "writesinglecoil"
        isresponse addr 4 value 65280 wait 5ms
    hmi -> plc modbus txid 103 unitid 1 func "readholdingregisters"
        addr 100 count 1 wait 3ms
    hmi <- plc modbus txid 103 unitid 1 func "readholdingregisters"
        isresponse count 1 value 1
}

compile {
    modbus_alarm_audit(safety_hmi, safety_plc)
}
