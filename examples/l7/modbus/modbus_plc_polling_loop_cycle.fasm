// PROMPT: Cyclic industrial control polling loop querying RTU register status every 25ms.
// TOKENS: host, ip, flow, modbus, func, addr, count, unitid, wait, ms, compile

// INSTRUCTION: Define factory DCS central controller.
host factory_dcs { ip 192.168.40.1 }

// INSTRUCTION: Define conveyor belt slave drive.
host conveyor_drive { ip 192.168.40.50 }

// INSTRUCTION: Define periodic register polling flow.
flow cyclic_poll_flow(dcs, drv) {
    dcs -> drv modbus func "readholdingregisters" addr 500 count 2 unitid 1 wait 25ms
}

// INSTRUCTION: Compile cyclic PLC polling in loop.
compile {
    cyclic_poll_flow(factory_dcs, conveyor_drive) // cycle 1
    cyclic_poll_flow(factory_dcs, conveyor_drive) // cycle 2
    cyclic_poll_flow(factory_dcs, conveyor_drive) // cycle 3
}
