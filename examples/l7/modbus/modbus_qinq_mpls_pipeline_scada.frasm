// Build a wide-area pipeline SCADA Modbus telemetry flow encapsulated in QinQ
// 500/30 and MPLS label 72000.
// Wireshark: mbtcp || modbus

// Central pipeline control center master station.
host pipeline_mcc {
    ip 10.210.1.10
    mac 00:50:56:d2:01:0a
}

// Remote compressor station RTU across the utility MPLS network.
host compressor_rtu {
    ip 10.210.45.20
    mac 00:50:56:d2:2d:14
}

// Poll suction and discharge pressure registers over QinQ 500/30 and MPLS
// label 72000. Encapsulation and QoS markings: 802.1ad QinQ S-VLAN 500 /
// C-VLAN 30, MPLS label 72000, DSCP 46. Modbus functions: FC 3 Read Holding
// Registers.
flow pipeline_qinq_mpls_modbus(c, s) {
    c -> s modbus txid 901 unitid 1 func "readholdingregisters" addr 300 count 6 qinq 500 innervlan 30 mpls 72000 dscp 46 ttl 58 wait 14ms
    c <- s modbus txid 901 unitid 1 func "readholdingregisters" isresponse value 1140 qinq 500 innervlan 30 mpls 72000 dscp 46 ttl 58
}

compile {
    pipeline_qinq_mpls_modbus(pipeline_mcc, compressor_rtu)
}
