// PROMPT: Create a Modbus Function Code 01 (Read Coils) and Function Code 02 (Read Discrete Inputs) exchange on TCP port 502.
// TOKENS: host, ip, mac, flow, s, modbus, txid, unitid, func, addr, count, wait, ms, isresponse, value, compile

// INSTRUCTION: Define the manufacturing execution system (MES) polling digital I/O status.
host mes_poller {
    ip 10.50.1.10
    mac 00:1c:06:50:01:10
}

// INSTRUCTION: Define the conveyor line PLC controller with Unit ID 1.
host conveyor_plc {
    ip 10.50.1.101
    mac 00:1c:06:50:01:65
}

// INSTRUCTION: Poll 16 output coils starting at address 0 (FC 01) and 16 discrete limit-switch inputs at address 100 (FC 02).
flow read_coils_and_discrete_inputs(c, s) {
    c -> s modbus txid 101 unitid 1 func "readcoils" addr 0 count 16 wait 3ms
    c <- s modbus txid 101 unitid 1 func "readcoils" isresponse value 0x05a3 wait 10ms
    c -> s modbus txid 102 unitid 1 func "readdiscreteinputs" addr 100 count 16 wait 3ms
    c <- s modbus txid 102 unitid 1 func "readdiscreteinputs" isresponse value 0x00ff
}

// INSTRUCTION: Compile the Modbus FC 01 and FC 02 digital I/O poll into a PCAP file.
compile {
    read_coils_and_discrete_inputs(mes_poller, conveyor_plc)
}
