// Modbus Function Code 01 (Read Coils) and Function Code 02 (Read Discrete
// Inputs) exchange on TCP port 502.
// Wireshark: mbtcp || modbus

// Manufacturing execution system (MES) polling digital I/O status.
host mes_poller {
    ip 10.50.1.10
    mac 00:1c:06:50:01:10
}

// Conveyor line PLC controller with Unit ID 1.
host conveyor_plc {
    ip 10.50.1.101
    mac 00:1c:06:50:01:65
}

// Poll 16 output coils starting at address 0 (FC 01) and 16 discrete
// limit-switch inputs at address 100 (FC 02). Modbus functions: FC 1 Read
// Coils, FC 2 Read Discrete Inputs.
flow read_coils_and_discrete_inputs(c, s) {
    c -> s modbus txid 101 unitid 1 func "readcoils" addr 0 count 16 wait 3ms
    c <- s modbus txid 101 unitid 1 func "readcoils" isresponse value 0x05a3 wait 10ms
    c -> s modbus txid 102 unitid 1 func "readdiscreteinputs" addr 100 count 16 wait 3ms
    c <- s modbus txid 102 unitid 1 func "readdiscreteinputs" isresponse value 0x00ff
}

compile {
    read_coils_and_discrete_inputs(mes_poller, conveyor_plc)
}
