// Modbus TCP function code 1 reading digital output coil statuses from remote
// PLC.
// Wireshark: mbtcp || modbus

// Industrial SCADA supervisory station.
host scada_station { ip 192.168.10.10 }

// Programmable logic controller (PLC).
host field_plc { ip 192.168.10.200 }

// Read coils operation flow. Modbus functions: FC 1 Read Coils.
flow read_coils_flow(scada, plc) {
    scada -> plc modbus func "readcoils" addr 0 count 16 unitid 1
}

compile {
    read_coils_flow(scada_station, field_plc)
}
