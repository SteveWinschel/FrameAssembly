// Modbus TCP function code 2 reading discrete input binary telemetry from
// RTU.
// Wireshark: mbtcp || modbus

// Water treatment plant master controller.
host water_plant_hmi { ip 10.100.1.15 }

// Remote telemetry unit pump controller.
host pump_station_rtu { ip 10.100.1.50 }

// Read discrete inputs flow. Modbus functions: FC 2 Read Discrete Inputs.
flow read_inputs_flow(hmi, rtu) {
    hmi -> rtu modbus func "readdiscreteinputs" addr 10001 count 8 unitid 2
}

compile {
    read_inputs_flow(water_plant_hmi, pump_station_rtu)
}
