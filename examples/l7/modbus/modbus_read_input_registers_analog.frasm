// Modbus TCP function code 4 reading analog sensor measurements from input
// registers.
// Wireshark: mbtcp || modbus

// Environmental telemetry monitor.
host env_monitor { ip 172.25.1.20 }

// Analog weather station sensor RTU.
host weather_rtu { ip 172.25.1.100 }

// Read input registers flow. Modbus functions: FC 4 Read Input Registers.
flow read_analog_flow(mon, rtu) {
    mon -> rtu modbus func "readinputregisters" addr 30001 count 4 unitid 1
}

compile {
    read_analog_flow(env_monitor, weather_rtu)
}
