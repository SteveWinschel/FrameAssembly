// Modbus TCP response frame returning holding register integer values to
// SCADA master.
// Wireshark: mbtcp || modbus

host scada_client { ip 10.50.1.10 }

// Responding field RTU node.
host field_rtu_node { ip 10.50.1.25 }

// Modbus response packet flow.
flow modbus_response_flow(mst, rtu) {
    mst <- rtu modbus isresponse txid 101 protoid 0 unitid 1 count 2 value 1234
}

compile {
    modbus_response_flow(scada_client, field_rtu_node)
}
