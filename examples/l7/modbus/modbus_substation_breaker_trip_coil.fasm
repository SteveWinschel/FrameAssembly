// PROMPT: Simulate an urgent Modbus TCP Write Single Coil (Function 05) command tripping a substation protection relay.
// TOKENS: HOST, IP, MAC, FLOW, MODBUS, TXID, PROTO_ID, UNITID, FUNC, ADDR, VALUE, DSCP, TTL, WAIT, IS_RESPONSE, COUNT, COMPILE

// INSTRUCTION: Define the substation protection SCADA master.
HOST prot_master {
    IP 10.205.1.10
    MAC 00:1b:1b:cd:01:0a
}

// INSTRUCTION: Define the feeder breaker intelligent electronic device (IED).
HOST breaker_ied {
    IP 10.205.1.52
    MAC 00:1b:1b:cd:01:34
}

// INSTRUCTION: Issue Write Single Coil (0xFF00 = ON) to coil address 10 with DSCP CS6 network control priority.
FLOW modbus_breaker_trip(m, ied) {
    m -> ied MODBUS TXID 901 PROTO_ID 0 UNITID 1 FUNC "WRITE_SINGLE_COIL" ADDR 10 VALUE 65280 DSCP 48 TTL 64 WAIT 2ms
    m <- ied MODBUS TXID 901 PROTO_ID 0 UNITID 1 FUNC "WRITE_SINGLE_COIL" IS_RESPONSE ADDR 10 VALUE 65280 DSCP 48 TTL 64 WAIT 5ms
    m -> ied MODBUS TXID 902 PROTO_ID 0 UNITID 1 FUNC "READ_DISCRETE_INPUTS" ADDR 10 COUNT 4 DSCP 48 TTL 64 WAIT 2ms
    m <- ied MODBUS TXID 902 PROTO_ID 0 UNITID 1 FUNC "READ_DISCRETE_INPUTS" IS_RESPONSE VALUE 1 DSCP 48 TTL 64
}

// INSTRUCTION: Compile the high-priority Modbus substation breaker trip flow.
COMPILE {
    modbus_breaker_trip(prot_master, breaker_ied)
}
