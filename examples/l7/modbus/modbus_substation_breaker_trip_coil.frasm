// PROMPT: Simulate an urgent Modbus TCP Write Single Coil (Function 05) command tripping a substation protection relay.
// TOKENS: host, ip, mac, flow, m, modbus, txid, protoid, unitid, func, addr, value, dscp, ttl, wait, ms, isresponse, count, compile

// INSTRUCTION: Define the substation protection SCADA master.
host prot_master {
    ip 10.205.1.10
    mac 00:1b:1b:cd:01:0a
}

// INSTRUCTION: Define the feeder breaker intelligent electronic device (IED).
host breaker_ied {
    ip 10.205.1.52
    mac 00:1b:1b:cd:01:34
}

// INSTRUCTION: Issue Write Single Coil (0xFF00 = ON) to coil address 10 with DSCP CS6 network control priority.
flow modbus_breaker_trip(m, ied) {
    m -> ied modbus txid 901 protoid 0 unitid 1 func "writesinglecoil" addr 10 value 65280 dscp 48 ttl 64 wait 2ms
    m <- ied modbus txid 901 protoid 0 unitid 1 func "writesinglecoil" isresponse addr 10 value 65280 dscp 48 ttl 64 wait 5ms
    m -> ied modbus txid 902 protoid 0 unitid 1 func "readdiscreteinputs" addr 10 count 4 dscp 48 ttl 64 wait 2ms
    m <- ied modbus txid 902 protoid 0 unitid 1 func "readdiscreteinputs" isresponse value 1 dscp 48 ttl 64
}

// INSTRUCTION: Compile the high-priority Modbus substation breaker trip flow.
compile {
    modbus_breaker_trip(prot_master, breaker_ied)
}
