// Modbus UDP transport broadcast time synchronization write and unicast
// diagnostic poll.
// Wireshark: mbtcp || modbus

// Real-time automation controller sending low-overhead Modbus UDP frames.
host rtac_master {
    ip 192.168.60.1
    mac 00:30:a7:60:00:01
}

// Substation bay controller listening for Modbus UDP on port 502.
host bay_controller {
    ip 192.168.60.25
    mac 00:30:a7:60:00:19
}

// Send a broadcast Unit ID 0 register write over TRANSPORT UDP followed by a
// Unit ID 25 read over UDP. Overrides default TCP with UDP transport on port
// 502. Modbus functions: FC 6 Write Single Register, FC 3 Read Holding
// Registers.
flow modbus_udp_sync_and_poll(c, s) {
    c -> s modbus transport udp srcport 52502 dstport 502 txid 1001 unitid 0 func "writesingleregister" addr 500 value 3600 wait 5ms
    c -> s modbus transport udp srcport 52502 dstport 502 txid 1002 unitid 25 func "readholdingregisters" addr 500 count 1 wait 2ms
    c <- s modbus transport udp srcport 502 dstport 52502 txid 1002 unitid 25 func "readholdingregisters" isresponse value 3600
}

compile {
    modbus_udp_sync_and_poll(rtac_master, bay_controller)
}
