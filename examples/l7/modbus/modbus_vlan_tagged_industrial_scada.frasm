// Critical infrastructure Modbus control traffic isolated on 802.1Q SCADA
// VLAN.
// Wireshark: mbtcp || modbus

// Operations control center HMI.
host occ_hmi { ip 10.200.5.12 }

// Generator protection relay PLC.
host generator_relay { ip 10.200.5.80 }

// Tagged VLAN Modbus interrogation flow. Encapsulation and QoS markings:
// 802.1Q VLAN 502. Modbus functions: FC 3 Read Holding Registers.
flow vlan_modbus_flow(hmi, rly) {
    hmi -> rly modbus func "readholdingregisters" addr 200 count 6 unitid 1 vlan 502 pcp 6 dei 0
}

compile {
    vlan_modbus_flow(occ_hmi, generator_relay)
}
