// PROMPT: Create a Modbus Function Code 15 (Write Multiple Coils) and Function Code 16 (Write Multiple Registers) recipe download over TCP.
// TOKENS: HOST, IP, MAC, FLOW, TCP, SRCPORT, DSTPORT, SYN, SEQ, WIN, WAIT, ACK, ACKNUM, MODBUS, TXID, UNITID, FUNC, ADDR, COUNT, VALUE, IS_RESPONSE, FIN, COMPILE

// INSTRUCTION: Define the batch server downloading a multi-parameter mixing recipe to a packaging line PLC.
HOST batch_server {
    IP 10.100.20.10
    MAC 00:1b:1b:64:14:0a
}

// INSTRUCTION: Define the packaging line PLC on TCP port 502.
HOST packaging_plc {
    IP 10.100.20.55
    MAC 00:1b:1b:64:14:37
}

// INSTRUCTION: Establish a TCP connection, execute FC 15 (Write Multiple Coils) and FC 16 (Write Multiple Registers), and close with FIN.
FLOW recipe_download_tcp(c, s) {
    c -> s TCP SRCPORT 49502 DSTPORT 502 SYN SEQ 500000 WIN 64240 WAIT 1ms
    c <- s TCP SRCPORT 502 DSTPORT 49502 SYN ACK SEQ 600000 ACKNUM 500001 WIN 32768 WAIT 1ms
    c -> s TCP SRCPORT 49502 DSTPORT 502 ACK SEQ 500001 ACKNUM 600001 WIN 64240 WAIT 2ms
    c -> s MODBUS SRCPORT 49502 DSTPORT 502 SEQ 500001 ACKNUM 600001 TXID 301 UNITID 1 FUNC "WRITE_MULTIPLE_COILS" ADDR 32 COUNT 8 VALUE 0xaa WAIT 4ms
    c <- s MODBUS SRCPORT 502 DSTPORT 49502 SEQ 600001 ACKNUM 500016 TXID 301 UNITID 1 FUNC "WRITE_MULTIPLE_COILS" ADDR 32 COUNT 8 IS_RESPONSE WAIT 5ms
    c -> s MODBUS SRCPORT 49502 DSTPORT 502 SEQ 500016 ACKNUM 600013 TXID 302 UNITID 1 FUNC "WRITE_MULTIPLE_REGISTERS" ADDR 200 COUNT 10 VALUE 1500 WAIT 5ms
    c <- s MODBUS SRCPORT 502 DSTPORT 49502 SEQ 600013 ACKNUM 500049 TXID 302 UNITID 1 FUNC "WRITE_MULTIPLE_REGISTERS" ADDR 200 COUNT 10 IS_RESPONSE WAIT 2ms
    c -> s TCP SRCPORT 49502 DSTPORT 502 FIN ACK SEQ 500049 ACKNUM 600025 WIN 64240 WAIT 1ms
    c <- s TCP SRCPORT 502 DSTPORT 49502 FIN ACK SEQ 600025 ACKNUM 500050 WIN 32768 WAIT 1ms
    c -> s TCP SRCPORT 49502 DSTPORT 502 ACK SEQ 500050 ACKNUM 600026 WIN 64240
}

// INSTRUCTION: Compile the full TCP Modbus FC 15 and FC 16 recipe download into a PCAP file.
COMPILE {
    recipe_download_tcp(batch_server, packaging_plc)
}
