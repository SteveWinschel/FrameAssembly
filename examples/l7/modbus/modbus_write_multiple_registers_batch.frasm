// Modbus TCP function code 16 writing batch parameter configuration to PLC
// registers.
// Wireshark: mbtcp || modbus

// Assembly line engineering workstation.
host eng_workstation { ip 192.168.2.10 }

// Manufacturing cell PLC controller.
host robot_cell_plc { ip 192.168.2.88 }

// Write multiple registers configuration flow. Modbus functions: FC 16 Write
// Multiple Registers.
flow write_batch_config(eng, plc) {
    eng -> plc modbus func "writemultipleregisters" addr 40100 count 5 unitid 3
}

compile {
    write_batch_config(eng_workstation, robot_cell_plc)
}
