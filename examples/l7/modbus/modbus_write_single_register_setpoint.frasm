// Modbus TCP function code 6 updating industrial PID temperature controller
// setpoint.
// Wireshark: mbtcp || modbus

// Furnace supervisory station.
host furnace_hmi { ip 172.16.80.14 }

// Temperature controller device.
host temp_controller { ip 172.16.80.200 }

// Setpoint write flow. Modbus functions: FC 6 Write Single Register.
flow write_setpoint_flow(hmi, ctrl) {
    hmi -> ctrl modbus func "writesingleregister" addr 40050 value 750 unitid 1
}

compile {
    write_setpoint_flow(furnace_hmi, temp_controller)
}
