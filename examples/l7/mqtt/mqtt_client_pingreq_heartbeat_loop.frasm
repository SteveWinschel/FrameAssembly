// MQTT keepalive heartbeat loop periodically transmitting PINGREQ to maintain
// session.
// Wireshark: mqtt

host lowpower_client { ip 192.168.20.99 }

// Cloud MQTT gateway.
host cloud_gateway { ip 192.168.20.1 }

// Heartbeat PINGREQ transmission flow. Repeats 3 times; each wait value
// pauses after sending its packet.
flow heartbeat_ping_flow(cli, gw) {
    cli -> gw mqtt pingreq wait 50ms
}

compile {
    heartbeat_ping_flow(lowpower_client, cloud_gateway) // cycle 1
    heartbeat_ping_flow(lowpower_client, cloud_gateway) // cycle 2
    heartbeat_ping_flow(lowpower_client, cloud_gateway) // cycle 3
}
