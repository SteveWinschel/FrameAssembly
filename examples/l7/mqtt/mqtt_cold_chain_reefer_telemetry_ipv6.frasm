// PROMPT: Simulate an IPv6 refrigerated container (reefer) publishing QoS 1 temperature and humidity telemetry.
// TOKENS: host, ip, mac, flow, mqtt, connect, clientid, flowlabel, dscp, ttl, wait, ms, connack, returncode, publish, topic, qos, pktid, payload, puback, compile

// INSTRUCTION: Define the IPv6 smart refrigerated container telematics unit.
host reefer_unit_v6 {
    ip 2001:db8:c01d:1::42
    mac 00:16:3e:c0:1d:42
}

// INSTRUCTION: Define the IPv6 logistics cloud MQTT ingestion broker.
host logistics_broker_v6 {
    ip 2001:db8:c01d:1::1
    mac 00:16:3e:c0:1d:01
}

// INSTRUCTION: Connect over IPv6 and publish cold-chain cargo sensor telemetry with QoS 1 acknowledgment.
flow mqtt_cold_chain_v6(c, b) {
    c -> b mqtt connect clientid "reefer-cont-0042" flowlabel 0xc01d1 dscp 26 ttl 64 wait 3ms
    c <- b mqtt connack returncode 0 flowlabel 0xc01d1 dscp 26 ttl 64 wait 2ms
    c -> b mqtt publish topic "fleet/coldchain/cont0042/env" qos 1 pktid 88
        payload "{'temp_c':-18.4,'rh_pct':82.1,'door':'closed'}" flowlabel 0xc01d1 dscp 26 ttl 64 wait 4ms
    c <- b mqtt puback pktid 88 flowlabel 0xc01d1 dscp 26 ttl 64
}

// INSTRUCTION: Compile the IPv6 cold-chain MQTT telemetry scenario.
compile {
    mqtt_cold_chain_v6(reefer_unit_v6, logistics_broker_v6)
}
