// MQTT CONNACK authentication failure sequence testing returncode 4 (Bad
// username or password) and returncode 5 (Not authorized).
// Wireshark: mqtt

// Misconfigured edge gateway attempting to connect with expired credentials.
host edge_gateway {
    ip 172.18.10.77
    mac 00:16:3e:12:0a:4d
}

// VerneMQ broker enforcing strict credential ACLs.
host vernemq_broker {
    ip 172.18.10.10
    mac 00:16:3e:12:0a:0a
}

// Attempt CONNECT and receive CONNACK returncode 4, retry with another client
// ID and receive returncode 5, then succeed with returncode 0. MQTT control
// session on TCP 1883 (CONNACK codes 0, 4, 5).
flow connack_auth_failures(c, s) {
    c -> s mqtt connect clientid "gw-unauth-01" wait 3ms
    c <- s mqtt connack returncode 4 wait 20ms
    c -> s mqtt connect clientid "gw-restricted-01" wait 3ms
    c <- s mqtt connack returncode 5 wait 20ms
    c -> s mqtt connect clientid "gw-provisioned-01" wait 3ms
    c <- s mqtt connack returncode 0
}

compile {
    connack_auth_failures(edge_gateway, vernemq_broker)
}
