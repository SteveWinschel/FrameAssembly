// MQTT broker CONNACK packet confirming successful connection and session
// acknowledgment.
// Wireshark: mqtt

host edge_client_device { ip 10.12.0.40 }

// Enterprise message broker.
host enterprise_broker { ip 10.12.0.1 }

// CONNACK acknowledgment response flow. MQTT control session on TCP 1883
// (CONNACK codes 0).
flow connack_response_flow(dev, brk) {
    dev <- brk mqtt connack returncode 0
}

compile {
    connack_response_flow(edge_client_device, enterprise_broker)
}
