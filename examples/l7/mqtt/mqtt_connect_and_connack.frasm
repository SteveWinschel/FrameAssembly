// MQTT broker session initiation with CONNECT and CONNACK response.
// Wireshark: mqtt
// Automatic Ethernet MAC addresses and TCP port 1883 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.10 }

host server { ip 192.168.1.2 }

flow mqtt_conn(c, s) {
    c -> s mqtt connect clientid "iot_sensor_1"
    c <- s mqtt connack
}

compile {
    mqtt_conn(client, server)
}
