// MQTT client session connection specifying client ID and clean session
// initiation.
// Wireshark: mqtt

// Offshore oil rig telemetry node.
host offshore_telemetry { ip 198.51.100.14 }

// Onshore central MQTT broker.
host onshore_broker { ip 198.51.100.1 }

// Extended keepalive connection flow.
flow extended_keepalive_conn(node, brk) {
    node -> brk mqtt connect clientid "offshore-rig-alpha"
}

compile {
    extended_keepalive_conn(offshore_telemetry, onshore_broker)
}
