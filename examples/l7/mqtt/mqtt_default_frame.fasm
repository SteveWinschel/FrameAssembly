// PROMPT: Generate a minimal default MQTT frame with default protocol parameters between an IoT sensor and an MQTT broker.
// TOKENS: host, ip, mac, flow, s, mqtt, compile

// INSTRUCTION: Define the IoT edge sensor publishing telemetry.
host iot_sensor {
    ip 192.168.10.50
    mac 00:1a:2b:10:00:50
}

// INSTRUCTION: Define the Mosquitto MQTT message broker on port 1883.
host mqtt_broker {
    ip 192.168.10.10
    mac 00:1a:2b:10:00:10
}

// INSTRUCTION: Emit a default MQTT protocol frame using built-in defaults.
flow default_mqtt_flow(c, s) {
    c -> s mqtt
}

// INSTRUCTION: Compile the default MQTT packet into a PCAP file.
compile {
    default_mqtt_flow(iot_sensor, mqtt_broker)
}
