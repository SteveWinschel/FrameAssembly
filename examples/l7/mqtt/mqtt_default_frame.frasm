// MQTT v3.1.1 starter control packet on TCP port 1883 using built-in
// defaults. Omitting extra keywords emits a 23-byte MQTT CONNECT handshake
// packet.
// Wireshark: mqtt

host iot_sensor {
    ip 192.168.10.50
    mac 00:1a:2b:10:00:50
}

host mqtt_broker {
    ip 192.168.10.10
    mac 00:1a:2b:10:00:10
}

// Send the frame directly in compile without needing a reusable flow block.
compile {
    iot_sensor -> mqtt_broker mqtt
}
