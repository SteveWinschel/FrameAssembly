// PROMPT: Create an AWS IoT Core Device Shadow delta synchronization flow using $aws/things shadow topics on port 8883.
// TOKENS: host, ip, mac, flow, s, mqtt, srcport, dstport, subscribe, topic, qos, pktid, wait, ms, suback, publish, payload, puback, compile

// INSTRUCTION: Define the smart HVAC heat pump synchronizing its desired state with AWS IoT Device Shadow.
host heat_pump {
    ip 192.168.12.64
    mac 00:24:e8:0c:00:40
}

// INSTRUCTION: Define the cloud IoT broker endpoint on port 8883.
host iot_core_endpoint {
    ip 198.51.100.88
    mac 00:24:e8:0c:00:01
}

// INSTRUCTION: Subscribe to the shadow update/delta topic, receive a desired temperature change, and report the updated state.
flow device_shadow_sync(c, s) {
    c -> s mqtt srcport 51883 dstport 8883 subscribe topic "$aws/things/heatpump-04/shadow/update/delta" qos 1 pktid 10 wait 12ms
    c <- s mqtt srcport 8883 dstport 51883 suback pktid 10 qos 1 wait 20ms
    c <- s mqtt srcport 8883 dstport 51883 publish topic "$aws/things/heatpump-04/shadow/update/delta" qos 1 pktid 11 payload "{\"state\":{\"target_c\":21.5}}" wait 2ms
    c -> s mqtt srcport 51883 dstport 8883 puback pktid 11 wait 5ms
    c -> s mqtt srcport 51883 dstport 8883 publish topic "$aws/things/heatpump-04/shadow/update" qos 1 pktid 12 payload "{\"state\":{\"reported\":{\"target_c\":21.5}}}" wait 12ms
    c <- s mqtt srcport 8883 dstport 51883 puback pktid 12
}

// INSTRUCTION: Compile the IoT Device Shadow MQTT synchronization trace into a PCAP file.
compile {
    device_shadow_sync(heat_pump, iot_core_endpoint)
}
