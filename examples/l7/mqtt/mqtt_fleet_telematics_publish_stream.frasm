// Connected vehicle telematics gateway streaming GPS location coordinates via
// MQTT.
// Wireshark: mqtt

// Vehicle telematics unit.
host vehicle_telematics { ip 10.220.1.88 }

// Fleet operations broker.
host fleet_broker { ip 10.220.1.10 }

// Vehicle GPS telemetry publishing flow.
flow vehicle_gps_publish(veh, brk) {
    veh -> brk mqtt publish topic "fleet/truck402/location" clientid "truck-obd-402"
}

compile {
    vehicle_gps_publish(vehicle_telematics, fleet_broker)
}
