// Full TCP-connected MQTT session with CONNECT, CONNACK, QoS 1 PUBLISH,
// PUBACK, and TCP FIN teardown.
// Wireshark: tcp || mqtt

// Smart meter gateway publishing hourly kWh readings.
host meter_gateway {
    ip 10.40.20.55
    mac 00:50:56:40:20:55
}

// EMQX broker listening on TCP port 1883.
host emqx_broker {
    ip 10.40.20.10
    mac 00:50:56:40:20:10
}

// Complete a TCP handshake, connect to the broker, publish a QoS 1 message
// with PUBACK, and close the connection. MQTT control session on TCP 1883
// (QoS 1, CONNACK codes 0).
flow full_mqtt_tcp_lifecycle(c, s) {
    c -> s tcp dstport 1883 syn seq 100000 wait 1ms
    c <- s tcp syn ack seq 200000 acknum 100001 wait 1ms
    c -> s tcp dstport 1883 ack seq 100001 acknum 200001 wait 2ms
    c -> s mqtt dstport 1883 seq 100001 acknum 200001 connect clientid "meter-gw-055" wait 3ms
    c <- s mqtt seq 200001 acknum 100027 connack returncode 0 wait 5ms
    c -> s mqtt dstport 1883 seq 100027 acknum 200005 publish topic "grid/substation4/meter055/kwh" qos 1 pktid 10 payload "{\"kwh\":1420.5}" wait 3ms
    c <- s mqtt seq 200005 acknum 100078 puback pktid 10 wait 2ms
    c -> s tcp dstport 1883 fin ack seq 100078 acknum 200009 wait 1ms
    c <- s tcp fin ack seq 200009 acknum 100079 wait 1ms
    c -> s tcp dstport 1883 ack seq 100079 acknum 200010
}

compile {
    full_mqtt_tcp_lifecycle(meter_gateway, emqx_broker)
}
