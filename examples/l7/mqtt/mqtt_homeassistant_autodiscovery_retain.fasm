// PROMPT: Generate an MQTT Home Assistant auto-discovery configuration publish followed by state telemetry.
// TOKENS: host, ip, mac, flow, s, mqtt, connect, clientid, wait, ms, connack, returncode, publish, topic, qos, retain, pktid, payload, puback, compile

// INSTRUCTION: Define the ESPHome smart plug publishing its Home Assistant discovery JSON payload.
host esphome_plug {
    ip 192.168.1.145
    mac 24:6f:28:01:01:45
}

// INSTRUCTION: Define the Home Assistant Mosquitto broker add-on.
host hass_mosquitto {
    ip 192.168.1.10
    mac dc:a6:32:01:00:10
}

// INSTRUCTION: Connect, publish a retained auto-discovery config to homeassistant/sensor/.../config, and publish live watt readings.
flow homeassistant_autodiscovery(c, s) {
    c -> s mqtt connect clientid "esphome-desk-plug" wait 2ms
    c <- s mqtt connack returncode 0 wait 3ms
    c -> s mqtt publish topic "homeassistant/sensor/desk_plug_power/config" qos 1 retain pktid 1
        payload "{\"name\":\"Desk Power\",\"unit_of_meas\":\"W\",\"stat_t\":\"esphome/desk_plug/power\"}" wait 2ms
    c <- s mqtt puback pktid 1 wait 10ms
    c -> s mqtt publish topic "esphome/desk_plug/power" qos 0 payload "124.6"
}

// INSTRUCTION: Compile the Home Assistant MQTT auto-discovery trace into a PCAP file.
compile {
    homeassistant_autodiscovery(esphome_plug, hass_mosquitto)
}
