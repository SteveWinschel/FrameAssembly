// Smart utility meter publishing electrical telemetry to cloud MQTT broker
// over IPv6.
// Wireshark: mqtt

// IPv6 smart electric meter.
host v6_smart_meter { ip 2001:db8:beef::45 }

// Utility IPv6 MQTT broker.
host v6_utility_broker { ip 2001:db8:beef::1 }

// IPv6 telemetry publishing flow.
flow v6_meter_publish(meter, brk) {
    meter -> brk mqtt publish topic "smartgrid/v6/meter45/voltage" clientid "meter-v6-45"
}

compile {
    v6_meter_publish(v6_smart_meter, v6_utility_broker)
}
