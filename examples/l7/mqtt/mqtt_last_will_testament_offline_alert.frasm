// MQTT client connecting with a Last Will and Testament (LWT) payload and the
// broker broadcasting the offline will.
// Wireshark: mqtt

host pump_ctrl {
    ip 10.92.10.21
    mac 00:1b:21:92:0a:15
}

// Plant SCADA MQTT subscriber console.
host scada_console {
    ip 10.92.10.50
    mac 00:1b:21:92:0a:32
}

// Central industrial MQTT broker.
host plant_broker {
    ip 10.92.10.1
    mac 00:1b:21:92:0a:01
}

// Connect pump_ctrl and publish initial online status to the broker. MQTT
// control session on TCP 1883 (QoS 1, CONNACK codes 0). Repeats 2 times; each
// wait value pauses after sending its packet.
flow mqtt_pump_connect(p, b) {
    p -> b mqtt connect clientid "pump-station-21" wait 2ms
    p <- b mqtt connack returncode 0 wait 2ms
    p -> b mqtt publish topic "plant/pump21/status" qos 1 retain pktid 10 payload "online" wait 2ms
    p <- b mqtt puback pktid 10
}

// Deliver the retained LWT offline alert from the broker to scada_console
// upon ungraceful loss.
flow mqtt_lwt_dispatch(s, b) {
    s -> b mqtt subscribe topic "plant/+/status" qos 1 pktid 20 wait 2ms
    s <- b mqtt suback pktid 20 qos 1 wait 15ms
    s <- b mqtt publish topic "plant/pump21/status" qos 1 retain pktid 21 payload "offline_ungraceful_lwt" wait 2ms
    s -> b mqtt puback pktid 21
}

compile {
    mqtt_pump_connect(pump_ctrl, plant_broker)
    mqtt_lwt_dispatch(scada_console, plant_broker)
}
