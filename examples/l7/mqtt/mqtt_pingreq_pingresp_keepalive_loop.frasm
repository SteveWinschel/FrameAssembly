// PROMPT: Generate an MQTT periodic keep-alive heartbeat loop exchanging PINGREQ and PINGRESP frames.
// TOKENS: host, ip, mac, flow, s, mqtt, pingreq, wait, ms, pingresp, compile

// INSTRUCTION: Define the idle connected home thermostat maintaining its MQTT broker session.
host smart_thermostat {
    ip 192.168.50.32
    mac 18:b4:30:50:00:32
}

// INSTRUCTION: Define the cloud MQTT broker endpoint.
host cloud_broker {
    ip 192.168.50.1
    mac 18:b4:30:50:00:01
}

// INSTRUCTION: Exchange 4 consecutive MQTT PINGREQ and PINGRESP keep-alive pairs in a repeated flow calls.
flow mqtt_ping_keepalive_loop(c, s) {
    c -> s mqtt pingreq wait 3ms
    c <- s mqtt pingresp wait 45ms
}

// INSTRUCTION: Compile the MQTT PINGREQ/PINGRESP keep-alive loop into a PCAP file.
compile {
    mqtt_ping_keepalive_loop(smart_thermostat, cloud_broker) // cycle 1
    mqtt_ping_keepalive_loop(smart_thermostat, cloud_broker) // cycle 2
    mqtt_ping_keepalive_loop(smart_thermostat, cloud_broker) // cycle 3
    mqtt_ping_keepalive_loop(smart_thermostat, cloud_broker) // cycle 4
}
