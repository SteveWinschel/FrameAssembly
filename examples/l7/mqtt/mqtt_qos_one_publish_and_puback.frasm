// MQTT QoS 1 reliable publishing with broker PUBACK acknowledgment packet.
// Wireshark: mqtt

// Smart power meter device.
host smart_meter { ip 10.0.12.50 }

// Utility telemetry broker.
host utility_broker { ip 10.0.12.1 }

// QoS 1 publish and PUBACK flow. MQTT control session on TCP 1883 (QoS 1).
flow qos1_publish_ack_flow(dev, brk) {
    dev -> brk mqtt publish topic "grid/meter/power_kw" qos 1 pktid 401 wait 5ms
    dev <- brk mqtt puback pktid 401
}

compile {
    qos1_publish_ack_flow(smart_meter, utility_broker)
}
