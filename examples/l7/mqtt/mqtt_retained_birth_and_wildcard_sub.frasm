// MQTT Last Will and Testament (LWT) retained status publication where a
// device publishes online status with RETAIN and a subscriber receives it.
// Wireshark: mqtt

// Industrial robot controller publishing its retained online birth
// certificate.
host robot_arm {
    ip 10.60.10.21
    mac 00:1b:21:60:10:21
}

// Central plant MQTT broker storing retained state messages.
host plant_broker {
    ip 10.60.10.5
    mac 00:1b:21:60:10:05
}

// Monitoring dashboard subscribing to cell status wildcard topics.
host status_dashboard {
    ip 10.60.10.90
    mac 00:1b:21:60:10:90
}

// Publish a retained QoS 1 birth message from the robot controller to the
// broker. MQTT control session on TCP 1883 (QoS 1). Repeats 2 times; each
// wait value pauses after sending its packet.
flow publish_retained_birth(c, s) {
    c -> s mqtt publish topic "factory/cell2/robot01/status" qos 1 retain pktid 1 payload "ONLINE" wait 2ms
    c <- s mqtt puback pktid 1
}

// Subscribe from the dashboard using a multi-level wildcard and immediately
// receive the retained status message.
flow subscribe_and_receive_retained(c, s) {
    c -> s mqtt subscribe topic "factory/cell2/#" qos 1 pktid 50 wait 2ms
    c <- s mqtt suback pktid 50 qos 1 wait 1ms
    c <- s mqtt publish topic "factory/cell2/robot01/status" qos 1 retain pktid 51 payload "ONLINE" wait 2ms
    c -> s mqtt puback pktid 51
}

compile {
    publish_retained_birth(robot_arm, plant_broker)
    subscribe_and_receive_retained(status_dashboard, plant_broker)
}
