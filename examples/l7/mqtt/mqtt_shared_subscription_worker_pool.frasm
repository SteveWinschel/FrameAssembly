// MQTT v5 shared subscription ($share/workers/jobs/+) load-balancing tasks
// across consumer workers.
// Wireshark: mqtt

// Two microservice worker instances sharing an MQTT v5 subscription group.
host worker_alpha {
    ip 10.25.5.101
    mac 00:50:56:25:05:65
}

// Second microservice worker in the same shared subscription group.
host worker_beta {
    ip 10.25.5.102
    mac 00:50:56:25:05:66
}

// Central MQTT v5 message broker dispatching shared subscription messages
// round-robin.
host mqtt5_broker {
    ip 10.25.5.10
    mac 00:50:56:25:05:0a
}

// Subscribe worker_alpha to $share/workers/jobs/+ and receive job 1. MQTT
// control session on TCP 1883 (QoS 1). Repeats 2 times; each wait value
// pauses after sending its packet.
flow alpha_shared_sub(c, s) {
    c -> s mqtt subscribe topic "$share/workers/jobs/+" qos 1 pktid 1 wait 2ms
    c <- s mqtt suback pktid 1 qos 1 wait 5ms
    c <- s mqtt publish topic "jobs/encode_video" qos 1 pktid 101 payload "{\"job_id\":9001}" wait 2ms
    c -> s mqtt puback pktid 101
}

// Subscribe worker_beta to $share/workers/jobs/+ and receive job 2 in
// round-robin order.
flow beta_shared_sub(c, s) {
    c -> s mqtt subscribe topic "$share/workers/jobs/+" qos 1 pktid 2 wait 2ms
    c <- s mqtt suback pktid 2 qos 1 wait 5ms
    c <- s mqtt publish topic "jobs/encode_video" qos 1 pktid 201 payload "{\"job_id\":9002}" wait 2ms
    c -> s mqtt puback pktid 201
}

compile {
    alpha_shared_sub(worker_alpha, mqtt5_broker)
    beta_shared_sub(worker_beta, mqtt5_broker)
}
