// PROMPT: Create an Eclipse Sparkplug B IIoT MQTT telemetry flow on VLAN 410 publishing NBIRTH and NDATA topics.
// TOKENS: host, ip, mac, flow, s, mqtt, connect, clientid, vlan, dscp, ttl, wait, ms, connack, returncode, publish, topic, qos, hexpayload, pktid, puback, compile

// INSTRUCTION: Define the Sparkplug B edge-of-network (EoN) gateway on industrial VLAN 410.
host sparkplug_eon {
    ip 10.41.0.30
    mac 00:25:90:41:00:1e
}

// INSTRUCTION: Define the HiveMQ Sparkplug B primary broker on VLAN 410.
host hivemq_broker {
    ip 10.41.0.10
    mac 00:25:90:41:00:0a
}

// INSTRUCTION: Connect and publish spBv1.0 NBIRTH and NDATA protobuf payloads over VLAN 410.
flow sparkplug_b_telemetry(c, s) {
    c -> s mqtt connect clientid "spb-eon-line4" vlan 410 dscp 24 ttl 64 wait 2ms
    c <- s mqtt connack returncode 0 vlan 410 dscp 24 ttl 64 wait 3ms
    c -> s mqtt publish topic "spBv1.0/Packaging/NBIRTH/Line4Gateway" qos 0 hexpayload "08c499b59e8631120c0a0662645365711800200a5000" vlan 410 dscp 24 ttl 64 wait 10ms
    c -> s mqtt publish topic "spBv1.0/Packaging/NDATA/Line4Gateway" qos 1 pktid 101 hexpayload "08c599b59e8631120e0a0856656c6f6369747920097842" vlan 410 dscp 24 ttl 64 wait 2ms
    c <- s mqtt puback pktid 101 vlan 410 dscp 24 ttl 64
}

// INSTRUCTION: Compile the Sparkplug B IIoT VLAN 410 MQTT trace into a PCAP file.
compile {
    sparkplug_b_telemetry(sparkplug_eon, hivemq_broker)
}
