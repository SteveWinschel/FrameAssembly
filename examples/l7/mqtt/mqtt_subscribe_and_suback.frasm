// PROMPT: MQTT topic subscription request and broker acknowledgment over IPv6.
// TOKENS: host, ip, flow, s, mqtt, subscribe, topic, qos, pktid, suback, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::2 }

// INSTRUCTION: Define application traffic flow.
flow mqtt_sub(c, s) {
    c -> s mqtt subscribe topic "sensors/temp" qos 1 pktid 100
    c <- s mqtt suback pktid 100
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    mqtt_sub(client, server)
}
