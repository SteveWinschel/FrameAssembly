// MQTT $SYS broker internal metrics subscription monitoring active clients
// and message rates.
// Wireshark: mqtt

// NOC monitoring agent subscribing to Mosquitto $SYS/broker/# statistics.
host noc_monitor {
    ip 10.15.30.80
    mac 00:16:3e:0f:1e:50
}

// Production Mosquitto broker publishing internal $SYS metrics.
host prod_mosquitto {
    ip 10.15.30.10
    mac 00:16:3e:0f:1e:0a
}

// Connect, subscribe to $SYS/broker/clients/connected and
// $SYS/broker/load/messages/received/1min, and receive both updates. MQTT
// control session on TCP 1883 (QoS 0, CONNACK codes 0).
flow sys_broker_metrics(c, s) {
    c -> s mqtt connect clientid "noc-sys-collector" wait 2ms
    c <- s mqtt connack returncode 0 wait 2ms
    c -> s mqtt subscribe topic "$SYS/broker/#" qos 0 pktid 1 wait 2ms
    c <- s mqtt suback pktid 1 qos 0 wait 5ms
    c <- s mqtt publish topic "$SYS/broker/clients/connected" qos 0 payload "1428" wait 2ms
    c <- s mqtt publish topic "$SYS/broker/load/messages/received/1min" qos 0 payload "98450.25"
}

compile {
    sys_broker_metrics(noc_monitor, prod_mosquitto)
}
