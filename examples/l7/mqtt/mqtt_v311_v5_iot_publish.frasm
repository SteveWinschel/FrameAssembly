// Lightweight IoT telemetry messaging using MQTT CONNECT and PUBLISH on TCP
// 1883.
// Wireshark: mqtt

// Edge IoT sensor node.
host iot_sensor { ip 192.168.10.50 }

// Central MQTT message broker.
host mqtt_broker { ip 192.168.10.1 }

// MQTT telemetry publishing flow.
flow mqtt_flow(s, b) {
    s -> b mqtt connect clientid "sensor-01"
    s -> b mqtt publish topic "factory/temp"
}

compile {
    mqtt_flow(iot_sensor, mqtt_broker)
}
