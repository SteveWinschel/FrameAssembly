// Application connection pool executing lightweight SELECT 1 keepalive query
// on MySQL.
// Wireshark: mysql
// Automatic Ethernet MAC addresses and TCP port 3306 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host connection_pool_mgr { ip 192.168.4.88 }

host pooled_mysql_server { ip 192.168.4.1 }

// Pool validation keepalive flow.
flow pool_keepalive_flow(mgr, srv) {
    mgr -> srv mysql sql "SELECT 1"
}

compile {
    pool_keepalive_flow(connection_pool_mgr, pooled_mysql_server)
}
