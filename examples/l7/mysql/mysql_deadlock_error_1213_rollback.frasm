// MySQL InnoDB transaction deadlock detection returning error code 1213
// followed by explicit ROLLBACK.
// Wireshark: mysql

// Order fulfillment worker encountering a lock wait conflict.
host order_worker {
    ip 10.90.1.25
    mac 00:1a:2b:90:01:25
}

// Primary MySQL 8.0 transactional database server.
host mysql_primary {
    ip 10.90.1.10
    mac 00:1a:2b:90:01:10
}

// Attempt an UPDATE that triggers ER_LOCK_DEADLOCK (1213) and issue ROLLBACK.
// MySQL error codes: 1213 (ER_LOCK_DEADLOCK) on TCP 3306.
flow mysql_deadlock_recovery(c, s) {
    c -> s mysql sql "UPDATE inventory SET qty = qty - 1 WHERE sku_id = 4092"
    c <- s mysql err errcode 1213 payload "Deadlock found when trying to get lock; try restarting transaction" wait 2ms
    c -> s mysql sql "ROLLBACK"
    c <- s mysql ok
}

compile {
    mysql_deadlock_recovery(order_worker, mysql_primary)
}
