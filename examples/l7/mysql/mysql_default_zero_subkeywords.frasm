// Minimal MySQL frame with zero optional sub-keywords exercising builder
// default COM_QUERY packet generation. MySQL wire protocol packets default to
// TCP port 3306 with length framing.
// Wireshark: mysql

host mysql_def_client {
    ip 10.90.0.10
    mac 00:1a:2b:90:00:10
}

host mysql_def_server {
    ip 10.90.0.1
    mac 00:1a:2b:90:00:01
}

compile {
    mysql_def_client -> mysql_def_server mysql
    mysql_def_client <- mysql_def_server mysql ok
}
