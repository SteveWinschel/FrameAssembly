// Online transaction processing database query prioritized with DSCP AF31
// traffic marking.
// Wireshark: mysql

// Trading platform order router.
host order_router { ip 10.90.1.18 }

// Low-latency MySQL transaction store.
host low_latency_db { ip 10.90.1.2 }

// DSCP marked payment query flow. Encapsulation and QoS markings: DSCP 26.
flow dscp_payment_query(rtr, db) {
    rtr -> db mysql sql "UPDATE balances SET amount = amount - 50.00 WHERE account_id = 918" dscp 26
}

compile {
    dscp_payment_query(order_router, low_latency_db)
}
