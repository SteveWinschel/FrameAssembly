// PROMPT: ProxySQL router accepting IPv4 application queries and forwarding read queries to an IPv6 MySQL replica.
// TOKENS: host, ip, mac, flow, srcport, dstport, mysql, sql, eof, compile

// INSTRUCTION: Define the IPv4 PHP-FPM application worker.
host php_app_v4 {
    ip 10.90.50.25
    mac 00:1a:2b:90:50:25
}

// INSTRUCTION: Define the IPv4 ProxySQL listener.
host proxysql_v4 {
    ip 10.90.50.2
    mac 00:1a:2b:90:50:02
}

// INSTRUCTION: Define the IPv6 ProxySQL backend interface.
host proxysql_v6 {
    ip 2001:db8:90:50::2
    mac 00:1a:2b:90:56:02
}

// INSTRUCTION: Define the IPv6 MySQL read replica server.
host replica_v6 {
    ip 2001:db8:90:50::10
    mac 00:1a:2b:90:56:10
}

// INSTRUCTION: Send SELECT query from IPv4 app to ProxySQL on port 6033.
flow app_to_proxysql(c, p) {
    c -> p srcport 52100 dstport 6033 mysql sql "SELECT id, title FROM articles WHERE published = 1 LIMIT 10"
    c <- p srcport 6033 dstport 52100 mysql eof
}

// INSTRUCTION: Forward SELECT query from ProxySQL over IPv6 to MySQL replica on port 3306.
flow proxysql_to_replica(p, r) {
    p -> r mysql sql "SELECT id, title FROM articles WHERE published = 1 LIMIT 10"
    p <- r mysql eof
}

// INSTRUCTION: Compile the dual-stack ProxySQL routing flows.
compile {
    app_to_proxysql(php_app_v4, proxysql_v4)
    proxysql_to_replica(proxysql_v6, replica_v6)
}
