// PROMPT: MySQL INSERT violating a UNIQUE index constraint and returning ER_DUP_ENTRY (ERRCODE 1062).
// TOKENS: host, ip, mac, flow, s, mysql, greeting, serverversion, wait, ms, login, user, db, ok, sql, err, errcode, payload, compile

// INSTRUCTION: Define the user registration API service.
host signup_api {
    ip 10.90.10.40
    mac 00:1a:2b:90:10:40
}

// INSTRUCTION: Define the customer identity MySQL server.
host identity_mysql {
    ip 10.90.10.5
    mac 00:1a:2b:90:10:05
}

// INSTRUCTION: Authenticate to the users_db schema and receive ERRCODE 1062 on duplicate email insert.
flow mysql_dup_key(c, s) {
    c <- s mysql greeting serverversion "8.0.36-debug" wait 1ms
    c -> s mysql login user "signup_svc" db "users_db"
    c <- s mysql ok wait 1ms
    c -> s mysql sql "INSERT INTO accounts (email, created_at) VALUES ('alice@example.com', NOW())"
    c <- s mysql err errcode 1062 payload "Duplicate entry 'alice@example.com' for key 'accounts.idx_email_uniq'"
}

// INSTRUCTION: Compile the MySQL duplicate key error scenario.
compile {
    mysql_dup_key(signup_api, identity_mysql)
}
