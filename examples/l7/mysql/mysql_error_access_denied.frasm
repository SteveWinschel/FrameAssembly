// MySQL authentication error packet indicating access denied over IPv6.
// Wireshark: mysql

host client { ip 2001:db8::100 }

host server { ip 2001:db8::1 }

// MySQL error codes: 1045 (ER_ACCESS_DENIED_ERROR) on TCP 3306.
flow mysql_err(c, s) {
    c <- s mysql err errcode 1045 sql "Access denied for user"
}

compile {
    mysql_err(client, server)
}
