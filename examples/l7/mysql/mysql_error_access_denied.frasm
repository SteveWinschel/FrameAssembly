// PROMPT: MySQL authentication error packet indicating access denied over IPv6.
// TOKENS: host, ip, flow, s, mysql, err, errcode, sql, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::100 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow mysql_err(c, s) {
    c <- s mysql err errcode 1045 sql "Access denied for user"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    mysql_err(client, server)
}
