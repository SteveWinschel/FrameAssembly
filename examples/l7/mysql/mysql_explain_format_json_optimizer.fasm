// PROMPT: MySQL query optimizer inspection using EXPLAIN FORMAT=JSON on a multi-table join query.
// TOKENS: host, ip, mac, flow, s, mysql, sql, payload, wait, ms, eof, compile

// INSTRUCTION: Define the DBA performance tuning workstation.
host dba_laptop {
    ip 172.20.90.88
    mac 00:1a:2b:20:90:88
}

// INSTRUCTION: Define the staging MySQL 8.0 server.
host staging_mysql {
    ip 172.20.90.10
    mac 00:1a:2b:20:90:10
}

// INSTRUCTION: Execute EXPLAIN FORMAT=JSON and receive the query execution cost plan before EOF.
flow mysql_explain_json(c, s) {
    c -> s mysql sql "EXPLAIN FORMAT=JSON SELECT o.id, c.name FROM orders o JOIN customers c ON o.cid = c.id"
    c <- s mysql payload "{'query_block':{'select_id':1,'cost_info':{'query_cost':'14.25'}}}" wait 2ms
    c <- s mysql eof
}

// INSTRUCTION: Compile the MySQL EXPLAIN FORMAT=JSON flow.
compile {
    mysql_explain_json(dba_laptop, staging_mysql)
}
