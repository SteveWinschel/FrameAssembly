// MySQL server initial greeting packet announcing version 8.0.36 protocol
// capabilities.
// Wireshark: mysql
// Automatic Ethernet MAC addresses and TCP port 3306 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host connecting_app_client { ip 192.168.1.50 }

host enterprise_mysql { ip 192.168.1.10 }

flow mysql_greeting_flow(app, db) {
    app <- db mysql greeting serverversion "8.0.36"
}

compile {
    mysql_greeting_flow(connecting_app_client, enterprise_mysql)
}
