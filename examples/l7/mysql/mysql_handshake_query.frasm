// PROMPT: MySQL relational database connection handshake, authentication login, and SQL query on TCP 3306.
// TOKENS: host, ip, flow, s, mysql, query, sql, compile

// INSTRUCTION: Define MySQL database client.
host db_client { ip 10.0.2.10 }

// INSTRUCTION: Define MySQL database server.
host mysql_server { ip 10.0.2.1 }

// INSTRUCTION: Define MySQL database query flow.
flow mysql_flow(c, s) {
    c -> s mysql query sql "SELECT 1"
}

// INSTRUCTION: Compile block executing MySQL database query.
compile {
    mysql_flow(db_client, mysql_server)
}
