// MySQL relational database connection handshake, authentication login, and
// SQL query on TCP 3306.
// Wireshark: mysql

host db_client { ip 10.0.2.10 }

host mysql_server { ip 10.0.2.1 }

// MySQL database query flow.
flow mysql_flow(c, s) {
    c -> s mysql query sql "SELECT 1"
}

compile {
    mysql_flow(db_client, mysql_server)
}
