// MySQL server rejecting new client connections during a traffic spike with
// ER_CON_COUNT_ERROR (1040).
// Wireshark: tcp || mysql

// Autoscaled web worker attempting to open a new database connection.
host web_worker_99 {
    ip 10.90.110.99
    mac 00:1a:2b:90:b0:99
}

host overloaded_mysql {
    ip 10.90.110.1
    mac 00:1a:2b:90:b0:01
}

// Establish TCP handshake and immediately receive MySQL ERR 1040 Too many
// connections. MySQL error codes: 1040 (ER_CON_COUNT_ERROR) on TCP 3306.
flow mysql_too_many_conns(c, s) {
    c -> s tcp srcport 55100 dstport 3306 syn seq 100
    c <- s tcp srcport 3306 dstport 55100 syn ack seq 500 acknum 101
    c -> s tcp srcport 55100 dstport 3306 ack seq 101 acknum 501
    c <- s mysql err errcode 1040 payload "Too many connections"
}

compile {
    mysql_too_many_conns(web_worker_99, overloaded_mysql)
}
