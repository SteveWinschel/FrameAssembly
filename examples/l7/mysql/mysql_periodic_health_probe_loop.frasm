// Load balancer health check loop executing periodic ping queries against
// MySQL server.
// Wireshark: mysql

// HAProxy load balancer probe.
host haproxy_probe { ip 172.20.1.10 }

// Backend MySQL cluster member.
host backend_mysql_node { ip 172.20.1.2 }

// Periodic health probe query flow. Repeats 3 times; each wait value pauses
// after sending its packet.
flow health_probe_flow(prb, db) {
    prb -> db mysql sql "/* ping */ SELECT 1" wait 20ms
}

compile {
    health_probe_flow(haproxy_probe, backend_mysql_node) // cycle 1
    health_probe_flow(haproxy_probe, backend_mysql_node) // cycle 2
    health_probe_flow(haproxy_probe, backend_mysql_node) // cycle 3
}
