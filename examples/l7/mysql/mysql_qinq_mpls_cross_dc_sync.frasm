// PROMPT: MySQL cross-datacenter query traffic encapsulated in QinQ (300/900) and MPLS label 4410.
// TOKENS: host, ip, mac, flow, s, mysql, greeting, serverversion, qinq, innervlan, mpls, wait, ms, login, user, db, ok, sql, eof, compile

// INSTRUCTION: Define the remote datacenter reporting service.
host remote_reporter {
    ip 10.90.40.70
    mac 00:1a:2b:90:40:70
}

// INSTRUCTION: Define the core datacenter MySQL cluster VIP.
host core_mysql_vip {
    ip 10.90.40.1
    mac 00:1a:2b:90:40:01
}

// INSTRUCTION: Login and execute an aggregation query over QinQ and MPLS encapsulation.
flow mysql_qinq_mpls(c, s) {
    c <- s mysql greeting serverversion "8.0.36" qinq 300 innervlan 900 mpls 4410 wait 2ms
    c -> s mysql login user "reporter_ro" db "dw_sales" qinq 300 innervlan 900 mpls 4410
    c <- s mysql ok qinq 300 innervlan 900 mpls 4410 wait 2ms
    c -> s mysql sql "SELECT region, SUM(revenue) FROM daily_rollup GROUP BY region" qinq 300 innervlan 900 mpls 4410
    c <- s mysql eof qinq 300 innervlan 900 mpls 4410
}

// INSTRUCTION: Compile the QinQ + MPLS MySQL reporting flow.
compile {
    mysql_qinq_mpls(remote_reporter, core_mysql_vip)
}
