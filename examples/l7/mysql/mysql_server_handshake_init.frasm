// MySQL initial server handshake greeting announcing version capabilities.
// Wireshark: mysql
// Automatic Ethernet MAC addresses and TCP port 3306 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.100 }

host server { ip 192.168.1.1 }

flow mysql_greet(c, s) {
    c <- s mysql greeting serverversion "8.0.35"
}

compile {
    mysql_greet(client, server)
}
