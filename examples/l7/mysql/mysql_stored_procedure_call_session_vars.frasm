// MySQL CALL stored procedure invocation with user session variables
// (@out_total) and SELECT retrieval.
// Wireshark: mysql

// ERP backend worker invoking a stored billing procedure.
host erp_worker {
    ip 10.90.70.33
    mac 00:1a:2b:90:70:33
}

host erp_mysql {
    ip 10.90.70.1
    mac 00:1a:2b:90:70:01
}

// Invoke CALL sp_calculate_invoice and read the populated session variable.
flow mysql_call_proc(c, s) {
    c -> s mysql sql "CALL sp_calculate_invoice(202610, 4401, @out_total)"
    c <- s mysql ok wait 2ms
    c -> s mysql sql "SELECT @out_total AS invoice_total"
    c <- s mysql eof payload "48250.75"
}

compile {
    mysql_call_proc(erp_worker, erp_mysql)
}
