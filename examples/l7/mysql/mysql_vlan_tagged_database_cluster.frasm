// Backend application querying MySQL cluster on 802.1Q tagged database
// storage VLAN.
// Wireshark: mysql

// Application cluster pod node.
host app_pod_node { ip 10.50.4.15 }

// Clustered database service on VLAN 405.
host db_cluster_service { ip 10.50.4.2 }

// Tagged VLAN database query flow. Encapsulation and QoS markings: 802.1Q
// VLAN 405.
flow vlan_db_query(pod, srv) {
    pod -> srv mysql sql "SELECT status FROM cluster_nodes WHERE healthy = 1" vlan 405 pcp 5 dei 0
}

compile {
    vlan_db_query(app_pod_node, db_cluster_service)
}
