// NetFlow v5 export measuring 95th-percentile CDN HTTPS video streaming
// egress traffic for billing.
// Wireshark: cflow || udp.port == 2055 || udp.port == 443

// CDN edge PoP egress router.
host cdn_pop_rtr {
    ip 192.0.2.1
    mac 00:24:dc:02:00:01
}

// CDN billing and settlement NetFlow collector.
host billing_collector {
    ip 192.0.2.250
    mac 00:24:dc:02:00:fa
}

// Export high-volume TCP port 443 video delivery flow records. Reports IP
// protocol 6 (TCP) flow records to UDP 2055.
flow netflow_cdn_billing(pop, bill) {
    pop -> bill netflow srcip 192.0.2.100 dstip 198.51.100.42 srcport 443 dstport 59120 proto 6 packets 210000 octets 304500000
}

compile {
    netflow_cdn_billing(cdn_pop_rtr, billing_collector)
}
