// NetFlow record summarizing DNS UDP port 53 query metrics and octet
// consumption.
// Wireshark: cflow || udp.port == 2055 || udp.port == 53

// Internal DNS resolver router.
host dns_router_node { ip 10.128.0.1 }

// Network analytics flow receiver.
host analytics_receiver { ip 10.128.0.254 }

// DNS volume NetFlow report flow. Reports IP protocol 17 (UDP) flow records
// to UDP 2055.
flow dns_volume_flow(rtr, rec) {
    rtr -> rec netflow srcip 10.128.1.50 dstip 8.8.8.8 srcport 53 dstport 60124 proto 17 packets 35 octets 2800
}

compile {
    dns_volume_flow(dns_router_node, analytics_receiver)
}
