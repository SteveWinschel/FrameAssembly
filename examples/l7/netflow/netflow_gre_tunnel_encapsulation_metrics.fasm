// PROMPT: NetFlow v5 export measuring IP protocol 47 GRE tunnel bandwidth across WAN branch routers.
// TOKENS: HOST, IP, MAC, FLOW, NETFLOW, SRCIP, DSTIP, SRCPORT, DSTPORT, PROTO, PACKETS, OCTETS, DSCP, COMPILE

// INSTRUCTION: Define hub WAN aggregation router terminating branch GRE tunnels.
HOST wan_hub_rtr {
    IP 10.200.0.1
    MAC 00:0c:29:44:55:01
}

// INSTRUCTION: Define WAN performance telemetry collector.
HOST wan_collector {
    IP 10.200.0.50
    MAC 00:0c:29:44:55:32
}

// INSTRUCTION: Export IP protocol 47 GRE tunnel packet and byte volume records.
FLOW netflow_gre_metrics(hub, col) {
    hub -> col NETFLOW SRCIP 172.30.1.1 DSTIP 172.30.2.1 SRCPORT 0 DSTPORT 0 PROTO 47 PACKETS 8500 OCTETS 11900000 DSCP 16
}

// INSTRUCTION: Compile the GRE tunnel encapsulation NetFlow accounting scenario.
COMPILE {
    netflow_gre_metrics(wan_hub_rtr, wan_collector)
}
