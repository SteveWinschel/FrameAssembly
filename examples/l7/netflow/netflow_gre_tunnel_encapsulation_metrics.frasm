// NetFlow v5 export measuring IP protocol 47 GRE tunnel bandwidth across WAN
// branch routers.
// Wireshark: cflow || udp.port == 2055

// Hub WAN aggregation router terminating branch GRE tunnels.
host wan_hub_rtr {
    ip 10.200.0.1
    mac 00:0c:29:44:55:01
}

// WAN performance telemetry collector.
host wan_collector {
    ip 10.200.0.50
    mac 00:0c:29:44:55:32
}

// Export IP protocol 47 GRE tunnel packet and byte volume records.
// Encapsulation and QoS markings: DSCP 16. Reports IP protocol 47 (GRE) flow
// records to UDP 2055.
flow netflow_gre_metrics(hub, col) {
    hub -> col netflow srcip 172.30.1.1 dstip 172.30.2.1 srcport 0 dstport 0 proto 47 packets 8500 octets 11900000 dscp 16
}

compile {
    netflow_gre_metrics(wan_hub_rtr, wan_collector)
}
