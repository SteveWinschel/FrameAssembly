// NetFlow accounting record reporting sustained high packet rate across
// datacenter spine.
// Wireshark: cflow || udp.port == 2055 || udp.port == 9000

// Datacenter spine router exporter.
host dc_spine_exporter { ip 10.255.0.1 }

// Network telemetry storage node.
host telemetry_storage { ip 10.255.0.100 }

// High packet volume audit flow. Reports IP protocol 6 (TCP) flow records to
// UDP 2055.
flow spine_audit_flow(rtr, stor) {
    rtr -> stor netflow srcip 10.1.1.100 dstip 10.2.2.200 srcport 9000 dstport 9000 proto 6 packets 250000 octets 350000000
}

compile {
    spine_audit_flow(dc_spine_exporter, telemetry_storage)
}
