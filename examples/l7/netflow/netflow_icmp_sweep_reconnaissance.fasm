// PROMPT: NetFlow v5 flow export documenting an ICMP protocol 1 network reconnaissance sweep across subnets.
// TOKENS: host, ip, mac, flow, netflow, srcip, dstip, srcport, dstport, proto, packets, octets, compile

// INSTRUCTION: Define internal distribution switch monitoring east-west reconnaissance traffic.
host dist_switch {
    ip 172.16.10.1
    mac 00:1e:be:10:01:01
}

// INSTRUCTION: Define network detection and response (NDR) NetFlow appliance.
host ndr_appliance {
    ip 172.16.10.100
    mac 00:1e:be:10:01:64
}

// INSTRUCTION: Export ICMP protocol 1 sweep flow records with zeroed transport ports.
flow netflow_icmp_sweep(sw, ndr) {
    sw -> ndr netflow srcip 172.16.40.99 dstip 172.16.50.10 srcport 0 dstport 0 proto 1 packets 10 octets 840
    sw -> ndr netflow srcip 172.16.40.99 dstip 172.16.50.11 srcport 0 dstport 0 proto 1 packets 10 octets 840
}

// INSTRUCTION: Compile the ICMP reconnaissance sweep NetFlow telemetry scenario.
compile {
    netflow_icmp_sweep(dist_switch, ndr_appliance)
}
