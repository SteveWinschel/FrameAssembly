// NetFlow v5 flow export documenting an ICMP protocol 1 network
// reconnaissance sweep across subnets.
// Wireshark: cflow || udp.port == 2055

// Internal distribution switch monitoring east-west reconnaissance traffic.
host dist_switch {
    ip 172.16.10.1
    mac 00:1e:be:10:01:01
}

// Network detection and response (NDR) NetFlow appliance.
host ndr_appliance {
    ip 172.16.10.100
    mac 00:1e:be:10:01:64
}

// Export ICMP protocol 1 sweep flow records with zeroed transport ports.
// Reports IP protocol 1 (ICMP) flow records to UDP 2055.
flow netflow_icmp_sweep(sw, ndr) {
    sw -> ndr netflow srcip 172.16.40.99 dstip 172.16.50.10 srcport 0 dstport 0 proto 1 packets 10 octets 840
    sw -> ndr netflow srcip 172.16.40.99 dstip 172.16.50.11 srcport 0 dstport 0 proto 1 packets 10 octets 840
}

compile {
    netflow_icmp_sweep(dist_switch, ndr_appliance)
}
