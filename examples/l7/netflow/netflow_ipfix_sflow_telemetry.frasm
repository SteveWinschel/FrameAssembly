// Network flow export and telemetry combining Cisco NetFlow, IPFIX, and InMon
// sFlow v5.
// Wireshark: cflow || udp.port == 2055

// Network flow exporter router.
host flow_exporter { ip 10.0.50.1 }

// Network monitoring collector.
host flow_collector { ip 10.0.50.2 }

// Network telemetry export flow.
flow telemetry_export_flow(e, c) {
    e -> c netflow
    e -> c ipfix
    e -> c sflow agentip 10.0.50.1
}

compile {
    telemetry_export_flow(flow_exporter, flow_collector)
}
