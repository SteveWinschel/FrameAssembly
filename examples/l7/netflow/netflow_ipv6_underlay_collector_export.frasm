// Cisco NetFlow telemetry exported over IPv6 transport to centralized
// monitoring station.
// Wireshark: cflow || udp.port == 2055

// IPv6 enterprise border router.
host v6_border_router { ip 2001:db8:f100::1 }

// IPv6 NetFlow monitoring station.
host v6_monitoring_station { ip 2001:db8:f100::254 }

// IPv6 NetFlow telemetry flow. Reports IP protocol 6 (TCP) flow records to
// UDP 2055.
flow v6_netflow_export(rtr, mon) {
    rtr -> mon netflow srcip 10.100.1.1 dstip 10.200.1.1 proto 6 packets 620 octets 780000
}

compile {
    v6_netflow_export(v6_border_router, v6_monitoring_station)
}
