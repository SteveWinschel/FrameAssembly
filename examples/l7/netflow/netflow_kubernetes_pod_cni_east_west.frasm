// PROMPT: NetFlow v5 export from a Kubernetes node router tracking CNI pod-to-pod east-west microservice traffic.
// TOKENS: host, ip, mac, flow, netflow, srcip, dstip, srcport, dstport, proto, packets, octets, compile

// INSTRUCTION: Define Kubernetes worker node routing agent exporting CNI flow records.
host k8s_node_agent {
    ip 10.244.1.1
    mac 02:42:0a:f4:01:01
}

// INSTRUCTION: Define cluster observability NetFlow collector pod.
host k8s_flow_collector {
    ip 10.244.0.100
    mac 02:42:0a:f4:00:64
}

// INSTRUCTION: Export pod-to-pod gRPC port 50051 and Redis port 6379 flow summaries.
flow netflow_k8s_cni(node, col) {
    node -> col netflow srcip 10.244.1.15 dstip 10.244.2.28 srcport 41820 dstport 50051 proto 6 packets 1450 octets 928000
    node -> col netflow srcip 10.244.2.28 dstip 10.244.3.9 srcport 53900 dstport 6379 proto 6 packets 820 octets 196800
}

// INSTRUCTION: Compile the Kubernetes CNI east-west NetFlow telemetry scenario.
compile {
    netflow_k8s_cni(k8s_node_agent, k8s_flow_collector)
}
