// NetFlow telemetry exported across MPLS carrier backbone with label tagging.
// Wireshark: cflow || udp.port == 2055

// Carrier core router exporter.
host core_transit_rtr { ip 192.168.220.1 }

// Carrier operations flow collector.
host carrier_flow_col { ip 192.168.220.254 }

// MPLS tagged NetFlow export flow. Encapsulation and QoS markings: MPLS label
// 1024. Reports IP protocol 6 (TCP) flow records to UDP 2055.
flow mpls_netflow_export(rtr, col) {
    rtr -> col netflow srcip 10.40.1.10 dstip 10.50.2.20 proto 6 packets 2400 octets 3120000 mpls 1024
}

compile {
    mpls_netflow_export(core_transit_rtr, carrier_flow_col)
}
