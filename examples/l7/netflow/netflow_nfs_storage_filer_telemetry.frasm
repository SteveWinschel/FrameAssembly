// NetFlow v5 flow export monitoring NFS TCP port 2049 NAS storage filer
// read/write throughput.
// Wireshark: cflow || udp.port == 2055 || udp.port == 2049

// Storage area network aggregation router.
host san_router {
    ip 10.77.0.1
    mac 00:25:90:77:00:01
}

// Storage capacity NetFlow collector.
host san_collector {
    ip 10.77.0.200
    mac 00:25:90:77:00:c8
}

// Export bidirectional NFS port 2049 flow summaries over VLAN 77.
// Encapsulation and QoS markings: 802.1Q VLAN 77. Reports IP protocol 6 (TCP)
// flow records to UDP 2055.
flow netflow_nfs_storage(rtr, col) {
    rtr -> col netflow srcip 10.77.5.100 dstip 10.77.5.10 srcport 51022 dstport 2049 proto 6 packets 18400 octets 26864000 vlan 77 pcp 4
    rtr -> col netflow srcip 10.77.5.10 dstip 10.77.5.100 srcport 2049 dstport 51022 proto 6 packets 42000 octets 61320000 vlan 77 pcp 4
}

compile {
    netflow_nfs_storage(san_router, san_collector)
}
