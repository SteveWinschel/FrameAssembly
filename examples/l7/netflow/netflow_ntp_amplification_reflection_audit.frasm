// PROMPT: NetFlow v5 telemetry capturing UDP port 123 NTP monlist amplification reflection traffic.
// TOKENS: host, ip, mac, flow, netflow, srcip, dstip, srcport, dstport, proto, packets, octets, compile

// INSTRUCTION: Define ISP edge router observing UDP port 123 reflection traffic.
host isp_edge_rtr {
    ip 172.22.0.1
    mac 00:19:e8:22:00:01
}

// INSTRUCTION: Define ISP threat intelligence NetFlow ingestion node.
host threat_ingest {
    ip 172.22.0.99
    mac 00:19:e8:22:00:63
}

// INSTRUCTION: Export high-octet UDP port 123 NTP reflection flow record.
flow netflow_ntp_reflection(edge, ing) {
    edge -> ing netflow srcip 198.51.100.123 dstip 203.0.113.77 srcport 123 dstport 40812 proto 17 packets 9000 octets 4212000
}

// INSTRUCTION: Compile the NTP amplification reflection NetFlow audit scenario.
compile {
    netflow_ntp_reflection(isp_edge_rtr, threat_ingest)
}
