// NetFlow v5 export auditing IP protocol 89 OSPF control-plane packet volume
// between core routers.
// Wireshark: cflow || udp.port == 2055

// Backbone OSPF area 0 router.
host ospf_backbone_rtr {
    ip 10.0.255.1
    mac 00:11:22:ff:00:01
}

// Network operations control-plane NetFlow collector.
host noc_collector {
    ip 10.0.255.100
    mac 00:11:22:ff:00:64
}

// Export NetFlow record for IP protocol 89 OSPF hello and LSA exchange.
// Encapsulation and QoS markings: DSCP 48. Reports IP protocol 89 (89) flow
// records to UDP 2055.
flow netflow_ospf_audit(rtr, noc) {
    rtr -> noc netflow srcip 10.0.12.1 dstip 10.0.12.2 srcport 0 dstport 0 proto 89 packets 360 octets 46080 dscp 48
}

compile {
    netflow_ospf_audit(ospf_backbone_rtr, noc_collector)
}
