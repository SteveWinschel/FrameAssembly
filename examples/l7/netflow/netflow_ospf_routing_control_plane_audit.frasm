// PROMPT: NetFlow v5 export auditing IP protocol 89 OSPF control-plane packet volume between core routers.
// TOKENS: host, ip, mac, flow, netflow, srcip, dstip, srcport, dstport, proto, packets, octets, dscp, compile

// INSTRUCTION: Define backbone OSPF area 0 router.
host ospf_backbone_rtr {
    ip 10.0.255.1
    mac 00:11:22:ff:00:01
}

// INSTRUCTION: Define network operations control-plane NetFlow collector.
host noc_collector {
    ip 10.0.255.100
    mac 00:11:22:ff:00:64
}

// INSTRUCTION: Export NetFlow record for IP protocol 89 OSPF hello and LSA exchange.
flow netflow_ospf_audit(rtr, noc) {
    rtr -> noc netflow srcip 10.0.12.1 dstip 10.0.12.2 srcport 0 dstport 0 proto 89 packets 360 octets 46080 dscp 48
}

// INSTRUCTION: Compile the OSPF control-plane NetFlow audit scenario.
compile {
    netflow_ospf_audit(ospf_backbone_rtr, noc_collector)
}
