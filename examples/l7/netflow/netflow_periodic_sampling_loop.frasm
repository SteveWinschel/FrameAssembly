// Periodic NetFlow export timer loop streaming accounting records to
// collector.
// Wireshark: cflow || udp.port == 2055 || udp.port == 80

// Edge sampling router.
host sampling_router { ip 192.168.60.1 }

host telemetry_listener { ip 192.168.60.200 }

// Periodic accounting record flow. Reports IP protocol 6 (TCP) flow records
// to UDP 2055. Repeats 3 times; each wait value pauses after sending its
// packet.
flow periodic_accounting_flow(rtr, col) {
    rtr -> col netflow srcip 172.16.8.12 dstip 198.51.100.44 srcport 80 dstport 41200 proto 6 packets 20 octets 28000 wait 15ms
}

compile {
    periodic_accounting_flow(sampling_router, telemetry_listener) // cycle 1
    periodic_accounting_flow(sampling_router, telemetry_listener) // cycle 2
    periodic_accounting_flow(sampling_router, telemetry_listener) // cycle 3
}
