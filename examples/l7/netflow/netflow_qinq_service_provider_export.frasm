// Metro Ethernet QinQ double-tagged underlay transporting NetFlow accounting
// packets.
// Wireshark: cflow || udp.port == 2055

// Service provider aggregation switch.
host metro_agg_switch { ip 100.64.50.1 }

// Carrier billing flow collector.
host billing_collector { ip 100.64.50.250 }

// QinQ encapsulated NetFlow flow. Encapsulation and QoS markings: 802.1Q VLAN
// 200. Reports IP protocol 6 (TCP) flow records to UDP 2055.
flow qinq_netflow_export(sw, col) {
    sw -> col netflow srcip 100.64.10.1 dstip 100.64.20.2 proto 6 packets 750 octets 950000 vlan 200
}

compile {
    qinq_netflow_export(metro_agg_switch, billing_collector)
}
