// NetFlow v5 accounting export tracking outbound SMTP TCP port 25 and 587
// mail relay traffic.
// Wireshark: cflow || udp.port == 2055 || udp.port == 25

// DMZ firewall router monitoring outbound mail relay servers.
host dmz_fw_rtr {
    ip 10.33.1.1
    mac 00:0e:0c:33:01:01
}

// DMZ compliance flow collector.
host dmz_collector {
    ip 10.33.1.50
    mac 00:0e:0c:33:01:32
}

// Export SMTP port 25 and submission port 587 flow records. Reports IP
// protocol 6 (TCP) flow records to UDP 2055.
flow netflow_smtp_relay(fw, col) {
    fw -> col netflow srcip 10.33.10.25 dstip 198.51.100.200 srcport 43210 dstport 25 proto 6 packets 420 octets 386400
    fw -> col netflow srcip 10.33.10.25 dstip 198.51.100.201 srcport 43211 dstport 587 proto 6 packets 190 octets 152000
}

compile {
    netflow_smtp_relay(dmz_fw_rtr, dmz_collector)
}
