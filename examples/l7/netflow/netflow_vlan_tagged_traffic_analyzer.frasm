// NetFlow telemetry collection over 802.1Q tagged network management VLAN.
// Wireshark: cflow || udp.port == 2055

// Campus distribution switch.
host campus_dist_sw { ip 10.15.0.1 }

// Management VLAN collector on VLAN 105.
host mgmt_flow_analyzer { ip 10.15.0.105 }

// Tagged VLAN NetFlow export flow. Encapsulation and QoS markings: 802.1Q
// VLAN 105. Reports IP protocol 17 (UDP) flow records to UDP 2055.
flow vlan_netflow_flow(sw, ana) {
    sw -> ana netflow srcip 10.10.5.15 dstip 10.20.5.25 proto 17 packets 42 octets 5376 vlan 105 pcp 4 dei 0
}

compile {
    vlan_netflow_flow(campus_dist_sw, mgmt_flow_analyzer)
}
