// NFSv4 compound RPC procedure inspecting file attributes over IPv6.
// Wireshark: nfs
// Automatic Ethernet MAC addresses and TCP port 2049 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 2001:db8::80 }

host server { ip 2001:db8::1 }

flow nfs_getattr(c, s) {
    c -> s nfs vers 4 proc "getattr" path "/exports/storage"
}

compile {
    nfs_getattr(client, server)
}
