// PROMPT: Dual-stack IPv4 and IPv6 HPC compute nodes reading and writing simulation checkpoints on an NFSv4 scratch volume.
// TOKENS: host, ip, mac, flow, s, nfs, vers, proc, tag, path, payload, compile

// INSTRUCTION: Define the IPv4 HPC compute node.
host hpc_node_v4 {
    ip 10.70.50.101
    mac 00:1a:2b:70:50:01
}

// INSTRUCTION: Define the IPv4 parallel NFSv4 gateway.
host nfs_gw_v4 {
    ip 10.70.50.1
    mac 00:1a:2b:70:50:fe
}

// INSTRUCTION: Define the IPv6 HPC compute node.
host hpc_node_v6 {
    ip 2001:db8:70:50::101
    mac 00:1a:2b:70:56:01
}

// INSTRUCTION: Define the IPv6 parallel NFSv4 gateway.
host nfs_gw_v6 {
    ip 2001:db8:70:50::1
    mac 00:1a:2b:70:56:fe
}

// INSTRUCTION: Write simulation checkpoint over IPv4.
flow nfs_hpc_v4(c, s) {
    c -> s nfs vers 4 proc "write" tag "ckpt_rank0" path "/scratch/cfd_run42/step_1000.h5" payload "HDF5_HEADER_RANK0"
    c <- s nfs vers 4 proc "write" tag "ckpt_rank0"
}

// INSTRUCTION: Read mesh geometry over IPv6.
flow nfs_hpc_v6(c, s) {
    c -> s nfs vers 4 proc "read" tag "mesh_rank1" path "/scratch/cfd_run42/wing_mesh.cgns"
    c <- s nfs vers 4 proc "read" tag "mesh_rank1" payload "CGNS_MESH_VERTICES"
}

// INSTRUCTION: Compile both IPv4 and IPv6 HPC NFSv4 flows.
compile {
    nfs_hpc_v4(hpc_node_v4, nfs_gw_v4)
    nfs_hpc_v6(hpc_node_v6, nfs_gw_v6)
}
