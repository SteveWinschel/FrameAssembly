// Dual-stack IPv4 and IPv6 HPC compute nodes reading and writing simulation
// checkpoints on an NFSv4 scratch volume.
// Wireshark: nfs

// IPv4 HPC compute node.
host hpc_node_v4 {
    ip 10.70.50.101
    mac 00:1a:2b:70:50:01
}

// IPv4 parallel NFSv4 gateway.
host nfs_gw_v4 {
    ip 10.70.50.1
    mac 00:1a:2b:70:50:fe
}

// IPv6 HPC compute node.
host hpc_node_v6 {
    ip 2001:db8:70:50::101
    mac 00:1a:2b:70:56:01
}

// IPv6 parallel NFSv4 gateway.
host nfs_gw_v6 {
    ip 2001:db8:70:50::1
    mac 00:1a:2b:70:56:fe
}

// Write simulation checkpoint over IPv4. Runs the same flow definition over
// both IPv4 and IPv6 host pairs.
flow nfs_hpc_v4(c, s) {
    c -> s nfs vers 4 proc "write" tag "ckpt_rank0" path "/scratch/cfd_run42/step_1000.h5" payload "HDF5_HEADER_RANK0"
    c <- s nfs vers 4 proc "write" tag "ckpt_rank0"
}

// Read mesh geometry over IPv6.
flow nfs_hpc_v6(c, s) {
    c -> s nfs vers 4 proc "read" tag "mesh_rank1" path "/scratch/cfd_run42/wing_mesh.cgns"
    c <- s nfs vers 4 proc "read" tag "mesh_rank1" payload "CGNS_MESH_VERTICES"
}

compile {
    nfs_hpc_v4(hpc_node_v4, nfs_gw_v4)
    nfs_hpc_v6(hpc_node_v6, nfs_gw_v6)
}
