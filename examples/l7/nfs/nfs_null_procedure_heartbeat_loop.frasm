// PROMPT: NFS NULL procedure RPC ping loop verifying remote storage cluster server availability.
// TOKENS: host, ip, flow, nfs, vers, proc, wait, ms, compile

// INSTRUCTION: Define storage health monitor.
host storage_monitor { ip 192.168.50.25 }

// INSTRUCTION: Define enterprise NFS cluster head.
host nfs_cluster_head { ip 192.168.50.1 }

// INSTRUCTION: Define periodic NULL RPC ping flow.
flow nfs_null_ping_flow(mon, srv) {
    mon -> srv nfs vers 4 proc "null" wait 20ms
}

// INSTRUCTION: Compile NFS heartbeat loop scenario.
compile {
    nfs_null_ping_flow(storage_monitor, nfs_cluster_head) // cycle 1
    nfs_null_ping_flow(storage_monitor, nfs_cluster_head) // cycle 2
    nfs_null_ping_flow(storage_monitor, nfs_cluster_head) // cycle 3
}
