// NFS RPC Procedure 0 (NULL) checking remote file server liveness.
// Wireshark: nfs
// Automatic Ethernet MAC addresses and TCP port 2049 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host client { ip 192.168.1.80 }

host server { ip 192.168.1.1 }

flow nfs_null(c, s) {
    c -> s nfs vers 4 proc "null"
}

compile {
    nfs_null(client, server)
}
