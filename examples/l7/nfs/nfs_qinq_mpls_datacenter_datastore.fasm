// PROMPT: VMware ESXi NFSv4 datastore read/write traffic encapsulated in QinQ (400/2049) and MPLS label 5020.
// TOKENS: host, ip, mac, flow, s, nfs, vers, proc, tag, path, qinq, innervlan, mpls, payload, wait, ms, compile

// INSTRUCTION: Define the ESXi hypervisor host accessing its remote NFS datastore.
host esxi_host {
    ip 172.22.40.11
    mac 00:1a:2b:22:40:11
}

// INSTRUCTION: Define the metro-cluster NFSv4 datastore target.
host metro_datastore {
    ip 172.22.40.100
    mac 00:1a:2b:22:40:99
}

// INSTRUCTION: Issue NFSv4 READ and WRITE procedures across QinQ and MPLS transport.
flow nfs_esxi_datastore(c, s) {
    c -> s nfs vers 4 proc "read" tag "vmdk_read" path "/vmfs/prod_vm01/prod_vm01-flat.vmdk" qinq 400 innervlan 2049 mpls 5020
    c <- s nfs vers 4 proc "read" tag "vmdk_read" qinq 400 innervlan 2049 mpls 5020 payload "VMDK_BOOT_SECTOR_BYTES" wait 2ms
    c -> s nfs vers 4 proc "write" tag "vmdk_write" path "/vmfs/prod_vm01/prod_vm01-flat.vmdk" qinq 400 innervlan 2049 mpls 5020 payload "VMDK_DIRTY_PAGE_FLUSH"
    c <- s nfs vers 4 proc "write" tag "vmdk_write" qinq 400 innervlan 2049 mpls 5020
}

// INSTRUCTION: Compile the QinQ + MPLS ESXi NFSv4 datastore flow.
compile {
    nfs_esxi_datastore(esxi_host, metro_datastore)
}
