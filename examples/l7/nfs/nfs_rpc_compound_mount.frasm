// Network File System ONC RPC procedure calls for NULL and LOOKUP operations
// on TCP 2049.
// Wireshark: nfs

host nfs_client { ip 10.0.10.1 }

host nfs_server { ip 10.0.10.2 }

// NFS RPC lookup and directory navigation flow.
flow nfs_flow(c, s) {
    c -> s nfs proc lookup path "/exports/data"
}

compile {
    nfs_flow(nfs_client, nfs_server)
}
