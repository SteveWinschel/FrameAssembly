// Legacy NFSv2 root filesystem LOOKUP and READ for a diskless embedded
// industrial controller.
// Wireshark: nfs

// Diskless embedded ARM controller booting over NFSroot.
host embedded_board {
    ip 192.168.72.90
    mac 00:1a:2b:72:00:90
}

// Lab embedded boot server running NFSv2.
host boot_srv {
    ip 192.168.72.1
    mac 00:1a:2b:72:00:01
}

// Perform NFSv2 LOOKUP and READ for /sbin/init during kernel root mount.
flow nfs2_nfsroot(c, s) {
    c -> s nfs vers 2 proc "lookup" path "/tftpboot/rootfs/sbin/init"
    c <- s nfs vers 2 proc "lookup" wait 2ms
    c -> s nfs vers 2 proc "read" path "/tftpboot/rootfs/sbin/init"
    c <- s nfs vers 2 proc "read" payload "ELF_32BIT_LSB_ARM_INIT"
}

compile {
    nfs2_nfsroot(embedded_board, boot_srv)
}
