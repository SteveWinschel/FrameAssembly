// NFSv4 COMPOUND procedure reading configuration data with descriptive RPC
// compound tags.
// Wireshark: nfs

// Kubernetes worker node mounting an NFSv4 persistent volume.
host k8s_worker {
    ip 10.70.10.22
    mac 00:1a:2b:70:10:22
}

// Enterprise NetApp NFSv4 storage virtual machine.
host netapp_svm {
    ip 10.70.10.5
    mac 00:1a:2b:70:10:05
}

// NFSv4 COMPOUND LOOKUP, GETATTR, and READ operations with explicit tags.
flow nfs4_read_config(c, s) {
    c -> s nfs vers 4 proc "compound" tag "lookup_cfg" path "/pv/app01/config.yaml"
    c <- s nfs vers 4 proc "compound" tag "lookup_cfg" wait 1ms
    c -> s nfs vers 4 proc "read" tag "read_cfg" path "/pv/app01/config.yaml"
    c <- s nfs vers 4 proc "read" tag "read_cfg" payload "replicas: 3
image: app:1.4.2
"
}

compile {
    nfs4_read_config(k8s_worker, netapp_svm)
}
