// Minimal NFS frame with zero optional sub-keywords exercising builder
// defaults (NFSv4 LOOKUP on /). NFSv4 RPC calls default to TCP port 2049 with
// ONC RPC XDR framing.
// Wireshark: nfs

host nfs_def_client {
    ip 10.70.0.10
    mac 00:1a:2b:70:00:10
}

host nfs_def_server {
    ip 10.70.0.1
    mac 00:1a:2b:70:00:01
}

compile {
    nfs_def_client -> nfs_def_server nfs
    nfs_def_client <- nfs_def_server nfs vers 4 proc "lookup"
}
