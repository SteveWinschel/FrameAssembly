// PROMPT: Electronic Design Automation (EDA) RTL simulator resolving deep Verilog library paths via NFSv4 LOOKUP.
// TOKENS: host, ip, mac, flow, s, nfs, vers, proc, tag, path, wait, ms, payload, compile

// INSTRUCTION: Define the EDA compute farm runner executing Verilog elaboration.
host eda_runner {
    ip 10.70.140.77
    mac 00:1a:2b:70:e0:77
}

// INSTRUCTION: Define the high-IOPS EDA filer hosting standard cell libraries.
host pdk_filer {
    ip 10.70.140.1
    mac 00:1a:2b:70:e0:01
}

// INSTRUCTION: Resolve PDK library paths and read standard cell timing models.
flow nfs_eda_pdk(c, s) {
    c -> s nfs vers 4 proc "lookup" tag "pdk_stdcell" path "/proj/asic_v5/pdk/3nm/stdcell/tt_0p75v_85c.lib"
    c <- s nfs vers 4 proc "lookup" tag "pdk_stdcell" wait 1ms
    c -> s nfs vers 4 proc "read" tag "read_liberty" path "/proj/asic_v5/pdk/3nm/stdcell/tt_0p75v_85c.lib"
    c <- s nfs vers 4 proc "read" tag "read_liberty" payload "library (stdcell_3nm_tt) { delay_model : table_lookup; }"
}

// INSTRUCTION: Compile the EDA PDK library lookup and read flow.
compile {
    nfs_eda_pdk(eda_runner, pdk_filer)
}
