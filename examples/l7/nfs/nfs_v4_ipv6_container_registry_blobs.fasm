// PROMPT: Container registry backend storing OCI image layer blobs on an IPv6 NFSv4 storage volume.
// TOKENS: host, ip, mac, flow, s, nfs, vers, proc, tag, path, payload, wait, ms, compile

// INSTRUCTION: Define the OCI container registry service over IPv6.
host oci_registry {
    ip 2001:db8:70:110::50
    mac 00:1a:2b:70:b0:50
}

// INSTRUCTION: Define the IPv6 enterprise NAS backend.
host ipv6_nas {
    ip 2001:db8:70:110::1
    mac 00:1a:2b:70:b0:01
}

// INSTRUCTION: Write a compressed OCI layer digest blob and verify its attributes over IPv6.
flow nfs6_oci_blob(c, s) {
    c -> s nfs vers 4 proc "write" tag "put_blob_sha256" path "/registry/blobs/sha256/4f/4f8a9b1c2d" payload "GZIP_OCI_LAYER_TARBALL_STREAM"
    c <- s nfs vers 4 proc "write" tag "put_blob_sha256" wait 2ms
    c -> s nfs vers 4 proc "getattr" tag "stat_blob_sha256" path "/registry/blobs/sha256/4f/4f8a9b1c2d"
    c <- s nfs vers 4 proc "getattr" tag "stat_blob_sha256"
}

// INSTRUCTION: Compile the IPv6 OCI registry NFSv4 blob write flow.
compile {
    nfs6_oci_blob(oci_registry, ipv6_nas)
}
