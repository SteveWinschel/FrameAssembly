// PROMPT: Two GPU training workers concurrently reading sharded TFRecord files from a central NFSv4 storage cluster.
// TOKENS: host, ip, mac, flow, s, nfs, vers, proc, tag, path, payload, compile

// INSTRUCTION: Define the first GPU training node.
host gpu_worker_1 {
    ip 10.70.80.11
    mac 00:1a:2b:70:80:11
}

// INSTRUCTION: Define the second GPU training node.
host gpu_worker_2 {
    ip 10.70.80.12
    mac 00:1a:2b:70:80:12
}

// INSTRUCTION: Define the all-NVMe NFSv4 dataset server.
host nvme_nfs {
    ip 10.70.80.1
    mac 00:1a:2b:70:80:01
}

// INSTRUCTION: Read training shard 0001 from GPU worker 1.
flow read_shard_1(w, s) {
    w -> s nfs vers 4 proc "read" tag "shard_0001" path "/datasets/imagenet/train-00001-of-01024.tfrecord"
    w <- s nfs vers 4 proc "read" tag "shard_0001" payload "TFRECORD_BATCH_TENSOR_01"
}

// INSTRUCTION: Read training shard 0002 from GPU worker 2.
flow read_shard_2(w, s) {
    w -> s nfs vers 4 proc "read" tag "shard_0002" path "/datasets/imagenet/train-00002-of-01024.tfrecord"
    w <- s nfs vers 4 proc "read" tag "shard_0002" payload "TFRECORD_BATCH_TENSOR_02"
}

// INSTRUCTION: Compile both GPU worker NFSv4 dataset read flows.
compile {
    read_shard_1(gpu_worker_1, nvme_nfs)
    read_shard_2(gpu_worker_2, nvme_nfs)
}
