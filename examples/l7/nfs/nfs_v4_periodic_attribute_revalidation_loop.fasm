// PROMPT: NFSv4 client attribute cache revalidation polling loop checking file mtime every 5ms for 4 iterations.
// TOKENS: HOST, IP, MAC, FLOW, NFS, VERS, PROC, TAG, PATH, WAIT, COMPILE, LOOP

// INSTRUCTION: Define the application server caching shared configuration files.
HOST app_cache_client {
    IP 10.70.120.33
    MAC 00:1a:2b:70:c0:33
}

// INSTRUCTION: Define the configuration NFSv4 server.
HOST cfg_nfs_server {
    IP 10.70.120.1
    MAC 00:1a:2b:70:c0:01
}

// INSTRUCTION: Poll GETATTR on the shared feature flags JSON file to detect modifications.
FLOW nfs_attr_revalidate(c, s) {
    c -> s NFS VERS 4 PROC "GETATTR" TAG "acregmin_poll" PATH "/etc/shared/feature_flags.json"
    c <- s NFS VERS 4 PROC "GETATTR" TAG "acregmin_poll" WAIT 5ms
}

// INSTRUCTION: Run the attribute cache revalidation loop for 4 iterations.
COMPILE {
    LOOP 4 {
        nfs_attr_revalidate(app_cache_client, cfg_nfs_server)
    }
}
