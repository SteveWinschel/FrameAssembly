// PROMPT: NFSv4 final attribute check followed by graceful TCP FIN/ACK connection teardown during umount.
// TOKENS: HOST, IP, MAC, FLOW, SRCPORT, DSTPORT, NFS, VERS, PROC, TAG, PATH, WAIT, TCP, FIN, ACK, SEQ, ACKNUM, COMPILE

// INSTRUCTION: Define the batch compute host unmounting its temporary NFS workspace.
HOST batch_host {
    IP 10.70.90.40
    MAC 00:1a:2b:70:90:40
}

// INSTRUCTION: Define the workspace NFSv4 server.
HOST workspace_nfs {
    IP 10.70.90.10
    MAC 00:1a:2b:70:90:10
}

// INSTRUCTION: Flush final GETATTR check and close TCP port 2049 with FIN/ACK handshake.
FLOW nfs_unmount_fin(c, s) {
    c -> s SRCPORT 784 DSTPORT 2049 NFS VERS 4 PROC "GETATTR" TAG "umount_sync" PATH "/mnt/job_8812"
    c <- s SRCPORT 2049 DSTPORT 784 NFS VERS 4 PROC "GETATTR" TAG "umount_sync" WAIT 1ms
    c -> s TCP SRCPORT 784 DSTPORT 2049 FIN ACK SEQ 5000 ACKNUM 9000
    c <- s TCP SRCPORT 2049 DSTPORT 784 FIN ACK SEQ 9000 ACKNUM 5001
    c -> s TCP SRCPORT 784 DSTPORT 2049 ACK SEQ 5001 ACKNUM 9001
}

// INSTRUCTION: Compile the NFSv4 unmount and TCP teardown flow.
COMPILE {
    nfs_unmount_fin(batch_host, workspace_nfs)
}
