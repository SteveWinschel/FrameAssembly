// Network Time Protocol client mode on UDP 123 and Precision Time Protocol
// synchronization on UDP 319.
// Wireshark: ntp

host time_client { ip 10.0.1.10 }

host time_server { ip 10.0.1.1 }

// Multi-protocol clock synchronization flow. NTPv4 modes on UDP 123: 3
// (Client).
flow clock_sync_flow(c, s) {
    c -> s ntp mode 3 stratum 2
    c -> s ptp msgtype sync domainid 0
}

compile {
    clock_sync_flow(time_client, time_server)
}
