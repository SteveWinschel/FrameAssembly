// PROMPT: Model a chronyd daemon initial iburst startup sequence sending back-to-back NTPv4 client polls.
// TOKENS: host, ip, mac, flow, s, ntp, li, vn, mode, stratum, poll, precision, txtimestamp, wait, ms, refid, compile

// INSTRUCTION: Define the NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 192.168.80.12
    mac 00:1b:21:7b:01:0a
}

// INSTRUCTION: Define the NTP reference server or peer endpoint.
host ntp_server {
    ip 192.168.80.1
    mac 00:1b:21:7b:01:01
}

// INSTRUCTION: Execute the RFC 5905 NTPv4 time synchronization packet exchange.
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 0 poll 4 precision -21 txtimestamp 0xe9b4cb0100000000 wait 2ms
    c <- s ntp li 0 vn 4 mode 4 stratum 2 poll 4 precision -23 refid "GPS" txtimestamp 0xe9b4cb0100200000 wait 10ms
    c -> s ntp li 0 vn 4 mode 3 stratum 2 poll 4 precision -21 txtimestamp 0xe9b4cb0200000000 wait 2ms
    c <- s ntp li 0 vn 4 mode 4 stratum 2 poll 4 precision -23 refid "GPS" txtimestamp 0xe9b4cb0200200000
}

// INSTRUCTION: Compile the NTPv4 synchronization scenario into a PCAP trace.
compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
