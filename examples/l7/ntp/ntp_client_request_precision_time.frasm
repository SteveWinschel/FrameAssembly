// NTP client request transmitting 64-bit transmit timestamp to NTP time
// server.
// Wireshark: ntp

host timestamp_client { ip 10.10.10.55 }

host ntp_clock_server { ip 10.10.10.1 }

// Timestamped request flow. NTPv4 modes on UDP 123: 3 (Client).
flow timestamped_ntp_req(cli, srv) {
    cli -> srv ntp mode 3 vn 4 stratum 0 txtimestamp 16500000000000000000
}

compile {
    timestamped_ntp_req(timestamp_client, ntp_clock_server)
}
