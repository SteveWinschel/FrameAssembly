// NTPv4 Mode 6 control message exchange used by ntpq to inspect peer
// association status.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 127.0.0.1
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 127.0.0.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 6 (Control).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 6 stratum 0 poll 0 precision 0 txtimestamp 0x0000000000000000 payload "ntpq-read-status-vars" wait 1ms
    c <- s ntp li 0 vn 4 mode 6 stratum 1 poll 0 precision 0 refid "PPS" txtimestamp 0x0000000000000000 payload "assid=0 status=0615 leap_none, sync_pps"
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
