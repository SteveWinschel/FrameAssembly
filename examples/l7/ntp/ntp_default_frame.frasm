// NTPv4 starter time query on UDP port 123 using built-in defaults. Omitting
// extra keywords emits a 48-byte client mode 3 synchronization request.
// Automatic UDP source port 12345 and valid checksums are filled in for you.
// Wireshark: ntp

host ntp_client {
    ip 10.10.10.55
    mac 00:1a:2b:0a:0a:37
}

host ntp_server {
    ip 10.10.10.1
    mac 00:1a:2b:0a:0a:01
}

// Send one default NTP query directly without needing a reusable flow block.
compile {
    ntp_client -> ntp_server ntp
}
