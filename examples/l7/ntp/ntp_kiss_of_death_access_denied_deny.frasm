// Enterprise NTPv4 server rejecting an unauthorized subnet client with
// Stratum 0 Kiss-o-Death REFID DENY.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 10.99.123.88
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 10.0.123.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 0 poll 6 precision -18 txtimestamp 0xe9b4c50000000000 wait 2ms
    c <- s ntp li 3 vn 4 mode 4 stratum 0 poll 6 precision -20 refid "DENY" txtimestamp 0x0000000000000000
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
