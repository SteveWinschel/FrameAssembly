// RFC 5905 Kiss-o-Death (KoD) NTPv4 response with Stratum 0 and REFID RATE
// throttling an aggressive client.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 203.0.113.45
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 198.51.100.123
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 0 poll 3 precision -16 txtimestamp 0xe9b4c40000000000 wait 2ms
    c <- s ntp li 3 vn 4 mode 4 stratum 0 poll 10 precision -20 refid "RATE" txtimestamp 0xe9b4c40000100000
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
