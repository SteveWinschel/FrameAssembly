// NTPv4 server response advertising an upcoming negative leap second (LI = 2,
// 59-second minute).
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 192.168.123.30
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 192.168.123.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 3 poll 6 precision -18 txtimestamp 0xe9b4c30000000000 wait 3ms
    c <- s ntp li 2 vn 4 mode 4 stratum 1 poll 6 precision -23 refid "USNO" txtimestamp 0xe9b4c30000624dd2
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
