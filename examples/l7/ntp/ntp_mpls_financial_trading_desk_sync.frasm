// PROMPT: Model a low-latency financial trading server polling a Stratum 1 PPS reference clock over MPLS label 1230.
// TOKENS: host, ip, mac, flow, s, ntp, li, vn, mode, stratum, poll, precision, txtimestamp, mpls, exp, bos, mplsttl, dscp, wait, ms, refid, compile

// INSTRUCTION: Define the NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 172.31.123.10
    mac 00:1b:21:7b:01:0a
}

// INSTRUCTION: Define the NTP reference server or peer endpoint.
host ntp_server {
    ip 172.31.123.1
    mac 00:1b:21:7b:01:01
}

// INSTRUCTION: Execute the RFC 5905 NTPv4 time synchronization packet exchange.
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 2 poll 4 precision -22 txtimestamp 0xe9b4c80000000000 mpls 1230 exp 6 bos 1 mplsttl 64 dscp 46 wait 1ms
    c <- s ntp li 0 vn 4 mode 4 stratum 1 poll 4 precision -26 refid "PPS" txtimestamp 0xe9b4c8000010624d mpls 1230 exp 6 bos 1 mplsttl 64 dscp 46
}

// INSTRUCTION: Compile the NTPv4 synchronization scenario into a PCAP trace.
compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
