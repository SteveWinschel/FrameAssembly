// NTPv4 Stratum 1 time server disciplined by NIST WWVB 60 kHz radio timecode
// (REFID WWVB).
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 172.25.123.8
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 172.25.123.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 2 poll 6 precision -19 txtimestamp 0xe9b4ce0000000000 wait 3ms
    c <- s ntp li 0 vn 4 mode 4 stratum 1 poll 6 precision -21 refid "WWVB" txtimestamp 0xe9b4ce0000400000
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
