// Continuous NTP time client synchronization poll loop executed in compile
// block.
// Wireshark: ntp

// Network time sync daemon.
host timed_daemon { ip 192.168.100.50 }

host ntp_server_node { ip 192.168.100.1 }

// Periodic poll cycle flow. NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
// Repeats 3 times; each wait value pauses after sending its packet.
flow periodic_ntp_poll(c, s) {
    c -> s ntp mode 3 vn 4 stratum 0 poll 4 wait 5ms
    c <- s ntp mode 4 vn 4 stratum 2 poll 4 wait 15ms
}

compile {
    periodic_ntp_poll(timed_daemon, ntp_server_node) // cycle 1
    periodic_ntp_poll(timed_daemon, ntp_server_node) // cycle 2
    periodic_ntp_poll(timed_daemon, ntp_server_node) // cycle 3
}
