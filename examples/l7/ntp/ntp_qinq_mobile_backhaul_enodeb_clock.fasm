// PROMPT: Generate an LTE/5G base station NTPv4 frequency and phase poll across a QinQ metro backhaul (S-VLAN 700, C-VLAN 123).
// TOKENS: host, ip, mac, flow, s, ntp, li, vn, mode, stratum, poll, precision, txtimestamp, qinq, innervlan, dscp, wait, ms, refid, compile

// INSTRUCTION: Define the NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 10.70.123.15
    mac 00:1b:21:7b:01:0a
}

// INSTRUCTION: Define the NTP reference server or peer endpoint.
host ntp_server {
    ip 10.70.123.1
    mac 00:1b:21:7b:01:01
}

// INSTRUCTION: Execute the RFC 5905 NTPv4 time synchronization packet exchange.
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 3 poll 4 precision -20 txtimestamp 0xe9b4c90000000000 qinq 700 innervlan 123 dscp 46 wait 2ms
    c <- s ntp li 0 vn 4 mode 4 stratum 1 poll 4 precision -24 refid "GPS" txtimestamp 0xe9b4c9000020c49b qinq 700 innervlan 123 dscp 46
}

// INSTRUCTION: Compile the NTPv4 synchronization scenario into a PCAP trace.
compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
