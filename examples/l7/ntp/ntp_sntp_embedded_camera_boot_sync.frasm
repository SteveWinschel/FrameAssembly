// Simple Network Time Protocol (SNTP, RFC 4330) boot time query from an
// embedded IP camera.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 192.168.60.140
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 192.168.60.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 3 vn 4 mode 3 stratum 0 poll 10 precision -10 txtimestamp 0x0000000000000000 wait 5ms
    c <- s ntp li 0 vn 4 mode 4 stratum 2 poll 10 precision -20 refid "NIST" txtimestamp 0xe9b4cc0080000000
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
