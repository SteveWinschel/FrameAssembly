// NTPv4 server response with LI 3 (alarm condition) and STRATUM 16 indicating
// loss of upstream reference.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 10.123.55.20
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 10.123.55.1
    mac 00:1b:21:7b:01:01
}

// NTPv4 modes on UDP 123: 3 (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 3 poll 6 precision -19 txtimestamp 0xe9b4cd0000000000 wait 3ms
    c <- s ntp li 3 vn 4 mode 4 stratum 16 poll 6 precision -19 refid "INIT" txtimestamp 0xe9b4cd0000300000
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
