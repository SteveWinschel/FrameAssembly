// PROMPT: NTP Stratum 1 server response referencing GPS synchronized reference clock over IPv6.
// TOKENS: HOST, IP, FLOW, NTP, MODE, VN, STRATUM, REFID, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
FLOW ntp_gps(c, s) {
    c <- s NTP MODE 4 VN 4 STRATUM 1 REFID "GPS"
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    ntp_gps(client, server)
}
