// NTP Stratum 1 server response referencing GPS synchronized reference clock
// over IPv6.
// Wireshark: ntp

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

// NTPv4 modes on UDP 123: 4 (Server).
flow ntp_gps(c, s) {
    c <- s ntp mode 4 vn 4 stratum 1 refid "GPS"
}

compile {
    ntp_gps(client, server)
}
