// NTPv4 client synchronizing with a Stratum 1 Galileo GNSS grandmaster clock
// (REFID GAL).
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 10.123.10.15
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 10.123.10.1
    mac 00:1b:21:7b:01:01
}

// Encapsulation and QoS markings: DSCP 46. NTPv4 modes on UDP 123: 3
// (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 0 poll 6 precision -20 txtimestamp 0xe9b4c10000000000 dscp 46 wait 2ms
    c <- s ntp li 0 vn 4 mode 4 stratum 1 poll 6 precision -24 refid "GAL" txtimestamp 0xe9b4c10000418937 dscp 46
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
