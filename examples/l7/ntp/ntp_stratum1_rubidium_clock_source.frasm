// Stratum 1 server response referencing synchronized Rubidium atomic
// frequency standard.
// Wireshark: ntp

// Mission control time receiver.
host mission_control { ip 192.168.0.50 }

// Rubidium atomic frequency reference.
host rubidium_server { ip 192.168.0.1 }

// Rubidium reference response flow. NTPv4 modes on UDP 123: 4 (Server).
flow rubidium_response_flow(mc, srv) {
    mc <- srv ntp mode 4 vn 4 stratum 1 refid "ATOM" precision -22
}

compile {
    rubidium_response_flow(mission_control, rubidium_server)
}
