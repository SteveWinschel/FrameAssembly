// Telecom Stratum 1 Rubidium atomic oscillator time server answering NTPv4
// queries with REFID RB.
// Wireshark: ntp

// NTP client or peer endpoint initiating time synchronization.
host ntp_client {
    ip 172.16.123.22
    mac 00:1b:21:7b:01:0a
}

// NTP reference server or peer endpoint.
host ntp_server {
    ip 172.16.123.1
    mac 00:1b:21:7b:01:01
}

// Encapsulation and QoS markings: 802.1Q VLAN 123. NTPv4 modes on UDP 123: 3
// (Client), 4 (Server).
flow ntp_scenario_flow(c, s) {
    c -> s ntp li 0 vn 4 mode 3 stratum 2 poll 4 precision -18 txtimestamp 0xe9b4c20000000000 vlan 123 pcp 6 wait 2ms
    c <- s ntp li 0 vn 4 mode 4 stratum 1 poll 4 precision -25 refid "RB" txtimestamp 0xe9b4c2000020c49b vlan 123 pcp 6
}

compile {
    ntp_scenario_flow(ntp_client, ntp_server)
}
