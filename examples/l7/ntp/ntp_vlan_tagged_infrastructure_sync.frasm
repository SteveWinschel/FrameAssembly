// Network infrastructure clock synchronization isolated on dedicated 802.1Q
// management VLAN.
// Wireshark: ntp

// Top of rack management switch.
host tor_mgmt_switch { ip 10.88.10.15 }

// Datacenter grandmaster clock on VLAN 200.
host grandmaster_clock { ip 10.88.10.1 }

// Tagged VLAN NTP client request flow. Encapsulation and QoS markings: 802.1Q
// VLAN 200. NTPv4 modes on UDP 123: 3 (Client).
flow vlan_ntp_sync(sw, gm) {
    sw -> gm ntp mode 3 vn 4 stratum 0 poll 6 vlan 200 pcp 6 dei 0
}

compile {
    vlan_ntp_sync(tor_mgmt_switch, grandmaster_clock)
}
