// OPC Unified Architecture binary secure connection hello and open secure
// channel on TCP 4840.
// Wireshark: opcua

host opc_client { ip 10.0.10.10 }

host opc_server { ip 10.0.10.1 }

// OPC UA secure channel initialization flow.
flow opcua_flow(c, s) {
    c -> s opcua msgtype hel
    c <- s opcua msgtype ack
    c -> s opcua msgtype opn
}

compile {
    opcua_flow(opc_client, opc_server)
}
