// PROMPT: OPC UA Alarms & Conditions (A&C) event notification followed by Acknowledge method call (i=9111).
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the control room alarm operator console.
host operator_console {
    ip 10.140.60.10
    mac 00:1a:2b:8c:60:10
}

// INSTRUCTION: Define the boiler safety OPC UA server.
host boiler_ua_srv {
    ip 10.140.60.1
    mac 00:1a:2b:8c:60:01
}

// INSTRUCTION: Receive high drum level alarm event notification and send Acknowledge method call on i=9111.
flow opcua_alarm_ack(c, s) {
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 601 tokenid 5 seqnum 310 reqid 310 nodeid "ns=1;s=DrumLevelHighAlarm" payload "Severity=900;Message=High Drum Level" wait 2ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 601 tokenid 5 seqnum 311 reqid 311 nodeid "i=9111" payload "AckComment=Operator verified drain valve open"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 601 tokenid 5 seqnum 311 reqid 311 nodeid "i=9111" payload "StatusCode:Good"
}

// INSTRUCTION: Compile the OPC UA Alarms and Conditions acknowledgment flow.
compile {
    opcua_alarm_ack(operator_console, boiler_ua_srv)
}
