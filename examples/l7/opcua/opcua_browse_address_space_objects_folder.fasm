// PROMPT: OPC UA BrowseRequest traversing the ObjectsFolder (i=85) to discover CNC machine tool nodes.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the digital twin modeling client.
host twin_client {
    ip 10.140.20.30
    mac 00:1a:2b:8c:20:30
}

// INSTRUCTION: Define the CNC machine tool embedded OPC UA server.
host cnc_ua_server {
    ip 10.140.20.5
    mac 00:1a:2b:8c:20:05
}

// INSTRUCTION: Browse ObjectsFolder (NODE_ID i=85) and then browse MachineTool sub-tree (ns=2;i=5001).
flow opcua_browse_tree(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 202 tokenid 4 seqnum 50 reqid 50 nodeid "i=85"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 202 tokenid 4 seqnum 50 reqid 50 nodeid "i=85" payload "Server,Aliases,MachineTool_01" wait 2ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 202 tokenid 4 seqnum 51 reqid 51 nodeid "ns=2;i=5001"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 202 tokenid 4 seqnum 51 reqid 51 nodeid "ns=2;i=5001" payload "SpindleSpeed,FeedRate,ToolNumber"
}

// INSTRUCTION: Compile the OPC UA address space browse flow.
compile {
    opcua_browse_tree(twin_client, cnc_ua_server)
}
