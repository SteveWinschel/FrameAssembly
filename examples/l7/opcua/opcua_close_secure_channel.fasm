// PROMPT: OPC UA CloseSecureChannel (CLO) session teardown between MES client and PLC server.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, wait, ms, tcp, fin, ack, compile

// INSTRUCTION: Define manufacturing execution system client.
host mes_client { ip 10.48.0.25 mac 00:50:56:48:00:19 }

// INSTRUCTION: Define assembly line OPC UA server.
host line_plc { ip 10.48.0.1 mac 00:50:56:48:00:01 }

// INSTRUCTION: Define OPC UA CLO message followed by TCP connection close.
flow opcua_close_channel(c, s) {
    c -> s opcua msgtype "clo" chunktype "f" securechannelid 500 tokenid 12 seqnum 99 reqid 99 wait 5ms
    c -> s tcp fin ack
    c <- s tcp fin ack
    c -> s tcp ack
}

// INSTRUCTION: Compile the OPC UA secure channel teardown flow.
compile {
    opcua_close_channel(mes_client, line_plc)
}
