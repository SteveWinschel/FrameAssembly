// PROMPT: OPC UA CreateSessionRequest (i=461) and ActivateSessionRequest (i=467) authenticating an operator session.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, wait, ms, payload, compile

// INSTRUCTION: Define the SCADA OPC UA client host.
host scada_ua_client {
    ip 10.140.10.20
    mac 00:1a:2b:8c:10:20
}

// INSTRUCTION: Define the plant OPC UA aggregation server.
host plant_ua_srv {
    ip 10.140.10.1
    mac 00:1a:2b:8c:10:01
}

// INSTRUCTION: Invoke CreateSession and ActivateSession over SecureChannel 101 Token 1.
flow opcua_session_activate(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 101 tokenid 1 seqnum 10 reqid 10 nodeid "i=461"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 101 tokenid 1 seqnum 10 reqid 10 nodeid "i=464" wait 2ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 101 tokenid 1 seqnum 11 reqid 11 nodeid "i=467" payload "UserNameIdentityToken:operator_01"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 101 tokenid 1 seqnum 11 reqid 11 nodeid "i=470"
}

// INSTRUCTION: Compile the OPC UA CreateSession and ActivateSession flow.
compile {
    opcua_session_activate(scada_ua_client, plant_ua_srv)
}
