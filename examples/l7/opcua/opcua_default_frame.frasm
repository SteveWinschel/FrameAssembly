// OPC UA Binary starter message on TCP port 4840 using built-in defaults.
// Omitting extra keywords emits a 32-byte HEL (Hello) session opening frame.
// TCP sequence progression and Ethernet MAC framing are handled
// automatically.
// Wireshark: opcua

host scada_client {
    ip 10.20.1.10
    mac 00:1b:1b:20:01:0a
}

host plc_server {
    ip 10.20.1.100
    mac 00:1b:1b:20:01:64
}

// Send one default OPC UA Hello directly without needing a reusable flow
// block.
compile {
    scada_client -> plc_server opcua
}
