// OPC UA binary protocol with zero sub-keywords emitting default HEL frame.
// Wireshark: opcua
// Automatic Ethernet MAC addresses and TCP port 4840 defaults apply whenever
// endpoint hardware addresses or ports are left unspecified.

host scada_client { ip 10.20.1.10 mac 00:1b:1b:20:01:0a }

host plc_server { ip 10.20.1.100 mac 00:1b:1b:20:01:64 }

compile {
    scada_client -> plc_server opcua
}
