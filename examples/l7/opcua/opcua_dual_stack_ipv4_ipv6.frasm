// Dual-stack IPv4 and IPv6 OPC UA telemetry polling using a shared shared
// IPv4/IPv6 flow.
// Wireshark: opcua

// IPv4 OPC UA client and server.
host opc_v4_client { ip 10.105.0.10 }

host opc_v4_server { ip 10.105.0.20 }

// IPv6 OPC UA client and server.
host opc_v6_client { ip 2001:db8:4840::10 }

host opc_v6_server { ip 2001:db8:4840::20 }

// Dual-stack flow reading turbine RPM node over IPv4 and IPv6. Encapsulation
// and QoS markings: DSCP 46. Runs the same flow definition over both IPv4 and
// IPv6 host pairs. OPC UA message sequence: MSG on TCP port 4840.
flow opcua_dual_stack_poll(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 9 tokenid 1 seqnum 1 reqid 1 nodeid "ns=3;i=1001" dscp 46 ttl 64 flowlabel 0x48400
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 9 tokenid 1 seqnum 2 reqid 1 nodeid "ns=3;i=1001" dscp 46 ttl 64 flowlabel 0x48400
}

compile {
    opcua_dual_stack_poll(opc_v4_client, opc_v4_server)
    opcua_dual_stack_poll(opc_v6_client, opc_v6_server)
}
