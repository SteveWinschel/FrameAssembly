// PROMPT: OPC UA Error (ERR) response returned when requesting an invalid endpoint URL.
// TOKENS: host, ip, flow, s, opcua, msgtype, chunktype, endpointurl, wait, ms, hexpayload, compile

// INSTRUCTION: Define diagnostic laptop host.
host diag_client { ip 192.168.120.88 }

// INSTRUCTION: Define gateway OPC UA server host.
host opc_gateway { ip 192.168.120.1 }

// INSTRUCTION: Define HEL request to unknown endpoint and ERR response with status code.
flow opcua_error_reply(c, s) {
    c -> s opcua msgtype "hel" chunktype "f" endpointurl "opc.tcp://192.168.120.1:4840/unknown" wait 8ms
    c <- s opcua msgtype "err" chunktype "f" hexpayload "00003f8000000000"
}

// INSTRUCTION: Compile the OPC UA error scenario.
compile {
    opcua_error_reply(diag_client, opc_gateway)
}
