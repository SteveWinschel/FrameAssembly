// PROMPT: OPC UA EUROMAP 77 plastics injection molding companion specification reading cycle counter and mold temperature.
// TOKENS: host, ip, mac, flow, m, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the plastics shopfloor MES host.
host plastics_mes {
    ip 10.140.90.10
    mac 00:1a:2b:8c:90:10
}

// INSTRUCTION: Define the injection molding machine (IMM) EUROMAP 77 OPC UA server.
host imm_ua_server {
    ip 10.140.90.42
    mac 00:1a:2b:8c:90:42
}

// INSTRUCTION: Read EUROMAP 77 IMM_MES_Interface cycle counter and clamping force nodes.
flow opcua_euromap77(m, i) {
    m -> i opcua msgtype "msg" chunktype "f" securechannelid 910 tokenid 1 seqnum 70 reqid 70 nodeid "ns=4;s=IMM.Jobs.Job_01.PartsCounter"
    m <- i opcua msgtype "msg" chunktype "f" securechannelid 910 tokenid 1 seqnum 70 reqid 70 nodeid "ns=4;s=IMM.Jobs.Job_01.PartsCounter" payload "UInt64:18490" wait 2ms
    m -> i opcua msgtype "msg" chunktype "f" securechannelid 910 tokenid 1 seqnum 71 reqid 71 nodeid "ns=4;s=IMM.Clamp.ActualForce"
    m <- i opcua msgtype "msg" chunktype "f" securechannelid 910 tokenid 1 seqnum 71 reqid 71 nodeid "ns=4;s=IMM.Clamp.ActualForce" payload "Double:2500.0"
}

// INSTRUCTION: Compile the EUROMAP 77 injection molding OPC UA flow.
compile {
    opcua_euromap77(plastics_mes, imm_ua_server)
}
