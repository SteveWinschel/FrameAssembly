// PROMPT: OPC UA GetEndpoints discovery service call over SecureChannel 1 querying server security policies.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, endpointurl, wait, ms, nodeid, payload, compile

// INSTRUCTION: Define the OPC UA discovery client application.
host ua_explorer {
    ip 10.140.1.25
    mac 00:1a:2b:8c:01:25
}

// INSTRUCTION: Define the OPC UA server endpoint on TCP port 4840.
host ua_server {
    ip 10.140.1.1
    mac 00:1a:2b:8c:01:01
}

// INSTRUCTION: Open temporary discovery channel and send GetEndpoints request (NodeId i=428).
flow opcua_get_endpoints(c, s) {
    c -> s opcua msgtype "opn" chunktype "f" securechannelid 1 tokenid 1 seqnum 1 reqid 1 endpointurl "opc.tcp://10.140.1.1:4840"
    c <- s opcua msgtype "opn" chunktype "f" securechannelid 1 tokenid 1 seqnum 1 reqid 1 wait 1ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 1 tokenid 1 seqnum 2 reqid 2 nodeid "i=428"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 1 tokenid 1 seqnum 2 reqid 2 nodeid "i=431" payload "Basic256Sha256#SignAndEncrypt"
}

// INSTRUCTION: Compile the OPC UA GetEndpoints discovery flow.
compile {
    opcua_get_endpoints(ua_explorer, ua_server)
}
