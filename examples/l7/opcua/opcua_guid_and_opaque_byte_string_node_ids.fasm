// PROMPT: OPC UA ReadRequest addressing GUID (g=...) and Opaque ByteString (b=...) NodeId identifier formats.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, wait, ms, compile

// INSTRUCTION: Define the brownfield PLC tag aggregator client.
host tag_aggregator {
    ip 10.140.130.25
    mac 00:1a:2b:8c:d0:25
}

// INSTRUCTION: Define the multi-protocol OPC UA wrapper server.
host wrapper_ua_srv {
    ip 10.140.130.1
    mac 00:1a:2b:8c:d0:01
}

// INSTRUCTION: Read a GUID NodeId (ns=2;g=09087e75-8e5e-499b-954f-f2a9603db28a) and an Opaque NodeId (ns=2;b=M/RbKBsRVkePCePcx24oRA==).
flow opcua_guid_opaque(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 1300 tokenid 1 seqnum 10 reqid 10 nodeid "ns=2;g=09087e75-8e5e-499b-954f-f2a9603db28a"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 1300 tokenid 1 seqnum 10 reqid 10 nodeid "ns=2;g=09087e75-8e5e-499b-954f-f2a9603db28a" wait 1ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 1300 tokenid 1 seqnum 11 reqid 11 nodeid "ns=2;b=M/RbKBsRVkePCePcx24oRA=="
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 1300 tokenid 1 seqnum 11 reqid 11 nodeid "ns=2;b=M/RbKBsRVkePCePcx24oRA=="
}

// INSTRUCTION: Compile the OPC UA GUID and Opaque NodeId read flow.
compile {
    opcua_guid_opaque(tag_aggregator, wrapper_ua_srv)
}
