// OPC UA Binary protocol HEL message negotiating buffer limits and ACK
// response.
// Wireshark: opcua

host client { ip 192.168.1.50 }

host server { ip 192.168.1.1 }

// OPC UA message sequence: HEL -> ACK on TCP port 4840.
flow opcua_hel(c, s) {
    c -> s opcua msgtype "hel" chunktype "f" endpointurl "opc.tcp://192.168.1.1:4840"
    c <- s opcua msgtype "ack" chunktype "f"
}

compile {
    opcua_hel(client, server)
}
