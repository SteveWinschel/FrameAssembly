// PROMPT: OPC UA HistoryReadRequest retrieving archived time-series pressure samples from a process historian.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the batch quality reporting client.
host quality_reporter {
    ip 10.140.40.44
    mac 00:1a:2b:8c:40:44
}

// INSTRUCTION: Define the OPC UA Historical Access (HA) server.
host ua_historian {
    ip 10.140.40.1
    mac 00:1a:2b:8c:40:01
}

// INSTRUCTION: Request historical values for Vessel_04_Pressure across multi-chunk response frames.
flow opcua_history_read(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 410 tokenid 8 seqnum 120 reqid 120 nodeid "ns=4;s=Vessel_04_Pressure"
    c <- s opcua msgtype "msg" chunktype "c" securechannelid 410 tokenid 8 seqnum 120 reqid 120 nodeid "ns=4;s=Vessel_04_Pressure" payload "HIST_SAMPLES_001_500" wait 1ms
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 410 tokenid 8 seqnum 121 reqid 120 nodeid "ns=4;s=Vessel_04_Pressure" payload "HIST_SAMPLES_501_1000"
}

// INSTRUCTION: Compile the OPC UA HistoryRead service flow.
compile {
    opcua_history_read(quality_reporter, ua_historian)
}
