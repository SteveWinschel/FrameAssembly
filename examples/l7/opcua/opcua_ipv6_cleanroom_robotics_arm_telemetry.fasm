// PROMPT: IPv6 OPC UA Robotics Companion Specification telemetry reading 6-axis joint angles with DSCP EF.
// TOKENS: host, ip, mac, flow, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, dscp, payload, wait, ms, compile

// INSTRUCTION: Define the semiconductor fab scheduler over IPv6.
host fab_scheduler {
    ip 2001:db8:140:140::10
    mac 00:1a:2b:8c:e0:10
}

// INSTRUCTION: Define the wafer handling cleanroom robot OPC UA server over IPv6.
host wafer_robot {
    ip 2001:db8:140:140::1
    mac 00:1a:2b:8c:e0:01
}

// INSTRUCTION: Read MotionDeviceSystem Axis 1-6 angles and vacuum gripper state over IPv6 with DSCP 46.
flow opcua_ipv6_robotics(c, r) {
    c -> r opcua msgtype "msg" chunktype "f" securechannelid 1400 tokenid 2 seqnum 90 reqid 90 nodeid "ns=3;s=MotionDevice.Axes.J1_Angle" dscp 46
    c <- r opcua msgtype "msg" chunktype "f" securechannelid 1400 tokenid 2 seqnum 90 reqid 90 nodeid "ns=3;s=MotionDevice.Axes.J1_Angle" dscp 46 payload "Double:45.12" wait 1ms
    c -> r opcua msgtype "msg" chunktype "f" securechannelid 1400 tokenid 2 seqnum 91 reqid 91 nodeid "ns=3;s=MotionDevice.EndEffector.VacuumOk" dscp 46
    c <- r opcua msgtype "msg" chunktype "f" securechannelid 1400 tokenid 2 seqnum 91 reqid 91 nodeid "ns=3;s=MotionDevice.EndEffector.VacuumOk" dscp 46 payload "Boolean:true"
}

// INSTRUCTION: Compile the IPv6 cleanroom robotics OPC UA flow.
compile {
    opcua_ipv6_robotics(fab_scheduler, wafer_robot)
}
