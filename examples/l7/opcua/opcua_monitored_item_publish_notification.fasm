// PROMPT: OPC UA CreateMonitoredItems (i=751) and PublishRequest (i=826) streaming data change notifications.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, wait, ms, payload, compile

// INSTRUCTION: Define the cloud edge gateway subscribing to OPC UA tags.
host edge_ua_sub {
    ip 10.140.50.15
    mac 00:1a:2b:8c:50:15
}

// INSTRUCTION: Define the packaging line PLC OPC UA server.
host line_ua_srv {
    ip 10.140.50.1
    mac 00:1a:2b:8c:50:01
}

// INSTRUCTION: Register monitored item on ns=2;s=RejectCount and receive PublishResponse notification.
flow opcua_publish_notify(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 500 tokenid 3 seqnum 200 reqid 200 nodeid "ns=2;s=RejectCount"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 500 tokenid 3 seqnum 200 reqid 200 nodeid "ns=2;s=RejectCount" wait 5ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 500 tokenid 3 seqnum 201 reqid 201 nodeid "i=826"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 500 tokenid 3 seqnum 201 reqid 201 nodeid "i=829" payload "DataChangeNotification:RejectCount=14"
}

// INSTRUCTION: Compile the OPC UA monitored item Publish notification flow.
compile {
    opcua_publish_notify(edge_ua_sub, line_ua_srv)
}
