// Multi-chunk OPC UA message transfer using intermediate (C) and final (F)
// chunks.
// Wireshark: opcua

// OPC UA client requesting large address space browse result.
host browse_client { ip 10.88.2.10 }

// OPC UA server streaming multi-chunk response.
host browse_server { ip 10.88.2.20 }

// Flow with intermediate chunk C and final chunk F. OPC UA message sequence:
// MSG on TCP port 4840.
flow opcua_chunked_transfer(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 77 tokenid 3 seqnum 50 reqid 200 wait 5ms
    c <- s opcua msgtype "msg" chunktype "c" securechannelid 77 tokenid 3 seqnum 51 reqid 200 payload "BrowseChunk1_Nodes_001_to_500" wait 2ms
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 77 tokenid 3 seqnum 52 reqid 200 payload "BrowseChunk2_Nodes_501_to_900"
}

compile {
    opcua_chunked_transfer(browse_client, browse_server)
}
