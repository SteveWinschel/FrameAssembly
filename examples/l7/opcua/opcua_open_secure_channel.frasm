// OPC UA Binary protocol OPN message establishing secure channel over IPv6.
// Wireshark: opcua

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

// OPC UA message sequence: OPN on TCP port 4840.
flow opcua_opn(c, s) {
    c -> s opcua msgtype "opn" chunktype "f" securechannelid 1001 seqnum 1
}

compile {
    opcua_opn(client, server)
}
