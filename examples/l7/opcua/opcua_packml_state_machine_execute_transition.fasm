// PROMPT: OPC UA ISA-TR88 PackML companion specification reading UnitCurrentState and invoking Start method.
// TOKENS: host, ip, mac, flow, s, m, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the packaging line supervisory controller.
host line_supervisor {
    ip 10.140.100.5
    mac 00:1a:2b:8c:a0:05
}

// INSTRUCTION: Define the cartoner machine PackML OPC UA server.
host cartoner_ua {
    ip 10.140.100.20
    mac 00:1a:2b:8c:a0:20
}

// INSTRUCTION: Read PackML Status.StateCurrent (Idle=4), invoke RemoteCommand.Start, and verify Execute=6.
flow opcua_packml_start(s, m) {
    s -> m opcua msgtype "msg" chunktype "f" securechannelid 1010 tokenid 3 seqnum 10 reqid 10 nodeid "ns=5;s=PackML.Status.StateCurrent"
    s <- m opcua msgtype "msg" chunktype "f" securechannelid 1010 tokenid 3 seqnum 10 reqid 10 nodeid "ns=5;s=PackML.Status.StateCurrent" payload "Int32:4(Idle)" wait 1ms
    s -> m opcua msgtype "msg" chunktype "f" securechannelid 1010 tokenid 3 seqnum 11 reqid 11 nodeid "ns=5;s=PackML.Admin.Start"
    s <- m opcua msgtype "msg" chunktype "f" securechannelid 1010 tokenid 3 seqnum 11 reqid 11 nodeid "ns=5;s=PackML.Status.StateCurrent" payload "Int32:6(Execute)"
}

// INSTRUCTION: Compile the OPC UA PackML state transition flow.
compile {
    opcua_packml_start(line_supervisor, cartoner_ua)
}
