// OPC UA Read service request and response targeting an industrial
// temperature sensor nodeid.
// Wireshark: opcua

host historian { ip 172.16.40.20 mac 00:19:99:40:00:14 }

host furnace_opc { ip 172.16.40.5 mac 00:19:99:40:00:05 }

// OPC UA MSG request reading node ns=2;s=Furnace.TempC and server reply. OPC
// UA message sequence: MSG on TCP port 4840.
flow opcua_node_read(client, srv) {
    client -> srv opcua msgtype "msg" chunktype "f" securechannelid 42 tokenid 7 seqnum 10 reqid 100 nodeid "ns=2;s=Furnace.TempC" wait 10ms
    client <- srv opcua msgtype "msg" chunktype "f" securechannelid 42 tokenid 7 seqnum 11 reqid 100 nodeid "ns=2;s=Furnace.TempC" payload "842.5C"
}

compile {
    opcua_node_read(historian, furnace_opc)
}
