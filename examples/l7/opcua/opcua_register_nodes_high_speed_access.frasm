// PROMPT: OPC UA RegisterNodes (i=560) and UnregisterNodes (i=566) optimizing repeated read access on complex string NodeIds.
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the high-speed data logger client.
host fast_logger {
    ip 10.140.80.18
    mac 00:1a:2b:8c:80:18
}

// INSTRUCTION: Define the S7-1500 embedded OPC UA server.
host s7_ua_server {
    ip 10.140.80.1
    mac 00:1a:2b:8c:80:01
}

// INSTRUCTION: Register string NodeId ns=3;s="DB_Fast"."Torque", read using alias handle, and unregister on teardown.
flow opcua_register_nodes(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 1 reqid 1 nodeid "i=560" payload "ns=3;s=DB_Fast.Torque"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 1 reqid 1 nodeid "i=563" payload "Alias=ns=3;i=99001" wait 1ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 2 reqid 2 nodeid "ns=3;i=99001"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 2 reqid 2 nodeid "ns=3;i=99001" payload "Float:412.8" wait 1ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 3 reqid 3 nodeid "i=566"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 800 tokenid 2 seqnum 3 reqid 3 nodeid "i=569"
}

// INSTRUCTION: Compile the OPC UA RegisterNodes and UnregisterNodes flow.
compile {
    opcua_register_nodes(fast_logger, s7_ua_server)
}
