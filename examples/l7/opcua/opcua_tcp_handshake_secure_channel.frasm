// Full TCP three-way handshake followed by OPC UA HEL, ACK, and OPN
// negotiation.
// Wireshark: tcp || opcua

host hmi_station { ip 192.168.50.15 mac 00:0e:8c:50:00:0f }

host robot_ctrl { ip 192.168.50.1 mac 00:0e:8c:50:00:01 }

// Flow with TCP handshake on port 4840 and OPC UA channel open. OPC UA
// message sequence: HEL -> ACK -> OPN on TCP port 4840.
flow opcua_tcp_session(hmi, ctrl) {
    hmi -> ctrl tcp syn dstport 4840
    hmi <- ctrl tcp syn ack
    hmi -> ctrl tcp ack wait 2ms
    hmi -> ctrl opcua msgtype "hel" chunktype "f" endpointurl "opc.tcp://192.168.50.1:4840" wait 5ms
    hmi <- ctrl opcua msgtype "ack" chunktype "f" wait 5ms
    hmi -> ctrl opcua msgtype "opn" chunktype "f" securechannelid 101 tokenid 1 seqnum 1 reqid 1 wait 5ms
    hmi <- ctrl opcua msgtype "opn" chunktype "f" securechannelid 101 tokenid 1 seqnum 1 reqid 1
}

compile {
    opcua_tcp_session(hmi_station, robot_ctrl)
}
