// PROMPT: OPC UA SecurityToken renewal over an existing SecureChannel on non-standard port 4841.
// TOKENS: host, ip, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, srcport, dstport, wait, ms, compile

// INSTRUCTION: Define redundant OPC UA client.
host red_client { ip 10.33.10.11 }

// INSTRUCTION: Define redundant OPC UA server listening on port 4841.
host red_server { ip 10.33.10.12 }

// INSTRUCTION: Define OPN token renewal incrementing TOKEN_ID from 1 to 2.
flow opcua_token_renew(c, s) {
    c -> s opcua msgtype "opn" chunktype "f" securechannelid 900 tokenid 2 seqnum 500 reqid 450 srcport 51200 dstport 4841 wait 5ms
    c <- s opcua msgtype "opn" chunktype "f" securechannelid 900 tokenid 2 seqnum 500 reqid 450 srcport 4841 dstport 51200
}

// INSTRUCTION: Compile the OPC UA token renewal flow.
compile {
    opcua_token_renew(red_client, red_server)
}
