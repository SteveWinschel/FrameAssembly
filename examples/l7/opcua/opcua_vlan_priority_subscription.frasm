// Industrial VLAN 200 and PCP 6 prioritized OPC UA subscription publish
// exchange.
// Wireshark: opcua

// Plant floor historian on industrial VLAN 200.
host plant_hist { ip 192.168.200.10 mac 00:1c:06:c8:00:0a }

// CNC machine controller on industrial VLAN 200.
host cnc_ctrl { ip 192.168.200.50 mac 00:1c:06:c8:00:32 }

// VLAN-tagged OPC UA publish request and notification response. Encapsulation
// and QoS markings: 802.1Q VLAN 200, DSCP 46. OPC UA message sequence: MSG on
// TCP port 4840.
flow opcua_vlan_publish(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 300 tokenid 4 seqnum 21 reqid 501 nodeid "ns=4;s=CNC.SpindleLoad" vlan 200 pcp 6 dei 0 dscp 46 wait 10ms
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 300 tokenid 4 seqnum 22 reqid 501 nodeid "ns=4;s=CNC.SpindleLoad" vlan 200 pcp 6 dei 0 dscp 46
}

compile {
    opcua_vlan_publish(plant_hist, cnc_ctrl)
}
