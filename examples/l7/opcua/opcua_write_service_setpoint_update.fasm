// PROMPT: OPC UA WriteRequest updating a pasteurization temperature setpoint node (ns=3;s=Pasteurizer.TempSetpoint).
// TOKENS: host, ip, mac, flow, s, opcua, msgtype, chunktype, securechannelid, tokenid, seqnum, reqid, nodeid, payload, wait, ms, compile

// INSTRUCTION: Define the dairy plant recipe manager client.
host recipe_client {
    ip 10.140.30.12
    mac 00:1a:2b:8c:30:12
}

// INSTRUCTION: Define the pasteurization skid OPC UA server.
host skid_ua_server {
    ip 10.140.30.1
    mac 00:1a:2b:8c:30:01
}

// INSTRUCTION: Write 72.5 C to ns=3;s=Pasteurizer.TempSetpoint and read back ns=3;s=Pasteurizer.TempActual.
flow opcua_write_setpoint(c, s) {
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 305 tokenid 2 seqnum 80 reqid 80 nodeid "ns=3;s=Pasteurizer.TempSetpoint" payload "Double:72.5"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 305 tokenid 2 seqnum 80 reqid 80 nodeid "ns=3;s=Pasteurizer.TempSetpoint" payload "StatusCode:Good(0x00000000)" wait 2ms
    c -> s opcua msgtype "msg" chunktype "f" securechannelid 305 tokenid 2 seqnum 81 reqid 81 nodeid "ns=3;s=Pasteurizer.TempActual"
    c <- s opcua msgtype "msg" chunktype "f" securechannelid 305 tokenid 2 seqnum 81 reqid 81 nodeid "ns=3;s=Pasteurizer.TempActual" payload "Double:72.4"
}

// INSTRUCTION: Compile the OPC UA WriteRequest setpoint update flow.
compile {
    opcua_write_setpoint(recipe_client, skid_ua_server)
}
