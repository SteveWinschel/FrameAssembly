// PROMPT: POP3 invalid password authentication rejection returning -ERR response.
// TOKENS: host, ip, flow, s, pop3, ok, wait, ms, cmd, arg, err, compile

// INSTRUCTION: Define mail client attempting login.
host client_host { ip 10.10.5.40 }

// INSTRUCTION: Define POP3 mail server.
host mail_host { ip 10.10.5.10 }

// INSTRUCTION: Define POP3 login attempt where PASS fails with -ERR.
flow pop3_auth_fail(c, s) {
    c <- s pop3 ok wait 5ms
    c -> s pop3 cmd "USER" arg "jdoe@corp.example" wait 5ms
    c <- s pop3 ok wait 5ms
    c -> s pop3 cmd "PASS" arg "wrong_password_123" wait 10ms
    c <- s pop3 err
}

// INSTRUCTION: Compile failed POP3 login scenario.
compile {
    pop3_auth_fail(client_host, mail_host)
}
