// PROMPT: Model a POP3 AUTH CRAM-MD5 challenge-response authentication sequence per RFC 5034.
// TOKENS: host, ip, mac, flow, s, pop3, cmd, arg, wait, ms, ok, response, compile

// INSTRUCTION: Define the mail client authenticating with SASL CRAM-MD5.
host cram_client {
    ip 10.110.30.40
    mac 00:15:5d:6e:1e:28
}

// INSTRUCTION: Define the corporate POP3 gateway.
host cram_pop3_gw {
    ip 10.110.30.1
    mac 00:15:5d:6e:1e:01
}

// INSTRUCTION: Request AUTH CRAM-MD5, receive base64 challenge, send HMAC digest, and receive +OK.
flow pop3_auth_cram_md5(c, s) {
    c -> s pop3 cmd "AUTH" arg "CRAM-MD5" wait 2ms
    c <- s pop3 ok response "PDE4OTYuNjk3MTcwOTUyQHBvcDMuY29ycC5sb2NhbD4=" wait 3ms
    c -> s pop3 cmd "RESPONSE" arg "dGltIGI5MTNhNjAyYzdlZGE3YTQ5NWI0ZTZlNzMzNGQzODkw" wait 3ms
    c <- s pop3 ok response "CRAM-MD5 authentication successful (4 messages)"
}

// INSTRUCTION: Compile the POP3 SASL CRAM-MD5 authentication scenario.
compile {
    pop3_auth_cram_md5(cram_client, cram_pop3_gw)
}
