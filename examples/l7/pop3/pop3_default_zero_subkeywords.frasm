// Minimal 2-block POP3 (RFC 1939) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (POP3 (RFC
// 1939), TCP 110).
// Wireshark: pop

host mail_client { ip 192.168.10.25 mac 00:11:22:33:44:19 }

host pop3_srv { ip 192.168.10.5 mac 00:11:22:33:44:05 }

compile {
    mail_client -> pop3_srv pop3
}
