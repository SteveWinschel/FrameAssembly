// PROMPT: Simulate a branch office fetchmail daemon pulling POP3 messages over an MPLS WAN pseudowire (label 4110).
// TOKENS: host, ip, mac, flow, s, pop3, cmd, mpls, exp, bos, mplsttl, wait, ms, ok, response, arg, payload, compile

// INSTRUCTION: Define the branch office fetchmail relay host.
host fetchmail_gw {
    ip 172.21.110.15
    mac 00:1a:4a:6e:00:0f
}

// INSTRUCTION: Define the headquarters POP3 mailstore server.
host hq_pop3_srv {
    ip 172.21.1.110
    mac 00:1a:4a:01:00:6e
}

// INSTRUCTION: Check STAT, retrieve message 1, delete it, and QUIT over MPLS label 4110.
flow pop3_fetchmail_mpls(c, s) {
    c -> s pop3 cmd "STAT" mpls 4110 exp 3 bos 1 mplsttl 64 wait 3ms
    c <- s pop3 ok response "1 840" mpls 4110 exp 3 bos 1 mplsttl 64 wait 2ms
    c -> s pop3 cmd "RETR" arg "1" mpls 4110 exp 3 bos 1 mplsttl 64 wait 4ms
    c <- s pop3 ok response "840 octets" payload "Subject: Branch Dispatch

Order 9912 approved.
.
" mpls 4110 exp 3 bos 1 mplsttl 64 wait 2ms
    c -> s pop3 cmd "DELE" arg "1" mpls 4110 exp 3 bos 1 mplsttl 64 wait 2ms
    c <- s pop3 ok response "message 1 marked deleted" mpls 4110 exp 3 bos 1 mplsttl 64 wait 2ms
    c -> s pop3 cmd "QUIT" mpls 4110 exp 3 bos 1 mplsttl 64 wait 2ms
    c <- s pop3 ok response "1 message purged" mpls 4110 exp 3 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the MPLS-encapsulated POP3 fetchmail flow.
compile {
    pop3_fetchmail_mpls(fetchmail_gw, hq_pop3_srv)
}
