// PROMPT: POP3 NOOP keepalive polling loop over VLAN 110 with 802.1p priority tagging.
// TOKENS: host, ip, mac, flow, s, pop3, cmd, vlan, pcp, dei, wait, ok, compile

// INSTRUCTION: Define campus mail client on VLAN 110.
host campus_mua { ip 192.168.110.45 mac 00:1a:2b:6e:00:2d }

// INSTRUCTION: Define campus POP3 server on VLAN 110.
host campus_pop { ip 192.168.110.10 mac 00:1a:2b:6e:00:0a }

// INSTRUCTION: Define single POP3 NOOP heartbeat exchange on VLAN 110.
flow pop3_noop_keepalive(c, s) {
    c -> s pop3 cmd "NOOP" vlan 110 pcp 2 dei 0 wait 1s
    c <- s pop3 ok vlan 110 pcp 2 dei 0 wait 1s
}

// INSTRUCTION: Execute 4 keepalive cycles in a COMPILE LOOP.
compile {
    pop3_noop_keepalive(campus_mua, campus_pop) // cycle 1
    pop3_noop_keepalive(campus_mua, campus_pop) // cycle 2
    pop3_noop_keepalive(campus_mua, campus_pop) // cycle 3
    pop3_noop_keepalive(campus_mua, campus_pop) // cycle 4
}
