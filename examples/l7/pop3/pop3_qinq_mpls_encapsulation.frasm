// POP3 traffic encapsulated in QinQ service provider tags and MPLS label
// stack.
// Encapsulation and QoS markings: 802.1ad QinQ outer 500 / inner 110, MPLS
// label 11001, 11002.
// Wireshark: (pop && vlan) && mpls

host branch_fetcher { ip 10.110.1.5 }

host hq_pop_srv { ip 10.110.2.5 }

flow pop3_wan_mpls(c, s) {
    c -> s pop3 cmd "LIST" arg "1" qinq 500 innervlan 110 mpls 11001 exp 2 bos 1 mplsttl 64
    c <- s pop3 ok qinq 500 innervlan 110 mpls 11002 exp 2 bos 1 mplsttl 63
}

compile {
    pop3_wan_mpls(branch_fetcher, hq_pop_srv)
}
