// POP3 message retrieval and session termination over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: pop

host client { ip 2001:db8::12 }

host server { ip 2001:db8::1 }

flow pop3_retr(c, s) {
    c -> s pop3 cmd "RETR" arg "1"
    c <- s pop3 ok
    c -> s pop3 cmd "QUIT"
    c <- s pop3 ok
}

compile {
    pop3_retr(client, server)
}
