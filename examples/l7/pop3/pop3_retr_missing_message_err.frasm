// POP3 request for non-existent message index returning -ERR no such message.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: pop

host pop_client { ip 192.168.88.12 }

host pop_server { ip 192.168.88.1 }

flow pop3_missing_msg(c, s) {
    c -> s pop3 cmd "RETR" arg "999" wait 5ms
    c <- s pop3 err
}

compile {
    pop3_missing_msg(pop_client, pop_server)
}
