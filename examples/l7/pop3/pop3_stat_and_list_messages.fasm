// PROMPT: POP3 mailbox status inspection retrieving message count and sizes.
// TOKENS: host, ip, flow, s, pop3, cmd, ok, compile

// INSTRUCTION: Define client endpoint.
host client { ip 10.0.0.12 }

// INSTRUCTION: Define server endpoint.
host server { ip 10.0.0.1 }

// INSTRUCTION: Define application traffic flow.
flow pop3_stat(c, s) {
    c -> s pop3 cmd "STAT"
    c <- s pop3 ok
    c -> s pop3 cmd "LIST"
    c <- s pop3 ok
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    pop3_stat(client, server)
}
