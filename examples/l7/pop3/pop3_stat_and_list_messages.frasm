// POP3 mailbox status inspection retrieving message count and sizes.
// Wireshark: pop

host client { ip 10.0.0.12 }

host server { ip 10.0.0.1 }

flow pop3_stat(c, s) {
    c -> s pop3 cmd "STAT"
    c <- s pop3 ok
    c -> s pop3 cmd "LIST"
    c <- s pop3 ok
}

compile {
    pop3_stat(client, server)
}
