// PROMPT: Simulate a POP3 mail retrieval session across DMZ VLAN 210 with IEEE 802.1p priority tagging.
// TOKENS: host, ip, mac, flow, s, pop3, cmd, arg, vlan, pcp, wait, ms, ok, response, payload, compile

// INSTRUCTION: Define the internal mail collector on DMZ VLAN 210.
host dmz_collector {
    ip 172.16.210.20
    mac 00:1b:21:d2:00:14
}

// INSTRUCTION: Define the DMZ POP3 bastion server on VLAN 210.
host dmz_pop3_srv {
    ip 172.16.210.5
    mac 00:1b:21:d2:00:05
}

// INSTRUCTION: Authenticate, retrieve message 1, and close session over VLAN 210 PCP 3.
flow pop3_dmz_vlan_session(c, s) {
    c -> s pop3 cmd "USER" arg "dmz_ingest" vlan 210 pcp 3 wait 2ms
    c <- s pop3 ok response "User accepted" vlan 210 pcp 3 wait 2ms
    c -> s pop3 cmd "PASS" arg "IngestVault#8" vlan 210 pcp 3 wait 3ms
    c <- s pop3 ok response "Mailbox open (1 message)" vlan 210 pcp 3 wait 2ms
    c -> s pop3 cmd "RETR" arg "1" vlan 210 pcp 3 wait 3ms
    c <- s pop3 ok response "620 octets" payload "Subject: External Partner EDI

ISA*00*
.
" vlan 210 pcp 3
}

// INSTRUCTION: Compile the DMZ VLAN 210 POP3 retrieval flow.
compile {
    pop3_dmz_vlan_session(dmz_collector, dmz_pop3_srv)
}
