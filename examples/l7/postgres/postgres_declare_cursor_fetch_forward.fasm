// PROMPT: PostgreSQL server-side portal streaming using DECLARE CURSOR, FETCH FORWARD 500, and CLOSE CURSOR.
// TOKENS: HOST, IP, MAC, FLOW, POSTGRES, SQL, COMMAND_COMPLETE, WAIT, PAYLOAD, READY_FOR_QUERY, COMPILE

// INSTRUCTION: Define the financial compliance export service.
HOST export_worker {
    IP 10.95.70.45
    MAC 00:1a:2b:95:70:45
}

// INSTRUCTION: Define the archival PostgreSQL server.
HOST archive_pg {
    IP 10.95.70.1
    MAC 00:1a:2b:95:70:01
}

// INSTRUCTION: Open a holdable cursor, fetch a batch of 500 rows, and close the cursor.
FLOW pg_cursor_stream(c, s) {
    c -> s POSTGRES SQL "BEGIN; DECLARE audit_cur NO SCROLL CURSOR FOR SELECT * FROM audit_trail WHERE yr = 2026"
    c <- s POSTGRES COMMAND_COMPLETE WAIT 1ms
    c -> s POSTGRES SQL "FETCH FORWARD 500 FROM audit_cur"
    c <- s POSTGRES COMMAND_COMPLETE PAYLOAD "FETCH 500" WAIT 2ms
    c -> s POSTGRES SQL "CLOSE audit_cur; COMMIT"
    c <- s POSTGRES COMMAND_COMPLETE WAIT 1ms
    c <- s POSTGRES READY_FOR_QUERY
}

// INSTRUCTION: Compile the PostgreSQL server-side cursor streaming flow.
COMPILE {
    pg_cursor_stream(export_worker, archive_pg)
}
