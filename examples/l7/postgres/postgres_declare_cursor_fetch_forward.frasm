// PostgreSQL server-side portal streaming using DECLARE CURSOR, FETCH FORWARD
// 500, and CLOSE CURSOR.
// Timing: uses post-packet wait delays (1ms, 2ms) between frames.
// Wireshark: pgsql

host export_worker {
    ip 10.95.70.45
    mac 00:1a:2b:95:70:45
}

host archive_pg {
    ip 10.95.70.1
    mac 00:1a:2b:95:70:01
}

flow pg_cursor_stream(c, s) {
    c -> s postgres sql "BEGIN; DECLARE audit_cur NO SCROLL CURSOR FOR SELECT * FROM audit_trail WHERE yr = 2026"
    c <- s postgres commandcomplete wait 1ms
    c -> s postgres sql "FETCH FORWARD 500 FROM audit_cur"
    c <- s postgres commandcomplete payload "FETCH 500" wait 2ms
    c -> s postgres sql "CLOSE audit_cur; COMMIT"
    c <- s postgres commandcomplete wait 1ms
    c <- s postgres readyforquery
}

compile {
    pg_cursor_stream(export_worker, archive_pg)
}
