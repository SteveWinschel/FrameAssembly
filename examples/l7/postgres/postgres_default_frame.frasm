// Minimal 2-block PostgreSQL v3.0 starter sending a default wire message on TCP 5432.
// Computes protocol length headers and TCP sequence numbers automatically without a flow block.
// Preview with 'frameassembly show' or compile to test database firewall rules.
// Wireshark: pgsql

host app_client  { ip 10.30.1.15 mac 00:1a:2b:30:01:0f }
host postgres_db { ip 10.30.1.40 mac 00:1a:2b:30:01:28 }

compile {
    app_client -> postgres_db postgres
}
