// PROMPT: Default PostgreSQL wire protocol query frame with zero sub-keywords on TCP port 5432.
// TOKENS: host, ip, mac, flow, s, postgres, compile

// INSTRUCTION: Define backend microservice host.
host app_node { ip 10.30.1.15 mac 00:16:3e:30:01:0f }

// INSTRUCTION: Define PostgreSQL primary database server.
host pg_primary { ip 10.30.1.5 mac 00:16:3e:30:01:05 }

// INSTRUCTION: Define flow sending default POSTGRES query frame.
flow pg_default(c, s) {
    c -> s postgres
}

// INSTRUCTION: Compile default PostgreSQL query scenario.
compile {
    pg_default(app_node, pg_primary)
}
