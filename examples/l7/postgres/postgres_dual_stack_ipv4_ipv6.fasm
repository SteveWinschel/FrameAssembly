// PROMPT: Dual-stack IPv4 and IPv6 PostgreSQL read replica queries using a polymorphic flow.
// TOKENS: host, ip, flow, s, postgres, sql, dscp, ttl, flowlabel, commandcomplete, readyforquery, compile

// INSTRUCTION: Define IPv4 reporting worker and PostgreSQL replica.
host pg_v4_client { ip 10.54.32.10 }
// INSTRUCTION: Define IPv4 PostgreSQL read replica.
host pg_v4_replica { ip 10.54.32.20 }

// INSTRUCTION: Define IPv6 reporting worker and PostgreSQL replica.
host pg_v6_client { ip 2001:db8:5432::10 }
// INSTRUCTION: Define IPv6 PostgreSQL read replica.
host pg_v6_replica { ip 2001:db8:5432::20 }

// INSTRUCTION: Define polymorphic PostgreSQL SELECT query flow.
flow pg_dual_stack_select(c, s) {
    c -> s postgres sql "SELECT id, status FROM orders WHERE created_at > NOW() - INTERVAL '1 hour'" dscp 26 ttl 64 flowlabel 0x54320
    c <- s postgres commandcomplete readyforquery dscp 26 ttl 64 flowlabel 0x54320
}

// INSTRUCTION: Compile dual-stack PostgreSQL queries over IPv4 and IPv6.
compile {
    pg_dual_stack_select(pg_v4_client, pg_v4_replica)
    pg_dual_stack_select(pg_v6_client, pg_v6_replica)
}
