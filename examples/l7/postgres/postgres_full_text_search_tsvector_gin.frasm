// PostgreSQL Full-Text Search query using to_tsvector, websearch_to_tsquery,
// and ts_rank_cd.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: pgsql

host docs_search_api {
    ip 10.95.90.30
    mac 00:1a:2b:95:90:30
}

host docs_pg {
    ip 10.95.90.5
    mac 00:1a:2b:95:90:05
}

flow pg_fts_query(c, s) {
    c -> s postgres sql "SELECT doc_id FROM docs WHERE search_tsv @@ websearch_to_tsquery('english', 'ebpf xdp packet') LIMIT 5"
    c <- s postgres commandcomplete payload "SELECT 5" wait 2ms
    c <- s postgres readyforquery
}

compile {
    pg_fts_query(docs_search_api, docs_pg)
}
