// PostgreSQL read replica verification querying pg_is_in_recovery() and
// pg_last_wal_replay_lsn().
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: pgsql

host patroni_agent {
    ip 10.95.110.10
    mac 00:1a:2b:95:b0:10
}

host pg_standby {
    ip 10.95.110.2
    mac 00:1a:2b:95:b0:02
}

flow pg_standby_lag(c, s) {
    c -> s postgres startup user "patroni_mon" db "postgres"
    c <- s postgres authok wait 1ms
    c <- s postgres readyforquery wait 1ms
    c -> s postgres sql "SELECT pg_is_in_recovery(), pg_last_wal_replay_lsn()"
    c <- s postgres commandcomplete payload "t | 0/4A001F88" wait 1ms
    c <- s postgres readyforquery
}

compile {
    pg_standby_lag(patroni_agent, pg_standby)
}
