// PostgreSQL LISTEN and asynchronous NOTIFY pub/sub channel exchange.
// Timing: uses post-packet wait delays (3ms, 10ms) between frames.
// Wireshark: pgsql

host event_worker { ip 10.82.0.12 }

host pg_broker { ip 10.82.0.1 }

flow pg_listen_notify(c, s) {
    c -> s postgres sql "LISTEN job_queue_events" wait 3ms
    c <- s postgres commandcomplete readyforquery wait 10ms
    c -> s postgres sql "NOTIFY job_queue_events, 'job_id_8821_ready'" wait 3ms
    c <- s postgres commandcomplete readyforquery payload "AsyncNotification:job_queue_events:job_id_8821_ready"
}

compile {
    pg_listen_notify(event_worker, pg_broker)
}
