// PostgreSQL REFRESH MATERIALIZED VIEW CONCURRENTLY updating pre-aggregated
// analytics dashboards.
// Timing: uses post-packet wait delays (1ms, 5ms) between frames.
// Wireshark: pgsql

host airflow_worker {
    ip 10.95.20.40
    mac 00:1a:2b:95:20:40
}

host dw_postgres {
    ip 10.95.20.10
    mac 00:1a:2b:95:20:10
}

flow pg_matview_refresh(c, s) {
    c -> s postgres startup user "dw_etl" db "analytics_prod"
    c <- s postgres authok wait 1ms
    c <- s postgres readyforquery wait 1ms
    c -> s postgres sql "REFRESH MATERIALIZED VIEW CONCURRENTLY mv_hourly_revenue_by_country"
    c <- s postgres commandcomplete wait 5ms
    c <- s postgres readyforquery
}

compile {
    pg_matview_refresh(airflow_worker, dw_postgres)
}
