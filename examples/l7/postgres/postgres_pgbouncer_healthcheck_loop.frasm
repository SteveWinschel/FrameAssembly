// PgBouncer connection pooler health check loop over VLAN 540 with 802.1p
// priority.
// Encapsulation and QoS markings: 802.1Q VLAN 540, 802.1p priority 3.
// Overrides destination port to 6432.
// Timing: runs 4 cycles in compile using post-packet waits (50ms).
// Wireshark: (pgsql || tcp.port == 6432) && vlan.id == 540

host pgbouncer { ip 192.168.54.5 }

host pg_backend { ip 192.168.54.10 }

flow pg_pool_ping(pool, db) {
    pool -> db postgres sql "SELECT 1" vlan 540 pcp 3 dei 0 srcport 48000 dstport 6432 wait 50ms
    pool <- db postgres commandcomplete readyforquery vlan 540 pcp 3 dei 0 srcport 6432 dstport 48000 wait 50ms
}

compile {
    pg_pool_ping(pgbouncer, pg_backend) // cycle 1
    pg_pool_ping(pgbouncer, pg_backend) // cycle 2
    pg_pool_ping(pgbouncer, pg_backend) // cycle 3
    pg_pool_ping(pgbouncer, pg_backend) // cycle 4
}
