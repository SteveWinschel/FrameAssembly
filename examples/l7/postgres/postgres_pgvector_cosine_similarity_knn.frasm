// PostgreSQL pgvector HNSW index nearest-neighbor cosine distance (<=>) query
// for RAG embeddings.
// Timing: uses post-packet wait delays (1ms, 2ms) between frames.
// Wireshark: pgsql

host rag_service {
    ip 10.95.100.50
    mac 00:1a:2b:95:a0:50
}

host vector_pg {
    ip 10.95.100.1
    mac 00:1a:2b:95:a0:01
}

flow pg_vector_knn(c, s) {
    c -> s postgres sql "SET LOCAL hnsw.ef_search = 100"
    c <- s postgres commandcomplete wait 1ms
    c -> s postgres sql "SELECT chunk_id, content FROM kb_embeddings ORDER BY embedding <=> '[0.021,-0.044,0.118,0.092]' LIMIT 3"
    c <- s postgres commandcomplete payload "SELECT 3" wait 2ms
    c <- s postgres readyforquery
}

compile {
    pg_vector_knn(rag_service, vector_pg)
}
