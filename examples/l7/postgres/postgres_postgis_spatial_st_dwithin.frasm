// PostGIS spatial query using ST_DWithin and ST_MakePoint over IPv6 for
// geofence alerting.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: pgsql

host geofence_svc {
    ip 2001:db8:95:30::22
    mac 00:1a:2b:95:30:22
}

host postgis_db {
    ip 2001:db8:95:30::1
    mac 00:1a:2b:95:30:01
}

flow pg_postgis_query(c, s) {
    c -> s postgres sql "SELECT zone_id, name FROM restricted_zones WHERE ST_DWithin(geom, ST_MakePoint(-73.9857, 40.7484)::geography, 500)"
    c <- s postgres commandcomplete payload "SELECT 2" wait 2ms
    c <- s postgres readyforquery
}

compile {
    pg_postgis_query(geofence_svc, postgis_db)
}
