// PostgreSQL backend command completion and ReadyForQuery signal over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: pgsql

host client { ip 2001:db8::200 }

host server { ip 2001:db8::1 }

flow pg_ready(c, s) {
    c <- s postgres commandcomplete
    c <- s postgres readyforquery
}

compile {
    pg_ready(client, server)
}
