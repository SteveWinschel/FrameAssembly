// PostgreSQL subtransaction management using SAVEPOINT, ERROR_RESPONSE
// recovery, and ROLLBACK TO SAVEPOINT.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: pgsql

host import_worker {
    ip 10.95.50.14
    mac 00:1a:2b:95:50:14
}

host tenant_pg {
    ip 10.95.50.1
    mac 00:1a:2b:95:50:01
}

flow pg_savepoint_recovery(c, s) {
    c -> s postgres sql "BEGIN; SAVEPOINT row_import_1"
    c <- s postgres commandcomplete wait 1ms
    c -> s postgres sql "INSERT INTO invoices (total_cents) VALUES (-500)"
    c <- s postgres errorresponse payload "new row for relation 'invoices' violates check constraint 'chk_positive_total'" wait 1ms
    c -> s postgres sql "ROLLBACK TO SAVEPOINT row_import_1; COMMIT"
    c <- s postgres commandcomplete wait 1ms
    c <- s postgres readyforquery
}

compile {
    pg_savepoint_recovery(import_worker, tenant_pg)
}
