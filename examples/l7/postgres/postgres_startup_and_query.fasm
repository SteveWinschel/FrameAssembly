// PROMPT: PostgreSQL database protocol v3 frontend startup and simple query execution on TCP 5432.
// TOKENS: HOST, IP, FLOW, ->, POSTGRES, QUERY, SQL, COMPILE

// INSTRUCTION: Define PostgreSQL application client.
HOST pg_client { IP 10.0.3.10 }

// INSTRUCTION: Define PostgreSQL database server.
HOST pg_server { IP 10.0.3.1 }

// INSTRUCTION: Define PostgreSQL database query flow.
FLOW postgres_flow(c, s) {
    c -> s POSTGRES QUERY SQL "SELECT version()"
}

// INSTRUCTION: Compile block executing PostgreSQL query.
COMPILE {
    postgres_flow(pg_client, pg_server)
}
