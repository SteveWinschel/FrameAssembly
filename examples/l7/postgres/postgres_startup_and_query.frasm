// PostgreSQL database protocol v3 frontend startup and simple query execution
// on TCP 5432.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (PostgreSQL
// v3.0, TCP 5432).
// Wireshark: pgsql

host pg_client { ip 10.0.3.10 }

host pg_server { ip 10.0.3.1 }

flow postgres_flow(c, s) {
    c -> s postgres query sql "SELECT version()"
}

compile {
    postgres_flow(pg_client, pg_server)
}
