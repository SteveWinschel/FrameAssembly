// PROMPT: PostgreSQL frontend connection initialization StartupMessage.
// TOKENS: host, ip, flow, s, postgres, startup, db, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.200 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
flow pg_startup(c, s) {
    c -> s postgres startup db "analytics"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    pg_startup(client, server)
}
