// PostgreSQL frontend connection initialization StartupMessage.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (PostgreSQL
// v3.0, TCP 5432).
// Wireshark: pgsql

host client { ip 192.168.1.200 }

host server { ip 192.168.1.1 }

flow pg_startup(c, s) {
    c -> s postgres startup db "analytics"
}

compile {
    pg_startup(client, server)
}
