// PROMPT: Full TCP 3-way handshake on port 5432 followed by PostgreSQL STARTUP, AUTH_OK, and READY_FOR_QUERY.
// TOKENS: host, ip, mac, flow, s, tcp, syn, dstport, ack, wait, ms, postgres, startup, db, authok, readyforquery, compile

// INSTRUCTION: Define ORM database client host.
host orm_worker { ip 192.168.42.20 mac 00:50:56:42:00:14 }

// INSTRUCTION: Define PostgreSQL cluster leader host.
host pg_leader { ip 192.168.42.10 mac 00:50:56:42:00:0a }

// INSTRUCTION: Define TCP handshake and PostgreSQL session initialization.
flow pg_tcp_startup(c, s) {
    c -> s tcp syn dstport 5432
    c <- s tcp syn ack
    c -> s tcp ack wait 2ms
    c -> s postgres startup db "analytics_prod" wait 5ms
    c <- s postgres authok wait 2ms
    c <- s postgres readyforquery
}

// INSTRUCTION: Compile PostgreSQL TCP connection startup flow.
compile {
    pg_tcp_startup(orm_worker, pg_leader)
}
