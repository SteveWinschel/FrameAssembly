// PostgreSQL INSERT ... ON CONFLICT DO UPDATE atomic upsert with
// COMMAND_COMPLETE and READY_FOR_QUERY.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: pgsql

host inv_sync_worker {
    ip 10.95.1.20
    mac 00:1a:2b:95:01:20
}

host pg_primary {
    ip 10.95.1.5
    mac 00:1a:2b:95:01:05
}

flow pg_upsert_flow(c, s) {
    c -> s postgres sql "INSERT INTO stock_levels (sku, qty) VALUES ('SKU-900', 50) ON CONFLICT (sku) DO UPDATE SET qty = EXCLUDED.qty"
    c <- s postgres commandcomplete payload "INSERT 0 1" wait 1ms
    c <- s postgres readyforquery
}

compile {
    pg_upsert_flow(inv_sync_worker, pg_primary)
}
