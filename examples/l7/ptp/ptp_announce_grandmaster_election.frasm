// PTP Grandmaster ANNOUNCE broadcast advertising clock quality in telecom
// domain 24.
// IEEE 1588v2 PTP (messages: announce; domain 24). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Timing: pauses 125ms after each marked packet before sending the next
// frame.
// Wireshark: ptp

host gnss_gm { ip 192.168.158.1 mac 00:80:ea:15:80:01 }

host gnodeb_ru { ip 192.168.158.10 mac 00:80:ea:15:80:0a }

flow ptp_announce_telecom(gm, ru) {
    gm -> ru ptp announce domain 24 seqid 501 clockid "GNSSGM01" wait 125ms
    gm -> ru ptp announce domain 24 seqid 502 clockid "GNSSGM01"
}

compile {
    ptp_announce_telecom(gnss_gm, gnodeb_ru)
}
