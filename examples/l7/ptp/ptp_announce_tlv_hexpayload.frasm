// PTP message carrying appended TLV management extension via HEXPAYLOAD.
// IEEE 1588v2 PTP (messages: announce; domain 4). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Wireshark: ptp

host tgm_node { ip 192.168.240.1 }

host tsc_node { ip 192.168.240.2 }

flow ptp_tlv_extension(gm, sc) {
    gm -> sc ptp announce domain 4 seqid 12 clockid "TGMNODE1" hexpayload "0008000401020304"
}

compile {
    ptp_tlv_extension(tgm_node, tsc_node)
}
