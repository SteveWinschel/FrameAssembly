// Create a PTPv2 Boundary Clock cascade where a spine switch grandmaster
// synchronizes a leaf switch on Domain 1.
// IEEE 1588v2 PTP (messages: announce, sync, followup; domain 1). UDP 319
// handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Timing: uses post-packet wait delays (2ms, 1ms) between frames.
// Wireshark: ptp

host ptp_grandmaster {
    ip 10.250.1.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 10.250.1.2
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 1 seqid 301 clockid "00163efffe010001" wait 2ms
    gm -> slv ptp sync domain 1 seqid 301 clockid "00163efffe010001" wait 1ms
    gm -> slv ptp followup domain 1 seqid 301 clockid "00163efffe010001"
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
