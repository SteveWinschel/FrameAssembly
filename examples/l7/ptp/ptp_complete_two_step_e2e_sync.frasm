// Complete 4-message IEEE 1588v2 E2E synchronization cycle (ANNOUNCE, SYNC,
// FOLLOW_UP, DELAY_REQ, DELAY_RESP).
// IEEE 1588v2 PTP (messages: announce, sync, followup, delayreq, delayresp;
// domain 0). UDP 319 handles Event messages (sync, delayreq) and UDP 320
// carries General messages (announce, followup, delayresp).
// Timing: uses post-packet wait delays (1ms, 2ms) between frames.
// Wireshark: ptp

host ptp_master { ip 10.158.0.1 mac 00:1b:21:aa:bb:01 }

host ptp_follower { ip 10.158.0.50 mac 00:1b:21:aa:bb:32 }

flow ptp_full_e2e_cycle(m, s) {
    m -> s ptp announce domain 0 seqid 10 clockid "MASTER01" wait 1ms
    m -> s ptp sync domain 0 seqid 10 clockid "MASTER01" wait 1ms
    m -> s ptp followup domain 0 seqid 10 clockid "MASTER01" wait 2ms
    m <- s ptp delayreq domain 0 seqid 10 clockid "SLAVE050" wait 1ms
    m -> s ptp delayresp domain 0 seqid 10 clockid "MASTER01"
}

compile {
    ptp_full_e2e_cycle(ptp_master, ptp_follower)
}
