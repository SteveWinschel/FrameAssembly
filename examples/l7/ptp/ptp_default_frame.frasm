// Minimal 2-block IEEE 1588v2 PTP starter emitting a default Sync frame on UDP port 319.
// Derives the ClockIdentity from the sender MAC and sends directly from the compile block.
// Use 'frameassembly show' to verify timestamps and port 319 Event framing.
// Wireshark: ptp

host grandmaster { ip 10.15.88.1 mac 00:1b:19:15:88:01 }
host slave_clock { ip 10.15.88.2 mac 00:1b:19:15:88:02 }

compile {
    grandmaster -> slave_clock ptp
}
