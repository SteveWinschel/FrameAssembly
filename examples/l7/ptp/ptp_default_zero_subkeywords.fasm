// PROMPT: Default IEEE 1588v2 PTP Sync frame with zero sub-keywords on UDP port 319.
// TOKENS: host, ip, mac, flow, ptp, compile

// INSTRUCTION: Define grandmaster clock endpoint.
host gm_clock { ip 10.15.88.1 mac 00:1b:19:15:88:01 }

// INSTRUCTION: Define boundary clock slave endpoint.
host bc_slave { ip 10.15.88.2 mac 00:1b:19:15:88:02 }

// INSTRUCTION: Define flow sending default PTP Sync packet.
flow ptp_default_sync(gm, slave) {
    gm -> slave ptp
}

// INSTRUCTION: Compile default PTP Sync scenario.
compile {
    ptp_default_sync(gm_clock, bc_slave)
}
