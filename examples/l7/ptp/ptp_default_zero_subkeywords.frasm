// Minimal 2-block IEEE 1588v2 PTP starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// UDP 319 handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Wireshark: ptp

host gm_clock { ip 10.15.88.1 mac 00:1b:19:15:88:01 }

host bc_slave { ip 10.15.88.2 mac 00:1b:19:15:88:02 }

compile {
    gm_clock -> bc_slave ptp
}
