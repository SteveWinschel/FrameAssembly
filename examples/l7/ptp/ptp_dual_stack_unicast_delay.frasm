// PROMPT: Dual-stack IPv4 and IPv6 unicast PTP Delay_Req and Delay_Resp timing exchange.
// TOKENS: host, ip, flow, ptp, delayreq, domain, seqid, dscp, ttl, flowlabel, delayresp, compile

// INSTRUCTION: Define IPv4 PTP slave and master endpoints.
host ptp_slave_v4 { ip 10.31.9.10 }
// INSTRUCTION: Define IPv4 PTP grandmaster endpoint.
host ptp_master_v4 { ip 10.31.9.1 }

// INSTRUCTION: Define IPv6 PTP slave and master endpoints.
host ptp_slave_v6 { ip 2001:db8:319::10 }
// INSTRUCTION: Define IPv6 PTP grandmaster endpoint.
host ptp_master_v6 { ip 2001:db8:319::1 }

// INSTRUCTION: Define polymorphic unicast PTP delay measurement flow.
flow ptp_unicast_delay(slave, master) {
    slave -> master ptp delayreq domain 0 seqid 42 dscp 46 ttl 64 flowlabel 0x31900
    slave <- master ptp delayresp domain 0 seqid 42 dscp 46 ttl 64 flowlabel 0x31900
}

// INSTRUCTION: Compile dual-stack unicast PTP delay flow.
compile {
    ptp_unicast_delay(ptp_slave_v4, ptp_master_v4)
    ptp_unicast_delay(ptp_slave_v6, ptp_master_v6)
}
