// Dual-stack IPv4 and IPv6 unicast PTP Delay_Req and Delay_Resp timing
// exchange.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Runs the same flow definition across both IPv4 and IPv6 host pairs.
// IEEE 1588v2 PTP (messages: delayreq, delayresp; domain 0). UDP 319 handles
// Event messages (sync, delayreq) and UDP 320 carries General messages
// (announce, followup, delayresp).
// Executes 2 sequential flow runs inside the compile block.
// Wireshark: ptp

host ptp_slave_v4 { ip 10.31.9.10 }
host ptp_master_v4 { ip 10.31.9.1 }

host ptp_slave_v6 { ip 2001:db8:319::10 }
host ptp_master_v6 { ip 2001:db8:319::1 }

flow ptp_unicast_delay(slave, master) {
    slave -> master ptp delayreq domain 0 seqid 42 dscp 46 ttl 64 flowlabel 0x31900
    slave <- master ptp delayresp domain 0 seqid 42 dscp 46 ttl 64 flowlabel 0x31900
}

compile {
    ptp_unicast_delay(ptp_slave_v4, ptp_master_v4)
    ptp_unicast_delay(ptp_slave_v6, ptp_master_v6)
}
