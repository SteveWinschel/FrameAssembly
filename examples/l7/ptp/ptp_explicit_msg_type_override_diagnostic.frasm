// Simulate a PTPv2 diagnostic probe using explicit MSG_TYPE string
// specification on Domain 15.
// IEEE 1588v2 PTP (domain 15). UDP 319 handles Event messages (sync,
// delayreq) and UDP 320 carries General messages (announce, followup,
// delayresp).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_grandmaster {
    ip 10.15.31.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 10.15.31.9
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp msgtype "sync" domain 15 seqid 701 clockid "001b21fffe0f0001" wait 2ms
    gm -> slv ptp msgtype "followup" domain 15 seqid 701 clockid "001b21fffe0f0001"
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
