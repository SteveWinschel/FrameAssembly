// Model a MiFID II high-frequency trading exchange PTPv2 grandmaster feeding
// an execution engine on Domain 10.
// Encapsulation and QoS markings: DSCP 46 (EF).
// IEEE 1588v2 PTP (messages: announce, sync, delayreq, delayresp; domain 10).
// UDP 319 handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_grandmaster {
    ip 10.31.10.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 10.31.10.99
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 10 seqid 9001 clockid "000f53fffe100001" dscp 46 wait 1ms
    gm -> slv ptp sync domain 10 seqid 9001 clockid "000f53fffe100001" dscp 46 wait 1ms
    gm <- slv ptp delayreq domain 10 seqid 9001 clockid "000f53fffe100099" dscp 46 wait 1ms
    gm -> slv ptp delayresp domain 10 seqid 9001 clockid "000f53fffe100001" dscp 46
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
