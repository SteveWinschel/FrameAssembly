// High-rate IEEE 1588v2 PTP Sync and Follow_Up pulse train across 5 cycles
// with 125us post-packet spacing.
// IEEE 1588v2 PTP (messages: sync, followup; domain 10). UDP 319 handles
// Event messages (sync, delayreq) and UDP 320 carries General messages
// (announce, followup, delayresp).
// Timing: runs 5 cycles in compile using post-packet waits (125us).
// Wireshark: ptp

host hft_gm { ip 10.1.158.1 mac 00:0f:53:15:80:01 }

host match_engine { ip 10.1.158.10 mac 00:0f:53:15:80:0a }

flow ptp_hft_pulse(gm, nic) {
    gm -> nic ptp sync domain 10 seqid 77 clockid "ATOMIC01" wait 125us
    gm -> nic ptp followup domain 10 seqid 77 clockid "ATOMIC01" wait 125us
}

compile {
    ptp_hft_pulse(hft_gm, match_engine) // cycle 1 of 5
    ptp_hft_pulse(hft_gm, match_engine) // cycle 2 of 5
    ptp_hft_pulse(hft_gm, match_engine) // cycle 3 of 5
    ptp_hft_pulse(hft_gm, match_engine) // cycle 4 of 5
    ptp_hft_pulse(hft_gm, match_engine) // cycle 5 of 5
}
