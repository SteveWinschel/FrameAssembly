// PROMPT: High-frequency 125us PTP Sync pulse train using COMPILE LOOP for sub-microsecond servo locking.
// TOKENS: host, ip, mac, flow, ptp, sync, domain, seqid, clockid, wait, us, followup, compile

// INSTRUCTION: Define HFT trading floor atomic grandmaster.
host hft_gm { ip 10.1.158.1 mac 00:0f:53:15:80:01 }

// INSTRUCTION: Define matching engine server NIC clock.
host match_engine { ip 10.1.158.10 mac 00:0f:53:15:80:0a }

// INSTRUCTION: Define rapid 125us Sync and Follow_Up pair.
flow ptp_hft_pulse(gm, nic) {
    gm -> nic ptp sync domain 10 seqid 77 clockid "ATOMIC01" wait 125us
    gm -> nic ptp followup domain 10 seqid 77 clockid "ATOMIC01" wait 125us
}

// INSTRUCTION: Execute 6 high-rate PTP sync cycles in COMPILE LOOP.
compile {
    ptp_hft_pulse(hft_gm, match_engine) // cycle 1 of 6
    ptp_hft_pulse(hft_gm, match_engine) // cycle 2 of 6
    ptp_hft_pulse(hft_gm, match_engine) // cycle 3 of 6
    ptp_hft_pulse(hft_gm, match_engine) // cycle 4 of 6
    ptp_hft_pulse(hft_gm, match_engine) // cycle 5 of 6
}
