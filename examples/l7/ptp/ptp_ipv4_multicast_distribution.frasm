// PROMPT: IPv4 multicast PTP Sync and Follow_Up distribution to 224.0.1.129 with RFC 1112 MAC auto-derivation.
// TOKENS: host, ip, mac, flow, ptp, sync, domain, seqid, dscp, ttl, wait, ms, followup, compile

// INSTRUCTION: Define PTP grandmaster clock source.
host ptp_gm_src { ip 172.16.158.1 mac 00:15:88:00:01:01 }

// INSTRUCTION: Define IANA IPv4 primary PTP multicast group 224.0.1.129.
host ptp_mcast_v4 { ip 224.0.1.129 }

// INSTRUCTION: Define multicast PTP Sync and Follow_Up with EF DSCP 46.
flow ptp_ipv4_multicast(gm, grp) {
    gm -> grp ptp sync domain 0 seqid 900 dscp 46 ttl 16 wait 2ms
    gm -> grp ptp followup domain 0 seqid 900 dscp 46 ttl 16
}

// INSTRUCTION: Compile IPv4 multicast PTP distribution.
compile {
    ptp_ipv4_multicast(ptp_gm_src, ptp_mcast_v4)
}
