// IPv4 multicast PTP Sync and Follow_Up distribution to 224.0.1.129 with RFC
// 1112 MAC auto-derivation.
// Encapsulation and QoS markings: DSCP 46 (EF).
// IEEE 1588v2 PTP (messages: sync, followup; domain 0). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_gm_src { ip 172.16.158.1 mac 00:15:88:00:01:01 }

host ptp_mcast_v4 { ip 224.0.1.129 }

flow ptp_ipv4_multicast(gm, grp) {
    gm -> grp ptp sync domain 0 seqid 900 dscp 46 ttl 16 wait 2ms
    gm -> grp ptp followup domain 0 seqid 900 dscp 46 ttl 16
}

compile {
    ptp_ipv4_multicast(ptp_gm_src, ptp_mcast_v4)
}
