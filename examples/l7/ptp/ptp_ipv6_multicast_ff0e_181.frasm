// IPv6 multicast PTP Sync and Announce to ff0e::181 with RFC 2464 multicast
// MAC derivation.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// IEEE 1588v2 PTP (messages: announce, sync; domain 1). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_gm_v6 { ip 2001:db8:1588::1 mac 00:15:88:06:00:01 }

host ptp_mcast_v6 { ip ff0e::181 }

flow ptp_ipv6_multicast(gm, mcast) {
    gm -> mcast ptp announce domain 1 seqid 201 clockid "GMV60001" dscp 46 ttl 64 flowlabel 0x15880 wait 5ms
    gm -> mcast ptp sync domain 1 seqid 201 clockid "GMV60001" dscp 46 ttl 64 flowlabel 0x15880
}

compile {
    ptp_ipv6_multicast(ptp_gm_v6, ptp_mcast_v6)
}
