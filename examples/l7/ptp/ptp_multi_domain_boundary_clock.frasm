// Multi-domain PTP boundary clock distributing Domain 0 and Domain 1 to
// separate followers.
// IEEE 1588v2 PTP (messages: sync, followup; domain 0, 1). UDP 319 handles
// Event messages (sync, delayreq) and UDP 320 carries General messages
// (announce, followup, delayresp).
// Timing: runs 2 cycles in compile using post-packet waits (1ms).
// Wireshark: ptp

host boundary_clk { ip 10.88.158.1 }

host dom0_slave { ip 10.88.158.11 }

host dom1_slave { ip 10.88.158.12 }

flow ptp_dom0_sync(bc, s0) {
    bc -> s0 ptp sync domain 0 seqid 15 clockid "BCLOCK00" wait 1ms
    bc -> s0 ptp followup domain 0 seqid 15 clockid "BCLOCK00"
}

flow ptp_dom1_sync(bc, s1) {
    bc -> s1 ptp sync domain 1 seqid 85 clockid "BCLOCK01" wait 1ms
    bc -> s1 ptp followup domain 1 seqid 85 clockid "BCLOCK01"
}

compile {
    ptp_dom0_sync(boundary_clk, dom0_slave)
    ptp_dom1_sync(boundary_clk, dom1_slave)
}
