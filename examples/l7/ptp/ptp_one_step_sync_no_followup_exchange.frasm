// Model a hardware-timestamped one-step PTPv2 SYNC and DELAY_REQ/DELAY_RESP
// exchange without FOLLOW_UP frames.
// IEEE 1588v2 PTP (messages: sync, delayreq, delayresp; domain 0). UDP 319
// handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_grandmaster {
    ip 172.29.31.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 172.29.31.40
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp sync domain 0 seqid 3301 clockid "0002c9fffe310001" wait 2ms
    gm <- slv ptp delayreq domain 0 seqid 3301 clockid "0002c9fffe310028" wait 2ms
    gm -> slv ptp delayresp domain 0 seqid 3301 clockid "0002c9fffe310001"
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
