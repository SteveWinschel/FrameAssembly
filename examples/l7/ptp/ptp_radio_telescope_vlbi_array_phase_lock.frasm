// PROMPT: Generate a radio astronomy antenna array PTPv2 white-rabbit sub-nanosecond phase sync trace on Domain 8.
// TOKENS: host, ip, mac, flow, ptp, sync, domain, seqid, clockid, dscp, wait, ms, followup, delayreq, delayresp, compile

// INSTRUCTION: Define the IEEE 1588v2 PTP Grandmaster clock endpoint.
host ptp_grandmaster {
    ip 10.8.158.1
    mac 00:1b:21:31:90:01
}

// INSTRUCTION: Define the IEEE 1588v2 PTP Ordinary or Boundary slave clock endpoint.
host ptp_slave_clock {
    ip 10.8.158.16
    mac 00:1b:21:31:90:25
}

// INSTRUCTION: Execute the IEEE 1588v2 Precision Time Protocol message exchange.
flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp sync domain 8 seqid 19001 clockid "0026b9fffe080001" dscp 56 wait 1ms
    gm -> slv ptp followup domain 8 seqid 19001 clockid "0026b9fffe080001" dscp 56 wait 1ms
    gm <- slv ptp delayreq domain 8 seqid 19001 clockid "0026b9fffe080010" dscp 56 wait 1ms
    gm -> slv ptp delayresp domain 8 seqid 19001 clockid "0026b9fffe080001" dscp 56
}

// INSTRUCTION: Compile the PTPv2 timing synchronization flow into a PCAP file.
compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
