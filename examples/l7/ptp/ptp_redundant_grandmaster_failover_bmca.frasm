// Simulate a Best Master Clock Algorithm (BMCA) failover between primary and
// standby PTPv2 grandmasters.
// IEEE 1588v2 PTP (messages: announce, sync; domain 0). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_grandmaster {
    ip 192.168.158.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 192.168.158.2
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 0 seqid 101 clockid "001b21fffeaa0001" wait 5ms
    gm <- slv ptp announce domain 0 seqid 201 clockid "001b21fffeaa0002" wait 5ms
    gm <- slv ptp sync domain 0 seqid 202 clockid "001b21fffeaa0002"
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
