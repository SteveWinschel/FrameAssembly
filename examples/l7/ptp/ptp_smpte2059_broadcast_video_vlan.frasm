// SMPTE ST 2059-2 broadcast video studio PTP synchronization on Domain 127
// with VLAN priority 7.
// Encapsulation and QoS markings: 802.1Q VLAN 127, 802.1p priority 7, DSCP 46
// (EF).
// IEEE 1588v2 PTP (messages: sync, followup, delayreq, delayresp; domain
// 127). UDP 319 handles Event messages (sync, delayreq) and UDP 320 carries
// General messages (announce, followup, delayresp).
// Timing: uses post-packet wait delays (1ms, 2ms) between frames.
// Wireshark: ptp && vlan.id == 127

host studio_gm { ip 192.168.127.1 mac 00:1c:cb:7f:00:01 }

host ip_camera { ip 192.168.127.25 mac 00:1c:cb:7f:00:19 }

flow ptp_smpte2059_studio(gm, cam) {
    gm -> cam ptp sync domain 127 seqid 1024 clockid "SMPTEGM1" vlan 127 pcp 7 dei 0 dscp 46 wait 1ms
    gm -> cam ptp followup domain 127 seqid 1024 clockid "SMPTEGM1" vlan 127 pcp 7 dei 0 dscp 46 wait 2ms
    gm <- cam ptp delayreq domain 127 seqid 1024 clockid "CAM4K025" vlan 127 pcp 7 dei 0 dscp 46 wait 1ms
    gm -> cam ptp delayresp domain 127 seqid 1024 clockid "SMPTEGM1" vlan 127 pcp 7 dei 0 dscp 46
}

compile {
    ptp_smpte2059_studio(studio_gm, ip_camera)
}
