// PROMPT: Create a SMPTE ST 2059-2 broadcast television genlock PTPv2 synchronization flow on default Domain 127.
// TOKENS: HOST, IP, MAC, FLOW, PTP, ANNOUNCE, DOMAIN, SEQ_ID, CLOCK_ID, DSCP, WAIT, SYNC, FOLLOW_UP, COMPILE

// INSTRUCTION: Define the IEEE 1588v2 PTP Grandmaster clock endpoint.
HOST ptp_grandmaster {
    IP 10.127.31.1
    MAC 00:1b:21:31:90:01
}

// INSTRUCTION: Define the IEEE 1588v2 PTP Ordinary or Boundary slave clock endpoint.
HOST ptp_slave_clock {
    IP 10.127.31.88
    MAC 00:1b:21:31:90:25
}

// INSTRUCTION: Execute the IEEE 1588v2 Precision Time Protocol message exchange.
FLOW ptp_scenario_flow(gm, slv) {
    gm -> slv PTP ANNOUNCE DOMAIN 127 SEQ_ID 5001 CLOCK_ID "001a6bfffe7f0001" DSCP 46 WAIT 1ms
    gm -> slv PTP SYNC DOMAIN 127 SEQ_ID 5001 CLOCK_ID "001a6bfffe7f0001" DSCP 46 WAIT 1ms
    gm -> slv PTP FOLLOW_UP DOMAIN 127 SEQ_ID 5001 CLOCK_ID "001a6bfffe7f0001" DSCP 46
}

// INSTRUCTION: Compile the PTPv2 timing synchronization flow into a PCAP file.
COMPILE {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
