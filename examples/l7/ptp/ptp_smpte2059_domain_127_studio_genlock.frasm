// Create a SMPTE ST 2059-2 broadcast television genlock PTPv2 synchronization
// flow on default Domain 127.
// Encapsulation and QoS markings: DSCP 46 (EF).
// IEEE 1588v2 PTP (messages: announce, sync, followup; domain 127). UDP 319
// handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: ptp

host ptp_grandmaster {
    ip 10.127.31.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 10.127.31.88
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 127 seqid 5001 clockid "001a6bfffe7f0001" dscp 46 wait 1ms
    gm -> slv ptp sync domain 127 seqid 5001 clockid "001a6bfffe7f0001" dscp 46 wait 1ms
    gm -> slv ptp followup domain 127 seqid 5001 clockid "001a6bfffe7f0001" dscp 46
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
