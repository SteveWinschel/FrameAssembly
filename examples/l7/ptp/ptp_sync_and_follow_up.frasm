// IEEE 1588 Precision Time Protocol master clock Sync and Follow_Up messages.
// IEEE 1588v2 PTP (messages: sync, followup; domain 0). UDP 319 handles Event
// messages (sync, delayreq) and UDP 320 carries General messages (announce,
// followup, delayresp).
// Wireshark: ptp

host client { ip 10.0.0.2 }

host server { ip 10.0.0.1 }

flow ptp_master(c, s) {
    c <- s ptp sync seqid 100 domain 0
    c <- s ptp followup seqid 100 domain 0
}

compile {
    ptp_master(client, server)
}
