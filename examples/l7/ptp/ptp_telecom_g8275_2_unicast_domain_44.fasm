// PROMPT: Model an ITU-T G.8275.2 telecom profile unicast PTPv2 phase synchronization exchange on Domain 44.
// TOKENS: host, ip, mac, flow, ptp, announce, domain, seqid, clockid, dscp, wait, ms, sync, followup, compile

// INSTRUCTION: Define the IEEE 1588v2 PTP Grandmaster clock endpoint.
host ptp_grandmaster {
    ip 172.22.44.1
    mac 00:1b:21:31:90:01
}

// INSTRUCTION: Define the IEEE 1588v2 PTP Ordinary or Boundary slave clock endpoint.
host ptp_slave_clock {
    ip 172.22.44.50
    mac 00:1b:21:31:90:25
}

// INSTRUCTION: Execute the IEEE 1588v2 Precision Time Protocol message exchange.
flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 44 seqid 8801 clockid "002590fffe440001" dscp 46 wait 2ms
    gm -> slv ptp sync domain 44 seqid 8801 clockid "002590fffe440001" dscp 46 wait 1ms
    gm -> slv ptp followup domain 44 seqid 8801 clockid "002590fffe440001" dscp 46
}

// INSTRUCTION: Compile the PTPv2 timing synchronization flow into a PCAP file.
compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
