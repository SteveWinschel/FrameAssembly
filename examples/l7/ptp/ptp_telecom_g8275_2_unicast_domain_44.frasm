// Model an ITU-T G.8275.2 telecom profile unicast PTPv2 phase synchronization
// exchange on Domain 44.
// Encapsulation and QoS markings: DSCP 46 (EF).
// IEEE 1588v2 PTP (messages: announce, sync, followup; domain 44). UDP 319
// handles Event messages (sync, delayreq) and UDP 320 carries General
// messages (announce, followup, delayresp).
// Timing: uses post-packet wait delays (2ms, 1ms) between frames.
// Wireshark: ptp

host ptp_grandmaster {
    ip 172.22.44.1
    mac 00:1b:21:31:90:01
}

host ptp_slave_clock {
    ip 172.22.44.50
    mac 00:1b:21:31:90:25
}

flow ptp_scenario_flow(gm, slv) {
    gm -> slv ptp announce domain 44 seqid 8801 clockid "002590fffe440001" dscp 46 wait 2ms
    gm -> slv ptp sync domain 44 seqid 8801 clockid "002590fffe440001" dscp 46 wait 1ms
    gm -> slv ptp followup domain 44 seqid 8801 clockid "002590fffe440001" dscp 46
}

compile {
    ptp_scenario_flow(ptp_grandmaster, ptp_slave_clock)
}
