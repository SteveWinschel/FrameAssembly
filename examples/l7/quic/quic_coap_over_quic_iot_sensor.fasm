// PROMPT: RFC 9175 CoAP over QUIC constrained IoT sensor telemetry over UDP port 5684.
// TOKENS: HOST, IP, FLOW, QUIC, INITIAL, VERSION, DCID, SCID, SRCPORT, DSTPORT, PKT_NUM, WAIT, HANDSHAKE, SHORT, PAYLOAD, COMPILE

// INSTRUCTION: Define smart grid meter IoT endpoint.
HOST grid_meter {
    IP 10.105.4.88
}

// INSTRUCTION: Define utility headend CoAP-over-QUIC server on port 5684.
HOST headend_srv {
    IP 10.105.4.1
}

// INSTRUCTION: Define CoAP over QUIC handshake and meter reading POST on UDP port 5684.
FLOW quic_coap_5684(c, s) {
    c -> s QUIC INITIAL VERSION 1 DCID 0x56840001 SCID 0x56840002 SRCPORT 45684 DSTPORT 5684 PKT_NUM 1 WAIT 6ms
    c <- s QUIC HANDSHAKE VERSION 1 DCID 0x56840002 SCID 0x56840003 SRCPORT 5684 DSTPORT 45684 PKT_NUM 1 WAIT 6ms
    c -> s QUIC SHORT DCID 0x56840003 SRCPORT 45684 DSTPORT 5684 PKT_NUM 2 PAYLOAD "COAP_POST_KWH_412" WAIT 6ms
    c <- s QUIC SHORT DCID 0x56840002 SRCPORT 5684 DSTPORT 45684 PKT_NUM 2 PAYLOAD "COAP_204_CHANGED"
}

// INSTRUCTION: Compile the CoAP over QUIC port 5684 flow.
COMPILE {
    quic_coap_5684(grid_meter, headend_srv)
}
