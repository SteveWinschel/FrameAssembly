// PROMPT: RFC 9175 CoAP over QUIC constrained IoT sensor telemetry over UDP port 5684.
// TOKENS: host, ip, flow, s, quic, initial, version, dcid, scid, srcport, dstport, pktnum, wait, ms, handshake, short, payload, compile

// INSTRUCTION: Define smart grid meter IoT endpoint.
host grid_meter {
    ip 10.105.4.88
}

// INSTRUCTION: Define utility headend CoAP-over-QUIC server on port 5684.
host headend_srv {
    ip 10.105.4.1
}

// INSTRUCTION: Define CoAP over QUIC handshake and meter reading POST on UDP port 5684.
flow quic_coap_5684(c, s) {
    c -> s quic initial version 1 dcid 0x56840001 scid 0x56840002 srcport 45684 dstport 5684 pktnum 1 wait 6ms
    c <- s quic handshake version 1 dcid 0x56840002 scid 0x56840003 srcport 5684 dstport 45684 pktnum 1 wait 6ms
    c -> s quic short dcid 0x56840003 srcport 45684 dstport 5684 pktnum 2 payload "COAP_POST_KWH_412" wait 6ms
    c <- s quic short dcid 0x56840002 srcport 5684 dstport 45684 pktnum 2 payload "COAP_204_CHANGED"
}

// INSTRUCTION: Compile the CoAP over QUIC port 5684 flow.
compile {
    quic_coap_5684(grid_meter, headend_srv)
}
