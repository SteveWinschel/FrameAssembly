// QUIC CONNECTION_CLOSE frame encoded in 1-RTT Short header terminating
// session.
// QUIC UDP 443 packet types: short.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: quic

host web_client { ip 192.168.144.20 }

host web_server { ip 192.168.144.1 }

flow quic_conn_close(c, s) {
    c -> s quic short dcid 0x55443322 pktnum 50 hexpayload "1c000000" wait 2ms
    c <- s quic short dcid 0x22334455 pktnum 60 hexpayload "1c000000"
}

compile {
    quic_conn_close(web_client, web_server)
}
