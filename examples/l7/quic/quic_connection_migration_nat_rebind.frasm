// QUIC connection migration across client NAT rebinding with updated source
// port.
// QUIC UDP 443 packet types: short.
// Overrides destination port to 443.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: quic

host roaming_ep { ip 192.168.60.25 }

host stream_srv { ip 192.168.60.1 }

flow quic_port_migration(c, s) {
    c -> s quic short dcid 0xdeadbeef pktnum 10 srcport 51000 dstport 443 payload "PATH_ACTIVE" wait 5ms
    c -> s quic short dcid 0xdeadbeef pktnum 11 srcport 62000 dstport 443 payload "PATH_CHALLENGE" wait 5ms
    c <- s quic short dcid 0xcafebabe pktnum 20 srcport 443 dstport 62000 payload "PATH_RESPONSE"
}

compile {
    quic_port_migration(roaming_ep, stream_srv)
}
