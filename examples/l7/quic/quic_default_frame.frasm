// Minimal 2-block QUIC starter sending a default RFC 9000 Initial packet on UDP port 443.
// Variable-length integers and connection IDs are populated automatically without a flow block.
// Compile to verify UDP 443 firewall pinholes or QUIC dissector rules.
// Wireshark: quic

host mobile_client { ip 192.0.2.50 mac 00:1a:2b:44:00:32 }
host edge_cdn      { ip 198.51.100.10 mac 00:1a:2b:44:00:0a }

compile {
    mobile_client -> edge_cdn quic
}
