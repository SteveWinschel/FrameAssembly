// Minimal 2-block QUIC (RFC 9000 / 9369) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// QUIC UDP 443.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (QUIC (RFC
// 9000 / 9369), UDP 443).
// Wireshark: quic

host h3_browser { ip 192.168.1.40 mac 00:1a:11:01:00:28 }

host cdn_edge { ip 198.51.100.10 mac 00:1a:11:64:00:0a }

compile {
    h3_browser -> cdn_edge quic
}
