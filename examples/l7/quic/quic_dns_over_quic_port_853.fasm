// PROMPT: DNS over QUIC (DoQ) RFC 9250 query and response on dedicated UDP port 853.
// TOKENS: HOST, IP, FLOW, QUIC, INITIAL, DCID, SCID, PKT_NUM, SRCPORT, DSTPORT, WAIT, HANDSHAKE, SHORT, HEXPAYLOAD, COMPILE

// INSTRUCTION: Define stub resolver using DNS over QUIC.
HOST doq_stub { IP 192.168.85.10 }

// INSTRUCTION: Define recursive DoQ resolver on UDP port 853.
HOST doq_resolver { IP 192.168.85.1 }

// INSTRUCTION: Define QUIC session on port 853 carrying encrypted DNS frames.
FLOW doq_port_853(c, s) {
    c -> s QUIC INITIAL DCID 0x08530001 SCID 0x08530002 PKT_NUM 1 SRCPORT 55853 DSTPORT 853 WAIT 3ms
    c <- s QUIC HANDSHAKE DCID 0x08530002 SCID 0x08530001 PKT_NUM 1 SRCPORT 853 DSTPORT 55853 WAIT 3ms
    c -> s QUIC SHORT DCID 0x08530001 PKT_NUM 2 SRCPORT 55853 DSTPORT 853 HEXPAYLOAD "061a2b3c4d5e6f" WAIT 3ms
    c <- s QUIC SHORT DCID 0x08530002 PKT_NUM 2 SRCPORT 853 DSTPORT 55853 HEXPAYLOAD "069a8b7c6d5e4f"
}

// INSTRUCTION: Compile DNS over QUIC (DoQ) port 853 flow.
COMPILE {
    doq_port_853(doq_stub, doq_resolver)
}
