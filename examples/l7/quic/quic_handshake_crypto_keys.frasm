// QUIC Handshake packet establishing 1-RTT cryptographic context over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// QUIC UDP 443 packet types: handshake.
// Wireshark: quic

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow quic_hs(c, s) {
    c -> s quic handshake dcid 0x11223344 scid 0x55667788
    c <- s quic handshake dcid 0x55667788 scid 0x11223344
}

compile {
    quic_hs(client, server)
}
