// QUIC and HTTP/3 connection establishment on UDP 443 with Initial and Short
// header framing.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// QUIC UDP 443 packet types: initial, short.
// Wireshark: quic

host quic_client { ip 2001:db8:8888::1 }

host quic_server { ip 2001:db8:8888::2 }

flow quic_flow(c, s) {
    c -> s quic initial dcid 0x01020304 scid 0x05060708
    c <- s quic initial dcid 0x05060708 scid 0x01020304
    c -> s quic short dcid 0x05060708
}

compile {
    quic_flow(quic_client, quic_server)
}
