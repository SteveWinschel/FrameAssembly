// RFC 9000 QUIC Initial packet establishing connection state with DCID and
// SCID.
// QUIC UDP 443 packet types: initial.
// Wireshark: quic

host client { ip 192.168.1.100 }

host server { ip 198.51.100.1 }

flow quic_init(c, s) {
    c -> s quic initial dcid 0x01020304 scid 0x05060708
}

compile {
    quic_init(client, server)
}
