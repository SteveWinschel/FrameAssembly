// PROMPT: MASQUE (RFC 9298) CONNECT-UDP proxy tunnel over QUIC Short header datagrams on port 8443.
// TOKENS: host, ip, flow, s, quic, initial, version, dcid, scid, srcport, dstport, pktnum, wait, ms, short, hexpayload, compile

// INSTRUCTION: Define privacy relay client establishing MASQUE tunnel.
host masque_client {
    ip 10.88.77.12
}

// INSTRUCTION: Define MASQUE oblivious HTTP/3 proxy server on port 8443.
host masque_proxy {
    ip 10.88.77.1
}

// INSTRUCTION: Define QUIC setup and HTTP/3 Datagram capsule tunneling UDP payload.
flow quic_masque_tunnel(c, s) {
    c -> s quic initial version 1 dcid 0x777788889999aaaa scid 0x1111222233334444 srcport 58443 dstport 8443 pktnum 1 wait 4ms
    c -> s quic short dcid 0x777788889999aaaa srcport 58443 dstport 8443 pktnum 2 hexpayload "004500001c" wait 4ms
    c <- s quic short dcid 0x1111222233334444 srcport 8443 dstport 58443 pktnum 1 hexpayload "0045000020"
}

// INSTRUCTION: Compile the MASQUE CONNECT-UDP over QUIC scenario.
compile {
    quic_masque_tunnel(masque_client, masque_proxy)
}
