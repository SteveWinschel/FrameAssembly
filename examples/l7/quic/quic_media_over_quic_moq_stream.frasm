// PROMPT: Media over QUIC (MoQ) live video relay streaming high-priority datagrams over UDP port 4433.
// TOKENS: host, ip, flow, s, quic, short, dcid, pktnum, srcport, dstport, dscp, hexpayload, wait, ms, compile

// INSTRUCTION: Define live broadcast encoder MoQ publisher host.
host moq_encoder {
    ip 10.140.10.25
}

// INSTRUCTION: Define Media over QUIC CDN relay server host.
host moq_relay {
    ip 10.140.10.1
}

// INSTRUCTION: Define 1-RTT Short header MoQ media object transmission on port 4433.
flow quic_moq_chunk(c, s) {
    c -> s quic short dcid 0x4d6f513030303031 pktnum 100 srcport 54433 dstport 4433 dscp 34 hexpayload "0001020304050607" wait 5ms
    c <- s quic short dcid 0x456e633030303031 pktnum 200 srcport 4433 dstport 54433 dscp 34 hexpayload "02000064"
}

// INSTRUCTION: Compile 3 iterations of Media over QUIC frame transmission.
compile {
    quic_moq_chunk(moq_encoder, moq_relay) // cycle 1
    quic_moq_chunk(moq_encoder, moq_relay) // cycle 2
    quic_moq_chunk(moq_encoder, moq_relay) // cycle 3
}
