// Multipath QUIC client probing primary Wi-Fi path and secondary cellular LTE
// path to server.
// QUIC UDP 443 packet types: short.
// Timing: runs 2 cycles in compile using post-packet waits (3ms).
// Wireshark: quic

host client_wifi {
    ip 192.168.10.80
}

host client_lte {
    ip 192.168.10.81
}

host mpquic_srv {
    ip 192.168.10.1
}

flow mpquic_subflow(c, s) {
    c -> s quic short dcid 0xaaaa111122223333 pktnum 10 payload "MP_PATH_CHALLENGE" wait 3ms
    c <- s quic short dcid 0xbbbb111122223333 pktnum 20 payload "MP_PATH_RESPONSE"
}

compile {
    mpquic_subflow(client_wifi, mpquic_srv)
    mpquic_subflow(client_lte, mpquic_srv)
}
