// PROMPT: QUIC Initial datagram with IPv4 Don't Fragment (DF) flag for PMTU discovery.
// TOKENS: host, ip, flow, s, quic, initial, dcid, scid, pktnum, df, ipid, ttl, payload, wait, ms, short, compile

// INSTRUCTION: Define QUIC client probing path MTU.
host pmtu_client { ip 10.140.0.10 }

// INSTRUCTION: Define QUIC origin server.
host origin_srv { ip 10.140.0.1 }

// INSTRUCTION: Define QUIC frames with DF bit set and explicit IPID values.
flow quic_pmtu_df(c, s) {
    c -> s quic initial dcid 0x44556677 scid 0x8899aabb pktnum 1 df ipid 1001 ttl 64 payload "PADDING_1200_CHECK" wait 5ms
    c <- s quic short dcid 0x8899aabb pktnum 1 df ipid 2001 ttl 64 payload "PMTU_ACK_OK"
}

// INSTRUCTION: Compile QUIC PMTU discovery with DF flag.
compile {
    quic_pmtu_df(pmtu_client, origin_srv)
}
