// Carrier backbone QUIC transport encapsulated in QinQ VLANs and MPLS label
// stack.
// Encapsulation and QoS markings: 802.1ad QinQ outer 2000 / inner 443, MPLS
// label 44301, 44302.
// QUIC UDP 443 packet types: initial, short.
// Wireshark: (quic && vlan) && mpls

host sub_cpe { ip 100.64.10.50 }

host carrier_cdn { ip 100.64.1.10 }

flow quic_carrier_mpls(c, s) {
    c -> s quic initial dcid 0xabcdef01 scid 0x12345678 pktnum 1 qinq 2000 innervlan 443 mpls 44301 exp 4 bos 1 mplsttl 64
    c <- s quic short dcid 0x12345678 pktnum 2 qinq 2000 innervlan 443 mpls 44302 exp 4 bos 1 mplsttl 63
}

compile {
    quic_carrier_mpls(sub_cpe, carrier_cdn)
}
