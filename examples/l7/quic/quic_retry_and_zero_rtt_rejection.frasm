// QUIC server rejecting unvalidated 0-RTT attempt with RETRY token before
// completing 1-RTT setup.
// QUIC UDP 443 (v1) packet types: initial, zerortt, handshake, retry, short.
// Timing: uses post-packet wait delays (1ms, 4ms) between frames.
// Wireshark: quic

host opt_client {
    ip 10.12.88.33
}

host strict_quic_srv {
    ip 10.12.88.1
}

flow quic_retry_0rtt(c, s) {
    c -> s quic initial version 1 dcid 0x11110000 scid 0x22220000 pktnum 1 wait 1ms
    c -> s quic zerortt version 1 dcid 0x11110000 scid 0x22220000 pktnum 2 wait 4ms
    c <- s quic retry version 1 dcid 0x22220000 scid 0x33330000 token "addr_valid_token_abc" wait 4ms
    c -> s quic initial version 1 dcid 0x33330000 scid 0x22220000 token "addr_valid_token_abc" pktnum 3 wait 4ms
    c <- s quic handshake version 1 dcid 0x22220000 scid 0x33330000 pktnum 1 wait 4ms
    c -> s quic short dcid 0x33330000 pktnum 4
}

compile {
    quic_retry_0rtt(opt_client, strict_quic_srv)
}
