// PROMPT: Geostationary satellite link QUIC connection maintaining NAT state with periodic PING frames.
// TOKENS: host, ip, flow, s, quic, short, dcid, pktnum, ttl, hexpayload, wait, ms, compile

// INSTRUCTION: Define remote maritime vessel satellite terminal.
host vessel_term {
    ip 10.220.50.10
}

// INSTRUCTION: Define shore station QUIC gateway.
host shore_gw {
    ip 10.220.50.1
}

// INSTRUCTION: Define QUIC 1-RTT PING frame (0x01) and ACK frame (0x02) over high-hop satellite link.
flow quic_sat_ping(c, s) {
    c -> s quic short dcid 0x5a7e1117e0000001 pktnum 77 ttl 128 hexpayload "01" wait 20ms
    c <- s quic short dcid 0x5a7e1117e0000002 pktnum 88 ttl 128 hexpayload "02004d0000"
}

// INSTRUCTION: Compile 3 iterations of satellite QUIC keepalive pings.
compile {
    quic_sat_ping(vessel_term, shore_gw) // cycle 1
    quic_sat_ping(vessel_term, shore_gw) // cycle 2
    quic_sat_ping(vessel_term, shore_gw) // cycle 3
}
