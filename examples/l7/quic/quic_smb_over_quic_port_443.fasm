// PROMPT: Windows Server SMB over QUIC encrypted file share access over UDP port 443 across WAN.
// TOKENS: host, ip, flow, s, quic, initial, version, dcid, scid, pktnum, wait, ms, handshake, short, payload, compile

// INSTRUCTION: Define remote branch workstation accessing SMB over QUIC share.
host smb_quic_client {
    ip 172.18.40.55
}

// INSTRUCTION: Define Windows File Server with SMB over QUIC enabled.
host smb_quic_server {
    ip 172.18.40.1
}

// INSTRUCTION: Define QUIC handshake followed by encrypted SMB3 TreeConnect in Short header packet.
flow quic_smb_session(c, s) {
    c -> s quic initial version 1 dcid 0x534d423300000001 scid 0x434c4e5400000001 pktnum 1 wait 4ms
    c <- s quic handshake version 1 dcid 0x434c4e5400000001 scid 0x5352565200000001 pktnum 1 wait 4ms
    c -> s quic short dcid 0x5352565200000001 pktnum 2 payload "ENC_SMB2_NEGOTIATE" wait 4ms
    c <- s quic short dcid 0x434c4e5400000001 pktnum 2 payload "ENC_SMB2_SESSION_SETUP"
}

// INSTRUCTION: Compile the SMB over QUIC file sharing flow.
compile {
    quic_smb_session(smb_quic_client, smb_quic_server)
}
