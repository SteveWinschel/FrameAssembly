// Server reboot triggering QUIC stateless reset token response to stale Short
// header packet.
// QUIC UDP 443 (v1) packet types: initial, short.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: quic

host stale_client {
    ip 192.168.122.45
}

host rebooted_srv {
    ip 192.168.122.1
}

flow quic_stateless_reset(c, s) {
    c -> s quic short dcid 0x0102030405060708 pktnum 99 hexpayload "080010" wait 4ms
    c <- s quic short dcid 0x0102030405060708 pktnum 0 hexpayload "ffffffffffffffffffffffffffffffff" wait 4ms
    c -> s quic initial version 1 dcid 0x9988776655443322 scid 0x2233445566778899 pktnum 1
}

compile {
    quic_stateless_reset(stale_client, rebooted_srv)
}
