// QUIC traffic over enterprise VLAN 443 with ECN Capable Transport (ECN 2)
// marking.
// Encapsulation and QoS markings: 802.1Q VLAN 443, 802.1p priority 4, DSCP
// 32.
// QUIC UDP 443 packet types: initial, handshake, short.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: quic && vlan.id == 443

host corp_ws { ip 172.22.43.10 mac 00:25:90:43:00:0a }

host corp_portal { ip 172.22.43.1 mac 00:25:90:43:00:01 }

flow quic_vlan_ecn(c, s) {
    c -> s quic initial dcid 0x10002000 scid 0x30004000 pktnum 1 vlan 443 pcp 4 dei 0 dscp 32 ecn 2 wait 4ms
    c <- s quic handshake dcid 0x30004000 scid 0x10002000 pktnum 1 vlan 443 pcp 4 dei 0 dscp 32 ecn 2 wait 4ms
    c -> s quic short dcid 0x10002000 pktnum 2 vlan 443 pcp 4 dei 0 dscp 32 ecn 2
}

compile {
    quic_vlan_ecn(corp_ws, corp_portal)
}
