// PROMPT: RADIUS Access-Request rejected with Access-Reject for expired contractor credentials.
// TOKENS: host, ip, flow, radius, accessrequest, user, nasip, servicetype, wait, ms, accessreject, compile

// INSTRUCTION: Define VPN concentrator NAS endpoint.
host vpn_gw { ip 172.16.18.10 }

// INSTRUCTION: Define central RADIUS authentication server.
host aaa_srv { ip 172.16.18.1 }

// INSTRUCTION: Define Access-Request and Access-Reject exchange.
flow radius_reject_flow(nas, srv) {
    nas -> srv radius accessrequest user "contractor_expired" nasip 172.16.18.10 servicetype 2 wait 8ms
    nas <- srv radius accessreject user "contractor_expired"
}

// INSTRUCTION: Compile RADIUS Access-Reject flow.
compile {
    radius_reject_flow(vpn_gw, aaa_srv)
}
