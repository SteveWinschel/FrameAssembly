// RADIUS Access-Request rejected with Access-Reject for expired contractor
// credentials.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessreject) with Service-Type 2 (Framed (802.1X)).
// Timing: pauses 8ms after each marked packet before sending the next frame.
// Wireshark: radius

host vpn_gw { ip 172.16.18.10 }

host aaa_srv { ip 172.16.18.1 }

flow radius_reject_flow(nas, srv) {
    nas -> srv radius accessrequest user "contractor_expired" nasip 172.16.18.10 servicetype 2 wait 8ms
    nas <- srv radius accessreject user "contractor_expired"
}

compile {
    radius_reject_flow(vpn_gw, aaa_srv)
}
