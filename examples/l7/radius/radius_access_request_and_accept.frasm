// RADIUS network access authentication exchange with Access-Request and
// Access-Accept.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept).
// Wireshark: radius

host client { ip 10.0.0.10 }

host server { ip 10.0.0.1 }

flow radius_auth(c, s) {
    c -> s radius accessrequest user "alice" nasip 10.0.0.10
    c <- s radius accessaccept
}

compile {
    radius_auth(client, server)
}
