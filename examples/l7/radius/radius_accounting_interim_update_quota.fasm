// PROMPT: Model a mobile gateway sending periodic RADIUS Accounting-Request interim updates on UDP port 1813.
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCOUNTING_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, FRAMED_IP, PAYLOAD, WAIT, ACCOUNTING_RESPONSE, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 10.181.3.10
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 10.181.3.200
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCOUNTING_REQUEST ID 106 USER "lte_imsi_310260991" NAS_IP 10.181.3.10 SERVICE_TYPE 2 FRAMED_IP 100.96.44.19 PAYLOAD "Acct-Status-Type=Interim-Update" WAIT 4ms
    nas <- srv RADIUS ACCOUNTING_RESPONSE ID 106 USER "lte_imsi_310260991" NAS_IP 10.181.3.10
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
