// Model a mobile gateway sending periodic RADIUS Accounting-Request interim
// updates on UDP port 1813.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting
// (accountingrequest, accountingresponse) with Service-Type 2 (Framed
// (802.1X)).
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 10.181.3.10
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 10.181.3.200
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accountingrequest id 106 user "lte_imsi_310260991" nasip 10.181.3.10 servicetype 2 framedip 100.96.44.19 payload "Acct-Status-Type=Interim-Update" wait 4ms
    nas <- srv radius accountingresponse id 106 user "lte_imsi_310260991" nasip 10.181.3.10
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
