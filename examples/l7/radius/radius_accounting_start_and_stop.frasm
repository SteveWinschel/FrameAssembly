// RADIUS session accounting request with Service-Type attribute over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting
// (accountingrequest, accountingresponse) with Service-Type 2 (Framed
// (802.1X)).
// Wireshark: radius

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow radius_acct(c, s) {
    c -> s radius accountingrequest user "bob" servicetype 2
    c <- s radius accountingresponse
}

compile {
    radius_acct(client, server)
}
