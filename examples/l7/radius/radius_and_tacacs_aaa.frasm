// Authentication, Authorization, and Accounting signaling with RADIUS
// Access-Request and TACACS+ Authen.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest).
// Wireshark: radius || tacplus

host nas_client { ip 172.16.10.1 }

host aaa_server { ip 172.16.10.2 }

flow aaa_flow(c, s) {
    c -> s radius accessrequest user "operator"
    c -> s tacacs authen user "admin"
}

compile {
    aaa_flow(nas_client, aaa_server)
}
