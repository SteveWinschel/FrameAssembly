// Simulate a hotel captive portal WLC validating a conference guest voucher
// code via RADIUS.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 1 (Login).
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 192.168.180.2
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 192.168.180.10
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 111 user "CONF-2026-VIP-881" nasip 192.168.180.2 servicetype 1 wait 3ms
    nas <- srv radius accessaccept id 111 user "CONF-2026-VIP-881" nasip 192.168.180.2 servicetype 1 framedip 192.168.184.55
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
