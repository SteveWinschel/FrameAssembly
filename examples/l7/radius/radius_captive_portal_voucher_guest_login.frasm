// PROMPT: Simulate a hotel captive portal WLC validating a conference guest voucher code via RADIUS.
// TOKENS: host, ip, mac, flow, radius, accessrequest, id, user, nasip, servicetype, wait, ms, accessaccept, framedip, compile

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
host radius_nas {
    ip 192.168.180.2
    mac 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
host radius_server {
    ip 192.168.180.10
    mac 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 111 user "CONF-2026-VIP-881" nasip 192.168.180.2 servicetype 1 wait 3ms
    nas <- srv radius accessaccept id 111 user "CONF-2026-VIP-881" nasip 192.168.180.2 servicetype 1 framedip 192.168.184.55
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
compile {
    radius_scenario_flow(radius_nas, radius_server)
}
