// Minimal 2-block RADIUS starter emitting a default Access-Request on UDP port 1812.
// Populates RFC 2865 packet headers and authenticator bytes automatically with zero flow block.
// Ideal for smoke-testing AAA collector listeners and firewall policies.
// Wireshark: radius

host access_switch { ip 10.60.1.10  mac 00:50:56:60:00:0a }
host radius_server { ip 10.60.1.200 mac 00:50:56:60:00:c8 }

compile {
    access_switch -> radius_server radius
}
