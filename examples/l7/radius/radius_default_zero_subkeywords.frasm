// Minimal 2-block RADIUS (RFC 2865 / 2866) starter emitting automatic
// protocol defaults directly from the compile block (zero flow wrapper).
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting.
// Wireshark: radius

host wlc_nas { ip 10.18.12.5 mac 00:1e:be:12:00:05 }

host radius_aaa { ip 10.18.12.1 mac 00:1e:be:12:00:01 }

compile {
    wlc_nas -> radius_aaa radius
}
