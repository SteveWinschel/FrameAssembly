// PROMPT: Dual-stack IPv4 and IPv6 RADIUS authentication and Framed-IP assignment.
// TOKENS: host, ip, flow, radius, accessrequest, user, nasip, servicetype, dscp, ttl, flowlabel, accessaccept, framedip, compile

// INSTRUCTION: Define IPv4 NAS and RADIUS server.
host nas_v4 { ip 10.181.2.10 }
// INSTRUCTION: Define IPv4 RADIUS AAA endpoint.
host rad_v4 { ip 10.181.2.1 }

// INSTRUCTION: Define IPv6 NAS and RADIUS server.
host nas_v6 { ip 2001:db8:1812::10 }
// INSTRUCTION: Define IPv6 RADIUS AAA endpoint.
host rad_v6 { ip 2001:db8:1812::1 }

// INSTRUCTION: Define polymorphic RADIUS authentication exchange.
flow radius_dual_stack(nas, aaa) {
    nas -> aaa radius accessrequest user "netops_dual" nasip 10.181.2.10 servicetype 6 dscp 48 ttl 64 flowlabel 0x18120
    nas <- aaa radius accessaccept user "netops_dual" framedip 10.181.99.50 servicetype 6 dscp 48 ttl 64 flowlabel 0x18120
}

// INSTRUCTION: Compile dual-stack RADIUS flow over IPv4 and IPv6.
compile {
    radius_dual_stack(nas_v4, rad_v4)
    radius_dual_stack(nas_v6, rad_v6)
}
