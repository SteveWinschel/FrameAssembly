// PROMPT: Generate a RADIUS Access-Reject for an expired user password followed by an Accounting-Request failure log.
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCESS_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, WAIT, ACCESS_REJECT, PAYLOAD, ACCOUNTING_REQUEST, ACCOUNTING_RESPONSE, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 10.18.90.5
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 10.18.90.100
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCESS_REQUEST ID 113 USER "contractor_temp09" NAS_IP 10.18.90.5 SERVICE_TYPE 2 WAIT 3ms
    nas <- srv RADIUS ACCESS_REJECT ID 113 USER "contractor_temp09" NAS_IP 10.18.90.5 PAYLOAD "Reply-Message=Password expired" WAIT 5ms
    nas -> srv RADIUS ACCOUNTING_REQUEST ID 114 USER "contractor_temp09" NAS_IP 10.18.90.5 PAYLOAD "Acct-Terminate-Cause=Admin-Reset" WAIT 3ms
    nas <- srv RADIUS ACCOUNTING_RESPONSE ID 114 USER "contractor_temp09" NAS_IP 10.18.90.5
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
