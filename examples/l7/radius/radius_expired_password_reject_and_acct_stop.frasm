// PROMPT: Generate a RADIUS Access-Reject for an expired user password followed by an Accounting-Request failure log.
// TOKENS: host, ip, mac, flow, radius, accessrequest, id, user, nasip, servicetype, wait, ms, accessreject, payload, accountingrequest, accountingresponse, compile

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
host radius_nas {
    ip 10.18.90.5
    mac 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
host radius_server {
    ip 10.18.90.100
    mac 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 113 user "contractor_temp09" nasip 10.18.90.5 servicetype 2 wait 3ms
    nas <- srv radius accessreject id 113 user "contractor_temp09" nasip 10.18.90.5 payload "Reply-Message=Password expired" wait 5ms
    nas -> srv radius accountingrequest id 114 user "contractor_temp09" nasip 10.18.90.5 payload "Acct-Terminate-Cause=Admin-Reset" wait 3ms
    nas <- srv radius accountingresponse id 114 user "contractor_temp09" nasip 10.18.90.5
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
compile {
    radius_scenario_flow(radius_nas, radius_server)
}
