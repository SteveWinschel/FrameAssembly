// Eduroam-style federated RADIUS proxy forwarding roaming authentication to
// home institution.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 2 (Framed (802.1X)).
// Timing: runs 2 cycles in compile using post-packet waits (6ms).
// Wireshark: radius

host visited_wlc { ip 172.30.1.10 mac 00:1a:a1:30:01:0a }

host fed_proxy { ip 172.30.1.1 mac 00:1a:a1:30:01:01 }

host home_idp { ip 172.30.2.1 mac 00:1a:a1:30:02:01 }

flow radius_proxy_hop(src, dst) {
    src -> dst radius accessrequest user "researcher@uni-home.edu" nasip 172.30.1.10 servicetype 2 wait 6ms
    src <- dst radius accessaccept user "researcher@uni-home.edu" framedip 172.30.99.15 servicetype 2
}

compile {
    radius_proxy_hop(visited_wlc, fed_proxy)
    radius_proxy_hop(fed_proxy, home_idp)
}
