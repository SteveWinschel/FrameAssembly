// PROMPT: Periodic RADIUS interim accounting updates emitted in a COMPILE LOOP.
// TOKENS: host, ip, flow, acct, radius, accountingrequest, user, nasip, framedip, servicetype, wait, s, accountingresponse, compile

// INSTRUCTION: Define Wi-Fi 6E access point NAS.
host wifi_ap { ip 10.120.5.50 }

// INSTRUCTION: Define RADIUS accounting collector.
host rad_acct { ip 10.120.5.1 }

// INSTRUCTION: Define single interim accounting request/response cycle.
flow radius_interim_acct(ap, acct) {
    ap -> acct radius accountingrequest user "corp_laptop_44" nasip 10.120.5.50 framedip 10.120.99.44 servicetype 2 wait 1s
    ap <- acct radius accountingresponse user "corp_laptop_44" wait 1s
}

// INSTRUCTION: Execute 4 interim accounting intervals in COMPILE LOOP.
compile {
    radius_interim_acct(wifi_ap, rad_acct) // cycle 1
    radius_interim_acct(wifi_ap, rad_acct) // cycle 2
    radius_interim_acct(wifi_ap, rad_acct) // cycle 3
    radius_interim_acct(wifi_ap, rad_acct) // cycle 4
}
