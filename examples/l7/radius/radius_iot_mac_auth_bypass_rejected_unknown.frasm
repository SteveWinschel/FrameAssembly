// Create a switch port 802.1X MAC Authentication Bypass (MAB) RADIUS lookup
// rejecting an unrecognized rogue MAC.
// Encapsulation and QoS markings: 802.1Q VLAN 55.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessreject) with Service-Type 10.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: radius && vlan.id == 55

host radius_nas {
    ip 10.55.18.15
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 10.55.18.1
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 107 user "deadbeef9901" nasip 10.55.18.15 servicetype 10 vlan 55 wait 2ms
    nas <- srv radius accessreject id 107 user "deadbeef9901" nasip 10.55.18.15 vlan 55
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
