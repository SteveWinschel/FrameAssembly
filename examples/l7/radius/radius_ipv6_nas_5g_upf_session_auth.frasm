// Model an IPv6 5G SMF/UPF node authenticating a PDU session against an IPv6
// FreeRADIUS server.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 2 (Framed (802.1X)).
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 2001:db8:1812:1::10
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 2001:db8:1812:1::100
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 110 user "5g_supi_001010123456789" nasip 2001:db8:1812:1::10 servicetype 2 flowlabel 0x18120 ttl 64 wait 3ms
    nas <- srv radius accessaccept id 110 user "5g_supi_001010123456789" nasip 2001:db8:1812:1::10 servicetype 2 framedip 2001:db8:cafe::42 flowlabel 0x18120 ttl 64
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
