// PROMPT: Generate an MPLS L3VPN PE router forwarding RADIUS authentication requests over MPLS label 1812.
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCESS_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, MPLS, EXP, BOS, MPLS_TTL, WAIT, ACCESS_ACCEPT, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 10.181.12.9
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 10.181.12.250
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCESS_REQUEST ID 109 USER "branch_mgr_07" NAS_IP 10.181.12.9 SERVICE_TYPE 1 MPLS 1812 EXP 4 BOS 1 MPLS_TTL 64 WAIT 4ms
    nas <- srv RADIUS ACCESS_ACCEPT ID 109 USER "branch_mgr_07" NAS_IP 10.181.12.9 SERVICE_TYPE 1 MPLS 1812 EXP 4 BOS 1 MPLS_TTL 64
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
