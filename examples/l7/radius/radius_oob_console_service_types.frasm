// RADIUS Administrative-User (SERVICE_TYPE 6) and Callback-Login
// (SERVICE_TYPE 3) comparison.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 3, 6 (Administrative).
// Timing: uses post-packet wait delays (5ms, 10ms) between frames.
// Wireshark: radius

host oob_console { ip 10.9.9.10 }

host oob_radius { ip 10.9.9.1 }

flow radius_service_types(nas, aaa) {
    nas -> aaa radius accessrequest user "oob_root" nasip 10.9.9.10 servicetype 6 wait 5ms
    nas <- aaa radius accessaccept user "oob_root" servicetype 6 wait 10ms
    nas -> aaa radius accessrequest user "modem_cb" nasip 10.9.9.10 servicetype 3 wait 5ms
    nas <- aaa radius accessaccept user "modem_cb" servicetype 3
}

compile {
    radius_service_types(oob_console, oob_radius)
}
