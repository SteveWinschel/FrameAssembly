// PROMPT: Simulate a wholesale L2TP LNS authenticating a bitstream subscriber over QinQ 600/181.
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCESS_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, QINQ, INNER_VLAN, WAIT, ACCESS_ACCEPT, FRAMED_IP, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 172.26.18.5
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 172.26.18.50
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCESS_REQUEST ID 108 USER "dsl_line_4410@partner-isp.co.uk" NAS_IP 172.26.18.5 SERVICE_TYPE 2 QINQ 600 INNER_VLAN 181 WAIT 5ms
    nas <- srv RADIUS ACCESS_ACCEPT ID 108 USER "dsl_line_4410@partner-isp.co.uk" NAS_IP 172.26.18.5 SERVICE_TYPE 2 FRAMED_IP 198.51.100.144 QINQ 600 INNER_VLAN 181
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
