// Simulate a wholesale L2TP LNS authenticating a bitstream subscriber over
// QinQ 600/181.
// Encapsulation and QoS markings: 802.1ad QinQ outer 600 / inner 181.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 2 (Framed (802.1X)).
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: radius && vlan

host radius_nas {
    ip 172.26.18.5
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 172.26.18.50
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 108 user "dsl_line_4410@partner-isp.co.uk" nasip 172.26.18.5 servicetype 2 qinq 600 innervlan 181 wait 5ms
    nas <- srv radius accessaccept id 108 user "dsl_line_4410@partner-isp.co.uk" nasip 172.26.18.5 servicetype 2 framedip 198.51.100.144 qinq 600 innervlan 181
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
