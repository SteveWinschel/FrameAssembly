// Simulate an SD-WAN branch router authenticating its chassis serial number
// via RADIUS during staging.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 7.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 172.30.18.40
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 172.30.18.1
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 116 user "SN-FDO241109AB" nasip 172.30.18.40 servicetype 7 wait 4ms
    nas <- srv radius accessaccept id 116 user "SN-FDO241109AB" nasip 172.30.18.40 servicetype 7 framedip 172.30.200.40
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
