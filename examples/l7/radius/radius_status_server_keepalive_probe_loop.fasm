// PROMPT: Model a load balancer probing RADIUS server health in a 2-iteration loop using Access-Request health checks.
// TOKENS: host, ip, mac, flow, radius, accessrequest, id, user, nasip, servicetype, wait, ms, accessaccept, compile

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
host radius_nas {
    ip 10.181.0.5
    mac 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
host radius_server {
    ip 10.181.0.10
    mac 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 115 user "healthcheck_probe" nasip 10.181.0.5 servicetype 8 wait 2ms
    nas <- srv radius accessaccept id 115 user "healthcheck_probe" nasip 10.181.0.5 servicetype 8 wait 20ms
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
compile {
    radius_scenario_flow(radius_nas, radius_server)
}
