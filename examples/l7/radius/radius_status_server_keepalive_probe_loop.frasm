// Model a load balancer probing RADIUS server health in a 2-iteration loop
// using Access-Request health checks.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 8 (Authenticate-Only).
// Timing: runs 2 cycles in compile using post-packet waits (2ms, 20ms).
// Wireshark: radius

host radius_nas {
    ip 10.181.0.5
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 10.181.0.10
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 115 user "healthcheck_probe" nasip 10.181.0.5 servicetype 8 wait 2ms
    nas <- srv radius accessaccept id 115 user "healthcheck_probe" nasip 10.181.0.5 servicetype 8 wait 20ms
}

compile {
    radius_scenario_flow(radius_nas, radius_server) // cycle 1
    radius_scenario_flow(radius_nas, radius_server) // cycle 2
}
