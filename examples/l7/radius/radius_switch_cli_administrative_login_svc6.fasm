// PROMPT: Simulate a campus switch authenticating an administrative SSH user via RADIUS with Service-Type 6 (Administrative).
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCESS_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, DSCP, WAIT, ACCESS_ACCEPT, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 10.18.12.2
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 10.18.12.100
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCESS_REQUEST ID 105 USER "netops_admin" NAS_IP 10.18.12.2 SERVICE_TYPE 6 DSCP 16 WAIT 3ms
    nas <- srv RADIUS ACCESS_ACCEPT ID 105 USER "netops_admin" NAS_IP 10.18.12.2 SERVICE_TYPE 6 DSCP 16
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
