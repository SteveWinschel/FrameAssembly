// Simulate a campus switch authenticating an administrative SSH user via
// RADIUS with Service-Type 6 (Administrative).
// Encapsulation and QoS markings: DSCP 16.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 6 (Administrative).
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 10.18.12.2
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 10.18.12.100
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 105 user "netops_admin" nasip 10.18.12.2 servicetype 6 dscp 16 wait 3ms
    nas <- srv radius accessaccept id 105 user "netops_admin" nasip 10.18.12.2 servicetype 6 dscp 16
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
