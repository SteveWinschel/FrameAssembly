// Create a SIP registrar verifying subscriber digest credentials against a
// backend RADIUS server.
// Encapsulation and QoS markings: DSCP 24 (CS3).
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 12.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 10.60.18.20
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 10.60.18.100
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 112 user "ext4401@voip.example.com" nasip 10.60.18.20 servicetype 12 dscp 24 wait 3ms
    nas <- srv radius accessaccept id 112 user "ext4401@voip.example.com" nasip 10.60.18.20 servicetype 12 dscp 24
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
