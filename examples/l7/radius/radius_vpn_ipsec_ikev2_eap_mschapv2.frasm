// Generate an IKEv2 remote-access VPN gateway authenticating a road-warrior
// user against RADIUS with Framed-IP.
// RADIUS uses UDP 1812 for auth and UDP 1813 for accounting (accessrequest,
// accessaccept) with Service-Type 2 (Framed (802.1X)).
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: radius

host radius_nas {
    ip 192.168.181.1
    mac 00:1b:21:18:12:05
}

host radius_server {
    ip 192.168.181.50
    mac 00:1b:21:18:12:64
}

flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 104 user "corp\s_connor" nasip 192.168.181.1 servicetype 2 wait 3ms
    nas <- srv radius accessaccept id 104 user "corp\s_connor" nasip 192.168.181.1 servicetype 2 framedip 10.254.8.42
}

compile {
    radius_scenario_flow(radius_nas, radius_server)
}
