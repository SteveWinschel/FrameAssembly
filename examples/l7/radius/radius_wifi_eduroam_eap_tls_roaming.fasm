// PROMPT: Model an eduroam federated campus Wi-Fi RADIUS Access-Request, Access-Challenge, and Access-Accept exchange.
// TOKENS: HOST, IP, MAC, FLOW, RADIUS, ACCESS_REQUEST, ID, USER, NAS_IP, SERVICE_TYPE, VLAN, PCP, WAIT, ACCESS_CHALLENGE, PAYLOAD, ACCESS_ACCEPT, COMPILE

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
HOST radius_nas {
    IP 172.18.18.10
    MAC 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
HOST radius_server {
    IP 172.18.18.200
    MAC 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
FLOW radius_scenario_flow(nas, srv) {
    nas -> srv RADIUS ACCESS_REQUEST ID 102 USER "researcher@uni-heidelberg.de" NAS_IP 172.18.18.10 SERVICE_TYPE 8 VLAN 18 PCP 4 WAIT 6ms
    nas <- srv RADIUS ACCESS_CHALLENGE ID 102 USER "researcher@uni-heidelberg.de" NAS_IP 172.18.18.10 PAYLOAD "EAP-TLS-Server-Hello-Cert" VLAN 18 PCP 4 WAIT 8ms
    nas -> srv RADIUS ACCESS_REQUEST ID 103 USER "researcher@uni-heidelberg.de" NAS_IP 172.18.18.10 PAYLOAD "EAP-TLS-Client-Finished" VLAN 18 PCP 4 WAIT 6ms
    nas <- srv RADIUS ACCESS_ACCEPT ID 103 USER "researcher@uni-heidelberg.de" NAS_IP 172.18.18.10 SERVICE_TYPE 8 VLAN 18 PCP 4
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
COMPILE {
    radius_scenario_flow(radius_nas, radius_server)
}
