// PROMPT: Model an eduroam federated campus Wi-Fi RADIUS Access-Request, Access-Challenge, and Access-Accept exchange.
// TOKENS: host, ip, mac, flow, radius, accessrequest, id, user, nasip, servicetype, vlan, pcp, wait, ms, accesschallenge, payload, accessaccept, compile

// INSTRUCTION: Define the Network Access Server (NAS) client initiating RADIUS requests.
host radius_nas {
    ip 172.18.18.10
    mac 00:1b:21:18:12:05
}

// INSTRUCTION: Define the central RADIUS authentication and accounting server.
host radius_server {
    ip 172.18.18.200
    mac 00:1b:21:18:12:64
}

// INSTRUCTION: Execute the RFC 2865 / RFC 2866 RADIUS transaction flow.
flow radius_scenario_flow(nas, srv) {
    nas -> srv radius accessrequest id 102 user "researcher@uni-heidelberg.de" nasip 172.18.18.10 servicetype 8 vlan 18 pcp 4 wait 6ms
    nas <- srv radius accesschallenge id 102 user "researcher@uni-heidelberg.de" nasip 172.18.18.10 payload "EAP-TLS-Server-Hello-Cert" vlan 18 pcp 4 wait 8ms
    nas -> srv radius accessrequest id 103 user "researcher@uni-heidelberg.de" nasip 172.18.18.10 payload "EAP-TLS-Client-Finished" vlan 18 pcp 4 wait 6ms
    nas <- srv radius accessaccept id 103 user "researcher@uni-heidelberg.de" nasip 172.18.18.10 servicetype 8 vlan 18 pcp 4
}

// INSTRUCTION: Compile the RADIUS AAA exchange into a PCAP trace.
compile {
    radius_scenario_flow(radius_nas, radius_server)
}
