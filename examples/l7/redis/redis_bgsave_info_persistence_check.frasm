// Redis RDB snapshot administration using BGSAVE, LASTSAVE, and INFO
// persistence inspection.
// Timing: uses post-packet wait delays (2ms, 1ms) between frames.
// Wireshark: resp

host dba_runner {
    ip 10.80.70.50
    mac 00:1a:2b:80:70:50
}

host redis_master {
    ip 10.80.70.1
    mac 00:1a:2b:80:70:01
}

flow redis_bgsave_audit(c, s) {
    c -> s redis cmd "BGSAVE" args "SCHEDULE"
    c <- s redis replytype "status" value "Background saving scheduled" wait 2ms
    c -> s redis cmd "LASTSAVE"
    c <- s redis replytype "integer" value "1761396000" wait 1ms
    c -> s redis cmd "INFO" args "persistence"
    c <- s redis replytype "bulk" value "# Persistence
rdb_bgsave_in_progress:0"
}

compile {
    redis_bgsave_audit(dba_runner, redis_master)
}
