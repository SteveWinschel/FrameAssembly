// PROMPT: Redis Bitmap SETBIT, GETBIT, and BITCOUNT tracking daily active user login streaks.
// TOKENS: host, ip, mac, flow, s, redis, cmd, args, replytype, value, wait, ms, compile

// INSTRUCTION: Define the user engagement tracker service.
host streak_worker {
    ip 10.80.40.44
    mac 00:1a:2b:80:40:44
}

// INSTRUCTION: Define the engagement Redis cluster node.
host bitmap_redis {
    ip 10.80.40.2
    mac 00:1a:2b:80:40:02
}

// INSTRUCTION: Set day-of-year bit 298 for user login and count active days with BITCOUNT.
flow redis_bitmap_streak(c, s) {
    c -> s redis cmd "SETBIT" args "login:2026:uid:5091 298 1"
    c <- s redis replytype "integer" value "0" wait 1ms
    c -> s redis cmd "BITCOUNT" args "login:2026:uid:5091"
    c <- s redis replytype "integer" value "241"
}

// INSTRUCTION: Compile the Redis Bitmap activity tracking flow.
compile {
    redis_bitmap_streak(streak_worker, bitmap_redis)
}
