// Redis connection diagnostics setting client name with CLIENT SETNAME and
// inspecting SLOWLOG GET.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host obs_agent {
    ip 10.80.80.12
    mac 00:1a:2b:80:80:12
}

host monitored_redis {
    ip 10.80.80.1
    mac 00:1a:2b:80:80:01
}

flow redis_slowlog_poll(c, s) {
    c -> s redis cmd "CLIENT" args "SETNAME datadog-redis-check"
    c <- s redis replytype "status" value "OK" wait 1ms
    c -> s redis cmd "SLOWLOG" args "LEN"
    c <- s redis replytype "integer" value "3" wait 1ms
    c -> s redis cmd "SLOWLOG" args "GET 3"
    c <- s redis replytype "bulk" value "KEYS *"
}

compile {
    redis_slowlog_poll(obs_agent, monitored_redis)
}
