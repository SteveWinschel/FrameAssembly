// Redis Cluster -MOVED hash slot redirection followed by client retry against
// the target shard node.
// Executes 2 sequential flow runs inside the compile block.
// Wireshark: resp

host cluster_client {
    ip 10.80.100.50
    mac 00:1a:2b:80:a0:50
}

host redis_shard_1 {
    ip 10.80.100.1
    mac 00:1a:2b:80:a0:01
}

host redis_shard_2 {
    ip 10.80.100.2
    mac 00:1a:2b:80:a0:02
}

flow query_wrong_shard(c, s1) {
    c -> s1 redis cmd "GET" args "{account:409}:balance"
    c <- s1 redis replytype "error" value "MOVED 8192 10.80.100.2:6379"
}

flow query_right_shard(c, s2) {
    c -> s2 redis cmd "GET" args "{account:409}:balance"
    c <- s2 redis replytype "bulk" value "12500.00"
}

compile {
    query_wrong_shard(cluster_client, redis_shard_1)
    query_right_shard(cluster_client, redis_shard_2)
}
