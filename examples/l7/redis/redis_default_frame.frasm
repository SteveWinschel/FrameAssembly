// Minimal 2-block Redis starter sending a default RESP2 PING array on TCP port 6379.
// Emits '*1\r\n$4\r\nPING\r\n' with automatic TCP sequence tracking and no flow wrapper.
// Use to verify unauthenticated cache exposure rules in IDS or firewalls.
// Wireshark: resp

host app_worker { ip 10.30.1.20 mac 00:1a:2b:63:00:14 }
host redis_node { ip 10.30.2.63 mac 00:1a:2b:63:00:3f }

compile {
    app_worker -> redis_node redis
}
