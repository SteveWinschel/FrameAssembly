// Minimal 2-block Redis RESP2 / RESP3 starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (Redis
// RESP2 / RESP3, TCP 6379).
// Wireshark: resp

host web_worker { ip 10.63.79.10 mac 00:16:3e:63:79:0a }

host redis_master { ip 10.63.79.1 mac 00:16:3e:63:79:01 }

compile {
    web_worker -> redis_master redis
}
