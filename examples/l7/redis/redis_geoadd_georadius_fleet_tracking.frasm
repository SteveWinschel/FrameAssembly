// Redis Geospatial GEOADD and GEOSEARCH commands indexing and querying nearby
// delivery vehicles.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host dispatch_svc {
    ip 2001:db8:80:30::25
    mac 00:1a:2b:80:30:25
}

host geo_redis {
    ip 2001:db8:80:30::1
    mac 00:1a:2b:80:30:01
}

flow redis_geo_fleet(c, s) {
    c -> s redis cmd "GEOADD" args "fleet:sf -122.4194 37.7749 van_104"
    c <- s redis replytype "integer" value "1" wait 1ms
    c -> s redis cmd "GEOSEARCH" args "fleet:sf FROMLONLAT -122.4194 37.7749 BYRADIUS 5 km"
    c <- s redis replytype "bulk" value "van_104"
}

compile {
    redis_geo_fleet(dispatch_svc, geo_redis)
}
