// Redis QUIT command with +OK reply followed by clean TCP FIN/ACK connection
// termination.
// Overrides destination port to 6379.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host cli_worker {
    ip 10.80.130.88
    mac 00:1a:2b:80:d0:88
}

host cache_srv {
    ip 10.80.130.1
    mac 00:1a:2b:80:d0:01
}

flow redis_quit_fin(c, s) {
    c -> s srcport 49800 dstport 6379 redis cmd "QUIT"
    c <- s srcport 6379 dstport 49800 redis replytype "status" value "OK" wait 1ms
    c -> s tcp srcport 49800 dstport 6379 fin ack seq 1200 acknum 3400
    c <- s tcp srcport 6379 dstport 49800 fin ack seq 3400 acknum 1201
    c -> s tcp srcport 49800 dstport 6379 ack seq 1201 acknum 3401
}

compile {
    redis_quit_fin(cli_worker, cache_srv)
}
