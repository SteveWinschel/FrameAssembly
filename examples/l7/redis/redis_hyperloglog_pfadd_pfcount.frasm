// Redis HyperLogLog PFADD and PFCOUNT commands estimating unique daily
// website visitors.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host analytics_ingester {
    ip 10.80.20.15
    mac 00:1a:2b:80:20:15
}

host analytics_redis {
    ip 10.80.20.1
    mac 00:1a:2b:80:20:01
}

flow redis_hll_uv(c, s) {
    c -> s redis cmd "PFADD" args "uv:2026-10-25 usr_99a1 usr_44b2 usr_77c3"
    c <- s redis replytype "integer" value "1" wait 1ms
    c -> s redis cmd "PFCOUNT" args "uv:2026-10-25"
    c <- s redis replytype "integer" value "148920"
}

compile {
    redis_hll_uv(analytics_ingester, analytics_redis)
}
