// API gateway rate limiter using Redis INCR and EXPIRE commands with integer
// and status replies.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host api_gateway {
    ip 10.80.1.20
    mac 00:1a:2b:80:01:20
}

host ratelimit_redis {
    ip 10.80.1.5
    mac 00:1a:2b:80:01:05
}

flow redis_rate_limit(c, s) {
    c -> s redis cmd "INCR" args "rl:ip:203.0.113.45:min:1248"
    c <- s redis replytype "integer" value "42" wait 1ms
    c -> s redis cmd "EXPIRE" args "rl:ip:203.0.113.45:min:1248 60"
    c <- s redis replytype "integer" value "1"
}

compile {
    redis_rate_limit(api_gateway, ratelimit_redis)
}
