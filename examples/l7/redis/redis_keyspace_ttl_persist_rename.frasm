// Redis key lifecycle management using SETEX, TTL inspection, PERSIST, and
// atomic RENAME.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host cart_service {
    ip 10.80.90.25
    mac 00:1a:2b:80:90:25
}

host checkout_redis {
    ip 10.80.90.5
    mac 00:1a:2b:80:90:05
}

flow redis_key_lifecycle(c, s) {
    c -> s redis cmd "SETEX" args "hold:ord_701 300 pending_payment"
    c <- s redis replytype "status" value "OK" wait 1ms
    c -> s redis cmd "TTL" args "hold:ord_701"
    c <- s redis replytype "integer" value "299" wait 1ms
    c -> s redis cmd "PERSIST" args "hold:ord_701"
    c <- s redis replytype "integer" value "1" wait 1ms
    c -> s redis cmd "RENAME" args "hold:ord_701 confirmed:ord_701"
    c <- s redis replytype "status" value "OK"
}

compile {
    redis_key_lifecycle(cart_service, checkout_redis)
}
