// Redis RESP simple PING heartbeat command.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (Redis
// RESP2 / RESP3, TCP 6379).
// Wireshark: resp

host client { ip 192.168.1.10 }

host server { ip 192.168.1.1 }

flow redis_ping(c, s) {
    c -> s redis cmd "PING"
}

compile {
    redis_ping(client, server)
}
