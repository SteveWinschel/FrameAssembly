// Cross-region Redis Enterprise active-active replication over QinQ and MPLS.
// Encapsulation and QoS markings: 802.1ad QinQ outer 1200 / inner 637, MPLS
// label 63790, 63791.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: (resp && vlan) && mpls

host redis_reg_a { ip 10.163.1.10 }

host redis_reg_b { ip 10.163.2.10 }

flow redis_wan_repl(r1, r2) {
    r1 -> r2 redis cmd "REPLCONF" args "listening-port 6379" qinq 1200 innervlan 637 mpls 63790 exp 4 bos 1 mplsttl 64 wait 5ms
    r1 -> r2 redis cmd "PSYNC" args "8391a2b3c4d5e6f7 1048576" qinq 1200 innervlan 637 mpls 63790 exp 4 bos 1 mplsttl 64 wait 5ms
    r1 <- r2 redis cmd "CONTINUE" qinq 1200 innervlan 637 mpls 63791 exp 4 bos 1 mplsttl 63
}

compile {
    redis_wan_repl(redis_reg_a, redis_reg_b)
}
