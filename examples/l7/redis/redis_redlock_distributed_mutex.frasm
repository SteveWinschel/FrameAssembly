// PROMPT: Distributed Redlock mutex acquisition using SET NX PX and release via DEL.
// TOKENS: host, ip, flow, redis, cmd, args, wait, ms, compile

// INSTRUCTION: Define payment processor acquiring distributed lock.
host lock_client { ip 10.111.0.9 }

// INSTRUCTION: Define independent Redlock quorum node 1.
host redlock_n1 { ip 10.111.0.101 }

// INSTRUCTION: Define independent Redlock quorum node 2.
host redlock_n2 { ip 10.111.0.102 }

// INSTRUCTION: Define SET NX PX lock acquire and DEL unlock flow.
flow redis_redlock_acquire(c, node) {
    c -> node redis cmd "SET" args "lock:order_771 val_uuid_99 NX PX 10000" wait 2ms
    c <- node redis cmd "OK" wait 5ms
    c -> node redis cmd "DEL" args "lock:order_771"
}

// INSTRUCTION: Compile Redlock acquisition across quorum nodes.
compile {
    redis_redlock_acquire(lock_client, redlock_n1)
    redis_redlock_acquire(lock_client, redlock_n2)
}
