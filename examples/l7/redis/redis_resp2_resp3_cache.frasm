// In-memory key-value database caching commands using Redis RESP2/RESP3
// protocol framing.
// Wireshark: resp

host redis_app { ip 10.5.0.1 }

host redis_db { ip 10.5.0.2 }

flow redis_ops_flow(a, db) {
    a -> db redis cmd "PING"
    a -> db redis cmd "SET"
    a -> db redis cmd "GET"
}

compile {
    redis_ops_flow(redis_app, redis_db)
}
