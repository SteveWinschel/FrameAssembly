// PROMPT: Non-blocking Redis SCAN cursor iteration sweeping expired session keys with MATCH and COUNT.
// TOKENS: host, ip, mac, flow, s, redis, cmd, args, replytype, value, wait, ms, compile

// INSTRUCTION: Define the background cache janitor daemon.
host cache_janitor {
    ip 10.80.60.70
    mac 00:1a:2b:80:60:70
}

// INSTRUCTION: Define the session Redis replica node.
host session_replica {
    ip 10.80.60.10
    mac 00:1a:2b:80:60:10
}

// INSTRUCTION: Iterate the keyspace with SCAN 0 MATCH sess:* COUNT 100 and unlink stale keys.
flow redis_scan_sweep(c, s) {
    c -> s redis cmd "SCAN" args "0 MATCH sess:legacy:* COUNT 100"
    c <- s redis replytype "bulk" value "sess:legacy:901" wait 2ms
    c -> s redis cmd "UNLINK" args "sess:legacy:901"
    c <- s redis replytype "integer" value "1"
}

// INSTRUCTION: Compile the Redis SCAN and UNLINK keyspace maintenance flow.
compile {
    redis_scan_sweep(cache_janitor, session_replica)
}
