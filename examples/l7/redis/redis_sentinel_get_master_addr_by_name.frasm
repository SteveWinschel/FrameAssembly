// Redis Sentinel high-availability discovery on TCP port 26379 querying
// master address by name.
// Overrides destination port to 26379.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp || tcp.port == 26379

host backend_app {
    ip 10.80.110.40
    mac 00:1a:2b:80:b0:40
}

host sentinel_node {
    ip 10.80.110.26
    mac 00:1a:2b:80:b0:26
}

flow redis_sentinel_lookup(c, s) {
    c -> s srcport 51200 dstport 26379 redis cmd "SENTINEL" args "get-master-addr-by-name mymaster"
    c <- s srcport 26379 dstport 51200 redis replytype "bulk" value "10.80.110.1" wait 1ms
    c -> s srcport 51200 dstport 26379 redis cmd "SENTINEL" args "ckquorum mymaster"
    c <- s srcport 26379 dstport 51200 redis replytype "status" value "OK 3 usable Sentinels. Quorum and failover authorization can be reached"
}

compile {
    redis_sentinel_lookup(backend_app, sentinel_node)
}
