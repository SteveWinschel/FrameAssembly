// Redis Sentinel master discovery and health ping loop on port 26379 over
// VLAN 637.
// Encapsulation and QoS markings: 802.1Q VLAN 637, 802.1p priority 5.
// Overrides destination port to 26379.
// Timing: runs 4 cycles in compile using post-packet waits (50ms).
// Wireshark: (resp || tcp.port == 26379) && vlan.id == 637

host sentinel_mon { ip 192.168.163.11 }

host sentinel_peer { ip 192.168.163.12 }

flow redis_sentinel_check(s1, s2) {
    s1 -> s2 redis cmd "SENTINEL" args "get-master-addr-by-name mymaster" vlan 637 pcp 5 dei 0 srcport 56379 dstport 26379 wait 50ms
    s1 <- s2 redis cmd "ARRAY" args "192.168.163.1:6379" vlan 637 pcp 5 dei 0 srcport 26379 dstport 56379 wait 50ms
}

compile {
    redis_sentinel_check(sentinel_mon, sentinel_peer) // cycle 1
    redis_sentinel_check(sentinel_mon, sentinel_peer) // cycle 2
    redis_sentinel_check(sentinel_mon, sentinel_peer) // cycle 3
    redis_sentinel_check(sentinel_mon, sentinel_peer) // cycle 4
}
