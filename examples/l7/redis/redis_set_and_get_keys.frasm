// PROMPT: Redis RESP key-value cache operations executing SET and GET over IPv6.
// TOKENS: host, ip, flow, s, redis, cmd, args, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow redis_kv(c, s) {
    c -> s redis cmd "SET" args "session_token val_9876"
    c -> s redis cmd "GET" args "session_token"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    redis_kv(client, server)
}
