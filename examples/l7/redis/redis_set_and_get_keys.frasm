// Redis RESP key-value cache operations executing SET and GET over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: resp

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow redis_kv(c, s) {
    c -> s redis cmd "SET" args "session_token val_9876"
    c -> s redis cmd "GET" args "session_token"
}

compile {
    redis_kv(client, server)
}
