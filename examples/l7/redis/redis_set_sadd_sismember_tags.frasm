// Redis Set operations SADD, SISMEMBER, and SCARD for real-time user
// permission role checks.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: resp

host authz_service {
    ip 10.80.10.30
    mac 00:1a:2b:80:10:30
}

host perm_redis {
    ip 10.80.10.10
    mac 00:1a:2b:80:10:10
}

flow redis_role_set(c, s) {
    c -> s redis cmd "SADD" args "user:8812:roles billing_admin audit_viewer"
    c <- s redis replytype "integer" value "2" wait 1ms
    c -> s redis cmd "SISMEMBER" args "user:8812:roles billing_admin"
    c <- s redis replytype "integer" value "1" wait 1ms
    c -> s redis cmd "SCARD" args "user:8812:roles"
    c <- s redis replytype "integer" value "2"
}

compile {
    redis_role_set(authz_service, perm_redis)
}
