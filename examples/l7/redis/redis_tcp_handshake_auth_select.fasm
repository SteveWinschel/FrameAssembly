// PROMPT: Full TCP 3-way handshake on port 6379 followed by Redis AUTH, SELECT, and SETEX.
// TOKENS: host, ip, mac, flow, s, tcp, syn, dstport, ack, wait, ms, redis, cmd, args, compile

// INSTRUCTION: Define session service client.
host sess_client { ip 192.168.63.20 mac 00:50:56:63:00:14 }

// INSTRUCTION: Define Redis cache server.
host redis_node { ip 192.168.63.1 mac 00:50:56:63:00:01 }

// INSTRUCTION: Define TCP handshake and authenticated Redis session setup.
flow redis_tcp_auth(c, s) {
    c -> s tcp syn dstport 6379
    c <- s tcp syn ack
    c -> s tcp ack wait 1ms
    c -> s redis cmd "AUTH" args "super_secret_redis_key" wait 2ms
    c <- s redis cmd "OK" wait 2ms
    c -> s redis cmd "SELECT" args "2" wait 2ms
    c -> s redis cmd "SETEX" args "jwt:user42 3600 tok_abc123"
}

// INSTRUCTION: Compile Redis TCP handshake and AUTH flow.
compile {
    redis_tcp_auth(sess_client, redis_node)
}
