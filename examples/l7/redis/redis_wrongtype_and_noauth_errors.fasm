// PROMPT: Redis error responses (-NOAUTH Authentication required and -WRONGTYPE Operation against wrong key kind).
// TOKENS: host, ip, mac, flow, s, redis, cmd, args, replytype, value, wait, ms, compile

// INSTRUCTION: Define the misconfigured client attempting unauthenticated and mismatched commands.
host buggy_worker {
    ip 192.168.80.99
    mac 00:1a:2b:80:80:99
}

// INSTRUCTION: Define the protected Redis server.
host strict_redis {
    ip 192.168.80.1
    mac 00:1a:2b:80:80:01
}

// INSTRUCTION: Trigger NOAUTH error before authenticating, then trigger WRONGTYPE by calling LPUSH on a string key.
flow redis_error_cases(c, s) {
    c -> s redis cmd "GET" args "config:version"
    c <- s redis replytype "error" value "NOAUTH Authentication required." wait 1ms
    c -> s redis cmd "AUTH" args "prod_redis_secret_2026"
    c <- s redis replytype "status" value "OK" wait 1ms
    c -> s redis cmd "LPUSH" args "config:version v2"
    c <- s redis replytype "error" value "WRONGTYPE Operation against a key holding the wrong kind of value"
}

// INSTRUCTION: Compile the Redis error response verification flow.
compile {
    redis_error_cases(buggy_worker, strict_redis)
}
