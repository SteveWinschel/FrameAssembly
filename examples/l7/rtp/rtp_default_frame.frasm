// Minimal 2-block RTP starter emitting a default RFC 3550 media packet on UDP port 5004.
// Automatically fills version 2 headers, sequence number, timestamp, and SSRC without a flow block.
// In Wireshark, filter on port 5004 or decode UDP 5004 as RTP.
// Wireshark: rtp || udp.port == 5004

host voip_phone { ip 10.80.1.50 mac 00:1a:2b:80:00:32 }
host media_gw   { ip 10.80.1.10 mac 00:1a:2b:80:00:0a }

compile {
    voip_phone -> media_gw rtp
}
