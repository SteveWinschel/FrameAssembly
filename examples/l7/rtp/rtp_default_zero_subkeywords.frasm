// Minimal 2-block RTP (RFC 3550) starter emitting automatic protocol defaults
// directly from the compile block (zero flow wrapper).
// RTP media stream emitted on UDP 5004 with automatic SSRC and timestamps.
// Wireshark: rtp || udp.port == 5004

host phone_a { ip 10.50.4.10 mac 00:04:f2:50:04:0a }

host phone_b { ip 10.50.4.20 mac 00:04:f2:50:04:14 }

compile {
    phone_a -> phone_b rtp
}
