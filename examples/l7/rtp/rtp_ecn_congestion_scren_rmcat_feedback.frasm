// SCReAM / RMCAT congestion-controlled interactive video RTP stream with ECN
// markings.
// Encapsulation and QoS markings: DSCP 34.
// RTP media on UDP 5004 carrying PT 96 (dynamic RTP payload (96)).
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 5004

host drone_tx {
    ip 10.72.9.20
}

host ground_rx {
    ip 10.72.9.1
}

flow rtp_ecn_video(tx, rx) {
    tx -> rx rtp pt 96 seq 9000 timestamp 450000 ssrc 0xd804e001 marker 0 dscp 34 ecn 2 payload "FPV_SLICE_ECT0" wait 4ms
    tx -> rx rtp pt 96 seq 9001 timestamp 450000 ssrc 0xd804e001 marker 1 dscp 34 ecn 3 payload "FPV_SLICE_CE_MARKED"
}

compile {
    rtp_ecn_video(drone_tx, ground_rx)
}
