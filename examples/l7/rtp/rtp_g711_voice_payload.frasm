// RTP audio media packet with G.711 PCMU payload type (PT 0) and SSRC.
// RTP media on UDP 5004 carrying PT 0 (G.711 PCMU).
// Wireshark: rtp || udp.port == 5004

host client { ip 10.0.0.10 }

host server { ip 10.0.0.20 }

flow rtp_voice(c, s) {
    c -> s rtp pt 0 ssrc 0x12345678 timestamp 160
}

compile {
    rtp_voice(client, server)
}
