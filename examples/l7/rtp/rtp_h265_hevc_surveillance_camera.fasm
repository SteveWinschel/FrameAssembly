// PROMPT: IP security camera streaming H.265/HEVC (payload type 100) video to NVR storage server.
// TOKENS: host, ip, flow, rtp, pt, seq, timestamp, ssrc, marker, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define perimeter PoE H.265 surveillance camera.
host hevc_cam {
    ip 10.18.200.55
}

// INSTRUCTION: Define Network Video Recorder (NVR) ingestion server.
host nvr_storage {
    ip 10.18.200.1
}

// INSTRUCTION: Define H.265 IDR access unit fragmented across two RTP packets on port 6004.
flow rtp_hevc_stream(cam, nvr) {
    cam -> nvr rtp pt 100 seq 1200 timestamp 180000 ssrc 0xca000055 marker 0 srcport 5004 dstport 6004 payload "HEVC_NAL_IDR_START" wait 3ms
    cam -> nvr rtp pt 100 seq 1201 timestamp 180000 ssrc 0xca000055 marker 1 srcport 5004 dstport 6004 payload "HEVC_NAL_IDR_END"
}

// INSTRUCTION: Compile the H.265 surveillance RTP flow.
compile {
    rtp_hevc_stream(hevc_cam, nvr_storage)
}
