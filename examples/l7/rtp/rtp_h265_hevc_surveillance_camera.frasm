// IP security camera streaming H.265/HEVC (payload type 100) video to NVR
// storage server.
// RTP media on UDP 5004 carrying PT 100.
// Overrides destination port to 6004.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 6004

host hevc_cam {
    ip 10.18.200.55
}

host nvr_storage {
    ip 10.18.200.1
}

flow rtp_hevc_stream(cam, nvr) {
    cam -> nvr rtp pt 100 seq 1200 timestamp 180000 ssrc 0xca000055 marker 0 srcport 5004 dstport 6004 payload "HEVC_NAL_IDR_START" wait 3ms
    cam -> nvr rtp pt 100 seq 1201 timestamp 180000 ssrc 0xca000055 marker 1 srcport 5004 dstport 6004 payload "HEVC_NAL_IDR_END"
}

compile {
    rtp_hevc_stream(hevc_cam, nvr_storage)
}
