// IPv6 multicast AES67 studio audio RTP stream to ff0e::5004 with RFC 2464
// MAC derivation.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RTP media on UDP 5004 carrying PT 98 (dynamic RTP payload (98)).
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 5004

host aes67_tx { ip 2001:db8:ae67::1 mac 00:1d:c1:ae:67:01 }

host aes67_mcast_v6 { ip ff0e::5004 }

flow rtp_aes67_ipv6_mcast(tx, grp) {
    tx -> grp rtp pt 98 timestamp 48 ssrc 0xae670001 marker 1 dscp 46 ttl 16 flowlabel 0xae670 wait 1ms
    tx -> grp rtp pt 98 timestamp 96 ssrc 0xae670001 marker 0 dscp 46 ttl 16 flowlabel 0xae670
}

compile {
    rtp_aes67_ipv6_mcast(aes67_tx, aes67_mcast_v6)
}
