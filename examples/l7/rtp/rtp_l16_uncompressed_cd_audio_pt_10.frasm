// Uncompressed 16-bit stereo 44.1kHz linear PCM audio (RFC 3551 PT 10) over
// studio LAN.
// RTP media on UDP 5004 carrying PT 10.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 5004

host daw_master {
    ip 192.168.77.10
}

host studio_dac {
    ip 192.168.77.20
}

flow rtp_l16_stereo(tx, rx) {
    tx -> rx rtp pt 10 seq 1000 timestamp 44100 ssrc 0x44100010 marker 1 hexpayload "0100ff000200fe00" wait 5ms
    tx -> rx rtp pt 10 seq 1001 timestamp 44541 ssrc 0x44100010 marker 0 hexpayload "0300fd000400fc00"
}

compile {
    rtp_l16_stereo(daw_master, studio_dac)
}
