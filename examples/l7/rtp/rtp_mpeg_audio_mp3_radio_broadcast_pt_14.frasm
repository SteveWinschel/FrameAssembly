// PROMPT: RFC 2250 MPEG Audio (MPA static payload type 14) syndication feed between radio stations.
// TOKENS: host, ip, flow, rtp, pt, seq, timestamp, ssrc, marker, payload, wait, ms, compile

// INSTRUCTION: Define national syndicate broadcast studio encoder.
host radio_hq {
    ip 10.125.14.1
}

// INSTRUCTION: Define regional FM transmitter site decoder.
host fm_tower {
    ip 10.125.14.50
}

// INSTRUCTION: Define MPEG Audio (PT 14) RTP frames using 90kHz presentation clock.
flow rtp_mpa_radio(hq, tower) {
    hq -> tower rtp pt 14 seq 800 timestamp 90000 ssrc 0x00140001 marker 1 payload "MPA_HDR_ADTS_FRAME_1" wait 24ms
    hq -> tower rtp pt 14 seq 801 timestamp 92160 ssrc 0x00140001 marker 0 payload "MPA_HDR_ADTS_FRAME_2"
}

// INSTRUCTION: Compile the RFC 2250 MPEG Audio radio broadcast RTP scenario.
compile {
    rtp_mpa_radio(radio_hq, fm_tower)
}
