// RFC 2250 MPEG Audio (MPA static payload type 14) syndication feed between
// radio stations.
// RTP media on UDP 5004 carrying PT 14.
// Timing: pauses 24ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 5004

host radio_hq {
    ip 10.125.14.1
}

host fm_tower {
    ip 10.125.14.50
}

flow rtp_mpa_radio(hq, tower) {
    hq -> tower rtp pt 14 seq 800 timestamp 90000 ssrc 0x00140001 marker 1 payload "MPA_HDR_ADTS_FRAME_1" wait 24ms
    hq -> tower rtp pt 14 seq 801 timestamp 92160 ssrc 0x00140001 marker 0 payload "MPA_HDR_ADTS_FRAME_2"
}

compile {
    rtp_mpa_radio(radio_hq, fm_tower)
}
