// RFC 2198 RTP Redundant Audio Data (RED payload type 97) protecting VoIP
// against packet loss.
// RTP media on UDP 5004 carrying PT 97 (dynamic RTP payload (97)).
// Timing: pauses 20ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 5004

host red_sender {
    ip 192.168.42.15
}

host red_receiver {
    ip 192.168.42.25
}

flow rtp_red_audio(a, b) {
    a -> b rtp pt 97 seq 300 timestamp 48000 ssrc 0x21980001 marker 0 hexpayload "8000a000d5d5d5d5" wait 20ms
    a -> b rtp pt 97 seq 301 timestamp 48160 ssrc 0x21980001 marker 0 hexpayload "8000a0005d5d5d5d"
}

compile {
    rtp_red_audio(red_sender, red_receiver)
}
