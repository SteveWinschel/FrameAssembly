// PROMPT: RFC 4733 RTP telephone-event DTMF digit press (PT 101) with end-of-event marker.
// TOKENS: host, ip, flow, rtp, pt, timestamp, ssrc, marker, hexpayload, wait, ms, compile

// INSTRUCTION: Define SIP softphone sending IVR keypad digit.
host softphone { ip 10.50.101.15 }

// INSTRUCTION: Define IVR voice gateway receiving DTMF.
host ivr_gw { ip 10.50.101.1 }

// INSTRUCTION: Define RFC 4733 DTMF digit '1' start and end packets with constant timestamp.
flow rtp_dtmf_digit(phone, ivr) {
    phone -> ivr rtp pt 101 timestamp 8000 ssrc 0x10102020 marker 1 hexpayload "010a00a0" wait 20ms
    phone -> ivr rtp pt 101 timestamp 8000 ssrc 0x10102020 marker 0 hexpayload "010a0140" wait 20ms
    phone -> ivr rtp pt 101 timestamp 8000 ssrc 0x10102020 marker 0 hexpayload "018a01e0"
}

// INSTRUCTION: Compile RFC 4733 DTMF telephone-event flow.
compile {
    rtp_dtmf_digit(softphone, ivr_gw)
}
