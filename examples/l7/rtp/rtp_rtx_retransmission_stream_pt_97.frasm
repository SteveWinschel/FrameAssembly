// PROMPT: RFC 4588 RTP retransmission (RTX) stream recovering lost video packet using separate SSRC.
// TOKENS: host, ip, flow, rtp, pt, seq, timestamp, ssrc, marker, payload, wait, ms, hexpayload, compile

// INSTRUCTION: Define WebRTC media server handling NACK retransmission.
host webrtc_sfu {
    ip 10.95.30.1
}

// INSTRUCTION: Define browser viewer requesting and receiving RTX packet.
host viewer_ep {
    ip 10.95.30.50
}

// INSTRUCTION: Define primary video stream SSRC 0x1001 and associated RTX repair stream SSRC 0x1002.
flow rtp_rtx_recovery(sfu, v) {
    sfu -> v rtp pt 96 seq 400 timestamp 540000 ssrc 0x00001001 marker 0 payload "ORIG_VIDEO_400" wait 5ms
    sfu -> v rtp pt 96 seq 402 timestamp 540000 ssrc 0x00001001 marker 1 payload "ORIG_VIDEO_402" wait 5ms
    sfu -> v rtp pt 97 seq 15 timestamp 540000 ssrc 0x00001002 marker 0 hexpayload "01914f5249475f343031"
}

// INSTRUCTION: Compile the RFC 4588 RTP RTX retransmission scenario.
compile {
    rtp_rtx_recovery(webrtc_sfu, viewer_ep)
}
