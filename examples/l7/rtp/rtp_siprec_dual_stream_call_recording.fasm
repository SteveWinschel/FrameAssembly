// PROMPT: SIPREC (RFC 7866) Session Border Controller forking caller and callee RTP streams to recorder.
// TOKENS: host, ip, flow, src, rtp, pt, seq, timestamp, ssrc, marker, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define enterprise SBC acting as SIPREC Recording Client (SRC).
host sbc_src {
    ip 10.160.5.10
}

// INSTRUCTION: Define compliance voice Recording Server (SRS).
host compliance_srs {
    ip 10.160.5.100
}

// INSTRUCTION: Define forked RTP streams for caller SSRC (port 10000) and agent SSRC (port 10002).
flow rtp_siprec_fork(src, srs) {
    src -> srs rtp pt 0 seq 50 timestamp 8000 ssrc 0xca11e801 marker 1 srcport 20000 dstport 10000 payload "CALLER_AUDIO_CH" wait 5ms
    src -> srs rtp pt 0 seq 50 timestamp 8000 ssrc 0xa9e07002 marker 1 srcport 20002 dstport 10002 payload "AGENT_AUDIO_CH"
}

// INSTRUCTION: Compile the SIPREC dual-stream compliance recording flow.
compile {
    rtp_siprec_fork(sbc_src, compliance_srs)
}
