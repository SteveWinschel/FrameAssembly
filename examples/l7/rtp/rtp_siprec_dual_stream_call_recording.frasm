// SIPREC (RFC 7866) Session Border Controller forking caller and callee RTP
// streams to recorder.
// RTP media on UDP 5004 carrying PT 0 (G.711 PCMU).
// Overrides destination port to 10000, 10002.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: rtp || udp.port == 10000 || udp.port == 10002

host sbc_src {
    ip 10.160.5.10
}

host compliance_srs {
    ip 10.160.5.100
}

flow rtp_siprec_fork(src, srs) {
    src -> srs rtp pt 0 seq 50 timestamp 8000 ssrc 0xca11e801 marker 1 srcport 20000 dstport 10000 payload "CALLER_AUDIO_CH" wait 5ms
    src -> srs rtp pt 0 seq 50 timestamp 8000 ssrc 0xa9e07002 marker 1 srcport 20002 dstport 10002 payload "AGENT_AUDIO_CH"
}

compile {
    rtp_siprec_fork(sbc_src, compliance_srs)
}
