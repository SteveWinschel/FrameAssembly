// PROMPT: SMPTE ST 2110-20 uncompressed studio video over RTP with VLAN 110 PCP 6 priority tagging.
// TOKENS: host, ip, mac, flow, src, dst, rtp, pt, seq, timestamp, ssrc, marker, vlan, pcp, dscp, hexpayload, wait, ms, compile

// INSTRUCTION: Define studio camera control unit (CCU) ST 2110 sender.
host studio_ccu {
    ip 10.211.20.10
    mac 00:1c:73:21:10:0a
}

// INSTRUCTION: Define broadcast vision mixer ST 2110 receiver.
host vision_mixer {
    ip 10.211.20.100
    mac 00:1c:73:21:10:64
}

// INSTRUCTION: Define SMPTE ST 2110-20 scanline RTP packet with end-of-frame marker.
flow rtp_st2110_video(src, dst) {
    src -> dst rtp pt 96 seq 7000 timestamp 360000 ssrc 0x21102001 marker 0 vlan 110 pcp 6 dscp 34 hexpayload "0000050000000000" wait 1ms
    src -> dst rtp pt 96 seq 7001 timestamp 360000 ssrc 0x21102001 marker 1 vlan 110 pcp 6 dscp 34 hexpayload "0000050004370000"
}

// INSTRUCTION: Compile 3 frames of SMPTE ST 2110-20 uncompressed video RTP.
compile {
    rtp_st2110_video(studio_ccu, vision_mixer) // cycle 1
    rtp_st2110_video(studio_ccu, vision_mixer) // cycle 2
    rtp_st2110_video(studio_ccu, vision_mixer) // cycle 3
}
