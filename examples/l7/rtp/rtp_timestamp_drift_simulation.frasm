// RTP consecutive media packets advancing timestamp by 160 samples over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RTP media on UDP 5004 carrying PT 0 (G.711 PCMU).
// Wireshark: rtp || udp.port == 5004

host client { ip 2001:db8::10 }

host server { ip 2001:db8::20 }

flow rtp_drift(c, s) {
    c -> s rtp pt 0 ssrc 0xaabbccdd timestamp 160
    c -> s rtp pt 0 ssrc 0xaabbccdd timestamp 320
}

compile {
    rtp_drift(client, server)
}
