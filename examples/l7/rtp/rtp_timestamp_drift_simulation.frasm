// PROMPT: RTP consecutive media packets advancing timestamp by 160 samples over IPv6.
// TOKENS: host, ip, flow, s, rtp, pt, ssrc, timestamp, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::20 }

// INSTRUCTION: Define application traffic flow.
flow rtp_drift(c, s) {
    c -> s rtp pt 0 ssrc 0xaabbccdd timestamp 160
    c -> s rtp pt 0 ssrc 0xaabbccdd timestamp 320
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    rtp_drift(client, server)
}
