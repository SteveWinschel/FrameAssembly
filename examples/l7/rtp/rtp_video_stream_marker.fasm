// PROMPT: RTP video stream frame asserting marker bit indicating end of video access unit.
// TOKENS: HOST, IP, FLOW, ->, RTP, PT, SSRC, TIMESTAMP, MARKER, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 10.0.0.10 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 10.0.0.20 }

// INSTRUCTION: Define application traffic flow.
FLOW rtp_video(c, s) {
    c -> s RTP PT 96 SSRC 0x87654321 TIMESTAMP 3600 MARKER 1
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    rtp_video(client, server)
}
