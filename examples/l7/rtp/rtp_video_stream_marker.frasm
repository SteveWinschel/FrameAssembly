// RTP video stream frame asserting marker bit indicating end of video access
// unit.
// RTP media on UDP 5004 carrying PT 96 (dynamic RTP payload (96)).
// Wireshark: rtp || udp.port == 5004

host client { ip 10.0.0.10 }

host server { ip 10.0.0.20 }

flow rtp_video(c, s) {
    c -> s rtp pt 96 ssrc 0x87654321 timestamp 3600 marker 1
}

compile {
    rtp_video(client, server)
}
