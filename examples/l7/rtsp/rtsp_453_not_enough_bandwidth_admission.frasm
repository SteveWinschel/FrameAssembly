// RTSP admission control rejecting 4K stream SETUP with 453 Not Enough
// Bandwidth.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: rtsp

host wan_viewer {
    ip 10.115.30.40
}

host bw_rtsp_srv {
    ip 10.115.30.1
}

flow rtsp_453_admission(c, s) {
    c -> s rtsp describe uri "rtsp://10.115.30.1/cam/uhd4k" cseq 1 wait 4ms
    c <- s rtsp status 200 cseq 1 wait 4ms
    c -> s rtsp setup uri "rtsp://10.115.30.1/cam/uhd4k/track1" cseq 2 transporthdr "RTP/AVP;unicast;client_port=7000-7001" wait 4ms
    c <- s rtsp status 453 cseq 2 wait 4ms
    c -> s rtsp setup uri "rtsp://10.115.30.1/cam/sub720p/track1" cseq 3 transporthdr "RTP/AVP;unicast;client_port=7000-7001" wait 4ms
    c <- s rtsp status 200 cseq 3 session "sub720_ok"
}

compile {
    rtsp_453_admission(wan_viewer, bw_rtsp_srv)
}
