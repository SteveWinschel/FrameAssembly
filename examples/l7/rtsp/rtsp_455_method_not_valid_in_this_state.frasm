// PROMPT: RTSP client sending PLAY before SETUP rejected with 455 Method Not Valid in This State.
// TOKENS: host, ip, flow, s, rtsp, describe, uri, cseq, wait, ms, status, play, setup, transporthdr, session, compile

// INSTRUCTION: Define buggy RTSP player state machine client.
host buggy_player {
    ip 10.62.14.20
}

// INSTRUCTION: Define strict RFC 2326 compliant RTSP server.
host strict_rtsp {
    ip 10.62.14.1
}

// INSTRUCTION: Define premature PLAY rejected with 455 followed by proper SETUP and PLAY.
flow rtsp_455_state_error(c, s) {
    c -> s rtsp describe uri "rtsp://10.62.14.1/vod/lecture" cseq 1 wait 3ms
    c <- s rtsp status 200 cseq 1 wait 3ms
    c -> s rtsp play uri "rtsp://10.62.14.1/vod/lecture" cseq 2 wait 3ms
    c <- s rtsp status 455 cseq 2 wait 3ms
    c -> s rtsp setup uri "rtsp://10.62.14.1/vod/lecture/track1" cseq 3 transporthdr "RTP/AVP;unicast;client_port=5400-5401" wait 3ms
    c <- s rtsp status 200 cseq 3 session "fixed_state_1" wait 3ms
    c -> s rtsp play uri "rtsp://10.62.14.1/vod/lecture" cseq 4 session "fixed_state_1" wait 3ms
    c <- s rtsp status 200 cseq 4 session "fixed_state_1"
}

// INSTRUCTION: Compile the RTSP 455 state error recovery scenario.
compile {
    rtsp_455_state_error(buggy_player, strict_rtsp)
}
