// PROMPT: RTSP server rejecting UDP unicast transport with 461 Unsupported Transport, client falling back to TCP interleaved.
// TOKENS: host, ip, flow, s, rtsp, setup, uri, cseq, transporthdr, wait, ms, status, session, play, compile

// INSTRUCTION: Define firewall-restricted RTSP player client.
host fw_client {
    ip 172.24.18.90
}

// INSTRUCTION: Define TCP-only RTSP camera server.
host tcp_cam_srv {
    ip 172.24.18.10
}

// INSTRUCTION: Define UDP SETUP rejected with 461 followed by successful RTP/AVP/TCP SETUP.
flow rtsp_461_fallback(c, s) {
    c -> s rtsp setup uri "rtsp://172.24.18.10/cam1/video" cseq 1 transporthdr "RTP/AVP;unicast;client_port=5004-5005" wait 4ms
    c <- s rtsp status 461 cseq 1 wait 4ms
    c -> s rtsp setup uri "rtsp://172.24.18.10/cam1/video" cseq 2 transporthdr "RTP/AVP/TCP;unicast;interleaved=0-1" wait 4ms
    c <- s rtsp status 200 cseq 2 session "tcp_fallback_77" wait 4ms
    c -> s rtsp play uri "rtsp://172.24.18.10/cam1" cseq 3 session "tcp_fallback_77" wait 4ms
    c <- s rtsp status 200 cseq 3 session "tcp_fallback_77"
}

// INSTRUCTION: Compile the RTSP 461 transport fallback flow.
compile {
    rtsp_461_fallback(fw_client, tcp_cam_srv)
}
