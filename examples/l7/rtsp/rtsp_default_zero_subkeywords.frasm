// Minimal 2-block RTSP (RFC 7826) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (RTSP (RFC
// 7826), TCP 554).
// Wireshark: rtsp

host player_client { ip 192.168.55.10 mac 00:1a:2b:55:00:0a }

host rtsp_camera { ip 192.168.55.1 mac 00:1a:2b:55:00:01 }

compile {
    player_client -> rtsp_camera rtsp
}
