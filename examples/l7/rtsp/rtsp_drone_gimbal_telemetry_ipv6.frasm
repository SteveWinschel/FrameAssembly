// IPv6 tactical UAV drone streaming RTSP video and gimbal metadata on custom
// TCP port 8554.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Overrides destination port to 8554.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: rtsp || tcp.port == 8554

host gcs_console_v6 {
    ip 2001:db8:8554::10
}

host uav_cam_v6 {
    ip 2001:db8:8554::1
}

flow rtsp_uav_ipv6(c, s) {
    c -> s rtsp describe uri "rtsp://[2001:db8:8554::1]:8554/eo_ir" cseq 1 srcport 52000 dstport 8554 wait 4ms
    c <- s rtsp status 200 cseq 1 srcport 8554 dstport 52000 wait 4ms
    c -> s rtsp setup uri "rtsp://[2001:db8:8554::1]:8554/eo_ir/video" cseq 2 srcport 52000 dstport 8554 transporthdr "RTP/AVP;unicast;client_port=5600-5601" wait 4ms
    c <- s rtsp status 200 cseq 2 srcport 8554 dstport 52000 session "uav_eo_01" wait 4ms
    c -> s rtsp play uri "rtsp://[2001:db8:8554::1]:8554/eo_ir" cseq 3 srcport 52000 dstport 8554 session "uav_eo_01" wait 4ms
    c <- s rtsp status 200 cseq 3 srcport 8554 dstport 52000 session "uav_eo_01"
}

compile {
    rtsp_uav_ipv6(gcs_console_v6, uav_cam_v6)
}
