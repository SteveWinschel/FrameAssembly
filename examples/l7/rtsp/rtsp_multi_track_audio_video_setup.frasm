// RTSP client setting up separate audio (trackID=0) and video (trackID=1)
// streams before aggregate PLAY.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: rtsp

host vlc_client {
    ip 10.44.12.35
}

host live555_srv {
    ip 10.44.12.1
}

flow rtsp_dual_track(c, s) {
    c -> s rtsp setup uri "rtsp://10.44.12.1/clip.mp4/trackID=0" cseq 1 transporthdr "RTP/AVP;unicast;client_port=8000-8001" wait 4ms
    c <- s rtsp status 200 cseq 1 session "av_sess_4412" wait 4ms
    c -> s rtsp setup uri "rtsp://10.44.12.1/clip.mp4/trackID=1" cseq 2 session "av_sess_4412" transporthdr "RTP/AVP;unicast;client_port=8002-8003" wait 4ms
    c <- s rtsp status 200 cseq 2 session "av_sess_4412" wait 4ms
    c -> s rtsp play uri "rtsp://10.44.12.1/clip.mp4/" cseq 3 session "av_sess_4412" wait 4ms
    c <- s rtsp status 200 cseq 3 session "av_sess_4412"
}

compile {
    rtsp_dual_track(vlc_client, live555_srv)
}
