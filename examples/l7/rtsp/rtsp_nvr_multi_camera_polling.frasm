// Central Network Video Recorder (NVR) establishing RTSP sessions with two
// warehouse IP cameras.
// Timing: runs 2 cycles in compile using post-packet waits (4ms).
// Wireshark: rtsp

host warehouse_nvr {
    ip 10.88.100.1
}

host dock_cam_1 {
    ip 10.88.100.101
}

host dock_cam_2 {
    ip 10.88.100.102
}

flow rtsp_nvr_pull(nvr, cam) {
    nvr -> cam rtsp setup uri "rtsp://10.88.100.101/main/track1" cseq 1 transporthdr "RTP/AVP/TCP;unicast;interleaved=0-1" wait 4ms
    nvr <- cam rtsp status 200 cseq 1 session "dock_cam_sess" wait 4ms
    nvr -> cam rtsp play uri "rtsp://10.88.100.101/main" cseq 2 session "dock_cam_sess" wait 4ms
    nvr <- cam rtsp status 200 cseq 2 session "dock_cam_sess"
}

compile {
    rtsp_nvr_pull(warehouse_nvr, dock_cam_1)
    rtsp_nvr_pull(warehouse_nvr, dock_cam_2)
}
