// PROMPT: ONVIF Profile T intercom camera negotiating bidirectional audio backchannel via RTSP SETUP.
// TOKENS: host, ip, flow, s, rtsp, describe, uri, cseq, wait, ms, status, setup, transporthdr, session, play, compile

// INSTRUCTION: Define security guard station VMS console.
host guard_vms {
    ip 192.168.105.10
}

// INSTRUCTION: Define front-gate ONVIF door intercom camera.
host gate_intercom {
    ip 192.168.105.50
}

// INSTRUCTION: Define ONVIF RTSP setup for video track and audio backchannel track.
flow rtsp_onvif_backchannel(c, s) {
    c -> s rtsp describe uri "rtsp://192.168.105.50/onvif-media/media.amp" cseq 1 wait 4ms
    c <- s rtsp status 200 cseq 1 wait 4ms
    c -> s rtsp setup uri "rtsp://192.168.105.50/onvif-media/media.amp/trackID=1" cseq 2 transporthdr "RTP/AVP;unicast;client_port=5100-5101" wait 4ms
    c <- s rtsp status 200 cseq 2 session "onvif_bc_99" wait 4ms
    c -> s rtsp setup uri "rtsp://192.168.105.50/onvif-media/media.amp/trackID=backchannel" cseq 3 session "onvif_bc_99" transporthdr "RTP/AVP;unicast;client_port=5102-5103" wait 4ms
    c <- s rtsp status 200 cseq 3 session "onvif_bc_99" wait 4ms
    c -> s rtsp play uri "rtsp://192.168.105.50/onvif-media/media.amp" cseq 4 session "onvif_bc_99" wait 4ms
    c <- s rtsp status 200 cseq 4 session "onvif_bc_99"
}

// INSTRUCTION: Compile the ONVIF RTSP audio backchannel scenario.
compile {
    rtsp_onvif_backchannel(guard_vms, gate_intercom)
}
