// RTSP OPTIONS query discovering streaming methods supported by media server.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (RTSP (RFC
// 7826), TCP 554).
// Wireshark: rtsp

host client { ip 192.168.1.100 }

host server { ip 192.168.1.250 }

flow rtsp_opt(c, s) {
    c -> s rtsp options uri "rtsp://camera.local/live" cseq 1
}

compile {
    rtsp_opt(client, server)
}
