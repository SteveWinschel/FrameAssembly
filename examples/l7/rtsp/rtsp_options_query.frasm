// PROMPT: RTSP OPTIONS query discovering streaming methods supported by media server.
// TOKENS: host, ip, flow, s, rtsp, options, uri, cseq, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.250 }

// INSTRUCTION: Define application traffic flow.
flow rtsp_opt(c, s) {
    c -> s rtsp options uri "rtsp://camera.local/live" cseq 1
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    rtsp_opt(client, server)
}
