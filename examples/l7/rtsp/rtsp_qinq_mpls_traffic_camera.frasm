// Smart city traffic camera RTSP control over metro QinQ VLANs and MPLS
// transport.
// Encapsulation and QoS markings: 802.1ad QinQ outer 1500 / inner 554, MPLS
// label 55400, 55401.
// Wireshark: (rtsp && vlan) && mpls

host tmc_vms { ip 10.254.0.10 }

host hwy_cam { ip 10.254.12.50 }

flow rtsp_metro_mpls(vms, cam) {
    vms -> cam rtsp method "PLAY" uri "rtsp://10.254.12.50/traffic_hd" cseq 12 session "hwy_sess_12" qinq 1500 innervlan 554 mpls 55400 exp 4 bos 1 mplsttl 64
    vms <- cam rtsp status 200 cseq 12 qinq 1500 innervlan 554 mpls 55401 exp 4 bos 1 mplsttl 63
}

compile {
    rtsp_metro_mpls(tmc_vms, hwy_cam)
}
