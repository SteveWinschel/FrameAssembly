// PROMPT: RTSP SET_PARAMETER PTZ camera pan/tilt preset command over active session.
// TOKENS: host, ip, flow, s, rtsp, method, uri, cseq, session, payload, wait, ms, status, compile

// INSTRUCTION: Define guard station PTZ controller.
host guard_ptz { ip 172.20.55.10 }

// INSTRUCTION: Define dome camera RTSP server.
host dome_cam { ip 172.20.55.200 }

// INSTRUCTION: Define SET_PARAMETER request adjusting camera preset position.
flow rtsp_set_parameter(c, s) {
    c -> s rtsp method "SET_PARAMETER" uri "rtsp://172.20.55.200/ptz" cseq 9 session "ptz_sess_1" payload "ptz_preset: gate_north\r\n" wait 5ms
    c <- s rtsp status 200 cseq 9
}

// INSTRUCTION: Compile RTSP SET_PARAMETER flow.
compile {
    rtsp_set_parameter(guard_ptz, dome_cam)
}
