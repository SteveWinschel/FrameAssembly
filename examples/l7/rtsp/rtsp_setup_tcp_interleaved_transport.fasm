// PROMPT: RTSP SETUP negotiating RTP/AVP/TCP interleaved transport on channels 0-1.
// TOKENS: host, ip, flow, s, rtsp, method, uri, cseq, transporthdr, wait, ms, status, session, compile

// INSTRUCTION: Define firewall-traversal RTSP client.
host fw_client { ip 172.17.10.22 }

// INSTRUCTION: Define RTSP media gateway.
host media_gw { ip 172.17.10.1 }

// INSTRUCTION: Define SETUP with RTP/AVP/TCP;unicast;interleaved=0-1 header.
flow rtsp_tcp_interleaved(c, s) {
    c -> s rtsp method "SETUP" uri "rtsp://172.17.10.1/live/ch1/trackID=0" cseq 3 transporthdr "RTP/AVP/TCP;unicast;interleaved=0-1" wait 5ms
    c <- s rtsp status 200 cseq 3
    c -> s rtsp method "PLAY" uri "rtsp://172.17.10.1/live/ch1" cseq 4 session "interleaved_9001"
}

// INSTRUCTION: Compile RTSP interleaved TCP transport setup.
compile {
    rtsp_tcp_interleaved(fw_client, media_gw)
}
