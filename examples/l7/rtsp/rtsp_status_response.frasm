// RTSP 200 OK status response confirming media control over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: rtsp

host client { ip 2001:db8::15 }

host server { ip 2001:db8::1 }

flow rtsp_resp(c, s) {
    c <- s rtsp cseq 3 status 200 session "Q192837465"
}

compile {
    rtsp_resp(client, server)
}
