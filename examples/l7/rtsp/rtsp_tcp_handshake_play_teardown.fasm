// PROMPT: Full TCP 3-way handshake on port 554 followed by RTSP PLAY and TEARDOWN session control.
// TOKENS: host, ip, mac, flow, s, tcp, syn, dstport, ack, wait, ms, rtsp, method, uri, cseq, session, status, compile

// INSTRUCTION: Define NVR video surveillance client.
host nvr_client { ip 10.55.4.20 mac 00:1c:cb:55:04:14 }

// INSTRUCTION: Define PTZ dome camera RTSP server.
host ptz_camera { ip 10.55.4.1 mac 00:1c:cb:55:04:01 }

// INSTRUCTION: Define TCP handshake followed by RTSP PLAY and TEARDOWN.
flow rtsp_play_teardown(c, s) {
    c -> s tcp syn dstport 554
    c <- s tcp syn ack
    c -> s tcp ack wait 2ms
    c -> s rtsp method "PLAY" uri "rtsp://10.55.4.1/stream1" cseq 4 session "91827364" wait 5ms
    c <- s rtsp status 200 cseq 4 wait 20ms
    c -> s rtsp method "TEARDOWN" uri "rtsp://10.55.4.1/stream1" cseq 5 session "91827364" wait 5ms
    c <- s rtsp status 200 cseq 5
}

// INSTRUCTION: Compile RTSP PLAY and TEARDOWN flow.
compile {
    rtsp_play_teardown(nvr_client, ptz_camera)
}
