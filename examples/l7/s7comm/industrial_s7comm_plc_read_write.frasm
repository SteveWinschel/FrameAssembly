// Siemens S7 PLC industrial communication over ISO-on-TCP COTP and S7
// protocol on port 102.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102.
// Wireshark: s7comm

host engineering_pg { ip 192.168.0.50 }

host s7_1500_plc { ip 192.168.0.1 }

flow s7_flow(pg, plc) {
    pg -> plc s7comm func readvar
    pg -> plc s7comm func writevar
}

compile {
    s7_flow(engineering_pg, s7_1500_plc)
}
