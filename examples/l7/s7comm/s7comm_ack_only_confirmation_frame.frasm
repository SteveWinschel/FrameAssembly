// S7comm rosctr ACK (0x02) header-only confirmation frame acknowledging a PLC
// job without data payload.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting DB (0x84).
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host opc_gateway {
    ip 10.130.50.10
    mac 00:1a:2b:82:50:10
}

host proc_plc {
    ip 10.130.50.1
    mac 00:1a:2b:82:50:01
}

flow s7_ack_frame(g, p) {
    g -> p s7comm rosctr "job" pduref 500 func "writevar" area 132 dbnum 10 offset 64 count 4 hexpayload "42c80000"
    g <- p s7comm rosctr "ack" pduref 500 func "writevar" wait 1ms
    g <- p s7comm rosctr "ackdata" pduref 500 func "writevar"
}

compile {
    s7_ack_frame(opc_gateway, proc_plc)
}
