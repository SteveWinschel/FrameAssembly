// Beverage bottling line reading S7 Counters (Area 28) for bottle tally and
// writing DB50 batch reset.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting DB (0x84), 28.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host mes_collector {
    ip 10.130.70.25
    mac 00:1a:2b:82:70:25
}

host filler_plc {
    ip 10.130.70.1
    mac 00:1a:2b:82:70:01
}

flow s7_bottle_counter(m, f) {
    m -> f s7comm rosctr "job" pduref 701 func "readvar" area 28 dbnum 0 offset 0 count 4
    m <- f s7comm rosctr "ackdata" pduref 701 func "readvar" hexpayload "ff09000809990500" wait 2ms
    m -> f s7comm rosctr "job" pduref 702 func "writevar" area 132 dbnum 50 offset 0 count 2 hexpayload "0000"
    m <- f s7comm rosctr "ackdata" pduref 702 func "writevar"
}

compile {
    s7_bottle_counter(mes_collector, filler_plc)
}
