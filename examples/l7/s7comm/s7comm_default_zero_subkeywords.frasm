// Minimal 2-block Siemens S7comm (ISO-on-TCP) starter emitting automatic
// protocol defaults directly from the compile block (zero flow wrapper).
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (Siemens
// S7comm (ISO-on-TCP), TCP 102).
// Wireshark: s7comm

host tia_eng { ip 192.168.0.200 mac 00:1b:1b:00:00:c8 }

host s7_1500 { ip 192.168.0.1 mac 00:1b:1b:00:00:01 }

compile {
    tia_eng -> s7_1500 s7comm
}
