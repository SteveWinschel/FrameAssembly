// SIMATIC WinCC SCADA HMI polling alarm bit words from Data Block DB100 (Area
// 132) on an S7-1500 PLC.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting DB (0x84).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host wincc_server {
    ip 10.130.20.10
    mac 00:1a:2b:82:20:10
}

host pack_plc {
    ip 10.130.20.1
    mac 00:1a:2b:82:20:01
}

flow s7_wincc_alarms(h, p) {
    h -> p s7comm rosctr "job" pduref 300 func "readvar" area 132 dbnum 100 offset 0 count 32
    h <- p s7comm rosctr "ackdata" pduref 300 func "readvar" wait 2ms
    h -> p s7comm rosctr "job" pduref 301 func "writevar" area 132 dbnum 100 offset 256 count 2 hexpayload "0001"
    h <- p s7comm rosctr "ackdata" pduref 301 func "writevar"
}

compile {
    s7_wincc_alarms(wincc_server, pack_plc)
}
