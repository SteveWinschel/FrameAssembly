// IPv6 S7comm exchange between an Automated Guided Vehicle (AGV) fleet
// manager and an inductive charging dock PLC.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting DB (0x84).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host agv_fleet_mgr {
    ip 2001:db8:130:130::10
    mac 00:1a:2b:82:d0:10
}

host dock7_plc {
    ip 2001:db8:130:130::7
    mac 00:1a:2b:82:d0:07
}

flow s7_ipv6_agv_dock(m, d) {
    m -> d s7comm rosctr "job" pduref 1300 func "writevar" area 132 dbnum 7 offset 0 count 1 hexpayload "01"
    m <- d s7comm rosctr "ackdata" pduref 1300 func "writevar" wait 2ms
    m -> d s7comm rosctr "job" pduref 1301 func "readvar" area 132 dbnum 7 offset 16 count 4
    m <- d s7comm rosctr "ackdata" pduref 1301 func "readvar" hexpayload "ff04002042340000"
}

compile {
    s7_ipv6_agv_dock(agv_fleet_mgr, dock7_plc)
}
