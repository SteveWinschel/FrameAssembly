// PROMPT: S7comm sequential multi-DataBlock recipe download (DB1, DB2, DB3) with DF bit set.
// TOKENS: HOST, IP, FLOW, S7COMM, ROSCTR, FUNC, PDU_REF, AREA, DB_NUM, OFFSET, COUNT, DF, IPID, HEXPAYLOAD, WAIT, COMPILE

// INSTRUCTION: Define batch recipe server client.
HOST recipe_srv { IP 10.102.88.5 }

// INSTRUCTION: Define mixer S7-1500 PLC.
HOST mixer_plc { IP 10.102.88.1 }

// INSTRUCTION: Define sequential WRITE_VAR operations across DB1, DB2, and DB3.
FLOW s7comm_recipe_load(c, plc) {
    c -> plc S7COMM ROSCTR "JOB" FUNC "WRITE_VAR" PDU_REF 11 AREA 0x84 DB_NUM 1 OFFSET 0 COUNT 4 DF IPID 101 HEXPAYLOAD "0004002011223344" WAIT 4ms
    c <- plc S7COMM ROSCTR "ACK_DATA" FUNC "WRITE_VAR" PDU_REF 11 DF IPID 201 HEXPAYLOAD "ff" WAIT 4ms
    c -> plc S7COMM ROSCTR "JOB" FUNC "WRITE_VAR" PDU_REF 12 AREA 0x84 DB_NUM 2 OFFSET 0 COUNT 4 DF IPID 102 HEXPAYLOAD "0004002055667788" WAIT 4ms
    c <- plc S7COMM ROSCTR "ACK_DATA" FUNC "WRITE_VAR" PDU_REF 12 DF IPID 202 HEXPAYLOAD "ff" WAIT 4ms
    c -> plc S7COMM ROSCTR "JOB" FUNC "WRITE_VAR" PDU_REF 13 AREA 0x84 DB_NUM 3 OFFSET 0 COUNT 4 DF IPID 103 HEXPAYLOAD "0004002099aabbcc" WAIT 4ms
    c <- plc S7COMM ROSCTR "ACK_DATA" FUNC "WRITE_VAR" PDU_REF 13 DF IPID 203 HEXPAYLOAD "ff"
}

// INSTRUCTION: Compile multi-DB recipe download flow.
COMPILE {
    s7comm_recipe_load(recipe_srv, mixer_plc)
}
