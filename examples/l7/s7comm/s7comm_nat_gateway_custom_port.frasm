// S7comm communication through an industrial NAT router on custom TCP port
// 10102.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting 0x84.
// Overrides destination port to 10102.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: s7comm || tcp.port == 10102

host vendor_client { ip 192.168.222.10 }

host nat_plc_gw { ip 192.168.222.1 }

flow s7comm_nat_port(c, gw) {
    c -> gw s7comm rosctr "job" func "setupcomm" pduref 1 srcport 50102 dstport 10102 wait 5ms
    c <- gw s7comm rosctr "ackdata" func "setupcomm" pduref 1 srcport 10102 dstport 50102 wait 5ms
    c -> gw s7comm rosctr "job" func "readvar" pduref 2 area 0x84 dbnum 1 offset 0 count 4 srcport 50102 dstport 10102
}

compile {
    s7comm_nat_port(vendor_client, nat_plc_gw)
}
