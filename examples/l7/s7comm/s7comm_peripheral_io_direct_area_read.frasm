// PROMPT: Siemens S7comm direct Peripheral Input (Area 0x80 = 128) read bypassing the process image input table.
// TOKENS: host, ip, mac, flow, s7comm, rosctr, pduref, func, area, dbnum, offset, count, hexpayload, compile

// INSTRUCTION: Define the high-speed diagnostic logger host.
host diag_logger {
    ip 10.130.10.20
    mac 00:1a:2b:82:10:20
}

// INSTRUCTION: Define the S7-400 high-availability PLC rack.
host s7_400_plc {
    ip 10.130.10.1
    mac 00:1a:2b:82:10:01
}

// INSTRUCTION: Read 8 bytes directly from Peripheral Input area 128 (0x80) at byte offset 256.
flow s7_peripheral_read(c, p) {
    c -> p s7comm rosctr "job" pduref 201 func "readvar" area 128 dbnum 0 offset 2048 count 8
    c <- p s7comm rosctr "ackdata" pduref 201 func "readvar" hexpayload "ff0400400a1200000000"
}

// INSTRUCTION: Compile the S7comm direct peripheral I/O read flow.
compile {
    s7_peripheral_read(diag_logger, s7_400_plc)
}
