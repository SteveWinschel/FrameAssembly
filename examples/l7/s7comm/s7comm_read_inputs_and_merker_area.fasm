// PROMPT: S7comm READ_VAR polling Process Image Input (AREA 0x81) and Merker flags (AREA 0x83).
// TOKENS: host, ip, flow, s7comm, rosctr, func, pduref, area, dbnum, offset, count, wait, ms, hexpayload, compile

// INSTRUCTION: Define HMI panel client.
host hmi_panel { ip 192.168.10.30 }

// INSTRUCTION: Define conveyor belt S7-1200 PLC.
host conveyor_plc { ip 192.168.10.1 }

// INSTRUCTION: Define READ_VAR for inputs (0x81) and bit memory merker (0x83).
flow s7comm_inputs_merker(hmi, plc) {
    hmi -> plc s7comm rosctr "job" func "readvar" pduref 31 area 0x81 dbnum 0 offset 0 count 4 wait 5ms
    hmi <- plc s7comm rosctr "ackdata" func "readvar" pduref 31 hexpayload "ff04002001010001" wait 5ms
    hmi -> plc s7comm rosctr "job" func "readvar" pduref 32 area 0x83 dbnum 0 offset 16 count 2 wait 5ms
    hmi <- plc s7comm rosctr "ackdata" func "readvar" pduref 32 hexpayload "ff040010a55a"
}

// INSTRUCTION: Compile S7comm input and merker memory read flow.
compile {
    s7comm_inputs_merker(hmi_panel, conveyor_plc)
}
