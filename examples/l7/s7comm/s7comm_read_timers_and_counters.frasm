// S7comm Timer (AREA 0x1D) and Counter (AREA 0x1C) register inspection on
// S7-300 PLC.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting 0x1C, 0x1D.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host maint_term { ip 10.102.50.99 }

host bottle_plc { ip 10.102.50.1 }

flow s7comm_timers_counters(c, plc) {
    c -> plc s7comm rosctr "job" func "readvar" pduref 601 area 0x1D dbnum 0 offset 0 count 1 wait 4ms
    c <- plc s7comm rosctr "ackdata" func "readvar" pduref 601 hexpayload "ff0900020150" wait 4ms
    c -> plc s7comm rosctr "job" func "readvar" pduref 602 area 0x1C dbnum 0 offset 0 count 1 wait 4ms
    c <- plc s7comm rosctr "ackdata" func "readvar" pduref 602 hexpayload "ff0900020042"
}

compile {
    s7comm_timers_counters(maint_term, bottle_plc)
}
