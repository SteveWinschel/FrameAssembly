// PROMPT: Siemens S7comm Read Variable command querying data block 1 memory offset 0.
// TOKENS: host, ip, flow, s, s7comm, rosctr, func, dbnum, offset, count, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.0.10 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.0.1 }

// INSTRUCTION: Define application traffic flow.
flow s7_read(c, s) {
    c -> s s7comm rosctr "job" func "readvar" dbnum 1 offset 0 count 10
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    s7_read(client, server)
}
