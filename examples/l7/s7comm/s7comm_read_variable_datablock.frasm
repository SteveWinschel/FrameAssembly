// Siemens S7comm Read Variable command querying data block 1 memory offset 0.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102.
// Wireshark: s7comm

host client { ip 192.168.0.10 }

host server { ip 192.168.0.1 }

flow s7_read(c, s) {
    c -> s s7comm rosctr "job" func "readvar" dbnum 1 offset 0 count 10
}

compile {
    s7_read(client, server)
}
