// PROMPT: Hot strip steel rolling mill reading X-ray thickness gauge inputs (Area 129) and adjusting hydraulic gap (Area 130).
// TOKENS: host, ip, mac, flow, s7comm, rosctr, pduref, func, area, dbnum, offset, count, vlan, pcp, wait, ms, hexpayload, compile

// INSTRUCTION: Define the rolling mill automatic gauge control (AGC) computer.
host mill_agc {
    ip 10.130.120.5
    mac 00:1a:2b:82:c0:05
}

// INSTRUCTION: Define Stand 4 hydraulic gap S7-400 PLC.
host stand4_plc {
    ip 10.130.120.4
    mac 00:1a:2b:82:c0:04
}

// INSTRUCTION: Read strip thickness from Process Inputs (Area 129) and write roll force correction to Process Outputs (Area 130) on VLAN 102.
flow s7_rolling_mill(c, p) {
    c -> p s7comm rosctr "job" pduref 1200 func "readvar" area 129 dbnum 0 offset 64 count 4 vlan 102 pcp 6
    c <- p s7comm rosctr "ackdata" pduref 1200 func "readvar" vlan 102 pcp 6 wait 1ms
    c -> p s7comm rosctr "job" pduref 1201 func "writevar" area 130 dbnum 0 offset 64 count 4 vlan 102 pcp 6 hexpayload "40100000"
    c <- p s7comm rosctr "ackdata" pduref 1201 func "writevar" vlan 102 pcp 6
}

// INSTRUCTION: Compile the steel rolling mill S7comm control flow.
compile {
    s7_rolling_mill(mill_agc, stand4_plc)
}
