// Full TCP 3-way handshake on port 102 followed by S7comm SETUP_COMM job and
// ACK_DATA reply.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102.
// Overrides destination port to 102.
// Timing: uses post-packet wait delays (2ms, 5ms) between frames.
// Wireshark: s7comm

host wincc_scada { ip 10.102.0.10 mac 00:0e:8c:66:00:0a }

host s7_300_cpu { ip 10.102.0.1 mac 00:0e:8c:66:00:01 }

flow s7comm_tcp_setup(hmi, plc) {
    hmi -> plc tcp syn dstport 102
    hmi <- plc tcp syn ack
    hmi -> plc tcp ack wait 2ms
    hmi -> plc s7comm rosctr "job" func "setupcomm" pduref 1 wait 5ms
    hmi <- plc s7comm rosctr "ackdata" func "setupcomm" pduref 1
}

compile {
    s7comm_tcp_setup(wincc_scada, s7_300_cpu)
}
