// PROMPT: S7comm USERDATA (ROSCTR 0x07) request reading System Status List SZL 0x0174 (CPU LED indicators).
// TOKENS: host, ip, mac, flow, m, s7comm, rosctr, pduref, hexpayload, compile

// INSTRUCTION: Define the plant maintenance portal querying PLC front-panel LED states.
host maint_portal {
    ip 10.130.30.15
    mac 00:1a:2b:82:30:15
}

// INSTRUCTION: Define the stamping press S7-300 PLC.
host press_plc {
    ip 10.130.30.2
    mac 00:1a:2b:82:30:02
}

// INSTRUCTION: Send USERDATA SZL request for CPU RUN/STOP/SF LEDs and receive USERDATA response.
flow s7_szl_leds(m, p) {
    m -> p s7comm rosctr "userdata" pduref 410 hexpayload "0001120411440100ff09000401740000"
    m <- p s7comm rosctr "userdata" pduref 410 hexpayload "000112081284010100000000ff09000801740000"
}

// INSTRUCTION: Compile the S7comm USERDATA SZL LED diagnostics flow.
compile {
    s7_szl_leds(maint_portal, press_plc)
}
