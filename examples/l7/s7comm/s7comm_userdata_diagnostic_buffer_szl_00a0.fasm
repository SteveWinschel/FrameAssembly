// PROMPT: S7comm USERDATA reading CPU diagnostic buffer entries (SZL ID 0x00A0) after an OB86 rack fault.
// TOKENS: host, ip, mac, flow, s7comm, rosctr, pduref, func, wait, ms, hexpayload, payload, compile

// INSTRUCTION: Define the TIA Portal diagnostic workstation.
host tia_portal {
    ip 10.130.40.88
    mac 00:1a:2b:82:40:88
}

// INSTRUCTION: Define the assembly robot cell PLC.
host cell_plc {
    ip 10.130.40.1
    mac 00:1a:2b:82:40:01
}

// INSTRUCTION: Negotiate communication setup and fetch diagnostic buffer SZL 0x00A0 via USERDATA.
flow s7_diag_buffer(t, p) {
    t -> p s7comm rosctr "job" pduref 1 func "setupcomm"
    t <- p s7comm rosctr "ackdata" pduref 1 func "setupcomm" wait 1ms
    t -> p s7comm rosctr "userdata" pduref 2 hexpayload "0001120411440100ff09000400a00000"
    t <- p s7comm rosctr "userdata" pduref 2 payload "SZL_00A0_EVENT_16#39C4_PROFINET_IO_STATION_RETURN"
}

// INSTRUCTION: Compile the S7comm diagnostic buffer retrieval flow.
compile {
    s7_diag_buffer(tia_portal, cell_plc)
}
