// S7comm USERDATA cyclic diagnostic SZL (System Status List) query and
// response.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: s7comm

host ot_scanner { ip 10.42.102.15 }

host target_plc { ip 10.42.102.1 }

flow s7comm_szl_userdata(c, plc) {
    c -> plc s7comm rosctr "userdata" pduref 200 hexpayload "ff090004001c0000" wait 5ms
    c <- plc s7comm rosctr "userdata" pduref 200 hexpayload "ff090008001c000136455337"
}

compile {
    s7comm_szl_userdata(ot_scanner, target_plc)
}
