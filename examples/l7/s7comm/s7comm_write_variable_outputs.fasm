// PROMPT: Siemens S7comm Write Variable command updating PLC output memory over IPv6.
// TOKENS: host, ip, flow, s, s7comm, rosctr, func, area, offset, count, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow s7_write(c, s) {
    c -> s s7comm rosctr "job" func "writevar" area 130 offset 4 count 2
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    s7_write(client, server)
}
