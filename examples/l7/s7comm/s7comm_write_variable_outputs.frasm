// Siemens S7comm Write Variable command updating PLC output memory over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Siemens S7comm over TPKT/COTP ISO-on-TCP port 102 targeting Outputs (0x82).
// Wireshark: s7comm

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow s7_write(c, s) {
    c -> s s7comm rosctr "job" func "writevar" area 130 offset 4 count 2
}

compile {
    s7_write(client, server)
}
