// PROMPT: sFlow v5 export from a 5G mobile core N3/N6 switch sampling GTP-U user plane subscriber traffic.
// TOKENS: host, ip, mac, flow, sflow, agentip, subagentid, uptime, samples, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define 5G N3/N6 user-plane aggregation switch.
host upf_agg_sw {
    ip 172.29.10.1
    mac 00:1e:49:1d:0a:01
}

// INSTRUCTION: Define telco mobile core sFlow probe collector.
host telco_sflow_col {
    ip 172.29.10.100
    mac 00:1e:49:1d:0a:64
}

// INSTRUCTION: Export sFlow v5 samples transported over MPLS label 3010.
flow sflow_5g_upf(sw, col) {
    sw -> col sflow agentip 172.29.10.1 subagentid 3 uptime 12800000 samples 20 mpls 3010 exp 4 bos 1 mplsttl 64
}

// INSTRUCTION: Compile the 5G UPF user-plane sFlow sampling scenario.
compile {
    sflow_5g_upf(upf_agg_sw, telco_sflow_col)
}
