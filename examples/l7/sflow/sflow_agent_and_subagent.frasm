// PROMPT: sFlow v5 sample datagram with explicit agent IP and sub-agent ID.
// TOKENS: host, ip, flow, s, sflow, agentip, subagentid, samples, compile

// INSTRUCTION: Define client endpoint.
host client { ip 10.0.0.1 }

// INSTRUCTION: Define server endpoint.
host server { ip 10.0.0.250 }

// INSTRUCTION: Define application traffic flow.
flow sflow_subagent(c, s) {
    c -> s sflow agentip 10.0.0.1 subagentid 5 samples 25
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    sflow_subagent(client, server)
}
