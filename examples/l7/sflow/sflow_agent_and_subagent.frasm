// sFlow v5 sample datagram with explicit agent IP and sub-agent ID.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (sFlow v5,
// UDP 6343).
// Wireshark: sflow

host client { ip 10.0.0.1 }

host server { ip 10.0.0.250 }

flow sflow_subagent(c, s) {
    c -> s sflow agentip 10.0.0.1 subagentid 5 samples 25
}

compile {
    sflow_subagent(client, server)
}
