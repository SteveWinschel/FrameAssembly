// sFlow v5 telemetry export from a core route reflector switch sampling
// inter-AS peering interfaces.
// Wireshark: sflow

host peering_switch {
    ip 198.51.100.10
    mac 00:21:59:64:00:0a
}

host te_sflow_col {
    ip 198.51.100.240
    mac 00:21:59:64:00:f0
}

flow sflow_peering_export(sw, col) {
    sw -> col sflow agentip 198.51.100.10 subagentid 10 uptime 17280000 samples 8
}

compile {
    sflow_peering_export(peering_switch, te_sflow_col)
}
