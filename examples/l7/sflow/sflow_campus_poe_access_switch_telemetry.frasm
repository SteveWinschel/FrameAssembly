// sFlow v5 export from a campus PoE access switch reporting wireless AP
// uplink traffic samples.
// Encapsulation and QoS markings: 802.1Q VLAN 25, 802.1p priority 2.
// Wireshark: sflow && vlan.id == 25

host poe_access_sw {
    ip 10.25.10.2
    mac 00:19:aa:19:0a:02
}

host campus_nms {
    ip 10.25.0.100
    mac 00:19:aa:19:00:64
}

flow sflow_campus_poe(sw, nms) {
    sw -> nms sflow agentip 10.25.10.2 subagentid 1 uptime 4320000 samples 4 vlan 25 pcp 2
}

compile {
    sflow_campus_poe(poe_access_sw, campus_nms)
}
