// DDoS mitigation scrubbing trigger driven by high-sample-count sFlow burst
// datagrams.
// Encapsulation and QoS markings: DSCP 48.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: sflow

host border_rtr { ip 10.99.63.1 }

host ddos_detector { ip 10.99.63.10 }

flow sflow_ddos_burst(rtr, det) {
    rtr -> det sflow agentip 10.99.63.1 subagentid 1 uptime 900100 samples 32 dscp 48 ttl 64 wait 2ms
    rtr -> det sflow agentip 10.99.63.1 subagentid 1 uptime 900102 samples 64 dscp 48 ttl 64 wait 2ms
    rtr -> det sflow agentip 10.99.63.1 subagentid 1 uptime 900104 samples 128 dscp 48 ttl 64
}

compile {
    sflow_ddos_burst(border_rtr, ddos_detector)
}
