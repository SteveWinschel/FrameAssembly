// Minimal 2-block sFlow v5 starter emitting automatic protocol defaults
// directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (sFlow v5,
// UDP 6343).
// Wireshark: sflow

host leaf_sw { ip 10.63.43.1 mac 00:1c:73:63:43:01 }

host sflow_coll { ip 10.63.43.100 mac 00:1c:73:63:43:64 }

compile {
    leaf_sw -> sflow_coll sflow
}
