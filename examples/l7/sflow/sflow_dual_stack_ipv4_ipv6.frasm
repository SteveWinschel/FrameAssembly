// PROMPT: Dual-stack IPv4 and IPv6 sFlow v5 telemetry export using a shared polymorphic flow.
// TOKENS: host, ip, flow, sflow, subagentid, uptime, samples, dscp, ttl, flowlabel, compile

// INSTRUCTION: Define IPv4 switch exporter and sFlow collector.
host sflow_v4_sw { ip 172.16.63.1 }
// INSTRUCTION: Define IPv4 sFlow collector endpoint.
host sflow_v4_coll { ip 172.16.63.100 }

// INSTRUCTION: Define IPv6 switch exporter and sFlow collector.
host sflow_v6_sw { ip 2001:db8:6343::1 }
// INSTRUCTION: Define IPv6 sFlow collector endpoint.
host sflow_v6_coll { ip 2001:db8:6343::100 }

// INSTRUCTION: Define polymorphic sFlow export relying on automatic source IP agent derivation.
flow sflow_dual_stack(sw, coll) {
    sw -> coll sflow subagentid 10 uptime 360000 samples 2 dscp 16 ttl 64 flowlabel 0x63430
}

// INSTRUCTION: Compile dual-stack sFlow export over IPv4 and IPv6.
compile {
    sflow_dual_stack(sflow_v4_sw, sflow_v4_coll)
    sflow_dual_stack(sflow_v6_sw, sflow_v6_coll)
}
