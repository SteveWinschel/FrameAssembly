// PROMPT: sFlow v5 telemetry from an EVPN-VXLAN leaf VTEP switch sampling encapsulated tenant overlay frames.
// TOKENS: host, ip, mac, flow, sflow, agentip, subagentid, uptime, samples, wait, ms, compile

// INSTRUCTION: Define EVPN-VXLAN leaf VTEP switch.
host vtep_leaf_01 {
    ip 10.180.1.11
    mac 00:1c:73:b4:01:0b
}

// INSTRUCTION: Define EVPN fabric visibility sFlow collector.
host evpn_collector {
    ip 10.180.0.200
    mac 00:1c:73:b4:00:c8
}

// INSTRUCTION: Export sFlow v5 samples from ASIC pipeline sub-agents 0 and 1.
flow sflow_evpn_vtep(vtep, col) {
    vtep -> col sflow agentip 10.180.1.11 subagentid 0 uptime 3600000 samples 10 wait 10ms
    vtep -> col sflow agentip 10.180.1.11 subagentid 1 uptime 3600010 samples 10
}

// INSTRUCTION: Compile the EVPN-VXLAN leaf VTEP sFlow sampling scenario.
compile {
    sflow_evpn_vtep(vtep_leaf_01, evpn_collector)
}
