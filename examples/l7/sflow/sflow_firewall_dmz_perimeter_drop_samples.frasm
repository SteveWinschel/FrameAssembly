// sFlow v5 dropped-packet notification samples exported from a perimeter DMZ
// switch to a SIEM.
// Encapsulation and QoS markings: 802.1Q VLAN 199, 802.1p priority 5.
// Wireshark: sflow && vlan.id == 199

host dmz_perim_sw {
    ip 10.199.1.1
    mac 00:1b:17:c7:01:01
}

host siem_sflow_col {
    ip 10.199.1.200
    mac 00:1b:17:c7:01:c8
}

flow sflow_dmz_drops(sw, siem) {
    sw -> siem sflow agentip 10.199.1.1 subagentid 21 uptime 810000 samples 15 vlan 199 pcp 5 dei 0
    sw -> siem sflow agentip 10.199.1.1 subagentid 22 uptime 810050 samples 19 vlan 199 pcp 5 dei 0
}

compile {
    sflow_dmz_drops(dmz_perim_sw, siem_sflow_col)
}
