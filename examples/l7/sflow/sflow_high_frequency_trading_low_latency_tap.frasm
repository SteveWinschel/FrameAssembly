// sFlow v5 telemetry from an ultra-low-latency trading floor switch auditing
// market data bursts.
// Wireshark: sflow

host hft_switch {
    ip 10.44.1.1
    mac 00:0f:53:2c:01:01
}

host hft_recorder {
    ip 10.44.1.100
    mac 00:0f:53:2c:01:64
}

flow sflow_hft_microburst(sw, rec) {
    sw -> rec sflow agentip 10.44.1.1 subagentid 0 uptime 105000 samples 40 hexpayload "01005e000101000f532c01010800"
}

compile {
    sflow_hft_microburst(hft_switch, hft_recorder)
}
