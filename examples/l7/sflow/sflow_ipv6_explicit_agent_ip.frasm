// IPv6 data center switch exporting sFlow with an IPv6 AGENT_IP address
// (Address Type 2).
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: sflow

host v6_leaf { ip 2001:db8:dc:1::1 mac 00:1c:73:dc:01:01 }

host v6_collector { ip 2001:db8:dc:1::100 mac 00:1c:73:dc:01:64 }

flow sflow_ipv6_agent_addr(sw, coll) {
    sw -> coll sflow agentip 2001:db8:dc:ffff::1 subagentid 10 uptime 604800 samples 6 flowlabel 0x06343 ttl 64
}

compile {
    sflow_ipv6_agent_addr(v6_leaf, v6_collector)
}
