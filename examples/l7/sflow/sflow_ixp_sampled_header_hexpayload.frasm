// sFlow v5 datagram carrying raw sampled Ethernet frame header bytes via
// HEXPAYLOAD.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (sFlow v5,
// UDP 6343).
// Wireshark: sflow

host ixp_switch { ip 198.51.100.1 }

host ixp_collector { ip 198.51.100.250 }

flow sflow_raw_header(sw, coll) {
    sw -> coll sflow agentip 198.51.100.1 subagentid 1 uptime 12345678 samples 1 hexpayload "000000010000001800000001000005dc000000000000000e"
}

compile {
    sflow_raw_header(ixp_switch, ixp_collector)
}
