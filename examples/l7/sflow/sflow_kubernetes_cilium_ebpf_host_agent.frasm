// Host sFlow (hsFlowd) agent on a Kubernetes worker node exporting container
// network packet samples.
// Wireshark: sflow

host hsflowd_node {
    ip 10.240.12.5
    mac 02:42:0a:f0:0c:05
}

host sflow_gateway {
    ip 10.240.0.50
    mac 02:42:0a:f0:00:32
}

flow sflow_k8s_hsflowd(node, gw) {
    node -> gw sflow agentip 10.240.12.5 subagentid 100 uptime 604800 samples 6 payload "hsflowd-k8s-pod-sample"
}

compile {
    sflow_k8s_hsflowd(hsflowd_node, sflow_gateway)
}
