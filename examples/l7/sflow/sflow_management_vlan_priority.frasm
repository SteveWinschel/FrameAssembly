// PROMPT: Out-of-band management VLAN 634 sFlow export with 802.1p priority tagging.
// TOKENS: host, ip, mac, flow, sflow, agentip, subagentid, uptime, samples, vlan, pcp, dei, dscp, compile

// INSTRUCTION: Define data center switch on telemetry VLAN 634.
host dc_switch { ip 10.63.0.5 mac 00:1c:73:00:63:05 }

// INSTRUCTION: Define telemetry analyzer on VLAN 634.
host dc_analyzer { ip 10.63.0.200 mac 00:1c:73:00:63:c8 }

// INSTRUCTION: Define VLAN-tagged sFlow datagram with CS2 DSCP 16.
flow sflow_vlan_export(sw, mon) {
    sw -> mon sflow agentip 10.63.0.5 subagentid 3 uptime 125000 samples 3 vlan 634 pcp 2 dei 0 dscp 16
}

// INSTRUCTION: Compile VLAN 634 sFlow export.
compile {
    sflow_vlan_export(dc_switch, dc_analyzer)
}
