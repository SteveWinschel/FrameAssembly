// sFlow v5 telemetry from a Metro Ethernet G.8032 ring node encapsulated in
// QinQ service provider tags.
// Encapsulation and QoS markings: 802.1ad QinQ outer 400 / inner 50.
// Wireshark: sflow && vlan

host metro_ring_sw {
    ip 172.18.50.1
    mac 00:15:17:12:32:01
}

host carrier_col {
    ip 172.18.50.250
    mac 00:15:17:12:32:fa
}

flow sflow_metro_ring(sw, col) {
    sw -> col sflow agentip 172.18.50.1 subagentid 7 uptime 25920000 samples 14 qinq 400 innervlan 50
}

compile {
    sflow_metro_ring(metro_ring_sw, carrier_col)
}
