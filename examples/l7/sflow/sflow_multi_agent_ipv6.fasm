// PROMPT: sFlow v5 collector datagram sent across an IPv6 management underlay.
// TOKENS: host, ip, flow, s, sflow, agentip, samples, uptime, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8:1::1 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8:1::254 }

// INSTRUCTION: Define application traffic flow.
flow sflow_v6(c, s) {
    c -> s sflow agentip 10.200.1.1 samples 5 uptime 120000
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    sflow_v6(client, server)
}
