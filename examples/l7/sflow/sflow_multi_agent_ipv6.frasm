// sFlow v5 collector datagram sent across an IPv6 management underlay.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: sflow

host client { ip 2001:db8:1::1 }

host server { ip 2001:db8:1::254 }

flow sflow_v6(c, s) {
    c -> s sflow agentip 10.200.1.1 samples 5 uptime 120000
}

compile {
    sflow_v6(client, server)
}
