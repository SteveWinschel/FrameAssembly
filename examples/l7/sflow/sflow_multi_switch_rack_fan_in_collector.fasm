// PROMPT: Three top-of-rack switches exporting sFlow v5 datagrams into a shared rack telemetry collector.
// TOKENS: host, ip, flow, sflow, agentip, subagentid, uptime, samples, compile

// INSTRUCTION: Define rack 1 top-of-rack switch.
host tor_rack_01 { ip 10.160.1.1 }

// INSTRUCTION: Define rack 2 top-of-rack switch.
host tor_rack_02 { ip 10.160.2.1 }

// INSTRUCTION: Define rack 3 top-of-rack switch.
host tor_rack_03 { ip 10.160.3.1 }

// INSTRUCTION: Define shared row sFlow collector.
host row_collector { ip 10.160.0.250 }

// INSTRUCTION: Export sFlow v5 sample datagram from any rack switch to the row collector.
flow sflow_rack_report(tor, col) {
    tor -> col sflow agentip 10.160.0.1 subagentid 1 uptime 500000 samples 10
}

// INSTRUCTION: Compile fan-in sFlow exports from all three rack switches.
compile {
    sflow_rack_report(tor_rack_01, row_collector)
    sflow_rack_report(tor_rack_02, row_collector)
    sflow_rack_report(tor_rack_03, row_collector)
}
