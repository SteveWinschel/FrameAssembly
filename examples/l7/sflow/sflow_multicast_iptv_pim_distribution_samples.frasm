// PROMPT: sFlow v5 export from a video headend switch sampling multicast IPTV PIM-SM video distribution streams.
// TOKENS: host, ip, mac, flow, sflow, agentip, subagentid, uptime, samples, dscp, compile

// INSTRUCTION: Define broadcast video headend multicast switch.
host iptv_headend_sw {
    ip 10.110.1.1
    mac 00:1b:21:6e:01:01
}

// INSTRUCTION: Define broadcast quality monitoring sFlow collector.
host iptv_monitor {
    ip 10.110.1.200
    mac 00:1b:21:6e:01:c8
}

// INSTRUCTION: Export sFlow v5 packet samples of high-bitrate IPTV video streams.
flow sflow_iptv_multicast(sw, mon) {
    sw -> mon sflow agentip 10.110.1.1 subagentid 8 uptime 51840000 samples 24 dscp 34
}

// INSTRUCTION: Compile the multicast IPTV headend sFlow monitoring scenario.
compile {
    sflow_iptv_multicast(iptv_headend_sw, iptv_monitor)
}
