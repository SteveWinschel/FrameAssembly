// PROMPT: sFlow export to a secondary collector listening on non-standard UDP port 16343.
// TOKENS: host, ip, flow, sflow, agentip, subagentid, uptime, samples, srcport, dstport, df, ipid, compile

// INSTRUCTION: Define hypervisor Open vSwitch sFlow agent.
host ovs_agent { ip 172.28.10.15 }

// INSTRUCTION: Define secondary sFlow collector on UDP port 16343.
host sec_collector { ip 172.28.10.200 }

// INSTRUCTION: Define sFlow datagram with custom UDP ports and DF flag.
flow sflow_custom_port(ovs, coll) {
    ovs -> coll sflow agentip 172.28.10.15 subagentid 500 uptime 72000 samples 3 srcport 56343 dstport 16343 df ipid 6343
}

// INSTRUCTION: Compile custom-port Open vSwitch sFlow export.
compile {
    sflow_custom_port(ovs_agent, sec_collector)
}
