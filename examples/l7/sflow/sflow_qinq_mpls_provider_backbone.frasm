// Service provider core router exporting sFlow over QinQ and MPLS transport
// tunnel.
// Encapsulation and QoS markings: 802.1ad QinQ outer 2500 / inner 634, MPLS
// label 63430.
// Wireshark: (sflow && vlan) && mpls

host pe_exporter { ip 100.64.63.1 }

host noc_sflow { ip 100.64.63.250 }

flow sflow_wan_mpls(pe, noc) {
    pe -> noc sflow agentip 100.64.63.1 subagentid 100 uptime 999000 samples 10 qinq 2500 innervlan 634 mpls 63430 exp 2 bos 1 mplsttl 64
}

compile {
    sflow_wan_mpls(pe_exporter, noc_sflow)
}
