// PROMPT: sFlow v5 datagram exported directly from a SmartNIC DPU embedded switch sampling PCIe VF traffic.
// TOKENS: host, ip, mac, flow, sflow, agentip, subagentid, uptime, samples, dscp, compile

// INSTRUCTION: Define bare-metal server SmartNIC DPU sFlow agent.
host smartnic_dpu {
    ip 10.195.4.10
    mac 00:02:c9:c3:04:0a
}

// INSTRUCTION: Define cloud infrastructure telemetry collector.
host cloud_telemetry {
    ip 10.195.0.10
    mac 00:02:c9:c3:00:0a
}

// INSTRUCTION: Export hardware-offloaded sFlow samples from DPU eswitch sub-agent 2.
flow sflow_dpu_offload(dpu, col) {
    dpu -> col sflow agentip 10.195.4.10 subagentid 2 uptime 720000 samples 32 dscp 18
}

// INSTRUCTION: Compile the SmartNIC DPU hardware offload sFlow scenario.
compile {
    sflow_dpu_offload(smartnic_dpu, cloud_telemetry)
}
