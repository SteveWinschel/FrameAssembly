// PROMPT: sFlow v5 network sampling agent datagram exporting packet samples.
// TOKENS: HOST, IP, FLOW, SFLOW, AGENT_IP, SAMPLES, UPTIME, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 172.16.0.1 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 172.16.0.100 }

// INSTRUCTION: Define application traffic flow.
FLOW sflow_sample(c, s) {
    c -> s SFLOW AGENT_IP 172.16.0.1 SAMPLES 10 UPTIME 360000
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    sflow_sample(client, server)
}
