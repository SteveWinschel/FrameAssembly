// sFlow v5 network sampling agent datagram exporting packet samples.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (sFlow v5,
// UDP 6343).
// Wireshark: sflow

host client { ip 172.16.0.1 }

host server { ip 172.16.0.100 }

flow sflow_sample(c, s) {
    c -> s sflow agentip 172.16.0.1 samples 10 uptime 360000
}

compile {
    sflow_sample(client, server)
}
