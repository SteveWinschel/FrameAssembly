// sFlow v5 export from an SD-WAN branch appliance sampling SaaS breakout
// traffic over broadband links.
// Timing: pauses 20ms after each marked packet before sending the next frame.
// Wireshark: sflow

host sdwan_branch {
    ip 10.132.15.1
    mac 00:18:0a:84:0f:01
}

host sdwan_analytics {
    ip 10.132.0.50
    mac 00:18:0a:84:00:32
}

flow sflow_sdwan_edge(edge, ana) {
    edge -> ana sflow agentip 10.132.15.1 subagentid 1 uptime 288000 samples 6 wait 20ms
    edge -> ana sflow agentip 10.132.15.1 subagentid 1 uptime 288020 samples 9
}

compile {
    sflow_sdwan_edge(sdwan_branch, sdwan_analytics)
}
