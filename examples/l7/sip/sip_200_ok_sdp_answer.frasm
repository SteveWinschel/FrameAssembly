// SIP 200 OK response accepting call setup with media session description
// body.
// Wireshark: sip

host client { ip 192.168.1.10 }

host server { ip 192.168.1.1 }

flow sip_ok(c, s) {
    c <- s sip status 200 reason "OK" contenttype "application/sdp" body "v=0\r\no=bob 2890844526 2890844526 IN IP4 192.168.1.1"
}

compile {
    sip_ok(client, server)
}
