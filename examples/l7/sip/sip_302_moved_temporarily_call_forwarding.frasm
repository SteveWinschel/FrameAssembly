// PROMPT: SIP 302 Moved Temporarily call forwarding redirecting incoming INVITE to mobile voicemail URI.
// TOKENS: host, ip, flow, sip, invite, uri, from, to, callid, cseq, wait, ms, status, reason, contact, ack, compile

// INSTRUCTION: Define originating SIP trunk proxy.
host orig_proxy {
    ip 10.22.15.10
}

// INSTRUCTION: Define user agent returning 302 redirect to voicemail server.
host redirect_uas {
    ip 10.22.15.50
}

// INSTRUCTION: Define voicemail media server receiving redirected INVITE.
host voicemail_srv {
    ip 10.22.15.99
}

// INSTRUCTION: Define initial INVITE redirected via 302 Moved Temporarily and ACK.
flow sip_302_redirect(p, uas) {
    p -> uas sip invite uri "sip:bob@10.22.15.50" from "sip:alice@10.22.15.10" to "sip:bob@10.22.15.50" callid "fwd-302" cseq 1 wait 4ms
    p <- uas sip status 302 reason "Moved Temporarily" callid "fwd-302" cseq 1 contact "sip:bob-vm@10.22.15.99" wait 4ms
    p -> uas sip ack uri "sip:bob@10.22.15.50" callid "fwd-302" cseq 1
}

// INSTRUCTION: Define follow-up INVITE sent to the Contact URI on the voicemail server.
flow sip_vm_connect(p, vm) {
    p -> vm sip invite uri "sip:bob-vm@10.22.15.99" from "sip:alice@10.22.15.10" to "sip:bob-vm@10.22.15.99" callid "fwd-302-vm" cseq 1 wait 4ms
    p <- vm sip status 200 reason "OK" callid "fwd-302-vm" cseq 1
}

// INSTRUCTION: Compile the SIP 302 call forwarding scenario.
compile {
    sip_302_redirect(orig_proxy, redirect_uas)
    sip_vm_connect(orig_proxy, voicemail_srv)
}
