// SIP INVITE offering unsupported G.729 audio codec rejected with 488 Not
// Acceptable Here.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: sip

host g729_gateway {
    ip 10.35.12.40
}

host hd_bridge {
    ip 10.35.12.1
}

flow sip_488_codec_mismatch(c, s) {
    c -> s sip invite uri "sip:conf@10.35.12.1" from "sip:gw@10.35.12.40" to "sip:conf@10.35.12.1" callid "codec-488" cseq 1 contenttype "application/sdp" body "v=0
m=audio 5004 RTP/AVP 18" wait 4ms
    c <- s sip status 488 reason "Not Acceptable Here" callid "codec-488" cseq 1 wait 4ms
    c -> s sip ack uri "sip:conf@10.35.12.1" callid "codec-488" cseq 1
}

compile {
    sip_488_codec_mismatch(g729_gateway, hd_bridge)
}
