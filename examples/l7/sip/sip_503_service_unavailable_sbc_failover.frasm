// PROMPT: Primary SIP Session Border Controller returning 503 Service Unavailable triggering failover to backup SBC.
// TOKENS: host, ip, flow, pri, sip, invite, uri, from, to, callid, cseq, wait, ms, status, reason, ack, compile

// INSTRUCTION: Define enterprise call router host.
host call_router {
    ip 10.75.0.10
}

// INSTRUCTION: Define overloaded primary SBC returning 503.
host sbc_primary {
    ip 10.75.0.1
}

// INSTRUCTION: Define standby secondary SBC accepting failover call.
host sbc_backup {
    ip 10.75.0.2
}

// INSTRUCTION: Define primary SBC rejection with 503 Service Unavailable.
flow sip_try_primary(c, pri) {
    c -> pri sip invite uri "sip:out@10.75.0.1" from "sip:rtr@10.75.0.10" to "sip:out@10.75.0.1" callid "sbc-pri-503" cseq 1 wait 3ms
    c <- pri sip status 503 reason "Service Unavailable" callid "sbc-pri-503" cseq 1 wait 3ms
    c -> pri sip ack uri "sip:out@10.75.0.1" callid "sbc-pri-503" cseq 1
}

// INSTRUCTION: Define immediate failover INVITE to secondary SBC succeeding with 200 OK.
flow sip_failover_backup(c, bak) {
    c -> bak sip invite uri "sip:out@10.75.0.2" from "sip:rtr@10.75.0.10" to "sip:out@10.75.0.2" callid "sbc-bak-200" cseq 1 wait 3ms
    c <- bak sip status 200 reason "OK" callid "sbc-bak-200" cseq 1
}

// INSTRUCTION: Compile primary SBC 503 failure and secondary SBC failover.
compile {
    sip_try_primary(call_router, sbc_primary)
    sip_failover_backup(call_router, sbc_backup)
}
