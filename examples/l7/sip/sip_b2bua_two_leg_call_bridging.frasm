// Back-to-Back User Agent (B2BUA) bridging inbound A-leg SIP INVITE to
// outbound B-leg SIP INVITE.
// Timing: runs 2 cycles in compile using post-packet waits (4ms).
// Wireshark: sip

host leg_a_caller {
    ip 10.130.1.10
}

host b2bua_core {
    ip 10.130.1.1
}

host leg_b_agent {
    ip 10.130.1.20
}

flow sip_dialog_leg(src, dst) {
    src -> dst sip invite uri "sip:bridge@10.130.1.1" from "sip:caller@10.130.1.10" to "sip:agent@10.130.1.20" callid "b2b-leg" cseq 1 wait 4ms
    src <- dst sip status 200 reason "OK" callid "b2b-leg" cseq 1 wait 4ms
    src -> dst sip ack uri "sip:bridge@10.130.1.1" callid "b2b-leg" cseq 1
}

compile {
    sip_dialog_leg(leg_a_caller, b2bua_core)
    sip_dialog_leg(b2bua_core, leg_b_agent)
}
