// SIP BYE message gracefully terminating active call dialog over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: sip

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow sip_bye(c, s) {
    c -> s sip bye from "sip:alice@pbx.corp" to "sip:bob@pbx.corp" callid "call-994827"
}

compile {
    sip_bye(client, server)
}
