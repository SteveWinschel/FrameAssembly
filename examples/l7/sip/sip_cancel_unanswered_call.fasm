// PROMPT: SIP CANCEL request terminating an unanswered call during 180 Ringing.
// TOKENS: host, ip, flow, s, sip, invite, from, to, callid, cseq, wait, ms, status, reason, cancel, method, uri, compile

// INSTRUCTION: Define caller canceling outbound attempt.
host canceling_caller { ip 10.33.1.25 }

// INSTRUCTION: Define call manager PBX.
host call_manager { ip 10.33.1.1 }

// INSTRUCTION: Define INVITE, Ringing, CANCEL, and Request Terminated teardown.
flow sip_cancel_flow(c, s) {
    c -> s sip invite from "sip:agent1@callcenter.com" to "sip:lead@sales.com" callid "cancel-3312" cseq 1 wait 10ms
    c <- s sip status 180 reason "Ringing" callid "cancel-3312" cseq 1 wait 15ms
    c -> s sip cancel from "sip:agent1@callcenter.com" to "sip:lead@sales.com" callid "cancel-3312" cseq 1 wait 5ms
    c <- s sip status 200 reason "OK" callid "cancel-3312" cseq 1 wait 5ms
    c <- s sip status 487 reason "Request Terminated" callid "cancel-3312" cseq 1 wait 5ms
    c -> s sip method "ACK" uri "sip:lead@sales.com" from "sip:agent1@callcenter.com" to "sip:lead@sales.com" callid "cancel-3312" cseq 1
}

// INSTRUCTION: Compile SIP call cancellation flow.
compile {
    sip_cancel_flow(canceling_caller, call_manager)
}
