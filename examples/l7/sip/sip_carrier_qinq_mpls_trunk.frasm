// SIP trunking across carrier network with 802.1ad QinQ and MPLS label
// encapsulation.
// Encapsulation and QoS markings: 802.1ad QinQ outer 200 / inner 120, MPLS
// label 50601, 50602.
// Wireshark: (sip && vlan) && mpls

host edge_sbc { ip 198.51.100.14 }

host carrier_ss { ip 198.51.100.1 }

flow sip_carrier_mpls(c, s) {
    c -> s sip invite from "sip:trunk@enterprise.net" to "sip:did@carrier.tel" callid "mpls-trunk-99" cseq 1 qinq 200 innervlan 120 mpls 50601 exp 5 bos 1 mplsttl 64
    c <- s sip status 200 reason "OK" callid "mpls-trunk-99" cseq 1 qinq 200 innervlan 120 mpls 50602 exp 5 bos 1 mplsttl 63
}

compile {
    sip_carrier_mpls(edge_sbc, carrier_ss)
}
