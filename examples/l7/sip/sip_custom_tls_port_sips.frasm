// PROMPT: Secure SIP SIPS signaling exchange operating on custom port 5061.
// TOKENS: host, ip, flow, s, sip, invite, from, to, callid, cseq, srcport, dstport, wait, ms, status, reason, compile

// INSTRUCTION: Define secure workstation softphone.
host secure_phone { ip 10.61.0.88 }

// INSTRUCTION: Define encrypted TLS SIP proxy server.
host secure_proxy { ip 10.61.0.1 }

// INSTRUCTION: Define SIP session exchange on port 5061.
flow sip_sips_custom(c, s) {
    c -> s sip invite from "sips:conf@finance.org" to "sips:board@finance.org" callid "sips-port-5061" cseq 1 srcport 55061 dstport 5061 wait 5ms
    c <- s sip status 200 reason "OK" callid "sips-port-5061" cseq 1 srcport 5061 dstport 55061
}

// INSTRUCTION: Compile custom port SIPS signaling flow.
compile {
    sip_sips_custom(secure_phone, secure_proxy)
}
