// Minimal 2-block SIP starter sending a default RFC 3261 INVITE on UDP port 5060.
// Generates Via, From, To, Call-ID, and CSeq headers automatically without a flow block.
// Compile to test VoIP firewall rules or SIP ALG inspection.
// Wireshark: sip

host sip_phone { ip 10.80.1.51 mac 00:1a:2b:50:00:33 }
host pbx_proxy { ip 10.80.1.10 mac 00:1a:2b:50:00:0a }

compile {
    sip_phone -> pbx_proxy sip
}
