// Minimal 2-block SIP (RFC 3261) starter emitting automatic protocol defaults
// directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SIP (RFC
// 3261), UDP 5060).
// Wireshark: sip

host sip_client { ip 10.99.1.50 mac 00:0c:29:99:01:32 }

host sip_proxy { ip 10.99.1.1 mac 00:0c:29:99:01:01 }

compile {
    sip_client -> sip_proxy sip
}
