// Dual-stack IPv4 and IPv6 SIP signaling with one shared flow.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Runs the same flow definition across both IPv4 and IPv6 host pairs.
// Executes 2 sequential flow runs inside the compile block.
// Wireshark: sip

host sip_v4_caller { ip 172.24.1.10 }
host sip_v4_callee { ip 172.24.1.1 }

host sip_v6_caller { ip 2001:db8:5060::10 }
host sip_v6_callee { ip 2001:db8:5060::1 }

flow sip_dual_stack(c, s) {
    c -> s sip invite from "sip:caller@ngn.org" to "sip:callee@ngn.org" callid "dual-stack-88" cseq 1 dscp 46 ttl 64 flowlabel 0x50600
    c <- s sip status 200 reason "OK" callid "dual-stack-88" cseq 1 dscp 46 ttl 64 flowlabel 0x50600
}

compile {
    sip_dual_stack(sip_v4_caller, sip_v4_callee)
    sip_dual_stack(sip_v6_caller, sip_v6_callee)
}
