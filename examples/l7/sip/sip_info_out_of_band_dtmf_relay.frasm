// PROMPT: SIP INFO method (RFC 6086) carrying out-of-band DTMF digit press during active IVR call.
// TOKENS: host, ip, flow, s, sip, method, uri, from, to, callid, cseq, contenttype, body, wait, ms, status, reason, compile

// INSTRUCTION: Define customer softphone sending menu selection digit.
host softphone_ep {
    ip 10.90.4.33
}

// INSTRUCTION: Define interactive voice response (IVR) SIP server.
host ivr_server {
    ip 10.90.4.1
}

// INSTRUCTION: Define SIP INFO request carrying application/dtmf-relay body and 200 OK response.
flow sip_dtmf_info(c, s) {
    c -> s sip method "INFO" uri "sip:ivr@10.90.4.1" from "sip:cust@10.90.4.33" to "sip:ivr@10.90.4.1" callid "ivr-call-42" cseq 5 contenttype "application/dtmf-relay" body "Signal=5
Duration=160" wait 4ms
    c <- s sip status 200 reason "OK" callid "ivr-call-42" cseq 5
}

// INSTRUCTION: Compile the SIP INFO out-of-band DTMF relay scenario.
compile {
    sip_dtmf_info(softphone_ep, ivr_server)
}
