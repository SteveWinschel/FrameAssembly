// PROMPT: SIP pager-mode instant messaging using MESSAGE method and 200 OK acknowledgment.
// TOKENS: host, ip, flow, s, sip, method, uri, from, to, callid, cseq, wait, ms, status, reason, compile

// INSTRUCTION: Define emergency dispatch operator terminal.
host dispatch_op { ip 10.91.2.14 }

// INSTRUCTION: Define mobile field technician terminal.
host field_tech { ip 10.91.2.99 }

// INSTRUCTION: Define bidirectional SIP MESSAGE pager communication.
flow sip_instant_msg(c, s) {
    c -> s sip method "MESSAGE" uri "sip:tech@field.corp" from "sip:dispatch@hq.corp" to "sip:tech@field.corp" callid "msg-alert-101" cseq 1 wait 5ms
    c <- s sip status 200 reason "OK" callid "msg-alert-101" cseq 1 wait 10ms
    c <- s sip method "MESSAGE" uri "sip:dispatch@hq.corp" from "sip:tech@field.corp" to "sip:dispatch@hq.corp" callid "msg-reply-102" cseq 1 wait 5ms
    c -> s sip status 200 reason "OK" callid "msg-reply-102" cseq 1
}

// INSTRUCTION: Compile SIP instant messaging flow.
compile {
    sip_instant_msg(dispatch_op, field_tech)
}
