// PROMPT: SIP call establishment with 100 Trying and 180 Ringing provisional status responses.
// TOKENS: HOST, IP, FLOW, SIP, INVITE, FROM, TO, CALL_ID, CSEQ, WAIT, STATUS, REASON, COMPILE

// INSTRUCTION: Define outbound caller user agent.
HOST caller_ua { IP 10.22.4.15 }

// INSTRUCTION: Define telephony gateway.
HOST telco_gw { IP 10.22.4.1 }

// INSTRUCTION: Define INVITE with 100 Trying and 180 Ringing provisional responses.
FLOW sip_call_progress(c, s) {
    c -> s SIP INVITE FROM "sip:carol@voice.net" TO "sip:dave@voice.net" CALL_ID "call-88190-bx2" CSEQ 101 WAIT 2ms
    c <- s SIP STATUS 100 REASON "Trying" CALL_ID "call-88190-bx2" CSEQ 101 WAIT 5ms
    c <- s SIP STATUS 180 REASON "Ringing" CALL_ID "call-88190-bx2" CSEQ 101
}

// INSTRUCTION: Compile SIP call progress flow.
COMPILE {
    sip_call_progress(caller_ua, telco_gw)
}
