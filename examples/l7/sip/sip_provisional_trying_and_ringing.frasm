// SIP call establishment with 100 Trying and 180 Ringing provisional status
// responses.
// Timing: uses post-packet wait delays (2ms, 5ms) between frames.
// Wireshark: sip

host caller_ua { ip 10.22.4.15 }

host telco_gw { ip 10.22.4.1 }

flow sip_call_progress(c, s) {
    c -> s sip invite from "sip:carol@voice.net" to "sip:dave@voice.net" callid "call-88190-bx2" cseq 101 wait 2ms
    c <- s sip status 100 reason "Trying" callid "call-88190-bx2" cseq 101 wait 5ms
    c <- s sip status 180 reason "Ringing" callid "call-88190-bx2" cseq 101
}

compile {
    sip_call_progress(caller_ua, telco_gw)
}
