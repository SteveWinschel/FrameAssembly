// PROMPT: SIP REFER method (RFC 3515) executing attended call transfer with 202 Accepted and NOTIFY.
// TOKENS: host, ip, flow, s, sip, method, uri, from, to, callid, cseq, contact, wait, ms, status, reason, body, compile

// INSTRUCTION: Define receptionist console transferring active call.
host reception_phone {
    ip 192.168.30.10
}

// INSTRUCTION: Define enterprise SIP call manager server.
host call_manager {
    ip 192.168.30.1
}

// INSTRUCTION: Define SIP REFER request, 202 Accepted response, and sipfrag NOTIFY confirmation.
flow sip_refer_transfer(c, s) {
    c -> s sip method "REFER" uri "sip:ext305@192.168.30.1" from "sip:oper@192.168.30.10" to "sip:caller@192.168.30.1" callid "xfer-5501" cseq 10 contact "sip:oper@192.168.30.10" wait 4ms
    c <- s sip status 202 reason "Accepted" callid "xfer-5501" cseq 10 wait 4ms
    c <- s sip method "NOTIFY" uri "sip:oper@192.168.30.10" callid "xfer-5501" cseq 11 body "SIP/2.0 200 OK" wait 4ms
    c -> s sip status 200 reason "OK" callid "xfer-5501" cseq 11
}

// INSTRUCTION: Compile the SIP REFER attended call transfer flow.
compile {
    sip_refer_transfer(reception_phone, call_manager)
}
