// SIP user agent registration exchange using REGISTER method and 200 OK
// response.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: sip

host desk_phone { ip 192.168.10.50 }

host sip_registrar { ip 192.168.10.1 }

flow sip_register(c, s) {
    c -> s sip method "REGISTER" uri "sip:pbx.enterprise.com" from "sip:alice@pbx.enterprise.com" to "sip:alice@pbx.enterprise.com" callid "reg-44819-ax9" cseq 1 wait 5ms
    c <- s sip status 200 reason "OK" callid "reg-44819-ax9" cseq 1
}

compile {
    sip_register(desk_phone, sip_registrar)
}
