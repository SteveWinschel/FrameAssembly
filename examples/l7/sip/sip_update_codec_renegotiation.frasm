// SIP UPDATE method (RFC 3311) modifying media session parameters before call
// answer.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: sip

host sbc_edge {
    ip 10.110.8.15
}
host ims_pcscf {
    ip 10.110.8.1
}
flow sip_update_media(c, s) {
    c -> s sip method "UPDATE" uri "sip:core@10.110.8.1" from "sip:sbc@10.110.8.15" to "sip:core@10.110.8.1"
        callid "upd-3311" cseq 3 contact "sip:sbc@10.110.8.15"
        contenttype "application/sdp" body "v=0
m=audio 6000 RTP/AVP 111" wait 4ms
    c <- s sip status 200 reason "OK" callid "upd-3311" cseq 3 contenttype "application/sdp" body "v=0
m=audio 7000 RTP/AVP 111"
}
compile {
    sip_update_media(sbc_edge, ims_pcscf)
}
