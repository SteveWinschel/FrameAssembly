// Server Message Block 2/3 file sharing dialect negotiation and session setup
// on TCP 445.
// SMB2 over NetBIOS TCP 445 with UTF-16LE share/file paths computed
// automatically.
// Wireshark: smb2

host smb_workstation { ip 192.168.20.10 }

host file_server { ip 192.168.20.2 }

flow smb_flow(w, s) {
    w -> s smb command negotiate
    w -> s smb command sessionsetup
}

compile {
    smb_flow(smb_workstation, file_server)
}
