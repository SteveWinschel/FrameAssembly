// PROMPT: SMB2 unauthorized share connection attempt returning NT status STATUS_ACCESS_DENIED.
// TOKENS: host, ip, flow, s, smb, command, sessionid, msgid, share, wait, ms, status, compile

// INSTRUCTION: Define guest workstation attempting restricted share access.
host guest_pc { ip 192.168.99.77 }

// INSTRUCTION: Define secure payroll storage vault.
host payroll_srv { ip 192.168.99.1 }

// INSTRUCTION: Define Tree Connect returning STATUS 3221225506 (0xC0000022 ACCESS_DENIED).
flow smb_access_denied(c, s) {
    c -> s smb command "treeconnect" sessionid 0x9000 msgid 5 share "\vault
estricted$" wait 5ms
    c <- s smb command "treeconnect" status 3221225506 sessionid 0x9000 msgid 5
}

// INSTRUCTION: Compile SMB2 access denied error rejection flow.
compile {
    smb_access_denied(guest_pc, payroll_srv)
}
