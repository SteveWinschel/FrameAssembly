// PROMPT: Administrative C$ hidden disk share connection and log file inspection by a security scanner.
// TOKENS: host, ip, mac, flow, s, smb, command, sessionid, msgid, share, status, treeid, wait, ms, filename, compile

// INSTRUCTION: Define the privileged vulnerability management scanner host.
host sec_scanner {
    ip 10.60.90.250
    mac 00:1a:2b:60:90:fa
}

// INSTRUCTION: Define the managed Windows Server target host.
host win_target {
    ip 10.60.90.14
    mac 00:1a:2b:60:90:14
}

// INSTRUCTION: Mount the administrative C$ share and read the WindowsUpdate.log file.
flow smb_admin_share(c, s) {
    c -> s smb command "treeconnect" sessionid 4400 msgid 1 share "\\10.60.90.14\C$"
    c <- s smb command "treeconnect" status 0 treeid 1 sessionid 4400 msgid 1 wait 1ms
    c -> s smb command "create" treeid 1 sessionid 4400 msgid 2 filename "Windows\WindowsUpdate.log"
    c <- s smb command "create" status 0 treeid 1 sessionid 4400 msgid 2 wait 1ms
    c -> s smb command "read" treeid 1 sessionid 4400 msgid 3
    c <- s smb command "read" status 0 treeid 1 sessionid 4400 msgid 3
}

// INSTRUCTION: Compile the administrative C$ share inspection flow.
compile {
    smb_admin_share(sec_scanner, win_target)
}
