// PROMPT: Branch office SMB2 document synchronization over MPLS WAN with DSCP AF21 and explicit TCP window sizing.
// TOKENS: host, ip, mac, flow, s, smb, command, treeid, sessionid, msgid, filename, mpls, dscp, window, status, wait, ms, payload, compile

// INSTRUCTION: Define the remote branch office client.
host branch_pc {
    ip 172.29.12.34
    mac 00:1a:2b:29:12:34
}

// INSTRUCTION: Define the headquarters central document repository server.
host hq_files {
    ip 172.29.1.10
    mac 00:1a:2b:29:01:10
}

// INSTRUCTION: Open and read a branch contract PDF over MPLS label 1640.
flow smb_wan_sync(c, s) {
    c -> s smb command "create" treeid 6 sessionid 2100 msgid 8 filename "contracts\branch12_lease.pdf" mpls 1640 dscp 18 window 65535
    c <- s smb command "create" status 0 treeid 6 sessionid 2100 msgid 8 mpls 1640 dscp 18 window 65535 wait 15ms
    c -> s smb command "read" treeid 6 sessionid 2100 msgid 9 mpls 1640 dscp 18 window 65535
    c <- s smb command "read" status 0 treeid 6 sessionid 2100 msgid 9 mpls 1640 dscp 18 window 65535 payload "%PDF-1.7 LEASE AGREEMENT"
}

// INSTRUCTION: Compile the branch WAN SMB2 synchronization flow.
compile {
    smb_wan_sync(branch_pc, hq_files)
}
