// SMB2 file handle creation and subsequent closure using CREATE and CLOSE
// commands.
// SMB2 over NetBIOS TCP 445 with NT status code(s): 0 (STATUS_SUCCESS).
// Timing: uses post-packet wait delays (5ms, 10ms) between frames.
// Wireshark: smb2

host backup_worker { ip 192.168.45.22 }

host nas_store { ip 192.168.45.2 }

flow smb_file_lifecycle(c, s) {
    c -> s smb command "create" treeid 1 sessionid 0x1000 msgid 10 filename "db_dump_2026.bak" wait 5ms
    c <- s smb command "create" status 0 treeid 1 sessionid 0x1000 msgid 10 wait 10ms
    c -> s smb command "close" treeid 1 sessionid 0x1000 msgid 11 wait 5ms
    c <- s smb command "close" status 0 treeid 1 sessionid 0x1000 msgid 11
}

compile {
    smb_file_lifecycle(backup_worker, nas_store)
}
