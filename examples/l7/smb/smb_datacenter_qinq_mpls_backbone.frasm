// SMB2 replication traffic traversing datacenter QinQ tags and MPLS transport
// labels.
// Encapsulation and QoS markings: 802.1ad QinQ outer 600 / inner 445, MPLS
// label 44501.
// SMB2 over NetBIOS TCP 445 with UTF-16LE share/file paths computed
// automatically.
// Wireshark: (smb2 && vlan) && mpls

host dc1_storage { ip 10.200.1.10 }

host dc2_storage { ip 10.200.2.10 }

flow smb_wan_replication(c, s) {
    c -> s smb command "write" treeid 5 sessionid 0x8000 msgid 900 qinq 600 innervlan 445 mpls 44501 exp 3 bos 1 mplsttl 64
}

compile {
    smb_wan_replication(dc1_storage, dc2_storage)
}
