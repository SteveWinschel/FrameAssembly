// PROMPT: SMB2 replication traffic traversing datacenter QinQ tags and MPLS transport labels.
// TOKENS: host, ip, flow, s, smb, command, treeid, sessionid, msgid, qinq, innervlan, mpls, exp, bos, mplsttl, compile

// INSTRUCTION: Define primary datacenter storage node.
host dc1_storage { ip 10.200.1.10 }

// INSTRUCTION: Define disaster recovery replica storage node.
host dc2_storage { ip 10.200.2.10 }

// INSTRUCTION: Define SMB2 replication WRITE with QinQ and MPLS carrier encapsulation.
flow smb_wan_replication(c, s) {
    c -> s smb command "write" treeid 5 sessionid 0x8000 msgid 900 qinq 600 innervlan 445 mpls 44501 exp 3 bos 1 mplsttl 64
}

// INSTRUCTION: Compile datacenter WAN MPLS SMB2 flow.
compile {
    smb_wan_replication(dc1_storage, dc2_storage)
}
