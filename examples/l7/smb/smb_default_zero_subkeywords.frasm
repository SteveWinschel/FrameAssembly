// PROMPT: Default Server Message Block SMB2 frame with zero sub-keywords on TCP port 445.
// TOKENS: host, ip, mac, flow, s, smb, compile

// INSTRUCTION: Define office workstation client.
host smb_client { ip 10.14.0.55 mac 00:50:56:14:00:37 }

// INSTRUCTION: Define enterprise file server.
host file_srv { ip 10.14.0.1 mac 00:50:56:14:00:01 }

// INSTRUCTION: Define flow sending default SMB frame.
flow smb_default(c, s) {
    c -> s smb
}

// INSTRUCTION: Compile default SMB frame scenario.
compile {
    smb_default(smb_client, file_srv)
}
