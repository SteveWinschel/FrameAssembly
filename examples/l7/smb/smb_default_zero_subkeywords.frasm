// Minimal 2-block SMB2 (MS-SMB2) starter emitting automatic protocol defaults
// directly from the compile block (zero flow wrapper).
// SMB2 over NetBIOS TCP 445 with UTF-16LE share/file paths computed
// automatically.
// Wireshark: smb2

host smb_client { ip 10.14.0.55 mac 00:50:56:14:00:37 }

host file_srv { ip 10.14.0.1 mac 00:50:56:14:00:01 }

compile {
    smb_client -> file_srv smb
}
