// PROMPT: SMB2 IPC$ hidden inter-process communication share connection for Distributed File System referral queries.
// TOKENS: host, ip, mac, flow, s, smb, command, sessionid, msgid, share, status, treeid, wait, ms, filename, compile

// INSTRUCTION: Define the domain client requesting DFS namespace resolution.
host dfs_client {
    ip 172.18.10.44
    mac 00:1a:2b:18:10:44
}

// INSTRUCTION: Define the Active Directory DFS root server.
host dfs_root {
    ip 172.18.10.5
    mac 00:1a:2b:18:10:05
}

// INSTRUCTION: Connect to the IPC$ share and open the dfsreferral named pipe.
flow smb_dfs_ipc(c, s) {
    c -> s smb command "treeconnect" sessionid 1024 msgid 1 share "\\dfs.corp.local\IPC$"
    c <- s smb command "treeconnect" status 0 treeid 1 sessionid 1024 msgid 1 wait 1ms
    c -> s smb command "create" treeid 1 sessionid 1024 msgid 2 filename "wkssvc"
    c <- s smb command "create" status 0 treeid 1 sessionid 1024 msgid 2
}

// INSTRUCTION: Compile the SMB2 IPC$ DFS referral flow.
compile {
    smb_dfs_ipc(dfs_client, dfs_root)
}
