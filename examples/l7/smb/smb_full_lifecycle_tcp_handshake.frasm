// Complete TCP 3-way handshake on port 445 followed by SMB2 Negotiate,
// Session Setup, Tree Connect, and Logoff.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// SMB2 over NetBIOS TCP 445 with NT status code(s): 0 (STATUS_SUCCESS).
// Overrides destination port to 445.
// Timing: uses post-packet wait delays (1ms, 2ms, 5ms) between frames.
// Wireshark: smb2

host pc_workstation { ip 192.168.1.105 mac 00:15:5d:01:00:69 }

host corp_storage { ip 192.168.1.10 mac 00:15:5d:01:00:0a }

flow smb_full_lifecycle(c, s) {
    c -> s tcp syn dstport 445
    c <- s tcp syn ack
    c -> s tcp ack wait 1ms
    c -> s smb command "negotiate" msgid 0 wait 2ms
    c <- s smb command "negotiate" status 0 msgid 0 wait 2ms
    c -> s smb command "sessionsetup" sessionid 0x1000 msgid 1 wait 2ms
    c <- s smb command "sessionsetup" status 0 sessionid 0x1000 msgid 1 wait 2ms
    c -> s smb command "treeconnect" treeid 1 sessionid 0x1000 msgid 2 share "\corp_storage\documents" wait 2ms
    c <- s smb command "treeconnect" status 0 treeid 1 sessionid 0x1000 msgid 2 wait 5ms
    c -> s smb command "logoff" sessionid 0x1000 msgid 3 wait 2ms
    c <- s smb command "logoff" status 0 sessionid 0x1000 msgid 3
}

compile {
    smb_full_lifecycle(pc_workstation, corp_storage)
}
