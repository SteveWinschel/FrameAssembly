// PROMPT: SMB3 over IPv6 Hyper-V virtual machine VHDX live storage read and write I/O operations.
// TOKENS: host, ip, mac, flow, s, smb, command, treeid, sessionid, msgid, filename, status, wait, ms, payload, compile

// INSTRUCTION: Define the Hyper-V compute node over IPv6.
host hyperv_node {
    ip 2001:db8:60:1::11
    mac 00:1a:2b:60:06:11
}

// INSTRUCTION: Define the Scale-Out File Server (SOFS) cluster node over IPv6.
host sofs_node {
    ip 2001:db8:60:1::2
    mac 00:1a:2b:60:06:02
}

// INSTRUCTION: Open a virtual hard disk file and execute synchronous write and read blocks.
flow smb_vhdx_io(c, s) {
    c -> s smb command "create" treeid 10 sessionid 5500 msgid 40 filename "vm_sql01_disk.vhdx"
    c <- s smb command "create" status 0 treeid 10 sessionid 5500 msgid 40 wait 1ms
    c -> s smb command "write" treeid 10 sessionid 5500 msgid 41 payload "VHDX_BLOCK_4096_SECTOR_DATA"
    c <- s smb command "write" status 0 treeid 10 sessionid 5500 msgid 41
}

// INSTRUCTION: Compile the IPv6 SMB3 Hyper-V storage flow.
compile {
    smb_vhdx_io(hyperv_node, sofs_node)
}
