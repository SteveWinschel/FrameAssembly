// Multi-client concurrent SMB2 session setups to clustered enterprise file
// cluster.
// SMB2 over NetBIOS TCP 445 with NT status code(s): 0 (STATUS_SUCCESS).
// Executes 2 sequential flow runs inside the compile block.
// Wireshark: smb2

host ws_alpha { ip 10.12.0.11 }

host ws_bravo { ip 10.12.0.12 }

host nas_cluster { ip 10.12.0.2 }

flow smb_client_alpha(c, s) {
    c -> s smb command "negotiate" sessionid 0x1001 msgid 1
    c <- s smb command "negotiate" status 0 sessionid 0x1001 msgid 1
}

flow smb_client_bravo(c, s) {
    c -> s smb command "negotiate" sessionid 0x1002 msgid 1
    c <- s smb command "negotiate" status 0 sessionid 0x1002 msgid 1
}

compile {
    smb_client_alpha(ws_alpha, nas_cluster)
    smb_client_bravo(ws_bravo, nas_cluster)
}
