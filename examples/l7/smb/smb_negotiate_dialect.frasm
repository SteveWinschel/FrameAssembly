// SMB2 Negotiate Protocol request querying supported dialect revisions.
// SMB2 over NetBIOS TCP 445 with UTF-16LE share/file paths computed
// automatically.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SMB2
// (MS-SMB2), TCP 445).
// Wireshark: smb2

host client { ip 192.168.1.50 }

host server { ip 192.168.1.1 }

flow smb_neg(c, s) {
    c -> s smb command "negotiate"
}

compile {
    smb_neg(client, server)
}
