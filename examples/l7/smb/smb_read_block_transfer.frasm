// SMB2 sequential block read query and server data response on TreeId 10.
// SMB2 over NetBIOS TCP 445 with NT status code(s): 0 (STATUS_SUCCESS).
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: smb2

host cad_workstation { ip 172.16.80.33 }

host eng_filesrv { ip 172.16.80.1 }

flow smb_read_stream(c, s) {
    c -> s smb command "read" treeid 10 sessionid 0x2400 msgid 101 wait 2ms
    c <- s smb command "read" status 0 treeid 10 sessionid 0x2400 msgid 101 wait 2ms
    c -> s smb command "read" treeid 10 sessionid 0x2400 msgid 102 wait 2ms
    c <- s smb command "read" status 0 treeid 10 sessionid 0x2400 msgid 102
}

compile {
    smb_read_stream(cad_workstation, eng_filesrv)
}
