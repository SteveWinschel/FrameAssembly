// PROMPT: Sequential multi-chunk SMB2 WRITE transfer uploading backup archive blocks with incrementing MSGIDs.
// TOKENS: host, ip, mac, flow, s, smb, command, treeid, sessionid, msgid, filename, status, wait, ms, payload, compile

// INSTRUCTION: Define the backup agent host streaming archive blocks.
host backup_agent {
    ip 10.60.70.20
    mac 00:1a:2b:60:70:20
}

// INSTRUCTION: Define the archival SMB vault appliance.
host backup_vault {
    ip 10.60.70.100
    mac 00:1a:2b:60:70:99
}

// INSTRUCTION: Create backup file and write two consecutive payload chunks before closing.
flow smb_chunked_write(c, s) {
    c -> s smb command "create" treeid 8 sessionid 9900 msgid 100 filename "db_full_20261025.bak"
    c <- s smb command "create" status 0 treeid 8 sessionid 9900 msgid 100 wait 1ms
    c -> s smb command "write" treeid 8 sessionid 9900 msgid 101 payload "CHUNK_01_HEADER_AND_SCHEMA"
    c <- s smb command "write" status 0 treeid 8 sessionid 9900 msgid 101 wait 1ms
    c -> s smb command "write" treeid 8 sessionid 9900 msgid 102 payload "CHUNK_02_TABLE_EXTENTS_EOF"
    c <- s smb command "write" status 0 treeid 8 sessionid 9900 msgid 102 wait 1ms
    c -> s smb command "close" treeid 8 sessionid 9900 msgid 103
}

// INSTRUCTION: Compile the sequential multi-chunk SMB2 write flow.
compile {
    smb_chunked_write(backup_agent, backup_vault)
}
