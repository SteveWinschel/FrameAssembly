// SMB2 Tree Connect request mounting network share over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// SMB2 over NetBIOS TCP 445 with UTF-16LE share/file paths computed
// automatically.
// Wireshark: smb2

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

flow smb_tree(c, s) {
    c -> s smb command "treeconnect" share "\\\\server\\public" sessionid 100020
}

compile {
    smb_tree(client, server)
}
