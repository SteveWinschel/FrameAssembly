// PROMPT: Active Directory SYSVOL Group Policy Object (GPO) gpt.ini read synchronization over SMB2.
// TOKENS: host, ip, mac, flow, s, smb, command, sessionid, msgid, share, status, treeid, wait, ms, filename, payload, compile

// INSTRUCTION: Define the domain-joined Windows endpoint refreshing Group Policy.
host domain_member {
    ip 10.60.40.115
    mac 00:1a:2b:60:40:15
}

// INSTRUCTION: Define the Primary Domain Controller hosting SYSVOL.
host pdc_server {
    ip 10.60.40.1
    mac 00:1a:2b:60:40:01
}

// INSTRUCTION: Connect to SYSVOL, read gpt.ini policy version, and close the file handle.
flow smb_gpo_sync(c, s) {
    c -> s smb command "treeconnect" sessionid 7700 msgid 1 share "\\corp.local\SYSVOL"
    c <- s smb command "treeconnect" status 0 treeid 9 sessionid 7700 msgid 1 wait 1ms
    c -> s smb command "create" treeid 9 sessionid 7700 msgid 2 filename "Policies\GPT.INI"
    c <- s smb command "create" status 0 treeid 9 sessionid 7700 msgid 2 wait 1ms
    c -> s smb command "read" treeid 9 sessionid 7700 msgid 3
    c <- s smb command "read" status 0 treeid 9 sessionid 7700 msgid 3 payload "[General]
Version=65543
"
    c -> s smb command "close" treeid 9 sessionid 7700 msgid 4
}

// INSTRUCTION: Compile the SYSVOL Group Policy SMB2 flow.
compile {
    smb_gpo_sync(domain_member, pdc_server)
}
