// SMB2 administrative IPC$ share connection and clean TREE_DISCONNECT
// teardown.
// SMB2 over NetBIOS TCP 445 with NT status code(s): 0 (STATUS_SUCCESS).
// Timing: uses post-packet wait delays (2ms, 5ms) between frames.
// Wireshark: smb2

host admin_console { ip 10.50.2.100 }

host domain_ctrl { ip 10.50.2.1 }

flow smb_ipc_tree(c, s) {
    c -> s smb command "treeconnect" treeid 100 sessionid 0x3000 msgid 20 share "\dc01\IPC$" wait 2ms
    c <- s smb command "treeconnect" status 0 treeid 100 sessionid 0x3000 msgid 20 wait 5ms
    c -> s smb command "treedisconnect" treeid 100 sessionid 0x3000 msgid 21 wait 2ms
    c <- s smb command "treedisconnect" status 0 treeid 100 sessionid 0x3000 msgid 21
}

compile {
    smb_ipc_tree(admin_console, domain_ctrl)
}
