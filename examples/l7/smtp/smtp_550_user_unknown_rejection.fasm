// PROMPT: Generate an SMTP transaction where RCPT TO is rejected with 550 5.1.1 User unknown followed by RSET and QUIT.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, smtp, code, reply, ehlo, mailfrom, param, rcptto, cmd, quit, compile

// INSTRUCTION: Define the external sender MTA and inbound mail gateway.
host ext_mta {
    mac 00:16:3e:55:10:01
    ip 198.51.100.88
}

// INSTRUCTION: Define the inbound_mx mail endpoint.
host inbound_mx {
    mac 00:16:3e:55:10:02
    ip 192.0.2.25
}

// INSTRUCTION: Send MAIL FROM, attempt RCPT TO an invalid mailbox, receive 550 User unknown, reset with RSET, and QUIT.
flow smtp_550_user_unknown_flow(ext_mta, inbound_mx) {
    ext_mta -> inbound_mx tcp syn srcport 53100 dstport 25
    inbound_mx -> ext_mta tcp syn ack
    ext_mta -> inbound_mx tcp ack
    inbound_mx -> ext_mta smtp code 220 reply "mx.example.com ESMTP"
    ext_mta -> inbound_mx smtp ehlo "mail.sender.org"
    inbound_mx -> ext_mta smtp code 250 reply "mx.example.com"
    ext_mta -> inbound_mx smtp mailfrom param "<bounce@sender.org>"
    inbound_mx -> ext_mta smtp code 250 reply "2.1.0 Ok"
    ext_mta -> inbound_mx smtp rcptto param "<nosuchuser@example.com>"
    inbound_mx -> ext_mta smtp code 550 reply "5.1.1 <nosuchuser@example.com>: Recipient address rejected: User unknown"
    ext_mta -> inbound_mx smtp cmd "RSET"
    inbound_mx -> ext_mta smtp code 250 reply "2.0.0 Ok"
    ext_mta -> inbound_mx smtp quit
    inbound_mx -> ext_mta smtp code 221 reply "2.0.0 Bye"
}

// INSTRUCTION: Compile the SMTP 550 User unknown rejection flow.
compile {
    smtp_550_user_unknown_flow(ext_mta, inbound_mx)
}
