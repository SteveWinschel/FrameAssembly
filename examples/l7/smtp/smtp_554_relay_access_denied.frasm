// PROMPT: Generate an SMTP 554 5.7.1 Relay access denied rejection when an unauthorized host attempts to relay mail.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, smtp, code, reply, ehlo, mailfrom, param, rcptto, quit, compile

// INSTRUCTION: Define the untrusted external host and corporate mail gateway.
host untrusted_host {
    mac 00:0f:ea:11:22:33
    ip 198.51.100.200
}

// INSTRUCTION: Define the corp_gateway mail endpoint.
host corp_gateway {
    mac 00:0f:ea:99:88:77
    ip 192.0.2.10
}

// INSTRUCTION: Attempt third-party mail relay and receive 554 5.7.1 Relay access denied.
flow smtp_554_relay_denied(untrusted_host, corp_gateway) {
    untrusted_host -> corp_gateway tcp syn srcport 57025 dstport 25
    corp_gateway -> untrusted_host tcp syn ack
    untrusted_host -> corp_gateway tcp ack
    corp_gateway -> untrusted_host smtp code 220 reply "gw.corp.example ESMTP"
    untrusted_host -> corp_gateway smtp ehlo "unknown.host.net"
    corp_gateway -> untrusted_host smtp code 250 reply "gw.corp.example"
    untrusted_host -> corp_gateway smtp mailfrom param "<spammer@external.org>"
    corp_gateway -> untrusted_host smtp code 250 reply "2.1.0 Ok"
    untrusted_host -> corp_gateway smtp rcptto param "<victim@otherdomain.org>"
    corp_gateway -> untrusted_host smtp code 554 reply "5.7.1 <victim@otherdomain.org>: Relay access denied"
    untrusted_host -> corp_gateway smtp quit
    corp_gateway -> untrusted_host smtp code 221 reply "2.0.0 Bye"
}

// INSTRUCTION: Compile the SMTP 554 relay access denied flow.
compile {
    smtp_554_relay_denied(untrusted_host, corp_gateway)
}
