// PROMPT: Simulate an SMTP AUTH PLAIN authentication on mail submission port 587 with 235 2.7.0 Authentication successful.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, smtp, code, reply, ehlo, cmd, param, quit, compile

// INSTRUCTION: Define the mail user agent and SMTP submission server on port 587.
host mua_client {
    mac 00:1c:42:33:44:55
    ip 192.168.10.45
}

// INSTRUCTION: Define the submission_srv mail endpoint.
host submission_srv {
    mac 00:1c:42:33:44:01
    ip 192.168.10.5
}

// INSTRUCTION: Connect to port 587, send EHLO, authenticate with AUTH PLAIN, and receive 235 success.
flow smtp_submission_auth_plain(mua_client, submission_srv) {
    mua_client -> submission_srv tcp syn srcport 52587 dstport 587
    submission_srv -> mua_client tcp syn ack
    mua_client -> submission_srv tcp ack
    submission_srv -> mua_client dstport 52587 srcport 587 smtp code 220 reply "msa.corp.local ESMTP Submission"
    mua_client -> submission_srv srcport 52587 dstport 587 smtp ehlo "laptop.corp.local"
    submission_srv -> mua_client dstport 52587 srcport 587 smtp code 250 reply "AUTH PLAIN LOGIN"
    mua_client -> submission_srv srcport 52587 dstport 587 smtp cmd "AUTH" param "PLAIN AGFsaWNlAHNlY3JldHBhc3M="
    submission_srv -> mua_client dstport 52587 srcport 587 smtp code 235 reply "2.7.0 Authentication successful"
    mua_client -> submission_srv srcport 52587 dstport 587 smtp quit
    submission_srv -> mua_client dstport 52587 srcport 587 smtp code 221 reply "2.0.0 Bye"
}

// INSTRUCTION: Compile the SMTP port 587 AUTH PLAIN submission flow.
compile {
    smtp_submission_auth_plain(mua_client, submission_srv)
}
