// PROMPT: Simulate an legacy SMTP HELO greeting and QUIT exchange with a mail relay on TCP port 25.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, smtp, code, reply, helo, quit, compile

// INSTRUCTION: Define the legacy mail client and corporate SMTP gateway.
host legacy_mta {
    mac 00:14:22:10:20:30
    ip 10.10.25.50
}

// INSTRUCTION: Define the smtp_gw mail endpoint.
host smtp_gw {
    mac 00:14:22:10:20:01
    ip 10.10.25.1
}

// INSTRUCTION: Establish TCP port 25, receive 220 banner, send HELO, receive 250 OK, and close with QUIT.
flow smtp_legacy_helo_session(legacy_mta, smtp_gw) {
    legacy_mta -> smtp_gw tcp syn srcport 49125 dstport 25
    smtp_gw -> legacy_mta tcp syn ack
    legacy_mta -> smtp_gw tcp ack
    smtp_gw -> legacy_mta smtp code 220 reply "mx1.corp.local ESMTP Service Ready"
    legacy_mta -> smtp_gw smtp helo "printer.corp.local"
    smtp_gw -> legacy_mta smtp code 250 reply "mx1.corp.local Hello printer.corp.local"
    legacy_mta -> smtp_gw smtp quit
    smtp_gw -> legacy_mta smtp code 221 reply "2.0.0 Bye"
}

// INSTRUCTION: Compile the legacy SMTP HELO session flow.
compile {
    smtp_legacy_helo_session(legacy_mta, smtp_gw)
}
