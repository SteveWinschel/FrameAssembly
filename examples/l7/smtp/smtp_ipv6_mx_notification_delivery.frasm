// Automated IPv6 system status alert delivery over ESMTP port 25.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: smtp

host alert_sender_v6 { ip 2001:db8:feed::50 }

host alert_receiver_v6 { ip 2001:db8:feed::1 }

flow smtp_v6_alert_flow(c, s) {
    c -> s smtp mailfrom param "mon-daemon@ipv6-infra.net"
    c <- s smtp code 250 reply "2.1.0 Sender ok"
    c -> s smtp rcptto param "noc-ops@ipv6-infra.net"
    c <- s smtp code 250 reply "2.1.5 Recipient ok"
    c -> s smtp body "Subject: NOC Alert

Core interface BGP peer online."
    c <- s smtp code 250 reply "2.0.0 Queued"
    c -> s smtp quit
}

compile {
    smtp_v6_alert_flow(alert_sender_v6, alert_receiver_v6)
}
