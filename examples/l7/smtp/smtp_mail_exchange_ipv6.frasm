// Simple Mail Transfer Protocol exchange over IPv6 with EHLO, MAIL FROM, RCPT
// TO, and QUIT.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: smtp

host mail_client { ip 2001:db8:25::1 }

host mail_server { ip 2001:db8:25::2 }

flow smtp_session(c, s) {
    c -> s smtp ehlo
    c -> s smtp mailfrom
    c -> s smtp rcptto
    c -> s smtp quit
}

compile {
    smtp_session(mail_client, mail_server)
}
