// Pipelined transaction abort and reset using RSET command followed by new
// envelope.
// Wireshark: smtp

host dispatch_node { ip 192.168.105.10 }

host mx_receiver { ip 192.168.105.1 }

flow smtp_reset_flow(c, s) {
    c -> s smtp mailfrom param "wrong-sender@newsletter.com"
    c <- s smtp code 250 reply "2.1.0 Sender ok"
    c -> s smtp cmd "RSET"
    c <- s smtp code 250 reply "2.0.0 Reset state OK"
    c -> s smtp mailfrom param "correct-sender@newsletter.com"
    c <- s smtp code 250 reply "2.1.0 Sender ok"
}

compile {
    smtp_reset_flow(dispatch_node, mx_receiver)
}
