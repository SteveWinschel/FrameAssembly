// PROMPT: Simulate an ISP carrier SMTP MX relay session over IEEE 802.1ad QinQ double VLAN tags (S-VLAN 1200, C-VLAN 25).
// TOKENS: host, ip, mac, flow, s, smtp, code, reply, qinq, innervlan, wait, ms, ehlo, mailfrom, param, rcptto, body, compile

// INSTRUCTION: Define the customer edge mail gateway sending outbound mail over QinQ.
host ce_mail_gw {
    ip 10.120.25.10
    mac 00:1b:21:78:19:0a
}

// INSTRUCTION: Define the provider core MX relay receiving double-tagged SMTP traffic.
host pe_mx_relay {
    ip 10.120.25.1
    mac 00:1b:21:78:19:01
}

// INSTRUCTION: Exchange SMTP banner, EHLO, envelope sender/recipient, and body over QinQ 1200/25.
flow smtp_qinq_relay_flow(c, s) {
    c <- s smtp code 220 reply "mx-core.isp.net ESMTP" qinq 1200 innervlan 25 wait 2ms
    c -> s smtp ehlo "ce-gw.customer.org" qinq 1200 innervlan 25 wait 2ms
    c <- s smtp code 250 reply "mx-core.isp.net PIPELINING" qinq 1200 innervlan 25 wait 2ms
    c -> s smtp mailfrom param "<billing@customer.org>" qinq 1200 innervlan 25 wait 2ms
    c <- s smtp code 250 reply "2.1.0 Originator OK" qinq 1200 innervlan 25 wait 2ms
    c -> s smtp rcptto param "<archive@isp.net>" qinq 1200 innervlan 25 wait 2ms
    c <- s smtp code 250 reply "2.1.5 Recipient OK" qinq 1200 innervlan 25 wait 2ms
    c -> s smtp body "Subject: Monthly Invoice

Invoice attached.
." qinq 1200 innervlan 25 wait 4ms
    c <- s smtp code 250 reply "2.0.0 Queued as QINQ25" qinq 1200 innervlan 25
}

// INSTRUCTION: Compile the QinQ-encapsulated SMTP carrier relay flow.
compile {
    smtp_qinq_relay_flow(ce_mail_gw, pe_mx_relay)
}
