// Minimal 2-block SNMPv1 starter emitting a default RFC 1157 trap on UDP port 162.
// Uses community "public", enterprise 1.3.6.1.4.1, and automatic BER encoding with no flow.
// Compile to test legacy trap receivers such as Checkmk or Zabbix.
// Wireshark: snmp

host legacy_agent { ip 10.145.0.1  mac 00:1a:2b:91:00:01 }
host trap_sink    { ip 10.145.0.10 mac 00:1a:2b:91:00:0a }

compile {
    legacy_agent -> trap_sink snmp1
}
