// Generate an SNMPv1 authenticationFailure generic trap (gentrap 4) reporting
// the unauthorized source IP address via an IpAddress varbind.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.5 (authenticationFailure).
// Wireshark: snmp

host guarded_switch { ip 10.104.0.1 mac 00:19:56:00:01:01 }

host secops_nms { ip 10.104.0.99 mac 00:19:56:00:01:99 }

flow snmpv1_auth_failure(agent, nms) {
    agent -> nms snmp1 trap community "sec_trap" oid 1.3.6.1.6.3.1.1.5.5
        enterprise 1.3.6.1.4.1.9.1 agentip 10.104.0.1 gentrap 4 spectrap 0
        sysuptime 543210
        varbind 1.3.6.1.4.1.9.2.1.5.0 ipval 192.168.66.13
        varbind 1.3.6.1.4.1.9.2.1.6.0 string "bad_community_attempt"
}

compile {
    snmpv1_auth_failure(guarded_switch, secops_nms)
}
