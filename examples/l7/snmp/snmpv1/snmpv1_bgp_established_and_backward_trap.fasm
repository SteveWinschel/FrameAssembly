// PROMPT: SNMPv1 RFC 1657 BGP4-MIB traps reporting bgpEstablished (SPECTRAP 1) and bgpBackwardTransition (SPECTRAP 2).
// TOKENS: host, ip, mac, flow, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, int, wait, ms, compile

// INSTRUCTION: Define the internet edge border router agent.
host border_rtr {
    ip 10.145.50.1
    mac 00:1a:2b:91:50:01
}

// INSTRUCTION: Define the transit peering telemetry collector.
host peering_nms {
    ip 10.145.50.50
    mac 00:1a:2b:91:50:50
}

// INSTRUCTION: Emit bgpBackwardTransition (SPECTRAP 2) followed by bgpEstablished (SPECTRAP 1) after session recovery.
flow snmpv1_bgp_traps(r, n) {
    r -> n snmp1 trap community "bgp_ro" enterprise 1.3.6.1.2.1.15.7 agentip 10.145.50.1 gentrap 6 spectrap 2 sysuptime 120400 varbind 1.3.6.1.2.1.15.3.1.2.198.51.100.1 int 1 wait 10ms
    r -> n snmp1 trap community "bgp_ro" enterprise 1.3.6.1.2.1.15.7 agentip 10.145.50.1 gentrap 6 spectrap 1 sysuptime 120500 varbind 1.3.6.1.2.1.15.3.1.2.198.51.100.1 int 6
}

// INSTRUCTION: Compile the SNMPv1 BGP4-MIB state transition traps flow.
compile {
    snmpv1_bgp_traps(border_rtr, peering_nms)
}
