// PROMPT: SNMPv1 RFC 1493 Bridge-MIB spanning tree topologyChange (SPECTRAP 2) and newRoot (SPECTRAP 1) traps.
// TOKENS: host, ip, mac, flow, s, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, string, wait, ms, counter32, compile

// INSTRUCTION: Define the aggregation layer L2 switch agent.
host l2_agg_switch {
    ip 10.145.60.2
    mac 00:1a:2b:91:60:02
}

// INSTRUCTION: Define the campus LAN management station.
host campus_nms {
    ip 10.145.60.100
    mac 00:1a:2b:91:60:64
}

// INSTRUCTION: Send Bridge-MIB newRoot (SPECTRAP 1) and topologyChange (SPECTRAP 2) traps with dot1dStpDesignatedRoot varbind.
flow snmpv1_stp_traps(s, n) {
    s -> n snmp1 trap community "campus_mon" enterprise 1.3.6.1.2.1.17.0 agentip 10.145.60.2 gentrap 6 spectrap 1 sysuptime 300400 varbind 1.3.6.1.2.1.17.2.5.0 string "8000.001a2b910001" wait 2ms
    s -> n snmp1 trap community "campus_mon" enterprise 1.3.6.1.2.1.17.0 agentip 10.145.60.2 gentrap 6 spectrap 2 sysuptime 300450 varbind 1.3.6.1.2.1.17.2.3.0 counter32 19
}

// INSTRUCTION: Compile the SNMPv1 Bridge-MIB STP trap flow.
compile {
    snmpv1_stp_traps(l2_agg_switch, campus_nms)
}
