// PROMPT: SNMPv1 enterprise trap (1.3.6.1.4.1.9.9.43.2) auditing an interactive CLI running-config modification.
// TOKENS: host, ip, mac, flow, s, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, int, compile

// INSTRUCTION: Define the router where an engineer just exited config mode.
host audited_router {
    ip 10.145.130.1
    mac 00:1a:2b:91:d0:01
}

// INSTRUCTION: Define the security compliance SIEM trap listener.
host siem_trapd {
    ip 10.145.130.200
    mac 00:1a:2b:91:d0:c8
}

// INSTRUCTION: Send ciscoConfigManEvent trap (GENTRAP 6, SPECTRAP 1) reporting commandSource=commandLine(1).
flow snmpv1_config_change_trap(r, s) {
    r -> s snmp1 trap community "sec_audit" enterprise 1.3.6.1.4.1.9.9.43.2 agentip 10.145.130.1 gentrap 6 spectrap 1 sysuptime 6048000 varbind 1.3.6.1.4.1.9.9.43.1.1.6.1.3.12 int 1
}

// INSTRUCTION: Compile the SNMPv1 configuration change audit trap flow.
compile {
    snmpv1_config_change_trap(audited_router, siem_trapd)
}
