// Minimal 2-block SNMPv1 (RFC 1157) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Uses SNMPv1 default trap PDUs on UDP 161/162.
// Wireshark: snmp

host snmp1_def_agent {
    ip 10.145.0.1
    mac 00:1a:2b:91:00:01
}

host snmp1_def_mgr {
    ip 10.145.0.10
    mac 00:1a:2b:91:00:10
}

compile {
    snmp1_def_agent -> snmp1_def_mgr snmp1
}
