// Generate an SNMPv1 egpNeighborLoss generic trap (gentrap 5) with EGP peer
// IpAddress and packet loss Counter32 variable bindings.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.6 (egpNeighborLoss).
// Wireshark: snmp

host egp_router { ip 10.105.0.1 mac 00:00:0c:aa:05:01 }

host routing_nms { ip 10.105.0.250 mac 00:00:0c:aa:05:fa }

flow snmpv1_egp_neighbor_loss(agent, nms) {
    agent -> nms snmp1 trap community "public" oid 1.3.6.1.6.3.1.1.5.6
        enterprise 1.3.6.1.2.1.8 agentip 10.105.0.1 gentrap 5 spectrap 0
        sysuptime 890000
        varbind 1.3.6.1.2.1.8.5.1.2.192.0.2.9 ipval 192.0.2.9
        varbind 1.3.6.1.2.1.8.5.1.5.192.0.2.9 counter32 42
}

compile {
    snmpv1_egp_neighbor_loss(egp_router, routing_nms)
}
