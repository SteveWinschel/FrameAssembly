// PROMPT: SNMPv1 GetRequest reading RFC 2790 Host-Resources-MIB hrSystemProcesses.0 and hrProcessorLoad.1.
// TOKENS: host, ip, mac, flow, s, snmp1, get, community, reqid, varbind, nullval, response, gauge32, int, compile

// INSTRUCTION: Define the server infrastructure monitoring station.
host infra_nms {
    ip 10.145.120.5
    mac 00:1a:2b:91:c0:05
}

// INSTRUCTION: Define the legacy Unix application server running net-snmp.
host unix_server {
    ip 10.145.120.40
    mac 00:1a:2b:91:c0:40
}

// INSTRUCTION: Query hrSystemProcesses.0 (GAUGE32) and hrProcessorLoad.1 (INT) via SNMP1 GET.
flow snmpv1_host_resources(n, s) {
    n -> s snmp1 get community "srv_public" reqid 12300 varbind 1.3.6.1.2.1.25.1.6.0 nullval varbind 1.3.6.1.2.1.25.3.3.1.2.1 nullval
    n <- s snmp1 response community "srv_public" reqid 12300 varbind 1.3.6.1.2.1.25.1.6.0 gauge32 184 varbind 1.3.6.1.2.1.25.3.3.1.2.1 int 67
}

// INSTRUCTION: Compile the SNMPv1 Host-Resources-MIB poll flow.
compile {
    snmpv1_host_resources(infra_nms, unix_server)
}
