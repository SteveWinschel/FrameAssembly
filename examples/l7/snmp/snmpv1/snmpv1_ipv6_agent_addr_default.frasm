// PROMPT: SNMPv1 Traps from IPv6 endpoints automatically defaulting agent-addr to 0.0.0.0 per RFC 3584 §3.2.
// TOKENS: host, ip, flow, snmp1, trap, community, oid, sysuptime, compile

// INSTRUCTION: Define SNMPv1 managed agent with IPv6 address.
host agent_v6 { ip 2001:db8::1 }

// INSTRUCTION: Define SNMP Network Management Station with IPv6 address.
host nms_v6 { ip 2001:db8::2 }

// INSTRUCTION: Define SNMPv1 trap flow over IPv6 with default agent-addr.
flow snmp1_v6_flow(a, n) {
    a -> n snmp1 trap community "public" oid "1.3.6.1.6.3.1.1.5.1" sysuptime 100
}

// INSTRUCTION: Compile block executing RFC 3584 default agent-addr trap.
compile {
    snmp1_v6_flow(agent_v6, nms_v6)
}
