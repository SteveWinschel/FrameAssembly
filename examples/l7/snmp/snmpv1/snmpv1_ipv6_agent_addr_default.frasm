// SNMPv1 Traps from IPv6 endpoints automatically defaulting agent-addr to
// 0.0.0.0 per RFC 3584 §3.2.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.1 (coldStart).
// Wireshark: snmp

host agent_v6 { ip 2001:db8::1 }

host nms_v6 { ip 2001:db8::2 }

flow snmp1_v6_flow(a, n) {
    a -> n snmp1 trap community "public" oid "1.3.6.1.6.3.1.1.5.1" sysuptime 100
}

compile {
    snmp1_v6_flow(agent_v6, nms_v6)
}
