// SNMPv1 Traps over IPv6 with explicit agentip proxy address override per RFC
// 3584.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.1 (coldStart).
// Wireshark: snmp

host agent_v6 { ip 2001:db8:1::1 }

host nms_v6 { ip 2001:db8:1::2 }

flow snmp1_proxy_flow(a, n) {
    a -> n snmp1 trap agentip 192.0.2.1 community "public" oid "1.3.6.1.6.3.1.1.5.1" sysuptime 200
}

compile {
    snmp1_proxy_flow(agent_v6, nms_v6)
}
