// Generate an SNMPv1 linkDown generic trap (gentrap 2) reporting interface
// index and interface description via INT and STRING variable bindings.
// Uses SNMPv1 trap PDUs on UDP 161/162.
// Wireshark: snmp

host tor_switch { ip 10.102.1.10 mac 00:05:9a:3c:78:00 }

host noc_monitor { ip 10.102.1.200 mac 00:05:9a:3c:78:c8 }

flow snmpv1_link_down(agent, nms) {
    agent -> nms snmp1 trap community "trap_ro" enterprise 1.3.6.1.4.1.9.1.516
        agentip 10.102.1.10 gentrap 2 spectrap 0 sysuptime 98400
        varbind 1.3.6.1.2.1.2.2.1.1.4 int 4
        varbind 1.3.6.1.2.1.2.2.1.2.4 string "TenGigabitEthernet1/0/4"
        varbind 1.3.6.1.2.1.2.2.1.8.4 int 2
}

compile {
    snmpv1_link_down(tor_switch, noc_monitor)
}
