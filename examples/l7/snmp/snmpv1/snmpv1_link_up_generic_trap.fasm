// PROMPT: Generate an SNMPv1 linkUp generic trap (GENTRAP 3) carrying TIMETICKS and OIDVAL variable bindings when an uplink recovers.
// TOKENS: host, ip, mac, flow, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, int, timeticks, oidval, compile

// INSTRUCTION: Define a fiber aggregation switch with IP 10.103.0.5.
host fiber_switch { ip 10.103.0.5 mac 2c:60:0c:10:20:30 }

// INSTRUCTION: Define a fault management server with IP 10.103.0.50.
host fault_manager { ip 10.103.0.50 mac 2c:60:0c:40:50:60 }

// INSTRUCTION: Define a flow sending an SNMPv1 linkUp trap (GENTRAP 3) with ifLastChange TIMETICKS and ifType OIDVAL varbinds.
flow snmpv1_link_up(agent, nms) {
    agent -> nms snmp1 trap community "public" enterprise 1.3.6.1.4.1.2636
        agentip 10.103.0.5 gentrap 3 spectrap 0 sysuptime 125000
        varbind 1.3.6.1.2.1.2.2.1.1.1 int 1
        varbind 1.3.6.1.2.1.2.2.1.9.1 timeticks 124950
        varbind 1.3.6.1.2.1.2.2.1.22.1 oidval 1.3.6.1.4.1.2636.1.1
}

// INSTRUCTION: Compile block to execute the SNMPv1 linkUp notification flow.
compile {
    snmpv1_link_up(fiber_switch, fault_manager)
}
