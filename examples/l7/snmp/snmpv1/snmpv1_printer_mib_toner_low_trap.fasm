// PROMPT: SNMPv1 enterprise-specific trap (GENTRAP 6) from a network laser printer reporting low black toner.
// TOKENS: host, ip, mac, flow, m, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, int, compile

// INSTRUCTION: Define the network laser printer agent.
host office_printer {
    ip 10.145.30.80
    mac 00:1a:2b:91:30:80
}

// INSTRUCTION: Define the print fleet management trap receiver.
host print_monitor {
    ip 10.145.30.10
    mac 00:1a:2b:91:30:10
}

// INSTRUCTION: Send an SNMPv1 enterprise-specific trap with Printer-MIB prtMarkerSuppliesLevel varbinds.
flow snmpv1_printer_trap(a, m) {
    a -> m snmp1 trap community "public" enterprise 1.3.6.1.2.1.43 agentip 10.145.30.80 gentrap 6 spectrap 14 sysuptime 450120 varbind 1.3.6.1.2.1.43.11.1.1.9.1.1 int 8
}

// INSTRUCTION: Compile the SNMPv1 Printer-MIB low toner trap flow.
compile {
    snmpv1_printer_trap(office_printer, print_monitor)
}
