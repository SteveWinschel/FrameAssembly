// SNMPv1 linkDown trap from a managed customer-premises router encapsulated
// in QinQ (500/162) and MPLS label 8100.
// Encapsulation and QoS markings: 802.1ad QinQ outer 500 / inner 162, MPLS
// label 8100.
// Uses SNMPv1 trap PDUs on UDP 161/162.
// Wireshark: (snmp && vlan) && mpls

host cpe_router {
    ip 172.31.145.1
    mac 00:1a:2b:1f:91:01
}

host carrier_noc {
    ip 172.31.1.162
    mac 00:1a:2b:1f:01:a2
}

flow snmpv1_cpe_wan_trap(a, n) {
    a -> n snmp1 trap community "cpe" enterprise 1.3.6.1.4.1.9.1 agentip 172.31.145.1 gentrap 2 spectrap 0 sysuptime 55000 qinq 500 innervlan 162 mpls 8100 varbind 1.3.6.1.2.1.2.2.1.1.2 int 2
}

compile {
    snmpv1_cpe_wan_trap(cpe_router, carrier_noc)
}
