// PROMPT: SNMPv1 polling MIB-II tcpCurrEstab.0 (GAUGE32) and tcpActiveOpens.0 (COUNTER32) on a load balancer.
// TOKENS: host, ip, mac, flow, snmp1, get, community, reqid, varbind, nullval, response, counter32, gauge32, compile

// INSTRUCTION: Define the Cacti / RRDtool SNMP poller host.
host cacti_poller {
    ip 10.145.90.10
    mac 00:1a:2b:91:90:10
}

// INSTRUCTION: Define the L4 hardware load balancer agent.
host l4_load_balancer {
    ip 10.145.90.1
    mac 00:1a:2b:91:90:01
}

// INSTRUCTION: Query tcpActiveOpens.0 (1.3.6.1.2.1.6.5.0) and tcpCurrEstab.0 (1.3.6.1.2.1.6.9.0).
flow snmpv1_tcp_mib_poll(p, l) {
    p -> l snmp1 get community "stats_ro" reqid 9010 varbind 1.3.6.1.2.1.6.5.0 nullval varbind 1.3.6.1.2.1.6.9.0 nullval
    p <- l snmp1 response community "stats_ro" reqid 9010 varbind 1.3.6.1.2.1.6.5.0 counter32 4829100 varbind 1.3.6.1.2.1.6.9.0 gauge32 14250
}

// INSTRUCTION: Compile the SNMPv1 TCP-MIB connection metrics flow.
compile {
    snmpv1_tcp_mib_poll(cacti_poller, l4_load_balancer)
}
