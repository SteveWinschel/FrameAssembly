// PROMPT: SNMPv1 RFC 1628 UPS-MIB trap notifying the NOC that utility AC input failed and the UPS is on battery.
// TOKENS: host, ip, mac, flow, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, int, compile

// INSTRUCTION: Define the datacenter UPS network management card.
host ups_agent {
    ip 10.145.40.5
    mac 00:1a:2b:91:40:05
}

// INSTRUCTION: Define the NOC SNMP trap collector.
host noc_collector {
    ip 10.145.40.100
    mac 00:1a:2b:91:40:64
}

// INSTRUCTION: Emit an SNMPv1 GENTRAP 6 SPECTRAP 1 (upsTrapOnBattery) with estimated minutes remaining and battery voltage.
flow snmpv1_ups_on_battery(u, n) {
    u -> n snmp1 trap community "ups_traps" enterprise 1.3.6.1.2.1.33.2 agentip 10.145.40.5 gentrap 6 spectrap 1 sysuptime 9912400 varbind 1.3.6.1.2.1.33.1.2.3.0 int 28
}

// INSTRUCTION: Compile the SNMPv1 UPS on-battery trap flow.
compile {
    snmpv1_ups_on_battery(ups_agent, noc_collector)
}
