// SNMPv2c linkDown followed by linkUp interface state traps on UDP port 162.
// Ready for testing Checkmk, Zabbix, or LibreNMS trap handlers and alert recovery
// rules: ifOperStatus flips from 2 (down) to 1 (up) for Ethernet10 (ifIndex 10).
// Timing: pauses 50ms after linkDown before sending the recovery linkUp trap.
// Wireshark: snmp

host access_switch { ip 10.125.0.10  mac 00:1c:73:25:00:10 }
host checkmk_nms   { ip 10.125.0.250 mac 00:1c:73:25:00:fa }

flow interface_flap_alert(sw, nms) {
    sw -> nms snmp2 trap community "noc_traps" reqid 6001 sysuptime 300100 oid 1.3.6.1.6.3.1.1.5.3
        varbind 1.3.6.1.2.1.2.2.1.1.10 int 10 varbind 1.3.6.1.2.1.2.2.1.2.10 string "Ethernet10" varbind 1.3.6.1.2.1.2.2.1.8.10 int 2 wait 50ms
    sw -> nms snmp2 trap community "noc_traps" reqid 6002 sysuptime 300105 oid 1.3.6.1.6.3.1.1.5.4
        varbind 1.3.6.1.2.1.2.2.1.1.10 int 10 varbind 1.3.6.1.2.1.2.2.1.2.10 string "Ethernet10" varbind 1.3.6.1.2.1.2.2.1.8.10 int 1
}

compile {
    interface_flap_alert(access_switch, checkmk_nms)
}
