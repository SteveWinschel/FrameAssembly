// PROMPT: Simulate an RFC 4273 BGP4-MIB bgpBackwardTransNotification SNMPv2c trap reporting a BGP peer dropping from Established to Idle with IPVAL and INT varbinds.
// TOKENS: host, ip, mac, flow, router, snmp2, trap, community, reqid, oid, sysuptime, varbind, ipval, int, oidval, compile

// INSTRUCTION: Define a core BGP speaker router with IP 10.128.0.1.
host bgp_speaker { ip 10.128.0.1 mac 00:00:5e:28:00:01 }

// INSTRUCTION: Define a WAN operations center trap receiver with IP 10.128.0.250.
host wan_noc_nms { ip 10.128.0.250 mac 00:00:5e:28:00:fa }

// INSTRUCTION: Define a flow sending a bgpBackwardTransNotification SNMPv2c trap with bgpPeerRemoteAddr IPVAL and bgpPeerState INT.
flow bgp_backward_transition_trap(router, nms) {
    router -> nms snmp2 trap community "wan_traps" reqid 8100 oid 1.3.6.1.2.1.15.0.2
        sysuptime 1840000
        varbind 1.3.6.1.2.1.15.3.1.7.198.51.100.2 ipval 198.51.100.2
        varbind 1.3.6.1.2.1.15.3.1.2.198.51.100.2 int 1
        varbind 1.3.6.1.2.1.15.3.1.14.198.51.100.2 oidval 1.3.6.1.2.1.15.3.1
}

// INSTRUCTION: Compile block to trigger the BGP state transition SNMPv2c trap.
compile {
    bgp_backward_transition_trap(bgp_speaker, wan_noc_nms)
}
