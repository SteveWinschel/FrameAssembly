// PROMPT: Poll cold-storage environmental sensors via SNMPv2c GET and RESPONSE using negative signed INT (-15 Celsius) and GAUGE32 humidity percentages.
// TOKENS: host, ip, mac, flow, snmp2, get, community, reqid, varbind, nullval, wait, ms, response, string, int, gauge32, compile

// INSTRUCTION: Define a facilities BMS polling host with IP 10.129.0.10.
host bms_poller { ip 10.129.0.10 mac 00:40:9d:29:00:10 }

// INSTRUCTION: Define a cold-aisle environmental probe with IP 10.129.0.55.
host cryo_probe { ip 10.129.0.55 mac 00:40:9d:29:00:55 }

// INSTRUCTION: Define a flow polling temperature and humidity OIDs and receiving negative INT and GAUGE32 readings.
flow poll_cold_storage_sensor(poller, probe) {
    poller -> probe snmp2 get community "env_read" reqid 8201
        varbind 1.3.6.1.4.1.3854.1.2.2.1.16.1.3.0 nullval
        varbind 1.3.6.1.4.1.3854.1.2.2.1.17.1.3.0 nullval
        wait 10ms
    poller <- probe snmp2 response community "env_read" reqid 8201
        varbind 1.3.6.1.4.1.3854.1.2.2.1.16.1.1.0 string "Freezer Vault B2"
        varbind 1.3.6.1.4.1.3854.1.2.2.1.16.1.3.0 int -15
        varbind 1.3.6.1.4.1.3854.1.2.2.1.17.1.3.0 gauge32 45
        wait 10ms
}

// INSTRUCTION: Compile block to execute the environmental sensor SNMPv2c polling flow.
compile {
    poll_cold_storage_sensor(bms_poller, cryo_probe)
}
