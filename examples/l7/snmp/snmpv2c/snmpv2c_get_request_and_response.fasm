// PROMPT: Simulate an SNMPv2c GET request on UDP port 161 with a NULLVAL varbind and a matching RESPONSE returning sysDescr and sysObjectID with matching REQID.
// TOKENS: host, ip, mac, flow, snmp2, get, srcport, dstport, community, reqid, varbind, nullval, wait, ms, response, string, oidval, compile

// INSTRUCTION: Define an NMS polling station with IP 10.120.0.10.
host nms_poller { ip 10.120.0.10 mac 00:10:db:20:00:10 }

// INSTRUCTION: Define a managed router agent with IP 10.120.0.1.
host router_agent { ip 10.120.0.1 mac 00:10:db:20:00:01 }

// INSTRUCTION: Define a flow sending an SNMPv2c GET request with NULLVAL varbinds and receiving a RESPONSE on port 161.
flow snmpv2c_get_sysinfo(poller, agent) {
    poller -> agent snmp2 get srcport 52161 dstport 161 community "public"
        reqid 1001
        varbind 1.3.6.1.2.1.1.1.0 nullval
        varbind 1.3.6.1.2.1.1.2.0 nullval
        wait 10ms
    poller <- agent snmp2 response srcport 161 dstport 52161 community "public"
        reqid 1001
        varbind 1.3.6.1.2.1.1.1.0 string "Arista Networks EOS version 4.31.2F"
        varbind 1.3.6.1.2.1.1.2.0 oidval 1.3.6.1.4.1.30065.1.3011.7280
        wait 10ms
}

// INSTRUCTION: Compile block to execute the SNMPv2c GET and RESPONSE flow.
compile {
    snmpv2c_get_sysinfo(nms_poller, router_agent)
}
