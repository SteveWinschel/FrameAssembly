// PROMPT: SNMPv2c polling Host-Resources-MIB hrStorageDescr, hrStorageSize, and hrStorageUsed for /var partition alerting.
// TOKENS: HOST, IP, MAC, FLOW, SNMP2, GET, COMMUNITY, REQID, VARBIND, NULLVAL, RESPONSE, STRING, INT, COMPILE

// INSTRUCTION: Define the Nagios / Icinga check_snmp monitoring host.
HOST icinga_poller {
    IP 10.146.30.15
    MAC 00:1a:2b:92:30:15
}

// INSTRUCTION: Define the Linux database server agent.
HOST linux_db_host {
    IP 10.146.30.5
    MAC 00:1a:2b:92:30:05
}

// INSTRUCTION: Query mount path and used allocation units for storage index 31 (/var/lib/pgsql).
FLOW snmpv2c_disk_check(p, h) {
    p -> h SNMP2 GET COMMUNITY "linux_ro" REQID 4400 VARBIND 1.3.6.1.2.1.25.2.3.1.3.31 NULLVAL VARBIND 1.3.6.1.2.1.25.2.3.1.6.31 NULLVAL
    p <- h SNMP2 RESPONSE COMMUNITY "linux_ro" REQID 4400 VARBIND 1.3.6.1.2.1.25.2.3.1.3.31 STRING "/var/lib/pgsql" VARBIND 1.3.6.1.2.1.25.2.3.1.6.31 INT 419430400
}

// INSTRUCTION: Compile the SNMPv2c disk utilization check flow.
COMPILE {
    snmpv2c_disk_check(icinga_poller, linux_db_host)
}
