// PROMPT: Simulate an acknowledged SNMPv2c INFORM notification sent to UDP port 162 followed by an NMS RESPONSE PDU confirming receipt.
// TOKENS: host, ip, mac, flow, snmp2, inform, srcport, dstport, community, reqid, oid, sysuptime, varbind, int, string, wait, ms, response, compile

// INSTRUCTION: Define a branch router sending reliable notifications with IP 10.124.0.1.
host branch_router { ip 10.124.0.1 mac 00:1e:13:24:00:01 }

// INSTRUCTION: Define the central NMS notification receiver with IP 10.124.0.200.
host central_nms { ip 10.124.0.200 mac 00:1e:13:24:00:c8 }

// INSTRUCTION: Define a flow sending an SNMPv2c INFORM on port 162 and receiving an acknowledging RESPONSE PDU with matching REQID 5010.
flow snmpv2c_inform_exchange(agent, nms) {
    agent -> nms snmp2 inform srcport 56162 dstport 162 community "inform_comm"
        reqid 5010 oid 1.3.6.1.6.3.1.1.5.4 sysuptime 720000
        varbind 1.3.6.1.2.1.2.2.1.1.2 int 2
        varbind 1.3.6.1.2.1.2.2.1.2.2 string "GigabitEthernet0/0/1"
        wait 15ms
    agent <- nms snmp2 response srcport 162 dstport 56162 community "inform_comm"
        reqid 5010
        varbind 1.3.6.1.2.1.2.2.1.1.2 int 2
        varbind 1.3.6.1.2.1.2.2.1.2.2 string "GigabitEthernet0/0/1"
        wait 10ms
}

// INSTRUCTION: Compile block to run the SNMPv2c INFORM and RESPONSE flow.
compile {
    snmpv2c_inform_exchange(branch_router, central_nms)
}
