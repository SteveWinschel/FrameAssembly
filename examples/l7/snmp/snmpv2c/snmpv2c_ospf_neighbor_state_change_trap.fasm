// PROMPT: SNMPv2c RFC 4750 OSPF-TRAP-MIB ospfNbrStateChange notification reporting Full (8) adjacency.
// TOKENS: host, ip, mac, flow, snmp2, trap, community, reqid, sysuptime, oid, varbind, ipval, int, compile

// INSTRUCTION: Define the core OSPF area 0 router agent.
host ospf_core_rtr {
    ip 10.146.1.1
    mac 00:1a:2b:92:01:01
}

// INSTRUCTION: Define the routing telemetry trap receiver.
host routing_trapd {
    ip 10.146.1.100
    mac 00:1a:2b:92:01:64
}

// INSTRUCTION: Send an SNMPv2c TRAP for ospfNbrStateChange (1.3.6.1.2.1.14.16.2.2) with router-id and state Full(8).
flow snmpv2c_ospf_trap(r, t) {
    r -> t snmp2 trap community "ospf_mon" reqid 4100 sysuptime 540200 oid 1.3.6.1.2.1.14.16.2.2 varbind 1.3.6.1.2.1.14.1.1.0 ipval 10.146.1.1 varbind 1.3.6.1.2.1.14.10.1.6.1 int 8
}

// INSTRUCTION: Compile the SNMPv2c OSPF neighbor state change trap flow.
compile {
    snmpv2c_ospf_trap(ospf_core_rtr, routing_trapd)
}
