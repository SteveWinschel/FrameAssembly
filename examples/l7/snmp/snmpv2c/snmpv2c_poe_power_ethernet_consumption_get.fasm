// PROMPT: SNMPv2c RFC 3621 POWER-ETHERNET-MIB polling pethMainPsePower and pethMainPseConsumptionPower on a PoE+ switch.
// TOKENS: HOST, IP, MAC, FLOW, SNMP2, GET, COMMUNITY, REQID, VARBIND, NULLVAL, RESPONSE, GAUGE32, COMPILE

// INSTRUCTION: Define the smart building facilities monitoring server.
HOST poe_monitor {
    IP 10.146.50.10
    MAC 00:1a:2b:92:50:10
}

// INSTRUCTION: Define the 48-port PoE+ access switch agent.
HOST poe_switch {
    IP 10.146.50.1
    MAC 00:1a:2b:92:50:01
}

// INSTRUCTION: Read nominal PoE budget (740 Watts) and current draw (412 Watts) via SNMP2 GET.
FLOW snmpv2c_poe_draw(m, s) {
    m -> s SNMP2 GET COMMUNITY "poe_ro" REQID 4700 VARBIND 1.3.6.1.2.1.105.1.3.1.1.2.1 NULLVAL VARBIND 1.3.6.1.2.1.105.1.3.1.1.4.1 NULLVAL
    m <- s SNMP2 RESPONSE COMMUNITY "poe_ro" REQID 4700 VARBIND 1.3.6.1.2.1.105.1.3.1.1.2.1 GAUGE32 740 VARBIND 1.3.6.1.2.1.105.1.3.1.1.4.1 GAUGE32 412
}

// INSTRUCTION: Compile the SNMPv2c PoE power consumption query flow.
COMPILE {
    snmpv2c_poe_draw(poe_monitor, poe_switch)
}
