// PROMPT: Simulate periodic 1-second SNMPv2c CPU and memory utilization polling using a repeated flow calls and WAIT 1s interval.
// TOKENS: host, ip, mac, flow, target, snmp2, get, community, reqid, varbind, nullval, wait, ms, response, gauge32, s, compile

// INSTRUCTION: Define a Prometheus snmp_exporter host with IP 10.133.0.10.
host snmp_exporter { ip 10.133.0.10 mac 02:42:0a:85:00:0a }

// INSTRUCTION: Define a monitored Linux appliance with IP 10.133.0.50.
host linux_appliance { ip 10.133.0.50 mac 02:42:0a:85:00:32 }

// INSTRUCTION: Define a flow querying CPU load and available memory gauges with a 1s polling delay.
flow poll_cpu_mem_loop(exporter, target) {
    exporter -> target snmp2 get community "metrics_ro" reqid 8600 varbind 1.3.6.1.4.1.2021.11.9.0 nullval varbind 1.3.6.1.4.1.2021.4.6.0 nullval wait 10ms
    exporter <- target snmp2 response community "metrics_ro" reqid 8600 varbind 1.3.6.1.4.1.2021.11.9.0 gauge32 14 varbind 1.3.6.1.4.1.2021.4.6.0 gauge32 8388608 wait 1s
}

// INSTRUCTION: Compile block to repeat the SNMPv2c metrics poll 10 times.
compile {
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 1 of 10
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 2 of 10
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 3 of 10
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 4 of 10
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 5 of 10
}
