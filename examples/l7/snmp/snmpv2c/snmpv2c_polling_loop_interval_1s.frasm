// Simulate periodic 1-second SNMPv2c CPU and memory utilization polling using
// a repeated flow calls and wait 1s interval.
// Uses SNMPv2c get, response PDUs on UDP 161/162.
// Timing: runs 5 cycles in compile using post-packet waits (10ms, 1s).
// Wireshark: snmp

host snmp_exporter { ip 10.133.0.10 mac 02:42:0a:85:00:0a }

host linux_appliance { ip 10.133.0.50 mac 02:42:0a:85:00:32 }

flow poll_cpu_mem_loop(exporter, target) {
    exporter -> target snmp2 get community "metrics_ro" reqid 8600 varbind 1.3.6.1.4.1.2021.11.9.0 nullval varbind 1.3.6.1.4.1.2021.4.6.0 nullval wait 10ms
    exporter <- target snmp2 response community "metrics_ro" reqid 8600 varbind 1.3.6.1.4.1.2021.11.9.0 gauge32 14 varbind 1.3.6.1.4.1.2021.4.6.0 gauge32 8388608 wait 1s
}

compile {
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 1 of 5
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 2 of 5
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 3 of 5
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 4 of 5
    poll_cpu_mem_loop(snmp_exporter, linux_appliance) // cycle 5 of 5
}
