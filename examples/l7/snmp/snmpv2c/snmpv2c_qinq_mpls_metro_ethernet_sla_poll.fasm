// PROMPT: SNMPv2c 64-bit interface octet counter poll across QinQ (700/161) and MPLS label 9200 for Metro Ethernet SLA verification.
// TOKENS: HOST, IP, MAC, FLOW, SNMP2, GET, COMMUNITY, REQID, QINQ, INNER_VLAN, MPLS, VARBIND, NULLVAL, RESPONSE, COUNTER64, COMPILE

// INSTRUCTION: Define the carrier SLA performance management poller.
HOST sla_poller {
    IP 172.25.146.10
    MAC 00:1a:2b:19:92:10
}

// INSTRUCTION: Define the Metro Ethernet NID (Network Interface Device) agent.
HOST metro_nid {
    IP 172.25.146.1
    MAC 00:1a:2b:19:92:01
}

// INSTRUCTION: Query ifHCInOctets.1 and ifHCOutOctets.1 (COUNTER64) over QinQ and MPLS headers.
FLOW snmpv2c_metro_sla(p, n) {
    p -> n SNMP2 GET COMMUNITY "metro_sla" REQID 4500 QINQ 700 INNER_VLAN 161 MPLS 9200 VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 NULLVAL
    p <- n SNMP2 RESPONSE COMMUNITY "metro_sla" REQID 4500 QINQ 700 INNER_VLAN 161 MPLS 9200 VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 COUNTER64 9841209581024
}

// INSTRUCTION: Compile the QinQ + MPLS Metro Ethernet SNMPv2c SLA flow.
COMPILE {
    snmpv2c_metro_sla(sla_poller, metro_nid)
}
