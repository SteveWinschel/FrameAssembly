// SNMPv2c 64-bit interface octet counter poll across QinQ (700/161) and MPLS
// label 9200 for Metro Ethernet SLA verification.
// Encapsulation and QoS markings: 802.1ad QinQ outer 700 / inner 161, MPLS
// label 9200.
// Uses SNMPv2c get, response PDUs on UDP 161/162.
// Wireshark: (snmp && vlan) && mpls

host sla_poller {
    ip 172.25.146.10
    mac 00:1a:2b:19:92:10
}

host metro_nid {
    ip 172.25.146.1
    mac 00:1a:2b:19:92:01
}

flow snmpv2c_metro_sla(p, n) {
    p -> n snmp2 get community "metro_sla" reqid 4500 qinq 700 innervlan 161 mpls 9200 varbind 1.3.6.1.2.1.31.1.1.1.6.1 nullval
    p <- n snmp2 response community "metro_sla" reqid 4500 qinq 700 innervlan 161 mpls 9200 varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 9841209581024
}

compile {
    snmpv2c_metro_sla(sla_poller, metro_nid)
}
