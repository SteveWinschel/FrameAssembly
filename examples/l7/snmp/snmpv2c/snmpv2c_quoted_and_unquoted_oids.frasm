// PROMPT: Demonstrate FrameAssembly OID syntax flexibility using quoted OIDs, unquoted multi-segment OIDs, and 4-segment IPv4-shaped OIDs (1.3.6.1) in OID and OIDVAL fields.
// TOKENS: host, ip, mac, flow, snmp2, trap, community, reqid, oid, sysuptime, varbind, oidval, string, wait, ms, get, response, compile

// INSTRUCTION: Define an OID syntax test agent with IP 10.132.0.5.
host oid_agent { ip 10.132.0.5 mac 00:11:22:32:00:05 }

// INSTRUCTION: Define an OID syntax test manager with IP 10.132.0.100.
host oid_manager { ip 10.132.0.100 mac 00:11:22:32:00:64 }

// INSTRUCTION: Define a flow mixing quoted OIDs ("1.3.6.1.6.3.1.1.5.1"), unquoted OIDs (1.3.6.1.4.1.8072), and 4-arc OIDs (1.3.6.1).
flow oid_format_permutations(agent, manager) {
    agent -> manager snmp2 trap community "public" reqid 8501 oid "1.3.6.1.6.3.1.1.5.1"
        sysuptime 100
        varbind "1.3.6.1.2.1.1.2.0" oidval "1.3.6.1.4.1.8072.3.2.10"
        varbind 1.3.6.1.2.1.1.5.0 string "quoted-and-unquoted"
        wait 10ms
    agent <- manager snmp2 get community "public" reqid 8502 oid 1.3.6.1 wait 10ms
    agent -> manager snmp2 response community "public" reqid 8502
        varbind 1.3.6.1 oidval 1.3.6.1.4.1
        wait 10ms
}

// INSTRUCTION: Compile block to run the OID format permutation flow.
compile {
    oid_format_permutations(oid_agent, oid_manager)
}
