// PROMPT: SNMPv2c SetRequest updating IF-MIB ifAlias (1.3.6.1.2.1.31.1.1.1.18) with a carrier dark-fiber circuit ID.
// TOKENS: host, ip, mac, flow, snmp2, set, community, reqid, varbind, string, response, wait, ms, get, nullval, gauge32, compile

// INSTRUCTION: Define the network automation orchestrator (NetBox / Ansible).
host netbox_sync {
    ip 10.146.80.12
    mac 00:1a:2b:92:80:12
}

// INSTRUCTION: Define the metro DWDM muxponder router agent.
host dwdm_router {
    ip 10.146.80.1
    mac 00:1a:2b:92:80:01
}

// INSTRUCTION: Provision ifAlias.101 with the carrier circuit ID and read back ifHighSpeed.101 (100000 Mbps).
flow snmpv2c_set_ifalias(n, r) {
    n -> r snmp2 set community "netops_rw" reqid 5001 varbind 1.3.6.1.2.1.31.1.1.1.18.101 string "CID:DF-LON-FRA-100G-0492"
    n <- r snmp2 response community "netops_rw" reqid 5001 varbind 1.3.6.1.2.1.31.1.1.1.18.101 string "CID:DF-LON-FRA-100G-0492" wait 2ms
    n -> r snmp2 get community "netops_rw" reqid 5002 varbind 1.3.6.1.2.1.31.1.1.1.15.101 nullval
    n <- r snmp2 response community "netops_rw" reqid 5002 varbind 1.3.6.1.2.1.31.1.1.1.15.101 gauge32 100000
}

// INSTRUCTION: Compile the SNMPv2c ifAlias circuit provisioning flow.
compile {
    snmpv2c_set_ifalias(netbox_sync, dwdm_router)
}
