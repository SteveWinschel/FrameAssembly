// PROMPT: Simulate an SNMPv2c linkDown and linkUp flap sequence carrying interface counters (COUNTER32) and link speed gauges (GAUGE32).
// TOKENS: HOST, IP, MAC, FLOW, SNMP2, TRAP, COMMUNITY, REQID, OID, SYSUPTIME, VARBIND, INT, STRING, COUNTER32, GAUGE32, WAIT, COMPILE

// INSTRUCTION: Define a distribution switch experiencing link flapping with IP 10.125.0.10.
HOST flapping_switch { IP 10.125.0.10 MAC 00:1c:73:25:00:10 }

// INSTRUCTION: Define the trap collector server with IP 10.125.0.250.
HOST trap_collector { IP 10.125.0.250 MAC 00:1c:73:25:00:fa }

// INSTRUCTION: Define a flow sending linkDown (1.3.6.1.6.3.1.1.5.3) followed by linkUp (1.3.6.1.6.3.1.1.5.4) SNMPv2c traps.
FLOW snmpv2c_link_flap(agent, collector) {
    agent -> collector SNMP2 TRAP COMMUNITY "public" REQID 6001 OID 1.3.6.1.6.3.1.1.5.3
        SYSUPTIME 300100
        VARBIND 1.3.6.1.2.1.2.2.1.1.10 INT 10
        VARBIND 1.3.6.1.2.1.2.2.1.2.10 STRING "Ethernet10"
        VARBIND 1.3.6.1.2.1.2.2.1.14.10 COUNTER32 152
        VARBIND 1.3.6.1.2.1.2.2.1.5.10 GAUGE32 0
        WAIT 200ms
    agent -> collector SNMP2 TRAP COMMUNITY "public" REQID 6002 OID 1.3.6.1.6.3.1.1.5.4
        SYSUPTIME 300120
        VARBIND 1.3.6.1.2.1.2.2.1.1.10 INT 10
        VARBIND 1.3.6.1.2.1.2.2.1.2.10 STRING "Ethernet10"
        VARBIND 1.3.6.1.2.1.2.2.1.14.10 COUNTER32 152
        VARBIND 1.3.6.1.2.1.2.2.1.5.10 GAUGE32 1000000000
        WAIT 50ms
}

// INSTRUCTION: Compile block to execute the SNMPv2c link flap trap sequence.
COMPILE {
    snmpv2c_link_flap(flapping_switch, trap_collector)
}
