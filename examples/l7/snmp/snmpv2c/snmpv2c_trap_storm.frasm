// SNMPv2c linkDown (1.3.6.1.6.3.1.1.5.3) trap burst firing 5 traps spaced
// 10ms apart to an NMS collector.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.3 (linkDown).
// Timing: runs 5 cycles in compile using post-packet waits (10ms).
// Wireshark: snmp

host switch_agent { ip 10.1.1.254 }

host nms_server { ip 10.0.0.10 }

flow snmp_storm(agent, nms) {
    agent -> nms snmp2 trap community "public" oid "1.3.6.1.6.3.1.1.5.3" sysuptime 1000 wait 10ms
}

compile {
    snmp_storm(switch_agent, nms_server) // cycle 1 of 5
    snmp_storm(switch_agent, nms_server) // cycle 2 of 5
    snmp_storm(switch_agent, nms_server) // cycle 3 of 5
    snmp_storm(switch_agent, nms_server) // cycle 4 of 5
    snmp_storm(switch_agent, nms_server) // cycle 5 of 5
}
