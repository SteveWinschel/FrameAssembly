// PROMPT: Simulate an uninterruptible power supply (UPS) sending an SNMPv2c trap and responding to a GET query with TIMETICKS remaining battery runtime and GAUGE32 battery capacity.
// TOKENS: host, ip, mac, flow, snmp2, trap, community, reqid, oid, sysuptime, varbind, int, timeticks, wait, ms, get, nullval, response, gauge32, compile

// INSTRUCTION: Define a data center UPS management card with IP 10.130.0.20.
host ups_agent { ip 10.130.0.20 mac 00:c0:b7:30:00:20 }

// INSTRUCTION: Define a power monitoring server with IP 10.130.0.100.
host power_nms { ip 10.130.0.100 mac 00:c0:b7:30:00:64 }

// INSTRUCTION: Define a flow where the UPS sends an on-battery trap and answers a follow-up GET for remaining runtime in TIMETICKS.
flow ups_battery_monitoring(ups, nms) {
    ups -> nms snmp2 trap community "power_ro" reqid 8301 oid 1.3.6.1.2.1.33.2.0.1 sysuptime 950000 varbind 1.3.6.1.2.1.33.1.2.1.0 int 3 varbind 1.3.6.1.2.1.33.1.2.3.0 timeticks 180000 wait 20ms
    ups <- nms snmp2 get community "power_ro" reqid 8302 varbind 1.3.6.1.2.1.33.1.2.3.0 nullval varbind 1.3.6.1.2.1.33.1.2.4.0 nullval wait 10ms
    ups -> nms snmp2 response community "power_ro" reqid 8302 varbind 1.3.6.1.2.1.33.1.2.3.0 timeticks 178500 varbind 1.3.6.1.2.1.33.1.2.4.0 gauge32 88 wait 10ms
}

// INSTRUCTION: Compile block to run the UPS battery SNMPv2c monitoring flow.
compile {
    ups_battery_monitoring(ups_agent, power_nms)
}
