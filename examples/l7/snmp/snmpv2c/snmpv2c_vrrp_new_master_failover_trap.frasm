// PROMPT: SNMPv2c RFC 2787 VRRP-MIB vrrpTrapNewMaster notification alerting that the standby router assumed VIP ownership.
// TOKENS: host, ip, mac, flow, s, snmp2, trap, community, reqid, sysuptime, oid, varbind, ipval, compile

// INSTRUCTION: Define the newly promoted VRRP master router agent.
host vrrp_router_b {
    ip 10.146.40.3
    mac 00:1a:2b:92:40:03
}

// INSTRUCTION: Define the datacenter NOC trap receiver.
host dc_trap_sink {
    ip 10.146.40.100
    mac 00:1a:2b:92:40:64
}

// INSTRUCTION: Send vrrpTrapNewMaster (1.3.6.1.2.1.68.0.1) carrying vrrpOperMasterIpAddr varbind.
flow snmpv2c_vrrp_trap(r, s) {
    r -> s snmp2 trap community "ha_alerts" reqid 4600 sysuptime 884120 oid 1.3.6.1.2.1.68.0.1 varbind 1.3.6.1.2.1.68.1.3.1.7.1.10 ipval 10.146.40.3
}

// INSTRUCTION: Compile the SNMPv2c VRRP new master trap flow.
compile {
    snmpv2c_vrrp_trap(vrrp_router_b, dc_trap_sink)
}
