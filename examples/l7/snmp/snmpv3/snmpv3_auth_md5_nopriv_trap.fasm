// PROMPT: Generate an SNMPv3 authNoPriv TRAP authenticated with USM HMAC-MD5-96 (AUTH MD5) without encryption.
// TOKENS: HOST, IP, MAC, FLOW, ->, SNMP3, TRAP, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, MD5, OID, SYSUPTIME, VARBIND, STRING, INT, COMPILE

// INSTRUCTION: Define an SNMPv3 agent using HMAC-MD5 authentication with IP 10.141.0.5.
HOST v3_md5_agent { IP 10.141.0.5 MAC 00:1b:63:41:00:05 }

// INSTRUCTION: Define an SNMPv3 trap receiver with IP 10.141.0.100.
HOST v3_trap_sink { IP 10.141.0.100 MAC 00:1b:63:41:00:64 }

// INSTRUCTION: Define a flow sending an SNMPv3 authNoPriv trap signed with AUTH MD5.
FLOW snmpv3_auth_md5_trap(agent, sink) {
    agent -> sink SNMP3 TRAP USER "md5_operator" ENGINEID "8000000001020304" ENGINEBOOTS 5 ENGINETIME 18200 AUTH MD5 "md5_secret_key_99" OID 1.3.6.1.6.3.1.1.5.3 SYSUPTIME 1820000 VARBIND 1.3.6.1.2.1.2.2.1.1.1 INT 1 VARBIND 1.3.6.1.2.1.2.2.1.2.1 STRING "eth0_down_md5"
}

// INSTRUCTION: Compile block to emit the HMAC-MD5 signed SNMPv3 trap.
COMPILE {
    snmpv3_auth_md5_trap(v3_md5_agent, v3_trap_sink)
}
