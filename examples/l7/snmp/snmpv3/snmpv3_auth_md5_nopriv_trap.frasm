// Generate an SNMPv3 authNoPriv TRAP authenticated with USM HMAC-MD5-96 (auth
// MD5) without encryption.
// SNMPv3 USM security uses auth md5 with localized engineid keys.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.3 (linkDown).
// Wireshark: snmp

host v3_md5_agent { ip 10.141.0.5 mac 00:1b:63:41:00:05 }

host v3_trap_sink { ip 10.141.0.100 mac 00:1b:63:41:00:64 }

flow snmpv3_auth_md5_trap(agent, sink) {
    agent -> sink snmp3 trap user "md5_operator" engineid "8000000001020304" engineboots 5 enginetime 18200
        auth md5 "md5_secret_key_99" oid 1.3.6.1.6.3.1.1.5.3 sysuptime 1820000
        varbind 1.3.6.1.2.1.2.2.1.1.1 int 1
        varbind 1.3.6.1.2.1.2.2.1.2.1 string "eth0_down_md5"
}

compile {
    snmpv3_auth_md5_trap(v3_md5_agent, v3_trap_sink)
}
