// SNMPv3 authPriv GetNext walk using HMAC-MD5-96 authentication and AES-128
// privacy over VLAN 147.
// Encapsulation and QoS markings: 802.1Q VLAN 147.
// SNMPv3 USM security uses auth md5, priv aes with localized engineid keys.
// MIB objects / traps: 1.3.6.1.2.1.4.20.1.1 (IP-MIB), 1.3.6.1.2.1.4.20.1.1.1
// (IP-MIB).
// In Wireshark, add the engineid, user, auth, and priv passphrases under SNMP
// Users Table to decrypt.
// Wireshark: snmp && vlan.id == 147

host compliance_nms {
    ip 10.147.20.15
    mac 00:1a:2b:93:20:15
}

host dist_sw_v3 {
    ip 10.147.20.1
    mac 00:1a:2b:93:20:01
}

flow snmpv3_md5_aes_walk(m, a) {
    m -> a snmp3 getnext user "audit_md5" reqid 6301 engineid "80001f88" auth md5 "Md5Key2026!!" priv aes "AesKey2026!!" vlan 147 varbind 1.3.6.1.2.1.4.20.1.1 nullval
    m <- a snmp3 response user "audit_md5" reqid 6301 engineid "80001f88" auth md5 "Md5Key2026!!" priv aes "AesKey2026!!" vlan 147 varbind 1.3.6.1.2.1.4.20.1.1.1 ipval 10.147.20.1
}

compile {
    snmpv3_md5_aes_walk(compliance_nms, dist_sw_v3)
}
