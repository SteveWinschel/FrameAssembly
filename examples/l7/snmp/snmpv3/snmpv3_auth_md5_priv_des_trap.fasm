// PROMPT: Generate an RFC 3414 SNMPv3 authPriv TRAP using HMAC-MD5-96 authentication (AUTH MD5) and DES-CBC privacy encryption (PRIV DES).
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, TRAP, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, MD5, PRIV, DES, OID, SYSUPTIME, VARBIND, INT, STRING, COMPILE

// INSTRUCTION: Define a legacy SNMPv3 router agent configured with MD5 and DES with IP 10.146.0.5.
HOST v3_md5_des_agent { IP 10.146.0.5 MAC 00:0c:29:46:00:05 }

// INSTRUCTION: Define an SNMPv3 trap collector with IP 10.146.0.100.
HOST v3_md5_des_nms { IP 10.146.0.100 MAC 00:0c:29:46:00:64 }

// INSTRUCTION: Define a flow sending an encrypted SNMPv3 trap using AUTH MD5 and PRIV DES.
FLOW snmpv3_md5_des_trap(agent, nms) {
    agent -> nms SNMP3 TRAP USER "usm_md5_des" ENGINEID "80001f8880aa11bb22" ENGINEBOOTS 4 ENGINETIME 12000
        AUTH MD5 "md5_auth_key_123" PRIV DES "des_priv_key_456" OID 1.3.6.1.6.3.1.1.5.3
        SYSUPTIME 1200000
        VARBIND 1.3.6.1.2.1.2.2.1.1.3 INT 3
        VARBIND 1.3.6.1.2.1.2.2.1.2.3 STRING "FastEthernet0/3"
}

// INSTRUCTION: Compile block to emit the MD5 + DES encrypted SNMPv3 trap.
COMPILE {
    snmpv3_md5_des_trap(v3_md5_des_agent, v3_md5_des_nms)
}
