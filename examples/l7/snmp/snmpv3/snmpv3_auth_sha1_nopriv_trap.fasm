// PROMPT: Generate an SNMPv3 authNoPriv TRAP authenticated with USM HMAC-SHA-96 (AUTH SHA) and carrying COUNTER32 and GAUGE32 varbinds.
// TOKENS: host, ip, mac, flow, snmp3, trap, user, engineid, engineboots, enginetime, auth, sha, oid, sysuptime, varbind, counter32, gauge32, compile

// INSTRUCTION: Define an SNMPv3 agent using HMAC-SHA1 authentication with IP 10.142.0.5.
host v3_sha1_agent { ip 10.142.0.5 mac 00:1b:63:42:00:05 }

// INSTRUCTION: Define an SNMPv3 NMS server with IP 10.142.0.100.
host v3_sha1_nms { ip 10.142.0.100 mac 00:1b:63:42:00:64 }

// INSTRUCTION: Define a flow sending an SNMPv3 authNoPriv trap signed with AUTH SHA.
flow snmpv3_auth_sha1_trap(agent, nms) {
    agent -> nms snmp3 trap user "sha1_watcher" engineid "800000090300001b63420005" engineboots 12 enginetime 95400
        auth sha "sha1_auth_passphrase" oid 1.3.6.1.6.3.1.1.5.4 sysuptime 9540000
        varbind 1.3.6.1.2.1.2.2.1.10.2 counter32 4590123
        varbind 1.3.6.1.2.1.2.2.1.5.2 gauge32 1000000000
}

// INSTRUCTION: Compile block to emit the HMAC-SHA-96 signed SNMPv3 trap.
compile {
    snmpv3_auth_sha1_trap(v3_sha1_agent, v3_sha1_nms)
}
