// PROMPT: Simulate an RFC 7860 SNMPv3 authNoPriv INFORM notification and RESPONSE acknowledgment signed with HMAC-SHA-256 (AUTH SHA256).
// TOKENS: host, ip, mac, flow, router, snmp3, inform, user, engineid, engineboots, enginetime, auth, sha256, reqid, oid, sysuptime, varbind, string, ipval, wait, ms, response, compile

// INSTRUCTION: Define a branch router using SHA-256 USM authentication with IP 10.143.0.1.
host v3_sha256_router { ip 10.143.0.1 mac 00:1c:73:43:00:01 }

// INSTRUCTION: Define a central NMS inform receiver with IP 10.143.0.200.
host v3_sha256_nms { ip 10.143.0.200 mac 00:1c:73:43:00:c8 }

// INSTRUCTION: Define a flow sending an SNMPv3 INFORM signed with AUTH SHA256 and receiving an authenticated RESPONSE.
flow snmpv3_sha256_inform(router, nms) {
    router -> nms snmp3 inform user "sha256_admin" engineid "80007571010a8f0001" engineboots 7 enginetime 36000
        auth sha256 "sha256_strong_auth_key" reqid 9101 oid 1.3.6.1.6.3.1.1.5.3
        sysuptime 3600000
        varbind 1.3.6.1.2.1.1.5.0 string "br-rtr-sha256"
        varbind 1.3.6.1.2.1.4.20.1.1.10.143.0.1 ipval 10.143.0.1
        wait 15ms
    router <- nms snmp3 response user "sha256_admin" engineid "80007571010a8f0001" engineboots 7 enginetime 36000
        auth sha256 "sha256_strong_auth_key" reqid 9101
        varbind 1.3.6.1.2.1.1.5.0 string "br-rtr-sha256"
        varbind 1.3.6.1.2.1.4.20.1.1.10.143.0.1 ipval 10.143.0.1
        wait 10ms
}

// INSTRUCTION: Compile block to run the SHA-256 authenticated SNMPv3 INFORM flow.
compile {
    snmpv3_sha256_inform(v3_sha256_router, v3_sha256_nms)
}
