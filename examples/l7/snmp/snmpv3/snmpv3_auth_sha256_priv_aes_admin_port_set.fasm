// PROMPT: SNMPv3 authPriv SetRequest disabling an unused switch port (ifAdminStatus = down(2)) using SHA-256 and AES-128.
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, SET, USER, REQID, ENGINEID, AUTH, SHA256, PRIV, AES, VARBIND, INT, RESPONSE, COMPILE

// INSTRUCTION: Define the NAC (Network Access Control) policy enforcement server.
HOST nac_enforcer {
    IP 10.147.50.10
    MAC 00:1a:2b:93:50:10
}

// INSTRUCTION: Define the wiring closet access switch SNMPv3 agent.
HOST closet_sw {
    IP 10.147.50.2
    MAC 00:1a:2b:93:50:02
}

// INSTRUCTION: Issue an encrypted SNMPv3 SET setting ifAdminStatus.24 (1.3.6.1.2.1.2.2.1.7.24) to 2 (down).
FLOW snmpv3_nac_port_shutdown(n, s) {
    n -> s SNMP3 SET USER "nac_rw" REQID 6600 ENGINEID "80000009" AUTH SHA256 "NacSha256Key!" PRIV AES "NacAes128Key!" VARBIND 1.3.6.1.2.1.2.2.1.7.24 INT 2
    n <- s SNMP3 RESPONSE USER "nac_rw" REQID 6600 ENGINEID "80000009" AUTH SHA256 "NacSha256Key!" PRIV AES "NacAes128Key!" VARBIND 1.3.6.1.2.1.2.2.1.7.24 INT 2
}

// INSTRUCTION: Compile the SNMPv3 NAC port shutdown SET flow.
COMPILE {
    snmpv3_nac_port_shutdown(nac_enforcer, closet_sw)
}
