// PROMPT: SNMPv3 authPriv GET and RESPONSE using HMAC-SHA-256 authentication and AES-128 CFB encryption.
// TOKENS: host, ip, mac, flow, m, snmp3, get, user, reqid, engineid, auth, sha256, priv, aes, varbind, nullval, response, counter64, compile

// INSTRUCTION: Define the hardened NOC monitoring station.
host v3_poller {
    ip 10.147.1.10
    mac 00:1a:2b:93:01:10
}

// INSTRUCTION: Define the core firewall SNMPv3 agent.
host core_fw_v3 {
    ip 10.147.1.1
    mac 00:1a:2b:93:01:01
}

// INSTRUCTION: Poll sysName.0 and ifHCInOctets.1 using SNMPv3 USM SHA256 + AES128.
flow snmpv3_sha256_aes_get(m, a) {
    m -> a snmp3 get user "sec_poller" reqid 6100 engineid "80001f88" auth sha256 "Sha256Key99!" priv aes "Aes128Key99!" varbind 1.3.6.1.2.1.31.1.1.1.6.1 nullval
    m <- a snmp3 response user "sec_poller" reqid 6100 engineid "80001f88" auth sha256 "Sha256Key99!" priv aes "Aes128Key99!" varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 184920194820
}

// INSTRUCTION: Compile the SNMPv3 SHA256 + AES GET/RESPONSE flow.
compile {
    snmpv3_sha256_aes_get(v3_poller, core_fw_v3)
}
