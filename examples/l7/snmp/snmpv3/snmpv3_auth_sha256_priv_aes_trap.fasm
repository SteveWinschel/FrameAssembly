// PROMPT: Generate a production-grade SNMPv3 authPriv TRAP using HMAC-SHA-256 authentication (AUTH SHA256) and AES-128-CFB encryption (PRIV AES).
// TOKENS: host, ip, mac, flow, router, snmp3, trap, user, engineid, engineboots, enginetime, contextname, reqid, auth, sha256, priv, aes, oid, sysuptime, varbind, string, int, counter64, compile

// INSTRUCTION: Define a core data center router with IP 10.151.0.1.
host v3_sha256_aes_rtr { ip 10.151.0.1 mac 00:25:90:51:00:01 }

// INSTRUCTION: Define a hardened SOC trap receiver with IP 10.151.0.250.
host v3_sha256_aes_soc { ip 10.151.0.250 mac 00:25:90:51:00:fa }

// INSTRUCTION: Define a flow sending an SNMPv3 trap secured with AUTH SHA256 and PRIV AES.
flow snmpv3_sha256_aes_trap(router, soc) {
    router -> soc snmp3 trap user "usm_sha256_aes" engineid "80001f8880510001" engineboots 30 enginetime 400000 contextname "core-fabric"
        reqid 9701 auth sha256 "sha256_prod_auth_pass" priv aes "aes128_prod_priv_pass" oid 1.3.6.1.6.3.1.1.5.3
        sysuptime 40000000
        varbind 1.3.6.1.2.1.31.1.1.1.1.10 string "HundredGigE0/0/0/10"
        varbind 1.3.6.1.2.1.2.2.1.8.10 int 2
        varbind 1.3.6.1.2.1.31.1.1.1.6.10 counter64 88776655443322
}

// INSTRUCTION: Compile block to emit the SHA256 + AES encrypted SNMPv3 trap.
compile {
    snmpv3_sha256_aes_trap(v3_sha256_aes_rtr, v3_sha256_aes_soc)
}
