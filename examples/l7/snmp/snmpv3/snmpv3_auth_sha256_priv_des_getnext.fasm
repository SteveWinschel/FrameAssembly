// PROMPT: Simulate an encrypted SNMPv3 GETNEXT and RESPONSE MIB walk step using HMAC-SHA-256 authentication (AUTH SHA256) and DES-CBC encryption (PRIV DES).
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, SNMP3, GETNEXT, RESPONSE, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA256, PRIV, DES, REQID, VARBIND, NULLVAL, OIDVAL, IPVAL, WAIT, ms, COMPILE

// INSTRUCTION: Define an SNMPv3 security scanner polling a router with IP 10.150.0.10.
HOST v3_sha256_des_mgr { IP 10.150.0.10 MAC 00:21:5a:50:00:10 }

// INSTRUCTION: Define an SNMPv3 router agent with IP 10.150.0.1.
HOST v3_sha256_des_rtr { IP 10.150.0.1 MAC 00:21:5a:50:00:01 }

// INSTRUCTION: Define a flow performing an SNMPv3 GETNEXT request and RESPONSE using AUTH SHA256 and PRIV DES.
FLOW snmpv3_sha256_des_getnext(mgr, rtr) {
    mgr -> rtr SNMP3 GETNEXT USER "usm_sha256_des" ENGINEID "80001f8880500001" ENGINEBOOTS 6 ENGINETIME 50000 AUTH SHA256 "sha256_auth_secret_key" PRIV DES "des_priv_secret_key" REQID 9601 VARBIND 1.3.6.1.2.1.1.2 NULLVAL VARBIND 1.3.6.1.2.1.4.20.1.1 NULLVAL WAIT 10ms
    mgr <- rtr SNMP3 RESPONSE USER "usm_sha256_des" ENGINEID "80001f8880500001" ENGINEBOOTS 6 ENGINETIME 50000 AUTH SHA256 "sha256_auth_secret_key" PRIV DES "des_priv_secret_key" REQID 9601 VARBIND 1.3.6.1.2.1.1.2.0 OIDVAL 1.3.6.1.4.1.9.1.2494 VARBIND 1.3.6.1.2.1.4.20.1.1.10.150.0.1 IPVAL 10.150.0.1 WAIT 10ms
}

// INSTRUCTION: Compile block to run the SHA256 + DES SNMPv3 GETNEXT flow.
COMPILE {
    snmpv3_sha256_des_getnext(v3_sha256_des_mgr, v3_sha256_des_rtr)
}
