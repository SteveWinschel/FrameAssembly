// Simulate an encrypted SNMPv3 GETNEXT and RESPONSE MIB walk step using
// HMAC-SHA-256 authentication (auth SHA256) and DES-CBC encryption (priv
// DES).
// SNMPv3 USM security uses auth sha256, priv des with localized engineid
// keys.
// MIB objects / traps: 1.3.6.1.2.1.4.20.1.1 (IP-MIB), 1.3.6.1.2.1.1.2.0
// (sysObjectID.0), 1.3.6.1.2.1.4.20.1.1.10.150.0.1 (IP-MIB).
// In Wireshark, add the engineid, user, auth, and priv passphrases under SNMP
// Users Table to decrypt.
// Timing: pauses 10ms after each marked packet before sending the next frame.
// Wireshark: snmp

host v3_sha256_des_mgr { ip 10.150.0.10 mac 00:21:5a:50:00:10 }

host v3_sha256_des_rtr { ip 10.150.0.1 mac 00:21:5a:50:00:01 }

flow snmpv3_sha256_des_getnext(mgr, rtr) {
    mgr -> rtr snmp3 getnext user "usm_sha256_des" engineid "80001f8880500001" engineboots 6 enginetime 50000
        auth sha256 "sha256_auth_secret_key" priv des "des_priv_secret_key"
        reqid 9601
        varbind 1.3.6.1.2.1.1.2 nullval
        varbind 1.3.6.1.2.1.4.20.1.1 nullval
        wait 10ms
    mgr <- rtr snmp3 response user "usm_sha256_des" engineid "80001f8880500001" engineboots 6 enginetime 50000
        auth sha256 "sha256_auth_secret_key" priv des "des_priv_secret_key"
        reqid 9601
        varbind 1.3.6.1.2.1.1.2.0 oidval 1.3.6.1.4.1.9.1.2494
        varbind 1.3.6.1.2.1.4.20.1.1.10.150.0.1 ipval 10.150.0.1
        wait 10ms
}

compile {
    snmpv3_sha256_des_getnext(v3_sha256_des_mgr, v3_sha256_des_rtr)
}
