// PROMPT: Simulate an encrypted SNMPv3 SET request and RESPONSE using HMAC-SHA-384 authentication (AUTH SHA384) and DES-CBC encryption (PRIV DES).
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, SET, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA384, PRIV, DES, REQID, VARBIND, STRING, INT, WAIT, RESPONSE, COMPILE

// INSTRUCTION: Define a network provisioning server with IP 10.152.0.100.
HOST v3_sha384_des_prov { IP 10.152.0.100 MAC 00:16:3e:52:00:64 }

// INSTRUCTION: Define an edge switch agent with IP 10.152.0.10.
HOST v3_sha384_des_sw { IP 10.152.0.10 MAC 00:16:3e:52:00:0a }

// INSTRUCTION: Define a flow executing an SNMPv3 SET and RESPONSE secured with AUTH SHA384 and PRIV DES.
FLOW snmpv3_sha384_des_set(prov, sw) {
    prov -> sw SNMP3 SET USER "usm_sha384_des" ENGINEID "80001f888052000a" ENGINEBOOTS 11 ENGINETIME 65000
        AUTH SHA384 "sha384_prov_auth_key" PRIV DES "des_prov_priv_key"
        REQID 9801
        VARBIND 1.3.6.1.2.1.1.6.0 STRING "DC2 Row 4 Rack 12"
        VARBIND 1.3.6.1.2.1.2.2.1.7.12 INT 1
        WAIT 10ms
    prov <- sw SNMP3 RESPONSE USER "usm_sha384_des" ENGINEID "80001f888052000a" ENGINEBOOTS 11 ENGINETIME 65000
        AUTH SHA384 "sha384_prov_auth_key" PRIV DES "des_prov_priv_key"
        REQID 9801
        VARBIND 1.3.6.1.2.1.1.6.0 STRING "DC2 Row 4 Rack 12"
        VARBIND 1.3.6.1.2.1.2.2.1.7.12 INT 1
        WAIT 10ms
}

// INSTRUCTION: Compile block to run the SHA384 + DES SNMPv3 SET flow.
COMPILE {
    snmpv3_sha384_des_set(v3_sha384_des_prov, v3_sha384_des_sw)
}
