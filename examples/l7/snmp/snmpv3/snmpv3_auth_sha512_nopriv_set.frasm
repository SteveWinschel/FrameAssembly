// Simulate an RFC 7860 SNMPv3 authNoPriv SET request and RESPONSE
// authenticated with HMAC-SHA-512 (auth SHA512).
// SNMPv3 USM security uses auth sha512 with localized engineid keys.
// Targets SNMPv3 MIB context(s): global.
// MIB objects / traps: 1.3.6.1.2.1.1.5.0 (sysName.0).
// Timing: pauses 10ms after each marked packet before sending the next frame.
// Wireshark: snmp

host v3_sha512_orchestrator { ip 10.145.0.100 mac 00:50:56:45:00:64 }

host v3_sha512_router { ip 10.145.0.1 mac 00:50:56:45:00:01 }

flow snmpv3_sha512_set(orch, router) {
    orch -> router snmp3 set user "sha512_netadmin" engineid "800000090300005056450001" engineboots 9 enginetime 54000 contextname "global"
        reqid 9301 auth sha512 "sha512_master_auth_password"
        varbind 1.3.6.1.2.1.1.5.0 string "core-rtr-sha512"
        varbind 1.3.6.1.2.1.2.2.1.7.1 int 1
        wait 10ms
    orch <- router snmp3 response user "sha512_netadmin" engineid "800000090300005056450001" engineboots 9 enginetime 54000 contextname "global"
        reqid 9301 auth sha512 "sha512_master_auth_password"
        varbind 1.3.6.1.2.1.1.5.0 string "core-rtr-sha512"
        varbind 1.3.6.1.2.1.2.2.1.7.1 int 1
        wait 10ms
}

compile {
    snmpv3_sha512_set(v3_sha512_orchestrator, v3_sha512_router)
}
