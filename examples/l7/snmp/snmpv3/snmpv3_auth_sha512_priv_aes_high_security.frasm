// PROMPT: Generate a maximum-security SNMPv3 authPriv packet using HMAC-SHA-512 (AUTH SHA512), AES-128-CFB (PRIV AES), and all 9 VARBIND types.
// TOKENS: host, ip, flow, snmp3, get, user, engineid, reqid, auth, sha512, priv, aes, varbind, nullval, response, string, int, timeticks, ipval, oidval, counter32, gauge32, counter64, compile

// INSTRUCTION: Define a classified enclave monitoring station with IP 10.155.0.10.
host enclave_nms { ip 10.155.0.10 }

// INSTRUCTION: Define a cryptographic gateway agent with IP 10.155.0.1.
host crypto_gw_agent { ip 10.155.0.1 }

// INSTRUCTION: Define a flow exchanging SHA512 + AES encrypted SNMPv3 GET and RESPONSE packets containing all 9 VarBind data types.
flow snmpv3_sha512_aes_all_varbinds(nms, gw) {
    nms -> gw snmp3 get user "secops_sha512_aes" engineid "80001f8880550001"
        reqid 9990 auth sha512 "sha512_top_secret_auth_key" priv aes "aes128_top_secret_priv_key"
        varbind 1.3.6.1.2.1.1.1.0 nullval
    nms <- gw snmp3 response user "secops_sha512_aes" engineid "80001f8880550001"
        reqid 9990 auth sha512 "sha512_top_secret_auth_key" priv aes "aes128_top_secret_priv_key"
        varbind 1.3.6.1.2.1.1.4.0 nullval
        varbind 1.3.6.1.2.1.1.5.0 string "crypto-gw-alpha"
        varbind 1.3.6.1.4.1.9999.1.2.0 int -9
        varbind 1.3.6.1.2.1.1.3.0 timeticks 50000000
        varbind 1.3.6.1.2.1.4.20.1.1.10.155.0.1 ipval 10.155.0.1
        varbind 1.3.6.1.2.1.1.2.0 oidval 1.3.6.1.4.1.8072.3.2.10
        varbind 1.3.6.1.2.1.2.2.1.10.1 counter32 12345678
        varbind 1.3.6.1.2.1.2.2.1.5.1 gauge32 1000000000
        varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 18446744073709551
}

// INSTRUCTION: Compile block to execute the SHA512 + AES 9-varbind SNMPv3 flow.
compile {
    snmpv3_sha512_aes_all_varbinds(enclave_nms, crypto_gw_agent)
}
