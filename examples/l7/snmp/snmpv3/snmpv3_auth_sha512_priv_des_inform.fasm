// PROMPT: Simulate an encrypted SNMPv3 INFORM notification and RESPONSE using HMAC-SHA-512 authentication (AUTH SHA512) and DES-CBC encryption (PRIV DES).
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, INFORM, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA512, PRIV, DES, REQID, OID, SYSUPTIME, VARBIND, STRING, IPVAL, WAIT, RESPONSE, COMPILE

// INSTRUCTION: Define a border gateway agent with IP 10.154.0.1.
HOST v3_sha512_des_gw { IP 10.154.0.1 MAC 00:25:90:54:00:01 }

// INSTRUCTION: Define an NMS inform collector with IP 10.154.0.200.
HOST v3_sha512_des_nms { IP 10.154.0.200 MAC 00:25:90:54:00:c8 }

// INSTRUCTION: Define a flow sending an SNMPv3 INFORM and receiving a RESPONSE using AUTH SHA512 and PRIV DES.
FLOW snmpv3_sha512_des_inform(gw, nms) {
    gw -> nms SNMP3 INFORM USER "usm_sha512_des" ENGINEID "80001f8880540001" ENGINEBOOTS 14 ENGINETIME 77000
        AUTH SHA512 "sha512_inform_auth_key" PRIV DES "des_inform_priv_key"
        REQID 9950 OID 1.3.6.1.6.3.1.1.5.5 SYSUPTIME 7700000
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "border-gw-01"
        VARBIND 1.3.6.1.2.1.4.20.1.1.10.154.0.1 IPVAL 10.154.0.1
        WAIT 15ms
    gw <- nms SNMP3 RESPONSE USER "usm_sha512_des" ENGINEID "80001f8880540001" ENGINEBOOTS 14 ENGINETIME 77000
        AUTH SHA512 "sha512_inform_auth_key" PRIV DES "des_inform_priv_key"
        REQID 9950
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "border-gw-01"
        VARBIND 1.3.6.1.2.1.4.20.1.1.10.154.0.1 IPVAL 10.154.0.1
        WAIT 10ms
}

// INSTRUCTION: Compile block to run the SHA512 + DES SNMPv3 INFORM flow.
COMPILE {
    snmpv3_sha512_des_inform(v3_sha512_des_gw, v3_sha512_des_nms)
}
