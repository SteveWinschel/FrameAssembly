// PROMPT: Simulate an encrypted SNMPv3 GET and RESPONSE exchange using HMAC-SHA-96 authentication (AUTH SHA) and DES-CBC privacy (PRIV DES).
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, GET, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA, PRIV, DES, REQID, VARBIND, NULLVAL, WAIT, RESPONSE, STRING, INT, COMPILE

// INSTRUCTION: Define an SNMPv3 polling station with IP 10.148.0.10.
HOST v3_sha_des_poller { IP 10.148.0.10 MAC 00:1a:a0:48:00:10 }

// INSTRUCTION: Define an SNMPv3 managed firewall with IP 10.148.0.1.
HOST v3_sha_des_fw { IP 10.148.0.1 MAC 00:1a:a0:48:00:01 }

// INSTRUCTION: Define a flow polling sysName and ifNumber over SNMPv3 with AUTH SHA and PRIV DES.
FLOW snmpv3_sha_des_poll(poller, fw) {
    poller -> fw SNMP3 GET USER "usm_sha_des" ENGINEID "800000090300001aa0480001" ENGINEBOOTS 15 ENGINETIME 86400
        AUTH SHA "sha1_pass_phrase" PRIV DES "des_cbc_pass_key" REQID 9401
        VARBIND 1.3.6.1.2.1.1.5.0 NULLVAL
        VARBIND 1.3.6.1.2.1.2.1.0 NULLVAL
        WAIT 10ms
    poller <- fw SNMP3 RESPONSE USER "usm_sha_des" ENGINEID "800000090300001aa0480001" ENGINEBOOTS 15 ENGINETIME 86400
        AUTH SHA "sha1_pass_phrase" PRIV DES "des_cbc_pass_key" REQID 9401
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "fw-sha-des-01"
        VARBIND 1.3.6.1.2.1.2.1.0 INT 16
        WAIT 10ms
}

// INSTRUCTION: Compile block to run the SHA + DES encrypted SNMPv3 GET/RESPONSE flow.
COMPILE {
    snmpv3_sha_des_poll(v3_sha_des_poller, v3_sha_des_fw)
}
