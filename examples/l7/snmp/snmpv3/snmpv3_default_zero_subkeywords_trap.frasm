// Minimal 2-block SNMPv3 USM (RFC 3414 / 7860) starter emitting automatic
// protocol defaults directly from the compile block (zero flow wrapper).
// Uses SNMPv3 default trap PDUs on UDP 161/162.
// Wireshark: snmp

host snmp3_def_agent {
    ip 10.147.0.1
    mac 00:1a:2b:93:00:01
}

host snmp3_def_mgr {
    ip 10.147.0.10
    mac 00:1a:2b:93:00:10
}

compile {
    snmp3_def_agent -> snmp3_def_mgr snmp3
}
