// PROMPT: Exercise RFC 3414 DES-CBC zero-padding across different ScopedPDU lengths by sending SNMPv3 PRIV DES packets with varying STRING varbind lengths.
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, TRAP, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, REQID, AUTH, SHA, PRIV, DES, OID, SYSUPTIME, VARBIND, STRING, WAIT, COMPILE

// INSTRUCTION: Define an SNMPv3 crypto test agent with IP 10.158.0.5.
HOST des_pad_agent { IP 10.158.0.5 MAC 00:1a:2b:58:00:05 }

// INSTRUCTION: Define an SNMPv3 crypto test receiver with IP 10.158.0.100.
HOST des_pad_receiver { IP 10.158.0.100 MAC 00:1a:2b:58:00:64 }

// INSTRUCTION: Define a flow sending 4 DES-CBC encrypted traps with string varbinds of lengths 1, 4, 8, and 13 bytes to test block alignment.
FLOW des_cbc_padding_vectors(agent, receiver) {
    agent -> receiver SNMP3 TRAP USER "des_tester" ENGINEID "80001f8880580005" ENGINEBOOTS 1 ENGINETIME 100
        REQID 10301 AUTH SHA "des_test_auth_123" PRIV DES "des_test_priv_123" OID 1.3.6.1.6.3.1.1.5.1
        SYSUPTIME 100
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "A"
        WAIT 5ms
    agent -> receiver SNMP3 TRAP USER "des_tester" ENGINEID "80001f8880580005" ENGINEBOOTS 1 ENGINETIME 101
        REQID 10302 AUTH SHA "des_test_auth_123" PRIV DES "des_test_priv_123" OID 1.3.6.1.6.3.1.1.5.1
        SYSUPTIME 101
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "ABCD"
        WAIT 5ms
    agent -> receiver SNMP3 TRAP USER "des_tester" ENGINEID "80001f8880580005" ENGINEBOOTS 1 ENGINETIME 102
        REQID 10303 AUTH SHA "des_test_auth_123" PRIV DES "des_test_priv_123" OID 1.3.6.1.6.3.1.1.5.1
        SYSUPTIME 102
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "ABCDEFGH"
        WAIT 5ms
    agent -> receiver SNMP3 TRAP USER "des_tester" ENGINEID "80001f8880580005" ENGINEBOOTS 1 ENGINETIME 103
        REQID 10304 AUTH SHA "des_test_auth_123" PRIV DES "des_test_priv_123" OID 1.3.6.1.6.3.1.1.5.1
        SYSUPTIME 103
        VARBIND 1.3.6.1.2.1.1.5.0 STRING "ABCDEFGHIJKLM"
        WAIT 5ms
}

// INSTRUCTION: Compile block to run the DES-CBC block padding test flow.
COMPILE {
    des_cbc_padding_vectors(des_pad_agent, des_pad_receiver)
}
