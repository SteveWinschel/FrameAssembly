// PROMPT: Advanced SNMPv3 security parameters configuring ENGINEID, ENGINEBOOTS, ENGINETIME, and CONTEXTNAME.
// TOKENS: HOST, IP, FLOW, SNMP3, TRAP, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, CONTEXTNAME, OID, COMPILE

// INSTRUCTION: Define multi-tenant SNMPv3 agent.
HOST engine_agent { IP 10.20.30.1 }

// INSTRUCTION: Define multi-tenant SNMPv3 NMS receiver.
HOST engine_nms { IP 10.20.30.2 }

// INSTRUCTION: Define engine time, boots, and context name configuration flow.
FLOW engine_param_flow(a, n) {
    a -> n SNMP3 TRAP USER "admin" ENGINEID "8000000001" ENGINEBOOTS 3 ENGINETIME 7200 CONTEXTNAME "datacenter-west" OID 1.3.6.1.6.3.1.1.5.1
}

// INSTRUCTION: Compile block executing advanced SNMPv3 security parameters.
COMPILE {
    engine_param_flow(engine_agent, engine_nms)
}
