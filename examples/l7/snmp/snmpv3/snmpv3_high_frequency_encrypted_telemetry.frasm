// Stream high-frequency encrypted SNMPv3 telemetry traps (auth SHA256, priv
// AES) with 64-bit counters and optical gauges inside a repeated flow calls.
// SNMPv3 USM security uses auth sha256, priv aes with localized engineid
// keys.
// Uses SNMPv3 trap PDUs on UDP 161/162.
// In Wireshark, add the engineid, user, auth, and priv passphrases under SNMP
// Users Table to decrypt.
// Timing: runs 5 cycles in compile using post-packet waits (25ms).
// Wireshark: snmp

host core_telemetry_agent { ip 10.159.0.1 mac 00:25:90:59:00:01 }

host telemetry_sink { ip 10.159.0.250 mac 00:25:90:59:00:fa }

flow encrypted_telemetry_burst(agent, sink) {
    agent -> sink snmp3 trap user "stream_sec" engineid "80001f8880590001" engineboots 50 enginetime 900000
        auth sha256 "stream_sha256_key" priv aes "stream_aes128_key" oid 1.3.6.1.4.1.9.9.719
        sysuptime 90000000
        varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 44556677889900
        varbind 1.3.6.1.2.1.2.2.1.21.1 gauge32 128
        varbind 1.3.6.1.4.1.9.9.91.1.1.1.1.4.1 int -7
        wait 25ms
}

compile {
    encrypted_telemetry_burst(core_telemetry_agent, telemetry_sink) // cycle 1 of 5
    encrypted_telemetry_burst(core_telemetry_agent, telemetry_sink) // cycle 2 of 5
    encrypted_telemetry_burst(core_telemetry_agent, telemetry_sink) // cycle 3 of 5
    encrypted_telemetry_burst(core_telemetry_agent, telemetry_sink) // cycle 4 of 5
    encrypted_telemetry_burst(core_telemetry_agent, telemetry_sink) // cycle 5 of 5
}
