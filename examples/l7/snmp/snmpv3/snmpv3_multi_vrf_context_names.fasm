// PROMPT: Poll isolated VRF routing tables on a multi-tenant PE router using SNMPv3 CONTEXTNAME strings ("vrf-prod", "vrf-pci", "vrf-guest").
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, GET, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, CONTEXTNAME, REQID, AUTH, SHA256, PRIV, AES, VARBIND, NULLVAL, WAIT, RESPONSE, IPVAL, INT, COMPILE

// INSTRUCTION: Define a multi-tenant MPLS NMS poller with IP 10.156.0.10.
HOST mpls_poller { IP 10.156.0.10 MAC 00:1b:54:56:00:10 }

// INSTRUCTION: Define a Provider Edge (PE) router hosting multiple VRFs with IP 10.156.0.1.
HOST pe_router { IP 10.156.0.1 MAC 00:1b:54:56:00:01 }

// INSTRUCTION: Define a flow querying each VRF's routing table by varying the SNMPv3 ScopedPDU CONTEXTNAME.
FLOW poll_multi_vrf_contexts(poller, pe) {
    poller -> pe SNMP3 GET USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80000 CONTEXTNAME "vrf-prod"
        REQID 10101 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.7.0.0.0.0 NULLVAL
        WAIT 10ms
    poller <- pe SNMP3 RESPONSE USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80000 CONTEXTNAME "vrf-prod"
        REQID 10101 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.7.0.0.0.0 IPVAL 10.1.254.1
        WAIT 10ms
    poller -> pe SNMP3 GET USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80001 CONTEXTNAME "vrf-pci"
        REQID 10102 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.7.0.0.0.0 NULLVAL
        WAIT 10ms
    poller <- pe SNMP3 RESPONSE USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80001 CONTEXTNAME "vrf-pci"
        REQID 10102 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.7.0.0.0.0 IPVAL 172.31.254.1
        WAIT 10ms
    poller -> pe SNMP3 GET USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80002 CONTEXTNAME "vrf-guest"
        REQID 10103 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.8.0.0.0.0 NULLVAL
        WAIT 10ms
    poller <- pe SNMP3 RESPONSE USER "vrf_auditor" ENGINEID "800000090300001b54560001" ENGINEBOOTS 10 ENGINETIME 80002 CONTEXTNAME "vrf-guest"
        REQID 10103 AUTH SHA256 "vrf_auth_secret" PRIV AES "vrf_priv_secret"
        VARBIND 1.3.6.1.2.1.4.21.1.8.0.0.0.0 INT 4
        WAIT 10ms
}

// INSTRUCTION: Compile block to run the multi-VRF SNMPv3 context polling flow.
COMPILE {
    poll_multi_vrf_contexts(mpls_poller, pe_router)
}
