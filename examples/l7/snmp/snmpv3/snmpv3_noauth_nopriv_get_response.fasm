// PROMPT: Simulate an SNMPv3 noAuthNoPriv GET request and RESPONSE exchange configuring USER, ENGINEID, ENGINEBOOTS, ENGINETIME, CONTEXTNAME, and REQID without AUTH or PRIV.
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, SNMP3, GET, RESPONSE, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, CONTEXTNAME, REQID, VARBIND, NULLVAL, STRING, TIMETICKS, WAIT, ms, COMPILE

// INSTRUCTION: Define an SNMPv3 management client with IP 10.140.0.10.
HOST v3_poller { IP 10.140.0.10 MAC 00:15:5d:40:00:10 }

// INSTRUCTION: Define an SNMPv3 agent configured for noAuthNoPriv lab access with IP 10.140.0.1.
HOST v3_lab_agent { IP 10.140.0.1 MAC 00:15:5d:40:00:01 }

// INSTRUCTION: Define a flow sending an unauthenticated SNMPv3 GET request and receiving a cleartext ScopedPDU RESPONSE.
FLOW snmpv3_noauth_nopriv_poll(poller, agent) {
    poller -> agent SNMP3 GET USER "lab_readonly" ENGINEID "80001f888001020304" ENGINEBOOTS 3 ENGINETIME 4200 CONTEXTNAME "default" REQID 9001 VARBIND 1.3.6.1.2.1.1.1.0 NULLVAL VARBIND 1.3.6.1.2.1.1.3.0 NULLVAL WAIT 10ms
    poller <- agent SNMP3 RESPONSE USER "lab_readonly" ENGINEID "80001f888001020304" ENGINEBOOTS 3 ENGINETIME 4200 CONTEXTNAME "default" REQID 9001 VARBIND 1.3.6.1.2.1.1.1.0 STRING "Net-SNMP 5.9.4 Agent" VARBIND 1.3.6.1.2.1.1.3.0 TIMETICKS 420000 WAIT 10ms
}

// INSTRUCTION: Compile block to run the SNMPv3 noAuthNoPriv GET/RESPONSE flow.
COMPILE {
    snmpv3_noauth_nopriv_poll(v3_poller, v3_lab_agent)
}
