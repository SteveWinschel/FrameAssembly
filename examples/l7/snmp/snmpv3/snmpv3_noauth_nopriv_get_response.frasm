// Simulate an SNMPv3 noAuthNoPriv GET request and RESPONSE exchange
// configuring USER, engineid, engineboots, enginetime, contextname, and reqid
// without auth or priv.
// Targets SNMPv3 MIB context(s): default.
// MIB objects / traps: 1.3.6.1.2.1.1.1.0 (sysDescr.0), 1.3.6.1.2.1.1.3.0
// (sysUpTime.0).
// Timing: pauses 10ms after each marked packet before sending the next frame.
// Wireshark: snmp

host v3_poller { ip 10.140.0.10 mac 00:15:5d:40:00:10 }

host v3_lab_agent { ip 10.140.0.1 mac 00:15:5d:40:00:01 }

flow snmpv3_noauth_nopriv_poll(poller, agent) {
    poller -> agent snmp3 get user "lab_readonly" engineid "80001f888001020304" engineboots 3 enginetime 4200 contextname "default"
        reqid 9001
        varbind 1.3.6.1.2.1.1.1.0 nullval
        varbind 1.3.6.1.2.1.1.3.0 nullval
        wait 10ms
    poller <- agent snmp3 response user "lab_readonly" engineid "80001f888001020304" engineboots 3 enginetime 4200 contextname "default"
        reqid 9001
        varbind 1.3.6.1.2.1.1.1.0 string "Net-SNMP 5.9.4 Agent"
        varbind 1.3.6.1.2.1.1.3.0 timeticks 420000
        wait 10ms
}

compile {
    snmpv3_noauth_nopriv_poll(v3_poller, v3_lab_agent)
}
