// PROMPT: SNMPv3 noAuthNoPriv INFORM request and RESPONSE acknowledgment with explicit USM EngineID and ContextName.
// TOKENS: HOST, IP, MAC, FLOW, SNMP3, INFORM, USER, REQID, ENGINEID, CONTEXTNAME, SYSUPTIME, OID, VARBIND, INT, RESPONSE, COMPILE

// INSTRUCTION: Define the branch lab SNMPv3 agent sending unauthenticated informs.
HOST lab_v3_agent {
    IP 10.147.40.50
    MAC 00:1a:2b:93:40:50
}

// INSTRUCTION: Define the lab management trap/inform receiver.
HOST lab_nms {
    IP 10.147.40.1
    MAC 00:1a:2b:93:40:01
}

// INSTRUCTION: Send an SNMPv3 noAuthNoPriv INFORM in context lab_vrf and receive SNMPv3 RESPONSE confirmation.
FLOW snmpv3_noauth_inform(a, m) {
    a -> m SNMP3 INFORM USER "lab_notify" REQID 6500 ENGINEID "80001f88" CONTEXTNAME "lab_vrf" SYSUPTIME 480000 OID 1.3.6.1.6.3.1.1.5.4 VARBIND 1.3.6.1.2.1.2.2.1.1.5 INT 5
    a <- m SNMP3 RESPONSE USER "lab_notify" REQID 6500 ENGINEID "80001f88" CONTEXTNAME "lab_vrf" VARBIND 1.3.6.1.2.1.2.2.1.1.5 INT 5
}

// INSTRUCTION: Compile the SNMPv3 noAuthNoPriv INFORM flow.
COMPILE {
    snmpv3_noauth_inform(lab_v3_agent, lab_nms)
}
