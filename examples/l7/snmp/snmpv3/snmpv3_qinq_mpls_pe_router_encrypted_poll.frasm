// SNMPv3 authPriv GetBulk poll across QinQ (800/161) and MPLS label 7300
// targeting a service provider PE router.
// Encapsulation and QoS markings: 802.1ad QinQ outer 800 / inner 161, MPLS
// label 7300.
// SNMPv3 USM security uses auth sha256, priv aes with localized engineid
// keys.
// Uses SNMPv3 getbulk, response PDUs on UDP 161/162.
// In Wireshark, add the engineid, user, auth, and priv passphrases under SNMP
// Users Table to decrypt.
// Wireshark: (snmp && vlan) && mpls

host sp_nms {
    ip 172.27.147.10
}

host pe_router {
    ip 172.27.147.1
}

flow snmpv3_qinq_mpls_bulk(m, a) {
    m -> a snmp3 getbulk user "sp" reqid 6200 maxrepetitions 4 auth sha256 "SpSha256!" priv aes "SpAes128!" qinq 800 innervlan 161 mpls 7300 varbind 1.3.6.1.2.1.31.1.1.1.1 nullval
    m <- a snmp3 response user "sp" reqid 6200 auth sha256 "SpSha256!" priv aes "SpAes128!" qinq 800 innervlan 161 mpls 7300 varbind 1.3.6.1.2.1.31.1.1.1.1.1 string "TenGigE0/0/0/0"
}

compile {
    snmpv3_qinq_mpls_bulk(sp_nms, pe_router)
}
