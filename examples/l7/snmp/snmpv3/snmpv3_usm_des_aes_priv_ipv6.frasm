// SNMPv3 privacy encryption over IPv6 using DES-CBC and AES-128-CFB cipher
// suites with localized keys.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// SNMPv3 USM security uses auth sha, priv aes/des with localized engineid
// keys.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.1 (coldStart), 1.3.6.1.6.3.1.1.5.2
// (warmStart).
// In Wireshark, add the engineid, user, auth, and priv passphrases under SNMP
// Users Table to decrypt.
// Wireshark: snmp

host priv_agent { ip 2001:db8:443::1 }

host priv_nms { ip 2001:db8:443::2 }

flow snmp3_priv_flow(a, n) {
    a -> n snmp3 trap user "desuser" auth sha "authpass12345" priv des "privpass12345" oid 1.3.6.1.6.3.1.1.5.1
    a -> n snmp3 trap user "aesuser" auth sha "authpass12345" priv aes "privpass12345" oid 1.3.6.1.6.3.1.1.5.2
}

compile {
    snmp3_priv_flow(priv_agent, priv_nms)
}
