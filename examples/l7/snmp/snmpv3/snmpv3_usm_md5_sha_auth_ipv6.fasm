// PROMPT: SNMPv3 USM authentication over IPv6 using MD5 and HMAC-SHA-96 authentication protocols.
// TOKENS: host, ip, flow, snmp3, trap, user, auth, md5, oid, sha, compile

// INSTRUCTION: Define SNMPv3 IPv6 secure agent.
host usm_agent_v6 { ip 2001:db8:3::1 }

// INSTRUCTION: Define SNMPv3 IPv6 NMS collector.
host usm_nms_v6 { ip 2001:db8:3::2 }

// INSTRUCTION: Define MD5 and SHA USM authentication trap flow.
flow usm_auth_flow(a, n) {
    a -> n snmp3 trap user "md5user" auth md5 "md5password123" oid 1.3.6.1.6.3.1.1.5.1
    a -> n snmp3 trap user "shauser" auth sha "shatestpassword" oid 1.3.6.1.6.3.1.1.5.2
}

// INSTRUCTION: Compile block executing SNMPv3 MD5 and SHA authentication.
compile {
    usm_auth_flow(usm_agent_v6, usm_nms_v6)
}
