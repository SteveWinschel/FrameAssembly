// SNMPv3 USM authentication over IPv6 using MD5 and HMAC-SHA-96
// authentication protocols.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// SNMPv3 USM security uses auth md5/sha with localized engineid keys.
// MIB objects / traps: 1.3.6.1.6.3.1.1.5.1 (coldStart), 1.3.6.1.6.3.1.1.5.2
// (warmStart).
// Wireshark: snmp

host usm_agent_v6 { ip 2001:db8:3::1 }

host usm_nms_v6 { ip 2001:db8:3::2 }

flow usm_auth_flow(a, n) {
    a -> n snmp3 trap user "md5user" auth md5 "md5password123" oid 1.3.6.1.6.3.1.1.5.1
    a -> n snmp3 trap user "shauser" auth sha "shatestpassword" oid 1.3.6.1.6.3.1.1.5.2
}

compile {
    usm_auth_flow(usm_agent_v6, usm_nms_v6)
}
