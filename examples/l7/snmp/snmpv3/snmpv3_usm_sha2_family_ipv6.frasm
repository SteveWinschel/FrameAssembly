// PROMPT: RFC 7860 SHA-2 HMAC family authentication (SHA256, SHA384, SHA512) for SNMPv3 over IPv6.
// TOKENS: host, ip, flow, snmp3, trap, user, auth, sha256, oid, sha384, sha512, compile

// INSTRUCTION: Define high-security SNMPv3 agent.
host sha2_agent { ip 2001:db8:7860::1 }

// INSTRUCTION: Define high-security SNMPv3 NMS collector.
host sha2_nms { ip 2001:db8:7860::2 }

// INSTRUCTION: Define SHA-2 HMAC family authentication trap flow.
flow sha2_flow(a, n) {
    a -> n snmp3 trap user "user256" auth sha256 "sha256secretkey" oid 1.3.6.1.6.3.1.1.5.1
    a -> n snmp3 trap user "user384" auth sha384 "sha384secretkey" oid 1.3.6.1.6.3.1.1.5.2
    a -> n snmp3 trap user "user512" auth sha512 "sha512secretkey" oid 1.3.6.1.6.3.1.1.5.3
}

// INSTRUCTION: Compile block executing RFC 7860 SHA-2 family authentication.
compile {
    sha2_flow(sha2_agent, sha2_nms)
}
