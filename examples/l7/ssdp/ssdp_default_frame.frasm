// Minimal 2-block SSDP starter sending a default UPnP M-SEARCH on UDP port 1900.
// Targets the standard 239.255.255.250 multicast address and derives the RFC 1112 MAC.
// Compile to verify IoT VLAN isolation and multicast discovery filters.
// Wireshark: ssdp

host lan_scanner  { ip 192.168.1.99    mac 00:1a:2b:19:00:63 }
host ssdp_mcast   { ip 239.255.255.250 }

compile {
    lan_scanner -> ssdp_mcast ssdp
}
