// Gateway discovery query targeting UPnP InternetGatewayDevice services.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host resident_pc { ip 10.0.1.75 }

host mcast_group { ip 239.255.255.250 }

flow ssdp_igd_flow(c, s) {
    c -> s ssdp msearch
        st "urn:schemas-upnp-org:device:InternetGatewayDevice:1"
        mx 5 man "\"ssdp:discover\""
}

compile {
    ssdp_igd_flow(resident_pc, mcast_group)
}
