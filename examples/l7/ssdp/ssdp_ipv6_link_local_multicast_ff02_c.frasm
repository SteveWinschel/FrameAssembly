// Simulate an IPv6 link-local SSDP M-SEARCH and NOTIFY exchange using ff02::c
// for UPnP IPv6 device discovery.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: ssdp

host ctrl_point_v6 {
    mac 00:1c:b3:19:00:01
    ip fe80::21c:b3ff:fe19:1
}

host upnp_gw_v6 {
    mac 00:1c:b3:19:00:fe
    ip fe80::21c:b3ff:fe19:fe
}

host ssdp_mcast_v6 {
    mac 33:33:00:00:00:0c
    ip ff02::c
}

flow ssdp_ipv6_link_local_discovery(ctrl_point_v6, upnp_gw_v6, ssdp_mcast_v6) {
    ctrl_point_v6 -> ssdp_mcast_v6 ssdp msearch hosthdr "[ff02::c]:1900" man "\"ssdp:discover\"" mx 3 st "ssdp:all"
    upnp_gw_v6 -> ssdp_mcast_v6 ssdp notify hosthdr "[ff02::c]:1900" nt "upnp:rootdevice" nts "ssdp:alive" usn "uuid:igd-v6-0001::upnp:rootdevice"
        location "http://[fe80::21c:b3ff:fe19:fe]:49152/rootDesc.xml"
}

compile {
    ssdp_ipv6_link_local_discovery(ctrl_point_v6, upnp_gw_v6, ssdp_mcast_v6)
}
