// IPv6 site-local multicast discovery query to ff05::c address.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: ssdp

host terminal_v6 { ip 2001:db8:cafe::12 }

host ssdp_v6_site { ip ff05::c }

flow ssdp_v6_flow(c, s) {
    c -> s ssdp msearch
        st "upnp:rootdevice"
        mx 2 man "\"ssdp:discover\""
}

compile {
    ssdp_v6_flow(terminal_v6, ssdp_v6_site)
}
