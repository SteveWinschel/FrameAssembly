// SSDP M-SEARCH query discovering UPnP MediaRenderer devices.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host cp_client { ip 192.168.1.105 }

host ssdp_mcast { ip 239.255.255.250 }

flow ssdp_renderer_flow(c, s) {
    c -> s ssdp msearch
        st "urn:schemas-upnp-org:device:MediaRenderer:1"
        mx 3 man "\"ssdp:discover\""
}

compile {
    ssdp_renderer_flow(cp_client, ssdp_mcast)
}
