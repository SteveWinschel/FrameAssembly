// SSDP M-SEARCH broadcast locating DLNA MediaServer storage appliances.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host smart_tv { ip 192.168.2.40 }

host upnp_multicast { ip 239.255.255.250 }

flow ssdp_server_flow(c, s) {
    c -> s ssdp msearch
        st "urn:schemas-upnp-org:device:MediaServer:1"
        mx 2 man "\"ssdp:discover\""
}

compile {
    ssdp_server_flow(smart_tv, upnp_multicast)
}
