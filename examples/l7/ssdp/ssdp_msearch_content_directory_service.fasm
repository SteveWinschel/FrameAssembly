// PROMPT: Generate an SSDP M-SEARCH for a UPnP ContentDirectory:1 service and matching NOTIFY response.
// TOKENS: HOST, MAC, IP, FLOW, SSDP, MSEARCH, HOST_HDR, MAN, MX, ST, DSCP, NOTIFY, NT, NTS, USN, LOCATION, COMPILE

// INSTRUCTION: Define host endpoint media_player.
HOST media_player {
    MAC 00:1d:ba:10:20:01
    IP 172.16.10.21
}

// INSTRUCTION: Define host endpoint content_srv.
HOST content_srv {
    MAC 00:1d:ba:10:20:99
    IP 172.16.10.99
}

// INSTRUCTION: Define host endpoint ssdp_addr.
HOST ssdp_addr {
    MAC 01:00:5e:7f:ff:fa
    IP 239.255.255.250
}

// INSTRUCTION: Discover ContentDirectory:1 service with DSCP 16 and receive the service advertisement.
FLOW ssdp_content_directory_search(media_player, content_srv, ssdp_addr) {
    media_player -> ssdp_addr SSDP MSEARCH HOST_HDR "239.255.255.250:1900" MAN "\"ssdp:discover\"" MX 2 ST "urn:schemas-upnp-org:service:ContentDirectory:1" DSCP 16
    content_srv -> media_player SSDP NOTIFY HOST_HDR "239.255.255.250:1900" NT "urn:schemas-upnp-org:service:ContentDirectory:1" NTS "ssdp:alive"
        USN "uuid:plex-dlna-99::urn:schemas-upnp-org:service:ContentDirectory:1"
        LOCATION "http://172.16.10.99:32469/DeviceDescription.xml" DSCP 16
}

// INSTRUCTION: Compile the SSDP ContentDirectory service discovery flow.
COMPILE {
    ssdp_content_directory_search(media_player, content_srv, ssdp_addr)
}
