// Generate an SSDP M-SEARCH for a UPnP ContentDirectory:1 service and
// matching NOTIFY response.
// Encapsulation and QoS markings: DSCP 16.
// Wireshark: ssdp

host media_player {
    mac 00:1d:ba:10:20:01
    ip 172.16.10.21
}

host content_srv {
    mac 00:1d:ba:10:20:99
    ip 172.16.10.99
}

host ssdp_addr {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

flow ssdp_content_directory_search(media_player, content_srv, ssdp_addr) {
    media_player -> ssdp_addr ssdp msearch hosthdr "239.255.255.250:1900" man "\"ssdp:discover\"" mx 2 st "urn:schemas-upnp-org:service:ContentDirectory:1" dscp 16
    content_srv -> media_player ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:service:ContentDirectory:1" nts "ssdp:alive"
        usn "uuid:plex-dlna-99::urn:schemas-upnp-org:service:ContentDirectory:1"
        location "http://172.16.10.99:32469/DeviceDescription.xml" dscp 16
}

compile {
    ssdp_content_directory_search(media_player, content_srv, ssdp_addr)
}
