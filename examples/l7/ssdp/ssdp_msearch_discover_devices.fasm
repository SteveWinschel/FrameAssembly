// PROMPT: SSDP M-SEARCH multicast discovery searching for root devices.
// TOKENS: host, ip, flow, s, ssdp, msearch, st, mx, man, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
host server { ip 239.255.255.250 }

// INSTRUCTION: Define application traffic flow.
flow ssdp_msearch(c, s) {
    c -> s ssdp msearch st "upnp:rootdevice" mx 2 man "\"ssdp:discover\""
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    ssdp_msearch(client, server)
}
