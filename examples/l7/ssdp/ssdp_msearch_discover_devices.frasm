// SSDP M-SEARCH multicast discovery searching for root devices.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host client { ip 192.168.1.100 }

host server { ip 239.255.255.250 }

flow ssdp_msearch(c, s) {
    c -> s ssdp msearch st "upnp:rootdevice" mx 2 man "\"ssdp:discover\""
}

compile {
    ssdp_msearch(client, server)
}
