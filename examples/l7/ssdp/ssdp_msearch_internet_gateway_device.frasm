// Model an SSDP M-SEARCH query specifically targeting UPnP
// InternetGatewayDevice:1 routers on the LAN.
// Wireshark: ssdp

host console_client {
    mac 00:24:8d:11:22:33
    ip 192.168.1.120
}

host upnp_multicast {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

flow ssdp_igd_gateway_search(console_client, upnp_multicast) {
    console_client -> upnp_multicast ssdp msearch hosthdr "239.255.255.250:1900" man "\"ssdp:discover\"" mx 2 st "urn:schemas-upnp-org:device:InternetGatewayDevice:1" ttl 2
}

compile {
    ssdp_igd_gateway_search(console_client, upnp_multicast)
}
