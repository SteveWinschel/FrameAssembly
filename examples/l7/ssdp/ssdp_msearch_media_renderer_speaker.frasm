// Generate an SSDP M-SEARCH for a UPnP MediaRenderer:1 smart speaker and its
// ssdp:alive descriptor advertisement.
// Wireshark: ssdp

host mobile_app {
    mac 00:26:bb:01:02:03
    ip 10.0.10.25
}

host speaker_renderer {
    mac 00:0e:58:aa:bb:cc
    ip 10.0.10.80
}

host mcast_ssdp {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

flow ssdp_media_renderer_probe(mobile_app, speaker_renderer, mcast_ssdp) {
    mobile_app -> mcast_ssdp ssdp msearch hosthdr "239.255.255.250:1900" man "\"ssdp:discover\"" mx 1 st "urn:schemas-upnp-org:device:MediaRenderer:1"
    speaker_renderer -> mobile_app ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:device:MediaRenderer:1" nts "ssdp:alive"
        usn "uuid:RINCON_000E58AABBCC01400::urn:schemas-upnp-org:device:MediaRenderer:1"
        location "http://10.0.10.80:1400/xml/device_description.xml"
}

compile {
    ssdp_media_renderer_probe(mobile_app, speaker_renderer, mcast_ssdp)
}
