// PROMPT: Simulate an SSDP M-SEARCH query looking specifically for WANIPConnection:1 service on a residential gateway.
// TOKENS: host, mac, ip, flow, ssdp, msearch, hosthdr, man, mx, st, notify, nt, nts, usn, location, compile

// INSTRUCTION: Define host endpoint p2p_host.
host p2p_host {
    mac 00:1a:92:33:44:55
    ip 192.168.0.101
}

// INSTRUCTION: Define host endpoint home_router.
host home_router {
    mac 00:1a:92:00:00:01
    ip 192.168.0.1
}

// INSTRUCTION: Define host endpoint ssdp_dest.
host ssdp_dest {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

// INSTRUCTION: Search for WANIPConnection:1 service and receive the router's service description URL.
flow ssdp_wan_ip_connection_search(p2p_host, home_router, ssdp_dest) {
    p2p_host -> ssdp_dest ssdp msearch hosthdr "239.255.255.250:1900" man "\"ssdp:discover\"" mx 2 st "urn:schemas-upnp-org:service:WANIPConnection:1"
    home_router -> p2p_host ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:service:WANIPConnection:1" nts "ssdp:alive"
        usn "uuid:router-wan-01::urn:schemas-upnp-org:service:WANIPConnection:1"
        location "http://192.168.0.1:5000/wanipconn.xml"
}

// INSTRUCTION: Compile the SSDP WANIPConnection service discovery flow.
compile {
    ssdp_wan_ip_connection_search(p2p_host, home_router, ssdp_dest)
}
