// Simulate a full UPnP device boot announcement Triad (rootdevice,
// device-UUID, and deviceType) via SSDP NOTIFY.
// Wireshark: ssdp

host storage_box {
    mac 00:08:9b:aa:bb:cc
    ip 192.168.5.200
}

host ssdp_all_mcast {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

flow ssdp_boot_announcement_triad(storage_box, ssdp_all_mcast) {
    storage_box -> ssdp_all_mcast ssdp notify hosthdr "239.255.255.250:1900" nt "upnp:rootdevice" nts "ssdp:alive" usn "uuid:qnap-nas-00089baabbcc::upnp:rootdevice"
        location "http://192.168.5.200:8080/upnp.xml" ttl 4
    storage_box -> ssdp_all_mcast ssdp notify hosthdr "239.255.255.250:1900" nt "uuid:qnap-nas-00089baabbcc" nts "ssdp:alive" usn "uuid:qnap-nas-00089baabbcc"
        location "http://192.168.5.200:8080/upnp.xml" ttl 4
    storage_box -> ssdp_all_mcast ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:device:Basic:1" nts "ssdp:alive"
        usn "uuid:qnap-nas-00089baabbcc::urn:schemas-upnp-org:device:Basic:1"
        location "http://192.168.5.200:8080/upnp.xml" ttl 4
}

compile {
    ssdp_boot_announcement_triad(storage_box, ssdp_all_mcast)
}
