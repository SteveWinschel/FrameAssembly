// PROMPT: Simulate a UPnP SSDP NOTIFY ssdp:byebye multicast advertisement announcing device shutdown.
// TOKENS: host, mac, ip, flow, ssdp, notify, hosthdr, nt, nts, usn, ttl, compile

// INSTRUCTION: Define host endpoint dlna_server.
host dlna_server {
    mac 00:11:32:aa:bb:01
    ip 192.168.1.50
}

// INSTRUCTION: Define host endpoint ssdp_mcast.
host ssdp_mcast {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

// INSTRUCTION: Broadcast two SSDP NOTIFY ssdp:byebye messages for the rootdevice and media server UUID.
flow ssdp_byebye_shutdown(dlna_server, ssdp_mcast) {
    dlna_server -> ssdp_mcast ssdp notify hosthdr "239.255.255.250:1900" nt "upnp:rootdevice" nts "ssdp:byebye" usn "uuid:2f402f80-da50-11e1-9b23-001132aabb01::upnp:rootdevice" ttl 4
    dlna_server -> ssdp_mcast ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:device:MediaServer:1" nts "ssdp:byebye"
        usn "uuid:2f402f80-da50-11e1-9b23-001132aabb01::urn:schemas-upnp-org:device:MediaServer:1" ttl 4
}

// INSTRUCTION: Compile the SSDP ssdp:byebye graceful departure flow.
compile {
    ssdp_byebye_shutdown(dlna_server, ssdp_mcast)
}
