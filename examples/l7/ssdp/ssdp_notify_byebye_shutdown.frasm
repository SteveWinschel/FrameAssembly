// Device graceful shutdown notification using NTS ssdp:byebye.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host printer_node { ip 192.168.1.50 }

host ssdp_broadcast { ip 239.255.255.250 }

flow ssdp_byebye_flow(c, s) {
    c -> s ssdp notify
        nt "urn:schemas-upnp-org:device:Printer:1"
        nts "ssdp:byebye"
        usn "uuid:print-lab-uuid::urn:schemas-upnp-org:device:Printer:1"
}

compile {
    ssdp_byebye_flow(printer_node, ssdp_broadcast)
}
