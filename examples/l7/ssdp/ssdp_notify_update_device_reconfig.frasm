// PROMPT: Model a UPnP Architecture 1.1 ssdp:update NOTIFY multicast announcement when a device transitions to a new IP or configuration.
// TOKENS: host, mac, ip, flow, ssdp, notify, hosthdr, nt, nts, usn, location, ttl, compile

// INSTRUCTION: Define host endpoint ip_camera.
host ip_camera {
    mac 00:40:8c:aa:11:22
    ip 192.168.20.45
}

// INSTRUCTION: Define host endpoint ssdp_multicast_grp.
host ssdp_multicast_grp {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

// INSTRUCTION: Multicast an SSDP NOTIFY with NTS ssdp:update advertising the updated descriptor URL.
flow ssdp_notify_config_update(ip_camera, ssdp_multicast_grp) {
    ip_camera -> ssdp_multicast_grp ssdp notify hosthdr "239.255.255.250:1900" nt "upnp:rootdevice" nts "ssdp:update" usn "uuid:axis-cam-00408caa1122::upnp:rootdevice"
        location "http://192.168.20.45:80/upnp/rootdesc.xml" ttl 4
}

// INSTRUCTION: Compile the SSDP ssdp:update notification flow.
compile {
    ssdp_notify_config_update(ip_camera, ssdp_multicast_grp)
}
