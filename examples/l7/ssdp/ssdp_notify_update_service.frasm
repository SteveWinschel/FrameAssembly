// Device service configuration update notification using NTS ssdp:update.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (SSDP /
// UPnP, UDP 1900).
// Wireshark: ssdp

host gateway_dev { ip 10.200.1.1 }

host mcast_endpoint { ip 239.255.255.250 }

flow ssdp_update_flow(c, s) {
    c -> s ssdp notify
        nt "upnp:rootdevice"
        nts "ssdp:update"
        usn "uuid:media-gw-9900::upnp:rootdevice"
        location "http://10.200.1.1:8080/desc.xml"
}

compile {
    ssdp_update_flow(gateway_dev, mcast_endpoint)
}
