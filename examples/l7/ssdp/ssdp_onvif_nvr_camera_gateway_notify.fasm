// PROMPT: Model a security surveillance gateway broadcasting SSDP ssdp:alive and ssdp:update notifications on CCTV VLAN 70.
// TOKENS: host, ip, mac, flow, ssdp, notify, hosthdr, nt, nts, usn, location, vlan, pcp, ttl, wait, ms, compile

// INSTRUCTION: Define the ONVIF/UPnP network video recorder appliance on VLAN 70.
host nvr_appliance {
    ip 10.70.0.10
    mac 00:40:8c:46:00:0a
}

// INSTRUCTION: Define the CCTV VLAN 70 SSDP multicast group.
host cctv_ssdp_mcast {
    ip 239.255.255.250
    mac 01:00:5e:7f:ff:fa
}

// INSTRUCTION: Broadcast initial ssdp:alive and subsequent ssdp:update announcements on VLAN 70.
flow ssdp_nvr_cctv_announce(nvr, mcast) {
    nvr -> mcast ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:device:DigitalSecurityCamera:1"
        nts "ssdp:alive" usn "uuid:nvr-cam-bay01::urn:schemas-upnp-org:device:DigitalSecurityCamera:1"
        location "http://10.70.0.10:8080/upnp/camera01.xml" vlan 70 pcp 2 ttl 2 wait 25ms
    nvr -> mcast ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:device:DigitalSecurityCamera:1"
        nts "ssdp:update" usn "uuid:nvr-cam-bay01::urn:schemas-upnp-org:device:DigitalSecurityCamera:1"
        location "http://10.70.0.10:8080/upnp/camera01.xml" vlan 70 pcp 2 ttl 2
}

// INSTRUCTION: Compile the CCTV VLAN 70 SSDP camera advertisement flow.
compile {
    ssdp_nvr_cctv_announce(nvr_appliance, cctv_ssdp_mcast)
}
