// PROMPT: Simulate a periodic SSDP NOTIFY ssdp:alive heartbeat loop from an IoT smart hub using LOOP.
// TOKENS: host, mac, ip, flow, ssdp, notify, hosthdr, nt, nts, usn, location, ttl, wait, ms, compile

// INSTRUCTION: Define host endpoint smart_bridge.
host smart_bridge {
    mac 00:17:88:22:33:44
    ip 192.168.1.25
}

// INSTRUCTION: Define host endpoint ssdp_bcast.
host ssdp_bcast {
    mac 01:00:5e:7f:ff:fa
    ip 239.255.255.250
}

// INSTRUCTION: Broadcast 3 periodic SSDP NOTIFY ssdp:alive announcements with 50ms spacing.
flow ssdp_periodic_alive_beacon(smart_bridge, ssdp_bcast) {
    smart_bridge -> ssdp_bcast ssdp notify hosthdr "239.255.255.250:1900" nt "upnp:rootdevice" nts "ssdp:alive" usn "uuid:2f402f80-da50-11e1-9b23-001788223344::upnp:rootdevice"
        location "http://192.168.1.25:80/description.xml" ttl 4 wait 50ms
}

// INSTRUCTION: Compile the periodic SSDP alive heartbeat flow.
compile {
    ssdp_periodic_alive_beacon(smart_bridge, ssdp_bcast) // cycle 1
    ssdp_periodic_alive_beacon(smart_bridge, ssdp_bcast) // cycle 2
    ssdp_periodic_alive_beacon(smart_bridge, ssdp_bcast) // cycle 3
}
