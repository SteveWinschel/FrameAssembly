// Periodic SSDP alive announcement broadcast across repeated flow calls.
// Executes 3 sequential flow runs inside the compile block.
// Wireshark: ssdp

host media_beacon { ip 192.168.1.200 }

host beacon_group { ip 239.255.255.250 }

flow ssdp_beacon_flow(c, s) {
    c -> s ssdp notify
        nt "upnp:rootdevice"
        nts "ssdp:alive"
        usn "uuid:beacon-service-01::upnp:rootdevice"
}

compile {
    ssdp_beacon_flow(media_beacon, beacon_group) // cycle 1
    ssdp_beacon_flow(media_beacon, beacon_group) // cycle 2
    ssdp_beacon_flow(media_beacon, beacon_group) // cycle 3
}
