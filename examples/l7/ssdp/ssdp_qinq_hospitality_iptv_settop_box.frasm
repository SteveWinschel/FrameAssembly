// Generate an SSDP discovery exchange for a hospitality IPTV set-top box
// encapsulated in QinQ outer VLAN 900 inner VLAN 45.
// Encapsulation and QoS markings: 802.1ad QinQ outer 900 / inner 45.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: ssdp && vlan

host room_iptv_stb {
    ip 10.45.12.101
    mac 00:1a:79:2d:0c:65
}

host hotel_vod_srv {
    ip 10.45.12.1
    mac 00:1a:79:2d:0c:01
}

flow ssdp_qinq_iptv_discovery(stb, vod) {
    stb -> vod ssdp msearch hosthdr "239.255.255.250:1900" man "ssdp:discover" mx 1
        st "urn:schemas-upnp-org:service:ContentDirectory:1" qinq 900 innervlan 45 wait 5ms
    stb <- vod ssdp notify hosthdr "239.255.255.250:1900" nt "urn:schemas-upnp-org:service:ContentDirectory:1"
        nts "ssdp:alive" usn "uuid:hotel-vod-core::urn:schemas-upnp-org:service:ContentDirectory:1"
        location "http://10.45.12.1:9000/cds/desc.xml" qinq 900 innervlan 45
}

compile {
    ssdp_qinq_iptv_discovery(room_iptv_stb, hotel_vod_srv)
}
