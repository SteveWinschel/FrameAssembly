// VLAN 100 tagged SSDP discovery frame with PCP priority tagging.
// Encapsulation and QoS markings: 802.1Q VLAN 100, 802.1p priority 4.
// Wireshark: ssdp && vlan.id == 100

host vlan_host { ip 10.100.1.14 }

host vlan_mcast { ip 239.255.255.250 }

flow ssdp_vlan_flow(c, s) {
    c -> s ssdp msearch
        st "urn:schemas-upnp-org:device:MediaServer:1"
        mx 3 man "\"ssdp:discover\""
        vlan 100 pcp 4 dei 0
}

compile {
    ssdp_vlan_flow(vlan_host, vlan_mcast)
}
