// Automated configuration backup probe loop across network routers.
// SSH RFC 4253 framing on TCP 22.
// Executes 3 sequential flow runs inside the compile block.
// Wireshark: ssh

host audit_ctrl { ip 172.22.1.100 }

host target_rtr { ip 172.22.1.1 }

flow ssh_audit_flow(c, s) {
    c -> s ssh banner "SSH-2.0-Ansible_Automation"
    c <- s ssh banner "SSH-2.0-Cisco-1.25"
    c -> s ssh newkeys
    c <- s ssh newkeys
}

compile {
    ssh_audit_flow(audit_ctrl, target_rtr) // cycle 1
    ssh_audit_flow(audit_ctrl, target_rtr) // cycle 2
    ssh_audit_flow(audit_ctrl, target_rtr) // cycle 3
}
