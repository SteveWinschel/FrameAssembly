// Encrypted pseudo-terminal session data frame with msgcode 94.
// SSH RFC 4253 framing on TCP 22 (message codes: 94 (CHANNEL_DATA)).
// Wireshark: ssh

host shell_client { ip 192.168.33.22 }

host target_bastion { ip 192.168.33.1 }

flow ssh_data_flow(c, s) {
    c -> s ssh msgcode 94
    c <- s ssh msgcode 94
}

compile {
    ssh_data_flow(shell_client, target_bastion)
}
