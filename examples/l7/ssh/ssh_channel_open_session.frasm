// Client requesting interactive shell channel allocation with msgcode 90.
// SSH RFC 4253 framing on TCP 22 (message codes: 90 (CHANNEL_OPEN), 91
// (CHANNEL_OPEN_CONFIRMATION)).
// Wireshark: ssh

host term_client { ip 172.28.0.8 }

host app_server { ip 172.28.0.2 }

flow ssh_channel_open_flow(c, s) {
    c -> s ssh msgcode 90
    c <- s ssh msgcode 91
}

compile {
    ssh_channel_open_flow(term_client, app_server)
}
