// Flow control window buffer adjustment packet with msgcode 93.
// SSH RFC 4253 framing on TCP 22 (message codes: 93).
// Wireshark: ssh

host receiver_host { ip 10.120.3.5 }

host transfer_server { ip 10.120.3.1 }

flow ssh_window_adjust_flow(c, s) {
    c -> s ssh msgcode 93
    c <- s ssh msgcode 93
}

compile {
    ssh_window_adjust_flow(receiver_host, transfer_server)
}
