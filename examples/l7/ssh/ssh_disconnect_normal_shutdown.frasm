// Clean session termination packet transmitting msgcode 1 disconnect.
// SSH RFC 4253 framing on TCP 22 (message codes: 1 (DISCONNECT)).
// Wireshark: ssh

host departing_client { ip 10.250.0.10 }

host corp_bastion { ip 10.250.0.1 }

flow ssh_disconnect_flow(c, s) {
    c -> s ssh msgcode 1
    c <- s ssh msgcode 1
}

compile {
    ssh_disconnect_flow(departing_client, corp_bastion)
}
