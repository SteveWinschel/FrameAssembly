// PROMPT: Simulate a complete SSH-2.0 handshake progressing through Banner, KEXINIT, DH Key Exchange (30/31), and NEWKEYS.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, ssh, banner, kexinit, payload, msgcode, newkeys, compile

// INSTRUCTION: Define host endpoint ssh_client.
host ssh_client {
    mac 00:50:56:a1:22:01
    ip 10.10.22.50
}

// INSTRUCTION: Define host endpoint ssh_bastion.
host ssh_bastion {
    mac 00:50:56:a1:22:02
    ip 10.10.22.1
}

// INSTRUCTION: Complete TCP port 22 handshake, exchange banners, KEXINIT, ECDH INIT/REPLY (30/31), and NEWKEYS.
flow ssh_full_key_exchange_flow(ssh_client, ssh_bastion) {
    ssh_client -> ssh_bastion tcp syn srcport 51022 dstport 22
    ssh_bastion -> ssh_client tcp syn ack
    ssh_client -> ssh_bastion tcp ack
    ssh_client -> ssh_bastion ssh banner "SSH-2.0-OpenSSH_9.6"
    ssh_bastion -> ssh_client ssh banner "SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13"
    ssh_client -> ssh_bastion ssh kexinit payload "11223344556677889900aabbccddeeff"
    ssh_bastion -> ssh_client ssh kexinit payload "ffeeddccbbaa00998877665544332211"
    ssh_client -> ssh_bastion ssh msgcode 30
    ssh_bastion -> ssh_client ssh msgcode 31
    ssh_client -> ssh_bastion ssh newkeys
    ssh_bastion -> ssh_client ssh newkeys
}

// INSTRUCTION: Compile the full SSH key exchange flow.
compile {
    ssh_full_key_exchange_flow(ssh_client, ssh_bastion)
}
