// PROMPT: Simulate an SSH traffic analysis defense sequence combining SSH_MSG_IGNORE (2) and SSH_MSG_DEBUG (4) with channel data.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, ssh, msgcode, payload, compile

// INSTRUCTION: Define host endpoint sec_client.
host sec_client {
    mac 00:1e:67:22:33:01
    ip 192.168.44.11
}

// INSTRUCTION: Define host endpoint sec_server.
host sec_server {
    mac 00:1e:67:22:33:02
    ip 192.168.44.22
}

// INSTRUCTION: Send SSH_MSG_DEBUG (4), SSH_MSG_IGNORE (2) chaff packet, and SSH_MSG_CHANNEL_DATA (94).
flow ssh_ignore_and_debug_messages(sec_client, sec_server) {
    sec_client -> sec_server tcp syn srcport 59022 dstport 22
    sec_server -> sec_client tcp syn ack
    sec_client -> sec_server tcp ack
    sec_client -> sec_server ssh msgcode 4 payload "debug1: keystroke timing obfuscation enabled"
    sec_client -> sec_server ssh msgcode 2 payload "CHAFF-PADDING-00000000"
    sec_client -> sec_server ssh msgcode 94 payload "ENC-KEYSTROKE-PACKET"
    sec_server -> sec_client ssh msgcode 2 payload "CHAFF-PADDING-11111111"
    sec_server -> sec_client ssh msgcode 94 payload "ENC-ECHO-RESPONSE"
}

// INSTRUCTION: Compile the SSH ignore and debug packet flow.
compile {
    ssh_ignore_and_debug_messages(sec_client, sec_server)
}
