// IPv6 remote console administration session with version banner and KEXINIT.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// SSH RFC 4253 framing on TCP 22.
// Wireshark: ssh

host admin_v6 { ip 2001:db8:8888::15 }

host fw_v6 { ip 2001:db8:8888::1 }

flow ssh_v6_session(c, s) {
    c -> s ssh banner "SSH-2.0-OpenSSH_9.3"
    c <- s ssh banner "SSH-2.0-OpenSSH_9.3"
    c -> s ssh kexinit
    c <- s ssh kexinit
}

compile {
    ssh_v6_session(admin_v6, fw_v6)
}
