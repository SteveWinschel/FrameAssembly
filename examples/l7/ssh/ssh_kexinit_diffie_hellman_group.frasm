// Diffie-Hellman key exchange initialization with cryptographic cookie.
// SSH RFC 4253 framing on TCP 22.
// Wireshark: ssh

host client_node { ip 10.15.0.4 }

host sec_gw { ip 10.15.0.1 }

flow ssh_kex_flow(c, s) {
    c -> s ssh kexinit payload "0123456789abcdef"
    c <- s ssh kexinit payload "fedcba9876543210"
}

compile {
    ssh_kex_flow(client_node, sec_gw)
}
