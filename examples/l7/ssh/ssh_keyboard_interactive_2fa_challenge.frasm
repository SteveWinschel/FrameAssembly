// Model an SSH keyboard-interactive 2FA challenge-response using msgcode 50,
// INFO_REQUEST (60), INFO_RESPONSE (61), and SUCCESS (52).
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// SSH RFC 4253 framing on TCP 22 (message codes: 50 (USERAUTH_REQUEST), 52
// (USERAUTH_SUCCESS), 60, 61).
// Overrides destination port to 22.
// Wireshark: ssh

host admin_client {
    mac 00:1a:a0:60:61:01
    ip 10.60.22.10
}

host pam_bastion {
    mac 00:1a:a0:60:61:02
    ip 10.60.22.1
}

flow ssh_keyboard_interactive_totp(admin_client, pam_bastion) {
    admin_client -> pam_bastion tcp syn srcport 62022 dstport 22
    pam_bastion -> admin_client tcp syn ack
    admin_client -> pam_bastion tcp ack
    admin_client -> pam_bastion ssh msgcode 50 payload "ops:ssh-connection:keyboard-interactive"
    pam_bastion -> admin_client ssh msgcode 60 payload "Verification code: "
    admin_client -> pam_bastion ssh msgcode 61 payload "482910"
    pam_bastion -> admin_client ssh msgcode 52
}

compile {
    ssh_keyboard_interactive_totp(admin_client, pam_bastion)
}
