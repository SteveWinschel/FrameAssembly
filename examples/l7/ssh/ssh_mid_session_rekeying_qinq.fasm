// PROMPT: Simulate an in-flight SSH session key re-exchange (rekeying) triggered after transferring bulk channel data over QinQ.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, qinq, innervlan, ack, ssh, msgcode, payload, kexinit, newkeys, compile

// INSTRUCTION: Define host endpoint repl_client.
host repl_client {
    mac 00:26:b9:22:01:01
    ip 10.77.22.1
}

// INSTRUCTION: Define host endpoint repl_target.
host repl_target {
    mac 00:26:b9:22:01:02
    ip 10.77.22.2
}

// INSTRUCTION: Exchange channel data (94), initiate mid-session KEXINIT rekeying, exchange DH 30/31 and NEWKEYS, and resume data.
flow ssh_mid_session_rekeying_qinq(repl_client, repl_target) {
    repl_client -> repl_target tcp syn srcport 63022 dstport 22 qinq 400 innervlan 22
    repl_target -> repl_client tcp syn ack qinq 400 innervlan 22
    repl_client -> repl_target tcp ack qinq 400 innervlan 22
    repl_client -> repl_target ssh msgcode 94 payload "BULK-STREAM-PRE-REKEY" qinq 400 innervlan 22
    repl_client -> repl_target ssh kexinit payload "99887766554433221100ffeeddccbbaa" qinq 400 innervlan 22
    repl_target -> repl_client ssh kexinit payload "aabbccddeeff00112233445566778899" qinq 400 innervlan 22
    repl_client -> repl_target ssh msgcode 30 qinq 400 innervlan 22
    repl_target -> repl_client ssh msgcode 31 qinq 400 innervlan 22
    repl_client -> repl_target ssh newkeys qinq 400 innervlan 22
    repl_target -> repl_client ssh newkeys qinq 400 innervlan 22
    repl_client -> repl_target ssh msgcode 94 payload "BULK-STREAM-POST-REKEY" qinq 400 innervlan 22
}

// INSTRUCTION: Compile the SSH mid-session rekeying flow over QinQ.
compile {
    ssh_mid_session_rekeying_qinq(repl_client, repl_target)
}
