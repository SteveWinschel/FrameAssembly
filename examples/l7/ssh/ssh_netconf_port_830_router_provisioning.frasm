// PROMPT: Model an RFC 6242 NETCONF over SSH session on TCP port 830 between an SDN orchestrator and a core router.
// TOKENS: host, ip, mac, flow, ssh, srcport, dstport, banner, dscp, wait, ms, msgcode, payload, compile

// INSTRUCTION: Define the SDN network orchestrator initiating NETCONF over SSH.
host sdn_orchestrator {
    ip 172.18.83.10
    mac 00:1b:21:53:00:0a
}

// INSTRUCTION: Define the core router listening on NETCONF over SSH port 830.
host netconf_router {
    ip 172.18.83.1
    mac 00:1b:21:53:00:01
}

// INSTRUCTION: Negotiate SSH banners and invoke the netconf subsystem on DSTPORT 830.
flow ssh_netconf_830_session(sdn, rtr) {
    sdn -> rtr ssh srcport 54830 dstport 830 banner "SSH-2.0-libssh_0.10.6_NETCONF" dscp 16 wait 3ms
    sdn <- rtr ssh srcport 830 dstport 54830 banner "SSH-2.0-Cisco-2.0" dscp 16 wait 3ms
    sdn -> rtr ssh srcport 54830 dstport 830 msgcode 98 payload "subsystem:netconf" dscp 16 wait 4ms
    sdn <- rtr ssh srcport 830 dstport 54830 msgcode 99 payload "netconf-hello-capabilities-1.1" dscp 16
}

// INSTRUCTION: Compile the RFC 6242 NETCONF over SSH port 830 session flow.
compile {
    ssh_netconf_830_session(sdn_orchestrator, netconf_router)
}
