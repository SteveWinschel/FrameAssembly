// SSH key exchange completion switching to negotiated symmetric encryption
// keys.
// SSH RFC 4253 framing on TCP 22.
// Wireshark: ssh

host client { ip 10.0.0.2 }

host server { ip 10.0.0.1 }

flow ssh_keys(c, s) {
    c -> s ssh newkeys
    c <- s ssh newkeys
}

compile {
    ssh_keys(client, server)
}
