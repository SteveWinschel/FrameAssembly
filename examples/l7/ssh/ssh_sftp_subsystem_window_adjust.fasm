// PROMPT: Simulate an SFTP subsystem invocation over an SSH session channel with window adjust (MSG_CODE 93) over MPLS 2200.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, mpls, ack, ssh, msgcode, payload, compile

// INSTRUCTION: Define host endpoint sftp_client.
host sftp_client {
    mac 00:21:5a:22:00:01
    ip 10.150.22.5
}

// INSTRUCTION: Define host endpoint sftp_server.
host sftp_server {
    mac 00:21:5a:22:00:02
    ip 10.150.22.50
}

// INSTRUCTION: Open channel (90/91), request subsystem sftp (98/99), transfer data (94), and adjust window (93).
flow ssh_sftp_subsystem_window_adjust(sftp_client, sftp_server) {
    sftp_client -> sftp_server tcp syn srcport 61022 dstport 22 mpls 2200
    sftp_server -> sftp_client tcp syn ack mpls 2200
    sftp_client -> sftp_server tcp ack mpls 2200
    sftp_client -> sftp_server ssh msgcode 90 payload "session" mpls 2200
    sftp_server -> sftp_client ssh msgcode 91 payload "channel-0" mpls 2200
    sftp_client -> sftp_server ssh msgcode 98 payload "subsystem:sftp" mpls 2200
    sftp_server -> sftp_client ssh msgcode 99 mpls 2200
    sftp_client -> sftp_server ssh msgcode 94 payload "SFTP-FXP-INIT-V3" mpls 2200
    sftp_server -> sftp_client ssh msgcode 94 payload "SFTP-FXP-VERSION-V3" mpls 2200
    sftp_client -> sftp_server ssh msgcode 93 payload "WINDOW-ADJUST-2097152" mpls 2200
}

// INSTRUCTION: Compile the SSH SFTP subsystem and window adjust flow.
compile {
    ssh_sftp_subsystem_window_adjust(sftp_client, sftp_server)
}
