// Generate an SSH remote port forwarding request using SSH_MSG_GLOBAL_REQUEST
// (80) tcpip-forward and confirmation (81).
// SSH RFC 4253 framing on TCP 22 (message codes: 80 (GLOBAL_REQUEST), 81
// (REQUEST_SUCCESS), 90 (CHANNEL_OPEN), 91 (CHANNEL_OPEN_CONFIRMATION)).
// Timing: uses post-packet wait delays (5ms, 10ms, 2ms) between frames.
// Wireshark: ssh

host dev_workstation {
    ip 192.168.77.25
    mac 00:24:e8:4d:00:19
}

host cloud_relay_sshd {
    ip 192.168.77.1
    mac 00:24:e8:4d:00:01
}

flow ssh_remote_port_forward(dev, relay) {
    dev -> relay ssh msgcode 80 payload "tcpip-forward:0.0.0.0:8443" wait 5ms
    dev <- relay ssh msgcode 81 payload "bound-port-8443" wait 10ms
    dev <- relay ssh msgcode 90 payload "forwarded-tcpip:0.0.0.0:8443" wait 2ms
    dev -> relay ssh msgcode 91 payload "channel-1-open-confirmed"
}

compile {
    ssh_remote_port_forward(dev_workstation, cloud_relay_sshd)
}
