// User authentication request message with msgcode 50.
// SSH RFC 4253 framing on TCP 22 (message codes: 50 (USERAUTH_REQUEST), 51
// (USERAUTH_FAILURE)).
// Wireshark: ssh

host dev_laptop { ip 192.168.4.15 }

host build_node { ip 192.168.4.1 }

flow ssh_userauth_req(c, s) {
    c -> s ssh msgcode 50
    c <- s ssh msgcode 51
}

compile {
    ssh_userauth_req(dev_laptop, build_node)
}
