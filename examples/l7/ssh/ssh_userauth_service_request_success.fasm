// PROMPT: Model an SSH-2.0 service request (MSG_CODE 5/6) and user authentication request/success (MSG_CODE 50/52).
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, dscp, ack, ssh, msgcode, payload, compile

// INSTRUCTION: Define host endpoint dev_laptop.
host dev_laptop {
    mac 00:1c:42:22:10:01
    ip 192.168.22.10
}

// INSTRUCTION: Define host endpoint prod_sshd.
host prod_sshd {
    mac 00:1c:42:22:10:99
    ip 192.168.22.99
}

// INSTRUCTION: Exchange SSH_MSG_SERVICE_REQUEST (5), SERVICE_ACCEPT (6), USERAUTH_REQUEST (50), and USERAUTH_SUCCESS (52).
flow ssh_userauth_publickey_flow(dev_laptop, prod_sshd) {
    dev_laptop -> prod_sshd tcp syn srcport 52022 dstport 22 dscp 16
    prod_sshd -> dev_laptop tcp syn ack dscp 16
    dev_laptop -> prod_sshd tcp ack dscp 16
    dev_laptop -> prod_sshd ssh msgcode 5 payload "ssh-userauth" dscp 16
    prod_sshd -> dev_laptop ssh msgcode 6 payload "ssh-userauth" dscp 16
    dev_laptop -> prod_sshd ssh msgcode 50 payload "deploy:ssh-connection:publickey:ssh-ed25519" dscp 16
    prod_sshd -> dev_laptop ssh msgcode 52 dscp 16
}

// INSTRUCTION: Compile the SSH userauth service and authentication flow.
compile {
    ssh_userauth_publickey_flow(dev_laptop, prod_sshd)
}
