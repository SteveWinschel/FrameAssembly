// Authentication accepted by server transmitting msgcode 52.
// SSH RFC 4253 framing on TCP 22 (message codes: 50 (USERAUTH_REQUEST), 52
// (USERAUTH_SUCCESS)).
// Wireshark: ssh

host oper_client { ip 10.77.2.19 }

host auth_server { ip 10.77.2.1 }

flow ssh_userauth_success(c, s) {
    c -> s ssh msgcode 50
    c <- s ssh msgcode 52
}

compile {
    ssh_userauth_success(oper_client, auth_server)
}
