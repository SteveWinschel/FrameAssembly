// PROMPT: STUN Binding Error Response indicating unauthenticated request over IPv6.
// TOKENS: HOST, IP, FLOW, STUN, BINDING_ERROR, SOFTWARE, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 2001:db8::100 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
FLOW stun_err(c, s) {
    c <- s STUN BINDING_ERROR SOFTWARE "coturn-server"
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    stun_err(client, server)
}
