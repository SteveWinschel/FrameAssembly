// STUN Binding Error Response indicating unauthenticated request over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host client { ip 2001:db8::100 }

host server { ip 2001:db8::1 }

flow stun_err(c, s) {
    c <- s stun bindingerror software "coturn-server"
}

compile {
    stun_err(client, server)
}
