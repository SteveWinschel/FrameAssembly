// STUN Binding Request probing NAT mapping and public endpoint discovery.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host client { ip 192.168.1.100 }

host server { ip 34.200.1.1 }

flow stun_req(c, s) {
    c -> s stun bindingrequest
}

compile {
    stun_req(client, server)
}
