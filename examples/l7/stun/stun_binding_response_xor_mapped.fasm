// PROMPT: STUN Binding Response returning public XOR mapped IPv4 address.
// TOKENS: host, ip, flow, s, stun, bindingresponse, xormappedaddr, software, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
host server { ip 34.200.1.1 }

// INSTRUCTION: Define application traffic flow.
flow stun_resp(c, s) {
    c <- s stun bindingresponse xormappedaddr 198.51.100.55 software "FrameAssembly-STUN"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    stun_resp(client, server)
}
