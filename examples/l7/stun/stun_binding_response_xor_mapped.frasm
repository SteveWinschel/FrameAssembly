// STUN Binding Response returning public XOR mapped IPv4 address.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host client { ip 192.168.1.100 }

host server { ip 34.200.1.1 }

flow stun_resp(c, s) {
    c <- s stun bindingresponse xormappedaddr 198.51.100.55 software "FrameAssembly-STUN"
}

compile {
    stun_resp(client, server)
}
