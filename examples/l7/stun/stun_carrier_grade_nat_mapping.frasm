// Carrier-Grade NAT traversal query with XOR-MAPPED-ADDRESS mapping.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host cgnat_subscriber { ip 100.64.12.90 }

host carrier_reflector { ip 203.0.113.5 }

flow stun_cgnat_flow(c, s) {
    c -> s stun bindingrequest
    c <- s stun bindingresponse xormappedaddr 203.0.113.150
}

compile {
    stun_cgnat_flow(cgnat_subscriber, carrier_reflector)
}
