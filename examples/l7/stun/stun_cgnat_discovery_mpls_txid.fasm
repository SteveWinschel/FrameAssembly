// PROMPT: Generate a STUN Binding Request and Response carrying a custom TXID and MPLS label 3478 across a service provider core.
// TOKENS: host, mac, ip, flow, stun, bindingrequest, software, txid, mpls, bindingresponse, xormappedaddr, compile

// INSTRUCTION: Define host endpoint cpe_gateway.
host cpe_gateway {
    mac 00:21:5a:34:78:01
    ip 100.64.10.55
}

// INSTRUCTION: Define host endpoint carrier_stun.
host carrier_stun {
    mac 00:21:5a:34:78:99
    ip 198.18.0.10
}

// INSTRUCTION: Probe the carrier STUN server over MPLS label 3478 with explicit TXID 9001.
flow stun_carrier_cgnat_mpls(cpe_gateway, carrier_stun) {
    cpe_gateway -> carrier_stun stun bindingrequest software "TR-069-STUN-Client" txid 9001 mpls 3478
    carrier_stun -> cpe_gateway stun bindingresponse xormappedaddr 198.51.100.250 software "Carrier-STUN/3.1" txid 9001 mpls 3478
}

// INSTRUCTION: Compile the MPLS-labeled CGNAT STUN discovery flow.
compile {
    stun_carrier_cgnat_mpls(cpe_gateway, carrier_stun)
}
