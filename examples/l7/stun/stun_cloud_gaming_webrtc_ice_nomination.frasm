// Generate a low-latency cloud gaming WebRTC ICE aggressive nomination STUN
// exchange over IPv6.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: stun

host gamer_client_v6 {
    ip 2001:db8:3478:10::55
    mac 00:25:90:34:78:55
}

host gpu_streamer_v6 {
    ip 2001:db8:3478:10::1
    mac 00:25:90:34:78:01
}

flow stun_cloud_gaming_v6(client, streamer) {
    client -> streamer stun bindingrequest txid 0x99aabbcc software "WebRTC-NVStream/2.1" dscp 46 flowlabel 0x34780 ttl 64 wait 3ms
    client <- streamer stun bindingresponse txid 0x99aabbcc xormappedaddr 2001:db8:3478:10::55 software "WebRTC-NVStream/2.1" dscp 46 flowlabel 0x34780 ttl 64
}

compile {
    stun_cloud_gaming_v6(gamer_client_v6, gpu_streamer_v6)
}
