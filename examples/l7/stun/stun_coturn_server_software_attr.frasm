// STUN binding response populated with server SOFTWARE attribute.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host conf_client { ip 172.25.1.80 }

host coturn_svr { ip 198.51.100.99 }

flow stun_coturn_flow(c, s) {
    c -> s stun bindingrequest software "Jitsi-Meet-Client"
    c <- s stun bindingresponse
        xormappedaddr 198.51.100.14
        software "Coturn-4.6.2 'dan Eiser'"
}

compile {
    stun_coturn_flow(conf_client, coturn_svr)
}
