// PROMPT: Simulate a STUN Binding Request on custom UDP port 19302 (Google STUN port) with DSCP 46 voice marking.
// TOKENS: host, mac, ip, flow, srcport, dstport, stun, bindingrequest, software, dscp, bindingresponse, xormappedaddr, compile

// INSTRUCTION: Define host endpoint browser_peer.
host browser_peer {
    mac 00:25:90:19:30:01
    ip 10.10.50.25
}

// INSTRUCTION: Define host endpoint stun_19302.
host stun_19302 {
    mac 00:25:90:19:30:02
    ip 198.51.100.193
}

// INSTRUCTION: Send a STUN Binding Request to UDP port 19302 with DSCP 46 and receive the reflexive IPv4 address.
flow stun_custom_port_19302_flow(browser_peer, stun_19302) {
    browser_peer -> stun_19302 srcport 54302 dstport 19302 stun bindingrequest software "Chromium-WebRTC/124.0" dscp 46
    stun_19302 -> browser_peer srcport 19302 dstport 54302 stun bindingresponse xormappedaddr 192.0.2.25 software "Google-STUN" dscp 46
}

// INSTRUCTION: Compile the STUN port 19302 NAT discovery flow.
compile {
    stun_custom_port_19302_flow(browser_peer, stun_19302)
}
