// Minimal 2-block STUN starter sending a default RFC 8489 Binding Request on UDP port 3478.
// Includes the 0x2112A442 magic cookie and random-free transaction ID directly in compile.
// Compile to check WebRTC / VoIP NAT traversal firewall rules.
// Wireshark: stun

host softphone   { ip 10.80.1.52     mac 00:1a:2b:34:00:34 }
host stun_server { ip 198.51.100.88  mac 00:1a:2b:34:00:58 }

compile {
    softphone -> stun_server stun
}
