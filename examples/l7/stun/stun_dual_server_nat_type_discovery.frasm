// Simulate symmetric NAT behavior detection by querying two distinct STUN
// servers and observing reflexive address mapping.
// Wireshark: stun

host nat_endpoint {
    mac 00:0c:29:34:78:11
    ip 10.0.0.45
}

host stun_primary {
    mac 00:0c:29:34:78:21
    ip 198.51.100.11
}

host stun_secondary {
    mac 00:0c:29:34:78:22
    ip 198.51.100.12
}

flow stun_dual_server_nat_classification(nat_endpoint, stun_primary, stun_secondary) {
    nat_endpoint -> stun_primary stun bindingrequest software "linphone-sdk/5.2"
    stun_primary -> nat_endpoint stun bindingresponse xormappedaddr 192.0.2.100 software "reTurnServer-1.12"
    nat_endpoint -> stun_secondary stun bindingrequest software "linphone-sdk/5.2"
    stun_secondary -> nat_endpoint stun bindingresponse xormappedaddr 192.0.2.100 software "reTurnServer-1.12"
}

compile {
    stun_dual_server_nat_classification(nat_endpoint, stun_primary, stun_secondary)
}
