// Multi-homed gateway verifying secondary WAN uplink NAT binding.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host wan2_interface { ip 172.31.50.10 }

host public_stun { ip 198.51.100.222 }

flow stun_wan2_flow(c, s) {
    c -> s stun bindingrequest
    c <- s stun bindingresponse xormappedaddr 198.51.100.77
}

compile {
    stun_wan2_flow(wan2_interface, public_stun)
}
