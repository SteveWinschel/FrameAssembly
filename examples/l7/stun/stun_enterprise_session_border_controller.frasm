// Enterprise SBC performing STUN keepalive probe on UDP 3478.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host internal_sbc { ip 10.50.200.5 }

host carrier_sbc { ip 203.0.113.120 }

flow stun_sbc_flow(c, s) {
    c -> s stun bindingrequest software "Audiocodes-Mediant-SBC"
    c <- s stun bindingresponse
        xormappedaddr 203.0.113.245
        software "Carrier-Edge-SBC-v7"
}

compile {
    stun_sbc_flow(internal_sbc, carrier_sbc)
}
