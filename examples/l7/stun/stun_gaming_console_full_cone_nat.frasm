// Online multiplayer gaming console detecting full-cone NAT mapping.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host game_console { ip 192.168.1.180 }

host match_stun { ip 203.0.113.4 }

flow stun_gaming_flow(c, s) {
    c -> s stun bindingrequest software "Xbox-Net-Engine"
    c <- s stun bindingresponse
        xormappedaddr 203.0.113.166
        software "Multiplayer-Reflector-v4"
}

compile {
    stun_gaming_flow(game_console, match_stun)
}
