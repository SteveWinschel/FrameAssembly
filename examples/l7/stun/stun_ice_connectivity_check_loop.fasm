// PROMPT: Model a periodic WebRTC ICE connectivity check keepalive loop using STUN Binding Requests and Responses.
// TOKENS: host, mac, ip, flow, stun, bindingrequest, software, bindingresponse, xormappedaddr, wait, ms, compile

// INSTRUCTION: Define host endpoint ice_agent_a.
host ice_agent_a {
    mac 00:1c:42:34:78:10
    ip 192.168.1.105
}

// INSTRUCTION: Define host endpoint ice_agent_b.
host ice_agent_b {
    mac 00:1c:42:34:78:20
    ip 198.51.100.42
}

// INSTRUCTION: Execute 3 periodic STUN Binding Request/Response keepalive checks with 25ms interval.
flow stun_ice_keepalive_loop(ice_agent_a, ice_agent_b) {
    ice_agent_a -> ice_agent_b stun bindingrequest software "libnice-0.1.21"
    ice_agent_b -> ice_agent_a stun bindingresponse xormappedaddr 203.0.113.105 software "libnice-0.1.21" wait 25ms
}

// INSTRUCTION: Compile the STUN ICE connectivity keepalive loop flow.
compile {
    stun_ice_keepalive_loop(ice_agent_a, ice_agent_b) // cycle 1
    stun_ice_keepalive_loop(ice_agent_a, ice_agent_b) // cycle 2
    stun_ice_keepalive_loop(ice_agent_a, ice_agent_b) // cycle 3
}
