// Dual-stack IPv6 STUN binding request to public session controller.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: stun

host dual_terminal { ip 2001:db8:9000::25 }

host stun_v6_ctrl { ip 2001:db8:9000::1 }

flow stun_v6_flow(c, s) {
    c -> s stun bindingrequest software "V6-Client-Lib"
    c <- s stun bindingresponse software "V6-Coturn-Core"
}

compile {
    stun_v6_flow(dual_terminal, stun_v6_ctrl)
}
