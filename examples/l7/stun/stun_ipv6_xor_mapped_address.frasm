// Simulate a STUN Binding Request and Binding Response over IPv6 returning an
// IPv6 XOR-MAPPED-ADDRESS (RFC 5389).
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: stun

host webrtc_v6_peer {
    mac 00:50:56:34:78:01
    ip 2001:db8:3478:1::50
}

host stun_v6_srv {
    mac 00:50:56:34:78:99
    ip 2001:db8:3478:2::1
}

flow stun_ipv6_binding_discovery(webrtc_v6_peer, stun_v6_srv) {
    webrtc_v6_peer -> stun_v6_srv stun bindingrequest software "WebRTC-ICE-v6/1.0"
    stun_v6_srv -> webrtc_v6_peer stun bindingresponse xormappedaddr 2001:db8:3478:1::50 software "coturn-4.6.2"
}

compile {
    stun_ipv6_binding_discovery(webrtc_v6_peer, stun_v6_srv)
}
