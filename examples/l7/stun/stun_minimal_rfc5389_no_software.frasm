// Minimal 2-block STUN (RFC 8489) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Wireshark: stun

host embedded_ua {
    mac 00:0e:08:34:78:12
    ip 10.12.34.56
}

host minimal_stun {
    mac 00:0e:08:34:78:01
    ip 10.12.34.1
}

compile {
    embedded_ua -> minimal_stun stun bindingrequest ttl 64
    minimal_stun -> embedded_ua stun bindingresponse xormappedaddr 198.51.100.56 ttl 64
}
