// Generate a multi-interface ICE gathering flow where a dual-homed host
// probes STUN from both Wi-Fi and LTE interfaces.
// Wireshark: stun

host host_wifi {
    mac 00:1f:5b:34:01:01
    ip 192.168.1.40
}

host host_lte {
    mac 00:1f:5b:34:02:02
    ip 100.64.22.19
}

host public_stun {
    mac 00:1f:5b:34:99:99
    ip 198.51.100.1
}

flow stun_multihomed_ice_gathering(host_wifi, host_lte, public_stun) {
    host_wifi -> public_stun stun bindingrequest software "WebRTC-Mobile/1.0"
    public_stun -> host_wifi stun bindingresponse xormappedaddr 192.0.2.40 software "coturn-4.6.2"
    host_lte -> public_stun stun bindingrequest software "WebRTC-Mobile/1.0"
    public_stun -> host_lte stun bindingresponse xormappedaddr 203.0.113.19 software "coturn-4.6.2"
}

compile {
    stun_multihomed_ice_gathering(host_wifi, host_lte, public_stun)
}
