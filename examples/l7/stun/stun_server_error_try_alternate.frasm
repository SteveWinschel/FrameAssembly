// STUN server error response directing client to try alternate server.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host roving_client { ip 192.168.75.14 }

host primary_stun { ip 198.51.100.12 }

flow stun_try_alt_flow(c, s) {
    c -> s stun bindingrequest software "SIP-Agent-3.0"
    c <- s stun bindingerror software "Primary-Overloaded-TryAlternate"
}

compile {
    stun_try_alt_flow(roving_client, primary_stun)
}
