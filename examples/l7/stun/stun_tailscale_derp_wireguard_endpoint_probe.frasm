// Simulate a mesh VPN node probing a STUN server on UDP port 3478 to discover
// its public reflexive endpoint before WireGuard peering.
// Encapsulation and QoS markings: DSCP 46 (EF).
// Timing: pauses 8ms after each marked packet before sending the next frame.
// Wireshark: stun

host mesh_vpn_node {
    ip 10.64.20.18
    mac 00:1c:42:40:14:12
}

host derp_stun_srv {
    ip 198.51.100.210
    mac 00:1c:42:40:14:d2
}

flow stun_mesh_vpn_discovery(node, stun_srv) {
    node -> stun_srv stun bindingrequest txid 0x77889901 software "tailscale-magicsock/1.64" dscp 46 wait 8ms
    node <- stun_srv stun bindingresponse txid 0x77889901 xormappedaddr 203.0.113.188 software "derper-stun/1.64" dscp 46
}

compile {
    stun_mesh_vpn_discovery(mesh_vpn_node, derp_stun_srv)
}
