// PROMPT: Simulate a TURN relay server returning a STUN Binding Error when an allocation quota is exceeded.
// TOKENS: host, mac, ip, flow, stun, bindingrequest, software, dscp, bindingerror, compile

// INSTRUCTION: Define host endpoint conf_client.
host conf_client {
    mac 00:15:5d:34:78:05
    ip 10.80.10.55
}

// INSTRUCTION: Define host endpoint relay_srv.
host relay_srv {
    mac 00:15:5d:34:78:99
    ip 10.80.10.1
}

// INSTRUCTION: Send STUN Binding Request and receive a STUN Binding Error due to server capacity limits.
flow stun_quota_exceeded_error(conf_client, relay_srv) {
    conf_client -> relay_srv stun bindingrequest software "Jitsi-Meet-ICE/2.0" dscp 34
    relay_srv -> conf_client stun bindingerror software "eturnal-1.11.0" dscp 34
}

// INSTRUCTION: Compile the STUN allocation quota error flow.
compile {
    stun_quota_exceeded_error(conf_client, relay_srv)
}
