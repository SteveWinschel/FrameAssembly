// Simulate a STUN UDP retransmission sequence where the initial Binding
// Request is lost and a retry after 100ms succeeds.
// Timing: pauses 100ms after each marked packet before sending the next
// frame.
// Wireshark: stun

host mobile_client {
    mac 00:26:bb:34:78:11
    ip 10.45.12.88
}

host cloud_stun {
    mac 00:26:bb:34:78:01
    ip 198.51.100.88
}

flow stun_rto_retransmission_flow(mobile_client, cloud_stun) {
    mobile_client -> cloud_stun stun bindingrequest software "Linphone-iOS/5.1" wait 100ms
    mobile_client -> cloud_stun stun bindingrequest software "Linphone-iOS/5.1"
    cloud_stun -> mobile_client stun bindingresponse xormappedaddr 203.0.113.88 software "Flexisip-STUN/2.2"
}

compile {
    stun_rto_retransmission_flow(mobile_client, cloud_stun)
}
