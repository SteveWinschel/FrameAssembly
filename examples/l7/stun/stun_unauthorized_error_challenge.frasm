// STUN error response indicating unauthorized credential challenge.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host unauth_client { ip 10.140.2.19 }

host auth_stun_gw { ip 10.140.2.1 }

flow stun_error_flow(c, s) {
    c -> s stun bindingrequest software "Generic-STUN-Tester"
    c <- s stun bindingerror software "Secure-STUN-Gateway"
}

compile {
    stun_error_flow(unauth_client, auth_stun_gw)
}
