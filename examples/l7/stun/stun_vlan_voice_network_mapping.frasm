// Dedicated voice VLAN 200 STUN binding transaction with DSCP EF priority.
// Encapsulation and QoS markings: 802.1Q VLAN 200, 802.1p priority 5, DSCP 46
// (EF).
// Wireshark: stun && vlan.id == 200

host voice_phone { ip 10.200.10.15 }

host cloud_voice_gw { ip 198.51.100.60 }

flow stun_voice_vlan_flow(c, s) {
    c -> s stun bindingrequest
        vlan 200 pcp 5 dei 0 dscp 46
    c <- s stun bindingresponse
        xormappedaddr 198.51.100.110
        vlan 200 pcp 5 dei 0 dscp 46
}

compile {
    stun_voice_vlan_flow(voice_phone, cloud_voice_gw)
}
