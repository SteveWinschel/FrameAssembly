// PROMPT: Simulate a STUN Binding Request and Response on enterprise voice VLAN 200 for a SIP deskphone discovering its public IP.
// TOKENS: host, mac, ip, flow, stun, bindingrequest, software, vlan, bindingresponse, xormappedaddr, compile

// INSTRUCTION: Define host endpoint voip_deskphone.
host voip_deskphone {
    mac 00:04:f2:34:78:10
    ip 10.200.1.50
}

// INSTRUCTION: Define host endpoint edge_stun.
host edge_stun {
    mac 00:04:f2:34:78:01
    ip 10.200.1.1
}

// INSTRUCTION: Send STUN Binding Request on VLAN 200 and receive the external WAN IPv4 in XOR_MAPPED_ADDR.
flow stun_voice_vlan_discovery(voip_deskphone, edge_stun) {
    voip_deskphone -> edge_stun stun bindingrequest software "Polycom-VVX450/6.4.5" vlan 200
    edge_stun -> voip_deskphone stun bindingresponse xormappedaddr 203.0.113.200 software "SBC-STUN-Engine" vlan 200
}

// INSTRUCTION: Compile the VLAN 200 STUN discovery flow.
compile {
    stun_voice_vlan_discovery(voip_deskphone, edge_stun)
}
