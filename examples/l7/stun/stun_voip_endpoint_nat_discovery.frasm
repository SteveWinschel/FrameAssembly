// SIP telephone performing STUN binding request for NAT discovery.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host sip_phone { ip 192.168.15.22 }

host cloud_stun { ip 198.51.100.40 }

flow stun_sip_nat_flow(c, s) {
    c -> s stun bindingrequest software "Polycom-VVX450"
    c <- s stun bindingresponse
        xormappedaddr 203.0.113.190
        software "reTurnServer-0.4"
}

compile {
    stun_sip_nat_flow(sip_phone, cloud_stun)
}
