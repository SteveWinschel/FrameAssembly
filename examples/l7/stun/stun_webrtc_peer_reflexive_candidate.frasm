// WebRTC browser endpoint acquiring server reflexive candidate address.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (STUN (RFC
// 8489), UDP 3478).
// Wireshark: stun

host browser_client { ip 10.0.8.44 }

host webrtc_stun { ip 198.51.100.88 }

flow stun_webrtc_flow(c, s) {
    c -> s stun bindingrequest software "Chromium-WebRTC"
    c <- s stun bindingresponse
        xormappedaddr 198.51.100.210
        software "coturn-4.5.2"
}

compile {
    stun_webrtc_flow(browser_client, webrtc_stun)
}
