// PROMPT: Model an SSH authentication failure and sudo escalation audit trail using Syslog Facility 10 (authpriv).
// TOKENS: host, mac, ip, flow, syslog, facility, severity, hostname, app, procid, msg, wait, ms, compile

// INSTRUCTION: Define host endpoint bastion_srv.
host bastion_srv {
    mac 00:50:56:51:40:10
    ip 172.16.10.22
}

// INSTRUCTION: Define host endpoint audit_log_srv.
host audit_log_srv {
    mac 00:50:56:51:40:01
    ip 172.16.10.5
}

// INSTRUCTION: Send an sshd warning (Severity 4) followed by a sudo notice (Severity 5) under Facility 10 (authpriv).
flow syslog_authpriv_ssh_and_sudo(bastion_srv, audit_log_srv) {
    bastion_srv -> audit_log_srv syslog facility 10 severity 4 hostname "bastion01" app "sshd" procid "4412"
        msg "Failed password for invalid user admin from 198.51.100.44 port 51200 ssh2" wait 20ms
    bastion_srv -> audit_log_srv syslog facility 10 severity 5 hostname "bastion01" app "sudo" procid "4489"
        msg "ops : TTY=pts/0 ; PWD=/home/ops ; USER=root ; COMMAND=/usr/bin/systemctl restart nginx"
}

// INSTRUCTION: Compile the authpriv SSH and sudo syslog flow.
compile {
    syslog_authpriv_ssh_and_sudo(bastion_srv, audit_log_srv)
}
