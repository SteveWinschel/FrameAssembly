// PROMPT: Generate a cron job execution log entry using Syslog Facility 9 (cron) and Severity 6 (informational).
// TOKENS: host, mac, ip, flow, syslog, facility, severity, hostname, app, procid, msg, vlan, compile

// INSTRUCTION: Define host endpoint db_server.
host db_server {
    mac 00:0c:29:51:40:09
    ip 10.50.9.20
}

// INSTRUCTION: Define host endpoint syslog_srv.
host syslog_srv {
    mac 00:0c:29:51:40:01
    ip 10.50.9.1
}

// INSTRUCTION: Send a Facility 9 (cron) informational message over VLAN 50.
flow syslog_cron_nightly_backup(db_server, syslog_srv) {
    db_server -> syslog_srv syslog facility 9 severity 6 hostname "pg-primary-01" app "CRON" procid "31024"
        msg "(postgres) CMD (/usr/local/bin/pg_backup_s3.sh --full)" vlan 50
}

// INSTRUCTION: Compile the cron facility syslog flow.
compile {
    syslog_cron_nightly_backup(db_server, syslog_srv)
}
