// Generate a cron job execution log entry using Syslog Facility 9 (cron) and
// Severity 6 (informational).
// Encapsulation and QoS markings: 802.1Q VLAN 50.
// RFC 5424 over UDP 514; facility 9 (cron) + severity 6 (info) yields PRI
// <78>.
// Wireshark: syslog && vlan.id == 50

host db_server {
    mac 00:0c:29:51:40:09
    ip 10.50.9.20
}

host syslog_srv {
    mac 00:0c:29:51:40:01
    ip 10.50.9.1
}

flow syslog_cron_nightly_backup(db_server, syslog_srv) {
    db_server -> syslog_srv syslog facility 9 severity 6 hostname "pg-primary-01" app "CRON" procid "31024"
        msg "(postgres) CMD (/usr/local/bin/pg_backup_s3.sh --full)" vlan 50
}

compile {
    syslog_cron_nightly_backup(db_server, syslog_srv)
}
