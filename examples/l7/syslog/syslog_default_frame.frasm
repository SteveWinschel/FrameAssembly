// Minimal 2-block Syslog starter emitting a default RFC 5424 event on UDP port 514.
// Computes the <PRI> header automatically from default user/info codes without a flow block.
// Compile to smoke-test SIEM, Graylog, or Splunk syslog collectors.
// Wireshark: syslog

host edge_router    { ip 10.250.10.1   mac 00:50:56:fa:01:01 }
host siem_collector { ip 10.250.10.100 mac 00:50:56:fa:01:64 }

compile {
    edge_router -> siem_collector syslog
}
