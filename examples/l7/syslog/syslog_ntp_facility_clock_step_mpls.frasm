// Generate a NTP clock synchronization step warning under Syslog Facility 12
// (ntp) over MPLS label 1514.
// Encapsulation and QoS markings: MPLS label 1514.
// RFC 5424 over UDP 514; facility 12 (ntp) + severity 4 (warning) yields PRI
// <100>.
// Wireshark: syslog && mpls

host ntp_node {
    mac 00:1a:a0:51:40:12
    ip 10.120.12.10
}

host wan_syslog {
    mac 00:1a:a0:51:40:99
    ip 10.120.12.99
}

flow syslog_ntp_clock_step_mpls(ntp_node, wan_syslog) {
    ntp_node -> wan_syslog syslog facility 12 severity 4 hostname "time-sync-02" app "chronyd" procid "614"
        msg "System clock was stepped by -0.418291 seconds" mpls 1514
}

compile {
    syslog_ntp_clock_step_mpls(ntp_node, wan_syslog)
}
