// PROMPT: Generate a NTP clock synchronization step warning under Syslog Facility 12 (ntp) over MPLS label 1514.
// TOKENS: host, mac, ip, flow, syslog, facility, severity, hostname, app, procid, msg, mpls, compile

// INSTRUCTION: Define host endpoint ntp_node.
host ntp_node {
    mac 00:1a:a0:51:40:12
    ip 10.120.12.10
}

// INSTRUCTION: Define host endpoint wan_syslog.
host wan_syslog {
    mac 00:1a:a0:51:40:99
    ip 10.120.12.99
}

// INSTRUCTION: Send a Facility 12 (ntp) clock step notice over MPLS label 1514.
flow syslog_ntp_clock_step_mpls(ntp_node, wan_syslog) {
    ntp_node -> wan_syslog syslog facility 12 severity 4 hostname "time-sync-02" app "chronyd" procid "614"
        msg "System clock was stepped by -0.418291 seconds" mpls 1514
}

// INSTRUCTION: Compile the NTP facility MPLS syslog flow.
compile {
    syslog_ntp_clock_step_mpls(ntp_node, wan_syslog)
}
