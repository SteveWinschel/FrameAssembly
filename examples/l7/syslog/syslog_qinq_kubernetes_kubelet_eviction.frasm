// Simulate a Kubernetes container runtime OOM/eviction warning forwarded over
// QinQ (S-VLAN 600, C-VLAN 60) via Syslog.
// Encapsulation and QoS markings: 802.1ad QinQ outer 600 / inner 60.
// RFC 5424 over UDP 514; facility 19 (local3) + severity 4 (warning) yields
// PRI <156>.
// Wireshark: syslog && vlan

host k8s_worker {
    mac 00:26:b9:51:40:60
    ip 10.60.60.12
}

host cluster_sink {
    mac 00:26:b9:51:40:01
    ip 10.60.60.1
}

flow syslog_k8s_kubelet_eviction_qinq(k8s_worker, cluster_sink) {
    k8s_worker -> cluster_sink syslog facility 19 severity 4 hostname "k8s-node-12" app "kubelet" procid "1420"
        msg "Evicting pod analytics/spark-exec-77b due to nodefs.available < 10%" qinq 600 innervlan 60
}

compile {
    syslog_k8s_kubelet_eviction_qinq(k8s_worker, cluster_sink)
}
