// RFC 5424 structured event logging over IPv6 with custom facility, severity,
// and application tags.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RFC 5424 over UDP 514; facility 1 (user) + severity 5 (notice) yields PRI
// <13>.
// Wireshark: syslog

host syslog_sender { ip 2001:db8:514::1 }

host syslog_collector { ip 2001:db8:514::2 }

flow syslog_flow(src, dst) {
    src -> dst syslog facility 1 severity 5 app "kernel" msg "System boot complete"
}

compile {
    syslog_flow(syslog_sender, syslog_collector)
}
