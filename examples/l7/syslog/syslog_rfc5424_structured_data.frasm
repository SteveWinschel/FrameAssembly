// PROMPT: RFC 5424 syslog event notification with facility, severity, hostname, and app identity.
// TOKENS: host, ip, flow, s, syslog, facility, severity, hostname, app, msg, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.20 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
flow syslog_event(c, s) {
    c -> s syslog facility 1 severity 6 hostname "router-1" app "sshd" msg "Accepted publickey for admin"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    syslog_event(client, server)
}
