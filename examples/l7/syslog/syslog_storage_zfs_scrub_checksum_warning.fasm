// PROMPT: Generate a ZFS storage pool scrub checksum repair notification transmitted over Syslog Facility 0 (kern).
// TOKENS: host, ip, mac, flow, syslog, facility, severity, hostname, app, procid, msg, wait, ms, compile

// INSTRUCTION: Define the ZFS petabyte storage server emitting kernel zed events.
host zfs_filer_node {
    ip 172.20.51.14
    mac 00:25:90:33:00:0e
}

// INSTRUCTION: Define the storage operations log server.
host storage_log_srv {
    ip 172.20.51.250
    mac 00:25:90:33:00:fa
}

// INSTRUCTION: Emit kernel ZFS scrub start and repaired checksum sector notifications.
flow syslog_zfs_scrub_event(filer, logsrv) {
    filer -> logsrv syslog facility 0 severity 4 hostname "zfs-vault-02" app "zed" procid "88"
        msg "ZFS checksum error on pool tank/vmstore vdev nvme2n1p1 offset 0x1a4f80000: repaired 4096 bytes via raidz2 parity" wait 10ms
    filer -> logsrv syslog facility 0 severity 5 hostname "zfs-vault-02" app "zed" procid "88"
        msg "ZFS pool scrub completed on tank/vmstore: 0 unrecoverable errors, 4KB repaired in 02h14m"
}

// INSTRUCTION: Compile the ZFS storage scrub Syslog telemetry trace.
compile {
    syslog_zfs_scrub_event(zfs_filer_node, storage_log_srv)
}
