// Simulate a TACACS+ accounting (ACCT) start and stop session logging CLI
// privilege level 15 commands on TCP port 49.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// TACACS+ on TCP 49 (acct).
// Overrides destination port to 49.
// Wireshark: tacplus

host switch_nas {
    mac 00:1b:21:00:49:01
    ip 10.10.49.10
}

host tacacs_srv {
    mac 00:1b:21:00:49:99
    ip 10.10.49.99
}

flow tacacs_accounting_command_log(switch_nas, tacacs_srv) {
    switch_nas -> tacacs_srv tcp syn srcport 51049 dstport 49
    tacacs_srv -> switch_nas tcp syn ack
    switch_nas -> tacacs_srv tcp ack
    switch_nas -> tacacs_srv tacacs acct sessionid 900101 user "netadmin" payload "task_id=42:service=shell:cmd=configure terminal"
    tacacs_srv -> switch_nas tacacs acct sessionid 900101 payload "ACCT_STATUS_SUCCESS"
}

compile {
    tacacs_accounting_command_log(switch_nas, tacacs_srv)
}
