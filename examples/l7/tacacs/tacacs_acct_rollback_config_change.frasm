// PROMPT: Generate a TACACS+ accounting start and stop transaction recording a configuration rollback event on VLAN 49.
// TOKENS: host, ip, mac, flow, acct, tacacs, type, seq, flags, sessionid, user, payload, vlan, pcp, wait, ms, compile

// INSTRUCTION: Define the data center aggregation switch on management VLAN 49.
host agg_switch_nas {
    ip 10.49.10.12
    mac 00:24:e8:31:0a:0c
}

// INSTRUCTION: Define the compliance TACACS+ accounting collector on VLAN 49.
host tacacs_acct_collector {
    ip 10.49.10.50
    mac 00:24:e8:31:0a:32
}

// INSTRUCTION: Log the configuration rollback start and completion records over VLAN 49.
flow tacacs_rollback_accounting(sw, acct) {
    sw -> acct tacacs type acct seq 1 flags 1 sessionid 991204 user "netops_oncall" payload "flags=START:task_id=901:cmd=configure replace flash:golden.cfg" vlan 49 pcp 6 wait 10ms
    sw <- acct tacacs type acct seq 2 flags 1 sessionid 991204 user "netops_oncall" payload "ACCT_STATUS_SUCCESS" vlan 49 pcp 6
}

// INSTRUCTION: Compile the VLAN 49 TACACS+ configuration rollback accounting flow.
compile {
    tacacs_rollback_accounting(agg_switch_nas, tacacs_acct_collector)
}
