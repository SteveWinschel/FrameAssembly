// Accounting START record logging initial administrator login timestamp.
// TACACS+ on TCP 49 (acct).
// Wireshark: tacplus

host mgmt_gateway { ip 10.210.1.2 }

host acct_db { ip 10.210.1.1 }

flow tacacs_acct_start_flow(c, s) {
    c -> s tacacs type acct user "cisco_admin" sessionid 11070
    c <- s tacacs type acct user "cisco_admin" sessionid 11070
}

compile {
    tacacs_acct_start_flow(mgmt_gateway, acct_db)
}
