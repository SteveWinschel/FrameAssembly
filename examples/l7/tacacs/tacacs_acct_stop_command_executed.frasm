// Accounting STOP record logging completed configuration change execution.
// TACACS+ on TCP 49 (acct).
// Wireshark: tacplus

host spine_nas { ip 10.70.1.1 }

host audit_logger { ip 10.70.1.250 }

flow tacacs_acct_stop_flow(c, s) {
    c -> s tacacs type acct user "net_architect" sessionid 12080
    c <- s tacacs type acct user "net_architect" sessionid 12080
}

compile {
    tacacs_acct_stop_flow(spine_nas, audit_logger)
}
