// Accounting UPDATE heartbeat record preserving active session audit trail.
// TACACS+ on TCP 49 (acct).
// Wireshark: tacplus

host lab_console { ip 192.168.88.10 }

host reg_acct_node { ip 192.168.88.1 }

flow tacacs_acct_update_flow(c, s) {
    c -> s tacacs type acct user "automation_bot" sessionid 13090
    c <- s tacacs type acct user "automation_bot" sessionid 13090
}

compile {
    tacacs_acct_update_flow(lab_console, reg_acct_node)
}
