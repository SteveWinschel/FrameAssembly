// PROMPT: TACACS+ authentication session passing user credentials.
// TOKENS: host, ip, flow, s, tacacs, type, authen, user, sessionid, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.10.5 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.10.1 }

// INSTRUCTION: Define application traffic flow.
flow tacacs_pass(c, s) {
    c -> s tacacs type authen user "admin" sessionid 1002
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    tacacs_pass(client, server)
}
