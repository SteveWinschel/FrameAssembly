// TACACS+ administrative login authentication START message on TCP port 49.
// TACACS+ on TCP 49 (authen).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TACACS+
// (RFC 8907), TCP 49).
// Wireshark: tacplus

host client { ip 192.168.10.5 }

host server { ip 192.168.10.1 }

flow tacacs_login(c, s) {
    c -> s tacacs type authen user "admin" sessionid 1001
}

compile {
    tacacs_login(client, server)
}
