// TACACS+ authentication session prompting user for login password.
// TACACS+ on TCP 49 (authen).
// Wireshark: tacplus

host switch_nas { ip 192.168.100.10 }

host aaa_server { ip 192.168.100.1 }

flow tacacs_prompt_flow(c, s) {
    c -> s tacacs type authen user "jdoe" sessionid 5010
    c <- s tacacs type authen user "jdoe" sessionid 5010
}

compile {
    tacacs_prompt_flow(switch_nas, aaa_server)
}
