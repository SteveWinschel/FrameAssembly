// CHAP authentication flow verifying administrative user credentials.
// TACACS+ on TCP 49 (authen).
// Wireshark: tacplus

host agg_rtr { ip 172.16.5.2 }

host tacacs_daemon { ip 172.16.5.1 }

flow tacacs_chap_flow(c, s) {
    c -> s tacacs type authen user "netops_lead" sessionid 6020
    c <- s tacacs type authen user "netops_lead" sessionid 6020
}

compile {
    tacacs_chap_flow(agg_rtr, tacacs_daemon)
}
