// PROMPT: Simulate a TACACS+ password expiry and interactive password change (CHPASS) sequence during user login.
// TOKENS: HOST, MAC, IP, FLOW, TCP, SYN, SRCPORT, DSTPORT, ACK, TACACS, AUTHEN, SESSION_ID, USER, PAYLOAD, COMPILE

// INSTRUCTION: Define host endpoint term_srv.
HOST term_srv {
    MAC 00:15:5d:49:50:01
    IP 10.59.1.5
}

// INSTRUCTION: Define host endpoint dir_tacacs.
HOST dir_tacacs {
    MAC 00:15:5d:49:50:99
    IP 10.59.1.99
}

// INSTRUCTION: Prompt for old and new passwords via TACACS+ AUTHEN CHPASS and return AUTHEN_STATUS_PASS.
FLOW tacacs_authen_chpass_flow(term_srv, dir_tacacs) {
    term_srv -> dir_tacacs TCP SYN SRCPORT 61049 DSTPORT 49
    dir_tacacs -> term_srv TCP SYN ACK
    term_srv -> dir_tacacs TCP ACK
    term_srv -> dir_tacacs TACACS AUTHEN SESSION_ID 66012 USER "sysadmin" PAYLOAD "action=CHPASS"
    dir_tacacs -> term_srv TACACS AUTHEN SESSION_ID 66012 PAYLOAD "GETDATA:Old Password: "
    term_srv -> dir_tacacs TACACS AUTHEN SESSION_ID 66012 USER "sysadmin" PAYLOAD "OldPass!2025"
    dir_tacacs -> term_srv TACACS AUTHEN SESSION_ID 66012 PAYLOAD "GETPASS:New Password: "
    term_srv -> dir_tacacs TACACS AUTHEN SESSION_ID 66012 USER "sysadmin" PAYLOAD "NewPass!2026"
    dir_tacacs -> term_srv TACACS AUTHEN SESSION_ID 66012 PAYLOAD "AUTHEN_STATUS_PASS:Password updated"
}

// INSTRUCTION: Compile the TACACS+ password change flow.
COMPILE {
    tacacs_authen_chpass_flow(term_srv, dir_tacacs)
}
