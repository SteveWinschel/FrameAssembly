// PROMPT: Simulate a TACACS+ password expiry and interactive password change (CHPASS) sequence during user login.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, tacacs, authen, sessionid, user, payload, compile

// INSTRUCTION: Define host endpoint term_srv.
host term_srv {
    mac 00:15:5d:49:50:01
    ip 10.59.1.5
}

// INSTRUCTION: Define host endpoint dir_tacacs.
host dir_tacacs {
    mac 00:15:5d:49:50:99
    ip 10.59.1.99
}

// INSTRUCTION: Prompt for old and new passwords via TACACS+ AUTHEN CHPASS and return AUTHEN_STATUS_PASS.
flow tacacs_authen_chpass_flow(term_srv, dir_tacacs) {
    term_srv -> dir_tacacs tcp syn srcport 61049 dstport 49
    dir_tacacs -> term_srv tcp syn ack
    term_srv -> dir_tacacs tcp ack
    term_srv -> dir_tacacs tacacs authen sessionid 66012 user "sysadmin" payload "action=CHPASS"
    dir_tacacs -> term_srv tacacs authen sessionid 66012 payload "GETDATA:Old Password: "
    term_srv -> dir_tacacs tacacs authen sessionid 66012 user "sysadmin" payload "OldPass!2025"
    dir_tacacs -> term_srv tacacs authen sessionid 66012 payload "GETPASS:New Password: "
    term_srv -> dir_tacacs tacacs authen sessionid 66012 user "sysadmin" payload "NewPass!2026"
    dir_tacacs -> term_srv tacacs authen sessionid 66012 payload "AUTHEN_STATUS_PASS:Password updated"
}

// INSTRUCTION: Compile the TACACS+ password change flow.
compile {
    tacacs_authen_chpass_flow(term_srv, dir_tacacs)
}
