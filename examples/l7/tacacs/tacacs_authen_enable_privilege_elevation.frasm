// User privilege elevation request to access level 15 exec mode.
// TACACS+ on TCP 49 (authen).
// Wireshark: tacplus

host core_nas { ip 10.0.0.1 }

host policy_aaa { ip 10.0.0.254 }

flow tacacs_enable_flow(c, s) {
    c -> s tacacs type authen user "enable_admin" sessionid 7030
    c <- s tacacs type authen user "enable_admin" sessionid 7030
}

compile {
    tacacs_enable_flow(core_nas, policy_aaa)
}
