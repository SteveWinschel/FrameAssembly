// Model a TACACS+ MSCHAPv2 remote-access VPN concentrator authentication
// session over MPLS label 4900.
// Encapsulation and QoS markings: MPLS label 4900.
// TACACS+ on TCP 49 (authen).
// Timing: pauses 6ms after each marked packet before sending the next frame.
// Wireshark: tacplus && mpls

host vpn_concentrator {
    ip 172.28.49.5
    mac 00:25:90:1c:31:05
}

host tacacs_auth_node {
    ip 172.28.49.100
    mac 00:25:90:1c:31:64
}

flow tacacs_mschapv2_mpls(vpn, aaa) {
    vpn -> aaa tacacs type authen seq 1 flags 0 sessionid 883920 user "remote_sre" payload "mschapv2-challenge-response-hash" mpls 4900 exp 5 bos 1 mplsttl 64 wait 6ms
    vpn <- aaa tacacs type authen seq 2 flags 0 sessionid 883920 user "remote_sre" payload "AUTHEN_STATUS_PASS" mpls 4900 exp 5 bos 1 mplsttl 64
}

compile {
    tacacs_mschapv2_mpls(vpn_concentrator, tacacs_auth_node)
}
