// Simulate a single-roundtrip TACACS+ PAP authentication request and PASS
// response using TYPE AUTHEN.
// Encapsulation and QoS markings: DSCP 16.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// TACACS+ on TCP 49 (authen).
// Overrides destination port to 49.
// Wireshark: tacplus

host vpn_nas {
    mac 00:1c:42:00:49:20
    ip 10.20.49.20
}

host id_server {
    mac 00:1c:42:00:49:01
    ip 10.20.49.1
}

flow tacacs_pap_single_roundtrip(vpn_nas, id_server) {
    vpn_nas -> id_server tcp syn srcport 53049 dstport 49 dscp 16
    id_server -> vpn_nas tcp syn ack dscp 16
    vpn_nas -> id_server tcp ack dscp 16
    vpn_nas -> id_server tacacs type authen sessionid 300404 user "vpnuser1" payload "PAP-TOKEN-998877" dscp 16
    id_server -> vpn_nas tacacs type authen sessionid 300404 payload "AUTHEN_STATUS_PASS" dscp 16
}

compile {
    tacacs_pap_single_roundtrip(vpn_nas, id_server)
}
