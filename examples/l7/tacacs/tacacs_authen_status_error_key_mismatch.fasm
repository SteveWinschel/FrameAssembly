// PROMPT: Generate a TACACS+ shared-secret mismatch error returning TAC_PLUS_AUTHEN_STATUS_ERROR and closing the TCP session.
// TOKENS: HOST, MAC, IP, FLOW, TCP, SYN, SRCPORT, DSTPORT, ACK, TACACS, AUTHEN, SESSION_ID, USER, PAYLOAD, FIN, COMPILE

// INSTRUCTION: Define host endpoint new_switch.
HOST new_switch {
    MAC 00:16:3e:49:60:01
    IP 10.69.1.50
}

// INSTRUCTION: Define host endpoint tacacs_daemon.
HOST tacacs_daemon {
    MAC 00:16:3e:49:60:02
    IP 10.69.1.1
}

// INSTRUCTION: Send a garbled TACACS+ payload due to key mismatch, receive AUTHEN_STATUS_ERROR, and close TCP.
FLOW tacacs_key_mismatch_error(new_switch, tacacs_daemon) {
    new_switch -> tacacs_daemon TCP SYN SRCPORT 62049 DSTPORT 49
    tacacs_daemon -> new_switch TCP SYN ACK
    new_switch -> tacacs_daemon TCP ACK
    new_switch -> tacacs_daemon TACACS AUTHEN SESSION_ID 11999 USER "admin" PAYLOAD "CORRUPTED-MD5-PAD-BODY"
    tacacs_daemon -> new_switch TACACS AUTHEN SESSION_ID 11999 PAYLOAD "AUTHEN_STATUS_ERROR:Invalid packet length or shared secret mismatch"
    tacacs_daemon -> new_switch TCP FIN ACK
    new_switch -> tacacs_daemon TCP FIN ACK
    tacacs_daemon -> new_switch TCP ACK
}

// INSTRUCTION: Compile the TACACS+ shared secret error flow.
COMPILE {
    tacacs_key_mismatch_error(new_switch, tacacs_daemon)
}
