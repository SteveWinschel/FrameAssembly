// Generate a TACACS+ shared-secret mismatch error returning
// TAC_PLUS_AUTHEN_STATUS_ERROR and closing the TCP session.
// Includes explicit TCP 3-way handshake and session teardown with tracked
// seq/ack counters.
// TACACS+ on TCP 49 (authen).
// Overrides destination port to 49.
// Wireshark: tacplus

host new_switch {
    mac 00:16:3e:49:60:01
    ip 10.69.1.50
}

host tacacs_daemon {
    mac 00:16:3e:49:60:02
    ip 10.69.1.1
}

flow tacacs_key_mismatch_error(new_switch, tacacs_daemon) {
    new_switch -> tacacs_daemon tcp syn srcport 62049 dstport 49
    tacacs_daemon -> new_switch tcp syn ack
    new_switch -> tacacs_daemon tcp ack
    new_switch -> tacacs_daemon tacacs authen sessionid 11999 user "admin" payload "CORRUPTED-MD5-PAD-BODY"
    tacacs_daemon -> new_switch tacacs authen sessionid 11999 payload "AUTHEN_STATUS_ERROR:Invalid packet length or shared secret mismatch"
    tacacs_daemon -> new_switch tcp fin ack
    new_switch -> tacacs_daemon tcp fin ack
    tacacs_daemon -> new_switch tcp ack
}

compile {
    tacacs_key_mismatch_error(new_switch, tacacs_daemon)
}
