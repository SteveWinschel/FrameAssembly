// Simulate a TACACS+ authorization request and response permitting BGP
// route-map modification on a core router.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// TACACS+ on TCP 49 (author; flags 1 keeps TACACS+ unencrypted for cleartext
// Wireshark inspection).
// Overrides destination port to 49.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: tacplus

host bgp_core_nas {
    ip 10.240.1.10
    mac 00:1b:21:f0:01:0a
}

host tacacs_policy_srv {
    ip 10.240.1.200
    mac 00:1b:21:f0:01:c8
}

flow tacacs_bgp_policy_author(nas, srv) {
    nas -> srv tcp syn srcport 52049 dstport 49
    nas <- srv tcp syn ack
    nas -> srv tcp ack
    nas -> srv tacacs type author seq 1 flags 1 sessionid 774101 user "routing_eng" payload "service=shell:cmd=route-map:cmd-arg=PEER-IN" wait 4ms
    nas <- srv tacacs type author seq 2 flags 1 sessionid 774101 user "routing_eng" payload "AUTHOR_STATUS_PASS_ADD"
}

compile {
    tacacs_bgp_policy_author(bgp_core_nas, tacacs_policy_srv)
}
