// PROMPT: Generate a TACACS+ command authorization (AUTHOR) check denying a dangerous reload command to a junior operator.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, tacacs, type, author, sessionid, user, payload, compile

// INSTRUCTION: Define host endpoint core_sw.
host core_sw {
    mac 00:25:90:00:49:30
    ip 10.30.49.30
}

// INSTRUCTION: Define host endpoint policy_tacacs.
host policy_tacacs {
    mac 00:25:90:00:49:01
    ip 10.30.49.1
}

// INSTRUCTION: Request command authorization for 'reload' and receive AUTHOR_STATUS_FAIL.
flow tacacs_author_command_denied(core_sw, policy_tacacs) {
    core_sw -> policy_tacacs tcp syn srcport 54049 dstport 49
    policy_tacacs -> core_sw tcp syn ack
    core_sw -> policy_tacacs tcp ack
    core_sw -> policy_tacacs tacacs type author sessionid 400505 user "jr_noc" payload "service=shell:cmd=reload:cmd-arg=<cr>"
    policy_tacacs -> core_sw tacacs type author sessionid 400505 payload "AUTHOR_STATUS_FAIL:Command not permitted for role=readonly"
}

// INSTRUCTION: Compile the TACACS+ command authorization denial flow.
compile {
    tacacs_author_command_denied(core_sw, policy_tacacs)
}
