// Command authorization denying non-admin request to reload hardware.
// TACACS+ on TCP 49 (author).
// Wireshark: tacplus

host branch_sw { ip 192.168.40.5 }

host aaa_cluster { ip 192.168.40.1 }

flow tacacs_deny_flow(c, s) {
    c -> s tacacs type author user "junior_tech" sessionid 9050
    c <- s tacacs type author user "junior_tech" sessionid 9050
}

compile {
    tacacs_deny_flow(branch_sw, aaa_cluster)
}
