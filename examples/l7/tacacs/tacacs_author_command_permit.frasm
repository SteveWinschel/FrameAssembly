// Command authorization verifying permission to run show running-config.
// TACACS+ on TCP 49 (author).
// Wireshark: tacplus

host dc_switch { ip 10.150.1.20 }

host author_engine { ip 10.150.1.1 }

flow tacacs_permit_flow(c, s) {
    c -> s tacacs type author user "auditor" sessionid 8040
    c <- s tacacs type author user "auditor" sessionid 8040
}

compile {
    tacacs_permit_flow(dc_switch, author_engine)
}
