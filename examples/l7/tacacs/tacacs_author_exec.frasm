// TACACS+ command authorization request over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// TACACS+ on TCP 49 (author).
// Wireshark: tacplus

host client { ip 2001:db8::5 }

host server { ip 2001:db8::1 }

flow tacacs_author(c, s) {
    c -> s tacacs type author user "network_admin" sessionid 2002
}

compile {
    tacacs_author(client, server)
}
