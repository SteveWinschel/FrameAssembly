// Authorization check for interface configuration command parameters.
// TACACS+ on TCP 49 (author).
// Wireshark: tacplus

host perim_rtr { ip 172.24.10.1 }

host policy_host { ip 172.24.10.200 }

flow tacacs_iface_flow(c, s) {
    c -> s tacacs type author user "secops_eng" sessionid 10060
    c <- s tacacs type author user "secops_eng" sessionid 10060
}

compile {
    tacacs_iface_flow(perim_rtr, policy_host)
}
