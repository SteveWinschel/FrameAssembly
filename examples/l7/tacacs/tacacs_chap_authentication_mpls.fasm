// PROMPT: Generate a TACACS+ CHAP authentication exchange over MPLS label 1049 between a WAN PE router and central AAA server.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, mpls, ack, tacacs, authen, sessionid, user, payload, compile

// INSTRUCTION: Define host endpoint pe_router.
host pe_router {
    mac 00:1a:a0:49:20:01
    ip 10.249.1.1
}

// INSTRUCTION: Define host endpoint central_aaa.
host central_aaa {
    mac 00:1a:a0:49:20:99
    ip 10.249.1.99
}

// INSTRUCTION: Perform TACACS+ CHAP authentication over MPLS label 1049.
flow tacacs_chap_auth_mpls(pe_router, central_aaa) {
    pe_router -> central_aaa tcp syn srcport 58049 dstport 49 mpls 1049
    central_aaa -> pe_router tcp syn ack mpls 1049
    pe_router -> central_aaa tcp ack mpls 1049
    pe_router -> central_aaa tacacs authen sessionid 91500 user "wan_eng" payload "CHAP-ID=01:CHALLENGE=a1b2c3d4:DIGEST=9988776655443322" mpls 1049
    central_aaa -> pe_router tacacs authen sessionid 91500 payload "AUTHEN_STATUS_PASS" mpls 1049
}

// INSTRUCTION: Compile the MPLS-labeled TACACS+ CHAP authentication flow.
compile {
    tacacs_chap_auth_mpls(pe_router, central_aaa)
}
