// Minimal 2-block TACACS+ starter sending a default authentication packet on TCP port 49.
// Uses unencrypted flags (0x01) by default so Wireshark dissects fields cleanly.
// Compile to verify AAA firewall reachability and TACACS+ parser rules.
// Wireshark: tacplus

host core_switch { ip 10.60.1.10  mac 00:50:56:49:00:0a }
host tacacs_srv  { ip 10.60.1.200 mac 00:50:56:49:00:c8 }

compile {
    core_switch -> tacacs_srv tacacs
}
