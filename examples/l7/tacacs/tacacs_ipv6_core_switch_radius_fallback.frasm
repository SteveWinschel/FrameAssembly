// IPv6 core switch authenticating operator credentials via TACACS+.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// TACACS+ on TCP 49 (authen).
// Wireshark: tacplus

host switch_v6 { ip 2001:db8:7777::10 }

host tacacs_v6_svr { ip 2001:db8:7777::1 }

flow tacacs_v6_flow(c, s) {
    c -> s tacacs type authen user "ipv6_operator" sessionid 14100
    c <- s tacacs type authen user "ipv6_operator" sessionid 14100
}

compile {
    tacacs_v6_flow(switch_v6, tacacs_v6_svr)
}
