// PROMPT: Simulate a complete AAA lifecycle (Authentication, Authorization, and Accounting) over IPv6 between a router and TACACS+ server.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, tacacs, authen, sessionid, user, payload, author, acct, compile

// INSTRUCTION: Define host endpoint rtr_v6.
host rtr_v6 {
    mac 00:50:56:b6:49:01
    ip 2001:db8:49:1::10
}

// INSTRUCTION: Define host endpoint tacacs_v6.
host tacacs_v6 {
    mac 00:50:56:b6:49:99
    ip 2001:db8:49:1::99
}

// INSTRUCTION: Execute AUTHEN, AUTHOR, and ACCT sequentially over IPv6 TCP port 49.
flow tacacs_ipv6_full_aaa_cycle(rtr_v6, tacacs_v6) {
    rtr_v6 -> tacacs_v6 tcp syn srcport 55049 dstport 49
    tacacs_v6 -> rtr_v6 tcp syn ack
    rtr_v6 -> tacacs_v6 tcp ack
    rtr_v6 -> tacacs_v6 tacacs authen sessionid 6001 user "neteng" payload "LOGIN-V6"
    tacacs_v6 -> rtr_v6 tacacs authen sessionid 6001 payload "AUTHEN_STATUS_PASS"
    rtr_v6 -> tacacs_v6 tacacs author sessionid 6002 user "neteng" payload "service=shell:priv-lvl=15"
    tacacs_v6 -> rtr_v6 tacacs author sessionid 6002 payload "AUTHOR_STATUS_PASS_ADD:priv-lvl=15"
    rtr_v6 -> tacacs_v6 tacacs acct sessionid 6003 user "neteng" payload "flags=START:service=shell"
    tacacs_v6 -> rtr_v6 tacacs acct sessionid 6003 payload "ACCT_STATUS_SUCCESS"
}

// INSTRUCTION: Compile the IPv6 full AAA TACACS+ flow.
compile {
    tacacs_ipv6_full_aaa_cycle(rtr_v6, tacacs_v6)
}
