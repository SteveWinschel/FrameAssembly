// PROMPT: Simulate a TACACS+ authorization session assigning a BGP VRF and read-only role over QinQ (S-VLAN 700, C-VLAN 49).
// TOKENS: HOST, MAC, IP, FLOW, TCP, SYN, SRCPORT, DSTPORT, QINQ, INNER_VLAN, ACK, TACACS, AUTHOR, SESSION_ID, USER, PAYLOAD, COMPILE

// INSTRUCTION: Define host endpoint metro_rtr.
HOST metro_rtr {
    MAC 00:26:b9:49:70:01
    IP 10.79.49.10
}

// INSTRUCTION: Define host endpoint metro_aaa.
HOST metro_aaa {
    MAC 00:26:b9:49:70:02
    IP 10.79.49.1
}

// INSTRUCTION: Request VRF shell authorization over QinQ 700/49 and receive AV-pair attributes.
FLOW tacacs_qinq_vrf_authorization(metro_rtr, metro_aaa) {
    metro_rtr -> metro_aaa TCP SYN SRCPORT 63049 DSTPORT 49 QINQ 700 INNER_VLAN 49
    metro_aaa -> metro_rtr TCP SYN ACK QINQ 700 INNER_VLAN 49
    metro_rtr -> metro_aaa TCP ACK QINQ 700 INNER_VLAN 49
    metro_rtr -> metro_aaa TACACS AUTHOR SESSION_ID 44800 USER "peering_ops" PAYLOAD "service=shell:cmd=*" QINQ 700 INNER_VLAN 49
    metro_aaa -> metro_rtr TACACS AUTHOR SESSION_ID 44800 PAYLOAD "AUTHOR_STATUS_PASS_ADD:priv-lvl=7:vrf=PEERING-VRF" QINQ 700 INNER_VLAN 49
}

// INSTRUCTION: Compile the QinQ TACACS+ VRF authorization flow.
COMPILE {
    tacacs_qinq_vrf_authorization(metro_rtr, metro_aaa)
}
