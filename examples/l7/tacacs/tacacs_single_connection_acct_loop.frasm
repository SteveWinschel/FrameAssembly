// Simulate a TACACS+ single-connection multiplexing multiple sequential
// command accounting (ACCT) records across repeated cycles.
// Starts with a TCP 3-way handshake; the compiler tracks seq/ack numbers into
// the session.
// TACACS+ on TCP 49 (acct).
// Overrides destination port to 49.
// Timing: runs 4 cycles in compile using post-packet waits (15ms).
// Wireshark: tacplus

host mux_router {
    mac 00:21:5a:49:10:01
    ip 10.149.1.10
}

host mux_tacacs {
    mac 00:21:5a:49:10:02
    ip 10.149.1.20
}

flow tacacs_single_conn_acct_loop_init(mux_router, mux_tacacs) {
    mux_router -> mux_tacacs tcp syn srcport 57049 dstport 49
    mux_tacacs -> mux_router tcp syn ack
    mux_router -> mux_tacacs tcp ack
}

flow tacacs_single_conn_acct_loop(mux_router, mux_tacacs) {
    mux_router -> mux_tacacs tacacs type acct sessionid 82000 user "automation_bot" payload "cmd=show ip bgp summary"
    mux_tacacs -> mux_router tacacs type acct sessionid 82000 payload "ACCT_STATUS_SUCCESS" wait 15ms
}

compile {
    tacacs_single_conn_acct_loop_init(mux_router, mux_tacacs)
    tacacs_single_conn_acct_loop(mux_router, mux_tacacs) // cycle 1
    tacacs_single_conn_acct_loop(mux_router, mux_tacacs) // cycle 2
    tacacs_single_conn_acct_loop(mux_router, mux_tacacs) // cycle 3
}
