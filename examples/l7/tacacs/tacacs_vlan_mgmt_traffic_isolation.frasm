// Out-of-band management VLAN 99 tagged TACACS+ session with CS6 priority.
// Encapsulation and QoS markings: 802.1Q VLAN 99, 802.1p priority 6, DSCP 48.
// TACACS+ on TCP 49 (authen).
// Wireshark: tacplus && vlan.id == 99

host mgmt_switch { ip 10.99.0.15 }

host mgmt_aaa { ip 10.99.0.1 }

flow tacacs_mgmt_vlan_flow(c, s) {
    c -> s tacacs type authen user "oob_admin" sessionid 15110
        vlan 99 pcp 6 dei 0 dscp 48
    c <- s tacacs type authen user "oob_admin" sessionid 15110
        vlan 99 pcp 6 dei 0 dscp 48
}

compile {
    tacacs_mgmt_vlan_flow(mgmt_switch, mgmt_aaa)
}
