// Management station sending show version command string to switch CLI.
// Telnet on TCP 23.
// Wireshark: telnet

host noc_admin { ip 172.22.4.18 }

host target_router { ip 172.22.4.1 }

flow telnet_show_ver_flow(c, s) {
    c -> s telnet payload "show version\r\n"
    c <- s telnet payload "Cisco IOS Software, C2960 Software, Version 15.2(2)E\r\n"
}

compile {
    telnet_show_ver_flow(noc_admin, target_router)
}
