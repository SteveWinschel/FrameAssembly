// Minimal 2-block Telnet starter emitting a default RFC 854 frame on TCP port 23.
// Tracks TCP sequence numbers directly inside the compile block without a flow wrapper.
// Useful for triggering cleartext management tripwires in Suricata or Zeek.
// Wireshark: telnet

host jump_client   { ip 10.50.1.101 mac 00:1a:2b:23:00:65 }
host legacy_switch { ip 10.50.1.2   mac 00:1a:2b:23:00:02 }

compile {
    jump_client -> legacy_switch telnet
}
