// Server rejecting terminal speed subnegotiation with IAC DONT 32.
// Telnet on TCP 23 negotiating option(s): 32.
// Wireshark: telnet

host legacy_client { ip 192.168.12.9 }

host term_concentrator { ip 192.168.12.2 }

flow telnet_speed_reject_flow(c, s) {
    c -> s telnet will 32
    c <- s telnet dont 32
}

compile {
    telnet_speed_reject_flow(legacy_client, term_concentrator)
}
