// PROMPT: Simulate a Telnet Echo (Option 1) and Suppress Go Ahead (Option 3) negotiation for character-at-a-time full-duplex mode.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, telnet, will, do, payload, compile

// INSTRUCTION: Define host endpoint term_client.
host term_client {
    mac 00:50:56:00:23:01
    ip 10.10.23.50
}

// INSTRUCTION: Define host endpoint unix_telnetd.
host unix_telnetd {
    mac 00:50:56:00:23:02
    ip 10.10.23.1
}

// INSTRUCTION: Complete TCP port 23 handshake, negotiate Suppress Go Ahead (3) and Echo (1), and send banner.
flow telnet_echo_sga_negotiation(term_client, unix_telnetd) {
    term_client -> unix_telnetd tcp syn srcport 51023 dstport 23
    unix_telnetd -> term_client tcp syn ack
    term_client -> unix_telnetd tcp ack
    unix_telnetd -> term_client telnet will 3
    term_client -> unix_telnetd telnet do 3
    unix_telnetd -> term_client telnet will 1
    term_client -> unix_telnetd telnet do 1
    unix_telnetd -> term_client telnet payload "SunOS 5.10\r\nlogin: "
}

// INSTRUCTION: Compile the Telnet Echo and SGA option negotiation flow.
compile {
    telnet_echo_sga_negotiation(term_client, unix_telnetd)
}
