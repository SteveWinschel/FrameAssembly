// Telnet IAC WILL 1 and IAC DO 1 local character echo negotiation.
// Telnet on TCP 23 negotiating option(s): 1 (Echo).
// Wireshark: telnet

host user_term { ip 192.168.1.15 }

host telnet_host { ip 192.168.1.1 }

flow telnet_echo_negotiate(c, s) {
    c -> s telnet will 1
    c <- s telnet do 1
    c <- s telnet will 1
    c -> s telnet do 1
}

compile {
    telnet_echo_negotiate(user_term, telnet_host)
}
