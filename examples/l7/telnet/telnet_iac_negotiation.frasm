// Telnet protocol option negotiation using IAC commands on TCP 23.
// Telnet on TCP 23 negotiating option(s): 1 (Echo).
// Wireshark: telnet

host telnet_client { ip 172.16.0.10 }

host telnet_server { ip 172.16.0.1 }

flow telnet_session(c, s) {
    c -> s telnet do 1
    c <- s telnet will 1
}

compile {
    telnet_session(telnet_client, telnet_server)
}
