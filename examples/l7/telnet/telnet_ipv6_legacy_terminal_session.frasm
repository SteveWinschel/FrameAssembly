// IPv6 terminal session negotiating character echo on port 23.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Telnet on TCP 23 negotiating option(s): 1 (Echo).
// Wireshark: telnet

host term_v6_client { ip 2001:db8:beef::20 }

host term_v6_server { ip 2001:db8:beef::1 }

flow telnet_v6_echo_flow(c, s) {
    c -> s telnet do 1
    c <- s telnet will 1
}

compile {
    telnet_v6_echo_flow(term_v6_client, term_v6_server)
}
