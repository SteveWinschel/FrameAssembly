// PROMPT: Simulate an IPv6 Telnet session to an out-of-band console server executing 'show version' and logging out.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, telnet, will, do, payload, fin, compile

// INSTRUCTION: Define host endpoint noc_v6.
host noc_v6 {
    mac 00:50:56:b6:23:01
    ip 2001:db8:23:1::10
}

// INSTRUCTION: Define host endpoint console_v6.
host console_v6 {
    mac 00:50:56:b6:23:99
    ip 2001:db8:23:1::99
}

// INSTRUCTION: Connect over IPv6 TCP 23, authenticate, run 'show version', and exit cleanly.
flow telnet_ipv6_console_session(noc_v6, console_v6) {
    noc_v6 -> console_v6 tcp syn srcport 55023 dstport 23
    console_v6 -> noc_v6 tcp syn ack
    noc_v6 -> console_v6 tcp ack
    console_v6 -> noc_v6 telnet will 1
    noc_v6 -> console_v6 telnet do 1
    console_v6 -> noc_v6 telnet payload "Username: admin\r\nRouter> "
    noc_v6 -> console_v6 telnet payload "show version\r\n"
    console_v6 -> noc_v6 telnet payload "IOS Software, Version 15.9(3)M8\r\nRouter> "
    noc_v6 -> console_v6 telnet payload "exit\r\n"
    noc_v6 -> console_v6 tcp fin ack
    console_v6 -> noc_v6 tcp fin ack
    noc_v6 -> console_v6 tcp ack
}

// INSTRUCTION: Compile the IPv6 Telnet router CLI session flow.
compile {
    telnet_ipv6_console_session(noc_v6, console_v6)
}
