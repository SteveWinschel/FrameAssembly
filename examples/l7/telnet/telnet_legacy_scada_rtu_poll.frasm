// Legacy industrial RTU serial-to-ethernet console telemetry query.
// Telnet on TCP 23.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (Telnet
// (RFC 854), TCP 23).
// Wireshark: telnet

host scada_poller { ip 10.12.34.50 }

host scada_rtu { ip 10.12.34.1 }

flow telnet_rtu_flow(c, s) {
    c -> s telnet payload "READ STATUS\r\n"
    c <- s telnet payload "STATUS=OK VOLT=24.2 CURRENT=1.4A\r\n"
}

compile {
    telnet_rtu_flow(scada_poller, scada_rtu)
}
