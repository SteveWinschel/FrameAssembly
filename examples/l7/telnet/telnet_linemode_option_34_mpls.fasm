// PROMPT: Generate a Telnet Linemode (Option 34, RFC 1184) negotiation over a high-latency satellite MPLS link (MPLS 2300).
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, mpls, ack, telnet, do, will, wont, payload, compile

// INSTRUCTION: Define host endpoint sat_terminal.
host sat_terminal {
    mac 00:21:5a:00:23:34
    ip 10.230.1.10
}

// INSTRUCTION: Define host endpoint hq_gateway.
host hq_gateway {
    mac 00:21:5a:00:23:01
    ip 10.230.1.1
}

// INSTRUCTION: Enable Telnet Linemode (Option 34) and disable server Echo (Option 1) over MPLS 2300.
flow telnet_linemode_satellite_mpls(sat_terminal, hq_gateway) {
    sat_terminal -> hq_gateway tcp syn srcport 58023 dstport 23 mpls 2300
    hq_gateway -> sat_terminal tcp syn ack mpls 2300
    sat_terminal -> hq_gateway tcp ack mpls 2300
    hq_gateway -> sat_terminal telnet do 34 mpls 2300
    sat_terminal -> hq_gateway telnet will 34 mpls 2300
    hq_gateway -> sat_terminal telnet wont 1 mpls 2300
    sat_terminal -> hq_gateway telnet payload "show interfaces brief\r\n" mpls 2300
    hq_gateway -> sat_terminal telnet payload "Gi0/0  10.230.1.1  YES  up  up\r\n" mpls 2300
}

// INSTRUCTION: Compile the Telnet Linemode Option 34 MPLS flow.
compile {
    telnet_linemode_satellite_mpls(sat_terminal, hq_gateway)
}
