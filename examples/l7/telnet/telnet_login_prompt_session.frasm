// PROMPT: Telnet terminal session option negotiation over IPv6.
// TOKENS: host, ip, flow, s, telnet, do, will, dont, wont, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::10 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow telnet_login(c, s) {
    c <- s telnet do 1
    c -> s telnet will 1
    c <- s telnet dont 3
    c -> s telnet wont 3
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    telnet_login(client, server)
}
