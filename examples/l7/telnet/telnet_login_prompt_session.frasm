// Telnet terminal session option negotiation over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Telnet on TCP 23 negotiating option(s): 1 (Echo), 3 (Suppress Go Ahead).
// Wireshark: telnet

host client { ip 2001:db8::10 }

host server { ip 2001:db8::1 }

flow telnet_login(c, s) {
    c <- s telnet do 1
    c -> s telnet will 1
    c <- s telnet dont 3
    c -> s telnet wont 3
}

compile {
    telnet_login(client, server)
}
