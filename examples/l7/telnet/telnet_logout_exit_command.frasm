// Administrative user sending exit command data to close telnet terminal.
// Telnet on TCP 23.
// Wireshark: telnet

host departing_op { ip 192.168.60.25 }

host active_rtr { ip 192.168.60.1 }

flow telnet_exit_flow(c, s) {
    c -> s telnet payload "exit\r\n"
    c <- s telnet payload "Connection closed by foreign host.\r\n"
}

compile {
    telnet_exit_flow(departing_op, active_rtr)
}
