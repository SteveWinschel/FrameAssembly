// Core router presenting password challenge string to connected client.
// Telnet on TCP 23.
// Wireshark: telnet

host field_eng { ip 192.168.20.100 }

host dist_switch { ip 192.168.20.1 }

flow telnet_password_prompt(c, s) {
    c <- s telnet payload "User Access Verification\r\nPassword: "
    c -> s telnet payload "cisco123\r\n"
}

compile {
    telnet_password_prompt(field_eng, dist_switch)
}
