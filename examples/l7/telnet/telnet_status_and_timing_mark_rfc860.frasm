// PROMPT: Model a Telnet Status (Option 5, RFC 859) and Timing Mark (Option 6, RFC 860) synchronization probe.
// TOKENS: host, mac, ip, flow, tcp, syn, srcport, dstport, ack, telnet, do, will, payload, compile

// INSTRUCTION: Define host endpoint probe_client.
host probe_client {
    mac 00:24:e8:00:23:05
    ip 192.168.55.10
}

// INSTRUCTION: Define host endpoint remote_host.
host remote_host {
    mac 00:24:e8:00:23:06
    ip 192.168.55.20
}

// INSTRUCTION: Negotiate Option 5 (Status) and Option 6 (Timing Mark) to synchronize output flush.
flow telnet_status_and_timing_mark(probe_client, remote_host) {
    probe_client -> remote_host tcp syn srcport 60023 dstport 23
    remote_host -> probe_client tcp syn ack
    probe_client -> remote_host tcp ack
    probe_client -> remote_host telnet do 5
    remote_host -> probe_client telnet will 5
    probe_client -> remote_host telnet do 6
    remote_host -> probe_client telnet will 6
    remote_host -> probe_client telnet payload "TIMING-MARK-SYNC-COMPLETE\r\n"
}

// INSTRUCTION: Compile the Telnet Status and Timing Mark flow.
compile {
    telnet_status_and_timing_mark(probe_client, remote_host)
}
