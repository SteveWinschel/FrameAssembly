// Telnet IAC WILL 3 and IAC DO 3 suppress go ahead transmission mode.
// Telnet on TCP 23 negotiating option(s): 3 (Suppress Go Ahead).
// Wireshark: telnet

host console_ws { ip 10.10.5.20 }

host gw_term { ip 10.10.5.1 }

flow telnet_sga_flow(c, s) {
    c -> s telnet will 3
    c <- s telnet do 3
    c <- s telnet will 3
    c -> s telnet do 3
}

compile {
    telnet_sga_flow(console_ws, gw_term)
}
