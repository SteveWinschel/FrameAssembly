// Network switch presenting Message of the Day security warning banner.
// Telnet on TCP 23.
// Wireshark: telnet

host oper_term { ip 10.75.1.40 }

host edge_sw_dev { ip 10.75.1.1 }

flow telnet_motd_flow(c, s) {
    c <- s telnet payload "Authorized Personnel Only. Violators will be prosecuted.\r\n"
    c <- s telnet payload "Switch-01> "
}

compile {
    telnet_motd_flow(oper_term, edge_sw_dev)
}
