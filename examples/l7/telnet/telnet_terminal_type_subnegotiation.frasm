// Telnet IAC terminal option negotiation offering DO and WILL requests.
// Telnet on TCP 23 negotiating option(s): 24 (Terminal-Type), 32.
// Wireshark: telnet

host client { ip 10.0.0.100 }

host server { ip 10.0.0.1 }

flow telnet_subneg(c, s) {
    c -> s telnet do 24
    c <- s telnet will 24
    c -> s telnet dont 32
    c <- s telnet wont 32
}

compile {
    telnet_subneg(client, server)
}
