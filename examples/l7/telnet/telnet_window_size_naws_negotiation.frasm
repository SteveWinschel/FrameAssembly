// Negotiate About Window Size option negotiation using IAC DO 31.
// Telnet on TCP 23 negotiating option(s): 31 (NAWS).
// Wireshark: telnet

host gui_term { ip 172.16.8.50 }

host unix_main { ip 172.16.8.1 }

flow telnet_naws_flow(c, s) {
    c <- s telnet do 31
    c -> s telnet will 31
}

compile {
    telnet_naws_flow(gui_term, unix_main)
}
