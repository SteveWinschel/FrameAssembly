// Client declining linemode operation using IAC WONT 34.
// Telnet on TCP 23 negotiating option(s): 34 (Linemode).
// Wireshark: telnet

host dumb_term { ip 10.30.0.14 }

host timeshare_host { ip 10.30.0.1 }

flow telnet_linemode_flow(c, s) {
    c <- s telnet do 34
    c -> s telnet wont 34
}

compile {
    telnet_linemode_flow(dumb_term, timeshare_host)
}
