// Automated configuration backup trigger loop across multiple network
// switches.
// Executes 3 sequential flow runs inside the compile block.
// Wireshark: tftp

host orch_client { ip 172.28.1.10 }

host store_tftp { ip 172.28.1.1 }

flow tftp_loop_backup(c, s) {
    c -> s tftp wrq
        filename "switch_config_batch.cfg"
        mode "octet"
}

compile {
    tftp_loop_backup(orch_client, store_tftp) // cycle 1
    tftp_loop_backup(orch_client, store_tftp) // cycle 2
    tftp_loop_backup(orch_client, store_tftp) // cycle 3
}
