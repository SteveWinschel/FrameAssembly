// PROMPT: Default TFTP frame emission over UDP port 69 using automatic protocol defaults.
// TOKENS: host, ip, mac, flow, s, tftp, compile

// INSTRUCTION: Define provisioning client host requesting TFTP service.
host tftp_client_node {
    ip 10.69.1.10
    mac 00:1a:2b:69:01:0a
}

// INSTRUCTION: Define network boot TFTP server host.
host tftp_server_node {
    ip 10.69.1.1
    mac 00:1a:2b:69:01:01
}

// INSTRUCTION: Emit a default TFTP protocol frame with automatic header defaults.
flow tftp_default_flow(c, s) {
    c -> s tftp
}

// INSTRUCTION: Compile the default TFTP frame scenario.
compile {
    tftp_default_flow(tftp_client_node, tftp_server_node)
}
