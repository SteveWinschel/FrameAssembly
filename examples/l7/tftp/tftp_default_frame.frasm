// Minimal 2-block TFTP (RFC 1350) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host tftp_client_node {
    ip 10.69.1.10
    mac 00:1a:2b:69:01:0a
}

host tftp_server_node {
    ip 10.69.1.1
    mac 00:1a:2b:69:01:01
}

compile {
    tftp_client_node -> tftp_server_node tftp
}
