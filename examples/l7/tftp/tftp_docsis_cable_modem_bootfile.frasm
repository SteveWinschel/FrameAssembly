// PROMPT: DOCSIS cable modem requesting its binary QoS configuration bootfile over a carrier QinQ access network.
// TOKENS: host, ip, mac, flow, head, tftp, rrq, filename, mode, qinq, innervlan, data, block, hexpayload, ack, compile

// INSTRUCTION: Define subscriber DOCSIS cable modem management interface.
host cable_modem {
    ip 10.220.44.19
    mac 00:1d:d4:44:00:13
}

// INSTRUCTION: Define MSO headend DOCSIS TFTP boot server.
host mso_tftp_headend {
    ip 10.220.0.5
    mac 00:1d:d4:00:00:05
}

// INSTRUCTION: Download DOCSIS binary profile encapsulated in QinQ outer VLAN 500 and inner VLAN 44.
flow tftp_docsis_boot(cm, head) {
    cm -> head tftp rrq filename "docsis31-gigabit.cm" mode "octet" qinq 500 innervlan 44
    cm <- head tftp data block 1 qinq 500 innervlan 44 hexpayload "03010104020001"
    cm -> head tftp ack block 1 qinq 500 innervlan 44
}

// INSTRUCTION: Compile the DOCSIS cable modem QinQ TFTP bootfile scenario.
compile {
    tftp_docsis_boot(cable_modem, mso_tftp_headend)
}
