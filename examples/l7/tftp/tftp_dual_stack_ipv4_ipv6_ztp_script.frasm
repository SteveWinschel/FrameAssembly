// PROMPT: Zero-Touch Provisioning (ZTP) Python script download via TFTP executed across IPv4 and IPv6 leaf switches.
// TOKENS: host, ip, flow, tftp, rrq, filename, mode, data, block, payload, ack, compile

// INSTRUCTION: Define IPv4 unprovisioned leaf switch.
host ztp_leaf_v4 { ip 10.254.1.101 }

// INSTRUCTION: Define IPv4 ZTP TFTP server.
host ztp_srv_v4 { ip 10.254.1.1 }

// INSTRUCTION: Define IPv6 unprovisioned leaf switch.
host ztp_leaf_v6 { ip 2001:db8:69:1::101 }

// INSTRUCTION: Define IPv6 ZTP TFTP server.
host ztp_srv_v6 { ip 2001:db8:69:1::1 }

// INSTRUCTION: Define polymorphic ZTP provisioning script download flow.
flow tftp_ztp_fetch(leaf, srv) {
    leaf -> srv tftp rrq filename "ztp_bootstrap.py" mode "octet"
    leaf <- srv tftp data block 1 payload "#!/usr/bin/env python3"
    leaf -> srv tftp ack block 1
}

// INSTRUCTION: Compile ZTP TFTP bootstrap across both IPv4 and IPv6 switch pairs.
compile {
    tftp_ztp_fetch(ztp_leaf_v4, ztp_srv_v4)
    tftp_ztp_fetch(ztp_leaf_v6, ztp_srv_v6)
}
