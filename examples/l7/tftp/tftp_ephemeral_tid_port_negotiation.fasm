// PROMPT: TFTP RFC 1350 transfer ID (TID) port negotiation switching from UDP port 69 to server ephemeral port 54120.
// TOKENS: host, ip, mac, flow, s, tftp, rrq, filename, mode, srcport, dstport, df, ipid, data, block, payload, ack, compile

// INSTRUCTION: Define PXE client using client TID port 50100.
host pxe_host {
    ip 10.80.69.55
    mac 00:25:90:50:45:37
}

// INSTRUCTION: Define TFTP server responding from server TID port 54120.
host tid_tftp_srv {
    ip 10.80.69.1
    mac 00:25:90:50:45:01
}

// INSTRUCTION: Send RRQ to UDP port 69 and continue DATA/ACK on ephemeral TID 54120.
flow tftp_tid_negotiation(c, s) {
    c -> s tftp rrq filename "grubx64.efi" mode "octet" srcport 50100 dstport 69 df ipid 2001
    c <- s tftp data block 1 srcport 54120 dstport 50100 df ipid 2002 payload "MZ-EFI-BOOTLOADER"
    c -> s tftp ack block 1 srcport 50100 dstport 54120 df ipid 2003
}

// INSTRUCTION: Compile the TFTP ephemeral TID port negotiation scenario.
compile {
    tftp_tid_negotiation(pxe_host, tid_tftp_srv)
}
