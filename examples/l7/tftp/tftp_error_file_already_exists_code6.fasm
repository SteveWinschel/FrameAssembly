// PROMPT: TFTP server rejecting a WRQ overwrite attempt with RFC 1350 ERRCODE 6 File already exists.
// TOKENS: host, ip, mac, flow, s, tftp, wrq, filename, mode, err, errcode, errmsg, compile

// INSTRUCTION: Define network administrator workstation attempting to overwrite an immutable image.
host admin_wkst {
    ip 192.168.69.40
    mac 00:21:70:69:00:28
}

// INSTRUCTION: Define write-once TFTP golden image server.
host golden_tftp_srv {
    ip 192.168.69.10
    mac 00:21:70:69:00:0a
}

// INSTRUCTION: Reject WRQ for existing golden firmware with ERRCODE 6.
flow tftp_err_code6(c, s) {
    c -> s tftp wrq filename "golden-release-v1.bin" mode "octet"
    c <- s tftp err errcode 6 errmsg "File already exists"
}

// INSTRUCTION: Compile the TFTP ERRCODE 6 file already exists scenario.
compile {
    tftp_err_code6(admin_wkst, golden_tftp_srv)
}
