// TFTP error notification packet indicating file not found over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: tftp

host client { ip 2001:db8::15 }

host server { ip 2001:db8::1 }

flow tftp_err(c, s) {
    c <- s tftp errcode 1 errmsg "File not found"
}

compile {
    tftp_err(client, server)
}
