// TFTP error packet returning ERRCODE 5 Unknown Transfer ID.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host tid_client { ip 192.168.5.7 }

host tid_server { ip 192.168.5.1 }

flow tftp_err_tid_flow(c, s) {
    c <- s tftp errcode 5 errmsg "Unknown transfer ID"
}

compile {
    tftp_err_tid_flow(tid_client, tid_server)
}
