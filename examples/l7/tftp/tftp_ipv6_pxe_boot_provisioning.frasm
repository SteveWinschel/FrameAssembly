// IPv6 enterprise client requesting network bootstrap provisioning file.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: tftp

host uefi_station_v6 { ip 2001:db8:aaaa::30 }

host deploy_tftp_v6 { ip 2001:db8:aaaa::1 }

flow tftp_v6_uefi_flow(c, s) {
    c -> s tftp rrq
        filename "bootx64.efi"
        mode "octet"
}

compile {
    tftp_v6_uefi_flow(uefi_station_v6, deploy_tftp_v6)
}
