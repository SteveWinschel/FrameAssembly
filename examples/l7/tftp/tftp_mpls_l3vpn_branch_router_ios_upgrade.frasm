// Branch router downloading a maintenance OS patch via TFTP across an MPLS
// L3VPN service provider core.
// Encapsulation and QoS markings: MPLS label 4020.
// Wireshark: tftp && mpls

host branch_cpe {
    ip 10.175.20.1
    mac 00:1e:14:af:14:01
}

host noc_tftp_depot {
    ip 10.175.0.10
    mac 00:1e:14:af:00:0a
}

flow tftp_mpls_upgrade(cpe, noc) {
    cpe -> noc tftp rrq filename "isr4300-universalk9.bin" mode "octet" mpls 4020 exp 3 bos 1 mplsttl 60
    cpe <- noc tftp data block 1 mpls 4020 exp 3 bos 1 mplsttl 60 payload "IOS-XE-IMAGE-BLOCK-1"
    cpe -> noc tftp ack block 1 mpls 4020 exp 3 bos 1 mplsttl 60
}

compile {
    tftp_mpls_upgrade(branch_cpe, noc_tftp_depot)
}
