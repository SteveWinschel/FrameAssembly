// Read request downloading router firmware image in octet binary mode.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host upgrading_sw { ip 192.168.1.25 }

host tftp_repo { ip 192.168.1.1 }

flow tftp_fw_flow(c, s) {
    c -> s tftp rrq
        filename "c2960x-universalk9-mz.152-7.E0a.bin"
        mode "octet"
}

compile {
    tftp_fw_flow(upgrading_sw, tftp_repo)
}
