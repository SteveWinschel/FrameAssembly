// Read request downloading PXE network boot loader pxelinux.0.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host pxe_client { ip 172.16.100.45 }

host pxe_tftp_host { ip 172.16.100.1 }

flow tftp_pxe_flow(c, s) {
    c -> s tftp rrq
        filename "pxelinux.0"
        mode "octet"
}

compile {
    tftp_pxe_flow(pxe_client, pxe_tftp_host)
}
