// TFTP Read Request (RRQ) querying remote boot image file in octet mode.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host client { ip 192.168.1.15 }

host server { ip 192.168.1.1 }

flow tftp_read(c, s) {
    c -> s tftp rrq filename "pxelinux.0" mode "octet"
}

compile {
    tftp_read(client, server)
}
