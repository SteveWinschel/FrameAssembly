// Read request downloading startup configuration file in netascii mode.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host prov_rtr { ip 10.20.1.15 }

host cfg_tftp_svr { ip 10.20.1.1 }

flow tftp_cfg_download(c, s) {
    c -> s tftp rrq
        filename "router-startup-config.cfg"
        mode "netascii"
}

compile {
    tftp_cfg_download(prov_rtr, cfg_tftp_svr)
}
