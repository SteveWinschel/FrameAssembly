// PROMPT: Enterprise VoIP IP deskphone downloading its XML SIP provisioning profile over voice VLAN 120.
// TOKENS: host, ip, mac, flow, tftp, rrq, filename, mode, vlan, pcp, dscp, data, block, payload, ack, compile

// INSTRUCTION: Define enterprise IP deskphone on voice VLAN 120.
host ip_deskphone {
    ip 10.120.5.88
    mac 00:04:f2:78:05:58
}

// INSTRUCTION: Define unified communications TFTP provisioning server.
host uc_tftp_srv {
    ip 10.120.1.10
    mac 00:04:f2:78:01:0a
}

// INSTRUCTION: Request SEP MAC XML phone configuration and acknowledge DATA block 1 over VLAN 120.
flow tftp_voip_provision(phone, srv) {
    phone -> srv tftp rrq filename "SEP0004F2780558.cnf.xml" mode "octet" vlan 120 pcp 5 dscp 24
    phone <- srv tftp data block 1 vlan 120 pcp 5 dscp 24 payload "<device><sipProfile/></device>"
    phone -> srv tftp ack block 1 vlan 120 pcp 5 dscp 24
}

// INSTRUCTION: Compile the VoIP deskphone TFTP XML profile provisioning scenario.
compile {
    tftp_voip_provision(ip_deskphone, uc_tftp_srv)
}
