// Write request uploading kernel crash dump file to diagnostic TFTP server.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host crash_host { ip 10.80.4.12 }

host diag_tftp { ip 10.80.4.1 }

flow tftp_crash_upload(c, s) {
    c -> s tftp wrq
        filename "vmcore-panic-20261024.dmp"
        mode "octet"
}

compile {
    tftp_crash_upload(crash_host, diag_tftp)
}
