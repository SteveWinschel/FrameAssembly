// Write request uploading archived network switch configuration backup.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host core_sw_backup { ip 192.168.10.1 }

host archive_tftp { ip 192.168.10.250 }

flow tftp_backup_upload(c, s) {
    c -> s tftp wrq
        filename "core_switch_config_oct2026.tar.gz"
        mode "octet"
}

compile {
    tftp_backup_upload(core_sw_backup, archive_tftp)
}
