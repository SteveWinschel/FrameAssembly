// TFTP Write Request (WRQ) uploading configuration backup file.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TFTP (RFC
// 1350), UDP 69).
// Wireshark: tftp

host client { ip 10.0.0.20 }

host server { ip 10.0.0.1 }

flow tftp_write(c, s) {
    c -> s tftp wrq filename "router-config.bak" mode "octet"
}

compile {
    tftp_write(client, server)
}
