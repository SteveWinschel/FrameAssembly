// TLS alert record signaling rejected certificate validation failure.
// TLS extensions: SNI untrusted.domain.net.
// Includes a TLS fatal alert record over TCP 443.
// Wireshark: tls

host val_client { ip 10.90.14.8 }

host untrusted_server { ip 10.90.14.1 }

flow tls_bad_cert_flow(c, s) {
    c -> s tls clienthello sni "untrusted.domain.net"
    c <- s tls serverhello
    c -> s tls alert
}

compile {
    tls_bad_cert_flow(val_client, untrusted_server)
}
