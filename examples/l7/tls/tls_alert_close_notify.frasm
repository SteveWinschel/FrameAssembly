// TLS session termination delivering encrypted close_notify alert over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Includes a TLS fatal alert record over TCP 443.
// Wireshark: tls

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

flow tls_close(c, s) {
    c -> s tls alert recordversion 0x0303
}

compile {
    tls_close(client, server)
}
