// TLS alert record signaling fatal handshake failure to peer endpoint.
// TLS extensions: SNI hardened.vault.local.
// Includes a TLS fatal alert record over TCP 443.
// Wireshark: tls

host incomp_client { ip 192.168.70.33 }

host strict_sec_svr { ip 192.168.70.1 }

flow tls_handshake_fail_flow(c, s) {
    c -> s tls clienthello sni "hardened.vault.local"
    c <- s tls alert
}

compile {
    tls_handshake_fail_flow(incomp_client, strict_sec_svr)
}
