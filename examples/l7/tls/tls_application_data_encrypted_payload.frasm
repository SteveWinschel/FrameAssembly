// TLS application data record transmitting encrypted secure web payload.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host established_client { ip 192.168.100.4 }

host established_server { ip 192.168.100.1 }

flow tls_app_data_flow(c, s) {
    c -> s tls appdata
    c <- s tls appdata
}

compile {
    tls_app_data_flow(established_client, established_server)
}
