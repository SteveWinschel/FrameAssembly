// Mobile client negotiating TLS_CHACHA20_POLY1305_SHA256 (0x1303) cipher
// suite over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Cipher suite(s): 0x1303 (TLS_CHACHA20_POLY1305_SHA256).
// TLS extensions: SNI m.video.example.org; ALPN h2.
// Timing: pauses 6ms after each marked packet before sending the next frame.
// Wireshark: tls

host mobile_v6 {
    ip 2001:db8:443:1::99
}

host cdn_edge_v6 {
    ip 2001:db8:443:1::1
}

flow tls_chacha20_flow(c, s) {
    c -> s tls clienthello handshakeversion 0x0303 sni "m.video.example.org" ciphersuite 0x1303 alpn "h2" wait 6ms
    c <- s tls serverhello handshakeversion 0x0303 ciphersuite 0x1303 alpn "h2" wait 6ms
    c <- s tls finished wait 6ms
    c -> s tls finished wait 6ms
    c <- s tls appdata
}

compile {
    tls_chacha20_flow(mobile_v6, cdn_edge_v6)
}
