// Client hello offering ALPN h2 application negotiation and SNI domain.
// TLS extensions: SNI api.service.internal; ALPN h2.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host api_consumer { ip 172.16.50.15 }

host api_gateway { ip 172.16.50.1 }

flow tls_alpn_h2_flow(c, s) {
    c -> s tls clienthello
        sni "api.service.internal"
        alpn "h2"
}

compile {
    tls_alpn_h2_flow(api_consumer, api_gateway)
}
