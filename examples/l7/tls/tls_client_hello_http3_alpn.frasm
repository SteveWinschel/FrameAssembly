// Client hello offering ALPN h3 next-generation transport negotiation.
// TLS extensions: SNI cdn.fast-delivery.net; ALPN h3.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host mobile_app { ip 192.168.10.99 }

host cdn_edge { ip 192.168.10.1 }

flow tls_alpn_h3_flow(c, s) {
    c -> s tls clienthello
        sni "cdn.fast-delivery.net"
        alpn "h3"
}

compile {
    tls_alpn_h3_flow(mobile_app, cdn_edge)
}
