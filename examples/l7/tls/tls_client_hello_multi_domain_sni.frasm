// Client hello specifying enterprise internal portal SNI host indicator.
// TLS extensions: SNI portal.corp.internal.net.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host corp_laptop { ip 10.200.5.40 }

host portal_lb { ip 10.200.5.1 }

flow tls_portal_sni_flow(c, s) {
    c -> s tls clienthello
        sni "portal.corp.internal.net"
}

compile {
    tls_portal_sni_flow(corp_laptop, portal_lb)
}
