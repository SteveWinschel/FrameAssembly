// PROMPT: Default TLS record frame with zero sub-keywords over standard HTTPS port 443.
// TOKENS: host, ip, mac, flow, s, tls, compile

// INSTRUCTION: Define HTTPS client workstation with IPv4 and MAC addresses.
host https_client {
    ip 10.20.30.40
    mac 00:11:22:33:44:55
}

// INSTRUCTION: Define TLS web server endpoint with IPv4 and MAC addresses.
host https_server {
    ip 10.20.30.1
    mac 00:11:22:33:44:01
}

// INSTRUCTION: Define baseline flow sending a default TLS record without sub-keywords.
flow tls_default_flow(c, s) {
    c -> s tls
}

// INSTRUCTION: Compile the default zero-subkeyword TLS scenario.
compile {
    tls_default_flow(https_client, https_server)
}
