// PROMPT: Dual-stack TLS 1.3 termination at CDN edge serving both IPv4 and IPv6 client populations.
// TOKENS: host, ip, flow, s, tls, clienthello, sni, alpn, wait, ms, serverhello, ciphersuite, finished, appdata, compile

// INSTRUCTION: Define IPv4 broadband client host.
host client_v4 {
    ip 192.0.2.45
}

// INSTRUCTION: Define IPv4 CDN anycast VIP host.
host cdn_v4 {
    ip 192.0.2.1
}

// INSTRUCTION: Define IPv6 fiber client host.
host client_v6 {
    ip 2001:db8:2::45
}

// INSTRUCTION: Define IPv6 CDN anycast VIP host.
host cdn_v6 {
    ip 2001:db8:2::1
}

// INSTRUCTION: Define reusable TLS handshake and application data exchange.
flow tls_cdn_handshake(c, s) {
    c -> s tls clienthello sni "assets.cdn.example.net" alpn "h2" wait 3ms
    c <- s tls serverhello ciphersuite 0x1301 alpn "h2" wait 3ms
    c -> s tls finished wait 3ms
    c <- s tls appdata
}

// INSTRUCTION: Compile dual-stack IPv4 and IPv6 TLS CDN flows.
compile {
    tls_cdn_handshake(client_v4, cdn_v4)
    tls_cdn_handshake(client_v6, cdn_v6)
}
