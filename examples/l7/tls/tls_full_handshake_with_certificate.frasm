// PROMPT: Complete TLS handshake sequence exercising CLIENT_HELLO, SERVER_HELLO, CERTIFICATE, FINISHED, and APP_DATA.
// TOKENS: host, ip, flow, s, tls, clienthello, recordversion, handshakeversion, sni, alpn, wait, ms, serverhello, ciphersuite, certificate, finished, appdata, payload, compile

// INSTRUCTION: Define enterprise web browser client endpoint.
host browser_ep {
    ip 192.168.10.55
}

// INSTRUCTION: Define e-commerce TLS server endpoint.
host shop_server {
    ip 192.168.10.1
}

// INSTRUCTION: Define full TLS handshake with server certificate presentation and encrypted application data.
flow tls_full_session(c, s) {
    c -> s tls clienthello recordversion 0x0301 handshakeversion 0x0303 sni "shop.corp.example" alpn "h2" wait 5ms
    c <- s tls serverhello recordversion 0x0303 handshakeversion 0x0303 ciphersuite 0x1301 alpn "h2" wait 5ms
    c <- s tls certificate recordversion 0x0303 wait 5ms
    c <- s tls finished recordversion 0x0303 wait 5ms
    c -> s tls finished recordversion 0x0303 wait 5ms
    c -> s tls appdata recordversion 0x0303 payload "ENCRYPTED_HTTP2_HEADERS"
}

// INSTRUCTION: Compile the complete TLS handshake and application data flow.
compile {
    tls_full_session(browser_ep, shop_server)
}
