// PROMPT: gRPC over TLS 1.3 microservice call negotiating h2 ALPN with explicit TCP sequence tracking.
// TOKENS: HOST, IP, FLOW, TLS, CLIENT_HELLO, SNI, CIPHERSUITE, ALPN, SEQ, ACKNUM, WINDOW, WAIT, SERVER_HELLO, FINISHED, APP_DATA, COMPILE

// INSTRUCTION: Define checkout gRPC client pod host.
HOST checkout_pod {
    IP 10.96.10.15
}

// INSTRUCTION: Define inventory gRPC server pod host.
HOST inventory_pod {
    IP 10.96.10.80
}

// INSTRUCTION: Define TLS 1.3 handshake with h2 ALPN and explicit TCP sequence numbers.
FLOW tls_grpc_call(c, s) {
    c -> s TLS CLIENT_HELLO SNI "inventory.svc.cluster.local" CIPHERSUITE 0x1301 ALPN "h2" SEQ 1000 ACKNUM 5000 WINDOW 65535 WAIT 2ms
    c <- s TLS SERVER_HELLO CIPHERSUITE 0x1301 ALPN "h2" SEQ 5000 ACKNUM 1200 WINDOW 65535 WAIT 2ms
    c -> s TLS FINISHED SEQ 1200 ACKNUM 5200 WINDOW 65535 WAIT 2ms
    c -> s TLS APP_DATA SEQ 1260 ACKNUM 5200 WINDOW 65535
}

// INSTRUCTION: Compile the gRPC over TLS microservice flow.
COMPILE {
    tls_grpc_call(checkout_pod, inventory_pod)
}
