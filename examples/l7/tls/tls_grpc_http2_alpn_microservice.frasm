// gRPC over TLS 1.3 microservice call negotiating h2 ALPN with explicit TCP
// sequence tracking.
// Cipher suite(s): 0x1301 (TLS_AES_128_GCM_SHA256).
// TLS extensions: SNI inventory.svc.cluster.local; ALPN h2.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: tls

host checkout_pod {
    ip 10.96.10.15
}

host inventory_pod {
    ip 10.96.10.80
}

flow tls_grpc_call(c, s) {
    c -> s tls clienthello sni "inventory.svc.cluster.local" ciphersuite 0x1301 alpn "h2" seq 1000 acknum 5000 window 65535 wait 2ms
    c <- s tls serverhello ciphersuite 0x1301 alpn "h2" seq 5000 acknum 1200 window 65535 wait 2ms
    c -> s tls finished seq 1200 acknum 5200 window 65535 wait 2ms
    c -> s tls appdata seq 1260 acknum 5200 window 65535
}

compile {
    tls_grpc_call(checkout_pod, inventory_pod)
}
