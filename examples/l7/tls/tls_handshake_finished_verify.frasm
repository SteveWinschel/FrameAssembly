// TLS finished handshake verification record confirming key exchange
// completion.
// TLS extensions: SNI auth.internal.org.
// Wireshark: tls

host auth_client_node { ip 10.115.1.10 }

host auth_server_node { ip 10.115.1.1 }

flow tls_finished_flow(c, s) {
    c -> s tls clienthello sni "auth.internal.org"
    c <- s tls serverhello
    c -> s tls finished
    c <- s tls finished
}

compile {
    tls_finished_flow(auth_client_node, auth_server_node)
}
