// PROMPT: Transport Layer Security 1.3 handshake exchange with SNI server name and ALPN protocol negotiation.
// TOKENS: host, ip, flow, s, tls, clienthello, sni, alpn, serverhello, compile

// INSTRUCTION: Define TLS client establishing secure session.
host tls_client { ip 192.168.1.10 }

// INSTRUCTION: Define TLS web server hosting HTTPS services.
host tls_server { ip 192.168.1.20 }

// INSTRUCTION: Define TLS 1.3 handshake negotiation flow.
flow tls_handshake_flow(c, s) {
    c -> s tls clienthello sni "secure.example.com" alpn "h2"
    c <- s tls serverhello
}

// INSTRUCTION: Compile block executing TLS security handshake.
compile {
    tls_handshake_flow(tls_client, tls_server)
}
