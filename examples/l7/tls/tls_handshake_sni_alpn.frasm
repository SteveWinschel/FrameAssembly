// Transport Layer Security 1.3 handshake exchange with SNI server name and
// ALPN protocol negotiation.
// TLS extensions: SNI secure.example.com; ALPN h2.
// Wireshark: tls

host tls_client { ip 192.168.1.10 }

host tls_server { ip 192.168.1.20 }

flow tls_handshake_flow(c, s) {
    c -> s tls clienthello sni "secure.example.com" alpn "h2"
    c <- s tls serverhello
}

compile {
    tls_handshake_flow(tls_client, tls_server)
}
