// IPv6 mutual TLS handshake exchange between gateway edge nodes.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// TLS extensions: SNI gateway.ipv6-cloud.org.
// Wireshark: tls

host gw_client_v6 { ip 2001:db8:9999::55 }

host gw_server_v6 { ip 2001:db8:9999::1 }

flow tls_v6_gateway_flow(c, s) {
    c -> s tls clienthello sni "gateway.ipv6-cloud.org"
    c <- s tls serverhello
}

compile {
    tls_v6_gateway_flow(gw_client_v6, gw_server_v6)
}
