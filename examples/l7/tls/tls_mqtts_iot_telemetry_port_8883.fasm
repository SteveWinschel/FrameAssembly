// PROMPT: Industrial IoT sensor gateway establishing MQTTS session on TCP port 8883 with ALPN mqtt.
// TOKENS: HOST, IP, FLOW, TLS, CLIENT_HELLO, SNI, ALPN, SRCPORT, DSTPORT, WAIT, SERVER_HELLO, CIPHERSUITE, CERTIFICATE, FINISHED, APP_DATA, COMPILE

// INSTRUCTION: Define factory floor PLC telemetry gateway.
HOST plc_gateway {
    IP 10.60.5.88
}

// INSTRUCTION: Define cloud IoT Core MQTTS broker endpoint.
HOST mqtts_broker {
    IP 10.60.5.1
}

// INSTRUCTION: Define MQTTS port 8883 handshake and encrypted telemetry publish.
FLOW tls_mqtts_8883(c, s) {
    c -> s TLS CLIENT_HELLO SNI "iot.cloud.example.com" ALPN "mqtt" SRCPORT 50883 DSTPORT 8883 WAIT 8ms
    c <- s TLS SERVER_HELLO CIPHERSUITE 0x1301 ALPN "mqtt" SRCPORT 8883 DSTPORT 50883 WAIT 8ms
    c <- s TLS CERTIFICATE SRCPORT 8883 DSTPORT 50883 WAIT 8ms
    c -> s TLS FINISHED SRCPORT 50883 DSTPORT 8883 WAIT 8ms
    c -> s TLS APP_DATA SRCPORT 50883 DSTPORT 8883
}

// INSTRUCTION: Compile the MQTTS port 8883 TLS scenario.
COMPILE {
    tls_mqtts_8883(plc_gateway, mqtts_broker)
}
