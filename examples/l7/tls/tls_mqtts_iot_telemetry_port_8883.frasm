// Industrial IoT sensor gateway establishing MQTTS session on TCP port 8883
// with ALPN mqtt.
// Cipher suite(s): 0x1301 (TLS_AES_128_GCM_SHA256).
// TLS extensions: SNI iot.cloud.example.com; ALPN mqtt.
// Overrides destination port to 8883.
// Timing: pauses 8ms after each marked packet before sending the next frame.
// Wireshark: tls || tcp.port == 8883

host plc_gateway {
    ip 10.60.5.88
}

host mqtts_broker {
    ip 10.60.5.1
}

flow tls_mqtts_8883(c, s) {
    c -> s tls clienthello sni "iot.cloud.example.com" alpn "mqtt" srcport 50883 dstport 8883 wait 8ms
    c <- s tls serverhello ciphersuite 0x1301 alpn "mqtt" srcport 8883 dstport 50883 wait 8ms
    c <- s tls certificate srcport 8883 dstport 50883 wait 8ms
    c -> s tls finished srcport 50883 dstport 8883 wait 8ms
    c -> s tls appdata srcport 50883 dstport 8883
}

compile {
    tls_mqtts_8883(plc_gateway, mqtts_broker)
}
