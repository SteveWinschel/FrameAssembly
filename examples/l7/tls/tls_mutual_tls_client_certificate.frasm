// Mutual TLS (mTLS) zero-trust service mesh handshake where both server and
// client send CERTIFICATE records.
// Cipher suite(s): 0x1302 (TLS_AES_256_GCM_SHA384).
// TLS extensions: SNI payment.mesh.internal; ALPN istio.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: tls

host order_svc {
    ip 10.244.1.18
}

host payment_svc {
    ip 10.244.2.34
}

flow mtls_mesh_handshake(c, s) {
    c -> s tls clienthello sni "payment.mesh.internal" alpn "istio" wait 2ms
    c <- s tls serverhello ciphersuite 0x1302 alpn "istio" wait 2ms
    c <- s tls certificate wait 2ms
    c <- s tls finished wait 2ms
    c -> s tls certificate wait 2ms
    c -> s tls finished wait 2ms
    c -> s tls appdata
}

compile {
    mtls_mesh_handshake(order_svc, payment_svc)
}
