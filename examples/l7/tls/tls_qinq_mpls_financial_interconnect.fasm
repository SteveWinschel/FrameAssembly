// PROMPT: Inter-bank TLS 1.3 settlement session encapsulated inside carrier QinQ and MPLS labels.
// TOKENS: HOST, IP, FLOW, TLS, CLIENT_HELLO, SNI, ALPN, QINQ, INNER_VLAN, MPLS, WAIT, SERVER_HELLO, CIPHERSUITE, FINISHED, APP_DATA, COMPILE

// INSTRUCTION: Define originating bank settlement engine host.
HOST bank_alpha {
    IP 10.200.1.10
}

// INSTRUCTION: Define clearing house TLS gateway host.
HOST clearing_house {
    IP 10.200.1.1
}

// INSTRUCTION: Define QinQ and MPLS tagged TLS handshake and settlement data transfer.
FLOW tls_carrier_settlement(c, s) {
    c -> s TLS CLIENT_HELLO SNI "swift.clearing.internal" ALPN "h2" QINQ 500 INNER_VLAN 50 MPLS 88001 WAIT 4ms
    c <- s TLS SERVER_HELLO CIPHERSUITE 0x1302 ALPN "h2" QINQ 500 INNER_VLAN 50 MPLS 88002 WAIT 4ms
    c -> s TLS FINISHED QINQ 500 INNER_VLAN 50 MPLS 88001 WAIT 4ms
    c -> s TLS APP_DATA QINQ 500 INNER_VLAN 50 MPLS 88001
}

// INSTRUCTION: Compile the QinQ MPLS financial TLS interconnect flow.
COMPILE {
    tls_carrier_settlement(bank_alpha, clearing_house)
}
