// TLS handshake record specifying legacy version 0x0303 compatibility.
// TLS extensions: SNI secure-banking.vault.org.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host legacy_terminal { ip 172.28.1.18 }

host txn_gateway { ip 172.28.1.2 }

flow tls_legacy_ver_flow(c, s) {
    c -> s tls clienthello
        recordversion 771
        sni "secure-banking.vault.org"
}

compile {
    tls_legacy_ver_flow(legacy_terminal, txn_gateway)
}
