// TLS server hello selecting AES-128-GCM cipher suite and handshake
// parameters.
// TLS extensions: SNI www.example.com.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (TLS (RFC
// 8446 / 5246), TCP 443).
// Wireshark: tls

host browser_host { ip 10.10.1.20 }

host web_server { ip 10.10.1.1 }

flow tls_server_hello_flow(c, s) {
    c -> s tls clienthello sni "www.example.com"
    c <- s tls serverhello
}

compile {
    tls_server_hello_flow(browser_host, web_server)
}
