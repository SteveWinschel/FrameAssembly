// Implicit TLS handshake for secure mail submission (SMTPS) on TCP port 465
// with ALPN smtp.
// Cipher suite(s): 0x1301 (TLS_AES_128_GCM_SHA256).
// TLS extensions: SNI smtp.corp.example; ALPN smtp.
// Overrides destination port to 465.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: tls || tcp.port == 465

host mail_client {
    ip 172.20.15.44
}

host smtps_gateway {
    ip 172.20.15.1
}

flow tls_smtps_465(c, s) {
    c -> s tls clienthello sni "smtp.corp.example" alpn "smtp" srcport 52100 dstport 465 wait 5ms
    c <- s tls serverhello ciphersuite 0x1301 alpn "smtp" srcport 465 dstport 52100 wait 5ms
    c <- s tls certificate srcport 465 dstport 52100 wait 5ms
    c <- s tls finished srcport 465 dstport 52100 wait 5ms
    c -> s tls finished srcport 52100 dstport 465 wait 5ms
    c <- s tls appdata srcport 465 dstport 52100
}

compile {
    tls_smtps_465(mail_client, smtps_gateway)
}
