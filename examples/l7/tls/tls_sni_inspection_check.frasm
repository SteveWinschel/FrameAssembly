// TLS 1.3 SNI and ALPN policy inspection check over a tracked TCP port 443 handshake.
// Negotiates TLS_AES_256_GCM_SHA384 (0x1302) for "blocked-saas.example.test" and ends
// with a fatal TLS alert so NGFW SNI filters and Suricata tls.sni rules trigger cleanly.
// Timing: 1ms spacing between handshake and TLS steps.
// Wireshark: tls

host client_pc  { ip 10.40.10.25  mac 00:50:56:40:0a:19 }
host tls_proxy  { ip 198.51.100.4 mac 00:1b:21:40:00:04 }

flow sni_policy_check(c, s) {
    c -> s tcp syn srcport 54443 dstport 443 win 65535 mss 1460 wait 1ms
    c <- s tcp syn ack win 65535 mss 1460 wait 1ms
    c -> s tcp ack wait 1ms
    c -> s tls clienthello recordversion 0x0301 handshakeversion 0x0303 sni "blocked-saas.example.test" ciphersuite 0x1302 alpn "h2" wait 1ms
    c <- s tls alert recordversion 0x0303
}

compile {
    sni_policy_check(client_pc, tls_proxy)
}
