// Multi-tenant reverse proxy rejecting unknown SNI hostname with TLS
// unrecognized_name alert.
// TLS extensions: SNI nonexistent-tenant.saas.example; ALPN http/1.1.
// Includes a TLS fatal alert record over TCP 443.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: tls

host ext_client {
    ip 172.16.200.88
}

host sni_proxy {
    ip 172.16.200.1
}

flow tls_unknown_sni(c, s) {
    c -> s tls clienthello sni "nonexistent-tenant.saas.example" alpn "http/1.1" wait 3ms
    c <- s tls alert recordversion 0x0303
}

compile {
    tls_unknown_sni(ext_client, sni_proxy)
}
