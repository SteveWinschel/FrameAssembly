// PROMPT: Multi-tenant reverse proxy rejecting unknown SNI hostname with TLS unrecognized_name alert.
// TOKENS: host, ip, flow, s, tls, clienthello, sni, alpn, wait, ms, alert, recordversion, compile

// INSTRUCTION: Define external web client requesting unconfigured virtual host.
host ext_client {
    ip 172.16.200.88
}

// INSTRUCTION: Define SNI-routing ingress controller host.
host sni_proxy {
    ip 172.16.200.1
}

// INSTRUCTION: Define ClientHello with unknown SNI triggering fatal server Alert.
flow tls_unknown_sni(c, s) {
    c -> s tls clienthello sni "nonexistent-tenant.saas.example" alpn "http/1.1" wait 3ms
    c <- s tls alert recordversion 0x0303
}

// INSTRUCTION: Compile the unrecognized SNI alert flow.
compile {
    tls_unknown_sni(ext_client, sni_proxy)
}
