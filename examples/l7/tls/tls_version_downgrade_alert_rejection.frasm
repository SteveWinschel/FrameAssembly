// Legacy client proposing TLS 1.0 (0x0301) rejected by strict server with
// protocol_version ALERT.
// TLS extensions: SNI vault.pci.example.com.
// Includes a TLS fatal alert record over TCP 443.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: tls

host legacy_scanner {
    ip 10.15.99.200
}

host hardened_srv {
    ip 10.15.99.1
}

flow tls_downgrade_reject(c, s) {
    c -> s tls clienthello recordversion 0x0301 handshakeversion 0x0301 sni "vault.pci.example.com" wait 2ms
    c <- s tls alert recordversion 0x0301
}

compile {
    tls_downgrade_reject(legacy_scanner, hardened_srv)
}
