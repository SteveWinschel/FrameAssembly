// VLAN 400 tagged secure API transaction with AF41 differentiated service.
// Encapsulation and QoS markings: 802.1Q VLAN 400, 802.1p priority 4, DSCP
// 34.
// TLS extensions: SNI fin-api.banking.net.
// Wireshark: tls && vlan.id == 400

host secure_app_host { ip 10.40.100.8 }

host fin_core { ip 10.40.100.1 }

flow tls_vlan_tagged_flow(c, s) {
    c -> s tls clienthello
        sni "fin-api.banking.net"
        vlan 400 pcp 4 dei 0 dscp 34
    c <- s tls serverhello
        vlan 400 pcp 4 dei 0 dscp 34
}

compile {
    tls_vlan_tagged_flow(secure_app_host, fin_core)
}
