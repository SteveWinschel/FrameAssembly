// Clean RFC 6455 bidirectional WebSocket close handshake initiated by client
// and echoed by server.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 80

host app_client {
    ip 192.168.75.33
}

host sess_server {
    ip 192.168.75.1
}

flow ws_mutual_close(c, s) {
    c -> s websocket close finbit 1 maskkey 0xdeadbeef hexpayload "03e8" wait 5ms
    c <- s websocket close finbit 1 hexpayload "03e8"
}

compile {
    ws_mutual_close(app_client, sess_server)
}
