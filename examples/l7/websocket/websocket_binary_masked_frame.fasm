// PROMPT: WebSocket client-to-server masked binary frame with custom mask key over IPv6.
// TOKENS: host, ip, flow, s, websocket, opcode, finbit, maskkey, compile

// INSTRUCTION: Define client endpoint.
host client { ip 2001:db8::50 }

// INSTRUCTION: Define server endpoint.
host server { ip 2001:db8::1 }

// INSTRUCTION: Define application traffic flow.
flow ws_mask(c, s) {
    c -> s websocket opcode "binary" finbit 1 maskkey 0x37fa213d
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    ws_mask(client, server)
}
