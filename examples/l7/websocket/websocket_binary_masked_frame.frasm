// WebSocket client-to-server masked binary frame with custom mask key over
// IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

flow ws_mask(c, s) {
    c -> s websocket opcode "binary" finbit 1 maskkey 0x37fa213d
}

compile {
    ws_mask(client, server)
}
