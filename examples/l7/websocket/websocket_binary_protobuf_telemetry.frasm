// Binary opcode WebSocket frame transporting serialized sensor telemetry.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host iot_gateway { ip 10.10.4.15 }

host cloud_telemetry { ip 10.10.4.1 }

flow ws_binary_flow(c, s) {
    c -> s websocket
        opcode "binary"
        finbit 1
        maskkey 1437227610
}

compile {
    ws_binary_flow(iot_gateway, cloud_telemetry)
}
