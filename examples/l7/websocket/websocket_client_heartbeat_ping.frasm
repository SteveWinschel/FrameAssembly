// Client liveness heartbeat ping frame with 32-bit masking key.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host client_conn { ip 172.16.2.9 }

host stream_broker { ip 172.16.2.1 }

flow ws_ping_flow(c, s) {
    c -> s websocket
        opcode "ping"
        finbit 1
        maskkey 2863311530
}

compile {
    ws_ping_flow(client_conn, stream_broker)
}
