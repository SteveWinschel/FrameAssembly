// WebSocket connection termination frame with CLOSE opcode and FIN bit 1.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host closing_client { ip 10.30.5.8 }

host connected_svr { ip 10.30.5.1 }

flow ws_close_flow(c, s) {
    c -> s websocket opcode "close" finbit 1 maskkey 2588014022
    c <- s websocket opcode "close" finbit 1 maskkey 0
}

compile {
    ws_close_flow(closing_client, connected_svr)
}
