// Minimal 2-block WebSocket (RFC 6455) starter emitting automatic protocol
// defaults directly from the compile block (zero flow wrapper).
// RFC 6455 WebSocket frames on TCP 80.
// Wireshark: websocket || tcp.port == 80

host ws_client {
    ip 10.40.10.25
    mac 00:1a:2b:40:10:19
}

host ws_server {
    ip 10.40.10.1
    mac 00:1a:2b:40:10:01
}

compile {
    ws_client -> ws_server websocket
}
