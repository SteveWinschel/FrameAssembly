// PROMPT: High-rate WebSocket telemetry burst experiencing ECN Congestion Experienced marking with LOOP.
// TOKENS: host, ip, flow, s, websocket, binary, finbit, maskkey, dscp, ecn, hexpayload, wait, ms, opcode, compile

// INSTRUCTION: Define autonomous vehicle telemetry sender host.
host vehicle_gw {
    ip 10.33.9.50
}

// INSTRUCTION: Define fleet management WebSocket collector host.
host fleet_collector {
    ip 10.33.9.1
}

// INSTRUCTION: Define ECN-marked WebSocket binary telemetry frame and server ACK.
flow ws_ecn_burst(c, s) {
    c -> s websocket binary finbit 1 maskkey 0xabcdef01 dscp 34 ecn 3 hexpayload "0102030405060708" wait 5ms
    c <- s websocket opcode "pong" finbit 1 dscp 34 ecn 2
}

// INSTRUCTION: Compile 4 iterations of ECN-marked WebSocket telemetry frames.
compile {
    ws_ecn_burst(vehicle_gw, fleet_collector) // cycle 1
    ws_ecn_burst(vehicle_gw, fleet_collector) // cycle 2
    ws_ecn_burst(vehicle_gw, fleet_collector) // cycle 3
    ws_ecn_burst(vehicle_gw, fleet_collector) // cycle 4
}
