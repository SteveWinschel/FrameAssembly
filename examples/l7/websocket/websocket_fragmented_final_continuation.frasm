// Final fragment of multi-frame message with FIN bit 1 completing payload.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host data_tx_host { ip 192.168.8.18 }

host data_rx_host { ip 192.168.8.1 }

flow ws_frag_final_flow(c, s) {
    c -> s websocket
        opcode "text"
        finbit 1
        maskkey 1122334455
}

compile {
    ws_frag_final_flow(data_tx_host, data_rx_host)
}
