// First fragment of multi-frame payload specifying FIN bit 0 and TEXT opcode.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host doc_client { ip 172.20.15.4 }

host index_server { ip 172.20.15.1 }

flow ws_frag_first_flow(c, s) {
    c -> s websocket
        opcode "text"
        finbit 0
        maskkey 3735928559
}

compile {
    ws_frag_first_flow(doc_client, index_server)
}
