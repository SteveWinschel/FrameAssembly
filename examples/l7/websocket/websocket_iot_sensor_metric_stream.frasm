// Industrial sensor streaming continuous metrics via WebSocket frames.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host vibration_sensor { ip 10.70.3.14 }

host floor_receiver { ip 10.70.3.1 }

flow ws_sensor_metric_flow(c, s) {
    c -> s websocket
        opcode "binary"
        finbit 1
        maskkey 2468135790
}

compile {
    ws_sensor_metric_flow(vibration_sensor, floor_receiver)
}
