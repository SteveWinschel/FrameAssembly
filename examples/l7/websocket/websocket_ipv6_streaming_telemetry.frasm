// IPv6 real-time monitoring session with masked WebSocket data frames.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host console_v6 { ip 2001:db8:4444::12 }

host broadcast_v6 { ip 2001:db8:4444::1 }

flow ws_v6_stream_flow(c, s) {
    c -> s websocket opcode "text" finbit 1 maskkey 3456789012
    c <- s websocket opcode "text" finbit 1 maskkey 0
}

compile {
    ws_v6_stream_flow(console_v6, broadcast_v6)
}
