// Kubernetes API server remote pod exec session multiplexing stdout and stdin
// over WebSocket binary channels.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Overrides destination port to 6443.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 6443

host kubectl_cli {
    ip 10.240.0.50
}

host kube_apiserver {
    ip 10.240.0.1
}

flow ws_k8s_exec(c, s) {
    c -> s websocket binary finbit 1 maskkey 0x90abcdef srcport 51200 dstport 6443 hexpayload "00756e616d650a" wait 5ms
    c <- s websocket binary finbit 1 srcport 6443 dstport 51200 hexpayload "014c696e75780a" wait 5ms
    c <- s websocket close finbit 1 srcport 6443 dstport 51200
}

compile {
    ws_k8s_exec(kubectl_cli, kube_apiserver)
}
