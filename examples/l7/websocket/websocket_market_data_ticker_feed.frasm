// Financial exchange market data streaming ticker updates via text frames.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host algo_trader { ip 10.99.1.5 }

host exchange_engine { ip 10.99.1.1 }

flow ws_ticker_flow(c, s) {
    c -> s websocket opcode "text" finbit 1 maskkey 876543210
    c <- s websocket opcode "text" finbit 1 maskkey 0
}

compile {
    ws_ticker_flow(algo_trader, exchange_engine)
}
