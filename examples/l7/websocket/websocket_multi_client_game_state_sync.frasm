// Multiplayer game server synchronizing state ticks to two WebSocket player
// endpoints.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Timing: runs 2 cycles in compile using post-packet waits (8ms).
// Wireshark: websocket || tcp.port == 80

host player_one {
    ip 192.168.200.11
}

host player_two {
    ip 192.168.200.12
}

host game_server {
    ip 192.168.200.1
}

flow ws_game_tick(p, srv) {
    p -> srv websocket binary finbit 1 maskkey 0x778899aa hexpayload "01001020" wait 8ms
    p <- srv websocket binary finbit 1 hexpayload "ff001020003040"
}

compile {
    ws_game_tick(player_one, game_server)
    ws_game_tick(player_two, game_server)
}
