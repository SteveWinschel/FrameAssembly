// WebSocket server streaming unmasked binary audio chunks using shorthand
// BINARY keyword.
// RFC 6455 WebSocket frames on TCP 80.
// Timing: pauses 10ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 80

host audio_client {
    ip 172.16.88.42
}

host tts_server {
    ip 172.16.88.10
}

flow ws_binary_stream(c, s) {
    c <- s websocket binary finbit 0 hexpayload "4f67675300020000" wait 10ms
    c <- s websocket opcode "continuation" finbit 1 hexpayload "ff00ff0011223344"
}

compile {
    ws_binary_stream(audio_client, tts_server)
}
