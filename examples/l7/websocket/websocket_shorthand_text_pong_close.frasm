// PROMPT: WebSocket session using shorthand TEXT, PING, PONG, and CLOSE keywords with payload data.
// TOKENS: host, ip, flow, s, websocket, text, finbit, maskkey, payload, wait, ms, ping, pong, close, compile

// INSTRUCTION: Define interactive web dashboard client endpoint.
host dash_client {
    ip 192.168.50.14
}

// INSTRUCTION: Define push notification WebSocket server endpoint.
host push_server {
    ip 192.168.50.1
}

// INSTRUCTION: Define WebSocket exchange exercising shorthand TEXT, PING, PONG, and CLOSE tokens.
flow ws_shorthand_ops(c, s) {
    c -> s websocket text finbit 1 maskkey 0x11223344 payload "SUB:ALERTS" wait 5ms
    c -> s websocket ping finbit 1 maskkey 0x55667788 wait 5ms
    c <- s websocket pong finbit 1 wait 5ms
    c <- s websocket close finbit 1
}

// INSTRUCTION: Compile the shorthand WebSocket opcode flow.
compile {
    ws_shorthand_ops(dash_client, push_server)
}
