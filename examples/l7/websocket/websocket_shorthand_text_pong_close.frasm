// WebSocket session using shorthand TEXT, PING, PONG, and CLOSE keywords with
// payload data.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 80

host dash_client {
    ip 192.168.50.14
}

host push_server {
    ip 192.168.50.1
}

flow ws_shorthand_ops(c, s) {
    c -> s websocket text finbit 1 maskkey 0x11223344 payload "SUB:ALERTS" wait 5ms
    c -> s websocket ping finbit 1 maskkey 0x55667788 wait 5ms
    c <- s websocket pong finbit 1 wait 5ms
    c <- s websocket close finbit 1
}

compile {
    ws_shorthand_ops(dash_client, push_server)
}
