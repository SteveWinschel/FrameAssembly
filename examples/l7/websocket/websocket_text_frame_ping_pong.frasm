// WebSocket text message framing with opcode and final bit set.
// RFC 6455 WebSocket frames on TCP 80.
// Wireshark: websocket || tcp.port == 80

host client { ip 10.0.0.5 }

host server { ip 10.0.0.1 }

flow ws_text(c, s) {
    c -> s websocket opcode "text" finbit 1
    c <- s websocket opcode "text" finbit 1
}

compile {
    ws_text(client, server)
}
