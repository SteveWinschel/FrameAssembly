// Client-to-server masked text frame transmitting JSON message with FIN bit.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Wireshark: websocket || tcp.port == 80

host web_browser { ip 192.168.1.88 }

host ws_server { ip 192.168.1.1 }

flow ws_masked_text_flow(c, s) {
    c -> s websocket
        opcode "text"
        finbit 1
        maskkey 305419896
}

compile {
    ws_masked_text_flow(web_browser, ws_server)
}
