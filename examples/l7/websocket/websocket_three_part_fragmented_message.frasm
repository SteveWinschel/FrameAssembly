// Multi-frame WebSocket message split across initial text frame, middle
// continuation, and final continuation.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Timing: pauses 2ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 80

host doc_client {
    ip 10.64.20.15
}

host collab_server {
    ip 10.64.20.1
}

flow ws_three_fragments(c, s) {
    c -> s websocket opcode "text" finbit 0 maskkey 0x10203040 payload "{'ops':[{'insert':'Part1'}," wait 2ms
    c -> s websocket opcode "continuation" finbit 0 maskkey 0x10203040 payload "{'insert':'Part2'}," wait 2ms
    c -> s websocket opcode "continuation" finbit 1 maskkey 0x10203040 payload "{'insert':'Part3'}]}"
}

compile {
    ws_three_fragments(doc_client, collab_server)
}
