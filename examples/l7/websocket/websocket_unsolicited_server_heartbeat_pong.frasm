// Unidirectional unsolicited WebSocket PONG heartbeat sent by client to keep
// NAT binding alive.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Timing: runs 3 cycles in compile using post-packet waits (15ms).
// Wireshark: websocket || tcp.port == 80

host home_hub {
    ip 192.168.1.150
}

host cloud_relay {
    ip 192.168.1.1
}

flow ws_unsolicited_pong(c, s) {
    c -> s websocket pong finbit 1 maskkey 0x6543210f ttl 64 df payload "keepalive" wait 15ms
}

compile {
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 1
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 2
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 3
}
