// PROMPT: Unidirectional unsolicited WebSocket PONG heartbeat sent by client to keep NAT binding alive.
// TOKENS: host, ip, flow, s, websocket, pong, finbit, maskkey, ttl, df, payload, wait, ms, compile

// INSTRUCTION: Define natted home automation hub client.
host home_hub {
    ip 192.168.1.150
}

// INSTRUCTION: Define cloud smart-home relay server.
host cloud_relay {
    ip 192.168.1.1
}

// INSTRUCTION: Define unsolicited client PONG frame with custom TTL and DF flag.
flow ws_unsolicited_pong(c, s) {
    c -> s websocket pong finbit 1 maskkey 0x6543210f ttl 64 df payload "keepalive" wait 15ms
}

// INSTRUCTION: Compile periodic unsolicited PONG loop.
compile {
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 1
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 2
    ws_unsolicited_pong(home_hub, cloud_relay) // cycle 3
}
