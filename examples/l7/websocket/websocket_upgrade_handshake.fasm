// PROMPT: WebSocket HTTP connection upgrade handshake establishing bi-directional framing.
// TOKENS: HOST, IP, FLOW, ->, WEBSOCKET, COMPILE

// INSTRUCTION: Define client endpoint.
HOST client { IP 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
HOST server { IP 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
FLOW ws_upgrade(c, s) {
    c -> s WEBSOCKET
}

// INSTRUCTION: Compile block executing the flow scenario.
COMPILE {
    ws_upgrade(client, server)
}
