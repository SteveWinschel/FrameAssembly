// WebSocket HTTP connection upgrade handshake establishing bi-directional
// framing.
// RFC 6455 WebSocket frames on TCP 80.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WebSocket
// (RFC 6455), TCP 80).
// Wireshark: websocket || tcp.port == 80

host client { ip 192.168.1.100 }

host server { ip 192.168.1.1 }

flow ws_upgrade(c, s) {
    c -> s websocket
}

compile {
    ws_upgrade(client, server)
}
