// PROMPT: WebSocket HTTP connection upgrade handshake establishing bi-directional framing.
// TOKENS: host, ip, flow, s, websocket, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.100 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.168.1.1 }

// INSTRUCTION: Define application traffic flow.
flow ws_upgrade(c, s) {
    c -> s websocket
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    ws_upgrade(client, server)
}
