// Low-latency financial orderbook WebSocket feed over VLAN 250 with 802.1p
// priority 6 and DSCP EF.
// Encapsulation and QoS markings: 802.1Q VLAN 250, 802.1p priority 6, DSCP 46
// (EF).
// RFC 6455 WebSocket frames on TCP 80.
// Timing: pauses 1ms after each marked packet before sending the next frame.
// Wireshark: (websocket || tcp.port == 80) && vlan.id == 250

host algo_trader {
    ip 10.250.1.50
    mac 00:0f:53:25:01:32
}

host exchange_pub {
    ip 10.250.1.1
    mac 00:0f:53:25:01:01
}

flow ws_orderbook_vlan(c, s) {
    c <- s websocket binary finbit 1 vlan 250 pcp 6 dscp 46 hexpayload "4254435553440001" wait 1ms
    c <- s websocket binary finbit 1 vlan 250 pcp 6 dscp 46 hexpayload "4254435553440002"
}

compile {
    ws_orderbook_vlan(algo_trader, exchange_pub)
}
