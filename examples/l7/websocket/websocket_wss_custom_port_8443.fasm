// PROMPT: WebSocket traffic tunneled over custom TCP port 8443 for reverse-proxied microservice API.
// TOKENS: host, ip, flow, s, websocket, text, finbit, maskkey, srcport, dstport, payload, wait, ms, compile

// INSTRUCTION: Define single-page application client host.
host spa_client {
    ip 10.120.5.90
}

// INSTRUCTION: Define API gateway listening on custom port 8443.
host api_gateway {
    ip 10.120.5.10
}

// INSTRUCTION: Define bidirectional WebSocket JSON-RPC exchange on custom TCP port 8443.
flow ws_custom_port(c, s) {
    c -> s websocket text finbit 1 maskkey 0x99887766 srcport 54321 dstport 8443 payload "{'id':1,'method':'ping'}" wait 4ms
    c <- s websocket text finbit 1 srcport 8443 dstport 54321 payload "{'id':1,'result':'pong'}"
}

// INSTRUCTION: Compile the custom port 8443 WebSocket exchange.
compile {
    ws_custom_port(spa_client, api_gateway)
}
