// WebSocket traffic tunneled over custom TCP port 8443 for reverse-proxied
// microservice API.
// RFC 6455 WebSocket on TCP 80; client frames apply the 32-bit maskkey XOR
// mask.
// Overrides destination port to 8443.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: websocket || tcp.port == 8443

host spa_client {
    ip 10.120.5.90
}

host api_gateway {
    ip 10.120.5.10
}

flow ws_custom_port(c, s) {
    c -> s websocket text finbit 1 maskkey 0x99887766 srcport 54321 dstport 8443 payload "{'id':1,'method':'ping'}" wait 4ms
    c <- s websocket text finbit 1 srcport 8443 dstport 54321 payload "{'id':1,'result':'pong'}"
}

compile {
    ws_custom_port(spa_client, api_gateway)
}
