// Create an AFNIC WHOIS query from a SOC analyst workstation auditing a
// French .fr domain registration.
// Encapsulation and QoS markings: DSCP 16.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 10.43.15.88
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.134.5.29
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "inria.fr" dscp 16 wait 4ms
    c <- s whois response domain "inria.fr" registrar "AFNIC - Association Francaise pour le Nommage Internet" dscp 16
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
