// Model an AFRINIC WHOIS lookup querying Autonomous System Number AS37100
// routing registry details.
// Timing: pauses 6ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 10.43.11.20
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 196.216.2.20
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "AS37100" wait 6ms
    c <- s whois response domain "AS37100" registrar "AFRINIC - African Network Information Centre"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
