// Machine learning platform domain query targeting registry whois database.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host lab_computer { ip 172.24.8.99 }

host ai_registry { ip 209.59.119.34 }

flow whois_ai_flow(c, s) {
    c -> s whois query domain "neuralmodels.ai"
    c <- s whois response
        domain "neuralmodels.ai"
        registrar "GoDaddy.com LLC"
}

compile {
    whois_ai_flow(lab_computer, ai_registry)
}
