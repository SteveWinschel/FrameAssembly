// APNIC regional internet registry lookup for IPv4 allocation subnets.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host apnic_cli { ip 10.120.5.8 }

host apnic_whois { ip 202.12.29.13 }

flow whois_apnic_flow(c, s) {
    c -> s whois query domain "203.0.113.0/24"
    c <- s whois response
        domain "203.0.113.0/24"
        registrar "APNIC"
}

compile {
    whois_apnic_flow(apnic_cli, apnic_whois)
}
