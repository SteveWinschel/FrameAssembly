// ARIN directory lookup for enterprise private autonomous system
// registration.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host arin_auditor { ip 172.30.2.14 }

host arin_whois { ip 199.212.0.43 }

flow whois_arin_asn_flow(c, s) {
    c -> s whois query domain "AS64512"
    c <- s whois response
        domain "AS64512"
        registrar "ARIN"
}

compile {
    whois_arin_asn_flow(arin_auditor, arin_whois)
}
