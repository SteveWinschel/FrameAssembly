// Automated domain registration audit loop verifying registry reachability.
// Executes 3 sequential flow runs inside the compile block.
// Wireshark: whois

host brand_bot { ip 172.29.5.12 }

host target_whois_svr { ip 198.51.100.10 }

flow whois_audit_flow(c, s) {
    c -> s whois query domain "brandprotection.com"
    c <- s whois response
        domain "brandprotection.com"
        registrar "SafeNames Ltd"
}

compile {
    whois_audit_flow(brand_bot, target_whois_svr) // cycle 1
    whois_audit_flow(brand_bot, target_whois_svr) // cycle 2
    whois_audit_flow(brand_bot, target_whois_svr) // cycle 3
}
