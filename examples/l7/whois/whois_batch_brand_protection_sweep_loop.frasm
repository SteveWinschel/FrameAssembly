// Create a brand-protection domain monitoring WHOIS query executed in a
// 2-iteration loop.
// Timing: runs 2 cycles in compile using post-packet waits (4ms, 15ms).
// Wireshark: whois

host whois_client {
    ip 10.43.99.50
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.0.2.143
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "brand-example-global.com" wait 4ms
    c <- s whois response domain "brand-example-global.com" registrar "MarkMonitor Inc. Corporate Domain Protection" wait 15ms
}

compile {
    whois_scenario_flow(whois_client, whois_server) // cycle 1
    whois_scenario_flow(whois_client, whois_server) // cycle 2
}
