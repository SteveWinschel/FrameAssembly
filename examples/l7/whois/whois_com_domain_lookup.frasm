// Commercial registry domain lookup query for enterprise organization domain.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host analyst_ws { ip 10.10.20.15 }

host verisign_svr { ip 192.52.178.30 }

flow whois_com_flow(c, s) {
    c -> s whois query domain "enterprise-tech.com"
    c <- s whois response
        domain "enterprise-tech.com"
        registrar "MarkMonitor Inc"
}

compile {
    whois_com_flow(analyst_ws, verisign_svr)
}
