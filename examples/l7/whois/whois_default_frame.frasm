// Minimal 2-block WHOIS starter sending a default RFC 3912 lookup on TCP port 43.
// Appends CRLF query framing and manages TCP sequence numbers without a flow wrapper.
// Useful for testing SOC threat-enrichment rules offline.
// Wireshark: whois

host soc_workstation { ip 10.50.1.100 mac 00:1a:2b:43:01:64 }
host whois_registry  { ip 192.0.2.43  mac 00:1a:2b:43:01:2b }

compile {
    soc_workstation -> whois_registry whois
}
