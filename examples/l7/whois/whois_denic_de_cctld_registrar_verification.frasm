// Simulate a DENIC WHOIS query on TCP port 43 verifying a German .de
// country-code top-level domain.
// Encapsulation and QoS markings: 802.1Q VLAN 43, 802.1p priority 2.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois && vlan.id == 43

host whois_client {
    ip 192.168.43.12
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 81.91.164.5
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "bund.de" vlan 43 pcp 2 wait 4ms
    c <- s whois response domain "bund.de" registrar "DENIC eG Frankfurt am Main" vlan 43 pcp 2
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
