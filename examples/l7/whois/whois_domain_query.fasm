// PROMPT: WHOIS directory domain registration query over TCP port 43.
// TOKENS: host, ip, flow, s, whois, query, domain, compile

// INSTRUCTION: Define client endpoint.
host client { ip 192.168.1.50 }

// INSTRUCTION: Define server endpoint.
host server { ip 192.0.47.59 }

// INSTRUCTION: Define application traffic flow.
flow whois_query(c, s) {
    c -> s whois query domain "example.com"
}

// INSTRUCTION: Compile block executing the flow scenario.
compile {
    whois_query(client, server)
}
