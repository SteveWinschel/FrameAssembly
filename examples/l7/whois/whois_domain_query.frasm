// WHOIS directory domain registration query over TCP port 43.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host client { ip 192.168.1.50 }

host server { ip 192.0.47.59 }

flow whois_query(c, s) {
    c -> s whois query domain "example.com"
}

compile {
    whois_query(client, server)
}
