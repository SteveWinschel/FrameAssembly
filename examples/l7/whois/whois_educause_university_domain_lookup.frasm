// Model an Educause WHOIS query verifying institutional ownership of a .edu
// university domain.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 192.168.43.99
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.52.178.30
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "stanford.edu" wait 4ms
    c <- s whois response domain "stanford.edu" registrar "EDUCAUSE .edu Top-Level Domain Registry"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
