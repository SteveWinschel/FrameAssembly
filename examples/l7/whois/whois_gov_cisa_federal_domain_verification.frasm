// Simulate a WHOIS lookup against the .gov registry verifying a federal
// agency domain registration.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 10.43.88.14
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.0.2.43
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "cisa.gov" wait 3ms
    c <- s whois response domain "cisa.gov" registrar "Cybersecurity and Infrastructure Security Agency (.GOV)"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
