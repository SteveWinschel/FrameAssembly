// Generate an IANA WHOIS query (whois.iana.org) looking up the authoritative
// TLD registry for .cloud.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 172.20.43.19
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.0.32.59
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "cloud" wait 4ms
    c <- s whois response domain "cloud" registrar "IANA Root Zone Database - Aruba PEC S.p.A."
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
