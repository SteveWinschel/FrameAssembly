// Cloud computing startup domain availability query in ccTLD io registry.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host startup_cli { ip 10.40.1.18 }

host io_registry { ip 193.223.78.42 }

flow whois_io_flow(c, s) {
    c -> s whois query domain "cloudnative.io"
    c <- s whois response
        domain "cloudnative.io"
        registrar "NameCheap Inc"
}

compile {
    whois_io_flow(startup_cli, io_registry)
}
