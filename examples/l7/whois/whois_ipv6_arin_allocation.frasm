// WHOIS IP address allocation query over IPv6.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host client { ip 2001:db8::50 }

host server { ip 2001:db8::1 }

flow whois_v6(c, s) {
    c -> s whois query domain "2001:db8::/32"
}

compile {
    whois_v6(client, server)
}
