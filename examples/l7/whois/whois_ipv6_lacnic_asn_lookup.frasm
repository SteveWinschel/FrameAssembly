// Generate an IPv6 WHOIS query to LACNIC inspecting Autonomous System AS28001
// ownership metadata.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 2001:db8:43:20::8
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 2001:13c7:7002:4000::10
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "AS28001" ttl 64 wait 5ms
    c <- s whois response domain "AS28001" registrar "LACNIC Registro Regional de Enderecamento" ttl 64
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
