// Regional registry query verifying allocated IPv6 address prefix assignment.
// Uses IPv6 endpoints and derives RFC 2464 multicast MACs when needed.
// Wireshark: whois

host architect_v6 { ip 2001:db8:1234::10 }

host ripe_v6_whois { ip 2001:67c:2e8:22::c100:687 }

flow whois_v6_prefix_flow(c, s) {
    c -> s whois query domain "2001:db8::/32"
    c <- s whois response
        domain "2001:db8::/32"
        registrar "RIPE NCC Registry"
}

compile {
    whois_v6_prefix_flow(architect_v6, ripe_v6_whois)
}
