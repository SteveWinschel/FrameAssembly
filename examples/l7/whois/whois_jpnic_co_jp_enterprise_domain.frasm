// Generate a JPRS/JPNIC WHOIS query inspecting registration records for a
// Japanese commercial .co.jp domain.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 172.16.43.30
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 192.41.192.40
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "ntt.co.jp" wait 4ms
    c <- s whois response domain "ntt.co.jp" registrar "Japan Registry Services Co., Ltd. (JPRS)"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
