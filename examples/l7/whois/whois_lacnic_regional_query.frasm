// LACNIC regional internet registry lookup for South American IP allocation.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host lacnic_cli { ip 192.168.99.20 }

host lacnic_whois { ip 200.3.14.10 }

flow whois_lacnic_flow(c, s) {
    c -> s whois query domain "200.7.84.0/22"
    c <- s whois response
        domain "200.7.84.0/22"
        registrar "LACNIC"
}

compile {
    whois_lacnic_flow(lacnic_cli, lacnic_whois)
}
