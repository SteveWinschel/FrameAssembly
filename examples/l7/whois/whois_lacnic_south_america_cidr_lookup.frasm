// Simulate a LACNIC regional internet registry WHOIS query on TCP port 43 for
// a South American IPv4 block.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 10.43.10.15
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 200.3.14.10
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "200.160.0.0/13" wait 5ms
    c <- s whois response domain "200.160.0.0/13" registrar "LACNIC - Latin America and Caribbean Network Information Centre"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
