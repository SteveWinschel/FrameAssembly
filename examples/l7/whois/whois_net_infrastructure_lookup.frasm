// Network infrastructure domain registration query for backbone transit
// provider.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host net_engineer { ip 172.16.4.8 }

host net_registry { ip 192.52.178.30 }

flow whois_net_flow(c, s) {
    c -> s whois query domain "backbone-core.net"
    c <- s whois response
        domain "backbone-core.net"
        registrar "CSC Corporate Domains"
}

compile {
    whois_net_flow(net_engineer, net_registry)
}
