// PROMPT: Model a Nominet UK WHOIS query checking registration metadata for an academic .ac.uk or .co.uk domain.
// TOKENS: HOST, IP, MAC, FLOW, WHOIS, QUERY, DOMAIN, WAIT, RESPONSE, REGISTRAR, COMPILE

// INSTRUCTION: Define the WHOIS client workstation or security enrichment node.
HOST whois_client {
    IP 10.43.14.55
    MAC 00:1b:21:00:43:0a
}

// INSTRUCTION: Define the authoritative RIR or TLD WHOIS directory server on TCP port 43.
HOST whois_server {
    IP 213.248.242.79
    MAC 00:1b:21:00:43:01
}

// INSTRUCTION: Execute the RFC 3912 WHOIS domain or prefix lookup transaction.
FLOW whois_scenario_flow(c, s) {
    c -> s WHOIS QUERY DOMAIN "bbc.co.uk" WAIT 5ms
    c <- s WHOIS RESPONSE DOMAIN "bbc.co.uk" REGISTRAR "Nominet UK Registry"
}

// INSTRUCTION: Compile the WHOIS registry query flow into a PCAP trace.
COMPILE {
    whois_scenario_flow(whois_client, whois_server)
}
