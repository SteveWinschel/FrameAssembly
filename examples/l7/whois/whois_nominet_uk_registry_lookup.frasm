// Model a Nominet UK WHOIS query checking registration metadata for an
// academic .ac.uk or .co.uk domain.
// Timing: pauses 5ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 10.43.14.55
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 213.248.242.79
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "bbc.co.uk" wait 5ms
    c <- s whois response domain "bbc.co.uk" registrar "Nominet UK Registry"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
