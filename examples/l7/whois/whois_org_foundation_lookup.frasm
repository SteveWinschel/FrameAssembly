// Public interest foundation domain lookup query for open source project.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host dev_audit { ip 192.168.10.45 }

host org_registry { ip 199.19.56.1 }

flow whois_org_flow(c, s) {
    c -> s whois query domain "opensourcesoftware.org"
    c <- s whois response
        domain "opensourcesoftware.org"
        registrar "Public Interest Registry"
}

compile {
    whois_org_flow(dev_audit, org_registry)
}
