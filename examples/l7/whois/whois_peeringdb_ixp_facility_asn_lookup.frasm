// Model a network capacity planner querying WHOIS for an Internet Exchange
// Point ASN peering record.
// Encapsulation and QoS markings: MPLS label 4300.
// Timing: pauses 4ms after each marked packet before sending the next frame.
// Wireshark: whois && mpls

host whois_client {
    ip 10.43.20.9
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 198.51.100.43
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "AS65001" mpls 4300 exp 2 bos 1 mplsttl 64 wait 4ms
    c <- s whois response domain "AS65001" registrar "PeeringDB IXP Registry Service" mpls 4300 exp 2 bos 1 mplsttl 64
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
