// Simulate a MSSP SOC enrichment pipeline querying a newly registered
// phishing domain over QinQ 400/43.
// Encapsulation and QoS markings: 802.1ad QinQ outer 400 / inner 43.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: whois && vlan

host whois_client {
    ip 10.40.43.77
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 10.40.43.1
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "login-verify-auth.xyz" qinq 400 innervlan 43 wait 3ms
    c <- s whois response domain "login-verify-auth.xyz" registrar "NameCheap, Inc. (IANA ID 1068)" qinq 400 innervlan 43
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
