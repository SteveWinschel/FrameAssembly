// PROMPT: Simulate a MSSP SOC enrichment pipeline querying a newly registered phishing domain over QinQ 400/43.
// TOKENS: host, ip, mac, flow, s, whois, query, domain, qinq, innervlan, wait, ms, response, registrar, compile

// INSTRUCTION: Define the WHOIS client workstation or security enrichment node.
host whois_client {
    ip 10.40.43.77
    mac 00:1b:21:00:43:0a
}

// INSTRUCTION: Define the authoritative RIR or TLD WHOIS directory server on TCP port 43.
host whois_server {
    ip 10.40.43.1
    mac 00:1b:21:00:43:01
}

// INSTRUCTION: Execute the RFC 3912 WHOIS domain or prefix lookup transaction.
flow whois_scenario_flow(c, s) {
    c -> s whois query domain "login-verify-auth.xyz" qinq 400 innervlan 43 wait 3ms
    c <- s whois response domain "login-verify-auth.xyz" registrar "NameCheap, Inc. (IANA ID 1068)" qinq 400 innervlan 43
}

// INSTRUCTION: Compile the WHOIS registry query flow into a PCAP trace.
compile {
    whois_scenario_flow(whois_client, whois_server)
}
