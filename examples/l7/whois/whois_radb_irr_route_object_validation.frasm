// Simulate a peering router tool querying whois.radb.net on port 43 to verify
// an IRR route object.
// Timing: pauses 3ms after each marked packet before sending the next frame.
// Wireshark: whois

host whois_client {
    ip 198.51.100.12
    mac 00:1b:21:00:43:0a
}

host whois_server {
    ip 198.108.0.18
    mac 00:1b:21:00:43:01
}

flow whois_scenario_flow(c, s) {
    c -> s whois query domain "192.0.2.0/24" wait 3ms
    c <- s whois response domain "192.0.2.0/24" registrar "Merit RADb Routing Assets Database"
}

compile {
    whois_scenario_flow(whois_client, whois_server)
}
