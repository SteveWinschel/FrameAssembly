// WHOIS server response payload returning domain delegation registrar
// records.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host registrar_insp { ip 10.85.12.4 }

host registry_db { ip 198.51.100.75 }

flow whois_delegation_flow(c, s) {
    c -> s whois query domain "hybrid-cloud-networks.com"
    c <- s whois response
        domain "hybrid-cloud-networks.com"
        registrar "VeriSign Global Registry"
}

compile {
    whois_delegation_flow(registrar_insp, registry_db)
}
