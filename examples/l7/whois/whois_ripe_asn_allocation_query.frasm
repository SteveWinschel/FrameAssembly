// RIPE NCC regional internet registry query for autonomous system allocation.
// Compile with 'frameassembly <file>.frasm' or inspect timestamps and ports
// before writing a capture with 'frameassembly show <file>.frasm' (WHOIS (RFC
// 3912), TCP 43).
// Wireshark: whois

host ripe_client { ip 192.168.80.12 }

host ripe_whois { ip 193.0.6.135 }

flow whois_ripe_asn_flow(c, s) {
    c -> s whois query domain "AS3333"
    c <- s whois response
        domain "AS3333"
        registrar "RIPE NCC"
}

compile {
    whois_ripe_asn_flow(ripe_client, ripe_whois)
}
