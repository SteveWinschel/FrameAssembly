// Branch security and monitoring audit combining firewall port block, Syslog alert, and SNMPv3 trap.
// Simulates an unauthorized SSH scan blocked with RST ACK, followed by an RFC 5424
// Syslog event and encrypted SNMPv3 authPriv (SHA-256 + AES) trap to Checkmk/Zabbix.
// Wireshark: tcp.port == 22 || syslog || snmp

host scanner_ext {
    ip 198.51.100.77
    mac de:ad:00:77:00:01
}

host branch_fw {
    ip 203.0.113.2
    mac 00:1b:17:02:00:01
}

host noc_collector {
    ip 10.77.0.50
    mac 00:50:56:77:00:32
}

flow branch_audit(ext, fw, noc) {
    ext -> fw tcp syn srcport 59122 dstport 22 win 1024 wait 1ms
    ext <- fw tcp rst ack srcport 22 dstport 59122 win 0 wait 5ms
    fw -> noc syslog pri 132 app "branch-fw02" msg "Denied SSH probe from 198.51.100.77" wait 5ms
    fw -> noc snmp3 trap user "noc_monitor" engineid "80001f8880770002" engineboots 5 enginetime 12400
        auth sha256 "noc_auth_pass_256" priv aes "noc_priv_pass_128"
        oid 1.3.6.1.4.1.25461.2.1.3.2.0.1 sysuptime 1240000
        varbind 1.3.6.1.4.1.25461.2.1.3.1.2.0 ipval 198.51.100.77
        varbind 1.3.6.1.4.1.25461.2.1.3.1.3.0 string "ACL_DENY_SSH_PROBE"
}

compile {
    branch_audit(scanner_ext, branch_fw, noc_collector)
}
