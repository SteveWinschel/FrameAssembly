// Grand finale omnibus exercising dual-stack IPv4/IPv6, L2 tags, L3 controls, L4
// transports, L7 apps, SNMP, and OT.
// Wire profile: 12 frames; 4 dual-stack IPv4/IPv6 hosts; QinQ S-VLAN 200 / C-VLAN
// 50; SNMPv3, Modbus, TCP, UDP, SCTP; TCP flags SYN/ACK; SCTP INIT; dstport 443;
// DSCP 18,46.
// Wireshark: snmp || modbus || (eth.type == 0x88a8 || vlan) || vlan

host host4_a { ip 10.0.0.1 }

host host4_b { ip 10.0.0.2 }

host host6_a { ip 2001:db8:f00d::1 }

host host6_b { ip 2001:db8:f00d::2 }

flow omni_l2_l3(a, b) {
    a -> b vlan 100 ttl 64 dscp 46 udp payload "vlan_l3_payload"
    a -> b qinq 200 innervlan 50 ttl 128 dscp 18 udp payload "qinq_payload"
}

flow omni_transports(a, b) {
    a -> b tcp syn srcport 50000 dstport 443
    a <- b tcp syn ack
    a -> b tcp ack
    a -> b sctp chunk init vtag 0
}

flow omni_apps(a, b) {
    a -> b flowlabel 99999 snmp3 trap user "admin" oid 1.3.6.1.6.3.1.1.5.1
    a -> b modbus func readholdingregisters
}

compile {
    omni_l2_l3(host4_a, host4_b)
    omni_l2_l3(host6_a, host6_b)
    omni_transports(host4_a, host4_b)
    omni_apps(host6_a, host6_b) // Iteration 1 of 2
    omni_apps(host6_a, host6_b) // Iteration 2 of 2
}
