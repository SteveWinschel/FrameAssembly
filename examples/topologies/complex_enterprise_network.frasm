// Simulate an enterprise network combining repeated HTTP TCP sessions between a
// router and web server with an SNMPv3 trap to a monitoring server.
// Wire profile: 21 frames; 3 IPv4 hosts; SNMPv3, TCP; TCP flags SYN/ACK; dstport
// 80.
// Wireshark: snmp || tcp

host core_router { ip 10.0.0.1 }

host web_server { ip 172.16.0.80 }

host monitoring_server { ip 192.168.100.100 }

flow web_traffic(client, server) {
    client -> server tcp syn dstport 80
    client <- server tcp syn ack srcport 80
    client -> server tcp ack dstport 80 payload "GET / HTTP/1.1"
    client <- server tcp ack srcport 80 payload "HTTP/1.1 200 OK"
}

flow secure_monitoring(agent, nms) {
    agent -> nms snmp3 trap user "admin_user" oid 1.3.6.1.4.1 sysuptime 50000
}

compile {
    web_traffic(core_router, web_server) // Iteration 1 of 5
    web_traffic(core_router, web_server) // Iteration 2 of 5
    web_traffic(core_router, web_server) // Iteration 3 of 5
    web_traffic(core_router, web_server) // Iteration 4 of 5
    web_traffic(core_router, web_server) // Iteration 5 of 5
    secure_monitoring(web_server, monitoring_server)
}
