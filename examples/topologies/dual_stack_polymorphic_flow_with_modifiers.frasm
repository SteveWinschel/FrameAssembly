// PROMPT: Polymorphic flow with Layer 3 TTL, DSCP QoS markings, and inter-frame WAIT timing over IPv4 and IPv6.
// TOKENS: host, ip, flow, ttl, dscp, udp, payload, wait, ms, compile

// INSTRUCTION: Define IPv4 source peer.
host peer_v4_x { ip 10.1.1.1 }

// INSTRUCTION: Define IPv4 destination peer.
host peer_v4_y { ip 10.1.1.2 }

// INSTRUCTION: Define IPv6 source peer.
host peer_v6_x { ip 2001:db8:a::1 }

// INSTRUCTION: Define IPv6 destination peer.
host peer_v6_y { ip 2001:db8:a::2 }

// INSTRUCTION: Define polymorphic flow with QoS and timing modifiers.
flow qos_timed_flow(a, b) {
    a -> b ttl 64 dscp 46 udp payload "voice_high_prio" wait 5ms
    a -> b ttl 32 dscp 10 udp payload "bulk_background" wait 10ms
}

// INSTRUCTION: Compile block executing polymorphic timed flow across stacks.
compile {
    qos_timed_flow(peer_v4_x, peer_v4_y)
    qos_timed_flow(peer_v6_x, peer_v6_y)
}
