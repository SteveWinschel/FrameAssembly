// IPv4 all-hosts multicast transmission to 224.0.0.1 deriving RFC 1112 MAC
// 01:00:5e:00:00:01.
// Wire profile: 1 frame; 2 IPv4 hosts; UDP.
// Verify packet timing and headers with `frameassembly show
// ipv4_multicast_mac_all_hosts.frasm` or write
// `ipv4_multicast_mac_all_hosts.pcap` via `frameassembly
// ipv4_multicast_mac_all_hosts.frasm` before replaying on a lab interface or
// opening in Wireshark.
// Wireshark: udp

host sender_v4 { ip 192.168.1.10 }

host all_hosts_v4 { ip 224.0.0.1 }

flow all_hosts_flow(src, dst) {
    src -> dst udp payload "igmp_membership_ping"
}

compile {
    all_hosts_flow(sender_v4, all_hosts_v4)
}
