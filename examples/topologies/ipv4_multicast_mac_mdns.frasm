// PROMPT: IPv4 mDNS link-local multicast transmission to 224.0.0.251 deriving RFC 1112 MAC 01:00:5e:00:00:fb.
// TOKENS: host, ip, flow, src, dst, udp, dstport, payload, compile

// INSTRUCTION: Define client advertising zero-conf service.
host mdns_client { ip 192.168.1.50 }

// INSTRUCTION: Define standard mDNS multicast address.
host mdns_mcast { ip 224.0.0.251 }

// INSTRUCTION: Define service announcement flow on UDP 5353.
flow mdns_announce_flow(src, dst) {
    src -> dst udp dstport 5353 payload "printer.local"
}

// INSTRUCTION: Compile block executing mDNS announcement.
compile {
    mdns_announce_flow(mdns_client, mdns_mcast)
}
