// IPv4 SSDP UPnP discovery multicast transmission to 239.255.255.250 deriving RFC
// 1112 MAC 01:00:5e:7f:ff:fa.
// Wire profile: 1 frame; 2 IPv4 hosts; SSDP.
// Verify packet timing and headers with `frameassembly show
// ipv4_multicast_mac_ssdp.frasm` or write `ipv4_multicast_mac_ssdp.pcap` via
// `frameassembly ipv4_multicast_mac_ssdp.frasm` before replaying on a lab
// interface or opening in Wireshark.
// Wireshark: ssdp

host ssdp_device { ip 192.168.1.75 }

host ssdp_mcast { ip 239.255.255.250 }

flow ssdp_search_flow(src, dst) {
    src -> dst ssdp msearch
}

compile {
    ssdp_search_flow(ssdp_device, ssdp_mcast)
}
