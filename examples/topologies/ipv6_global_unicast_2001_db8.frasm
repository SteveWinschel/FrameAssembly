// End-to-end traffic exchange using RFC 3849 global unicast documentation prefix
// 2001:db8::/32.
// Wire profile: 3 frames; 2 IPv6 hosts; TCP; TCP flags SYN/ACK; dstport 80.
// Wireshark: tcp.port == 80

host client_gua { ip 2001:db8:acad:1::10 }

host server_gua { ip 2001:db8:acad:2::20 }

flow gua_tcp_handshake(c, s) {
    c -> s tcp syn srcport 45000 dstport 80
    c <- s tcp syn ack
    c -> s tcp ack
}

compile {
    gua_tcp_handshake(client_gua, server_gua)
}
