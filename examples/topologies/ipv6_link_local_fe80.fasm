// PROMPT: Peer-to-peer communication using IPv6 link-local addressing in the fe80::/10 prefix.
// TOKENS: host, ip, flow, udp, payload, compile

// INSTRUCTION: Define link-local node A.
host link_node_a { ip fe80::1 }

// INSTRUCTION: Define link-local node B.
host link_node_b { ip fe80::2 }

// INSTRUCTION: Define bidirectional link-local UDP flow.
flow link_local_flow(a, b) {
    a -> b udp payload "hello_fe80"
    a <- b udp payload "ack_fe80"
}

// INSTRUCTION: Compile block executing link-local flow.
compile {
    link_local_flow(link_node_a, link_node_b)
}
