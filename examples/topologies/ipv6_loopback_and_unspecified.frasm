// Communication between IPv6 loopback and unspecified addresses to test zero-
// compression and host resolution.
// Wire profile: 1 frame; 2 IPv6 hosts; UDP.
// Wireshark: ipv6 && udp

host loop_host { ip ::1 }

host unspec_host { ip :: }

flow unspec_flow(src, dst) {
    src -> dst udp payload "loop_to_unspec"
}

compile {
    unspec_flow(loop_host, unspec_host)
}
