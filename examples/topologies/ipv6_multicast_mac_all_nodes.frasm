// IPv6 all-nodes multicast transmission automatically deriving RFC 2464 MAC
// 33:33:00:00:00:01.
// Wire profile: 1 frame; 2 IPv6 hosts; UDP.
// Verify packet timing and headers with `frameassembly show
// ipv6_multicast_mac_all_nodes.frasm` or write
// `ipv6_multicast_mac_all_nodes.pcap` via `frameassembly
// ipv6_multicast_mac_all_nodes.frasm` before replaying on a lab interface or
// opening in Wireshark.
// Wireshark: ipv6 && udp

host sender_node { ip fe80::100 }

host all_nodes_mcast { ip ff02::1 }

flow all_nodes_flow(src, dst) {
    src -> dst udp payload "all_nodes_ping"
}

compile {
    all_nodes_flow(sender_node, all_nodes_mcast)
}
