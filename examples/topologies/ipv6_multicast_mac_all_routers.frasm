// IPv6 all-routers multicast transmission automatically deriving RFC 2464 MAC
// 33:33:00:00:00:02.
// Wire profile: 1 frame; 2 IPv6 hosts; UDP.
// Verify packet timing and headers with `frameassembly show
// ipv6_multicast_mac_all_routers.frasm` or write
// `ipv6_multicast_mac_all_routers.pcap` via `frameassembly
// ipv6_multicast_mac_all_routers.frasm` before replaying on a lab interface or
// opening in Wireshark.
// Wireshark: ipv6 && udp

host host_node { ip fe80::200 }

host all_routers_mcast { ip ff02::2 }

flow all_routers_flow(src, dst) {
    src -> dst udp payload "router_solicitation_query"
}

compile {
    all_routers_flow(host_node, all_routers_mcast)
}
