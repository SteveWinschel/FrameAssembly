// IPv6 solicited-node multicast transmission deriving RFC 2464 MAC
// 33:33:ff:00:12:34.
// Wire profile: 1 frame; 2 IPv6 hosts; UDP.
// Verify packet timing and headers with `frameassembly show
// ipv6_multicast_solicited_node.frasm` or write
// `ipv6_multicast_solicited_node.pcap` via `frameassembly
// ipv6_multicast_solicited_node.frasm` before replaying on a lab interface or
// opening in Wireshark.
// Wireshark: ipv6 && udp

host solicit_sender { ip fe80::1 }

host solicit_target { ip ff02::1:ff00:1234 }

flow solicited_node_flow(src, dst) {
    src -> dst udp payload "solicited_node_ns"
}

compile {
    solicited_node_flow(solicit_sender, solicit_target)
}
