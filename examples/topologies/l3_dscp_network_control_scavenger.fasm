// PROMPT: Network control and scavenger traffic classes spanning CS6, CS7, CS1, and boundary values 0 and 63.
// TOKENS: host, ip, flow, dscp, udp, payload, compile

// INSTRUCTION: Define router peer A.
host router_peer_a { ip 198.51.100.1 }

// INSTRUCTION: Define router peer B.
host router_peer_b { ip 198.51.100.2 }

// INSTRUCTION: Define network control and boundary DSCP flow.
flow control_qos_flow(a, b) {
    a -> b dscp 48 udp payload "cs6_routing_control"
    a -> b dscp 56 udp payload "cs7_link_layer"
    a -> b dscp 8 udp payload "cs1_scavenger"
    a -> b dscp 0 udp payload "cs0_best_effort"
    a -> b dscp 63 udp payload "max_dscp_boundary"
}

// INSTRUCTION: Compile block executing control QoS traffic.
compile {
    control_qos_flow(router_peer_a, router_peer_b)
}
