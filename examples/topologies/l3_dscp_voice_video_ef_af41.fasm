// PROMPT: Differentiated Services Code Point QoS marking for Expedited Forwarding voice and AF41 video.
// TOKENS: host, ip, flow, s, dscp, udp, dstport, payload, compile

// INSTRUCTION: Define multimedia sender host.
host media_sender { ip 10.50.1.10 }

// INSTRUCTION: Define multimedia receiver host.
host media_receiver { ip 10.50.1.20 }

// INSTRUCTION: Define DSCP marked voice and video flow.
flow qos_media_flow(s, r) {
    s -> r dscp 46 udp dstport 5004 payload "voice_ef_frame"
    s -> r dscp 34 udp dstport 5006 payload "video_af41_frame"
}

// INSTRUCTION: Compile block executing QoS marked traffic.
compile {
    qos_media_flow(media_sender, media_receiver)
}
