// Dual-stack flow specifying flowlabel executed over both IPv4 and IPv6 where
// IPv4 silently ignores the modifier.
// Wire profile: 2 frames; 4 dual-stack IPv4/IPv6 hosts; UDP.
// Wireshark: udp

host v4_src { ip 10.0.0.1 }

host v4_dst { ip 10.0.0.2 }

host v6_src { ip 2001:db8::1 }

host v6_dst { ip 2001:db8::2 }

flow dual_stack_flowlabel(s, d) {
    s -> d flowlabel 54321 udp payload "flowlabel_dual_stack"
}

compile {
    dual_stack_flowlabel(v4_src, v4_dst)
    dual_stack_flowlabel(v6_src, v6_dst)
}
