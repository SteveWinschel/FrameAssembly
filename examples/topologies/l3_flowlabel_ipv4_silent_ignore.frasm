// PROMPT: Polymorphic flow specifying FLOWLABEL executed over both IPv4 and IPv6 where IPv4 silently ignores the modifier.
// TOKENS: host, ip, flow, s, flowlabel, udp, payload, compile

// INSTRUCTION: Define IPv4 client node.
host v4_src { ip 10.0.0.1 }

// INSTRUCTION: Define IPv4 server node.
host v4_dst { ip 10.0.0.2 }

// INSTRUCTION: Define IPv6 client node.
host v6_src { ip 2001:db8::1 }

// INSTRUCTION: Define IPv6 server node.
host v6_dst { ip 2001:db8::2 }

// INSTRUCTION: Define dual-stack polymorphic flow with FLOWLABEL modifier.
flow dual_stack_flowlabel(s, d) {
    s -> d flowlabel 54321 udp payload "flowlabel_polymorphic"
}

// INSTRUCTION: Compile block executing polymorphic flow across IPv4 and IPv6.
compile {
    dual_stack_flowlabel(v4_src, v4_dst)
    dual_stack_flowlabel(v6_src, v6_dst)
}
