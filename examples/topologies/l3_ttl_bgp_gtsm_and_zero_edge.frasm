// Generalized TTL Security Mechanism with maximum TTL 255 and boundary edge case
// TTL 0.
// Wire profile: 2 frames; 2 IPv4 hosts; TCP; TCP flags SYN; dstport 179.
// Wireshark: tcp.port == 179

host bgp_speaker_a { ip 192.0.2.1 }

host bgp_speaker_b { ip 192.0.2.2 }

flow gtsm_flow(a, b) {
    a -> b ttl 255 tcp syn srcport 179 dstport 179
    a -> b ttl 0 tcp syn srcport 179 dstport 179
}

compile {
    gtsm_flow(bgp_speaker_a, bgp_speaker_b)
}
