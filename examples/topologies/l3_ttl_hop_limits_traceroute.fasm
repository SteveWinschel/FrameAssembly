// PROMPT: Traceroute simulation with incremental TTL hop limit values 1, 2, and 3.
// TOKENS: host, ip, flow, ttl, udp, dstport, payload, compile

// INSTRUCTION: Define traceroute client endpoint.
host trace_client { ip 10.1.1.10 }

// INSTRUCTION: Define traceroute target server.
host trace_target { ip 10.2.2.20 }

// INSTRUCTION: Define sequential traceroute probe steps.
flow traceroute_flow(c, t) {
    c -> t ttl 1 udp dstport 33434 payload "probe1"
    c -> t ttl 2 udp dstport 33435 payload "probe2"
    c -> t ttl 3 udp dstport 33436 payload "probe3"
}

// INSTRUCTION: Compile block executing traceroute probe sequence.
compile {
    traceroute_flow(trace_client, trace_target)
}
