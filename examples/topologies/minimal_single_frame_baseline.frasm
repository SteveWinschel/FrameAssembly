// Minimalist single-frame baseline defining two hosts and one direct TCP SYN frame.
// Uses two-block host and compile syntax with built-in defaults (srcport 12345,
// dstport 80, seq 1000) to produce a valid 54-byte Ethernet/IPv4/TCP capture.
// Inspect with `frameassembly show minimal_single_frame_baseline.frasm`.
// Wireshark: tcp.flags.syn == 1

host host_a { ip 10.0.0.1 }
host host_b { ip 10.0.0.2 }

compile {
    host_a -> host_b tcp syn
}
