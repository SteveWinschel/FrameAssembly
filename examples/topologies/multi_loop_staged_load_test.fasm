// PROMPT: Simulate a multi-stage load test using sequential repeated flow calls in the compile section representing warm-up, peak burst, and cool-down traffic phases.
// TOKENS: host, ip, mac, flow, udp, srcport, dstport, payload, wait, ms, tcp, syn, ack, psh, compile

// INSTRUCTION: Define a load generator client host with IP 10.201.0.10.
host load_generator { ip 10.201.0.10 mac 00:16:3e:c9:00:0a }

// INSTRUCTION: Define the system under test (SUT) API gateway with IP 10.201.0.80.
host sut_gateway { ip 10.201.0.80 mac 00:16:3e:c9:00:50 }

// INSTRUCTION: Define a warm-up health check flow over UDP port 8125.
flow warmup_probe(gen, sut) {
    gen -> sut udp srcport 58125 dstport 8125 payload "STATSD_WARMUP_STAGE:1|c" wait 20ms
}

// INSTRUCTION: Define a high-rate HTTP load test flow over TCP port 80.
flow peak_http_burst(gen, sut) {
    gen -> sut tcp syn dstport 80 wait 1ms
    gen <- sut tcp syn ack srcport 80 wait 1ms
    gen -> sut tcp psh ack dstport 80 payload "GET /benchmark HTTP/1.1" wait 1ms
    gen <- sut tcp psh ack srcport 80 payload "HTTP/1.1 200 OK" wait 1ms
}

// INSTRUCTION: Compile block executing 3 warm-up cycles, 15 peak load cycles, and a final single probe.
compile {
    warmup_probe(load_generator, sut_gateway) // cycle 1
    warmup_probe(load_generator, sut_gateway) // cycle 2
    warmup_probe(load_generator, sut_gateway) // cycle 3
    peak_http_burst(load_generator, sut_gateway) // cycle 1 of 15
    peak_http_burst(load_generator, sut_gateway) // cycle 2 of 15
    peak_http_burst(load_generator, sut_gateway) // cycle 3 of 15
    peak_http_burst(load_generator, sut_gateway) // cycle 4 of 15
    peak_http_burst(load_generator, sut_gateway) // cycle 5 of 15
    warmup_probe(load_generator, sut_gateway)
}
