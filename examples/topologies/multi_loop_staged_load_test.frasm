// Simulate a multi-stage load test using sequential repeated flow calls in the
// compile section representing warm-up, peak burst, and cool-down traffic phases.
// Wire profile: 24 frames; 2 IPv4 hosts; TCP, UDP; TCP flags SYN/ACK/PSH; dstport
// 80,8125; waits 20ms, 1ms.
// Wireshark: tcp || udp

host load_generator { ip 10.201.0.10 mac 00:16:3e:c9:00:0a }

host sut_gateway { ip 10.201.0.80 mac 00:16:3e:c9:00:50 }

flow warmup_probe(gen, sut) {
    gen -> sut udp srcport 58125 dstport 8125 payload "STATSD_WARMUP_STAGE:1|c" wait 20ms
}

flow peak_http_burst(gen, sut) {
    gen -> sut tcp syn dstport 80 wait 1ms
    gen <- sut tcp syn ack srcport 80 wait 1ms
    gen -> sut tcp psh ack dstport 80 payload "GET /benchmark HTTP/1.1" wait 1ms
    gen <- sut tcp psh ack srcport 80 payload "HTTP/1.1 200 OK" wait 1ms
}

compile {
    warmup_probe(load_generator, sut_gateway) // Iteration 1 of 4
    warmup_probe(load_generator, sut_gateway) // Iteration 2 of 4
    warmup_probe(load_generator, sut_gateway) // Iteration 3 of 4
    peak_http_burst(load_generator, sut_gateway) // Iteration 1 of 5
    peak_http_burst(load_generator, sut_gateway) // Iteration 2 of 5
    peak_http_burst(load_generator, sut_gateway) // Iteration 3 of 5
    peak_http_burst(load_generator, sut_gateway) // Iteration 4 of 5
    peak_http_burst(load_generator, sut_gateway) // Iteration 5 of 5
    warmup_probe(load_generator, sut_gateway)
}
