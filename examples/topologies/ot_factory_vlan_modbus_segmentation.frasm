// OT/ICS Purdue segmentation audit separating Control VLAN 110 SCADA polls from IT VLAN 200 blocks.
// Verifies authorized Modbus/TCP holding register read on VLAN 110 (PCP 6), then
// shows an unauthorized IT workstation coil write on VLAN 200 reset by the OT firewall.
// Wireshark: (vlan.id == 110 || vlan.id == 200) && (modbus || tcp.flags.reset == 1)

host scada_hmi {
    ip 172.30.110.10
    mac 00:1b:21:6e:00:0a
}

host assembly_plc {
    ip 172.30.110.50
    mac 00:0e:8c:6e:00:32
}

host it_laptop {
    ip 172.30.200.40
    mac 00:50:56:c8:00:28
}

host ot_conduit_fw {
    ip 172.30.200.1
    mac 00:1b:17:c8:00:01
}

flow authorized_ot_poll(hmi, plc) {
    hmi -> plc vlan 110 pcp 6 dscp 46 modbus unitid 1 func "readholdingregisters" addr 40001 count 4 wait 2ms
    hmi <- plc vlan 110 pcp 6 dscp 46 modbus unitid 1 func "readholdingregisters" count 4 isresponse wait 10ms
}

flow blocked_it_crossover(ws, fw) {
    ws -> fw vlan 200 pcp 0 modbus unitid 1 func "writesinglecoil" addr 1 value 1 wait 1ms
    ws <- fw vlan 200 pcp 0 tcp rst ack srcport 502 dstport 12345 win 0
}

compile {
    authorized_ot_poll(scada_hmi, assembly_plc)
    blocked_it_crossover(it_laptop, ot_conduit_fw)
}
