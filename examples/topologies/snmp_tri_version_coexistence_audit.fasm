// PROMPT: Simulate a brownfield network management audit where legacy SNMPv1, standard SNMPv2c, and encrypted SNMPv3 coexist and report to a single compliance collector.
// TOKENS: host, ip, mac, flow, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, string, wait, ms, snmp2, get, reqid, nullval, response, int, snmp3, inform, compile

// INSTRUCTION: Define a legacy SNMPv1 print server with IP 10.204.0.11.
host legacy_v1_dev { ip 10.204.0.11 mac 00:11:22:cc:00:11 }

// INSTRUCTION: Define a distribution SNMPv2c switch with IP 10.204.0.22.
host standard_v2_dev { ip 10.204.0.22 mac 00:11:22:cc:00:22 }

// INSTRUCTION: Define a core SNMPv3 router with IP 10.204.0.33.
host secure_v3_dev { ip 10.204.0.33 mac 00:11:22:cc:00:33 }

// INSTRUCTION: Define the unified compliance NMS server with IP 10.204.0.250.
host compliance_nms { ip 10.204.0.250 mac 00:11:22:cc:00:fa }

// INSTRUCTION: Define a 4-host flow auditing SNMP1 trap, SNMP2 GET/RESPONSE, and SNMP3 encrypted INFORM/RESPONSE.
flow tri_version_snmp_audit(dev1, dev2, dev3, nms) {
    dev1 -> nms snmp1 trap community "public" enterprise 1.3.6.1.4.1.11
        agentip 10.204.0.11 gentrap 6 spectrap 3 sysuptime 50000
        varbind 1.3.6.1.2.1.1.5.0 string "hp-jetdirect-v1"
        wait 10ms
    nms -> dev2 snmp2 get community "audit_ro" reqid 10601
        varbind 1.3.6.1.2.1.1.5.0 nullval
        wait 10ms
    nms <- dev2 snmp2 response community "audit_ro" reqid 10601
        varbind 1.3.6.1.2.1.1.5.0 string "dist-sw-v2c"
        varbind 1.3.6.1.2.1.2.1.0 int 48
        wait 10ms
    dev3 -> nms snmp3 inform user "compliance_v3" engineid "80001f8880cc0033" engineboots 18 enginetime 99000
        auth sha256 "audit_sha256_pass" priv aes "audit_aes128_pass"
        reqid 10602 oid 1.3.6.1.6.3.1.1.5.4 sysuptime 9900000
        varbind 1.3.6.1.2.1.1.5.0 string "core-rtr-v3"
        varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 776655443322
        wait 10ms
    dev3 <- nms snmp3 response user "compliance_v3" engineid "80001f8880cc0033" engineboots 18 enginetime 99000
        auth sha256 "audit_sha256_pass" priv aes "audit_aes128_pass"
        reqid 10602
        varbind 1.3.6.1.2.1.1.5.0 string "core-rtr-v3"
        varbind 1.3.6.1.2.1.31.1.1.1.6.1 counter64 776655443322
        wait 10ms
}

// INSTRUCTION: Compile block to execute the tri-version SNMP coexistence audit.
compile {
    tri_version_snmp_audit(legacy_v1_dev, standard_v2_dev, secure_v3_dev, compliance_nms)
}
