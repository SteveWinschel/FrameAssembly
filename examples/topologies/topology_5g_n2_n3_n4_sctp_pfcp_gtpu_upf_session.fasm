// PROMPT: 5G Standalone N2, N3, and N4 core network PDU session establishment combining SCTP NGAP signaling, UDP PFCP session control, and VXLAN/GTP-U user plane forwarding.
// TOKENS: host, ip, flow, dscp, sctp, chunk, init, vtag, dstport, initack, wait, ms, data, stream, ppid, payload, udp, srcport, vxlan, vni, compile

// INSTRUCTION: Define 5G gNodeB radio access network base station.
host gnb_ran_node { ip 10.150.1.10 }

// INSTRUCTION: Define 5G Access and Mobility Management Function (AMF).
host amf_control_node { ip 10.150.2.10 }

// INSTRUCTION: Define 5G Session Management Function (SMF) controlling N4 interface.
host smf_session_node { ip 10.150.2.20 }

// INSTRUCTION: Define 5G User Plane Function (UPF) anchoring N3/N6 data path.
host upf_data_plane { ip 10.150.3.10 }

// INSTRUCTION: Define N2 SCTP NGAP session request, N4 UDP PFCP rule provisioning, and N3 encapsulated user plane traffic.
flow fiveg_n2_n3_n4_pdu_session(gnb, amf, smf, upf) {
    gnb -> amf dscp 48 sctp chunk init vtag 1001 dstport 38412
    gnb <- amf dscp 48 sctp chunk initack vtag 2002 wait 1ms
    gnb -> amf dscp 48 sctp chunk data vtag 2002 stream 0 ppid 60 payload "NGAP_PDUSessionResourceSetupRequest" wait 1ms
    smf -> upf dscp 48 udp srcport 8805 dstport 8805 payload "PFCP_SessionEstablishmentRequest_FAR_QER" wait 1ms
    smf <- upf dscp 48 udp srcport 8805 dstport 8805 payload "PFCP_SessionEstablishmentResponse_CauseAccepted" wait 1ms
    gnb <- amf dscp 48 sctp chunk data vtag 1001 stream 0 ppid 60 payload "NGAP_PDUSessionResourceSetupResponse" wait 1ms
    gnb -> upf dscp 46 vxlan vni 5001 payload "GTPU_TEID_0x1000_5G_UE_Uplink_Packet" wait 2ms
    gnb <- upf dscp 46 vxlan vni 5001 payload "GTPU_TEID_0x2000_5G_UE_Downlink_Packet" wait 2ms
}

// INSTRUCTION: Compile block executing 5G N2/N3/N4 PDU session topology.
compile {
    fiveg_n2_n3_n4_pdu_session(gnb_ran_node, amf_control_node, smf_session_node, upf_data_plane)
}
