// 5G Stand-Alone (5G SA) Core Network topology combining N1/N2 SCTP NGAP
// signaling, N3 GTP-U user plane, and N4 PFCP/HTTP2 SBA.
// Wire profile: 5 frames; 4 IPv4 hosts; VLAN 501,502,503,504; PCP 4,5,6; HTTP/2,
// UDP, SCTP; SCTP DATA/SACK; PPID 60; dstport 2152,8805,38412; DSCP 34,46; waits
// 1ms, 2ms.
// Wireshark: http2 || vlan || udp || sctp

host gnb_cell_01 {
    ip 10.50.1.10
    mac 00:1c:73:50:01:0a
}

host core_amf_01 {
    ip 10.50.1.1
    mac 00:1c:73:50:01:01
}

host core_smf_01 {
    ip 10.50.1.2
    mac 00:1c:73:50:01:02
}

host core_upf_01 {
    ip 10.50.1.3
    mac 00:1c:73:50:01:03
}

flow topology_5g_sa_pdu_session(gnb, amf, smf, upf) {
    gnb -> amf vlan 501 pcp 6 dscp 46 sctp chunk data vtag 500101 stream 1 ssn 0 ppid 60 srcport 38412 dstport 38412 payload "ngap_pdu_session_resource_setup_req"
        wait 1ms
    gnb <- amf vlan 501 pcp 6 dscp 46 sctp chunk sack vtag 500101 srcport 38412 dstport 38412 wait 2ms
    amf -> smf vlan 502 pcp 5 dscp 34 http2 headers streamid 1 payload "POST /nsmf-pdusession/v1/sm-contexts" wait 2ms
    smf -> upf vlan 503 pcp 6 dscp 46 udp srcport 8805 dstport 8805 hexpayload "21320010000000000000000100000100" wait 2ms
    gnb -> upf vlan 504 pcp 4 dscp 34 udp srcport 2152 dstport 2152 hexpayload "34ff0010000102030000000085010000"
}

compile {
    topology_5g_sa_pdu_session(gnb_cell_01, core_amf_01, core_smf_01, core_upf_01)
}
