// Active Directory domain workstation logon workflow combining DNS SRV discovery,
// Kerberos AS/TGS ticket exchange, LDAP directory query, and SMB3 SYSVOL Group
// Policy mount.
// Wire profile: 11 frames; 2 IPv4 hosts; DNS, Kerberos, LDAP, SMB; waits 1ms.
// Wireshark: dns || kerberos || ldap || (smb || smb2)

host ad_workstation {
    ip 10.50.10.105
    mac 00:50:56:32:0a:69
}

host ad_domain_ctrl {
    ip 10.50.1.10
    mac 00:50:56:32:01:0a
}

flow active_directory_domain_logon(ws, dc) {
    ws -> dc dns query qname "_kerberos._tcp.corp.internal" wait 1ms
    ws <- dc dns response qname "_kerberos._tcp.corp.internal" rdata "dc01.corp.internal" wait 1ms
    ws -> dc kerberos asreq realm "CORP.INTERNAL" cname "jdoe" wait 1ms
    ws <- dc kerberos asrep realm "CORP.INTERNAL" cname "jdoe" wait 1ms
    ws -> dc kerberos tgsreq realm "CORP.INTERNAL" cname "jdoe" wait 1ms
    ws <- dc kerberos tgsrep realm "CORP.INTERNAL" cname "jdoe" wait 1ms
    ws -> dc ldap bindreq user "CN=jdoe,OU=Staff,DC=corp,DC=internal" wait 1ms
    ws <- dc ldap bindres wait 1ms
    ws -> dc ldap searchreq wait 1ms
    ws -> dc smb command "sessionsetup" wait 1ms
    ws -> dc smb command "treeconnect" share "\\\\dc01.corp.internal\\SYSVOL"
}

compile {
    active_directory_domain_logon(ad_workstation, ad_domain_ctrl)
}
