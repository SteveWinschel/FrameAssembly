// PROMPT: AI GPU training cluster RoCEv2 lossless fabric combining LLDP DCBX capability exchange, BGP EVPN route learning, VLAN PCP 3 RDMA over UDP, and ECN congestion marking.
// TOKENS: host, ip, mac, flow, lldp, chassisid, portid, sysname, bgp, open, asn, bgpid, wait, us, update, prefix, nexthop, vlan, pcp, dscp, ecn, udp, srcport, dstport, payload, compile

// INSTRUCTION: Define AI GPU worker node 0 with 400GbE ConnectX-7 NIC.
host gpu_worker_node0 {
    ip 10.200.1.10
    mac 0c:42:a1:c8:01:0a
}

// INSTRUCTION: Define lossless RoCEv2 leaf switch with PFC and ECN WRED enabled.
host roce_leaf_switch {
    ip 10.200.1.1
    mac 00:1c:73:c8:01:01
}

// INSTRUCTION: Define AI GPU worker node 1 participating in NCCL AllReduce collective.
host gpu_worker_node1 {
    ip 10.200.2.20
    mac 0c:42:a1:c8:02:14
}

// INSTRUCTION: Define LLDP DCBX advertisement, BGP RoCE endpoint advertisement, ECN-marked RDMA Write, and RoCEv2 CNP response.
flow ai_gpu_rocev2_allreduce(gpu0, leaf, gpu1) {
    gpu0 -> leaf lldp chassisid "hgx-h200-node0" portid "mlx5_0" sysname "gpu-node0"
    gpu0 -> leaf bgp open asn 65200 bgpid 10.200.1.10 wait 100us
    leaf -> gpu0 bgp update prefix "10.200.2.0/24" nexthop 10.200.1.1 wait 100us
    gpu0 -> gpu1 vlan 200 pcp 3 dscp 26 ecn 2 udp srcport 49152 dstport 4791 payload "BTH_RDMA_WRITE_ONLY_NCCL_RING_CHUNK_01" wait 20us
    gpu0 -> gpu1 vlan 200 pcp 3 dscp 26 ecn 3 udp srcport 49152 dstport 4791 payload "BTH_RDMA_WRITE_ONLY_NCCL_RING_CHUNK_02_CE" wait 20us
    gpu0 <- gpu1 vlan 200 pcp 6 dscp 48 ecn 0 udp srcport 4791 dstport 4791 payload "BTH_ROCEV2_CNP_CONGESTION_NOTIFICATION" wait 10us
}

// INSTRUCTION: Compile block executing AI GPU cluster RoCEv2 lossless fabric topology.
compile {
    ai_gpu_rocev2_allreduce(gpu_worker_node0, roce_leaf_switch, gpu_worker_node1)
}
