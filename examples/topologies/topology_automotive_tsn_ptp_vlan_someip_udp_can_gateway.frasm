// Automotive zonal Ethernet Time-Sensitive Networking (TSN) backbone combining
// IEEE 802.1AS PTP sync, VLAN PCP 7 ADAS LiDAR stream, UDP SOME/IP service
// discovery, and DoIP diagnostics.
// Wire profile: 6 frames; 3 IPv4 hosts; VLAN 88; PCP 4,6,7; PTP, TCP, UDP; TCP
// flags ACK/PSH; dstport 13400,30490,30501,49200; DSCP 46,56; waits 100us, 200us,
// 500us.
// Wireshark: ptp || vlan || tcp || udp

host adas_central_ecu {
    ip 192.168.88.10
    mac 02:00:00:58:00:0a
}

host front_zonal_gw {
    ip 192.168.88.20
    mac 02:00:00:58:00:14
}

host doip_diag_tester {
    ip 192.168.88.250
    mac 02:00:00:58:00:fa
}

flow automotive_tsn_zonal_backbone(adas, zonal, tester) {
    adas -> zonal vlan 88 pcp 7 ptp sync domain 0 seqid 1200 wait 100us
    adas -> zonal vlan 88 pcp 7 ptp followup domain 0 seqid 1200 wait 200us
    zonal -> adas vlan 88 pcp 6 dscp 46 udp srcport 30490 dstport 30490 payload "SOMEIP_SD_OFFER_SERVICE_0x1234_LIDAR_OBJECT_TRACK" wait 200us
    zonal -> adas vlan 88 pcp 7 dscp 56 udp srcport 30501 dstport 30501 payload "SOMEIP_LIDAR_POINT_CLOUD_FRAME_8810_64_CHANNELS" wait 500us
    tester -> adas vlan 88 pcp 4 tcp psh ack srcport 49200 dstport 13400 win 65535 payload "DOIP_UDS_0x22_READ_DID_F190_VIN_NUMBER" wait 500us
    tester <- adas vlan 88 pcp 4 tcp psh ack srcport 13400 dstport 49200 win 65535 payload "DOIP_UDS_0x62_POSITIVE_RESPONSE_VIN_VERIFIED"
}

compile {
    automotive_tsn_zonal_backbone(adas_central_ecu, front_zonal_gw, doip_diag_tester)
}
