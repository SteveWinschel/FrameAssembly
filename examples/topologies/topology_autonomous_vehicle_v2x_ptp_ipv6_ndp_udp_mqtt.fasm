// PROMPT: Connected autonomous vehicle V2X roadside unit corridor over IPv6 combining NDP neighbor discovery, PTP clock sync, UDP Basic Safety Message broadcast, and MQTT telemetry.
// TOKENS: host, ip, mac, flow, ndp, routeradvert, slla, neighborsolicit, target, wait, ms, neighboradvert, ptp, sync, domain, seqid, dscp, flowlabel, udp, dstport, payload, mqtt, publish, compile

// INSTRUCTION: Define autonomous vehicle onboard telematics unit (OBU) with IPv6 address.
host av_vehicle_obu {
    ip 2001:db8:800:1::55
    mac 02:42:ac:11:00:55
}

// INSTRUCTION: Define smart highway Roadside Unit (RSU) and PTP boundary clock.
host highway_rsu_gw {
    ip 2001:db8:800:1::1
    mac 00:1b:21:80:01:01
}

// INSTRUCTION: Define regional Transportation Management Center (TMC) MQTT cloud broker.
host regional_tmc_cloud {
    ip 2001:db8:800:2::100
    mac 00:50:56:80:02:64
}

// INSTRUCTION: Define IPv6 NDP discovery, PTP timing sync, low-latency UDP V2X BSM frame, and MQTT hazard telemetry publish.
flow autonomous_v2x_corridor_flow(obu, rsu, tmc) {
    rsu -> obu ndp routeradvert slla 00:1b:21:80:01:01
    obu -> rsu ndp neighborsolicit target 2001:db8:800:1::1 slla 02:42:ac:11:00:55 wait 1ms
    obu <- rsu ndp neighboradvert target 2001:db8:800:1::1 wait 1ms
    rsu -> obu ptp sync domain 1 seqid 500 wait 1ms
    obu -> rsu dscp 46 flowlabel 0x80055 udp dstport 30100 payload "J2735_BSM_LAT_37.3861_LON_-122.0839_SPEED_28MPS" wait 1ms
    rsu -> tmc dscp 34 flowlabel 0x80100 mqtt publish topic "v2x/corridor101/bsm_aggregate" payload "{\"vehicles\":14}" wait 2ms
}

// INSTRUCTION: Compile block executing IPv6 autonomous vehicle V2X NDP, PTP, UDP, and MQTT topology.
compile {
    autonomous_v2x_corridor_flow(av_vehicle_obu, highway_rsu_gw, regional_tmc_cloud)
}
