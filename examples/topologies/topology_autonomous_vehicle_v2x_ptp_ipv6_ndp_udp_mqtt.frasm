// Connected autonomous vehicle V2X roadside unit corridor over IPv6 combining NDP
// neighbor discovery, PTP clock sync, UDP Basic Safety Message broadcast, and
// MQTT telemetry.
// Wire profile: 6 frames; 3 IPv6 hosts; PTP, MQTT, NDP, UDP; dstport 30100; DSCP
// 34,46; waits 1ms, 2ms.
// Wireshark: ptp || mqtt || icmpv6 || udp

host av_vehicle_obu {
    ip 2001:db8:800:1::55
    mac 02:42:ac:11:00:55
}

host highway_rsu_gw {
    ip 2001:db8:800:1::1
    mac 00:1b:21:80:01:01
}

host regional_tmc_cloud {
    ip 2001:db8:800:2::100
    mac 00:50:56:80:02:64
}

flow autonomous_v2x_corridor_flow(obu, rsu, tmc) {
    rsu -> obu ndp routeradvert slla 00:1b:21:80:01:01 wait 1ms
    obu -> rsu ndp neighborsolicit target 2001:db8:800:1::1 slla 02:42:ac:11:00:55 wait 1ms
    obu <- rsu ndp neighboradvert target 2001:db8:800:1::1 wait 1ms
    rsu -> obu ptp sync domain 1 seqid 500 wait 1ms
    obu -> rsu dscp 46 flowlabel 0x80055 udp dstport 30100 payload "J2735_BSM_LAT_37.3861_LON_-122.0839_SPEED_28MPS" wait 2ms
    rsu -> tmc dscp 34 flowlabel 0x80100 mqtt publish topic "v2x/corridor101/bsm_aggregate" payload "{\"vehicles\":14}"
}

compile {
    autonomous_v2x_corridor_flow(av_vehicle_obu, highway_rsu_gw, regional_tmc_cloud)
}
