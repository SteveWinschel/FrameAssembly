// Proof-of-Stake blockchain validator node topology combining NTP clock
// discipline, QUIC P2P block gossip, gRPC execution engine API, and HTTP JSON-RPC
// client queries.
// Wire profile: 7 frames; 3 IPv4 hosts; NTP, HTTP, gRPC, QUIC; waits 1ms.
// Wireshark: ntp || http || (grpc || http2) || quic

host pos_beacon_validator { ip 172.30.10.10 }

host p2p_peer_validator { ip 172.30.10.20 }

host execution_rpc_node { ip 172.30.10.30 }

flow blockchain_validator_slot_flow(beacon, peer, exec) {
    beacon -> peer ntp vn 4 mode 3 stratum 3 wait 1ms
    beacon <- peer ntp vn 4 mode 4 stratum 2 wait 1ms
    peer -> beacon quic short dcid 0xfeedfacecafebeef payload "LIBP2P_GOSSIPSUB_SIGNED_BEACON_BLOCK_SLOT_9400120" wait 1ms
    beacon -> exec grpc service "engine.v1.ExecutionEngine" method "NewPayloadV3" grpcstatus 0 payload "{\"blockHash\":\"0x88aa\"}" wait 1ms
    beacon <- exec grpc service "engine.v1.ExecutionEngine" method "NewPayloadV3" grpcstatus 0 payload "{\"status\":\"VALID\"}" wait 1ms
    beacon -> exec http method "POST" uri "/" body "{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"id\":1}" wait 1ms
    beacon <- exec http status 200 reason "OK" body "{\"jsonrpc\":\"2.0\",\"result\":\"0x8f6f38\",\"id\":1}"
}

compile {
    blockchain_validator_slot_flow(pos_beacon_validator, p2p_peer_validator, execution_rpc_node)
}
