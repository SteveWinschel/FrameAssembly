// Live IP broadcast studio (SMPTE ST 2110) combining IEEE 1588v2 PTP media clock
// synchronization, IGMPv3 and PIM-SM multicast routing, RTSP stream setup, and
// uncompressed RTP video.
// Wire profile: 8 frames; 3 IPv4 hosts; PTP, RTP, RTSP, IGMP, PIM; DSCP 46; waits
// 50us, 100us, 200us, 20us.
// Wireshark: ptp || rtp || rtsp || igmp

host st2110_camera_tx {
    ip 10.211.10.10
    mac 00:1b:21:d3:0a:0a
}

host broadcast_spine_gm {
    ip 10.211.10.1
    mac 00:1c:73:d3:0a:01
}

host vision_mixer_rx {
    ip 10.211.20.50
    mac 00:1b:21:d3:14:32
}

flow smpte_st2110_broadcast_studio(cam, spine, mixer) {
    spine -> cam ptp announce domain 127 wait 50us
    spine -> cam ptp sync domain 127 wait 50us
    spine -> cam ptp followup domain 127 wait 100us
    mixer -> spine igmp report version 3 group 239.211.20.1 wait 100us
    spine -> cam pim joinprune group 239.211.20.1 rp 10.211.10.1 wait 200us
    mixer -> cam rtsp method "DESCRIBE" uri "rtsp://10.211.10.10:554/by-name/cam01-uhd-video" wait 20us
    cam -> mixer dscp 46 rtp pt 96 seq 1 ssrc 0x21100001 marker 0 payload "ST2110_20_YCBCR_422_10BIT_SCANLINE_0001" wait 20us
    cam -> mixer dscp 46 rtp pt 96 seq 2 ssrc 0x21100001 marker 1 payload "ST2110_20_YCBCR_422_10BIT_SCANLINE_2160_EOF"
}

compile {
    smpte_st2110_broadcast_studio(st2110_camera_tx, broadcast_spine_gm, vision_mixer_rx)
}
