// PROMPT: High-availability campus distribution layer combining RSTP loop prevention, VRRP and HSRP first-hop redundancy, and Gratuitous ARP.
// TOKENS: host, ip, mac, flow, pri, vlan, pcp, stp, rstp, rootid, bridgeid, cost, flags, vrrp, vrid, priority, vip, wait, ms, hsrp, group, state, arp, garp, sha, spa, compile

// INSTRUCTION: Define primary distribution switch A (RSTP Root and VRRP/HSRP Active).
host campus_dist_pri {
    ip 10.100.10.2
    mac 00:1c:73:64:0a:02
}

// INSTRUCTION: Define secondary distribution switch B (RSTP Backup and VRRP/HSRP Standby).
host campus_dist_sec {
    ip 10.100.10.3
    mac 00:1c:73:64:0a:03
}

// INSTRUCTION: Define access layer switch uplink receiving FHRP and RSTP control frames.
host campus_access_sw {
    ip 10.100.10.10
    mac 00:1c:73:64:0a:0a
}

// INSTRUCTION: Define RSTP convergence, VRRP VRID 10 advertisement, HSRP Group 20 hello, and VIP Gratuitous ARP.
flow campus_ha_fhrp_stp(pri, sec, acc) {
    pri -> acc vlan 10 pcp 7 stp rstp rootid "4096:00:1c:73:64:0a:02" bridgeid "4096:00:1c:73:64:0a:02" cost 0 flags 60
    pri -> sec vlan 10 pcp 6 vrrp vrid 10 priority 150 vip 10.100.10.1 wait 2ms
    sec -> pri vlan 20 pcp 6 hsrp group 20 priority 110 state 16 vip 10.100.20.1 wait 2ms
    pri -> acc vlan 10 pcp 6 arp garp sha 00:00:5e:00:01:0a spa 10.100.10.1 wait 2ms
}

// INSTRUCTION: Compile block executing campus RSTP, VRRP, HSRP, and GARP redundancy topology.
compile {
    campus_ha_fhrp_stp(campus_dist_pri, campus_dist_sec, campus_access_sw)
}
