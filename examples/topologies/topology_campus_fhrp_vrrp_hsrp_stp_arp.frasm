// High-availability campus distribution layer combining RSTP loop prevention,
// VRRP and HSRP first-hop redundancy, and Gratuitous ARP.
// Wire profile: 4 frames; 3 IPv4 hosts; VLAN 10,20; PCP 6,7; VRRP, HSRP, ARP,
// STP; waits 2ms.
// Wireshark: vrrp || hsrp || arp || stp

host campus_dist_pri {
    ip 10.100.10.2
    mac 00:1c:73:64:0a:02
}

host campus_dist_sec {
    ip 10.100.10.3
    mac 00:1c:73:64:0a:03
}

host campus_access_sw {
    ip 10.100.10.10
    mac 00:1c:73:64:0a:0a
}

flow campus_ha_fhrp_stp(pri, sec, acc) {
    pri -> acc vlan 10 pcp 7 stp rstp rootid "4096:00:1c:73:64:0a:02" bridgeid "4096:00:1c:73:64:0a:02" cost 0 flags 60 wait 2ms
    pri -> sec vlan 10 pcp 6 vrrp vrid 10 priority 150 vip 10.100.10.1 wait 2ms
    sec -> pri vlan 20 pcp 6 hsrp group 20 priority 110 state 16 vip 10.100.20.1 wait 2ms
    pri -> acc vlan 10 pcp 6 arp garp sha 00:00:5e:00:01:0a spa 10.100.10.1
}

compile {
    campus_ha_fhrp_stp(campus_dist_pri, campus_dist_sec, campus_access_sw)
}
