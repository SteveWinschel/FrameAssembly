// Enterprise Wi-Fi 6E fast roaming workflow combining 802.1X EAPOL 4-way
// handshake, RADIUS interim accounting, UDP CAPWAP wireless controller tunnel,
// DHCP renewal, and mDNS discovery.
// Wire profile: 8 frames; 3 IPv4 hosts; mDNS, DHCP, RADIUS, EAPOL, UDP; dstport
// 5246; waits 1ms.
// Wireshark: mdns || (dhcp || dhcpv6) || radius || eapol

host wifi6e_roaming_client {
    ip 10.72.16.88
    mac a4:83:e7:48:10:58
}

host wifi6e_target_ap {
    ip 10.72.0.32
    mac 00:27:e3:48:00:20
}

host campus_wlc_core {
    ip 10.72.0.1
    mac 00:1e:bd:48:00:01
}

flow wifi6e_fast_roaming_flow(cli, ap, wlc) {
    ap -> cli eapol version 2 type key wait 1ms
    cli -> ap eapol version 2 type key wait 1ms
    ap -> wlc radius accountingrequest id 77 user "tablet_exec04" wait 1ms
    ap <- wlc radius accountingresponse id 77 wait 1ms
    ap -> wlc udp dstport 5246 payload "CAPWAP_MOBILITY_ROAM_HANDOFF_PMK_R1_CACHED" wait 1ms
    cli -> wlc dhcp request ciaddr 10.72.16.88 wait 1ms
    cli -> ap mdns qname "_ipp._tcp.local" wait 1ms
    ap -> cli mdns qname "_ipp._tcp.local" rdata "printer-fl3.local"
}

compile {
    wifi6e_fast_roaming_flow(wifi6e_roaming_client, wifi6e_target_ap, campus_wlc_core)
}
