// PROMPT: Global Anycast CDN edge PoP combining BGP Anycast prefix announcement, DNS GeoIP resolution, QUIC/HTTP3 client delivery, and TLS 1.3 origin shield cache fill.
// TOKENS: host, ip, flow, bgp, update, prefix, nexthop, dns, query, qname, qtype, wait, ms, response, rdata, quic, initial, dcid, scid, short, payload, tls, clienthello, sni, serverhello, compile

// INSTRUCTION: Define end-user browser client requesting media asset.
host eyeball_client { ip 198.51.100.88 }

// INSTRUCTION: Define Anycast CDN edge PoP server and authoritative DNS responder.
host anycast_cdn_edge { ip 203.0.113.1 }

// INSTRUCTION: Define upstream origin shield storage server.
host origin_shield_srv { ip 192.0.2.200 }

// INSTRUCTION: Define BGP Anycast route update, DNS lookup, QUIC HTTP/3 request, and TLS 1.3 / HTTP/2 origin fetch.
flow anycast_cdn_cache_miss_flow(client, edge, origin) {
    edge -> origin bgp update prefix "203.0.113.0/24" nexthop 203.0.113.1
    client -> edge dns query qname "cdn.video-stream.io" qtype "a" wait 1ms
    client <- edge dns response qname "cdn.video-stream.io" qtype "a" rdata "203.0.113.1" wait 1ms
    client -> edge quic initial dcid 0x9988776655443322 scid 0x1122334455667788 wait 1ms
    client -> edge quic short dcid 0x9988776655443322 payload "HTTP3_GET_SEGMENT_1080P_0042.M4S" wait 1ms
    edge -> origin tls clienthello sni "origin.video-stream.io" wait 1ms
    edge <- origin tls serverhello wait 1ms
    edge -> origin http2 headers streamid 1 payload "GET /segments/1080p_0042.m4s" wait 1ms
    client <- edge quic short dcid 0x1122334455667788 payload "HTTP3_200_OK_CACHE_MISS_VIDEO_BYTES" wait 2ms
}

// INSTRUCTION: Compile block executing Anycast CDN BGP, DNS, QUIC, TLS, and HTTP/2 topology.
compile {
    anycast_cdn_cache_miss_flow(eyeball_client, anycast_cdn_edge, origin_shield_srv)
}
