// Polyglot persistence data tier combining AMQP event broker, Memcached lookaside
// cache, MySQL read replica, and PostgreSQL primary ledger.
// Wire profile: 8 frames; 5 IPv4 hosts; Memcached, MySQL, PostgreSQL, AMQP; waits
// 500us, 1ms.
// Wireshark: memcache || mysql || pgsql || amqp

host async_worker_svc { ip 10.215.1.10 }

host rabbitmq_broker { ip 10.215.1.20 }

host memcached_node { ip 10.215.1.30 }

host mysql_replica_db { ip 10.215.1.40 }

host postgres_primary_db { ip 10.215.1.50 }

flow polyglot_data_tier_flow(wrk, mq, mc, my, pg) {
    mq -> wrk amqp basicdeliver channel 1 routingkey "billing.invoice.created" wait 500us
    wrk -> mc memcached cmd "get" key "customer:profile:8812" wait 1ms
    wrk -> my mysql sql "SELECT tier, discount FROM customer_profiles WHERE id = 8812;" wait 1ms
    wrk <- my mysql ok wait 500us
    wrk -> mc memcached cmd "set" key "customer:profile:8812" exptime 3600 payload "{\"tier\":\"enterprise\"}" wait 1ms
    wrk -> pg postgres sql "UPDATE invoices SET finalized = true WHERE cust_id = 8812;" wait 1ms
    wrk <- pg postgres commandcomplete wait 500us
    wrk -> mq amqp basicpublish channel 1 routingkey "billing.invoice.finalized"
}

compile {
    polyglot_data_tier_flow(async_worker_svc, rabbitmq_broker, memcached_node, mysql_replica_db, postgres_primary_db)
}
