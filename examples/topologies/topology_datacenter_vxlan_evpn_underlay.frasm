// PROMPT: Data center network fabric running BGP-EVPN control plane with VXLAN encapsulation over IPv6 underlay.
// TOKENS: host, ip, flow, v1, v2, bgp, open, asn, holdtime, bgpid, vxlan, vni, compile

// INSTRUCTION: Define data center VTEP switch 1 over IPv6.
host v6_vtep1 { ip 2001:db8:dc::1 }

// INSTRUCTION: Define data center VTEP switch 2 over IPv6.
host v6_vtep2 { ip 2001:db8:dc::2 }

// INSTRUCTION: Define BGP EVPN control plane and VXLAN overlay flow.
flow evpn_underlay_flow(v1, v2) {
    v1 -> v2 bgp open asn 65100 holdtime 90 bgpid 10.0.0.1
    v1 -> v2 vxlan vni 50001
}

// INSTRUCTION: Compile block executing EVPN and VXLAN data fabric.
compile {
    evpn_underlay_flow(v6_vtep1, v6_vtep2)
}
