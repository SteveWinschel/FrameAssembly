// PROMPT: Carrier DDoS mitigation scrubbing center combining sFlow and NetFlow volumetric anomaly detection, BGP traffic diversion update, and clean GRE return tunnel.
// TOKENS: host, ip, flow, sflow, version, agentip, subagentid, seqnum, uptime, samples, netflow, srcip, dstip, packets, octets, proto, wait, ms, bgp, update, prefix, nexthop, gre, checksum, compile

// INSTRUCTION: Define transit border router exporting sFlow and NetFlow telemetry.
host transit_border_rtr { ip 198.51.100.1 }

// INSTRUCTION: Define DDoS mitigation scrubbing appliance and BGP controller.
host ddos_scrubber_appliance { ip 198.51.100.250 }

// INSTRUCTION: Define protected enterprise authoritative DNS server.
host protected_dns_srv { ip 203.0.113.53 }

// INSTRUCTION: Define sFlow/NetFlow volumetric spike detection, BGP /32 diversion announcement, and clean GRE injection.
flow carrier_ddos_scrubbing_workflow(border, scrubber, victim) {
    border -> scrubber sflow version 5 agentip 198.51.100.1 subagentid 1 seqnum 4001 uptime 990000 samples 12
    border -> scrubber netflow version 9 srcip 192.0.2.99 dstip 203.0.113.53 packets 500000 octets 700000000 proto 17 wait 1ms
    scrubber -> border bgp update prefix "203.0.113.53/32" nexthop 198.51.100.250 wait 1ms
    scrubber -> border gre checksum grekey 7700 greseq 101 wait 1ms
    scrubber -> victim dns query qname "legitimate.customer-portal.com" wait 1ms
}

// INSTRUCTION: Compile block executing carrier DDoS sFlow, NetFlow, BGP diversion, and GRE scrubbing topology.
compile {
    carrier_ddos_scrubbing_workflow(transit_border_rtr, ddos_scrubber_appliance, protected_dns_srv)
}
