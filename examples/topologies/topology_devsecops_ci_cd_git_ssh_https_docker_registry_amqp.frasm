// DevSecOps CI/CD container build pipeline combining SSH git push, AMQP build
// worker dispatch, TLS 1.3 and HTTP/2 OCI registry push, and gRPC Kubernetes
// rollout.
// Wire profile: 8 frames; 3 IPv4 hosts; SSH, HTTP/2, gRPC, TLS, AMQP; waits 1ms,
// 2ms.
// Wireshark: ssh || http2 || (grpc || http2) || tls

host git_ci_controller { ip 10.165.10.10 }

host ci_build_runner { ip 10.165.10.50 }

host oci_registry_k8s { ip 10.165.20.100 }

flow devsecops_cicd_pipeline_flow(git, runner, k8s) {
    git -> runner ssh banner "SSH-2.0-GitLab-SSHD" wait 1ms
    git <- runner ssh kexinit newkeys wait 1ms
    git -> runner amqp basicpublish channel 1 routingkey "ci.jobs.container_build" wait 1ms
    runner <- git amqp basicdeliver channel 1 routingkey "ci.jobs.container_build" wait 1ms
    runner -> k8s tls clienthello sni "registry.internal.io" wait 1ms
    runner <- k8s tls serverhello wait 2ms
    runner -> k8s http2 headers streamid 1 payload "PUT /v2/payments/blobs/uploads/sha256:9f86d08" wait 1ms
    runner -> k8s grpc service "deploy.v1.RolloutController" method "ApplyManifest" grpcstatus 0 payload "{\"image\":\"registry.internal.io/payments:v1.4.2\"}"
}

compile {
    devsecops_cicd_pipeline_flow(git_ci_controller, ci_build_runner, oci_registry_k8s)
}
