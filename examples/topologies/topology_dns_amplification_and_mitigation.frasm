// Simulate a UDP DNS ANY amplification attack against a victim server followed by
// an automated DDoS scrubbing center BGP FlowSpec mitigation rule and SNMPv2c
// trap.
// Wire profile: 7 frames; 4 IPv4 hosts; SNMPv2c, TCP, UDP; TCP flags ACK/PSH;
// dstport 179,44123; waits 1ms, 5ms.
// Wireshark: snmp || tcp || udp

host open_dns_resolver { ip 198.51.100.53 mac 00:11:22:94:00:53 }

host ddos_victim { ip 192.0.2.100 mac 00:11:22:94:01:00 }

host mitigation_ctrl { ip 10.94.0.10 mac 00:11:22:94:00:10 }

host border_scrubber { ip 10.94.0.1 mac 00:11:22:94:00:01 }

flow dns_amplification_wave(resolver, victim) {
    resolver -> victim udp srcport 53 dstport 44123 payload "DNS_RRSIG_DNSKEY_ANY_AMPLIFIED_4096B"
        wait 1ms
}

flow trigger_flowspec_mitigation(ctrl, router) {
    ctrl -> router tcp psh ack srcport 50179 dstport 179 payload "BGP_FLOWSPEC_DROP_UDP_SRC53_DST_192.0.2.100" wait 5ms
    ctrl -> router snmp2 trap community "ddos_soc" oid 1.3.6.1.4.1.9999.94.1
        sysuptime 650000
        varbind 1.3.6.1.4.1.9999.94.1.1 ipval 192.0.2.100
        varbind 1.3.6.1.4.1.9999.94.1.2 gauge32 10000000
        varbind 1.3.6.1.4.1.9999.94.1.3 string "MITIGATED_UDP_53_AMP"
}

compile {
    dns_amplification_wave(open_dns_resolver, ddos_victim) // Iteration 1 of 5
    dns_amplification_wave(open_dns_resolver, ddos_victim) // Iteration 2 of 5
    dns_amplification_wave(open_dns_resolver, ddos_victim) // Iteration 3 of 5
    dns_amplification_wave(open_dns_resolver, ddos_victim) // Iteration 4 of 5
    dns_amplification_wave(open_dns_resolver, ddos_victim) // Iteration 5 of 5
    trigger_flowspec_mitigation(mitigation_ctrl, border_scrubber)
}
