// PROMPT: Multi-tier web service deployment resolving DNS records followed by TLS 1.3 and HTTP/2 session establishment.
// TOKENS: host, ip, flow, dns, query, qname, tls, clienthello, sni, http2, settings, compile

// INSTRUCTION: Define user web client.
host user_agent { ip 192.168.1.50 }

// INSTRUCTION: Define local DNS resolver.
host dns_server { ip 192.168.1.1 }

// INSTRUCTION: Define edge web application server.
host web_server { ip 192.168.1.80 }

// INSTRUCTION: Define multi-tier web service access flow.
flow web_access_flow(u, d, w) {
    u -> d dns query qname "www.example.com"
    u -> w tls clienthello sni "www.example.com"
    u -> w http2 settings
}

// INSTRUCTION: Compile block executing multi-tier web flow.
compile {
    web_access_flow(user_agent, dns_server, web_server)
}
