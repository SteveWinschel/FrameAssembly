// PROMPT: Kubernetes dual-stack service mesh traffic routing between microservices via HTTP/2 and gRPC.
// TOKENS: host, ip, flow, s, http2, settings, grpc, service, method, compile

// INSTRUCTION: Define frontend pod on IPv4.
host pod_frontend { ip 10.244.0.15 }

// INSTRUCTION: Define auth service virtual IP on IPv4.
host svc_auth_v4 { ip 10.96.0.100 }

// INSTRUCTION: Define frontend pod on IPv6.
host pod_v6 { ip fd00:10:244::15 }

// INSTRUCTION: Define auth service virtual IP on IPv6.
host svc_auth_v6 { ip fd00:10:96::100 }

// INSTRUCTION: Define service mesh gRPC call flow.
flow mesh_rpc(c, s) {
    c -> s http2 settings
    c -> s grpc service "AuthService" method "VerifyToken"
}

// INSTRUCTION: Compile block executing service mesh traffic across dual-stack clusters.
compile {
    mesh_rpc(pod_frontend, svc_auth_v4)
    mesh_rpc(pod_v6, svc_auth_v6)
}
