// PROMPT: Enterprise VoIP deployment combining SIP signaling (DSCP 26), RTP audio streams (DSCP 46), and SNMP telemetry.
// TOKENS: host, ip, flow, s, dscp, sip, invite, rtp, pt, snmp3, trap, user, oid, compile

// INSTRUCTION: Define enterprise IP phone.
host ip_phone { ip 10.20.1.100 }

// INSTRUCTION: Define central PBX call manager.
host pbx_server { ip 10.20.1.1 }

// INSTRUCTION: Define VoIP call signaling, voice media, and telemetry flow.
flow voip_call(p, s) {
    p -> s dscp 26 sip invite
    p <- s dscp 26 sip invite
    p -> s dscp 46 rtp pt 0
    p -> s snmp3 trap user "voip_admin" oid 1.3.6.1.6.3.1.1.5.1
}

// INSTRUCTION: Compile block executing VoIP session.
compile {
    voip_call(ip_phone, pbx_server)
}
