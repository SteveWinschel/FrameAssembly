// Enterprise VoIP deployment combining SIP signaling (DSCP 26), RTP audio streams
// (DSCP 46), and SNMP telemetry.
// Wire profile: 4 frames; 2 IPv4 hosts; SNMPv3, SIP, RTP; DSCP 26,46.
// Wireshark: snmp || sip || rtp

host ip_phone { ip 10.20.1.100 }

host pbx_server { ip 10.20.1.1 }

flow voip_call(p, s) {
    p -> s dscp 26 sip invite
    p <- s dscp 26 sip invite
    p -> s dscp 46 rtp pt 0
    p -> s snmp3 trap user "voip_admin" oid 1.3.6.1.6.3.1.1.5.1
}

compile {
    voip_call(ip_phone, pbx_server)
}
