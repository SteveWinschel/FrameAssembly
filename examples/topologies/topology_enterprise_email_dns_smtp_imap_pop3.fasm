// PROMPT: Enterprise email infrastructure lifecycle covering DNS MX resolution, SMTP message submission, IMAP folder sync, and POP3 retrieval.
// TOKENS: host, ip, flow, dns, qname, qtype, rdata, wait, ms, smtp, ehlo, mailfrom, param, body, code, reply, imap, tag, cmd, arg, payload, pop3, ok, compile

// INSTRUCTION: Define corporate mail user agent (MUA) workstation.
host mail_client_ws { ip 10.40.20.15 }

// INSTRUCTION: Define internal recursive DNS resolver.
host internal_dns_srv { ip 10.40.1.53 }

// INSTRUCTION: Define unified enterprise mail server (SMTP/IMAP/POP3).
host mail_exchange_srv { ip 10.40.1.25 }

// INSTRUCTION: Define DNS MX lookup, SMTP mail submission, IMAP inbox fetch, and legacy POP3 status check.
flow enterprise_email_lifecycle(mua, dns, mta) {
    mua -> dns dns qname "corp.example.com" qtype "mx"
    mua <- dns dns qname "corp.example.com" qtype "mx" rdata "mail.corp.example.com" wait 1ms
    mua -> mta smtp ehlo "ws15.corp.example.com" wait 1ms
    mua -> mta smtp mailfrom param "alice@corp.example.com" body "Subject: Quarterly Report\r\n" wait 2ms
    mua <- mta smtp code 250 reply "2.0.0 OK Queued" wait 1ms
    mua -> mta imap tag "A001" cmd "SELECT" arg "INBOX" wait 2ms
    mua <- mta imap tag "A001" payload "* 12 EXISTS\r\nA001 OK SELECT completed\r\n" wait 1ms
    mua -> mta pop3 cmd "STAT" arg "1" wait 2ms
    mua <- mta pop3 ok wait 1ms
}

// INSTRUCTION: Compile block executing enterprise DNS, SMTP, IMAP, and POP3 mail topology.
compile {
    enterprise_email_lifecycle(mail_client_ws, internal_dns_srv, mail_exchange_srv)
}
