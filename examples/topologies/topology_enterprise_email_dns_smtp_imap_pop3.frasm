// Enterprise email infrastructure lifecycle covering DNS MX resolution, SMTP
// message submission, IMAP folder sync, and POP3 retrieval.
// Wire profile: 9 frames; 3 IPv4 hosts; DNS, SMTP, IMAP, POP3; waits 1ms, 2ms.
// Wireshark: dns || smtp || imap || pop

host mail_client_ws { ip 10.40.20.15 }

host internal_dns_srv { ip 10.40.1.53 }

host mail_exchange_srv { ip 10.40.1.25 }

flow enterprise_email_lifecycle(mua, dns, mta) {
    mua -> dns dns qname "corp.example.com" qtype "mx" wait 1ms
    mua <- dns dns qname "corp.example.com" qtype "mx" rdata "mail.corp.example.com" wait 1ms
    mua -> mta smtp ehlo "ws15.corp.example.com" wait 2ms
    mua -> mta smtp mailfrom param "alice@corp.example.com" body "Subject: Quarterly Report\r\n" wait 1ms
    mua <- mta smtp code 250 reply "2.0.0 OK Queued" wait 2ms
    mua -> mta imap tag "A001" cmd "SELECT" arg "INBOX" wait 1ms
    mua <- mta imap tag "A001" payload "* 12 EXISTS\r\nA001 OK SELECT completed\r\n" wait 2ms
    mua -> mta pop3 cmd "STAT" arg "1" wait 1ms
    mua <- mta pop3 ok
}

compile {
    enterprise_email_lifecycle(mail_client_ws, internal_dns_srv, mail_exchange_srv)
}
