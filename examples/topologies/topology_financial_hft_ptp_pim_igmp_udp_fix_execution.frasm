// Financial high-frequency trading venue combining IEEE 1588v2 PTP nanosecond
// synchronization, IGMPv3 and PIM-SM market data multicast, and TCP FIX
// execution.
// Wire profile: 9 frames; 3 IPv4 hosts; PTP, IGMP, PIM, TCP, UDP; TCP flags
// ACK/PSH; dstport 9800,15000,52100; DSCP 46; waits 50us, 100us, 10us, 5us.
// Wireshark: ptp || igmp || pim || tcp

host hft_fpga_algo {
    ip 10.77.1.100
    mac 00:0f:53:4d:01:64
}

host exchange_ptp_tor {
    ip 10.77.1.1
    mac 00:1c:73:4d:01:01
}

host matching_engine_gw {
    ip 10.77.2.10
    mac 00:1c:73:4d:02:0a
}

flow hft_market_data_and_execution(algo, tor, exch) {
    tor -> algo ptp sync domain 0 seqid 9001 wait 50us
    tor -> algo ptp followup domain 0 seqid 9001 wait 50us
    algo -> tor ptp delayreq domain 0 seqid 9001 wait 50us
    tor -> algo ptp delayresp domain 0 seqid 9001 wait 100us
    algo -> tor igmp report version 3 group 239.77.1.50 wait 100us
    tor -> exch pim joinprune group 239.77.1.50 rp 10.77.2.10 wait 10us
    exch -> algo dscp 46 udp srcport 15000 dstport 15000 payload "ITCH50_ADD_ORDER_NVDA_1000_SHARES" wait 5us
    algo -> exch dscp 46 tcp psh ack srcport 52100 dstport 9800 win 65535 payload "8=FIX.4.2|35=D|55=NVDA|54=1|38=1000|40=2|" wait 20us
    algo <- exch dscp 46 tcp psh ack srcport 9800 dstport 52100 win 65535 payload "8=FIX.4.2|35=8|39=2|150=F|55=NVDA|"
}

compile {
    hft_market_data_and_execution(hft_fpga_algo, exchange_ptp_tor, matching_engine_gw)
}
