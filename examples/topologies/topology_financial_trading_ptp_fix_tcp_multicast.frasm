// Electronic financial trading venue topology combining IEEE 1588 PTP nanosecond
// clock sync, multicast UDP market feed, and TCP FIX order entry.
// Wire profile: 5 frames; 3 IPv4 hosts; VLAN 80; PCP 5,6,7; PTP, TCP, UDP; TCP
// flags ACK/PSH; dstport 9876,15000,58100; DSCP 46,56; waits 10us, 20us, 15us,
// 25us.
// Wireshark: ptp || vlan || tcp || udp

host exchange_engine {
    ip 10.8.100.1
    mac 00:0f:53:08:64:01
}

host algo_trader_srv {
    ip 10.8.100.50
    mac 00:0f:53:08:64:32
}

host market_feed_mcast { ip 239.8.100.1 }

flow hft_trading_venue_flow(exch, algo, feed) {
    exch -> algo vlan 80 pcp 7 dscp 56 ptp sync seqid 8801 wait 10us
    exch -> algo vlan 80 pcp 7 dscp 56 ptp followup seqid 8801 wait 20us
    exch -> feed vlan 80 pcp 5 dscp 46 udp srcport 15000 dstport 15000 payload "itch50_add_order_sym_NVDA_px_14050_qty_500" wait 15us
    algo -> exch vlan 80 pcp 6 dscp 46 tcp psh ack srcport 58100 dstport 9876 payload "8=FIX.4.4|35=D|49=ALGO1|56=EXCH|55=NVDA|54=1|38=500|44=140.50|" wait 25us
    algo <- exch vlan 80 pcp 6 dscp 46 tcp psh ack srcport 9876 dstport 58100 payload "8=FIX.4.4|35=8|39=2|150=F|55=NVDA|32=500|31=140.50|"
}

compile {
    hft_trading_venue_flow(exchange_engine, algo_trader_srv, market_feed_mcast)
}
