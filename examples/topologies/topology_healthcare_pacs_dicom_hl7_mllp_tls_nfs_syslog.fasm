// PROMPT: Hospital PACS medical imaging workflow combining TLS 1.3 authentication, TCP HL7 MLLP and DICOM C-STORE transfer, NFSv4 archive storage, and Syslog HIPAA audit.
// TOKENS: host, ip, flow, vlan, pcp, tls, clienthello, sni, serverhello, certificate, finished, wait, ms, tcp, psh, ack, srcport, dstport, win, payload, nfs, vers, proc, tag, path, syslog, compile

// INSTRUCTION: Define MRI scanner modality workstation in radiology VLAN 150.
host mri_modality_ws { ip 10.95.150.20 }

// INSTRUCTION: Define Picture Archiving and Communication System (PACS) DICOM server.
host pacs_imaging_srv { ip 10.95.150.100 }

// INSTRUCTION: Define clinical NFSv4 NAS archive and HIPAA Syslog audit vault.
host hipaa_archive_nas { ip 10.95.200.50 }

// INSTRUCTION: Define TLS mutual handshake, HL7 order check, DICOM C-STORE slice upload, NFSv4 write, and Syslog HIPAA audit event.
flow hospital_pacs_imaging_workflow(mri, pacs, nas) {
    mri -> pacs vlan 150 pcp 4 tls clienthello sni "pacs.hospital.local"
    mri <- pacs vlan 150 pcp 4 tls serverhello certificate finished wait 1ms
    mri -> pacs vlan 150 pcp 4 tcp psh ack srcport 51200 dstport 2575 win 65535 payload "\x0bMSH|^~\\&|MRI01|RAD|PACS|HOSP||ORM^O01|1001|P|2.5\r\x1c\r" wait 1ms
    mri -> pacs vlan 150 pcp 4 tcp psh ack srcport 51201 dstport 104 win 65535 payload "DICOM_C_STORE_RQ_SOP_MR_IMAGE_STORAGE_STUDY_9921" wait 2ms
    pacs -> nas vlan 200 pcp 3 nfs vers 4 proc "compound" tag "dicom_store" path "/archive/studies/9921/slice001.dcm" wait 2ms
    pacs -> nas vlan 200 pcp 5 syslog pri 86 app "pacs-hipaa-audit" msg "DICOM_STUDY_9921_ARCHIVED_ENCRYPTED_AT_REST" wait 1ms
}

// INSTRUCTION: Compile block executing hospital PACS TLS, HL7/DICOM, NFSv4, and Syslog topology.
compile {
    hospital_pacs_imaging_workflow(mri_modality_ws, pacs_imaging_srv, hipaa_archive_nas)
}
