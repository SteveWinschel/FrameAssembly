// Hospital PACS medical imaging workflow combining TLS 1.3 authentication, TCP
// HL7 MLLP and DICOM C-STORE transfer, NFSv4 archive storage, and Syslog HIPAA
// audit.
// Wire profile: 6 frames; 3 IPv4 hosts; VLAN 150,200; PCP 3,4,5; Syslog, TLS,
// NFS, TCP; TCP flags ACK/PSH; dstport 104,2575; waits 1ms, 2ms.
// Wireshark: syslog || tls || nfs || vlan

host mri_modality_ws { ip 10.95.150.20 }

host pacs_imaging_srv { ip 10.95.150.100 }

host hipaa_archive_nas { ip 10.95.200.50 }

flow hospital_pacs_imaging_workflow(mri, pacs, nas) {
    mri -> pacs vlan 150 pcp 4 tls clienthello sni "pacs.hospital.local" wait 1ms
    mri <- pacs vlan 150 pcp 4 tls serverhello certificate finished wait 1ms
    mri -> pacs vlan 150 pcp 4 tcp psh ack srcport 51200 dstport 2575 win 65535 payload "\x0bMSH|^~\\&|MRI01|RAD|PACS|HOSP||ORM^O01|1001|P|2.5\r\x1c\r" wait 2ms
    mri -> pacs vlan 150 pcp 4 tcp psh ack srcport 51201 dstport 104 win 65535 payload "DICOM_C_STORE_RQ_SOP_MR_IMAGE_STORAGE_STUDY_9921" wait 2ms
    pacs -> nas vlan 200 pcp 3 nfs vers 4 proc "compound" tag "dicom_store" path "/archive/studies/9921/slice001.dcm" wait 1ms
    pacs -> nas vlan 200 pcp 5 syslog pri 86 app "pacs-hipaa-audit" msg "DICOM_STUDY_9921_ARCHIVED_ENCRYPTED_AT_REST"
}

compile {
    hospital_pacs_imaging_workflow(mri_modality_ws, pacs_imaging_srv, hipaa_archive_nas)
}
