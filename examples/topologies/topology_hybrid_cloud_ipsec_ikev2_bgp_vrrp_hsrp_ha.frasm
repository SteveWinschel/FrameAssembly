// Hybrid cloud direct connect HA failover combining VRRP and HSRP LAN gateway
// redundancy, IKEv2/ESP IPsec backup tunnel, BGP route convergence, and BFD.
// Wire profile: 7 frames; 3 IPv4 hosts; ESP, IKEv2, BGP, VRRP, HSRP (+1 more);
// waits 1ms, 2ms.
// Wireshark: esp || isakmp || bgp || vrrp

host onprem_edge_pri { ip 192.0.2.10 }

host onprem_edge_sec { ip 192.0.2.11 }

host cloud_transit_gw { ip 198.51.100.1 }

flow hybrid_cloud_ha_failover(pri, sec, cloud) {
    pri -> sec vrrp vrid 10 priority 150 advint 1 vip 192.0.2.1 wait 1ms
    pri -> sec hsrp group 10 priority 150 hellotime 3 state 16 vip 192.0.2.254 wait 1ms
    pri -> cloud bfd mydisc 501 yourdisc 601 mintx 100000 minrx 100000 mult 3 wait 2ms
    sec -> cloud ikev2 sainit initiatorspi 0xa1b2c3d4e5f60718 responderspi 0x0000000000000000 msgid 0 wait 2ms
    sec <- cloud ikev2 sainit initiatorspi 0xa1b2c3d4e5f60718 responderspi 0x1122334455667788 msgid 0 wait 1ms
    sec -> cloud esp spi 0x9001 seq 1 wait 1ms
    sec -> cloud bgp update prefix "10.100.0.0/16" nexthop 192.0.2.11
}

compile {
    hybrid_cloud_ha_failover(onprem_edge_pri, onprem_edge_sec, cloud_transit_gw)
}
