// PROMPT: Simulate an Industrial Control System (ICS/SCADA) HMI polling a Programmable Logic Controller (PLC) over Modbus/TCP port 502 alongside SNMPv1 and SNMPv2c thermal alerts.
// TOKENS: host, ip, mac, flow, tcp, syn, srcport, dstport, wait, ms, ack, psh, payload, snmp1, trap, community, enterprise, agentip, gentrap, spectrap, sysuptime, varbind, string, int, snmp2, compile

// INSTRUCTION: Define the SCADA HMI master station with IP 192.168.200.10.
host scada_hmi { ip 192.168.200.10 mac 00:0e:8c:95:00:10 }

// INSTRUCTION: Define an industrial Modbus/TCP PLC controller with IP 192.168.200.50.
host modbus_plc { ip 192.168.200.50 mac 00:0e:8c:95:00:50 }

// INSTRUCTION: Define an industrial Ethernet switch monitoring cabinet temperature with IP 192.168.200.2.
host din_rail_switch { ip 192.168.200.2 mac 00:0e:8c:95:00:02 }

// INSTRUCTION: Define a 3-host flow combining Modbus/TCP Function Code 03 holding register reads with industrial SNMPv1 and SNMPv2c traps.
flow scada_plc_and_snmp(hmi, plc, ind_sw) {
    hmi -> plc tcp syn srcport 50502 dstport 502 wait 5ms
    hmi <- plc tcp syn ack srcport 502 dstport 50502 wait 5ms
    hmi -> plc tcp ack srcport 50502 dstport 502 wait 2ms
    hmi -> plc tcp psh ack srcport 50502 dstport 502 payload "MODBUS_TCP_TID01_FC03_READ_REG_40001"
        wait 10ms
    hmi <- plc tcp psh ack srcport 502 dstport 50502 payload "MODBUS_TCP_TID01_FC03_RESP_VAL_1450RPM"
        wait 10ms
    ind_sw -> hmi snmp1 trap community "scada_public" enterprise 1.3.6.1.4.1.4329
        agentip 192.168.200.2 gentrap 6 spectrap 12 sysuptime 880000
        varbind 1.3.6.1.4.1.4329.1.1.0 string "DIN-Rail Cabinet High Temp"
        varbind 1.3.6.1.4.1.4329.1.2.0 int 72
        wait 10ms
    plc -> hmi snmp2 trap community "scada_public" oid 1.3.6.1.4.1.4329.2.0.1
        sysuptime 880050
        varbind 1.3.6.1.4.1.4329.2.1.0 gauge32 1450
        wait 10ms
}

// INSTRUCTION: Compile block to execute the ICS SCADA Modbus and SNMP monitoring flow.
compile {
    scada_plc_and_snmp(scada_hmi, modbus_plc, din_rail_switch)
}
