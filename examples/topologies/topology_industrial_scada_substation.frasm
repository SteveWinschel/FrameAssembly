// Power grid electrical substation automation integrating Modbus, DNP3, and
// S7comm telemetry.
// Wire profile: 3 frames; 2 IPv4 hosts; Modbus, DNP3, S7comm.
// Wireshark: modbus || dnp3 || s7comm

host scada_hmi { ip 10.50.0.10 }

host feeder_relay { ip 10.50.0.100 }

flow substation_scada(hmi, relay) {
    hmi -> relay modbus func readholdingregisters
    hmi -> relay dnp3 func read
    hmi -> relay s7comm func readvar
}

compile {
    substation_scada(scada_hmi, feeder_relay)
}
