// PROMPT: ISP Broadband Network Gateway (BNG) subscriber onboarding combining QinQ double tagging, DHCPv4, RADIUS AAA, and MPLS core transit.
// TOKENS: host, ip, mac, flow, qinq, innervlan, dhcp, discover, radius, accessrequest, user, wait, ms, accessaccept, offer, yiaddr, accountingrequest, mpls, exp, bos, mplsttl, http, get, uri, compile

// INSTRUCTION: Define residential FTTH ONT subscriber CPE.
host ftth_cpe_home {
    ip 100.64.10.50
    mac 48:57:02:0a:00:32
}

// INSTRUCTION: Define ISP Broadband Network Gateway (BNG) edge router.
host isp_bng_router {
    ip 100.64.0.1
    mac 00:05:85:b0:00:01
}

// INSTRUCTION: Define ISP RADIUS AAA and billing server.
host isp_radius_aaa {
    ip 172.20.10.5
    mac 00:50:56:14:0a:05
}

// INSTRUCTION: Define ISP MPLS core transit router.
host isp_mpls_core {
    ip 172.20.0.1
    mac 00:05:85:c0:00:01
}

// INSTRUCTION: Define subscriber QinQ DHCP discovery, RADIUS subscriber authorization, and MPLS-labeled Internet traffic.
flow isp_bng_subscriber_flow(cpe, bng, aaa, core) {
    cpe -> bng qinq 1100 innervlan 50 dhcp discover
    bng -> aaa radius accessrequest user "sub_ftth_1100_50@isp.net" wait 1ms
    bng <- aaa radius accessaccept user "sub_ftth_1100_50@isp.net" wait 2ms
    cpe <- bng qinq 1100 innervlan 50 dhcp offer yiaddr 100.64.10.50 wait 1ms
    bng -> aaa radius accountingrequest user "sub_ftth_1100_50@isp.net" wait 1ms
    bng -> core mpls 40100 exp 3 bos 1 mplsttl 64 http get uri "/speedtest" wait 2ms
}

// INSTRUCTION: Compile block executing ISP BNG QinQ, RADIUS, DHCP, and MPLS workflow.
compile {
    isp_bng_subscriber_flow(ftth_cpe_home, isp_bng_router, isp_radius_aaa, isp_mpls_core)
}
