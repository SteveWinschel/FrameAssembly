// ISP Broadband Network Gateway (BNG) subscriber onboarding combining QinQ double
// tagging, DHCPv4, RADIUS AAA, and MPLS core transit.
// Wire profile: 6 frames; 4 IPv4 hosts; QinQ S-VLAN 1100 / C-VLAN 50; MPLS label
// 40100; DHCP, RADIUS, HTTP; waits 1ms, 2ms.
// Wireshark: (dhcp || dhcpv6) || radius || http || (eth.type == 0x88a8 || vlan)

host ftth_cpe_home {
    ip 100.64.10.50
    mac 48:57:02:0a:00:32
}

host isp_bng_router {
    ip 100.64.0.1
    mac 00:05:85:b0:00:01
}

host isp_radius_aaa {
    ip 172.20.10.5
    mac 00:50:56:14:0a:05
}

host isp_mpls_core {
    ip 172.20.0.1
    mac 00:05:85:c0:00:01
}

flow isp_bng_subscriber_flow(cpe, bng, aaa, core) {
    cpe -> bng qinq 1100 innervlan 50 dhcp discover wait 1ms
    bng -> aaa radius accessrequest user "sub_ftth_1100_50@isp.net" wait 2ms
    bng <- aaa radius accessaccept user "sub_ftth_1100_50@isp.net" wait 1ms
    cpe <- bng qinq 1100 innervlan 50 dhcp offer yiaddr 100.64.10.50 wait 1ms
    bng -> aaa radius accountingrequest user "sub_ftth_1100_50@isp.net" wait 2ms
    bng -> core mpls 40100 exp 3 bos 1 mplsttl 64 http get uri "/speedtest"
}

compile {
    isp_bng_subscriber_flow(ftth_cpe_home, isp_bng_router, isp_radius_aaa, isp_mpls_core)
}
