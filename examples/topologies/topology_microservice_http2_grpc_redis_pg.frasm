// PROMPT: Cloud-native e-commerce microservice transaction across HTTP/2 API gateway, gRPC order service, Redis cache, and PostgreSQL database.
// TOKENS: host, ip, flow, redis, http2, headers, streamid, payload, cmd, args, wait, us, replytype, postgres, sql, ms, commandcomplete, grpc, service, method, grpcstatus, compile

// INSTRUCTION: Define ingress Envoy HTTP/2 API Gateway pod.
host envoy_api_gw { ip 10.244.10.5 }

// INSTRUCTION: Define gRPC Order Processing microservice pod.
host order_grpc_svc { ip 10.244.10.20 }

// INSTRUCTION: Define Redis in-memory inventory cache cluster node.
host redis_inv_cache { ip 10.244.10.50 }

// INSTRUCTION: Define PostgreSQL primary transactional database node.
host pg_ledger_db { ip 10.244.10.100 }

// INSTRUCTION: Define end-to-end checkout distributed trace across HTTP/2, gRPC, Redis, and PostgreSQL.
flow ecommerce_microservice_trace(gw, order, redis, pg) {
    gw -> order http2 headers streamid 1 payload "POST /checkout.v1.OrderService/CreateOrder"
    order -> redis redis cmd "DECRBY" args "sku:gpu-h200:stock 1" wait 500us
    order <- redis redis replytype "integer" payload ":41\r\n" wait 500us
    order -> pg postgres sql "INSERT INTO orders (id, sku, status) VALUES (9001, 'gpu-h200', 'PAID');" wait 1ms
    order <- pg postgres commandcomplete wait 1ms
    gw <- order grpc service "checkout.v1.OrderService" method "CreateOrder" grpcstatus 0 payload "{\"order_id\":9001}" wait 500us
}

// INSTRUCTION: Compile block executing cloud-native microservice transaction topology.
compile {
    ecommerce_microservice_trace(envoy_api_gw, order_grpc_svc, redis_inv_cache, pg_ledger_db)
}
