// Cloud-native e-commerce microservice transaction across HTTP/2 API gateway,
// gRPC order service, Redis cache, and PostgreSQL database.
// Wire profile: 6 frames; 4 IPv4 hosts; HTTP/2, gRPC, Redis, PostgreSQL; waits
// 500us, 1ms.
// Wireshark: http2 || (grpc || http2) || resp || pgsql

host envoy_api_gw { ip 10.244.10.5 }

host order_grpc_svc { ip 10.244.10.20 }

host redis_inv_cache { ip 10.244.10.50 }

host pg_ledger_db { ip 10.244.10.100 }

flow ecommerce_microservice_trace(gw, order, redis, pg) {
    gw -> order http2 headers streamid 1 payload "POST /checkout.v1.OrderService/CreateOrder" wait 500us
    order -> redis redis cmd "DECRBY" args "sku:gpu-h200:stock 1" wait 500us
    order <- redis redis replytype "integer" payload ":41\r\n" wait 1ms
    order -> pg postgres sql "INSERT INTO orders (id, sku, status) VALUES (9001, 'gpu-h200', 'PAID');" wait 1ms
    order <- pg postgres commandcomplete wait 500us
    gw <- order grpc service "checkout.v1.OrderService" method "CreateOrder" grpcstatus 0 payload "{\"order_id\":9001}"
}

compile {
    ecommerce_microservice_trace(envoy_api_gw, order_grpc_svc, redis_inv_cache, pg_ledger_db)
}
