// Out-of-band network management bastion workflow using TACACS+ AAA
// authorization, SSH and Telnet CLI access, and TFTP running-config archive.
// Wire profile: 9 frames; 3 IPv4 hosts; TACACS+, TFTP, SSH, Telnet; waits 1ms,
// 2ms.
// Wireshark: tacacs || tftp || ssh || telnet

host neteng_jumpbox { ip 10.254.100.10 }

host managed_core_rtr { ip 10.254.100.1 }

host tacacs_tftp_vault { ip 10.254.100.200 }

flow oob_network_admin_workflow(eng, rtr, vault) {
    eng -> rtr ssh banner "SSH-2.0-OpenSSH_9.7" wait 1ms
    eng <- rtr ssh kexinit wait 1ms
    rtr -> vault tacacs authen sessionid 0x88001122 user "netadmin_steve" wait 1ms
    rtr -> vault tacacs author sessionid 0x88001122 user "netadmin_steve" wait 2ms
    rtr -> vault tftp wrq filename "core-rtr-01-running-cfg" mode "octet" wait 1ms
    rtr -> vault tftp block 1 wait 1ms
    rtr -> vault tacacs acct sessionid 0x88001122 user "netadmin_steve" wait 2ms
    eng -> rtr telnet will 3 wait 1ms
    eng <- rtr telnet do 3
}

compile {
    oob_network_admin_workflow(neteng_jumpbox, managed_core_rtr, tacacs_tftp_vault)
}
