// Industrial Purdue Model (Levels 1-3) OT/ICS factory floor combining Siemens
// S7comm, EtherNet/IP CIP, and OPC UA historian aggregation.
// Wire profile: 5 frames; 4 IPv4 hosts; VLAN 101,102; PCP 4,6; S7comm,
// EtherNet/IP, OPC UA; waits 2ms, 3ms.
// Wireshark: s7comm || enip || opcua || vlan

host l1_siemens_plc {
    ip 192.168.101.10
    mac 00:0e:8c:65:00:0a
}

host l1_ab_controllogix {
    ip 192.168.101.20
    mac 00:00:bc:65:00:14
}

host l2_scada_gateway {
    ip 192.168.101.1
    mac 00:1b:21:65:00:01
}

host l3_plant_historian {
    ip 192.168.101.200
    mac 00:50:56:65:00:c8
}

flow purdue_ot_factory_flow(s7_plc, ab_plc, scada, hist) {
    scada -> s7_plc vlan 101 pcp 6 s7comm rosctr "job" func "setupcomm" pduref 1 wait 2ms
    scada -> s7_plc vlan 101 pcp 6 s7comm rosctr "job" func "readvar" area 0x84 dbnum 1 offset 0 count 16 wait 2ms
    scada -> ab_plc vlan 101 pcp 6 ethernetip cmd "REGISTER_SESSION" sessionhandle 1 wait 2ms
    scada -> ab_plc vlan 101 pcp 6 ethernetip cmd "SEND_RR_DATA" sessionhandle 1 cipservice 0x0e cipclass 0x04 cipinstance 100 cipattr 3 wait 3ms
    scada -> hist vlan 102 pcp 4 opcua chunktype "f" endpointurl "opc.tcp://historian.plant.local:4840" nodeid "ns=2;s=Line1.Throughput"
}

compile {
    purdue_ot_factory_flow(l1_siemens_plc, l1_ab_controllogix, l2_scada_gateway, l3_plant_historian)
}
