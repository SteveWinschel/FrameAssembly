// Secure Access Service Edge (SASE) topology combining WireGuard encrypted branch
// mesh with QUIC/HTTP3 and DNS cloud security inspection.
// Wire profile: 8 frames; 3 IPv4 hosts; DNS, QUIC, WireGuard; waits 2ms, 1ms.
// Wireshark: dns || quic || wg

host sase_branch_cpe { ip 198.18.10.50 }

host sase_cloud_pop { ip 198.18.10.1 }

host saas_quic_origin { ip 198.18.20.100 }

flow sase_wireguard_quic_flow(cpe, pop, saas) {
    cpe -> pop wireguard initiation sender 0x1001 receiver 0 wait 2ms
    cpe <- pop wireguard data sender 0x2001 receiver 0x1001 counter 1 wait 1ms
    cpe -> pop wireguard data sender 0x1001 receiver 0x2001 counter 1 wait 1ms
    cpe -> pop dns qname "app.enterprise-saas.io" wait 1ms
    cpe <- pop dns qname "app.enterprise-saas.io" rdata "198.18.20.100" wait 1ms
    pop -> saas quic initial dcid 0xaabbccddeeff0011 scid 0x1122334455667788 wait 2ms
    pop <- saas quic handshake dcid 0x1122334455667788 scid 0xaabbccddeeff0011 wait 1ms
    pop -> saas quic short dcid 0xaabbccddeeff0011 payload "HTTP3_GET_API_DASHBOARD"
}

compile {
    sase_wireguard_quic_flow(sase_branch_cpe, sase_cloud_pop, saas_quic_origin)
}
