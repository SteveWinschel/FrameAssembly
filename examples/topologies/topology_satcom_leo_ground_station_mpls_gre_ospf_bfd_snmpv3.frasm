// Low-Earth-Orbit (LEO) satellite ground station gateway handover combining BFD
// link tracking, OSPF dynamic metric update, GRE/MPLS backhaul, and SNMPv3 USM
// telemetry.
// Wire profile: 5 frames; 3 IPv4 hosts; MPLS label 18001; SNMPv3, GRE, OSPF, BFD;
// waits 1ms, 2ms.
// Wireshark: snmp || gre || ospf || bfd

host leo_terminal_rtr { ip 10.175.1.10 }

host ground_station_alpha { ip 10.175.1.1 }

host satcom_noc_mgr { ip 10.175.100.50 }

flow leo_satcom_beam_handover(term, gs, noc) {
    term -> gs bfd mydisc 701 yourdisc 702 mintx 25000 wait 1ms
    term <- gs bfd mydisc 702 yourdisc 701 mintx 25000 wait 1ms
    term -> gs ospf lsu routerid 10.175.1.10 areaid 0 wait 1ms
    term -> gs mpls 18001 exp 5 bos 1 gre grekey 9001 wait 2ms
    gs -> noc snmp3 inform user "satnoc_sec" engineid "80001f888011223344" auth sha256 "SatAuthKey2026!" priv aes "SatPrivKey2026!"
}

compile {
    leo_satcom_beam_handover(leo_terminal_rtr, ground_station_alpha, satcom_noc_mgr)
}
