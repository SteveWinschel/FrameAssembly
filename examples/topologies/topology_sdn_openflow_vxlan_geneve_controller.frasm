// Software-Defined Networking (SDN) OpenFlow 1.3 controller programming flow
// tables on VXLAN and GENEVE virtual tunnel switches.
// Wire profile: 8 frames; 3 IPv4 hosts; VXLAN, GENEVE, OpenFlow; waits 1ms, 2ms.
// Wireshark: vxlan || geneve || (openflow_v4 || openflow)

host sdn_of_controller { ip 10.240.10.1 }

host ovs_vtep_alpha { ip 10.240.10.11 }

host ovs_vtep_beta { ip 10.240.10.12 }

flow sdn_openflow_overlay_programming(ctrl, vtep_a, vtep_b) {
    ctrl -> vtep_a openflow hello xid 1 wait 1ms
    ctrl <- vtep_a openflow hello xid 1 wait 1ms
    ctrl -> vtep_a openflow featuresreq xid 2 wait 1ms
    ctrl <- vtep_a openflow featuresreply xid 2 dpid 0x0000001c73000001 wait 2ms
    ctrl <- vtep_a openflow packetin xid 10 tableid 0 wait 1ms
    ctrl -> vtep_a openflow flowmod xid 11 tableid 0 wait 1ms
    vtep_a -> vtep_b vxlan vni 5001 payload "sdn_programmed_vxlan_flow" wait 1ms
    vtep_b -> vtep_a geneve vni 6001 payload "sdn_programmed_geneve_flow"
}

compile {
    sdn_openflow_overlay_programming(sdn_of_controller, ovs_vtep_alpha, ovs_vtep_beta)
}
