// PROMPT: Smart Building Automation System (BAS) integrating BACnet/IP HVAC controllers, CoAP wireless environmental sensors, and MQTT cloud broker.
// TOKENS: host, ip, flow, mqtt, vlan, bacnet, whois, iam, objecttype, objectinstance, wait, ms, readproperty, coap, con, get, uripath, ack, payload, connect, publish, topic, compile

// INSTRUCTION: Define building management system (BMS) edge controller.
host bms_edge_ctrl { ip 10.85.10.1 }

// INSTRUCTION: Define rooftop HVAC chiller BACnet/IP unit.
host bacnet_chiller { ip 10.85.10.50 }

// INSTRUCTION: Define CoAP smart thermostat sensor node.
host coap_thermostat { ip 10.85.10.80 }

// INSTRUCTION: Define facility IoT MQTT broker aggregating building telemetry.
host facility_mqtt_broker { ip 10.85.10.200 }

// INSTRUCTION: Define BACnet discovery/read, CoAP sensor GET, and MQTT cloud telemetry publish.
flow smart_building_bas_flow(bms, hvac, sensor, mqtt) {
    bms -> hvac vlan 85 bacnet whois
    bms <- hvac vlan 85 bacnet iam objecttype 8 objectinstance 5001 wait 2ms
    bms -> hvac vlan 85 bacnet readproperty objecttype 0 objectinstance 1 wait 2ms
    bms -> sensor vlan 85 coap con get uripath "temp/zone4" wait 2ms
    bms <- sensor vlan 85 coap ack payload "21.8C" wait 2ms
    bms -> mqtt vlan 85 mqtt connect wait 2ms
    bms -> mqtt vlan 85 mqtt publish topic "building/hq/zone4/hvac" payload "{\"chiller\":5001,\"temp_c\":21.8}" wait 2ms
}

// INSTRUCTION: Compile block executing Smart Building BACnet, CoAP, and MQTT topology.
compile {
    smart_building_bas_flow(bms_edge_ctrl, bacnet_chiller, coap_thermostat, facility_mqtt_broker)
}
