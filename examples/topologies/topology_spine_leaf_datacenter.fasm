// PROMPT: Simulate a data center Clos spine-leaf fabric combining eBGP TCP peering on port 179, VXLAN UDP overlay frames on port 4789, and SNMPv3 fabric health traps.
// TOKENS: HOST, IP, MAC, FLOW, ->, <-, TCP, ACK, PSH, UDP, SNMP3, TRAP, SRCPORT, DSTPORT, PAYLOAD, USER, ENGINEID, ENGINEBOOTS, ENGINETIME, AUTH, SHA256, PRIV, AES, OID, SYSUPTIME, VARBIND, STRING, COUNTER64, WAIT, ms, COMPILE

// INSTRUCTION: Define Spine Switch 1 with IP 10.92.0.1.
HOST clos_spine_1 { IP 10.92.0.1 MAC 00:02:c9:92:00:01 }

// INSTRUCTION: Define Leaf Switch 1 with IP 10.92.1.11.
HOST clos_leaf_1 { IP 10.92.1.11 MAC 00:02:c9:92:01:11 }

// INSTRUCTION: Define Leaf Switch 2 with IP 10.92.1.12.
HOST clos_leaf_2 { IP 10.92.1.12 MAC 00:02:c9:92:01:12 }

// INSTRUCTION: Define Fabric Controller NMS with IP 10.92.254.100.
HOST fabric_controller { IP 10.92.254.100 MAC 00:02:c9:92:fe:64 }

// INSTRUCTION: Define a flow combining BGP EVPN route updates, VXLAN leaf-to-leaf data, and SNMPv3 spine telemetry.
FLOW clos_fabric_operations(spine, leaf1, leaf2, controller) {
    leaf1 -> spine TCP PSH ACK SRCPORT 51179 DSTPORT 179 PAYLOAD "BGP_EVPN_TYPE2_MAC_IP_ADV" WAIT 2ms
    spine -> leaf2 TCP PSH ACK SRCPORT 179 DSTPORT 52179 PAYLOAD "BGP_EVPN_TYPE2_MAC_IP_REFLECT" WAIT 2ms
    leaf1 -> leaf2 UDP SRCPORT 59001 DSTPORT 4789 PAYLOAD "VXLAN_VNI_20000_EAST_WEST_PACKET" WAIT 2ms
    leaf1 <- leaf2 UDP SRCPORT 59002 DSTPORT 4789 PAYLOAD "VXLAN_VNI_20000_EAST_WEST_REPLY" WAIT 2ms
    spine -> controller SNMP3 TRAP USER "fabric_admin" ENGINEID "80001f8880920001" ENGINEBOOTS 9 ENGINETIME 55000 AUTH SHA256 "fabric_sha256_key" PRIV AES "fabric_aes128_key" OID 1.3.6.1.6.3.1.1.5.4 SYSUPTIME 5500000 VARBIND 1.3.6.1.2.1.1.5.0 STRING "clos-spine-1" VARBIND 1.3.6.1.2.1.31.1.1.1.6.1 COUNTER64 998877665544 WAIT 5ms
}

// INSTRUCTION: Compile block to run the Clos spine-leaf fabric simulation.
COMPILE {
    clos_fabric_operations(clos_spine_1, clos_leaf_1, clos_leaf_2, fabric_controller)
}
