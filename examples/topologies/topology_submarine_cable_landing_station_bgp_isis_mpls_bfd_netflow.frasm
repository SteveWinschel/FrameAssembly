// Submarine optical cable landing station border peering combining eBGP multihop,
// MPLS traffic engineering labels, BFD fast failure detection, and NetFlow v9
// accounting.
// Wire profile: 7 frames; 3 IPv4 hosts; MPLS label 300100,300200; NetFlow, ICMP,
// BGP, BFD; waits 35ms, 2ms.
// Wireshark: cflow || icmp || bgp || bfd

host cls_east_border {
    ip 198.18.100.1
    mac 00:05:85:64:00:01
}

host cls_west_border {
    ip 198.18.100.2
    mac 00:05:85:64:00:02
}

host cls_noc_collector {
    ip 198.18.100.250
    mac 00:50:56:64:00:fa
}

flow submarine_cable_peering_flow(east, west, noc) {
    east -> west bfd mydisc 9001 yourdisc 9002 mintx 50000 minrx 50000 mult 3 wait 35ms
    east <- west bfd mydisc 9002 yourdisc 9001 mintx 50000 minrx 50000 mult 3 wait 35ms
    east -> west bgp open asn 64512 holdtime 90 bgpid 198.18.100.1 wait 35ms
    east -> west bgp update prefix "203.0.113.0/24" nexthop 198.18.100.1 wait 35ms
    east -> west mpls 300100 exp 5 bos 1 mplsttl 64 icmp echorequest wait 35ms
    east <- west mpls 300200 exp 5 bos 1 mplsttl 64 icmp echoreply wait 2ms
    east -> noc netflow version 9 srcip 198.18.100.1 dstip 198.18.100.2 packets 125000 octets 187500000 proto 6
}

compile {
    submarine_cable_peering_flow(cls_east_border, cls_west_border, cls_noc_collector)
}
