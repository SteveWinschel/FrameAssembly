// Enterprise Virtual Desktop Infrastructure (VDI) session launch combining
// Kerberos SSO authentication, TLS 1.3 gateway handshake, QUIC UDP display
// transport, and SMB3 FSLogix profile mount.
// Wire profile: 7 frames; 3 IPv4 hosts; TLS, QUIC, Kerberos, SMB; DSCP 34; waits
// 1ms, 2ms.
// Wireshark: tls || quic || kerberos || (smb || smb2)

host vdi_thin_client { ip 10.115.10.80 }

host vdi_desktop_host { ip 10.115.50.25 }

host fslogix_smb_filer { ip 10.115.100.10 }

flow vdi_session_launch_workflow(thin, vdi, filer) {
    thin -> vdi kerberos asreq realm "VDI.CORP.NET" cname "eng_user01" sname "krbtgt/VDI.CORP.NET" wait 1ms
    thin <- vdi kerberos asrep realm "VDI.CORP.NET" cname "eng_user01" wait 1ms
    thin -> vdi tls clienthello sni "rdp-gw.vdi.corp.net" wait 1ms
    thin <- vdi tls serverhello finished wait 1ms
    vdi -> filer smb command "sessionsetup" sessionid 0x77001100 wait 1ms
    vdi -> filer smb command "treeconnect" sessionid 0x77001100 share "\\\\fslogix\\profiles$\\eng_user01.vhdx" treeid 5 wait 2ms
    thin <- vdi dscp 34 quic short dcid 0x5566778899aabbcc payload "RDP_UDP_H264_GPU_ENCODED_DESKTOP_FRAME_60FPS"
}

compile {
    vdi_session_launch_workflow(vdi_thin_client, vdi_desktop_host, fslogix_smb_filer)
}
