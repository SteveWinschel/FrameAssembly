// PROMPT: Simulate an enterprise VoIP call combining SIP UDP signaling (port 5060), RTP UDP voice packets (port 16384), and voice gateway SNMPv3 QoS jitter and MOS score.
// TOKENS: host, ip, mac, flow, udp, srcport, dstport, payload, wait, ms, snmp3, trap, user, engineid, engineboots, enginetime, auth, sha256, priv, aes, oid, sysuptime, varbind, string, compile

// INSTRUCTION: Define Executive IP Phone with IP 10.98.1.50.
host exec_ip_phone { ip 10.98.1.50 mac 00:04:f2:98:01:50 }

// INSTRUCTION: Define Branch Voice Gateway router with IP 10.98.1.1.
host voice_gateway { ip 10.98.1.1 mac 00:04:f2:98:01:01 }

// INSTRUCTION: Define UC Voice Quality Manager with IP 10.98.100.10.
host uc_qos_manager { ip 10.98.100.10 mac 00:04:f2:98:64:0a }

// INSTRUCTION: Define a 3-host flow interleaving SIP/RTP voice packets with an SNMPv3 voice quality telemetry report.
flow voip_call_with_qos_report(phone, vgw, qos_mgr) {
    phone -> vgw udp srcport 5060 dstport 5060 payload "INVITE sip:918005550199@vgw.local SIP/2.0"
        wait 10ms
    phone <- vgw udp srcport 5060 dstport 5060 payload "SIP/2.0 200 OK SDP_G722_HD"
        wait 10ms
    phone -> vgw udp srcport 16384 dstport 16384 payload "RTP_G722_SEQ_1_AUDIO"
        wait 20ms
    phone <- vgw udp srcport 16384 dstport 16384 payload "RTP_G722_SEQ_1_RETURN"
        wait 20ms
    vgw -> qos_mgr snmp3 trap user "uc_monitor" engineid "8000000903000004f2980101" engineboots 8 enginetime 64000
        auth sha256 "uc_qos_sha256" priv aes "uc_qos_aes128" oid 1.3.6.1.4.1.9.9.63.2.0.1
        sysuptime 6400000
        varbind 1.3.6.1.4.1.9.9.63.1.3.1.1.1 string "Codec-G722-Call-99"
        varbind 1.3.6.1.4.1.9.9.63.1.3.1.1.2 gauge32 4
        varbind 1.3.6.1.4.1.9.9.63.1.3.1.1.3 counter32 0
        wait 10ms
}

// INSTRUCTION: Compile block to execute the VoIP call and QoS telemetry flow.
compile {
    voip_call_with_qos_report(exec_ip_phone, voice_gateway, uc_qos_manager)
}
