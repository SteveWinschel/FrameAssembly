// PROMPT: Site-to-site IPsec VPN topology negotiating IKEv2 Security Associations, AH and ESP headers, and GRE-over-IPsec OSPF routing.
// TOKENS: host, ip, flow, ikev2, sainit, initiatorspi, responderspi, msgid, wait, ms, createchildsa, ah, spi, seq, esp, gre, grekey, ospf, hello, routerid, areaid, compile

// INSTRUCTION: Define headquarters VPN border gateway router.
host hq_ipsec_gw { ip 198.51.100.10 }

// INSTRUCTION: Define remote branch VPN border gateway router.
host branch_ipsec_gw { ip 203.0.113.20 }

// INSTRUCTION: Define IKEv2 SA_INIT and Child SA setup followed by AH, ESP, GRE keepalive, and OSPF routing adjacency.
flow site_to_site_ipsec_ospf(hq, br) {
    hq -> br ikev2 sainit initiatorspi 0x1122334455667788 responderspi 0x0000000000000000 msgid 0
    hq <- br ikev2 sainit initiatorspi 0x1122334455667788 responderspi 0x99aabbccddeeff00 msgid 0 wait 2ms
    hq -> br ikev2 createchildsa initiatorspi 0x1122334455667788 responderspi 0x99aabbccddeeff00 msgid 1 wait 2ms
    hq -> br ah spi 0x1001 seq 1 wait 1ms
    hq -> br esp spi 0x2001 seq 1 wait 1ms
    hq <- br esp spi 0x2002 seq 1 wait 1ms
    hq -> br gre grekey 500 wait 1ms
    hq -> br ospf hello routerid 10.0.0.1 areaid 0 wait 1ms
}

// INSTRUCTION: Compile block executing site-to-site IKEv2, AH, ESP, GRE, and OSPF VPN topology.
compile {
    site_to_site_ipsec_ospf(hq_ipsec_gw, branch_ipsec_gw)
}
