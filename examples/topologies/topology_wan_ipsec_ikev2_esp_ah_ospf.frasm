// Site-to-site IPsec VPN topology negotiating IKEv2 Security Associations, AH and
// ESP headers, and GRE-over-IPsec OSPF routing.
// Wire profile: 8 frames; 2 IPv4 hosts; GRE, ESP, AH, IKEv2, OSPF; waits 2ms,
// 1ms.
// Wireshark: gre || esp || ah || isakmp

host hq_ipsec_gw { ip 198.51.100.10 }

host branch_ipsec_gw { ip 203.0.113.20 }

flow site_to_site_ipsec_ospf(hq, br) {
    hq -> br ikev2 sainit initiatorspi 0x1122334455667788 responderspi 0x0000000000000000 msgid 0 wait 2ms
    hq <- br ikev2 sainit initiatorspi 0x1122334455667788 responderspi 0x99aabbccddeeff00 msgid 0 wait 2ms
    hq -> br ikev2 createchildsa initiatorspi 0x1122334455667788 responderspi 0x99aabbccddeeff00 msgid 1 wait 1ms
    hq -> br ah spi 0x1001 seq 1 wait 1ms
    hq -> br esp spi 0x2001 seq 1 wait 1ms
    hq <- br esp spi 0x2002 seq 1 wait 1ms
    hq -> br gre grekey 500 wait 1ms
    hq -> br ospf hello routerid 10.0.0.1 areaid 0
}

compile {
    site_to_site_ipsec_ospf(hq_ipsec_gw, branch_ipsec_gw)
}
