// WebRTC real-time collaboration topology combining STUN NAT traversal, SIP call
// signaling, RTP audio/video, and SCTP DataChannel.
// Wire profile: 6 frames; 3 IPv4 hosts; STUN, SIP, RTP, SCTP; SCTP DATA; PPID 51;
// DSCP 18,24,46; waits 2ms, 10ms, 5ms.
// Wireshark: stun || sip || rtp || sctp

host webrtc_caller { ip 192.168.10.45 }

host stun_turn_srv { ip 198.51.100.40 }

host webrtc_sfu_gw { ip 198.51.100.50 }

flow webrtc_collaboration_session(caller, stun, sfu) {
    caller -> stun stun bindingrequest wait 2ms
    caller <- stun stun bindingresponse xormappedaddr 203.0.113.45 software "coturn-4.6" wait 2ms
    caller -> sfu dscp 24 sip invite uri "sip:room-42@sfu.collab.example.com" wait 2ms
    caller <- sfu dscp 24 sip method "ACK" uri "sip:room-42@sfu.collab.example.com" wait 10ms
    caller -> sfu dscp 46 rtp pt 111 seq 1 timestamp 960 ssrc 0x99887766 payload "opus_voice_packet_20ms" wait 5ms
    caller -> sfu dscp 18 sctp chunk data vtag 42001 stream 1 ppid 51 payload "{\"whiteboard\":\"draw_stroke\"}"
}

compile {
    webrtc_collaboration_session(webrtc_caller, stun_turn_srv, webrtc_sfu_gw)
}
