// PROMPT: Zero-Trust Network Access (ZTNA) enterprise architecture with Kerberos ticket grant, LDAP group lookup, and mTLS 1.3 gateway access.
// TOKENS: host, ip, flow, kerberos, asreq, realm, cname, sname, asrep, wait, ms, tgsreq, tgsrep, ldap, searchreq, basedn, filter, searchentry, tls, clienthello, sni, serverhello, finished, compile

// INSTRUCTION: Define corporate developer workstation requesting zero-trust access.
host ztna_workstation { ip 10.110.20.55 }

// INSTRUCTION: Define Active Directory Kerberos KDC and LDAP identity provider.
host ad_identity_idp { ip 10.110.1.10 }

// INSTRUCTION: Define Zero-Trust Policy Enforcement Point (PEP) mTLS proxy gateway.
host ztna_pep_proxy { ip 10.110.1.50 }

// INSTRUCTION: Define Kerberos authentication, LDAP RBAC verification, and mTLS 1.3 tunnel setup to ZTNA PEP.
flow ztna_identity_and_mtls(ws, idp, pep) {
    ws -> idp kerberos asreq realm "CORP.EXAMPLE.COM" cname "dev_alice" sname "krbtgt/CORP.EXAMPLE.COM"
    ws <- idp kerberos asrep realm "CORP.EXAMPLE.COM" cname "dev_alice" wait 2ms
    ws -> idp kerberos tgsreq realm "CORP.EXAMPLE.COM" cname "dev_alice" sname "HTTP/ztna-pep.corp.example.com" wait 2ms
    ws <- idp kerberos tgsrep realm "CORP.EXAMPLE.COM" cname "dev_alice" wait 2ms
    pep -> idp ldap searchreq basedn "dc=corp,dc=example,dc=com" filter "(sAMAccountName=dev_alice)" wait 1ms
    pep <- idp ldap searchentry basedn "cn=dev_alice,ou=eng,dc=corp,dc=example,dc=com" wait 1ms
    ws -> pep tls clienthello sni "ztna-pep.corp.example.com" wait 2ms
    ws <- pep tls serverhello wait 1ms
    ws -> pep tls finished wait 1ms
}

// INSTRUCTION: Compile block executing Zero-Trust Kerberos, LDAP, and mTLS workflow.
compile {
    ztna_identity_and_mtls(ztna_workstation, ad_identity_idp, ztna_pep_proxy)
}
