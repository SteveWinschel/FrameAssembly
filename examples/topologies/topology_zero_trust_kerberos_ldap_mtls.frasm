// Zero-Trust Network Access (ZTNA) enterprise architecture with Kerberos ticket
// grant, LDAP group lookup, and mTLS 1.3 gateway access.
// Wire profile: 9 frames; 3 IPv4 hosts; TLS, Kerberos, LDAP; waits 2ms, 1ms.
// Wireshark: tls || kerberos || ldap

host ztna_workstation { ip 10.110.20.55 }

host ad_identity_idp { ip 10.110.1.10 }

host ztna_pep_proxy { ip 10.110.1.50 }

flow ztna_identity_and_mtls(ws, idp, pep) {
    ws -> idp kerberos asreq realm "CORP.EXAMPLE.COM" cname "dev_alice" sname "krbtgt/CORP.EXAMPLE.COM" wait 2ms
    ws <- idp kerberos asrep realm "CORP.EXAMPLE.COM" cname "dev_alice" wait 2ms
    ws -> idp kerberos tgsreq realm "CORP.EXAMPLE.COM" cname "dev_alice" sname "HTTP/ztna-pep.corp.example.com" wait 2ms
    ws <- idp kerberos tgsrep realm "CORP.EXAMPLE.COM" cname "dev_alice" wait 1ms
    pep -> idp ldap searchreq basedn "dc=corp,dc=example,dc=com" filter "(sAMAccountName=dev_alice)" wait 1ms
    pep <- idp ldap searchentry basedn "cn=dev_alice,ou=eng,dc=corp,dc=example,dc=com" wait 2ms
    ws -> pep tls clienthello sni "ztna-pep.corp.example.com" wait 1ms
    ws <- pep tls serverhello wait 1ms
    ws -> pep tls finished
}

compile {
    ztna_identity_and_mtls(ztna_workstation, ad_identity_idp, ztna_pep_proxy)
}
