{
    "comments": {
        "lineComment": "//"
    },
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*|0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)+|[0-9]+[a-z]*",
    "brackets": [
        ["{", "}"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(?:host|flow|compile)\\b.*\\{\\s*$",
            "end": "^\\s*\\}"
        }
    }
}
