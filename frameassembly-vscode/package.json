{
  "name": "frameassembly-vscode",
  "displayName": "FrameAssembly — PCAP & Network Packet Studio (.frasm)",
  "description": "Compile, inspect, and reverse .pcap / .pcapng network packet captures as .frasm code across 81 L2-L7 protocols with live diagnostics, autocomplete, and packet ladder preview.",
  "version": "3.0.0",
  "publisher": "SteveWinschel",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://frameassembly.ai.studio/",
  "bugs": {
    "url": "https://github.com/SteveWinschel/FrameAssembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveWinschel/FrameAssembly.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onLanguage:frameassembly",
    "onCommand:frameassembly.reversePcap",
    "onCommand:frameassembly.openWalkthrough"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "frameassembly",
    "frasm",
    "pcap",
    "pcapng",
    "wireshark",
    "tshark",
    "tcpreplay",
    "packet-crafting",
    "packet-generator",
    "pcap-editor",
    "pcap-decompiler",
    "packets-as-code",
    "networking",
    "network-testing",
    "firewall",
    "security",
    "cybersecurity",
    "pentesting",
    "suricata",
    "zeek",
    "siem",
    "ids",
    "shadow-it",
    "snmp",
    "snmpv3",
    "checkmk",
    "zabbix",
    "modbus",
    "scada",
    "vlan"
  ],
  "contributes": {
    "languages": [
      {
        "id": "frameassembly",
        "aliases": [
          "FrameAssembly",
          "frameassembly",
          "frasm"
        ],
        "extensions": [
          ".frasm"
        ],
        "mimetypes": [
          "text/vnd.frameassembly"
        ],
        "firstLine": "^(?:host|flow|compile|//)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "frameassembly",
        "scopeName": "source.frameassembly",
        "path": "./syntaxes/frameassembly.tmLanguage.json"
      },
      {
        "scopeName": "markdown.frameassembly.codeblock",
        "path": "./syntaxes/frameassembly.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.frameassembly": "frameassembly"
        }
      }
    ],
    "snippets": [
      {
        "language": "frameassembly",
        "path": "./snippets/frameassembly.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "frameassembly.compileToPcap",
        "title": "Compile .frasm to .pcap",
        "category": "FrameAssembly",
        "icon": "$(package)"
      },
      {
        "command": "frameassembly.showPacketLadder",
        "title": "Show Live Packet Ladder Preview",
        "category": "FrameAssembly",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "frameassembly.reversePcap",
        "title": "Reverse Capture (.pcap/.pcapng) to .frasm",
        "category": "FrameAssembly"
      },
      {
        "command": "frameassembly.openWalkthrough",
        "title": "Open Getting Started Walkthrough",
        "category": "FrameAssembly"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "frameassembly.showPacketLadder",
          "when": "editorLangId == frameassembly",
          "group": "navigation@1"
        },
        {
          "command": "frameassembly.compileToPcap",
          "when": "editorLangId == frameassembly",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "frameassembly.reversePcap",
          "when": "resourceExtname == .pcap || resourceExtname == .pcapng",
          "group": "navigation@1"
        },
        {
          "command": "frameassembly.compileToPcap",
          "when": "resourceExtname == .frasm",
          "group": "navigation@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "frameassembly.gettingStarted",
        "title": "Get Started with FrameAssembly Packet Studio",
        "description": "Write packets as code in a .frasm file, preview the packet ladder live, then compile a .pcap for Wireshark or tcpreplay and reverse existing captures.",
        "steps": [
          {
            "id": "frameassembly.step1.create",
            "title": "Create a .frasm file",
            "description": "Open a new file, save it with the `.frasm` extension, and type `frasm` followed by Tab to insert a complete host, flow, and compile skeleton.\n[Create a new file](command:workbench.action.files.newUntitledFile)",
            "media": {
              "markdown": "walkthroughs/step1-create.md"
            },
            "completionEvents": [
              "onLanguage:frameassembly"
            ]
          },
          {
            "id": "frameassembly.step2.ladder",
            "title": "Preview the packet ladder",
            "description": "See every frame your code produces, with timestamps, protocols, and a hex dump, updating as you type.\n[Show Live Packet Ladder](command:frameassembly.showPacketLadder)",
            "media": {
              "markdown": "walkthroughs/step2-ladder.md"
            },
            "completionEvents": [
              "onCommand:frameassembly.showPacketLadder"
            ]
          },
          {
            "id": "frameassembly.step3.compile",
            "title": "Compile to .pcap or reverse a capture",
            "description": "Write a `.pcap` next to your file for Wireshark, tcpreplay, or Suricata, or right-click an existing capture to turn it back into `.frasm` code.\n[Compile .frasm to .pcap](command:frameassembly.compileToPcap)\n[Reverse a capture to .frasm](command:frameassembly.reversePcap)",
            "media": {
              "markdown": "walkthroughs/step3-compile-reverse.md"
            },
            "completionEvents": [
              "onCommand:frameassembly.compileToPcap",
              "onCommand:frameassembly.reversePcap"
            ]
          }
        ]
      }
    ]
  }
}
