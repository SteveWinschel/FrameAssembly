{
  "name": "frameassembly-vscode",
  "displayName": "FrameAssembly (.frasm)",
  "description": "Syntax highlighting and live error linting for FrameAssembly (.frasm) packet capture code.",
  "version": "3.1.2",
  "publisher": "SteveWinschel",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://frameassembly-lang.dev/",
  "bugs": {
    "url": "https://github.com/SteveWinschel/FrameAssembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveWinschel/FrameAssembly"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onLanguage:frameassembly"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "keywords": [
    "frameassembly",
    "frasm",
    "pcap",
    "pcapng",
    "wireshark",
    "tshark",
    "tcpreplay",
    "packet-crafting",
    "packet-generator",
    "packets-as-code",
    "networking",
    "network-testing",
    "firewall",
    "security",
    "cybersecurity",
    "pentesting",
    "suricata",
    "zeek",
    "siem",
    "ids",
    "shadow-it",
    "snmp",
    "snmpv3",
    "checkmk",
    "zabbix",
    "modbus",
    "scada",
    "vlan",
    "qinq",
    "mpls"
  ],
  "contributes": {
    "languages": [
      {
        "id": "frameassembly",
        "aliases": [
          "FrameAssembly",
          "frameassembly",
          "frasm"
        ],
        "extensions": [
          ".frasm"
        ],
        "mimetypes": [
          "text/vnd.frameassembly"
        ],
        "firstLine": "^(?:host|flow|compile|//)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "frameassembly",
        "scopeName": "source.frameassembly",
        "path": "./syntaxes/frameassembly.tmLanguage.json"
      },
      {
        "scopeName": "markdown.frameassembly.codeblock",
        "path": "./syntaxes/frameassembly.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.frameassembly": "frameassembly"
        }
      }
    ]
  }
}
