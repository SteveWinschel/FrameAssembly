{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FrameAssembly",
  "scopeName": "source.frameassembly",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#protocols"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.frameassembly"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.frameassembly",
      "patterns": [
        {
          "match": "\\\\(?:[rnt\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|.)",
          "name": "constant.character.escape.frameassembly"
        }
      ]
    },
    "keywords": {
      "match": "\\b(host|flow|compile)\\b",
      "name": "keyword.control.frameassembly"
    },
    "protocols": {
      "patterns": [
        {
          "match": "\\b(arp|vlan|qinq|lldp|stp|lacp|eapol|mpls|icmp|ndp|igmp|mld|gre|vxlan|geneve|ipsec|esp|ah|ikev2|wireguard|ospf)\\b",
          "name": "entity.name.type.protocol.frameassembly"
        },
        {
          "match": "\\b(bgp|rip|vrrp|hsrp|pim|bfd|openflow|tcp|udp|sctp|snmp1|snmp2|snmp3|dns|mdns|dhcp|ntp|ptp|radius|tacacs|syslog)\\b",
          "name": "entity.name.type.protocol.frameassembly"
        },
        {
          "match": "\\b(netflow|ipfix|sflow|tftp|ftp|ssh|telnet|http|http2|grpc|websocket|tls|quic|stun|sip|rtp|rtsp|smtp|imap|pop3|kerberos)\\b",
          "name": "entity.name.type.protocol.frameassembly"
        },
        {
          "match": "\\b(ldap|smb|nfs|redis|memcached|mysql|postgres|mqtt|coap|amqp|ssdp|whois|modbus|bacnet|dnp3|s7comm|ethernetip|opcua)\\b",
          "name": "entity.name.type.protocol.frameassembly"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(abort|accessaccept|accesschallenge|accessreject|accessrequest|accountingrequest|accountingresponse|acct|ack|advertise|aes|alert|announce|appdata|asrep|asreq)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(authen|author|basicdeliver|basicpublish|bindingerror|bindingrequest|bindingresponse|bindreq|bindres|bye|cancel|certificate|changed|channelopen|clienthello|close)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(con|connack|connect|connectionstart|cookie|cookieack|cookieecho|counter32|counter64|createchildsa|created|cwr|data|dbd|delayreq|delayresp)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(delete|des|describe|destunreach|directoperate|disconnect|discover|done|ece|echoreply|echoreq|echorequest|ehlo|err|error|featuresreply)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(featuresreq|fin|finished|flowmod|followup|garp|gauge32|get|getbulk|getnext|goaway|gratuitous|handshake|head|headers|heartbeat)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(heartbeatack|hello|helo|iam|inform|informational|init|initack|initial|initiation|int|invite|ipval|joinprune|keepalive|krberror)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(leave|listidentity|listinterfaces|listservices|logoff|lsack|lsr|lsu|md5|msearch|negotiate|neighboradvert|neighborsolicit|non|nop|notfound)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(notification|notify|null|nullval|offer|oidval|ok|open|operate|options|packetin|packetout|patch|ping|pingreq|pingresp)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(play|pong|post|preface|psh|puback|publish|put|query|quit|read|readcoils|readdiscreteinputs|readholdingregisters|readinputregisters|redirect)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(register|registersession|release|reply|report|request|response|retry|routeradvert|routersolicit|rrq|rst|rstp|sack|sainit|searchdone)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(searchentry|searchreq|select|sendrrdata|sendunitdata|serverhello|sessionsetup|set|settings|setup|sha|sha256|sha384|sha512|short|shutdown)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(shutdownack|solicit|start|string|suback|subscribe|syn|sync|teardown|tgsrep|tgsreq|timeexceeded|timeticks|trap|treeconnect|treedisconnect)\\b",
          "name": "constant.language.frameassembly"
        },
        {
          "match": "\\b(unbindreq|unregistersession|unsolicitedresponse|update|urg|v1|v2|v3|windowupdate|write|writemultipleregisters|writesinglecoil|writesingleregister|wrq|zerortt)\\b",
          "name": "constant.language.frameassembly"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "\\b(acknum|actorkey|actorport|actorstate|actorsys|addr|advint|agentip|alpn|ansttl|app|area|areaid|arg|args|asn)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(auth|authok|banner|basedn|bgpid|binary|block|body|bos|bridgeid|callid|cas|chaddr|channel|chassisid|checksum)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(chunk|chunktype|ciaddr|cipattr|cipclass|ciphersuite|cipinstance|cipservice|clientid|clockid|cmd|cname|code|command|commandcomplete|community)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(compound|confirm|contact|contentformat|contenttype|context|contextname|cost|count|counter|crc|create|cseq|db|dbnum|dcid)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(deadinterval|dei|df|diag|dnsserver|do|domain|domainid|dont|dpid|drpriority|dscp|dst|dstip|dstmac|dstport)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(eapcode|eapid|eapmethod|eappacket|ecn|endpointurl|engineboots|engineid|enginetime|enterprise|eof|errcode|errmsg|errorresponse|ethertype|etype)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(exchange|exp|exptime|facility|filename|filter|finbit|flags|flowlabel|forwarddelay|fragoffset|framedip|from|func|gateway|gentrap)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(greeting|grekey|greproto|greseq|group|grpcstatus|handshakeversion|header|hellointerval|hellotime|hexpayload|holdtime|hosthdr|hostname|icv|id)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(identity|initiatorspi|innervlan|invokeid|ip|ipid|isresponse|iv|kexinit|key|label|leasetime|li|location|login|mac)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(mailfrom|man|marker|maskkey|maxage|maxrepetitions|maxresp|maxrespdelay|method|metric|mf|minrx|mintx|mode|mplsttl|msg)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(msgcode|msgid|msgtype|mss|mult|multicastaddr|mx|mydisc|nasip|newkeys|nextheader|nexthop|nextpayload|nlri|nodeid|nonrepeaters)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(nt|nts|objectinstance|objecttype|octets|offset|oid|opaque|opcode|optclass|option|opttype|packets|param|partnerkey|partnerport)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(partnerstate|partnersys|path|payload|pcp|pduref|pktid|pktnum|pkttype|plccontrol|poll|portid|ppid|precision|prefix|pri)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(priority|priv|proc|procid|propertyid|proto|protocolheader|protocoltype|protoid|pt|qname|qos|qtype|rcode|rcptto|rdata)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(readproperty|readvar|readyforquery|realm|reason|receiver|recordversion|refid|registrar|replytype|reqid|responderspi|resultcode|retain|returncode|rootid)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(rosctr|router|routerid|routerlifetime|routingkey|rp|sackperm|samples|scid|securechannelid|sender|senderip|sendermac|seq|seqid|seqnum)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(serverversion|service|servicetype|session|sessionhandle|sessionid|setupcomm|severity|share|siaddr|slla|sname|sni|software|source|spa)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(spectrap|spi|sql|src|srcip|srcmac|srcport|ssn|ssrc|st|startup|state|status|stratum|stream|streamid)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(subagentid|subnetmask|sysdesc|sysname|sysuptime|tableid|tag|target|targetip|targetmac|tc|text|tha|timestamp|tlla|to)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(token|tokenid|topic|tpa|transport|transporthdr|treeid|tsecr|tsn|tsval|ttl|txid|txtimestamp|type|unitid|uptime)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(urgent|uri|uripath|user|useragent|usn|value|varbind|variation|vers|version|via|vip|vn|vni|vnid)\\b",
          "name": "support.type.property-name.frameassembly"
        },
        {
          "match": "\\b(vrid|vtag|wait|will|win|window|wont|writeproperty|writevar|wscale|xid|xormappedaddr|yiaddr|yourdisc)\\b",
          "name": "support.type.property-name.frameassembly"
        }
      ]
    },
    "operators": {
      "match": "(->|<-)",
      "name": "keyword.operator.frameassembly"
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(?:([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}|([0-9a-fA-F]{2}-){5}[0-9a-fA-F]{2}|[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4})\\b",
          "name": "constant.numeric.mac.frameassembly"
        },
        {
          "match": "(?:::|::[0-9a-fA-F:.]+|\\b[0-9a-fA-F]{1,4}(:[0-9a-fA-F:.]+)+)",
          "name": "constant.numeric.ipv6.frameassembly"
        },
        {
          "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\\b",
          "name": "constant.numeric.ip.frameassembly"
        },
        {
          "match": "\\b0[xX][0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.frameassembly"
        },
        {
          "match": "(?:\\B\\.|\\b)[0-9]+(?:\\.[0-9]+)+",
          "name": "constant.numeric.oid.frameassembly"
        },
        {
          "match": "\\b[0-9]+(ns|us|ms|s|m)\\b",
          "name": "constant.numeric.duration.frameassembly"
        },
        {
          "match": "-?\\b[0-9]+\\b",
          "name": "constant.numeric.integer.frameassembly"
        }
      ]
    }
  }
}
