# ============================================================================
# FrameAssembly GBNF Constrained Decoding Grammar (llama.cpp / GGML BNF)
# Usage: llama-server -m model.gguf --grammar-file frameassembly.gbnf
# Enforces 100% syntactically valid FrameAssembly (.fasm) generation across
# all 81 native protocols, L2-L4 modifiers, SNMPv1/v2c/v3 USM, and L7 specs.
# Note: FrameAssembly v2.0.0 enforces strict-lowercase alphanumeric tokens
# without '_' or '-' across all keywords, protocols, modifiers, and time units.
# ============================================================================

root ::= ws (host-decl | flow-decl)* compile-block (host-decl | flow-decl)* ws

# Whitespace and single-line comments
ws ::= ([ \t\n\r] | "//" [^\n]* "\n")*
ws1 ::= ([ \t\n\r] | "//" [^\n]* "\n")+

# 1. Host Declarations (at least one IP or MAC property in any order)
host-decl ::= "host" ws1 ident ws "{" ws host-prop+ "}" ws
host-prop ::= ("ip" ws1 ip-addr | "mac" ws1 mac-addr) ws

# 2. Flow Declarations & Statements (FLOW blocks are optional when COMPILE uses inline frame-stmt)
flow-decl ::= "flow" ws1 ident ws "(" ws param-list? ")" ws "{" ws frame-stmt* "}" ws
param-list ::= ident ws ("," ws ident ws)*

frame-stmt ::= ident ws direction ws ident (ws1 frame-field)* ws
direction ::= "->" | "<-"

# 3. Compile Block & Inline Frame Statements
compile-block ::= "compile" ws "{" ws run-stmt* "}" ws
run-stmt ::= flow-call | frame-stmt
flow-call ::= ident ws "(" ws param-list? ")" ws

# 4. Frame Fields (Protocols, Modifiers & Protocol Attributes)
frame-field ::= protocol-kw
              | universal-mod
              | l2-mod
              | l3-mod
              | l4-mod
              | l2-proto-field
              | l3-proto-field
              | l4-proto-field
              | snmp-proto-field
              | l7-proto-field

# 5. All 81 Native Protocol Keywords
protocol-kw ::= l2-proto | l3-proto | l4-proto | snmp-proto | l7-infra-proto | l7-app-proto | l7-ot-proto

l2-proto ::= "arp" | "vlan" | "qinq" | "lldp" | "stp" | "lacp" | "eapol" | "mpls"

l3-proto ::= "icmp" | "ndp" | "igmp" | "mld" | "gre" | "vxlan" | "geneve"
           | "ipsec" | "esp" | "ah" | "ikev2" | "wireguard"
           | "ospf" | "bgp" | "rip" | "vrrp" | "hsrp" | "pim" | "bfd" | "openflow"

l4-proto ::= "tcp" | "udp" | "sctp"

snmp-proto ::= "snmp1" | "snmp2" | "snmp3"

l7-infra-proto ::= "dns" | "mdns" | "dhcp" | "ntp" | "ptp" | "radius"
                 | "tacacs" | "syslog" | "netflow" | "ipfix" | "sflow"

l7-app-proto ::= "tftp" | "ftp" | "ssh" | "telnet" | "http" | "http2" | "grpc"
               | "websocket" | "tls" | "quic" | "stun" | "sip" | "rtp" | "rtsp"
               | "smtp" | "imap" | "pop3" | "kerberos" | "ldap" | "smb" | "nfs"
               | "redis" | "memcached" | "mysql" | "postgres" | "mqtt" | "coap"
               | "amqp" | "ssdp" | "whois"

l7-ot-proto ::= "modbus" | "bacnet" | "dnp3" | "s7comm" | "ethernetip" | "opcua"

# 6. Universal & Layer 2-4 Modifiers
universal-mod ::= "wait" ws1 duration-lit
                | "payload" ws1 string-lit
                | "hexpayload" ws1 hex-string-lit

l2-mod ::= "srcmac" ws1 mac-addr
         | "dstmac" ws1 mac-addr
         | "ethertype" ws1 uint-lit
         | "vlan" (ws1 uint-lit)?
         | "pcp" ws1 uint-lit
         | "dei" ws1 uint-lit
         | "qinq" (ws1 uint-lit)?
         | "innervlan" ws1 uint-lit
         | "mpls" (ws1 uint-lit)?
         | "label" ws1 uint-lit
         | ("exp" | "tc") ws1 uint-lit
         | "bos" ws1 uint-lit
         | "mplsttl" ws1 uint-lit

l3-mod ::= "ttl" ws1 uint-lit
         | "dscp" ws1 uint-lit
         | "ecn" ws1 uint-lit
         | "flowlabel" ws1 uint-lit
         | "ipid" ws1 uint-lit
         | "df"
         | "mf"
         | "fragoffset" ws1 uint-lit
         | "nextheader" ws1 uint-lit

l4-mod ::= "srcport" ws1 uint-lit
         | "dstport" ws1 uint-lit
         | "transport" ws1 ("tcp" | "udp")
         | tcp-flag
         | "seq" ws1 uint-lit
         | "acknum" ws1 uint-lit
         | ("win" | "window") ws1 uint-lit
         | "urgent" ws1 uint-lit
         | "mss" ws1 uint-lit
         | "wscale" ws1 uint-lit
         | "sackperm"
         | "tsval" ws1 uint-lit
         | "tsecr" ws1 uint-lit

tcp-flag ::= "syn" | "ack" | "fin" | "rst" | "psh" | "urg" | "ece" | "cwr"

# 7. Layer 2 Protocol Sub-Keywords
l2-proto-field ::= "request"
                 | "reply" (ws1 string-lit)?
                 | "gratuitous" | "garp"
                 | ("sha" | "sendermac") ws1 mac-addr
                 | ("spa" | "senderip") ws1 ip-addr
                 | ("tha" | "targetmac") ws1 mac-addr
                 | ("tpa" | "targetip") ws1 ip-addr
                 | "chassisid" ws1 str-or-ident
                 | "portid" ws1 (uint-lit | str-or-ident)
                 | "sysname" ws1 str-or-ident
                 | "sysdesc" ws1 str-or-ident
                 | "rootid" ws1 str-or-ident
                 | "bridgeid" ws1 str-or-ident
                 | "cost" ws1 uint-lit
                 | "maxage" ws1 uint-lit
                 | "hellotime" ws1 uint-lit
                 | "forwarddelay" ws1 uint-lit
                 | "rstp"
                 | "flags" ws1 uint-lit
                 | "actorsys" ws1 (mac-addr | string-lit)
                 | "actorkey" ws1 uint-lit
                 | "actorport" ws1 uint-lit
                 | "partnersys" ws1 (mac-addr | string-lit)
                 | "partnerkey" ws1 uint-lit
                 | "partnerport" ws1 uint-lit
                 | "actorstate" ws1 uint-lit
                 | "partnerstate" ws1 uint-lit
                 | "version" ws1 (uint-lit | str-or-ident)
                 | "type" ws1 (uint-lit | "start" | "logoff" | "key" | "eappacket" | "initiation" | "response" | "cookie" | "data"
                 | "hello" | "featuresreq" | "featuresreply" | "packetin" | "packetout" | "flowmod" | "echoreq" | "echorequest" | "echoreply"
                 | "authen" | "author" | "acct" | str-or-ident)
                 | "start" | "logoff" | "key" | "eappacket"
                 | "eapcode" ws1 uint-lit
                 | "eapid" ws1 uint-lit
                 | "eapmethod" ws1 uint-lit
                 | "identity" ws1 str-or-ident

# 8. Layer 3 Protocol Sub-Keywords
l3-proto-field ::= "echorequest" | "echoreply" | "destunreach" | "timeexceeded" | "redirect"
                 | "code" ws1 (uint-lit | str-or-ident)
                 | "id" ws1 uint-lit
                 | "gateway" ws1 ip-addr
                 | "routersolicit" | "routeradvert" | "neighborsolicit" | "neighboradvert"
                 | "target" ws1 (ip-addr | mac-addr)
                 | "slla" ws1 mac-addr
                 | "tlla" ws1 mac-addr
                 | "routerlifetime" ws1 uint-lit
                 | "query" | "report" | "leave" | "done" | "v1" | "v2" | "v3"
                 | "group" ws1 (ip-addr | uint-lit)
                 | "maxresp" ws1 uint-lit
                 | "multicastaddr" ws1 ip-addr
                 | "maxrespdelay" ws1 uint-lit
                 | "checksum"
                 | "grekey" ws1 uint-lit
                 | "greseq" ws1 uint-lit
                 | "greproto" ws1 uint-lit
                 | ("vni" | "vnid") ws1 uint-lit
                 | "optclass" ws1 uint-lit
                 | "opttype" ws1 uint-lit
                 | "protocoltype" ws1 uint-lit
                 | "spi" ws1 uint-lit
                 | "iv" ws1 (hex-string-lit | uint-lit)
                 | "icv" ws1 (hex-string-lit | uint-lit)
                 | "initiatorspi" ws1 (uint-lit | hex-string-lit)
                 | "responderspi" ws1 (uint-lit | hex-string-lit)
                 | "exchange" ws1 (uint-lit | "sainit" | "createchildsa" | "informational" | str-or-ident)
                 | "sainit" | "createchildsa" | "informational"
                 | "msgid" ws1 (uint-lit | str-or-ident)
                 | "nextpayload" ws1 uint-lit
                 | "initiation" | "cookie" (ws1 str-or-ident)? | "data" (ws1 str-or-ident)?
                 | "sender" ws1 uint-lit
                 | "receiver" ws1 uint-lit
                 | "counter" ws1 uint-lit
                 | "hello" | "dbd" | "lsr" | "lsu" | "lsack"
                 | "routerid" ws1 ip-addr
                 | "areaid" ws1 (uint-lit | ip-addr)
                 | "hellointerval" ws1 uint-lit
                 | "deadinterval" ws1 uint-lit
                 | "priority" ws1 uint-lit
                 | "open" | "update" | "notification" | "keepalive" (ws1 uint-lit)?
                 | "asn" ws1 uint-lit
                 | "holdtime" ws1 uint-lit
                 | "bgpid" ws1 ip-addr
                 | ("prefix" | "nlri") ws1 (ip-addr | str-or-ident)
                 | "nexthop" ws1 ip-addr
                 | "command" ws1 (uint-lit | str-or-ident)
                 | "metric" ws1 uint-lit
                 | "tag" ws1 (uint-lit | str-or-ident)
                 | "vrid" ws1 uint-lit
                 | "advint" ws1 uint-lit
                 | "vip" ws1 ip-addr
                 | "hellotime" ws1 uint-lit
                 | "state" ws1 uint-lit
                 | "joinprune" | "register"
                 | "source" ws1 ip-addr
                 | "rp" ws1 ip-addr
                 | "drpriority" ws1 uint-lit
                 | "diag" ws1 uint-lit
                 | "mydisc" ws1 uint-lit
                 | "yourdisc" ws1 uint-lit
                 | "mintx" ws1 uint-lit
                 | "minrx" ws1 uint-lit
                 | "mult" ws1 uint-lit
                 | "featuresreq" | "featuresreply" | "packetin" | "packetout" | "flowmod" | "echoreq"
                 | "xid" ws1 uint-lit
                 | "dpid" ws1 uint-lit
                 | "tableid" ws1 uint-lit

# 9. Layer 4 SCTP Sub-Keywords
l4-proto-field ::= "vtag" ws1 uint-lit
                 | "stream" ws1 uint-lit
                 | "ssn" ws1 uint-lit
                 | "ppid" ws1 uint-lit
                 | "tsn" ws1 uint-lit
                 | "chunk" ws1 ("data" | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack" | "abort" | "shutdown" | "shutdownack" | "cookieecho" | "cookieack" | uint-lit | str-or-ident)
                 | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack"
                 | "abort" | "shutdown" | "shutdownack" | "cookieecho" | "cookieack"

# 10. SNMPv1 / SNMPv2c / SNMPv3 Sub-Keywords
snmp-proto-field ::= "trap" | "inform" | "get" | "getnext" | "getbulk" | "set" | "response" (ws1 str-or-ident)? | "report"
                   | "community" ws1 string-lit
                   | "oid" ws1 oid-lit
                   | "sysuptime" ws1 uint-lit
                   | "reqid" ws1 uint-lit
                   | "nonrepeaters" ws1 uint-lit
                   | "maxrepetitions" ws1 uint-lit
                   | "enterprise" ws1 oid-lit
                   | "agentip" ws1 ip-addr
                   | "gentrap" ws1 uint-lit
                   | "spectrap" ws1 uint-lit
                   | "user" ws1 str-or-ident
                   | "engineid" ws1 string-lit
                   | "engineboots" ws1 uint-lit
                   | "enginetime" ws1 uint-lit
                   | "contextname" ws1 string-lit
                   | "auth" ws1 ("md5" | "sha" | "sha256" | "sha384" | "sha512") ws1 string-lit
                   | "priv" ws1 ("des" | "aes") ws1 string-lit
                   | "varbind" ws1 oid-lit ws1 varbind-val

varbind-val ::= "nullval" | "null"
              | "string" ws1 string-lit
              | "int" ws1 int-lit
              | "timeticks" ws1 uint-lit
              | "ipval" ws1 ip-addr
              | "oidval" ws1 oid-lit
              | "counter32" ws1 uint-lit
              | "gauge32" ws1 uint-lit
              | "counter64" ws1 uint-lit

# 11. Layer 7 Sub-Keywords
l7-proto-field ::= "txid" ws1 (uint-lit | str-or-ident)
                 | "qname" ws1 str-or-ident
                 | "qtype" ws1 (uint-lit | str-or-ident)
                 | "rdata" ws1 str-or-ident
                 | "rcode" ws1 uint-lit
                 | "ansttl" ws1 uint-lit
                 | "discover" | "solicit" | "offer" | "advertise" | "release"
                 | "ciaddr" ws1 ip-addr
                 | "yiaddr" ws1 ip-addr
                 | "siaddr" ws1 ip-addr
                 | "chaddr" ws1 mac-addr
                 | "hostname" ws1 str-or-ident
                 | "dnsserver" ws1 ip-addr
                 | "router" ws1 ip-addr
                 | "subnetmask" ws1 ip-addr
                 | "leasetime" ws1 uint-lit
                 | "li" ws1 uint-lit
                 | "vn" ws1 uint-lit
                 | "mode" ws1 (uint-lit | str-or-ident)
                 | "stratum" ws1 uint-lit
                 | "poll" ws1 uint-lit
                 | "precision" ws1 int-lit
                 | "refid" ws1 str-or-ident
                 | "txtimestamp" ws1 uint-lit
                 | "msgtype" ws1 (uint-lit | str-or-ident)
                 | "sync" | "delayreq" | "followup" | "delayresp" | "announce"
                 | "domain" ws1 (uint-lit | str-or-ident)
                 | "seqid" ws1 uint-lit
                 | "clockid" ws1 (mac-addr | str-or-ident)
                 | "accessrequest" | "accessaccept" | "accessreject"
                 | "accesschallenge" | "accountingrequest" | "accountingresponse"
                 | "nasip" ws1 ip-addr
                 | "servicetype" ws1 uint-lit
                 | "framedip" ws1 ip-addr
                 | "authen" | "author" | "acct"
                 | "sessionid" ws1 uint-lit
                 | "facility" ws1 uint-lit
                 | "severity" ws1 uint-lit
                 | "pri" ws1 uint-lit
                 | "app" ws1 str-or-ident
                 | "procid" ws1 str-or-ident
                 | "msg" ws1 str-or-ident
                 | "srcip" ws1 ip-addr
                 | "dstip" ws1 ip-addr
                 | "proto" ws1 uint-lit
                 | "packets" ws1 uint-lit
                 | "octets" ws1 uint-lit
                 | "domainid" ws1 uint-lit
                 | "agentip" ws1 ip-addr
                 | "subagentid" ws1 uint-lit
                 | "uptime" ws1 uint-lit
                 | "samples" ws1 uint-lit
                 | "rrq" | "wrq" | "error"
                 | "filename" ws1 str-or-ident
                 | "block" ws1 uint-lit
                 | "errcode" ws1 uint-lit
                 | "errmsg" ws1 str-or-ident
                 | "cmd" ws1 (uint-lit | str-or-ident)
                 | "arg" ws1 str-or-ident
                 | "banner" ws1 str-or-ident
                 | "kexinit" | "newkeys"
                 | "msgcode" ws1 uint-lit
                 | "will" ws1 uint-lit
                 | "wont" ws1 uint-lit
                 | "do" ws1 uint-lit
                 | "dont" ws1 uint-lit
                 | "option" ws1 uint-lit
                 | "post" | "put" | "delete" | "head" | "options" | "patch"
                 | "uri" ws1 str-or-ident
                 | "hosthdr" ws1 str-or-ident
                 | "useragent" ws1 str-or-ident
                 | "contenttype" ws1 str-or-ident
                 | "status" ws1 (uint-lit | str-or-ident)
                 | "reason" ws1 str-or-ident
                 | "header" ws1 string-lit ws1 string-lit
                 | "body" ws1 str-or-ident
                 | "preface" | "settings" | "headers" | "windowupdate" | "ping" | "goaway"
                 | "streamid" ws1 uint-lit
                 | "service" ws1 str-or-ident
                 | "method" ws1 str-or-ident
                 | "grpcstatus" ws1 uint-lit
                 | "opcode" ws1 (uint-lit | str-or-ident)
                 | "text" | "binary" | "pong" | "close"
                 | "finbit" ws1 uint-lit
                 | "maskkey" ws1 uint-lit
                 | "clienthello" | "serverhello" | "certificate" | "finished" | "appdata" | "alert"
                 | "recordversion" ws1 uint-lit
                 | "handshakeversion" ws1 uint-lit
                 | "sni" ws1 str-or-ident
                 | "ciphersuite" ws1 uint-lit
                 | "alpn" ws1 str-or-ident
                 | "initial" | "zerortt" | "handshake" | "retry" | "short"
                 | "dcid" ws1 (uint-lit | str-or-ident)
                 | "scid" ws1 (uint-lit | str-or-ident)
                 | "token" ws1 (uint-lit | str-or-ident)
                 | "pktnum" ws1 uint-lit
                 | "bindingrequest" | "bindingresponse" | "bindingerror"
                 | "xormappedaddr" ws1 ip-addr (ws1 uint-lit)?
                 | "software" ws1 str-or-ident
                 | "invite" | "bye" | "cancel"
                 | "from" ws1 str-or-ident
                 | "to" ws1 str-or-ident
                 | "callid" ws1 str-or-ident
                 | "cseq" ws1 uint-lit
                 | "via" ws1 str-or-ident
                 | "contact" ws1 str-or-ident
                 | "pt" ws1 uint-lit
                 | "timestamp" ws1 uint-lit
                 | "ssrc" ws1 uint-lit
                 | "marker" ws1 uint-lit
                 | "describe" | "setup" | "play" | "teardown"
                 | "transporthdr" ws1 str-or-ident
                 | "session" ws1 str-or-ident
                 | "ehlo" (ws1 str-or-ident)?
                 | "helo" (ws1 str-or-ident)?
                 | "mailfrom" (ws1 str-or-ident)?
                 | "rcptto" (ws1 str-or-ident)?
                 | "quit"
                 | "param" ws1 str-or-ident
                 | "ok" | "err"
                 | "asreq" | "asrep" | "tgsreq" | "tgsrep" | "krberror"
                 | "realm" ws1 str-or-ident
                 | "cname" ws1 str-or-ident
                 | "sname" ws1 str-or-ident
                 | "etype" ws1 uint-lit
                 | "bindreq" | "bindres" | "searchreq" | "searchentry" | "searchdone" | "unbindreq"
                 | "basedn" ws1 str-or-ident
                 | "filter" ws1 str-or-ident
                 | "resultcode" ws1 uint-lit
                 | "negotiate" | "sessionsetup" | "treeconnect" | "create" | "treedisconnect"
                 | "treeid" ws1 uint-lit
                 | "share" ws1 str-or-ident
                 | "vers" ws1 uint-lit
                 | "proc" ws1 (uint-lit | str-or-ident)
                 | "path" ws1 str-or-ident
                 | "compound"
                 | "args" ws1 str-or-ident
                 | "replytype" ws1 str-or-ident
                 | "key" ws1 (uint-lit | str-or-ident)
                 | "value" ws1 (uint-lit | str-or-ident)
                 | "exptime" ws1 uint-lit
                 | "opaque" ws1 uint-lit
                 | "cas" ws1 uint-lit
                 | "greeting" | "login" | "eof"
                 | "sql" ws1 str-or-ident
                 | "serverversion" ws1 str-or-ident
                 | "db" ws1 str-or-ident
                 | "startup" | "readyforquery" | "commandcomplete" | "errorresponse" | "authok"
                 | "connect" | "connack" | "publish" | "puback" | "subscribe" | "suback" | "pingreq" | "pingresp" | "disconnect"
                 | "clientid" ws1 str-or-ident
                 | "topic" ws1 str-or-ident
                 | "qos" ws1 uint-lit
                 | "retain" (ws1 uint-lit)?
                 | "pkttype" ws1 (uint-lit | str-or-ident)
                 | "pktid" ws1 uint-lit
                 | "returncode" ws1 uint-lit
                 | "con" | "non" | "changed" | "created" | "notfound"
                 | "uripath" ws1 str-or-ident
                 | "contentformat" ws1 uint-lit
                 | "protocolheader" | "connectionstart" | "channelopen" | "basicpublish" | "basicdeliver"
                 | "channel" ws1 uint-lit
                 | "routingkey" ws1 str-or-ident
                 | "msearch" | "notify"
                 | "man" ws1 str-or-ident
                 | "mx" ws1 uint-lit
                 | "st" ws1 str-or-ident
                 | "nt" ws1 str-or-ident
                 | "nts" ws1 str-or-ident
                 | "usn" ws1 str-or-ident
                 | "location" ws1 str-or-ident
                 | "registrar" ws1 str-or-ident
                 | "protoid" ws1 uint-lit
                 | "unitid" ws1 uint-lit
                 | "func" ws1 (uint-lit | str-or-ident)
                 | "readcoils" | "readdiscreteinputs" | "readholdingregisters" | "readinputregisters"
                 | "writesinglecoil" | "writesingleregister" | "writemultipleregisters"
                 | "addr" ws1 uint-lit
                 | "count" ws1 uint-lit
                 | "isresponse"
                 | "whois" | "iam" | "readproperty" | "writeproperty"
                 | "invokeid" ws1 uint-lit
                 | "objecttype" ws1 uint-lit
                 | "objectinstance" ws1 uint-lit
                 | "propertyid" ws1 uint-lit
                 | "confirm" | "read" | "write" | "select" | "operate" | "directoperate" | "unsolicitedresponse"
                 | "variation" ws1 uint-lit
                 | "crc" ws1 uint-lit
                 | "src" ws1 uint-lit
                 | "dst" ws1 uint-lit
                 | "rosctr" ws1 (uint-lit | str-or-ident)
                 | "pduref" ws1 uint-lit
                 | "setupcomm" | "readvar" | "writevar" | "plccontrol"
                 | "area" ws1 (uint-lit | str-or-ident)
                 | "dbnum" ws1 uint-lit
                 | "offset" ws1 uint-lit
                 | "nop" | "listservices" | "listidentity" | "listinterfaces"
                 | "registersession" | "unregistersession" | "sendrrdata" | "sendunitdata"
                 | "sessionhandle" ws1 uint-lit
                 | "context" ws1 (uint-lit | str-or-ident)
                 | "cipservice" ws1 uint-lit
                 | "cipclass" ws1 uint-lit
                 | "cipinstance" ws1 uint-lit
                 | "cipattr" ws1 uint-lit
                 | "chunktype" ws1 str-or-ident
                 | "securechannelid" ws1 uint-lit
                 | "tokenid" ws1 uint-lit
                 | "seqnum" ws1 uint-lit
                 | "endpointurl" ws1 str-or-ident
                 | "nodeid" ws1 str-or-ident

# 12. Lexical Terminals
str-or-ident ::= string-lit | ident
# Matches /[a-zA-Z_][a-zA-Z0-9_]*(-[a-zA-Z0-9_]+)*/
ident ::= [a-zA-Z_] [a-zA-Z0-9_]* ("-" [a-zA-Z0-9_]+)*
uint-lit ::= [0-9]+ | "0" [xX] [0-9a-fA-F]+
int-lit ::= "-"? [0-9]+ | "0" [xX] [0-9a-fA-F]+
duration-lit ::= uint-lit ("ns" | "us" | "ms" | "s" | "m")
string-lit ::= "\"" ([^"\\] | "\\" (["\\/bfnrt'] | "x" [0-9a-fA-F]{2} | "u" [0-9a-fA-F]{4}))* "\""
hex-string-lit ::= "\"" [0-9a-fA-F: ]* "\""
mac-addr ::= ([0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2}) | ([0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2}) | ([0-9a-fA-F]{4} "." [0-9a-fA-F]{4} "." [0-9a-fA-F]{4})
ip-addr ::= ipv4-addr | ipv6-addr
ipv4-addr ::= [0-9]+ "." [0-9]+ "." [0-9]+ "." [0-9]+
ipv6-addr ::= "::" [0-9a-fA-F:.]* | [0-9a-fA-F]{1,4} (":" [0-9a-fA-F:.]*)+
oid-lit ::= "."? [0-9]+ ("." [0-9]+)* | string-lit
