fins-field ::= "read" | "write" | "response" | "isresponse" | "cmd" ws1 any-str | "icf" ws1 uint-lit | "dna" ws1 uint-lit | "da1" ws1 uint-lit | "da2" ws1 uint-lit | "sna" ws1 uint-lit | "sa1" ws1 uint-lit | "sa2" ws1 uint-lit | "sid" ws1 uint-lit | "area" ws1 any-str | "addr" ws1 uint-lit | "count" ws1 uint-lit | "value" ws1 uint-lit | "errcode" ws1 uint-lit
melsec-field ::= "read" | "write" | "response" | "isresponse" | "cmd" ws1 any-str | "subcmd" ws1 uint-lit | "network" ws1 uint-lit | "pc" ws1 uint-lit | "io" ws1 uint-lit | "station" ws1 uint-lit | "timer" ws1 uint-lit | "device" ws1 any-str | "addr" ws1 uint-lit | "count" ws1 uint-lit | "value" ws1 uint-lit | "endcode" ws1 uint-lit | "errcode" ws1 uint-lit
someip-field ::= "findservice" | "offerservice" | "subscribe" | "subscribeack" | "request" | "requestnoreply" | "notification" | "response" | "error" | "msgtype" ws1 any-str | "serviceid" ws1 uint-lit | "methodid" ws1 uint-lit | "clientid" ws1 uint-lit | "sessionid" ws1 uint-lit | "protover" ws1 uint-lit | "ifacever" ws1 uint-lit | "returncode" ws1 uint-lit | "flags" ws1 uint-lit | "sdservice" ws1 uint-lit | "instanceid" ws1 uint-lit | "majorver" ws1 uint-lit | "sdttl" ws1 uint-lit | "minorver" ws1 uint-lit | "endpointip" ws1 ip-addr | "endpointport" ws1 uint-lit
doip-field ::= "routingreq" | "routingresp" | "diagnostic" | "diagack" | "diagnack" | "vehicleid" | "vehicleeid" | "vehiclevin" | "announcement" | "alivecheckreq" | "alivecheckresp" | "nack" | "msgtype" ws1 any-str | "version" ws1 uint-lit | "invversion" ws1 uint-lit | "src" ws1 uint-lit | "dst" ws1 uint-lit | "code" ws1 uint-lit | "vin" ws1 str-or-ident | "eid" ws1 (mac-addr | hex-string-lit | uint-lit) | "gid" ws1 (mac-addr | hex-string-lit | uint-lit)
c1222-field ::= "read" | "write" | "identify" | "logon" | "logoff" | "terminate" | "response" | "ok" | "service" ws1 any-str | "callingap" ws1 oid-val | "calledap" ws1 oid-val | "callingid" ws1 uint-lit | "calledid" ws1 uint-lit | "epsemctrl" ws1 uint-lit | "edclass" ws1 uint-lit | "tableid" ws1 uint-lit | "value" ws1 uint-lit | "errcode" ws1 uint-lit
gesrtp-field ::= "init" | "initack" | "request" | "response" | "type" ws1 any-str | "read" | "write" | "func" ws1 any-str | "seqnum" ws1 uint-lit | "area" ws1 any-str | "addr" ws1 uint-lit | "count" ws1 uint-lit | "value" ws1 uint-lit | "status" ws1 uint-lit
rocplus-field ::= "read" | "write" | "error" | "opcode" ws1 any-str | "func" ws1 any-str | "dst" ws1 uint-lit | "group" ws1 uint-lit | "src" ws1 uint-lit | "type" ws1 uint-lit | "addr" ws1 uint-lit | "param" ws1 uint-lit | "value" ws1 uint-lit | "isresponse" | "crc" ws1 uint-lit
bsap-field ::= "read" | "write" | "poll" | "func" ws1 any-str | "dst" ws1 uint-lit | "src" ws1 uint-lit | "seqnum" ws1 uint-lit | "addr" ws1 uint-lit | "count" ws1 uint-lit | "value" ws1 uint-lit | "isresponse"
knxnetip-field ::= "connect" | "connack" | "disconnect" | "service" ws1 any-str | "channel" ws1 uint-lit | "seqnum" ws1 uint-lit | "status" ws1 uint-lit | "src" ws1 uint-lit | "dst" ws1 uint-lit | "read" | "write" | "value" ws1 uint-lit

# Lexical terminals (exact match to src/lexer/mod.rs and src/parser/ident.rs)
str-or-ident ::= string-lit | ident
any-str ::= str-or-ident | int-lit | ip-addr | mac-addr | oid-lit
ident ::= [a-zA-Z_] [a-zA-Z0-9_]* ("-" [a-zA-Z0-9_]+)*
uint-lit ::= [0-9]+ | "0" [xX] [0-9a-fA-F]+
int-lit ::= "-"? [0-9]+ | "0" [xX] [0-9a-fA-F]+
real-lit ::= int-lit | "-"? [0-9]+ "." [0-9]+ | "." [0-9]+ | string-lit
hex-bytes ::= hex-string-lit | uint-lit
duration-lit ::= uint-lit ws ("ns" | "us" | "ms" | "s" | "m")
string-lit ::= "\"" ([^"\\\r\n] | "\\" (["\\0nrt'] | "x" [0-9a-fA-F]{2} | "u" [0-9a-fA-F]{4} | "u{" [0-9a-fA-F]{1,6} "}"))* "\""
hex-string-lit ::= "\"" [0-9a-fA-F: \t]* "\""
mac-addr ::= ([0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2} ":" [0-9a-fA-F]{2}) | ([0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2} "-" [0-9a-fA-F]{2}) | ([0-9a-fA-F]{4} "." [0-9a-fA-F]{4} "." [0-9a-fA-F]{4})
ip-addr ::= ipv4-addr | ipv6-addr
ipv4-addr ::= [0-9]+ "." [0-9]+ "." [0-9]+ "." [0-9]+
ipv6-addr ::= "::" [0-9a-fA-F:.]* | [0-9a-fA-F]{1,4} (":" [0-9a-fA-F:.]*)+
oid-lit ::= "."? [0-9]+ ("." [0-9]+)+ | string-lit
oid-val ::= oid-lit | ip-addr
