# ============================================================================
# FrameAssembly GBNF Constrained Decoding Grammar (llama.cpp / XGrammar)
# Version: 3.3.1 — Strict-lowercase [a-z0-9]+ built-in keywords, optional
# flow blocks (2-block host + compile or reusable flow templates), repeat
# blocks, and all 146 native Layer 2 through Layer 7 protocols & modifiers.
# Usage: llama-server -m model.gguf --grammar-file frameassembly.gbnf
# ============================================================================

root ::= ws (host-decl | flow-decl)* compile-block (host-decl | flow-decl)* ws

# Whitespace (including \f and UTF-8 BOM \uFEFF) and single-line comments (EOF-safe)
ws ::= ([ \t\n\r\x0c\ufeff] | "//" [^\r\n]*)*
ws1 ::= ([ \t\n\r\x0c\ufeff] | "//" [^\r\n]*)+

# Top-level structure (2-block host+compile or optional flow templates, repeat blocks)
host-decl ::= "host" ws1 ident ws "{" ws host-prop+ "}" ws
host-prop ::= ("ip" ws1 ip-addr | "mac" ws1 mac-addr) ws

flow-decl ::= "flow" ws1 ident ws "(" ws param-list? ")" ws "{" ws flow-stmt* "}" ws
param-list ::= ident ws ("," ws ident ws)*
flow-stmt ::= flow-repeat | flow-call | frame-stmt
flow-repeat ::= "repeat" ws1 uint-lit ws "{" ws flow-stmt* "}" ws

frame-stmt ::= ident ws direction ws ident (ws1 frame-field)* ws
direction ::= "->" | "<-"

compile-block ::= "compile" ws "{" ws run-stmt* "}" ws
run-stmt ::= run-repeat | flow-call | frame-stmt
run-repeat ::= "repeat" ws1 uint-lit ws "{" ws run-stmt* "}" ws
flow-call ::= ident ws "(" ws param-list? ")" ws

# Frame fields & 146 protocol keywords
frame-field ::= protocol-kw | universal-mod | l2-mod | l3-mod | l4-mod | l2-proto-field | l3-proto-field | l4-proto-field | snmp-proto-field | l7-proto-field
protocol-kw ::= l2-proto | l3-proto | l4-proto | snmp-proto | l7-infra-proto | l7-app-proto | l7-data-proto | l7-telco-proto | l7-ot-proto
l2-proto ::= "arp" | "vlan" | "qinq" | "lldp" | "stp" | "lacp" | "eapol" | "mpls" | "cdp" | "isis" | "macsec" | "pfc" | "pppoe" | "nsh" | "profinet" | "goose" | "sv" | "ethercat"
l3-proto ::= "icmp" | "ndp" | "igmp" | "mld" | "gre" | "vxlan" | "geneve" | "ipsec" | "esp" | "ah" | "ikev2" | "wireguard" | "ospf" | "bgp" | "rip" | "vrrp" | "hsrp" | "pim" | "bfd" | "openflow" | "ipip" | "srv6" | "erspan" | "rsvp" | "ldp" | "bmp" | "rpkirtr" | "l2tp" | "lisp" | "glbp" | "gtpu"
l4-proto ::= "tcp" | "udp" | "sctp"
snmp-proto ::= "snmp1" | "snmp2" | "snmp3"
l7-infra-proto ::= "dns" | "mdns" | "dhcp" | "ntp" | "ptp" | "radius" | "tacacs" | "syslog" | "netflow" | "ipfix" | "sflow" | "llmnr" | "nbns" | "doh" | "wsdiscovery" | "twamp" | "netconf" | "ipmi"
l7-app-proto ::= "tftp" | "ftp" | "ssh" | "telnet" | "http" | "http2" | "grpc" | "websocket" | "tls" | "quic" | "stun" | "turn" | "sip" | "rtp" | "rtcp" | "rtsp" | "h323" | "sccp" | "mgcp" | "smtp" | "imap" | "pop3" | "irc" | "kerberos" | "ldap" | "ntlm" | "smb" | "nfs" | "dcerpc" | "rdp" | "socks" | "vnc" | "ssdp" | "whois"
l7-data-proto ::= "redis" | "memcached" | "mysql" | "postgres" | "mssql" | "mongodb" | "tns" | "kafka" | "mqtt" | "coap" | "amqp" | "iscsi" | "nvmetcp" | "rocev2"
l7-telco-proto ::= "gtpc" | "pfcp" | "diameter" | "ngap" | "s1ap"
l7-ot-proto ::= "modbus" | "bacnet" | "dnp3" | "s7comm" | "ethernetip" | "opcua" | "iec104" | "mms" | "s7commplus" | "synchrophasor" | "hartip" | "fins" | "melsec" | "someip" | "doip" | "c1222" | "gesrtp" | "rocplus" | "bsap" | "knxnetip"

# Universal & L2/L3/L4 frame modifiers
universal-mod ::= "wait" ws1 duration-lit | "payload" ws1 string-lit | "hexpayload" ws1 hex-string-lit | "comment" ws1 string-lit
l2-mod ::= "srcmac" ws1 mac-addr | "dstmac" ws1 mac-addr | "ethertype" ws1 uint-lit | "vlan" (ws1 uint-lit)? | "pcp" ws1 uint-lit | "dei" ws1 uint-lit | "qinq" (ws1 uint-lit)? | "innervlan" ws1 uint-lit | "mpls" (ws1 uint-lit)? | "label" ws1 uint-lit | ("exp" | "tc") ws1 uint-lit | "bos" ws1 uint-lit | "mplsttl" ws1 uint-lit | "fcs" | "badfcs"
l3-mod ::= "ttl" ws1 uint-lit | "dscp" ws1 uint-lit | "ecn" ws1 uint-lit | "flowlabel" ws1 uint-lit | "ipid" ws1 uint-lit | "df" | "mf" | "fragoffset" ws1 uint-lit | "routeralert" | "badipchecksum" | "nextheader" ws1 uint-lit
l4-mod ::= "srcport" ws1 uint-lit | "dstport" ws1 uint-lit | "transport" ws1 ("tcp" | "udp" | "sctp") | "badchecksum" | "nochecksum" | tcp-flag | "seq" ws1 uint-lit | "acknum" ws1 uint-lit | ("win" | "window") ws1 uint-lit | "urgent" ws1 uint-lit | "mss" ws1 uint-lit | "wscale" ws1 uint-lit | "sackperm" | "sackblock" ws1 uint-lit ws1 uint-lit | "tsval" ws1 uint-lit | "tsecr" ws1 uint-lit | "tcpmd5" ws1 hex-string-lit | "tfo" ws1 hex-string-lit
tcp-flag ::= "syn" | "ack" | "fin" | "rst" | "psh" | "urg" | "ece" | "cwr"

# Layer 2 protocol-specific fields (18 protocols; vlan/qinq/mpls in l2-mod)
l2-proto-field ::= arp-field | cdp-field | eapol-field | ethercat-field | goose-field | isis-field | lacp-field | lldp-field | macsec-field | nsh-field | pfc-field | pppoe-field | profinet-field | stp-field | sv-field
eapol-pkt-type ::= "start" | "logoff" | "key" | "eappacket"
isis-pdu-type ::= "l1iih" | "hello" | "l2iih" | "p2piih" | "l1lsp" | "l2lsp" | "l1csnp" | "l2csnp" | "l1psnp" | "l2psnp"
pppoe-stage ::= "padi" | "pado" | "padr" | "pads" | "padt" | "session"
arp-field ::= "request" | "reply" | "gratuitous" | "garp" | ("sha" | "sendermac") ws1 mac-addr | ("spa" | "senderip") ws1 ip-addr | ("tha" | "targetmac") ws1 mac-addr | ("tpa" | "targetip") ws1 ip-addr
cdp-field ::= "version" ws1 uint-lit | "deviceid" ws1 any-str | "addr" ws1 ip-addr | "portid" ws1 any-str | "capabilities" ws1 uint-lit | "swversion" ws1 any-str | "platform" ws1 any-str | "nativevlan" ws1 uint-lit
eapol-field ::= "version" ws1 uint-lit | "eapcode" ws1 uint-lit | "eapid" ws1 uint-lit | "eapmethod" ws1 uint-lit | "identity" ws1 str-or-ident | ("type" ws1)? eapol-pkt-type
ethercat-field ::= "cmd" ws1 any-str | "nop" | "read" | "write" | "idx" ws1 uint-lit | "adp" ws1 uint-lit | ("ado" | "offset") ws1 uint-lit | "addr" ws1 uint-lit | "irq" ws1 uint-lit | "wkc" ws1 uint-lit
goose-field ::= "appid" ws1 uint-lit | "gocbref" ws1 str-or-ident | "timetolive" ws1 uint-lit | "datset" ws1 str-or-ident | "goid" ws1 str-or-ident | "stnum" ws1 uint-lit | "sqnum" ws1 uint-lit | "simulation" | "confrev" ws1 uint-lit | "ndscom" | "numdatsetentries" ws1 uint-lit
isis-field ::= ("type" ws1)? isis-pdu-type | "type" ws1 any-str | "sysid" ws1 any-str | "area" ws1 any-str | "holdtime" ws1 uint-lit | "priority" ws1 uint-lit | "lanid" ws1 any-str | "circuittype" ws1 uint-lit | "lifetime" ws1 uint-lit | "seqnum" ws1 uint-lit | "hostname" ws1 any-str
lacp-field ::= "actorsys" ws1 mac-addr | "actorkey" ws1 uint-lit | "actorport" ws1 uint-lit | "partnersys" ws1 mac-addr | "partnerkey" ws1 uint-lit | "partnerport" ws1 uint-lit | "actorstate" ws1 uint-lit | "partnerstate" ws1 uint-lit
lldp-field ::= "chassisid" ws1 str-or-ident | "sysname" ws1 str-or-ident | "sysdesc" ws1 str-or-ident | "portid" ws1 (uint-lit | str-or-ident)
macsec-field ::= "tci" ws1 uint-lit | "an" ws1 uint-lit | "sl" ws1 uint-lit | "pn" ws1 uint-lit | "sci" ws1 uint-lit | "icv" ws1 hex-bytes
nsh-field ::= "version" ws1 uint-lit | "oam" | "mdtype" ws1 uint-lit | "nextproto" ws1 any-str | "spi" ws1 uint-lit | "si" ws1 uint-lit | "context" ws1 hex-bytes
pfc-field ::= "enable" ws1 uint-lit | "quanta" ws1 uint-lit | "q0" ws1 uint-lit | "q1" ws1 uint-lit | "q2" ws1 uint-lit | "q3" ws1 uint-lit | "q4" ws1 uint-lit | "q5" ws1 uint-lit | "q6" ws1 uint-lit | "q7" ws1 uint-lit
pppoe-field ::= ("type" ws1)? pppoe-stage | "sessionid" ws1 uint-lit | "servicename" ws1 any-str | "acname" ws1 any-str | "hostuniq" ws1 hex-bytes | "accookie" ws1 hex-bytes | "pppproto" ws1 (uint-lit | str-or-ident)
profinet-field ::= "frameid" ws1 uint-lit | "cycle" ws1 uint-lit | "datastatus" ws1 uint-lit | "transferstatus" ws1 uint-lit | "xid" ws1 uint-lit | "service" ws1 any-str | "request" | "response" | "read" | "write" | "get" | "set" | "release" | "connect"
stp-field ::= "rootid" ws1 any-str | "bridgeid" ws1 any-str | "portid" ws1 (uint-lit | str-or-ident) | "cost" ws1 uint-lit | "maxage" ws1 uint-lit | "hellotime" ws1 uint-lit | "forwarddelay" ws1 uint-lit | "rstp" | "flags" ws1 uint-lit
sv-field ::= "appid" ws1 uint-lit | "svid" ws1 str-or-ident | "datset" ws1 str-or-ident | "smpcnt" ws1 uint-lit | "confrev" ws1 uint-lit | "smpsynch" ws1 uint-lit | "smprate" ws1 uint-lit | "simulation"

# Layer 3 protocol-specific fields (31 protocols; ah/esp have no extra fields)
l3-proto-field ::= bfd-field | bgp-field | bmp-field | erspan-field | geneve-field | glbp-field | gre-field | gtpu-field | hsrp-field | icmp-field | igmp-field | ikev2-field | ipip-field | ipsec-field | l2tp-field | ldp-field | lisp-field | mld-field | ndp-field | openflow-field | ospf-field | pim-field | rip-field | rpkirtr-field | rsvp-field | srv6-field | vrrp-field | vxlan-field | wireguard-field
ikev2-exchange-mode ::= "sainit" | "auth" | "createchildsa" | "informational"
wireguard-pkt-type ::= "initiation" | "response" | "cookie" | "data"
openflow-pkt-type ::= "hello" | "featuresreq" | "featuresreply" | "packetin" | "packetout" | "flowmod" | "echoreq" | "echorequest" | "echoreply"
bfd-field ::= "state" ws1 uint-lit | "diag" ws1 uint-lit | "mydisc" ws1 uint-lit | "yourdisc" ws1 uint-lit | "mintx" ws1 uint-lit | "minrx" ws1 uint-lit | "mult" ws1 uint-lit
bgp-field ::= "open" | "update" | "notification" | "keepalive" | "asn" ws1 uint-lit | "holdtime" ws1 uint-lit | "bgpid" ws1 ip-addr | ("prefix" | "nlri") ws1 any-str | "nexthop" ws1 ip-addr
bmp-field ::= "routemon" | "statsreport" | "peerdown" | "peerup" | "initiation" | "termination" | "version" ws1 uint-lit | "peertype" ws1 uint-lit | "flags" ws1 uint-lit | "peerip" ws1 ip-addr | "asn" ws1 uint-lit | "bgpid" ws1 ip-addr | "sysname" ws1 str-or-ident | "sysdesc" ws1 str-or-ident | "reason" ws1 uint-lit
erspan-field ::= "v2" | "v3" | "version" ws1 uint-lit | "sessionid" ws1 uint-lit | "vid" ws1 uint-lit | "cos" ws1 uint-lit | "greseq" ws1 uint-lit | "index" ws1 uint-lit | "timestamp" ws1 uint-lit | "direction" ws1 uint-lit
geneve-field ::= ("vni" | "vnid") ws1 uint-lit | "optclass" ws1 uint-lit | "opttype" ws1 uint-lit | "protocoltype" ws1 uint-lit
glbp-field ::= "hello" | "request" | "response" | "version" ws1 uint-lit | "group" ws1 uint-lit | "ownerid" ws1 mac-addr | "state" ws1 uint-lit | "priority" ws1 uint-lit | "weight" ws1 uint-lit | "forwarder" ws1 uint-lit | "hellotime" ws1 uint-lit | "holdtime" ws1 uint-lit | "redirect" ws1 uint-lit | "timeout" ws1 uint-lit | "vip" ws1 ip-addr | "vmac" ws1 mac-addr | "auth" ws1 str-or-ident
gre-field ::= ("grekey" | "key") ws1 uint-lit | "greseq" ws1 uint-lit | "greproto" ws1 uint-lit | "checksum"
gtpu-field ::= "gpdu" | "echorequest" | "echoreply" | "errorindication" | "endmarker" | "teid" ws1 uint-lit | "flags" ws1 uint-lit | "seqnum" ws1 uint-lit | "npdu" ws1 uint-lit | "qfi" ws1 uint-lit
hsrp-field ::= "group" ws1 uint-lit | "priority" ws1 uint-lit | "state" ws1 uint-lit | "auth" ws1 str-or-ident | "vip" ws1 ip-addr | "hellotime" ws1 uint-lit | "holdtime" ws1 uint-lit
icmp-field ::= "echorequest" | "echoreply" | "destunreach" | "timeexceeded" | "redirect" | "gateway" ws1 ip-addr | "type" ws1 uint-lit | "code" ws1 uint-lit | "id" ws1 uint-lit | "seq" ws1 uint-lit
igmp-field ::= "query" | "report" | "leave" | "v1" | "v2" | "v3" | "version" ws1 uint-lit | "group" ws1 (ip-addr | uint-lit) | "maxresp" ws1 uint-lit
ikev2-field ::= "initiatorspi" ws1 uint-lit | "responderspi" ws1 uint-lit | "exchange" ws1 ikev2-exchange-mode | "sainit" | "auth" | "createchildsa" | "informational" | "msgid" ws1 uint-lit | "flags" ws1 uint-lit | ("nextpayload" | "nextheader") ws1 uint-lit
ipip-field ::= "v4" | "v6" | "version" ws1 uint-lit | "srcip" ws1 ip-addr | "dstip" ws1 ip-addr | "innerttl" ws1 uint-lit | "innerdscp" ws1 uint-lit | "proto" ws1 uint-lit
ipsec-field ::= "spi" ws1 uint-lit | "seq" ws1 uint-lit | "iv" ws1 hex-bytes | "icv" ws1 hex-bytes | "nextheader" ws1 uint-lit
l2tp-field ::= "v2" | "v3" | "version" ws1 uint-lit | "data" | "hello" | "sccrq" | "sccrp" | "scccn" | "stopccn" | "msgtype" ws1 any-str | "tunnelid" ws1 uint-lit | "sessionid" ws1 uint-lit | "ns" ws1 uint-lit | "nr" ws1 uint-lit | "flags" ws1 uint-lit
ldp-field ::= "hello" | "init" | "keepalive" | "notification" | "labelmapping" | "labelrequest" | "labelwithdraw" | "labelrelease" | "lsrid" ws1 ip-addr | "labelspace" ws1 uint-lit | "msgid" ws1 uint-lit | "holdtime" ws1 uint-lit | "label" ws1 uint-lit | "prefix" ws1 any-str | "status" ws1 uint-lit
lisp-field ::= "data" | "maprequest" | "mapreply" | "mapregister" | "mapnotify" | "ecm" | "flags" ws1 uint-lit | "iid" ws1 uint-lit | "nonce" ws1 uint-lit | "eid" ws1 any-str | "rloc" ws1 ip-addr | "priority" ws1 uint-lit | "weight" ws1 uint-lit
mld-field ::= "query" | "report" | "done" | "multicastaddr" ws1 ip-addr | "maxrespdelay" ws1 uint-lit
ndp-field ::= "routersolicit" | "routeradvert" | "neighborsolicit" | "neighboradvert" | "redirect" | "target" ws1 ip-addr | "slla" ws1 mac-addr | "tlla" ws1 mac-addr | "routerlifetime" ws1 uint-lit
openflow-field ::= "version" ws1 uint-lit | "xid" ws1 uint-lit | "dpid" ws1 uint-lit | "tableid" ws1 uint-lit | "priority" ws1 uint-lit | ("type" ws1)? openflow-pkt-type
ospf-field ::= "hello" | "dbd" | "lsr" | "lsu" | "lsack" | "routerid" ws1 ip-addr | "areaid" ws1 (uint-lit | ip-addr) | "hellointerval" ws1 uint-lit | "deadinterval" ws1 uint-lit | "priority" ws1 uint-lit
pim-field ::= "hello" | "joinprune" | "register" | "group" ws1 ip-addr | "source" ws1 ip-addr | "rp" ws1 ip-addr | "holdtime" ws1 uint-lit | "drpriority" ws1 uint-lit
rip-field ::= "request" | "reply" | "response" | "command" ws1 any-str | "metric" ws1 uint-lit | "prefix" ws1 ip-addr | "nexthop" ws1 ip-addr | "tag" ws1 uint-lit
rpkirtr-field ::= "serialnotify" | "serialquery" | "resetquery" | "cacheresponse" | "ipv4prefix" | "ipv6prefix" | "endofdata" | "cachereset" | "errorreport" | "version" ws1 uint-lit | "sessionid" ws1 uint-lit | "serial" ws1 uint-lit | "announce" | "withdraw" | "flags" ws1 uint-lit | "prefix" ws1 any-str | "maxlen" ws1 uint-lit | "asn" ws1 uint-lit | "refresh" ws1 uint-lit | "retry" ws1 uint-lit | "expire" ws1 uint-lit | "errcode" ws1 uint-lit | "errmsg" ws1 str-or-ident
rsvp-field ::= "path" | "resv" | "patherr" | "resverr" | "pathtear" | "resvtear" | "resvconf" | "hello" | "tunnelid" ws1 uint-lit | "lspid" ws1 uint-lit | "label" ws1 uint-lit | "refresh" ws1 uint-lit | "srcip" ws1 ip-addr | "dstip" ws1 ip-addr | "errcode" ws1 uint-lit
srv6-field ::= "nextheader" ws1 uint-lit | "segleft" ws1 uint-lit | "flags" ws1 uint-lit | "tag" ws1 uint-lit | "sid" ws1 ip-addr
vrrp-field ::= "vrid" ws1 uint-lit | "priority" ws1 uint-lit | "advint" ws1 uint-lit | "vip" ws1 ip-addr | "version" ws1 uint-lit
vxlan-field ::= ("vni" | "vnid") ws1 uint-lit
wireguard-field ::= ("type" ws1)? wireguard-pkt-type | "sender" ws1 uint-lit | "receiver" ws1 uint-lit | "counter" ws1 uint-lit

# Layer 4 protocol-specific fields (tcp/udp in l4-mod; sctp below)
l4-proto-field ::= sctp-field
sctp-field ::= "vtag" ws1 uint-lit | "stream" ws1 uint-lit | "ssn" ws1 uint-lit | "ppid" ws1 uint-lit | "tsn" ws1 uint-lit | "chunk" ws1 any-str | "data" | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack" | "abort" | "shutdown" | "shutdownack" | "shutdowncomplete" | "cookieecho" | "cookieack"

# SNMP v1/v2c/v3 USM & VarBind fields
snmp-proto-field ::= "community" ws1 string-lit | "user" ws1 str-or-ident | "sysuptime" ws1 uint-lit | "agentip" ws1 ip-addr | "gentrap" ws1 uint-lit | "spectrap" ws1 uint-lit | "engineid" ws1 string-lit | "engineboots" ws1 uint-lit | "enginetime" ws1 uint-lit | "contextname" ws1 string-lit | "nonrepeaters" ws1 uint-lit | "maxrepetitions" ws1 uint-lit | "reqid" ws1 uint-lit | "oid" ws1 oid-val | "enterprise" ws1 oid-val | snmp-varbind | "auth" ws1 snmp-auth-algo ws1 string-lit | "priv" ws1 snmp-priv-algo ws1 string-lit | "trap" | "get" | "set" | "response" | "inform" | "getnext" | "getbulk" | "report"
snmp-varbind ::= "varbind" ws1 oid-val ws1 varbind-val
varbind-val ::= "nullval" | "null" | "string" ws1 string-lit | "int" ws1 int-lit | "timeticks" ws1 uint-lit | "ipval" ws1 ip-addr | "oidval" ws1 oid-val | "counter32" ws1 uint-lit | "gauge32" ws1 uint-lit | "counter64" ws1 uint-lit
snmp-auth-algo ::= "md5" | "sha" | "sha256" | "sha384" | "sha512"
snmp-priv-algo ::= "des" | "aes"

# Layer 7 protocol-specific fields (91 non-SNMP L7 protocols)
l7-proto-field ::= l7-infra-field | l7-app-field | l7-data-field | l7-telco-field | l7-ot-field
l7-infra-field ::= dns-field | mdns-field | dhcp-field | ntp-field | ptp-field | radius-field | tacacs-field | syslog-field | netflow-field | ipfix-field | sflow-field | llmnr-field | nbns-field | doh-field | wsdiscovery-field | twamp-field | netconf-field | ipmi-field
l7-app-field ::= tftp-field | ftp-field | ssh-field | telnet-field | http-field | http2-field | grpc-field | websocket-field | tls-field | quic-field | stun-field | turn-field | sip-field | rtp-field | rtcp-field | rtsp-field | h323-field | sccp-field | mgcp-field | smtp-field | imap-field | pop3-field | irc-field | kerberos-field | ldap-field | ntlm-field | smb-field | nfs-field | dcerpc-field | rdp-field | socks-field | vnc-field | ssdp-field | whois-field
l7-data-field ::= redis-field | memcached-field | mysql-field | postgres-field | mssql-field | mongodb-field | tns-field | kafka-field | mqtt-field | coap-field | amqp-field | iscsi-field | nvmetcp-field | rocev2-field
l7-telco-field ::= gtpc-field | pfcp-field | diameter-field | ngap-field | s1ap-field
l7-ot-field ::= modbus-field | bacnet-field | dnp3-field | s7comm-field | ethernetip-field | opcua-field | iec104-field | mms-field | s7commplus-field | synchrophasor-field | hartip-field | fins-field | melsec-field | someip-field | doip-field | c1222-field | gesrtp-field | rocplus-field | bsap-field | knxnetip-field
tacacs-pkt-type ::= "authen" | "author" | "acct"

# L7 infrastructure & management
dns-field ::= "txid" ws1 uint-lit | "qname" ws1 any-str | "qtype" ws1 any-str | "rdata" ws1 any-str | "rcode" ws1 uint-lit | "ansttl" ws1 uint-lit | "query" | "response" | "edns0" | "udpsize" ws1 uint-lit | "dobit"
mdns-field ::= "txid" ws1 uint-lit | "qname" ws1 any-str | "qtype" ws1 any-str | "rdata" ws1 any-str | "rcode" ws1 uint-lit | "ansttl" ws1 uint-lit | "query" | "response" | "edns0" | "udpsize" ws1 uint-lit | "dobit"
dhcp-field ::= "discover" | "solicit" | "offer" | "advertise" | "request" | "ack" | "reply" | "release" | "xid" ws1 uint-lit | "ciaddr" ws1 ip-addr | "yiaddr" ws1 ip-addr | "siaddr" ws1 ip-addr | "chaddr" ws1 mac-addr | "hostname" ws1 str-or-ident | "dnsserver" ws1 ip-addr | "router" ws1 ip-addr | "subnetmask" ws1 ip-addr | "leasetime" ws1 uint-lit
ntp-field ::= "li" ws1 uint-lit | "vn" ws1 uint-lit | "mode" ws1 uint-lit | "stratum" ws1 uint-lit | "poll" ws1 uint-lit | "precision" ws1 int-lit | "refid" ws1 str-or-ident | "txtimestamp" ws1 uint-lit
