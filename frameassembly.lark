// ============================================================================
// FrameAssembly Lark Grammar (Outlines / vLLM / Guidance / XGrammar / llguidance)
// Version: 3.3.0 — Strict-lowercase [a-z0-9]+ built-in keywords, optional
// flow blocks (2-block host + compile or reusable flow templates), and all
// 146 native Layer 2 through Layer 7 protocols, modifiers, and literals.
// Synchronized 1:1 with src/lexer/mod.rs, grammar.ebnf, and frameassembly.gbnf.
// ============================================================================

start: top_level_decl* compile_block top_level_decl*

top_level_decl: host_decl
              | flow_decl

// 1. Host Declarations (at least one ip or mac property in any order)
host_decl: "host" ident_or_kw "{" host_prop+ "}"
host_prop: "ip" ip_addr
         | "mac" MAC_ADDR

// 2. Optional Flow Declarations & Statements
//    Minimal 2-block programs use only host + compile; flow blocks are optional.
flow_decl: "flow" ident_or_kw "(" param_list? ")" "{" flow_stmt* "}"
param_list: ident_or_kw ("," ident_or_kw)*
flow_stmt: flow_repeat
         | flow_call
         | frame_stmt
flow_repeat: "repeat" UINT_LIT "{" flow_stmt* "}"
frame_stmt: ident_or_kw direction ident_or_kw frame_field*
direction: "->" | "<-"

// 3. Compile Block & Inline Frame Statements
compile_block: "compile" "{" run_stmt* "}"
run_stmt: run_repeat
        | flow_call
        | frame_stmt
run_repeat: "repeat" UINT_LIT "{" run_stmt* "}"
flow_call: ident_or_kw "(" param_list? ")"

// 4. Frame Fields (Protocols, Modifiers & Protocol Attributes)
frame_field: protocol_kw
           | universal_mod
           | l2_mod
           | l3_mod
           | l4_mod
           | l2_proto_field
           | l3_proto_field
           | l4_proto_field
           | snmp_proto_field
           | l7_proto_field

// 5. All 146 Native Protocol Keywords
protocol_kw: l2_proto
           | l3_proto
           | l4_proto
           | snmp_proto
           | l7_infra_proto
           | l7_app_proto
           | l7_ot_proto
l2_proto: "arp" | "vlan" | "qinq" | "lldp" | "stp" | "lacp" | "eapol" | "mpls" | "cdp"
          | "ethercat" | "goose" | "isis" | "macsec" | "nsh" | "pfc" | "pppoe" | "profinet" | "sv"
l3_proto: "icmp" | "ndp" | "igmp" | "mld" | "gre" | "vxlan" | "geneve" | "ipsec"
          | "esp" | "ah" | "ikev2" | "wireguard" | "ospf" | "bgp" | "rip" | "vrrp"
          | "hsrp" | "pim" | "bfd" | "openflow" | "bmp" | "erspan" | "glbp" | "gtpu"
          | "ipip" | "l2tp" | "ldp" | "lisp" | "rpkirtr" | "rsvp" | "srv6"
l4_proto: "tcp" | "udp" | "sctp"
snmp_proto: "snmp1" | "snmp2" | "snmp3"
l7_infra_proto: "dns" | "mdns" | "dhcp" | "ntp" | "ptp" | "radius" | "tacacs"
                | "syslog" | "netflow" | "ipfix" | "sflow" | "llmnr" | "nbns" | "doh"
                | "diameter" | "netconf" | "twamp" | "ngap" | "s1ap"
l7_app_proto: "tftp" | "ftp" | "ssh" | "telnet" | "http" | "http2" | "grpc"
              | "websocket" | "tls" | "quic" | "stun" | "turn" | "sip" | "rtp"
              | "rtcp" | "rtsp" | "smtp" | "imap" | "pop3" | "kerberos" | "ldap"
              | "ntlm" | "dcerpc" | "smb" | "nfs" | "iscsi" | "nvmetcp" | "redis"
              | "memcached" | "mysql" | "postgres" | "mssql" | "mongodb" | "tns" | "mqtt"
              | "coap" | "amqp" | "kafka" | "ssdp" | "wsdiscovery" | "whois" | "h323"
              | "mgcp" | "sccp" | "gtpc" | "pfcp" | "rocev2" | "rdp" | "vnc"
              | "socks" | "ipmi" | "irc" | "doip" | "someip" | "knxnetip" | "c1222"
l7_ot_proto: "modbus" | "bacnet" | "dnp3" | "s7comm" | "s7commplus" | "ethernetip" | "opcua"
             | "iec104" | "fins" | "melsec" | "gesrtp" | "mms" | "bsap" | "hartip"
             | "rocplus" | "synchrophasor"

// 6. Universal & Layer 2-4 Modifiers
universal_mod: "wait" duration_lit
             | "payload" string_lit
             | "hexpayload" HEX_STRING_LIT
             | "comment" string_lit

l2_mod: "srcmac" MAC_ADDR
      | "dstmac" MAC_ADDR
      | "ethertype" UINT_LIT
      | "vlan" UINT_LIT?
      | "pcp" UINT_LIT
      | "dei" UINT_LIT
      | "qinq" UINT_LIT?
      | "innervlan" UINT_LIT
      | "mpls" UINT_LIT?
      | "label" UINT_LIT
      | ("exp" | "tc") UINT_LIT
      | "bos" UINT_LIT
      | "mplsttl" UINT_LIT
      | "fcs"
      | "badfcs"

l3_mod: "ttl" UINT_LIT
      | "dscp" UINT_LIT
      | "ecn" UINT_LIT
      | "flowlabel" UINT_LIT
      | "ipid" UINT_LIT
      | "df"
      | "mf"
      | "fragoffset" UINT_LIT
      | "routeralert"
      | "badipchecksum"
      | "nextheader" UINT_LIT

l4_mod: "srcport" UINT_LIT
      | "dstport" UINT_LIT
      | "transport" ("tcp" | "udp" | "sctp")
      | "badchecksum"
      | "nochecksum"
      | tcp_flag
      | "seq" UINT_LIT
      | "acknum" UINT_LIT
      | ("win" | "window") UINT_LIT
      | "urgent" UINT_LIT
      | "mss" UINT_LIT
      | "wscale" UINT_LIT
      | "sackperm"
      | "sackblock" UINT_LIT UINT_LIT
      | "tsval" UINT_LIT
      | "tsecr" UINT_LIT
      | "tcpmd5" HEX_STRING_LIT
      | "tfo" HEX_STRING_LIT

tcp_flag: "syn" | "ack" | "fin" | "rst" | "psh" | "urg" | "ece" | "cwr"

// 7. Layer 2 Protocol Sub-Keywords (18 protocols)
l2_proto_field: "request"
              | "reply"
              | "gratuitous" | "garp"
              | ("sha" | "sendermac") MAC_ADDR
              | ("spa" | "senderip") ip_addr
              | ("tha" | "targetmac") MAC_ADDR
              | ("tpa" | "targetip") ip_addr
              | "chassisid" str_or_ident
              | "portid" any_str
              | "sysname" str_or_ident
              | "sysdesc" str_or_ident
              | "rootid" any_str
              | "bridgeid" any_str
              | "cost" UINT_LIT
              | "maxage" UINT_LIT
              | "hellotime" UINT_LIT
              | "forwarddelay" UINT_LIT
              | "rstp"
              | "flags" UINT_LIT
              | "actorsys" MAC_ADDR
              | "actorkey" UINT_LIT
              | "actorport" UINT_LIT
              | "partnersys" MAC_ADDR
              | "partnerkey" UINT_LIT
              | "partnerport" UINT_LIT
              | "actorstate" UINT_LIT
              | "partnerstate" UINT_LIT
              | "version" UINT_LIT
              | "type" any_str
              | "start" | "logoff" | "key" | "eappacket"
              | "eapcode" UINT_LIT
              | "eapid" UINT_LIT
              | "eapmethod" UINT_LIT
              | "identity" str_or_ident
              | "deviceid" any_str
              | "addr" (ip_addr | UINT_LIT)
