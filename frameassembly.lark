duration_lit: DURATION_LIT | UINT_LIT time_unit
time_unit: "ns" | "us" | "ms" | "s" | "m"
ip_addr: IPV4_ADDR | IPV6_ADDR
oid_lit: OID_LIT | IPV4_ADDR | string_lit
real_lit: int_lit | OID_LIT | NEG_FLOAT_LIT | string_lit

// 6-tier terminal priority ladder mirroring src/lexer/mod.rs (zero regex overlap):
// 6: MAC_ADDR (. : - dotted) > 5: DURATION_LIT, IPV4_ADDR > 4: UINT_LIT, NEG_INT_LIT,
// NEG_FLOAT_LIT > 3: OID_LIT, HEX_STRING_LIT > 2: IPV6_ADDR, STRING_LIT > 0: IDENT
MAC_ADDR.6: /[0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5}|[0-9a-fA-F]{2}(?:-[0-9a-fA-F]{2}){5}|[0-9a-fA-F]{4}(?:\.[0-9a-fA-F]{4}){2}/
DURATION_LIT.5: /(?:0[xX][0-9a-fA-F]+|[0-9]+)(?:ns|us|ms|s|m)\b/
IPV4_ADDR.5: /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/
UINT_LIT.4: /0[xX][0-9a-fA-F]+|[0-9]+/
NEG_INT_LIT.4: /-[0-9]+/
NEG_FLOAT_LIT.4: /-[0-9]+\.[0-9]+/
OID_LIT.3: /\.?[0-9]+(?:\.[0-9]+)+/
HEX_STRING_LIT.3: /"[0-9a-fA-F: \t]*"/
IPV6_ADDR.2: /::[0-9a-fA-F:.]*|[0-9a-fA-F]{1,4}(?::[0-9a-fA-F:.]*)+/
STRING_LIT.2: /"(?:[^"\\\r\n]|\\[^\r\n])*"/
IDENT.0: /[a-zA-Z_][a-zA-Z0-9_]*(-[a-zA-Z0-9_]+)*/

COMMENT: /\/\/[^\r\n]*/
WS: /[ \t\r\n\f\ufeff]+/

%ignore WS
%ignore COMMENT
