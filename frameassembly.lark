// 9. Layer 4 SCTP Sub-Keywords
l4_proto_field: "vtag" UINT_LIT
              | "stream" UINT_LIT
              | "ssn" UINT_LIT
              | "ppid" UINT_LIT
              | "tsn" UINT_LIT
              | "chunk" any_str
              | "data" | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack"
              | "abort" | "shutdown" | "shutdownack" | "shutdowncomplete" | "cookieecho" | "cookieack"

// 10. SNMPv1 / SNMPv2c / SNMPv3 Sub-Keywords
snmp_proto_field: "trap" | "inform" | "get" | "getnext" | "getbulk" | "set"
                | "response" | "report"
                | "community" string_lit
                | "oid" oid_lit
                | "sysuptime" UINT_LIT
                | "reqid" UINT_LIT
                | "nonrepeaters" UINT_LIT
                | "maxrepetitions" UINT_LIT
                | "enterprise" oid_lit
                | "agentip" ip_addr
                | "gentrap" UINT_LIT
                | "spectrap" UINT_LIT
                | "user" any_str
                | "engineid" string_lit
                | "engineboots" UINT_LIT
                | "enginetime" UINT_LIT
                | "contextname" string_lit
                | "auth" ("md5" | "sha" | "sha256" | "sha384" | "sha512") string_lit
                | "priv" ("des" | "aes") string_lit
                | "varbind" oid_lit varbind_val

varbind_val: "nullval" | "null"
           | "string" string_lit
           | "int" int_lit
           | "timeticks" UINT_LIT
           | "ipval" ip_addr
           | "oidval" oid_lit
           | "counter32" UINT_LIT
           | "gauge32" UINT_LIT
           | "counter64" UINT_LIT

