// ============================================================================
// FrameAssembly Lark Grammar (Outlines / vLLM / Guidance / XGrammar / llguidance)
// Synchronized with src/lexer/mod.rs, grammar.ebnf, and frameassembly.gbnf.
// Covers all 81 native protocols, L2-L4 modifiers, SNMPv1/v2c/v3 USM, and L7.
// Note: FrameAssembly v3.0.0 (.frasm) enforces strict-lowercase alphanumeric tokens
// without '_' or '-' across all keywords, protocols, modifiers, and time units.
// ============================================================================

start: top_level_decl* compile_block top_level_decl*

top_level_decl: host_decl
              | flow_decl

// 1. Host Declarations (at least one ip or mac property in any order)
host_decl: "host" ident "{" host_prop+ "}"
host_prop: "ip" ip_addr
         | "mac" MAC_ADDR

// 2. Flow Declarations & Statements (flow blocks are optional when compile uses inline frame_stmt)
flow_decl: "flow" ident "(" param_list? ")" "{" frame_stmt* "}"
param_list: ident ("," ident)*

frame_stmt: ident direction ident frame_field*
direction: "->" | "<-"

// 3. Compile Block & Inline Frame Statements
compile_block: "compile" "{" run_stmt* "}"
run_stmt: flow_call
        | frame_stmt
flow_call: ident "(" param_list? ")"

// 4. Frame Fields (Protocols, Modifiers & Protocol Attributes)
frame_field: protocol_kw
           | universal_mod
           | l2_mod
           | l3_mod
           | l4_mod
           | l2_proto_field
           | l3_proto_field
           | l4_proto_field
           | snmp_proto_field
           | l7_proto_field

// 5. All 81 Native Protocol Keywords
protocol_kw: l2_proto
           | l3_proto
           | l4_proto
           | snmp_proto
           | l7_infra_proto
           | l7_app_proto
           | l7_ot_proto

l2_proto: "arp" | "vlan" | "qinq" | "lldp" | "stp" | "lacp" | "eapol" | "mpls"

l3_proto: "icmp" | "ndp" | "igmp" | "mld" | "gre" | "vxlan" | "geneve"
        | "ipsec" | "esp" | "ah" | "ikev2" | "wireguard"
        | "ospf" | "bgp" | "rip" | "vrrp" | "hsrp" | "pim" | "bfd" | "openflow"

l4_proto: "tcp" | "udp" | "sctp"

snmp_proto: "snmp1" | "snmp2" | "snmp3"

l7_infra_proto: "dns" | "mdns" | "dhcp" | "ntp" | "ptp" | "radius"
              | "tacacs" | "syslog" | "netflow" | "ipfix" | "sflow"

l7_app_proto: "tftp" | "ftp" | "ssh" | "telnet" | "http" | "http2" | "grpc"
            | "websocket" | "tls" | "quic" | "stun" | "sip" | "rtp" | "rtsp"
            | "smtp" | "imap" | "pop3" | "kerberos" | "ldap" | "smb" | "nfs"
            | "redis" | "memcached" | "mysql" | "postgres" | "mqtt" | "coap"
            | "amqp" | "ssdp" | "whois"

l7_ot_proto: "modbus" | "bacnet" | "dnp3" | "s7comm" | "ethernetip" | "opcua"

// 6. Universal & Layer 2-4 Modifiers
universal_mod: "wait" duration_lit
             | "payload" STRING_LIT
             | "hexpayload" HEX_STRING_LIT

l2_mod: "srcmac" MAC_ADDR
      | "dstmac" MAC_ADDR
      | "ethertype" UINT_LIT
      | "vlan" UINT_LIT?
      | "pcp" UINT_LIT
      | "dei" UINT_LIT
      | "qinq" UINT_LIT?
      | "innervlan" UINT_LIT
      | "mpls" UINT_LIT?
      | "label" UINT_LIT
      | ("exp" | "tc") UINT_LIT
      | "bos" UINT_LIT
      | "mplsttl" UINT_LIT

l3_mod: "ttl" UINT_LIT
      | "dscp" UINT_LIT
      | "ecn" UINT_LIT
      | "flowlabel" UINT_LIT
      | "ipid" UINT_LIT
      | "df"
      | "mf"
      | "fragoffset" UINT_LIT
      | "nextheader" UINT_LIT

l4_mod: "srcport" UINT_LIT
      | "dstport" UINT_LIT
      | "transport" ("tcp" | "udp")
      | tcp_flag
      | "seq" UINT_LIT
      | "acknum" UINT_LIT
      | ("win" | "window") UINT_LIT
      | "urgent" UINT_LIT
      | "mss" UINT_LIT
      | "wscale" UINT_LIT
      | "sackperm"
      | "tsval" UINT_LIT
      | "tsecr" UINT_LIT

tcp_flag: "syn" | "ack" | "fin" | "rst" | "psh" | "urg" | "ece" | "cwr"

// 7. Layer 2 Protocol Sub-Keywords
l2_proto_field: "request"
              | "reply" STRING_LIT?
              | "gratuitous" | "garp"
              | ("sha" | "sendermac") MAC_ADDR
              | ("spa" | "senderip") ip_addr
              | ("tha" | "targetmac") MAC_ADDR
              | ("tpa" | "targetip") ip_addr
              | "chassisid" str_or_ident
              | "portid" (UINT_LIT | str_or_ident)
              | "sysname" str_or_ident
              | "sysdesc" str_or_ident
              | "rootid" str_or_ident
              | "bridgeid" str_or_ident
              | "cost" UINT_LIT
              | "maxage" UINT_LIT
              | "hellotime" UINT_LIT
              | "forwarddelay" UINT_LIT
              | "rstp"
              | "flags" UINT_LIT
              | "actorsys" (MAC_ADDR | STRING_LIT)
              | "actorkey" UINT_LIT
              | "actorport" UINT_LIT
              | "partnersys" (MAC_ADDR | STRING_LIT)
              | "partnerkey" UINT_LIT
              | "partnerport" UINT_LIT
              | "actorstate" UINT_LIT
              | "partnerstate" UINT_LIT
              | "version" (UINT_LIT | str_or_ident)
              | "type" (UINT_LIT | "start" | "logoff" | "key" | "eappacket" | "initiation" | "response" | "cookie" | "data"
              | "hello" | "featuresreq" | "featuresreply" | "packetin" | "packetout" | "flowmod" | "echoreq" | "echorequest" | "echoreply"
              | "authen" | "author" | "acct" | str_or_ident)
              | "start" | "logoff" | "key" | "eappacket"
              | "eapcode" UINT_LIT
              | "eapid" UINT_LIT
              | "eapmethod" UINT_LIT
              | "identity" str_or_ident

// 8. Layer 3 Protocol Sub-Keywords
l3_proto_field: "echorequest" | "echoreply" | "destunreach" | "timeexceeded" | "redirect"
              | "code" (UINT_LIT | str_or_ident)
              | "id" UINT_LIT
              | "gateway" ip_addr
              | "routersolicit" | "routeradvert" | "neighborsolicit" | "neighboradvert"
              | "target" (ip_addr | MAC_ADDR)
              | "slla" MAC_ADDR
              | "tlla" MAC_ADDR
              | "routerlifetime" UINT_LIT
              | "query" | "report" | "leave" | "done" | "v1" | "v2" | "v3"
              | "group" (ip_addr | UINT_LIT)
              | "maxresp" UINT_LIT
              | "multicastaddr" ip_addr
              | "maxrespdelay" UINT_LIT
              | "checksum"
              | "grekey" UINT_LIT
              | "greseq" UINT_LIT
              | "greproto" UINT_LIT
              | ("vni" | "vnid") UINT_LIT
              | "optclass" UINT_LIT
              | "opttype" UINT_LIT
              | "protocoltype" UINT_LIT
              | "spi" UINT_LIT
              | "iv" (HEX_STRING_LIT | UINT_LIT)
              | "icv" (HEX_STRING_LIT | UINT_LIT)
              | "initiatorspi" (UINT_LIT | HEX_STRING_LIT)
              | "responderspi" (UINT_LIT | HEX_STRING_LIT)
              | "exchange" (UINT_LIT | "sainit" | "createchildsa" | "informational" | str_or_ident)
              | "sainit" | "createchildsa" | "informational"
              | "msgid" (UINT_LIT | str_or_ident)
              | "nextpayload" UINT_LIT
              | "initiation" | "cookie" str_or_ident? | "data" str_or_ident?
              | "sender" UINT_LIT
              | "receiver" UINT_LIT
              | "counter" UINT_LIT
              | "hello" | "dbd" | "lsr" | "lsu" | "lsack"
              | "routerid" ip_addr
              | "areaid" (UINT_LIT | ip_addr)
              | "hellointerval" UINT_LIT
              | "deadinterval" UINT_LIT
              | "priority" UINT_LIT
              | "open" | "update" | "notification" | "keepalive" UINT_LIT?
              | "asn" UINT_LIT
              | "holdtime" UINT_LIT
              | "bgpid" ip_addr
              | ("prefix" | "nlri") (ip_addr | str_or_ident)
              | "nexthop" ip_addr
              | "command" (UINT_LIT | str_or_ident)
              | "metric" UINT_LIT
              | "tag" (UINT_LIT | str_or_ident)
              | "vrid" UINT_LIT
              | "advint" UINT_LIT
              | "vip" ip_addr
              | "hellotime" UINT_LIT
              | "state" UINT_LIT
              | "joinprune" | "register"
              | "source" ip_addr
              | "rp" ip_addr
              | "drpriority" UINT_LIT
              | "diag" UINT_LIT
              | "mydisc" UINT_LIT
              | "yourdisc" UINT_LIT
              | "mintx" UINT_LIT
              | "minrx" UINT_LIT
              | "mult" UINT_LIT
              | "featuresreq" | "featuresreply" | "packetin" | "packetout" | "flowmod" | "echoreq"
              | "xid" UINT_LIT
              | "dpid" UINT_LIT
              | "tableid" UINT_LIT

// 9. Layer 4 SCTP Sub-Keywords
l4_proto_field: "vtag" UINT_LIT
              | "stream" UINT_LIT
              | "ssn" UINT_LIT
              | "ppid" UINT_LIT
              | "tsn" UINT_LIT
              | "chunk" ("data" | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack" | "abort" | "shutdown" | "shutdownack" | "cookieecho" | "cookieack" | UINT_LIT | str_or_ident)
              | "init" | "initack" | "sack" | "heartbeat" | "heartbeatack"
              | "abort" | "shutdown" | "shutdownack" | "cookieecho" | "cookieack"

// 10. SNMPv1 / SNMPv2c / SNMPv3 Sub-Keywords
snmp_proto_field: "trap" | "inform" | "get" | "getnext" | "getbulk" | "set" | "response" str_or_ident? | "report"
                | "community" STRING_LIT
                | "oid" oid_lit
                | "sysuptime" UINT_LIT
                | "reqid" UINT_LIT
                | "nonrepeaters" UINT_LIT
                | "maxrepetitions" UINT_LIT
                | "enterprise" oid_lit
                | "agentip" ip_addr
                | "gentrap" UINT_LIT
                | "spectrap" UINT_LIT
                | "user" str_or_ident
                | "engineid" STRING_LIT
                | "engineboots" UINT_LIT
                | "enginetime" UINT_LIT
                | "contextname" STRING_LIT
                | "auth" ("md5" | "sha" | "sha256" | "sha384" | "sha512") STRING_LIT
                | "priv" ("des" | "aes") STRING_LIT
                | "varbind" oid_lit varbind_val

varbind_val: "nullval" | "null"
           | "string" STRING_LIT
           | "int" INT_LIT
           | "timeticks" UINT_LIT
           | "ipval" ip_addr
           | "oidval" oid_lit
           | "counter32" UINT_LIT
           | "gauge32" UINT_LIT
           | "counter64" UINT_LIT

// 11. Layer 7 Sub-Keywords
l7_proto_field: "txid" (UINT_LIT | str_or_ident)
              | "qname" str_or_ident
              | "qtype" (UINT_LIT | str_or_ident)
              | "rdata" str_or_ident
              | "rcode" UINT_LIT
              | "ansttl" UINT_LIT
              | "discover" | "solicit" | "offer" | "advertise" | "release"
              | "ciaddr" ip_addr
              | "yiaddr" ip_addr
              | "siaddr" ip_addr
              | "chaddr" MAC_ADDR
              | "hostname" str_or_ident
              | "dnsserver" ip_addr
              | "router" ip_addr
              | "subnetmask" ip_addr
              | "leasetime" UINT_LIT
              | "li" UINT_LIT
              | "vn" UINT_LIT
              | "mode" (UINT_LIT | str_or_ident)
              | "stratum" UINT_LIT
              | "poll" UINT_LIT
              | "precision" INT_LIT
              | "refid" str_or_ident
              | "txtimestamp" UINT_LIT
              | "msgtype" (UINT_LIT | str_or_ident)
              | "sync" | "delayreq" | "followup" | "delayresp" | "announce"
              | "domain" (UINT_LIT | str_or_ident)
              | "seqid" UINT_LIT
              | "clockid" (MAC_ADDR | str_or_ident)
              | "accessrequest" | "accessaccept" | "accessreject"
              | "accesschallenge" | "accountingrequest" | "accountingresponse"
              | "nasip" ip_addr
              | "servicetype" UINT_LIT
              | "framedip" ip_addr
              | "authen" | "author" | "acct"
              | "sessionid" UINT_LIT
              | "facility" UINT_LIT
              | "severity" UINT_LIT
              | "pri" UINT_LIT
              | "app" str_or_ident
              | "procid" str_or_ident
              | "msg" str_or_ident
              | "srcip" ip_addr
              | "dstip" ip_addr
              | "proto" UINT_LIT
              | "packets" UINT_LIT
              | "octets" UINT_LIT
              | "domainid" UINT_LIT
              | "agentip" ip_addr
              | "subagentid" UINT_LIT
              | "uptime" UINT_LIT
              | "samples" UINT_LIT
              | "rrq" | "wrq" | "error"
              | "filename" str_or_ident
              | "block" UINT_LIT
              | "errcode" UINT_LIT
              | "errmsg" str_or_ident
              | "cmd" (UINT_LIT | str_or_ident)
              | "arg" str_or_ident
              | "banner" str_or_ident
              | "kexinit" | "newkeys"
              | "msgcode" UINT_LIT
              | "will" UINT_LIT
              | "wont" UINT_LIT
              | "do" UINT_LIT
              | "dont" UINT_LIT
              | "option" UINT_LIT
              | "post" | "put" | "delete" | "head" | "options" | "patch"
              | "uri" str_or_ident
              | "hosthdr" str_or_ident
              | "useragent" str_or_ident
              | "contenttype" str_or_ident
              | "status" (UINT_LIT | str_or_ident)
              | "reason" str_or_ident
              | "header" STRING_LIT STRING_LIT
              | "body" str_or_ident
              | "preface" | "settings" | "headers" | "windowupdate" | "ping" | "goaway"
              | "streamid" UINT_LIT
              | "service" str_or_ident
              | "method" str_or_ident
              | "grpcstatus" UINT_LIT
              | "opcode" (UINT_LIT | str_or_ident)
              | "text" | "binary" | "pong" | "close"
              | "finbit" UINT_LIT
              | "maskkey" UINT_LIT
              | "clienthello" | "serverhello" | "certificate" | "finished" | "appdata" | "alert"
              | "recordversion" UINT_LIT
              | "handshakeversion" UINT_LIT
              | "sni" str_or_ident
              | "ciphersuite" UINT_LIT
              | "alpn" str_or_ident
              | "initial" | "zerortt" | "handshake" | "retry" | "short"
              | "dcid" (UINT_LIT | str_or_ident)
              | "scid" (UINT_LIT | str_or_ident)
              | "token" (UINT_LIT | str_or_ident)
              | "pktnum" UINT_LIT
              | "bindingrequest" | "bindingresponse" | "bindingerror"
              | "xormappedaddr" ip_addr UINT_LIT?
              | "software" str_or_ident
              | "invite" | "bye" | "cancel"
              | "from" str_or_ident
              | "to" str_or_ident
              | "callid" str_or_ident
              | "cseq" UINT_LIT
              | "via" str_or_ident
              | "contact" str_or_ident
              | "pt" UINT_LIT
              | "timestamp" UINT_LIT
              | "ssrc" UINT_LIT
              | "marker" UINT_LIT
              | "describe" | "setup" | "play" | "teardown"
              | "transporthdr" str_or_ident
              | "session" str_or_ident
              | "ehlo" str_or_ident?
              | "helo" str_or_ident?
              | "mailfrom" str_or_ident?
              | "rcptto" str_or_ident?
              | "quit"
              | "param" str_or_ident
              | "ok" | "err"
              | "asreq" | "asrep" | "tgsreq" | "tgsrep" | "krberror"
              | "realm" str_or_ident
              | "cname" str_or_ident
              | "sname" str_or_ident
              | "etype" UINT_LIT
              | "bindreq" | "bindres" | "searchreq" | "searchentry" | "searchdone" | "unbindreq"
              | "basedn" str_or_ident
              | "filter" str_or_ident
              | "resultcode" UINT_LIT
              | "negotiate" | "sessionsetup" | "treeconnect" | "create" | "treedisconnect"
              | "treeid" UINT_LIT
              | "share" str_or_ident
              | "vers" UINT_LIT
              | "proc" (UINT_LIT | str_or_ident)
              | "path" str_or_ident
              | "compound"
              | "args" str_or_ident
              | "replytype" str_or_ident
              | "key" (UINT_LIT | str_or_ident)
              | "value" (UINT_LIT | str_or_ident)
              | "exptime" UINT_LIT
              | "opaque" UINT_LIT
              | "cas" UINT_LIT
              | "greeting" | "login" | "eof"
              | "sql" str_or_ident
              | "serverversion" str_or_ident
              | "db" str_or_ident
              | "startup" | "readyforquery" | "commandcomplete" | "errorresponse" | "authok"
              | "connect" | "connack" | "publish" | "puback" | "subscribe" | "suback"
              | "pingreq" | "pingresp" | "disconnect"
              | "clientid" str_or_ident
              | "topic" str_or_ident
              | "qos" UINT_LIT
              | "retain" UINT_LIT?
              | "pkttype" (UINT_LIT | str_or_ident)
              | "pktid" UINT_LIT
              | "returncode" UINT_LIT
              | "con" | "non" | "changed" | "created" | "notfound"
              | "uripath" str_or_ident
              | "contentformat" UINT_LIT
              | "protocolheader" | "connectionstart" | "channelopen" | "basicpublish" | "basicdeliver"
              | "channel" UINT_LIT
              | "routingkey" str_or_ident
              | "msearch" | "notify"
              | "man" str_or_ident
              | "mx" UINT_LIT
              | "st" str_or_ident
              | "nt" str_or_ident
              | "nts" str_or_ident
              | "usn" str_or_ident
              | "location" str_or_ident
              | "registrar" str_or_ident
              | "protoid" UINT_LIT
              | "unitid" UINT_LIT
              | "func" (UINT_LIT | str_or_ident)
              | "readcoils" | "readdiscreteinputs" | "readholdingregisters" | "readinputregisters"
              | "writesinglecoil" | "writesingleregister" | "writemultipleregisters"
              | "addr" UINT_LIT
              | "count" UINT_LIT
              | "isresponse"
              | "whois" | "iam" | "readproperty" | "writeproperty"
              | "invokeid" UINT_LIT
              | "objecttype" UINT_LIT
              | "objectinstance" UINT_LIT
              | "propertyid" UINT_LIT
              | "confirm" | "read" | "write" | "select" | "operate" | "directoperate" | "unsolicitedresponse"
              | "variation" UINT_LIT
              | "crc" UINT_LIT
              | "src" UINT_LIT
              | "dst" UINT_LIT
              | "rosctr" (UINT_LIT | str_or_ident)
              | "pduref" UINT_LIT
              | "setupcomm" | "readvar" | "writevar" | "plccontrol"
              | "area" (UINT_LIT | str_or_ident)
              | "dbnum" UINT_LIT
              | "offset" UINT_LIT
              | "nop" | "listservices" | "listidentity" | "listinterfaces"
              | "registersession" | "unregistersession" | "sendrrdata" | "sendunitdata"
              | "sessionhandle" UINT_LIT
              | "context" (UINT_LIT | str_or_ident)
              | "cipservice" UINT_LIT
              | "cipclass" UINT_LIT
              | "cipinstance" UINT_LIT
              | "cipattr" UINT_LIT
              | "chunktype" str_or_ident
              | "securechannelid" UINT_LIT
              | "tokenid" UINT_LIT
              | "seqnum" UINT_LIT
              | "endpointurl" str_or_ident
              | "nodeid" str_or_ident

// 12. Lexical Terminals
ident: IDENT | contextual_keyword
str_or_ident: STRING_LIT | IDENT | contextual_keyword

contextual_keyword: "abort" | "accessaccept" | "accesschallenge" | "accessreject"
                  | "accessrequest" | "accountingrequest" | "accountingresponse" | "acct"
                  | "ack" | "acknum" | "actorkey" | "actorport" | "actorstate" | "actorsys"
                  | "addr" | "advertise" | "advint" | "aes" | "agentip" | "ah" | "alert"
                  | "alpn" | "amqp" | "announce" | "ansttl" | "app" | "appdata" | "area"
                  | "areaid" | "arg" | "args" | "arp" | "asn" | "asrep" | "asreq" | "auth"
                  | "authen" | "authok" | "author" | "bacnet" | "banner" | "basedn"
                  | "basicdeliver" | "basicpublish" | "bfd" | "bgp" | "bgpid" | "binary"
                  | "bindingerror" | "bindingrequest" | "bindingresponse" | "bindreq"
                  | "bindres" | "block" | "body" | "bos" | "bridgeid" | "bye" | "callid"
                  | "cancel" | "cas" | "certificate" | "chaddr" | "changed" | "channel"
                  | "channelopen" | "chassisid" | "checksum" | "chunk" | "chunktype" | "ciaddr"
                  | "cipattr" | "cipclass" | "ciphersuite" | "cipinstance" | "cipservice"
                  | "clienthello" | "clientid" | "clockid" | "close" | "cmd" | "cname" | "coap"
                  | "code" | "command" | "commandcomplete" | "community" | "compound" | "con"
                  | "confirm" | "connack" | "connect" | "connectionstart" | "contact"
                  | "contentformat" | "contenttype" | "context" | "contextname" | "cookie"
                  | "cookieack" | "cookieecho" | "cost" | "count" | "counter" | "counter32"
                  | "counter64" | "crc" | "create" | "createchildsa" | "created" | "cseq"
                  | "cwr" | "data" | "db" | "dbd" | "dbnum" | "dcid" | "deadinterval" | "dei"
                  | "delayreq" | "delayresp" | "delete" | "des" | "describe" | "destunreach"
                  | "df" | "dhcp" | "diag" | "directoperate" | "disconnect" | "discover"
                  | "dnp3" | "dns" | "dnsserver" | "do" | "domain" | "domainid" | "done"
                  | "dont" | "dpid" | "drpriority" | "dscp" | "dst" | "dstip" | "dstmac"
                  | "dstport" | "eapcode" | "eapid" | "eapmethod" | "eapol" | "eappacket"
                  | "ece" | "echoreply" | "echoreq" | "echorequest" | "ecn" | "ehlo"
                  | "endpointurl" | "engineboots" | "engineid" | "enginetime" | "enterprise"
                  | "eof" | "err" | "errcode" | "errmsg" | "error" | "errorresponse" | "esp"
                  | "ethernetip" | "ethertype" | "etype" | "exchange" | "exp" | "exptime"
                  | "facility" | "featuresreply" | "featuresreq" | "filename" | "filter" | "fin"
                  | "finbit" | "finished" | "flags" | "flowlabel" | "flowmod" | "followup"
                  | "forwarddelay" | "fragoffset" | "framedip" | "from" | "ftp" | "func"
                  | "garp" | "gateway" | "gauge32" | "geneve" | "gentrap" | "get" | "getbulk"
