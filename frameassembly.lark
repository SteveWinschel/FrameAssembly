              | "accookie" (HEX_STRING_LIT | UINT_LIT)
              | "pppproto" (UINT_LIT | any_str)
              | "frameid" UINT_LIT
              | "cycle" UINT_LIT
              | "datastatus" UINT_LIT
              | "transferstatus" UINT_LIT
              | "connect" | "get" | "set" | "release" | "response"
              | "service" any_str
              | "xid" UINT_LIT
              | "hostname" any_str

// 8. Layer 3 Protocol Sub-Keywords (31 protocols)
