              | "adp" UINT_LIT
              | ("ado" | "offset") UINT_LIT
              | "irq" UINT_LIT
              | "wkc" UINT_LIT
              | "appid" UINT_LIT
              | "gocbref" str_or_ident
              | "timetolive" UINT_LIT
              | "datset" str_or_ident
              | "goid" str_or_ident
              | "stnum" UINT_LIT
              | "sqnum" UINT_LIT
              | "simulation"
              | "confrev" UINT_LIT
              | "ndscom"
              | "numdatsetentries" UINT_LIT
              | "svid" str_or_ident
              | "smpcnt" UINT_LIT
              | "smpsynch" UINT_LIT
              | "smprate" UINT_LIT
              | "l1iih" | "l2iih" | "p2piih" | "l1lsp" | "l2lsp"
              | "l1csnp" | "l2csnp" | "l1psnp" | "l2psnp" | "hello"
              | "sysid" any_str
              | "area" any_str
              | "holdtime" UINT_LIT
              | "circuittype" UINT_LIT
              | "priority" UINT_LIT
              | "lanid" any_str
              | "seqnum" UINT_LIT
              | "lifetime" UINT_LIT
              | "tci" UINT_LIT
              | "an" UINT_LIT
              | "sl" UINT_LIT
              | "pn" UINT_LIT
              | "sci" UINT_LIT
              | "icv" (HEX_STRING_LIT | UINT_LIT)
              | "oam"
