              | "nextproto" (UINT_LIT | any_str)
              | "spi" UINT_LIT
              | "si" UINT_LIT
              | "context" (HEX_STRING_LIT | UINT_LIT)
              | "enable" UINT_LIT
              | "quanta" UINT_LIT
              | "q0" UINT_LIT | "q1" UINT_LIT | "q2" UINT_LIT | "q3" UINT_LIT
              | "q4" UINT_LIT | "q5" UINT_LIT | "q6" UINT_LIT | "q7" UINT_LIT
              | "padi" | "pado" | "padr" | "pads" | "padt" | "session"
              | "sessionid" UINT_LIT
              | "servicename" any_str
              | "acname" any_str
