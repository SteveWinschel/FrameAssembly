                            | ( "status" , unsigned_int ) | ( "flags" , unsigned_int )
                            | ( "offset" , unsigned_int ) ;
nvmetcp_field               = "icreq" | "icresp" | "read" | "write" | "response" | "h2cdata" | "c2hdata"
                            | "r2t" | ( "msgtype" , any_str ) | ( "cmd" , any_str )
                            | ( "opcode" , unsigned_int ) | ( "nsid" , unsigned_int )
                            | ( "qid" , unsigned_int ) | ( "reqid" , unsigned_int )
                            | ( "flags" , unsigned_int ) | ( "status" , unsigned_int )
                            | ( "offset" , unsigned_int ) | ( "count" , unsigned_int ) ;
rocev2_field                = "read" | "write" | ( "opcode" , any_str ) | ( "pkey" , unsigned_int )
                            | ( "destqp" , unsigned_int ) | "ackreq" | ( "seqnum" , unsigned_int )
                            | ( "addr" , unsigned_int ) | ( "key" , unsigned_int )
                            | ( "count" , unsigned_int ) | ( "status" , unsigned_int )
                            | ( "msgid" , unsigned_int ) | ( "crc" , unsigned_int ) ;

(* 8d. L7 3GPP / Telco Core Control-Plane Protocols *)
gtpc_field                  = "echorequest" | "echoreply" | "echoresponse" | "createsessionrequest"
                            | "createsessionresponse" | "modifybearerrequest" | "modifybearerresponse"
                            | "deletesessionrequest" | "deletesessionresponse" | ( "msgtype" , any_str )
                            | ( "teid" , unsigned_int ) | ( "seqnum" , unsigned_int )
                            | ( "cause" , unsigned_int ) | ( "imsi" , any_str ) | ( "apn" , any_str )
                            | ( "rat" , unsigned_int ) | ( "recovery" , unsigned_int )
                            | ( "addr" , ip_address ) ;
pfcp_field                  = "heartbeatrequest" | "heartbeatresponse" | "associationsetuprequest"
                            | "associationsetupresponse" | "sessionestablishmentrequest"
                            | "sessionestablishmentresponse" | "sessionmodificationrequest"
                            | "sessionmodificationresponse" | "sessiondeletionrequest"
                            | "sessiondeletionresponse" | ( "msgtype" , any_str )
                            | ( "seid" , unsigned_int ) | ( "seqnum" , unsigned_int )
                            | ( "cause" , unsigned_int ) | ( "nodeid" , any_str )
                            | ( "recovery" , unsigned_int ) ;
diameter_field              = "cer" | "cea" | "dwr" | "dwa" | "ccr" | "cca" | "request" | "response"
                            | ( ( "cmd" | "command" ) , any_str ) | ( "flags" , unsigned_int )
                            | ( "appid" , unsigned_int ) | ( "hopid" , unsigned_int )
                            | ( "endid" , unsigned_int ) | ( "originhost" , any_str )
                            | ( "realm" , any_str ) | ( "dsthost" , any_str ) | ( "dstrealm" , any_str )
                            | ( "sessionid" , any_str ) | ( "resultcode" , unsigned_int )
                            | ( "user" , any_str ) ;
ngap_field                  = "ngsetuprequest" | "ngsetupresponse" | "ngsetupfailure"
                            | "initialuemessage" | "downlinknastransport" | "uplinknastransport"
                            | "uecontextreleasecommand" | "uecontextreleasecomplete" | "errorindication"
                            | ( "msgtype" , any_str ) | ( "proccode" , unsigned_int )
                            | ( "criticality" , any_str ) | ( "amfueid" , unsigned_int )
                            | ( "ranueid" , unsigned_int ) | ( "plmn" , any_str )
                            | ( "gnbid" , unsigned_int ) | ( "tac" , unsigned_int )
                            | ( "ranname" , any_str ) | ( "naspdu" , hex_bytes ) ;
s1ap_field                  = "s1setuprequest" | "s1setupresponse" | "s1setupfailure"
                            | "initialuemessage" | "downlinknastransport" | "uplinknastransport"
                            | "uecontextreleasecommand" | "uecontextreleasecomplete" | "errorindication"
                            | ( "msgtype" , any_str ) | ( "proccode" , unsigned_int )
                            | ( "criticality" , any_str ) | ( "mmeueid" , unsigned_int )
                            | ( "enbueid" , unsigned_int ) | ( "plmn" , any_str )
                            | ( "enbid" , unsigned_int ) | ( "tac" , unsigned_int )
                            | ( "enbname" , any_str ) | ( "naspdu" , hex_bytes ) ;

(* 8e. L7 OT / ICS / Energy / Automotive / Building Automation Protocols *)
modbus_field                = "readcoils" | "readdiscreteinputs" | "readholdingregisters"
                            | "readinputregisters" | "writesinglecoil" | "writesingleregister"
                            | "writemultipleregisters" | ( "txid" , unsigned_int )
