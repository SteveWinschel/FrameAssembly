                            | ( "src" , unsigned_int ) | ( "dst" , unsigned_int )
                            | ( "group" , unsigned_int ) | ( "variation" , unsigned_int )
                            | ( "crc" , unsigned_int ) ;
s7comm_field                = "setupcomm" | "readvar" | "writevar" | "plccontrol" | "szl"
