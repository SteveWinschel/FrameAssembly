                            | ( "count" , unsigned_int ) | ( "value" , unsigned_int )
                            | ( "errcode" , unsigned_int ) | "isresponse" ;
bacnet_field                = "whois" | "iam" | "readproperty" | "writeproperty" | "complexack"
                            | ( "invokeid" , unsigned_int ) | ( "objecttype" , unsigned_int )
                            | ( "objectinstance" , unsigned_int ) | ( "propertyid" , unsigned_int )
                            | ( "value" , unsigned_int ) | ( "real" , real_literal ) ;
dnp3_field                  = "confirm" | "read" | "write" | "select" | "operate" | "directoperate"
